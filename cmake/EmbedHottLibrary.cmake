# Embed the HoTT library modules (lib/hott/*.esk) into the cubical kernel
# (ADR-0043), so `(hott (import circle))` works the same in every engine and
# needs no installed files. Generated at configure time; the .esk files are
# configure dependencies, and the header is rewritten only when it changes.
function(eshkol_embed_hott_library out_dir)
    file(GLOB _hott_modules CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/lib/hott/*.esk")
    list(SORT _hott_modules)
    set(_text "// Generated by cmake/EmbedHottLibrary.cmake from lib/hott/*.esk. Do not edit.\n")
    string(APPEND _text "struct HottModule { const char* name; const char* text; };\n")
    string(APPEND _text "static const HottModule kHottLibrary[] = {\n")
    foreach(_m IN LISTS _hott_modules)
        get_filename_component(_name "${_m}" NAME_WE)
        file(READ "${_m}" _body)
        string(LENGTH "${_body}" _len)
        string(APPEND _text "  {\"${_name}\",")
        set(_pos 0)
        while(_pos LESS _len)
            string(SUBSTRING "${_body}" ${_pos} 8000 _piece)
            string(APPEND _text "\n   R\"HOTTLIB(${_piece})HOTTLIB\"")
            math(EXPR _pos "${_pos} + 8000")
        endwhile()
        string(APPEND _text "},\n")
    endforeach()
    string(APPEND _text "};\n")
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${out_dir}/hott_library.inc.tmp" "${_text}")
    configure_file("${out_dir}/hott_library.inc.tmp" "${out_dir}/hott_library.inc" COPYONLY)
    set_property(SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/lib/types/cubical/decl.cpp"
                 APPEND PROPERTY INCLUDE_DIRECTORIES "${out_dir}")
    set_property(SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/lib/types/cubical/decl.cpp"
                 APPEND PROPERTY OBJECT_DEPENDS "${out_dir}/hott_library.inc")
endfunction()
