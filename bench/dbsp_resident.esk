;;; Fixed live relation; snapshot handles are released after each successful tick.
(require stdlib)
(require core.dbsp.resident)
(define ticks (string->number (or (get-environment-variable "ESHKOL_RESIDENT_TICKS") "100000")))
(define threshold (string->number (or (get-environment-variable "ESHKOL_RESIDENT_THRESHOLD") "1048576")))
(if (not (and (integer? ticks) (exact? ticks) (>= ticks 16))) (error "benchmark needs at least 16 ticks"))
(define circuit (make-dbsp-circuit '(a) (list (list 'distinct 'out 'a)) 'out))
(call-with-dbsp-resident circuit threshold (lambda (owner initial)
  (let loop ((i 0) (snapshot initial))
    (if (= i ticks)
      (let ((preused (vector-ref (dbsp-resident-stats owner) 1)))
        (dbsp-resident-compact! owner)
        (let ((stats (dbsp-resident-stats owner)) (output (dbsp-resident-output owner snapshot)))
          (if (not (and (= (zset-size output) 16) (= (vector-ref stats 0) 1)))
              (begin (display "RESULT: FAIL\n") (exit 1)))
          (for-each (lambda (k)
            (let ((last (- (- ticks 1) (modulo (- (- ticks 1) k) 16))))
              (if (not (= (zset-weight output (list k last)) 1))
                  (begin (display "RESULT: FAIL\n") (exit 1))))) (iota 16))
          (display "TICKS: ") (display ticks) (newline)
          (display "LIVE: ") (display (vector-ref stats 0)) (newline)
          (display "PREUSED: ") (display preused) (newline)
          (display "USED: ") (display (vector-ref stats 1)) (newline)
          (display "COMPACTIONS: ") (display (vector-ref stats 2)) (newline)
          (display "COPIED: ") (display (vector-ref stats 3)) (newline)
          (display "RESULT: PASS\n")))
      (let ((next (with-region
        (let* ((key (modulo i 16))
               ;; Use a changed row version while preserving exactly 16 rows.
               (row (list key i))
               (old (list key (- i 16)))
               (actual (if (< i 16) (zset-singleton row 1)
                           (zset-from-weighted (list (list -1 old) (list 1 row)))))
               (next (dbsp-resident-step owner snapshot (list (list 'a actual)))))
          (dbsp-resident-release! owner snapshot) next))))
        (loop (+ i 1) next))))))
