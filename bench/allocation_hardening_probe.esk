(define N 1000000)
(define t0 (current-jiffy))
(define (build n xs)
  (if (= n 0) xs (build (- n 1) (cons n xs))))
(define out (build N '()))
(define t1 (current-jiffy))
(display "cons-count: ") (display N) (newline)
(display "head: ") (display (car out)) (newline)
(display "cons-jiffies: ") (display (- t1 t0)) (newline)
(define v (make-vector 100000 0))
(define t2 (current-jiffy))
(define (fill i)
  (if (= i 1000000)
      #t
      (begin (vector-set! v (modulo i 100000) i) (fill (+ i 1)))))
(fill 0)
(define t3 (current-jiffy))
(display "vector-last: ") (display (vector-ref v 99999)) (newline)
(display "store-jiffies: ") (display (- t3 t2)) (newline)
