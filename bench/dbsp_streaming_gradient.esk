;; Compare maintained and full AD objectives with identical row kernels.
;; ESHKOL_DBSP_ROWS (default 512), ESHKOL_DBSP_TICKS (default 32),
;; ESHKOL_DBSP_MODE (incremental or full). Initialization and oracle excluded.
(require stdlib)
(require core.dbsp.ad)
(define (setting name default)
  (let* ((text (get-environment-variable name)) (value (if text (string->number text) default)))
    (if (not (and (integer? value) (exact? value) (> value 0) (<= value 65536)))
        (error "Benchmark size must be an integer from 1 through 65536")) value))
(define n (setting "ESHKOL_DBSP_ROWS" 512))
(define ticks (setting "ESHKOL_DBSP_TICKS" 32))
(define mode (or (get-environment-variable "ESHKOL_DBSP_MODE") "incremental"))
(if (not (or (string=? mode "incremental") (string=? mode "full"))) (error "Unknown benchmark mode"))
(define (loss tape p row)
  (let* ((a (tape-mul tape (car p) (tape-const tape (list-ref row 1))))
         (b (tape-mul tape (cadr p) (tape-const tape (list-ref row 2))))
         (residual (tape-sub tape (tape-add tape a b) (tape-const tape (list-ref row 3)))))
    (tape-square tape residual)))
(define kernel (dbsp-ad-lift (vector 0.5 -1.0) loss))
;; Observational callback counter only; it never affects computed values.
(define calls 0)
(define (lift row) (set! calls (+ calls 1)) (kernel row))
(define samples (make-vector n #f))
(let fill ((i 0))
  (if (< i n) (begin (vector-set! samples i (list i (+ 1 (modulo i 5)) (modulo i 3) 3)) (fill (+ i 1)))))
(define (total full-ad?)
  (let ((sum (vector 0 0 0)))
    (let rows ((i 0))
      (if (< i n)
          (let* ((row (vector-ref samples i)) (x (cadr row)) (z (caddr row)) (y (list-ref row 3))
                 (e (- (- (* 0.5 x) z) y))
                 (v (if full-ad? (lift row) (vector (* e e) (* 2 e x) (* 2 e z)))))
            (vector-set! sum 0 (+ (vector-ref sum 0) (vector-ref v 0)))
            (vector-set! sum 1 (+ (vector-ref sum 1) (vector-ref v 1)))
            (vector-set! sum 2 (+ (vector-ref sum 2) (vector-ref v 2)))
            (rows (+ i 1))))) sum))
(define graph (make-dbsp-circuit '(rows) (list
  (list 'aggregate 'out 'rows (lambda (row) 'all) lift (dbsp-vector-group 3)
    (lambda (key value) (vector->list value)))) 'out))
(define current (if (string=? mode "incremental")
  (car (dbsp-circuit-step graph (list (list 'rows (zset-from-weighted
    (map (lambda (row) (list 1 row)) (vector->list samples))))))) #f))
(define answer (if current (list->vector (cadar (zset-entries (dbsp-circuit-output current)))) (total #t)))
(set! calls 0)
(define arena-before (__arena-used))
(define start (current-jiffy))
(let loop ((i 0))
  (if (< i ticks)
      (let* ((old (vector-ref samples 0)) (new (list 0 1 0 (if (even? i) 4 3))))
        (vector-set! samples 0 new)
        (if current
            (set! current (car (dbsp-circuit-step current (list (list 'rows
              (zset-from-weighted (list (list -1 old) (list 1 new))))))))
            (set! answer (total #t)))
        (loop (+ i 1)))))
(define elapsed (- (current-jiffy) start))
(define arena-after (__arena-used))
(if current (set! answer (list->vector (cadar (zset-entries (dbsp-circuit-output current))))))
(define expected (total #f))
(define correct (let cells ((i 0)) (or (= i 3)
  (and (= (vector-ref answer i) (vector-ref expected i)) (cells (+ i 1))))))
(if (not (and correct (= calls (if current (* 2 ticks) (* n ticks)))))
    (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "mode=") (display mode) (display " rows=") (display n) (display " ticks=") (display ticks)
(display " row_evaluations=") (display calls) (display " jiffies=") (display elapsed)
(display " jiffies_per_second=") (display (jiffies-per-second))
(display " global_arena_used_before=") (display arena-before)
(display " global_arena_used_after=") (display arena-after)
(display " global_arena_used_change=") (display (- arena-after arena-before)) (newline)
(display "RESULT: PASS") (newline)
