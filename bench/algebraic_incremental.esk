;; Parameter-only ticks: maintained exact moments vs full closed-form scans.
(require stdlib)
(require core.ad.algebraic_incremental)
(define count-text (getenv "ESHKOL_POLYNOMIAL_ROWS"))
(define count (if count-text (string->number count-text) 16))
(define mode (getenv "ESHKOL_POLYNOMIAL_MODE"))
(define maintained? (and mode (string=? mode "incremental")))
(if (not (and (integer? count) (exact? count) (> count 0) (<= count 1024))) (error "Invalid polynomial benchmark size"))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define rows (zset-from-weighted (let init ((i 0) (out '()))
  (if (= i count) out (init (+ i 1) (cons (list 1 (vector (/ i count) (/ (modulo i 5) 3))) out))))))
(define parameters (vector (algebraic-element field 1/2) (algebraic-element field -1/3)))
(define plan (make-algebraic-incremental-plan field 2 2 '(pow (- (+ (* (param 0) (row 0)) (param 1)) (row 1)) 2)))
(define state (algebraic-incremental-new plan parameters rows))
(define row-visits 0)
(define (full theta measured)
  (let ((loss (algebraic-element field 0)) (g0 (algebraic-element field 0)) (g1 (algebraic-element field 0)))
    (for-each (lambda (entry)
      (let* ((row (cadr entry)) (x (algebraic-element field (vector-ref row 0))) (y (algebraic-element field (vector-ref row 1)))
             (r (algebraic-sub (algebraic-add (algebraic-mul (vector-ref theta 0) x) (vector-ref theta 1)) y)))
        (if measured (set! row-visits (+ row-visits 1)))
        (set! loss (algebraic-add loss (algebraic-mul r r)))
        (set! g0 (algebraic-add g0 (algebraic-scale (algebraic-mul r x) 2)))
        (set! g1 (algebraic-add g1 (algebraic-scale r 2))))) (zset-entries rows))
    (vector loss (vector g0 g1))))
(define output #f)
(define delta (vector 1/100 -1/200))
(define elapsed 0)
(let ticks ((t 0)) (if (< t 4)
  (begin
    (set! parameters (vector (algebraic-add (vector-ref parameters 0) (algebraic-element field 1/100))
                            (algebraic-add (vector-ref parameters 1) (algebraic-element field -1/200))))
    (let ((start (current-time-ns)))
      (if maintained?
        (let ((result (algebraic-incremental-step state (zset-empty) delta)))
          (set! state (vector-ref result 0)) (set! output (algebraic-incremental-output state))
          (if (not (= (vector-ref (vector-ref result 2) 1) 0)) (error "Parameter-only update replayed rows")))
        (set! output (full parameters #t)))
      (set! elapsed (+ elapsed (- (current-time-ns) start))))
    (ticks (+ t 1)))))
(define expected (full parameters #f))
(if (not (and (algebraic-equal? (vector-ref output 0) (vector-ref expected 0))
              (algebraic-equal? (vector-ref (vector-ref output 1) 0) (vector-ref (vector-ref expected 1) 0))
              (algebraic-equal? (vector-ref (vector-ref output 1) 1) (vector-ref (vector-ref expected 1) 1))))
    (error "Incremental polynomial benchmark oracle mismatch"))
(if (not (= row-visits (if maintained? 0 (* count 4)))) (error "Unexpected benchmark row work"))
(display "Mode: ") (display (if maintained? "incremental" "full")) (newline)
(display "Rows: ") (display count) (newline)
(display "Row visits: ") (display row-visits) (newline)
(display "Elapsed ns: ") (display elapsed) (newline)
(display "RESULT: PASS") (newline)
