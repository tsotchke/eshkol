;; End-to-end per-call packing/preflight/kernel/reconstruction vs generic AD.
(require stdlib)
(require core.algebraic_batch)
(define count-text (getenv "ESHKOL_BATCH_COUNT"))
(define count (if count-text (string->number count-text) 32))
(define mode (getenv "ESHKOL_BATCH_MODE"))
(define packed? (and mode (string=? mode "packed")))
(if (not (and (integer? count) (exact? count) (> count 0) (<= count 4096))) (error "Invalid batch benchmark size"))
(define field (make-algebraic-field '(-2 0 0 1) 7 0))
(define hyper (make-algebraic-hyperdual field))
(define a (algebraic-ad-value hyper (list
  (algebraic-element field '(1/2 1/3 1/5)) (algebraic-element field '(2/3 -1/2 1/5))
  (algebraic-element field '(-1/5 1/3 1/2)) (algebraic-element field '(1/3 1/5 -1/2)))))
(define b (algebraic-ad-value hyper (list
  (algebraic-element field '(1/3 -1/2 1/5)) (algebraic-element field '(1/2 1/5 -1/3))
  (algebraic-element field '(1/5 1/3 1/2)) (algebraic-element field '(-1/3 1/2 1/5)))))
(define plan (make-algebraic-multiplication-plan hyper))
(define left (make-vector count a))
(define right (make-vector count b))
(define output #f)
(define start (current-time-ns))
(let repeats ((i 0)) (if (< i 4)
  (begin
    (set! output (if packed? (vector-ref (algebraic-batch-mul plan left right) 0)
      (let ((values (make-vector count #f)))
        (let loop ((j 0)) (if (< j count)
          (begin (vector-set! values j (algebraic-ad-mul (vector-ref left j) (vector-ref right j))) (loop (+ j 1))))) values)))
    (repeats (+ i 1)))))
(define elapsed (- (current-time-ns) start))
(define expected (algebraic-ad-mul a b))
(let verify ((i 0)) (if (< i count)
  (begin (if (not (algebraic-ad-equal? (vector-ref output i) expected)) (error "Batch benchmark oracle mismatch"))
    (verify (+ i 1)))))
(display "Mode: ") (display (if packed? "packed" "generic")) (newline)
(display "Products: ") (display (* count 4)) (newline)
(display "Elapsed ns: ") (display elapsed) (newline)
(display "RESULT: PASS") (newline)
