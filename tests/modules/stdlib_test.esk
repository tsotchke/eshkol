;;; Test reorganized stdlib
;;;
;;; Expected values are fixed by what each name denotes (SRFI-1 iota, ordinary
;;; function composition, a stable ascending sort), not by current output.
(require stdlib)

(define (check name expected actual)
  (if (equal? expected actual)
      (begin (display "PASS: ") (display name) (newline))
      (begin (display "FAIL: ") (display name)
             (display " -- expected ") (write expected)
             (display ", got ") (write actual)
             (newline))))

;;; Test arithmetic operators
(check "add(3, 4)" 7 (add 3 4))

;;; Test comparison
(check "lt(3, 5)" #t (lt 3 5))
(check "lt(5, 3)" #f (lt 5 3))

;;; Test predicates
(check "is-even?(4)" #t (is-even? 4))
(check "is-even?(5)" #f (is-even? 5))

;;; Test compose -- (compose f g) x = f (g x)
(define (double x) (* x 2))
(define (inc x) (+ x 1))
(check "(compose double inc)(5) = double(inc(5))" 12 ((compose double inc) 5))
;; ...and the order matters: the other order would give 11.
(check "(compose inc double)(5) = inc(double(5))" 11 ((compose inc double) 5))

;;; Test iota -- SRFI-1: (iota count) counts up from 0
(check "(iota 5)" '(0 1 2 3 4) (iota 5))

;;; Test curry
(check "((curry2 add) 3) 4" 7 (((curry2 add) 3) 4))

;;; Test sort
(check "(sort '(3 1 4 1 5) <)" '(1 1 3 4 5) (sort '(3 1 4 1 5) <))
(check "(sort '(3 1 4 1 5) >)" '(5 4 3 1 1) (sort '(3 1 4 1 5) >))
