(require core.compiler.incremental_plan)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (condition (#t #t)) (thunk) #f))
(define (input i) (vector 0 i (vector)))
(define (binary a b) (vector 2 0 (vector a b)))
(define nodes (vector (input 0) (input 1) (binary 0 1) (binary 0 0) (binary 2 3)))
(define graph (vector 1 2 4 nodes))
(define plan (incremental-plan graph))
(check "schema and trie shape" (and (= (vector-ref plan 0) 1) (= (vector-ref plan 1) 8) (= (vector-ref plan 2) 3)))
(check "operand multiplicity and kernel count" (and (= (vector-ref plan 3) 6) (= (vector-ref plan 4) 3)))
(define consumers (vector-ref plan 5))
(check "consumer order and deduplication" (equal? (vector-ref consumers 0) (vector 2 3)))
(check "all parents" (and (equal? (vector-ref consumers 1) (vector 2))
                         (equal? (vector-ref consumers 2) (vector 4))
                         (equal? (vector-ref consumers 3) (vector 4))
                         (= (vector-length (vector-ref consumers 4)) 0)))
(vector-set! (vector-ref consumers 0) 0 999)
(check "plans do not alias" (equal? (vector-ref (vector-ref (incremental-plan graph) 5) 0) (vector 2 3)))
(check "input operands are not mutated" (equal? (vector-ref (vector-ref nodes 3) 2) (vector 0 0)))
(define singleton (incremental-plan (vector 1 1 0 (vector (input 0)))))
(check "single input has height zero" (and (= (vector-ref singleton 1) 1) (= (vector-ref singleton 2) 0) (= (vector-ref singleton 4) 0)))
(check "schema refusal" (raises? (lambda () (incremental-plan (vector 2 2 4 nodes)))))
(check "inexact schema refusal" (raises? (lambda () (incremental-plan (vector 1.0 2 4 nodes)))))
(check "nonvector refusal" (raises? (lambda () (incremental-plan '(1 2 4)))))
(check "zero width refusal" (raises? (lambda () (incremental-plan (vector 1 0 4 nodes)))))
(check "width budget refusal" (raises? (lambda () (incremental-plan (vector 1 65 4 nodes)))))
(check "inexact index refusal" (raises? (lambda () (incremental-plan (vector 1 2.0 4 nodes)))))
(check "output refusal" (raises? (lambda () (incremental-plan (vector 1 2 5 nodes)))))
(check "node budget refusal" (raises? (lambda () (incremental-plan (vector 1 1 0 (make-vector 1025 (input 0)))))))
(check "input mapping refusal" (raises? (lambda () (incremental-plan (vector 1 1 0 (vector (input 1)))))))
(check "misplaced input refusal" (raises? (lambda () (incremental-plan (vector 1 1 0 (vector (input 0) (input 1)))))))
(check "unknown kind refusal" (raises? (lambda () (incremental-plan (vector 1 1 0 (vector (vector 8 0 (vector))))))))
(check "arity refusal" (raises? (lambda () (incremental-plan (vector 1 1 1 (vector (input 0) (vector 2 0 (vector 0))))))))
(check "forward edge refusal" (raises? (lambda () (incremental-plan (vector 1 1 1 (vector (input 0) (binary 0 1)))))))
(check "negative edge refusal" (raises? (lambda () (incremental-plan (vector 1 1 1 (vector (input 0) (binary -1 0)))))))
(check "inexact edge refusal" (raises? (lambda () (incremental-plan (vector 1 1 1 (vector (input 0) (binary 0.0 0)))))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(display (if (= failed 0) "RESULT: PASS" "RESULT: FAIL")) (newline)
(if (> failed 0) (exit 1))
