(require core.compiler.scalar_lower)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (condition (#t #t)) (thunk) #f))
(define (input i) (vector 0 i (vector)))
(define (binary op a b) (vector op 0 (vector a b)))
(define nodes (vector (input 0) (input 1) (vector 1 0 (vector))
                      (binary 2 0 1) (binary 3 1 0) (binary 4 0 0) (binary 5 3 4)))
(define graph (vector 1 2 6 nodes))
(define lowered (scalar-lower graph))
(define bindings (vector-ref lowered 3))
(define kernels (vector-ref lowered 4))
(check "core schema, width, output" (and (= (vector-ref lowered 0) 1) (= (vector-ref lowered 1) 2) (= (vector-ref lowered 2) 6)))
(check "one binding and kernel per source node" (and (= (vector-length bindings) 7) (= (vector-length kernels) 7)))
(check "input identity" (equal? (vector-ref bindings 1) (vector 0 1 (vector))))
(check "opaque literal slot" (equal? (vector-ref bindings 2) (vector 1 2 (vector))))
(check "inputs and literals have no kernel" (and (equal? (vector-ref kernels 0) (vector 5 0 (vector)))
                                               (equal? (vector-ref kernels 2) (vector 5 0 (vector)))))
(let loop ((i 3))
  (if (< i 7)
      (begin (check "primitive identity in each scope"
               (and (= (vector-ref (vector-ref bindings i) 1) (- i 3))
                    (= (vector-ref (vector-ref kernels i) 1) (- i 3))))
             (loop (+ i 1)))))
(check "subtraction operand order and binding scope"
  (equal? (vector-ref bindings 4) (vector 2 1 (vector (vector 3 1 (vector)) (vector 3 0 (vector))))))
(check "division operand order and kernel scope"
  (equal? (vector-ref kernels 6) (vector 2 3 (vector (vector 4 3 (vector)) (vector 4 4 (vector))))))
(check "repeated operands remain repeated"
  (equal? (vector-ref bindings 5) (vector 2 2 (vector (vector 3 0 (vector)) (vector 3 0 (vector))))))
(define earlier (scalar-lower (vector 1 2 0 nodes)))
(check "earlier output retains unused arithmetic" (and (= (vector-ref earlier 2) 0) (= (vector-length (vector-ref earlier 3)) 7)))
(vector-set! (vector-ref (vector-ref bindings 3) 2) 0 (vector 3 99 (vector)))
(define fresh-lowering (scalar-lower graph))
(define fresh-first-parent
  (vector-ref (vector-ref (vector-ref (vector-ref fresh-lowering 3) 3) 2) 0))
(check "lowerings do not alias" (= (vector-ref fresh-first-parent 1) 0))
(check "source operands are untouched" (equal? (vector-ref (vector-ref nodes 3) 2) (vector 0 1)))
(check "singleton graph" (equal? (scalar-lower (vector 1 1 0 (vector (input 0))))
                                 (vector 1 1 0 (vector (vector 0 0 (vector))) (vector (vector 5 0 (vector))))))
(check "schema refusal" (raises? (lambda () (scalar-lower (vector 2 2 6 nodes)))))
(check "inexact schema refusal" (raises? (lambda () (scalar-lower (vector 1.0 2 6 nodes)))))
(check "nonvector refusal" (raises? (lambda () (scalar-lower '(1 2 6)))))
(check "zero width refusal" (raises? (lambda () (scalar-lower (vector 1 0 6 nodes)))))
(check "width budget refusal" (raises? (lambda () (scalar-lower (vector 1 65 6 nodes)))))
(check "inexact width refusal" (raises? (lambda () (scalar-lower (vector 1 2.0 6 nodes)))))
(check "output refusal" (raises? (lambda () (scalar-lower (vector 1 2 7 nodes)))))
(check "inexact output refusal" (raises? (lambda () (scalar-lower (vector 1 2 6.0 nodes)))))
(check "node budget refusal" (raises? (lambda () (scalar-lower (vector 1 1 0 (make-vector 1025 (input 0)))))))
(check "too few nodes refusal" (raises? (lambda () (scalar-lower (vector 1 2 0 (vector (input 0)))))))
(check "node shape refusal" (raises? (lambda () (scalar-lower (vector 1 1 0 (vector (vector 0 0)))))))
(check "input mapping refusal" (raises? (lambda () (scalar-lower (vector 1 1 0 (vector (input 1)))))))
(check "inexact input mapping refusal" (raises? (lambda () (scalar-lower (vector 1 1 0 (vector (input 0.0)))))))
(check "misplaced input refusal" (raises? (lambda () (scalar-lower (vector 1 1 0 (vector (input 0) (input 1)))))))
(check "unknown opcode refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (vector 6 0 (vector 0 0))))))))
(check "inexact opcode refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (vector 2.0 0 (vector 0 0))))))))
(check "arity refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (vector 2 0 (vector 0))))))))
(check "forward edge refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (binary 2 0 1)))))))
(check "negative edge refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (binary 3 -1 0)))))))
(check "inexact edge refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (binary 4 0.0 0)))))))
(check "literal arity refusal" (raises? (lambda () (scalar-lower (vector 1 1 1 (vector (input 0) (vector 1 0 (vector 0))))))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(display (if (= failed 0) "RESULT: PASS" "RESULT: FAIL")) (newline)
(if (> failed 0) (exit 1))
