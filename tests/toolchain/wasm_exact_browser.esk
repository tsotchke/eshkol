(display (denominator (inexact->exact 0.1)))
(display (+ (inexact->exact 0.1) (inexact->exact 0.2)))
(display (/ (inexact->exact 0.1) (inexact->exact 0.2)))
(display (* (inexact->exact 5e-324) (inexact->exact 5e-324)))
(display (expt (inexact->exact 9223372036854775808.0) 3))
(display (if (exact? (inexact->exact 5e-324)) 1 0))
(display (if (integer? (inexact->exact 9223372036854775808.0)) 1 0))
(display (if (< (inexact->exact 0.1) (inexact->exact 0.2)) 1 0))
(display (if (= (inexact->exact 0.1) (inexact->exact 0.1)) 1 0))
(display (exact->inexact (inexact->exact 5e-324)))
(display (exact->inexact (inexact->exact 1e-300)))
(display (exact->inexact (inexact->exact 1.7976931348623157e308)))
(display (+ (inexact->exact 0.1) 0.2))
(display (floor (inexact->exact -3.5)))
(display (ceiling (inexact->exact -3.5)))
(display (truncate (inexact->exact -3.5)))
(display (round (inexact->exact -3.5)))
(display (round (inexact->exact 2.5)))
(display (round (inexact->exact 3.5)))
(display (floor (/ (+ (inexact->exact 1e300) 1) 2)))
(display (numerator 0.1))
(display (denominator 0.1))
(display (sqrt (/ 4 9)))
(display (sqrt 2))
(display (expt (/ 8 27) (/ 2 3)))
(display (expt (/ 8 27) (/ -2 3)))
(display (expt 2 (/ 1 2)))
(display 0.0)
(display -0.0)
(display +inf.0)
(display -inf.0)
(display +nan.0)
(display (* 1e308 2.0))
(display (* -1e308 2.0))
