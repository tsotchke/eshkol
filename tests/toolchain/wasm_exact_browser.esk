(display (inexact->exact 0.0))
(display (inexact->exact -0.0))
(display (inexact->exact 0.1))
(display (inexact->exact -0.1))
(display (inexact->exact 9223372036854775808.0))
(display (inexact->exact -9223372036854775808.0))
