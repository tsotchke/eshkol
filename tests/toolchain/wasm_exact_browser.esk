(display (exact->inexact (* (inexact->exact -5e-324) (inexact->exact 5e-324))))
(extern void exact-observe-string ptr :real exact_observe_string)
(exact-observe-string (number->string 0.0))
(exact-observe-string (number->string -0.0))
(exact-observe-string (number->string +inf.0))
(exact-observe-string (number->string -inf.0))
(exact-observe-string (number->string +nan.0))
