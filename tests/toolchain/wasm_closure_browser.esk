;; Proposed WASM closure indirect-call ABI regression fixture.
;; Each display emits one numeric result for the paired host harness.
(define (invoke2 f a b) (f a b))
(define (invoke3 f a b c) (f a b c))
(define (invoke0 f) (f))

;; Dynamic fixed-arity target with zero captures.
(display (invoke2 (lambda (x y) (+ x y)) 4 5)) (newline)

;; Dynamic fixed-arity target with one capture.
(display (let ((offset 11))
           (invoke2 (lambda (x y) (+ offset (+ x y))) 3 4))) (newline)

;; Dynamic fixed-arity target with multiple captures.
(display (let ((a 10) (b 20) (c 30))
           (invoke2 (lambda (x y) (+ x (+ y (+ a (+ b c))))) 1 2))) (newline)

;; Existing recursively defined standard-library length path from the minimal trap.
(display (length (list 1 2 3))) (newline)

;; Variadic fixed-arity 0 closure, with one capture.
(display (let ((base 10))
           (invoke3 (lambda xs (+ base (+ (car xs)
                              (+ (car (cdr xs)) (car (cdr (cdr xs)))))))
                    2 3 4))) (newline)

;; Variadic fixed-arity 1 closure, with one capture.
(display (let ((base 5))
           (invoke3 (lambda (x . xs) (+ base (+ x (car xs)))) 2 3 4))) (newline)

;; apply/spread to a captured fixed-arity closure.
(display (let ((base 7))
           (apply (lambda (x y) (+ base (+ x y))) (list 8 9)))) (newline)

;; apply/spread to a captured variadic fixed-arity 1 closure.
(display (let ((base 13))
           (apply (lambda (x . xs) (+ base (+ x (car xs))))
                  (list 2 5 7)))) (newline)

