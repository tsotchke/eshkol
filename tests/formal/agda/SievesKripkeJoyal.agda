{-# OPTIONS --safe --without-K #-}
------------------------------------------------------------------------
-- Sieves, the subobject classifier of a presheaf topos, and Kripke–Joyal
-- forcing.
--
-- nLab claims (tests/nlab/nlab_topos_test.esk):
--   [sieve#1]   "sieves are closed under pulling back"
--   [sieve#2]   "the sieve generated by F is the smallest sieve on c containing F"
--   [sieve#3]   "the union and the intersection of every family of sieves on c
--                is a sieve"
--   [subobject classifier#1] Omega(U) = sieves(U), with its Heyting structure
--   [subobject classifier#3] "precisely two sieves on the single object of BG"
--   [Kripke-Joyal semantics#1] forcing = factoring through the truth sieve
--   [Kripke-Joyal semantics#2] "If f:V→U and U⊧φ(α) then V⊧φ(α∘f)"
--   [Kripke-Joyal semantics#3] the ¬ and ⇒ clauses quantify over all g : V → U
--   [Kripke-Joyal semantics#4] excluded middle fails on the walking arrow
--
-- General theorems, for every category C (Hom-sets with propositional
-- equations), proved below:
--   * pullback, generated sieve (with minimality), arbitrary unions and
--     intersections, the Heyting implication with  R ∧ S ≤ T  ⇔  R ≤ S ⇒ T;
--   * Omega is a presheaf: id^* and (g∘h)^* = h^* g^* up to equivalence;
--   * Kripke–Joyal forcing for the propositional and Omega-quantified
--     language (⊤ ⊥ ∧ ∨ ⇒ ∀p:Ω ∃p:Ω) is invariant under equivalent
--     environments and monotone along every arrow;
--   * the truth value [[φ]] of a formula at a stage U is a sieve on U and
--     U ⊩ φ  ⇔  id_U ∈ [[φ]];
--   * for a group G, every inhabited sieve on the object of BG is maximal.
-- Instances (the values Eshkol prints):
--   * walking arrow 0 → 1: the sieve {0 → 1} on 1 has no complement (Omega
--     is not Boolean) and stage 1 refutes p ∨ ¬p for p = {0 → 1};
--   * sieve counts by exhaustive enumeration, decided by `refl`:
--     walking arrow (2, 3), BZ/2 (2), BZ/3 (2).
------------------------------------------------------------------------
module SievesKripkeJoyal where

open import Level using (Level; _⊔_; 0ℓ) renaming (suc to lsuc)
open import Data.Empty using (⊥; ⊥-elim)
open import Data.Unit using (⊤; tt)
open import Data.Sum using (_⊎_; inj₁; inj₂)
open import Data.Product using (Σ; _×_; _,_; proj₁; proj₂; ∃)
open import Data.Nat using (ℕ; zero; suc)
open import Data.Fin as F using (Fin)
open import Data.Bool using (Bool; true; false; _∧_; _∨_; not; if_then_else_)
open import Data.List using (List; []; _∷_; length; filter; map; concatMap; allFin)
open import Data.Nat using (_+_)
open import Data.Fin using (toℕ; fromℕ<)
open import Data.Nat.DivMod using (_mod_)
open import Data.Maybe using (Maybe; just; nothing)
open import Relation.Nullary using (¬_; Dec; yes; no)
open import Relation.Nullary.Decidable using (⌊_⌋)
open import Relation.Binary.PropositionalEquality
  using (_≡_; refl; sym; trans; cong; subst)

------------------------------------------------------------------------
-- Categories

record Category : Set₁ where
  infixr 9 _∘_
  field
    Ob    : Set
    Hom   : Ob → Ob → Set
    idn   : ∀ {a} → Hom a a
    _∘_   : ∀ {a b c} → Hom b c → Hom a b → Hom a c
    idl   : ∀ {a b} (f : Hom a b) → idn ∘ f ≡ f
    idr   : ∀ {a b} (f : Hom a b) → f ∘ idn ≡ f
    assoc : ∀ {a b c d} (h : Hom c d) (g : Hom b c) (f : Hom a b)
          → (h ∘ g) ∘ f ≡ h ∘ (g ∘ f)

module Sieves (C : Category) where
  open Category C

  -- a sieve on c: a family of arrows into c closed under precomposition
  record Sieve (c : Ob) : Set₁ where
    field
      mem    : ∀ {d} → Hom d c → Set
      closed : ∀ {d e} (f : Hom d c) (g : Hom e d) → mem f → mem (f ∘ g)
  open Sieve public

  _≤_ : ∀ {c} → Sieve c → Sieve c → Set
  _≤_ {c} S T = ∀ {d} (f : Hom d c) → mem S f → mem T f

  _≈_ : ∀ {c} → Sieve c → Sieve c → Set
  S ≈ T = (S ≤ T) × (T ≤ S)

  maximal : ∀ c → Sieve c
  mem (maximal c) _ = ⊤
  closed (maximal c) _ _ _ = tt

  empty : ∀ c → Sieve c
  mem (empty c) _ = ⊥
  closed (empty c) _ _ ()

  -- [sieve#1] pullback along g : d → c
  pull : ∀ {c d} → Hom d c → Sieve c → Sieve d
  mem (pull g S) f = mem S (g ∘ f)
  closed (pull g S) f h m = subst (mem S) (assoc g f h) (closed S (g ∘ f) h m)

  -- [sieve#3] unions and intersections of arbitrary families
  ⋃ : ∀ {c} {I : Set} → (I → Sieve c) → Sieve c
  mem (⋃ {I = I} S) f = Σ I λ i → mem (S i) f
  closed (⋃ S) f g (i , m) = i , closed (S i) f g m

  ⋂ : ∀ {c} {I : Set} → (I → Sieve c) → Sieve c
  mem (⋂ {I = I} S) f = ∀ i → mem (S i) f
  closed (⋂ S) f g m i = closed (S i) f g (m i)

  ⋃-upper : ∀ {c I} (S : I → Sieve c) i → S i ≤ ⋃ S
  ⋃-upper S i f m = i , m

  ⋃-least : ∀ {c I} (S : I → Sieve c) (T : Sieve c) → (∀ i → S i ≤ T) → ⋃ S ≤ T
  ⋃-least S T h f (i , m) = h i f m

  ⋂-lower : ∀ {c I} (S : I → Sieve c) i → ⋂ S ≤ S i
  ⋂-lower S i f m = m i

  ⋂-greatest : ∀ {c I} (S : I → Sieve c) (T : Sieve c) → (∀ i → T ≤ S i) → T ≤ ⋂ S
  ⋂-greatest S T h f m i = h i f m

  -- [sieve#2] the sieve generated by a family of arrows into c
  module _ {c : Ob} {I : Set} {dom : I → Ob} (gen : (i : I) → Hom (dom i) c) where
    generated : Sieve c
    mem generated {d} f = Σ I λ i → Σ (Hom d (dom i)) λ h → gen i ∘ h ≡ f
    closed generated f g (i , h , e) =
      i , h ∘ g , trans (sym (assoc (gen i) h g)) (cong (_∘ g) e)

    generated-contains : ∀ i → mem generated (gen i)
    generated-contains i = i , idn , idr (gen i)

    generated-least : (T : Sieve c) → (∀ i → mem T (gen i)) → generated ≤ T
    generated-least T h f (i , k , e) = subst (mem T) e (closed T (gen i) k (h i))

  -- [subobject classifier#1] the Heyting algebra Omega(c)
  _∩_ : ∀ {c} → Sieve c → Sieve c → Sieve c
  mem (S ∩ T) f = mem S f × mem T f
  closed (S ∩ T) f g (s , t) = closed S f g s , closed T f g t

  _∪_ : ∀ {c} → Sieve c → Sieve c → Sieve c
  mem (S ∪ T) f = mem S f ⊎ mem T f
  closed (S ∪ T) f g (inj₁ s) = inj₁ (closed S f g s)
  closed (S ∪ T) f g (inj₂ t) = inj₂ (closed T f g t)

  _⇒_ : ∀ {c} → Sieve c → Sieve c → Sieve c
  mem (S ⇒ T) {d} f = ∀ {e} (g : Hom e d) → mem S (f ∘ g) → mem T (f ∘ g)
  closed (S ⇒ T) f g m k s =
    subst (mem T) (sym (assoc f g k))
      (m (g ∘ k) (subst (mem S) (assoc f g k) s))

  ⇒-adjunction : ∀ {c} (R S T : Sieve c) → ((R ∩ S) ≤ T) → (R ≤ (S ⇒ T))
  ⇒-adjunction R S T h f r g s = h (f ∘ g) (closed R f g r , s)

  ⇒-adjunction⁻¹ : ∀ {c} (R S T : Sieve c) → (R ≤ (S ⇒ T)) → ((R ∩ S) ≤ T)
  ⇒-adjunction⁻¹ R S T h f (r , s) =
    subst (mem T) (idr f) (h f r idn (subst (mem S) (sym (idr f)) s))

  -- Omega is a presheaf: restriction is pullback, functorial up to ≈
  pull-id : ∀ {c} (S : Sieve c) → pull idn S ≈ S
  pull-id S = (λ f m → subst (mem S) (idl f) m) , (λ f m → subst (mem S) (sym (idl f)) m)

  pull-∘ : ∀ {a b c} (g : Hom b c) (h : Hom a b) (S : Sieve c)
         → pull (g ∘ h) S ≈ pull h (pull g S)
  pull-∘ g h S = (λ f m → subst (mem S) (assoc g h f) m)
               , (λ f m → subst (mem S) (sym (assoc g h f)) m)

  pull-mono : ∀ {c d} (g : Hom d c) (S T : Sieve c) → S ≤ T → pull g S ≤ pull g T
  pull-mono g S T h f m = h _ m

------------------------------------------------------------------------
-- Kripke–Joyal forcing in the presheaf topos over C

module KripkeJoyal (C : Category) where
  open Category C
  open Sieves C

  -- formulas in n propositional variables ranging over Omega
  data Form (n : ℕ) : Set where
    var       : Fin n → Form n
    ⊤ᶠ ⊥ᶠ     : Form n
    _∧ᶠ_ _∨ᶠ_ _⇒ᶠ_ : Form n → Form n → Form n
    ∀Ω ∃Ω     : Form (suc n) → Form n

  ¬ᶠ_ : ∀ {n} → Form n → Form n
  ¬ᶠ φ = φ ⇒ᶠ ⊥ᶠ

  Env : ℕ → Ob → Set₁
  Env n U = Fin n → Sieve U

  _·_ : ∀ {n U V} → Env n U → Hom V U → Env n V
  (ρ · g) i = pull g (ρ i)

  _,,_ : ∀ {n U} → Env n U → Sieve U → Env (suc n) U
  (ρ ,, S) F.zero = S
  (ρ ,, S) (F.suc i) = ρ i

  -- the forcing relation (presheaf toposes: covers are the maximal sieves)
  _⊩_[_] : ∀ {n} (U : Ob) → Form n → Env n U → Set₁
  U ⊩ var i  [ ρ ] = Level.Lift _ (mem (ρ i) idn)
  U ⊩ ⊤ᶠ     [ ρ ] = Level.Lift _ ⊤
  U ⊩ ⊥ᶠ     [ ρ ] = Level.Lift _ ⊥
  U ⊩ φ ∧ᶠ ψ [ ρ ] = (U ⊩ φ [ ρ ]) × (U ⊩ ψ [ ρ ])
  U ⊩ φ ∨ᶠ ψ [ ρ ] = (U ⊩ φ [ ρ ]) ⊎ (U ⊩ ψ [ ρ ])
  U ⊩ φ ⇒ᶠ ψ [ ρ ] = ∀ {V} (g : Hom V U) → V ⊩ φ [ ρ · g ] → V ⊩ ψ [ ρ · g ]
  U ⊩ ∀Ω φ   [ ρ ] = ∀ {V} (g : Hom V U) (S : Sieve V) → V ⊩ φ [ (ρ · g) ,, S ]
  U ⊩ ∃Ω φ   [ ρ ] = Σ (Sieve U) λ S → U ⊩ φ [ ρ ,, S ]

  -- [Kripke-Joyal semantics#3]: the negation clause, as the nLab states it
  ¬-clause : ∀ {n U} (φ : Form n) (ρ : Env n U)
           → U ⊩ ¬ᶠ φ [ ρ ] → ∀ {V} (g : Hom V U) → ¬ (V ⊩ φ [ ρ · g ])
  ¬-clause φ ρ h g v = Level.lower (h g v)

  -- equivalent environments force the same formulas
  record _≋_ {n U} (ρ σ : Env n U) : Set where
    constructor ≋i
    field at : ∀ i → ρ i ≈ σ i
  open _≋_

  ≋-sym : ∀ {n U} {ρ σ : Env n U} → ρ ≋ σ → σ ≋ ρ
  ≋-sym e = ≋i λ i → proj₂ (at e i) , proj₁ (at e i)

  ≋-· : ∀ {n U V} {ρ σ : Env n U} (g : Hom V U) → ρ ≋ σ → (ρ · g) ≋ (σ · g)
  ≋-· {ρ = ρ} {σ} g e = ≋i λ i →
    pull-mono g (ρ i) (σ i) (proj₁ (at e i)) , pull-mono g (σ i) (ρ i) (proj₂ (at e i))

  ≋-,, : ∀ {n U} {ρ σ : Env n U} (S : Sieve U) → ρ ≋ σ → (ρ ,, S) ≋ (σ ,, S)
  ≋-,, S e = ≋i λ { F.zero → (λ f m → m) , (λ f m → m) ; (F.suc i) → at e i }

  invariant : ∀ {n U} (φ : Form n) {ρ σ : Env n U} → ρ ≋ σ → U ⊩ φ [ ρ ] → U ⊩ φ [ σ ]
  invariant (var i) e (Level.lift m) = Level.lift (proj₁ (at e i) idn m)
  invariant ⊤ᶠ e h = h
  invariant ⊥ᶠ e h = h
  invariant (φ ∧ᶠ ψ) e (a , b) = invariant φ e a , invariant ψ e b
  invariant (φ ∨ᶠ ψ) e (inj₁ a) = inj₁ (invariant φ e a)
  invariant (φ ∨ᶠ ψ) e (inj₂ b) = inj₂ (invariant ψ e b)
  invariant (φ ⇒ᶠ ψ) e h g a =
    invariant ψ (≋-· g e) (h g (invariant φ (≋-· g (≋-sym e)) a))
  invariant (∀Ω φ) e h g S = invariant φ (≋-,, S (≋-· g e)) (h g S)
  invariant (∃Ω φ) e (S , a) = S , invariant φ (≋-,, S e) a

  -- restricting twice is restricting along the composite
  ·-∘ : ∀ {n U V W} (ρ : Env n U) (g : Hom V U) (h : Hom W V)
      → ((ρ · g) · h) ≋ (ρ · (g ∘ h))
  ·-∘ ρ g h = ≋i λ i → proj₂ (pull-∘ g h (ρ i)) , proj₁ (pull-∘ g h (ρ i))

  ·-,, : ∀ {n U V} (ρ : Env n U) (S : Sieve U) (g : Hom V U)
       → ((ρ ,, S) · g) ≋ ((ρ · g) ,, pull g S)
  ·-,, ρ S g = ≋i λ { F.zero → (λ f m → m) , (λ f m → m)
                    ; (F.suc i) → (λ f m → m) , (λ f m → m) }

  -- [Kripke-Joyal semantics#2] monotonicity along every arrow f : V → U
  monotone : ∀ {n U V} (φ : Form n) (ρ : Env n U) (f : Hom V U)
           → U ⊩ φ [ ρ ] → V ⊩ φ [ ρ · f ]
  monotone (var i) ρ f (Level.lift m) =
    Level.lift (subst (mem (ρ i)) (trans (idl f) (sym (idr f))) (closed (ρ i) idn f m))
  monotone ⊤ᶠ ρ f h = h
  monotone ⊥ᶠ ρ f h = h
  monotone (φ ∧ᶠ ψ) ρ f (a , b) = monotone φ ρ f a , monotone ψ ρ f b
  monotone (φ ∨ᶠ ψ) ρ f (inj₁ a) = inj₁ (monotone φ ρ f a)
  monotone (φ ∨ᶠ ψ) ρ f (inj₂ b) = inj₂ (monotone ψ ρ f b)
  monotone (φ ⇒ᶠ ψ) ρ f h g a =
    invariant ψ (≋-sym (·-∘ ρ f g)) (h (f ∘ g) (invariant φ (·-∘ ρ f g) a))
  monotone (∀Ω φ) ρ f h g S =
    invariant φ (≋-,, S (≋-sym (·-∘ ρ f g))) (h (f ∘ g) S)
  monotone (∃Ω φ) ρ f (S , a) =
    pull f S , invariant φ (·-,, ρ S f) (monotone φ (ρ ,, S) f a)

  -- [Kripke-Joyal semantics#1] the truth value of φ at U is a sieve on U,
  -- and U forces φ exactly when id_U belongs to it
  record TruthSieve {n} (U : Ob) (φ : Form n) (ρ : Env n U) : Set₂ where
    field
      holds  : ∀ {V} → Hom V U → Set₁
      closed : ∀ {V W} (g : Hom V U) (h : Hom W V) → holds g → holds (g ∘ h)

  truth : ∀ {n U} (φ : Form n) (ρ : Env n U) → TruthSieve U φ ρ
  TruthSieve.holds (truth {U = U} φ ρ) {V} g = V ⊩ φ [ ρ · g ]
  TruthSieve.closed (truth φ ρ) g h v = invariant φ (·-∘ ρ g h) (monotone φ (ρ · g) h v)

  forces⇔id∈truth : ∀ {n U} (φ : Form n) (ρ : Env n U)
                  → (U ⊩ φ [ ρ ] → TruthSieve.holds (truth φ ρ) idn)
                  × (TruthSieve.holds (truth φ ρ) idn → U ⊩ φ [ ρ ])
  forces⇔id∈truth φ ρ =
      invariant φ (≋i λ i → proj₂ (pull-id (ρ i)) , proj₁ (pull-id (ρ i)))
    , invariant φ (≋i λ i → pull-id (ρ i))

------------------------------------------------------------------------
-- [subobject classifier#3] groups: inhabited sieves on BG are maximal

record Group : Set₁ where
  field
    G     : Set
    e     : G
    _·_   : G → G → G
    inv   : G → G
    idlG  : ∀ g → e · g ≡ g
    idrG  : ∀ g → g · e ≡ g
    assocG : ∀ g h k → (g · h) · k ≡ g · (h · k)
    invr  : ∀ g → g · inv g ≡ e

module Deloop (Gr : Group) where
  open Group Gr

  BG : Category
  Category.Ob BG = ⊤
  Category.Hom BG _ _ = G
  Category.idn BG = e
  Category._∘_ BG = _·_
  Category.idl BG = idlG
  Category.idr BG = idrG
  Category.assoc BG = assocG

  open Sieves BG

  -- every arrow k factors as h ∘ (h⁻¹ ∘ k), so one arrow forces them all
  inhabited→maximal : (S : Sieve tt) {h : G} → mem S {tt} h → maximal tt ≤ S
  inhabited→maximal S {h} m {tt} k _ =
    subst (mem S) eq (closed S h (inv h · k) m)
    where
    eq : h · (inv h · k) ≡ k
    eq = trans (sym (assocG h (inv h) k)) (trans (cong (_· k) (invr h)) (idlG k))

  -- hence a sieve on BG is maximal as soon as it is inhabited, and empty
  -- otherwise: exactly two truth values
  inhabited→≈maximal : (S : Sieve tt) {h : G} → mem S {tt} h → S ≈ maximal tt
  inhabited→≈maximal S m = (λ f _ → tt) , inhabited→maximal S m

  uninhabited→≈empty : (S : Sieve tt) → (∀ (k : G) → ¬ mem S {tt} k) → S ≈ empty tt
  uninhabited→≈empty S none = (λ {tt} f m → none f m) , (λ f ())

------------------------------------------------------------------------
-- The walking arrow 0 → 1

data Two : Set where o0 o1 : Two

ArrHom : Two → Two → Set
ArrHom o0 o0 = ⊤
ArrHom o0 o1 = ⊤
ArrHom o1 o1 = ⊤
ArrHom o1 o0 = ⊥

arrId : ∀ {a} → ArrHom a a
arrId {o0} = tt
arrId {o1} = tt

arrComp : ∀ {a b c} → ArrHom b c → ArrHom a b → ArrHom a c
arrComp {o0} {o0} {o0} _ _ = tt
arrComp {o0} {o0} {o1} _ _ = tt
arrComp {o0} {o1} {o1} _ _ = tt
arrComp {o1} {o1} {o1} _ _ = tt
arrComp {o0} {o1} {o0} () _
arrComp {o1} {o0} _ ()
arrComp {o1} {o1} {o0} () _

-- every Hom-set is a proposition (the category is thin)
arrProp : ∀ {a b} (f g : ArrHom a b) → f ≡ g
arrProp {o0} {o0} tt tt = refl
arrProp {o0} {o1} tt tt = refl
arrProp {o1} {o1} tt tt = refl
arrProp {o1} {o0} ()

Arrow : Category
Category.Ob Arrow = Two
Category.Hom Arrow = ArrHom
Category.idn Arrow = arrId
Category._∘_ Arrow = arrComp
Category.idl Arrow f = arrProp _ f
Category.idr Arrow f = arrProp _ f
Category.assoc Arrow h g f = arrProp _ _

module WalkingArrow where
  open Sieves Arrow
  open KripkeJoyal Arrow

  arr : ArrHom o0 o1
  arr = tt

  -- the sieve {0 → 1} on 1 (it does not contain id_1)
  P : Sieve o1
  mem P {o0} _ = ⊤
  mem P {o1} _ = ⊥
  closed P {o0} {o0} _ _ _ = tt
  closed P {o1} _ _ ()

  -- Omega(1) is not Boolean: P has no complement
  no-complement : (T : Sieve o1) → ¬ ((P ∪ T) ≈ maximal o1 × (P ∩ T) ≈ empty o1)
  no-complement T ((_ , ⊇) , (∩⊆ , _)) with ⊇ {o1} (arrId {o1}) tt
  ... | inj₁ ()
  ... | inj₂ t = ∩⊆ {o0} arr (tt , closed T (arrId {o1}) arr t)

  -- [Kripke-Joyal semantics#4] stage 1 refutes p ∨ ¬p with p := P
  p : Form 1
  p = var F.zero

  env : Env 1 o1
  env _ = P

  stage1-refutes-LEM : ¬ (o1 ⊩ (p ∨ᶠ (¬ᶠ p)) [ env ])
  stage1-refutes-LEM (inj₁ (Level.lift ()))
  stage1-refutes-LEM (inj₂ h) = Level.lower (h {o0} arr (Level.lift tt))

  -- so the closed formula ∀p:Ω. p ∨ ¬p is not forced at stage 1
  LEM : Form 0
  LEM = ∀Ω (var F.zero ∨ᶠ (¬ᶠ var F.zero))

  stage1-refutes-∀LEM : ∀ (ρ : Env 0 o1) → ¬ (o1 ⊩ LEM [ ρ ])
  stage1-refutes-∀LEM ρ h with h {o1} (arrId {o1}) P
  ... | inj₁ (Level.lift ())
  ... | inj₂ k = Level.lower (k {o0} arr (Level.lift tt))

------------------------------------------------------------------------
-- Sieve counts on finite categories, decided by exhaustive enumeration.
-- A finite category: arrows 0..n-1 with target and a composition table.
-- A sieve on c is a set of arrows into c closed under precomposition.

record FinCat : Set where
  field
    nOb  : ℕ
    nArr : ℕ
    tgt  : Fin nArr → Fin nOb
    comp : Fin nArr → Fin nArr → Maybe (Fin nArr)   -- f ∘ g when defined

module Count (K : FinCat) where
  open FinCat K

  arrowsInto : Fin nOb → List (Fin nArr)
  arrowsInto c = filter (λ a → tgt a F.≟ c) (allFin nArr)

  subsets : List (Fin nArr) → List (List (Fin nArr))
  subsets [] = [] ∷ []
  subsets (a ∷ as) = concatMap (λ s → s ∷ (a ∷ s) ∷ []) (subsets as)

  elem : Fin nArr → List (Fin nArr) → Bool
  elem a [] = false
  elem a (b ∷ bs) = ⌊ a F.≟ b ⌋ ∨ elem a bs

  all : List (Fin nArr) → (Fin nArr → Bool) → Bool
  all [] p = true
  all (x ∷ xs) p = p x ∧ all xs p

  isSieve : List (Fin nArr) → Bool
  isSieve s = all s λ f → all (allFin nArr) λ g → ok (comp f g)
    where ok : Maybe (Fin nArr) → Bool
          ok (just h) = elem h s
          ok nothing  = true

  sieveCount : Fin nOb → ℕ
  sieveCount c = length (filter (λ s → Data.Bool._≟_ (isSieve s) true) (subsets (arrowsInto c)))

-- walking arrow: arrows 0 = id_0, 1 = id_1, 2 = (0 → 1)
walkingArrow : FinCat
FinCat.nOb walkingArrow = 2
FinCat.nArr walkingArrow = 3
FinCat.tgt walkingArrow F.zero = F.zero
FinCat.tgt walkingArrow (F.suc F.zero) = F.suc F.zero
FinCat.tgt walkingArrow (F.suc (F.suc F.zero)) = F.suc F.zero
FinCat.comp walkingArrow F.zero F.zero = just F.zero
FinCat.comp walkingArrow (F.suc F.zero) (F.suc F.zero) = just (F.suc F.zero)
FinCat.comp walkingArrow (F.suc F.zero) (F.suc (F.suc F.zero)) = just (F.suc (F.suc F.zero))
FinCat.comp walkingArrow (F.suc (F.suc F.zero)) F.zero = just (F.suc (F.suc F.zero))
FinCat.comp walkingArrow _ _ = nothing

-- the cyclic group Z/n as a one-object category: arrow k composes by addition
cyclic : ℕ → FinCat
FinCat.nOb (cyclic n) = 1
FinCat.nArr (cyclic n) = suc n
FinCat.tgt (cyclic n) _ = F.zero
FinCat.comp (cyclic n) f g = just (addMod f g)
  where
  addMod : Fin (suc n) → Fin (suc n) → Fin (suc n)
  addMod a b = (toℕ a + toℕ b) mod (suc n)

