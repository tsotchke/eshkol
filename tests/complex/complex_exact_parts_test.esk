;; tests/ad/vm_complex_exact_parts_test.esk
;; Ledger SW-199: an exact rational part of a complex number was read as 0 on
;; the VM. The real/complex boundary coerced a part with the immediate-tag
;; reader, which knows fixnums and flonums only, so (make-rectangular 1/2 1/3)
;; printed +0i and every real function that shares that boundary (atan with
;; two arguments, asin, acos, make-polar) saw 0 for a rational argument.
;; Expected values are the native engine's.

(define failures 0)
(define (fail name got want)
  (set! failures (+ failures 1))
  (display "FAIL: ") (display name)
  (display " got=") (display got) (display " want=") (display want) (newline))
(define (check name got want)
  (if (< (magnitude (- got want)) 1e-12)
      (begin (display "  ok   ") (display name) (newline))
      (fail name got want)))

(define z (make-rectangular 1/2 1/3))
(check "real part of (make-rectangular 1/2 1/3)" (real-part z) 0.5)
(check "imag part of (make-rectangular 1/2 1/3)" (imag-part z) (/ 1.0 3.0))
(check "scaled" (* z 6) (make-rectangular 3.0 2.0))
(check "make-rectangular exact integer parts" (make-rectangular 3 -4) (make-rectangular 3.0 -4.0))
(check "magnitude of exact parts" (magnitude (make-rectangular 3/5 4/5)) 1.0)
(check "make-polar exact angle" (make-polar 2 1/2) (make-rectangular (* 2 (cos 0.5)) (* 2 (sin 0.5))))
(check "two-argument atan, exact" (atan 1/2 1) (atan 0.5 1.0))
(check "asin of an exact rational" (asin 1/2) (asin 0.5))
(check "acos of an exact rational" (acos 1/3) (acos (/ 1.0 3.0)))
(check "atan of an exact rational" (atan 1/3) (atan (/ 1.0 3.0)))
(display z) (newline)

(newline)
(if (= failures 0)
    (begin (display "PASS: complex exact parts") (newline) (exit 0))
    (begin (display "FAIL: complex exact parts") (newline) (exit 1)))
