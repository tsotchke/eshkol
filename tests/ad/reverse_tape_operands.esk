(define (refuses-carrier? f)
  (guard (e (#t (and (error-object? e)
                     (equal? (error-object-message e)
                             "reverse-gradient on the VM supports real scalar arithmetic only; complex/dual carriers are unsupported"))))
    (f) #f))
(define rational-slope (reverse-gradient (lambda (x) (* x (/ 1 3))) 2.0))
(define rejects-complex (refuses-carrier? (lambda ()
    (reverse-gradient (lambda (x) (* x (make-rectangular 1.0 2.0))) 2.0))))
(define rejects-dual (refuses-carrier? (lambda ()
    (reverse-gradient (lambda (x) (* x (make-dual 1.0 1.0))) 2.0))))
(display (if (and (< (abs (- rational-slope (/ 1.0 3.0))) 1e-12)
                  rejects-complex rejects-dual)
             "PASS reverse_tape_operands" "FAIL reverse_tape_operands"))
(newline)
