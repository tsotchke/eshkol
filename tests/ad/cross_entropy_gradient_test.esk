;; Native CE must preserve the tape across matmul, broadcast, activation and
;; scalar consumers. The independent finite-difference checks below are only
;; a test oracle; the differentiated path must report zero FD evaluations.
(define failed 0)
(define checked 0)
(define (check name actual expected tolerance)
  (set! checked (+ checked 1))
  (if (< (abs (- actual expected)) tolerance)
      #t
      (begin
        (set! failed (+ failed 1))
        (display "FAIL: ") (display name)
        (display " actual=") (display actual)
        (display " expected=") (display expected) (newline))))
(define (check-pair name g a b)
  (check name (vref g 0) a 1e-10)
  (check name (vref g 1) b 1e-10))
(define labels #(1.0 0.0))
(define point #(0.0 0.0))
(define (loss w) (cross-entropy-loss w labels))
(define (through-call f w) (gradient f w))
(define (make-loss target) (lambda (w) (cross-entropy-loss w target)))
(define captured-loss (make-loss labels))

(check "numeric dense labels" (loss point) (log 2.0) 1e-12)
(check "numeric indexed labels" (cross-entropy-loss point #(0.0)) (log 2.0) 1e-12)
(check-pair "named loss" (gradient loss point) -0.5 0.5)
(check-pair "indirect loss" (through-call loss point) -0.5 0.5)
(check-pair "curried gradient" ((gradient loss) point) -0.5 0.5)
(check-pair "captured labels" (gradient captured-loss point) -0.5 0.5)
(check-pair "indexed labels" (gradient (lambda (w) (cross-entropy-loss w #(0.0))) point) -0.5 0.5)
(check-pair "soft labels" (gradient (lambda (w) (cross-entropy-loss w #(0.25 0.75))) point) 0.25 -0.25)
(check-pair "scaled scalar loss" (gradient (lambda (w) (* -3.0 (loss w))) point) 1.5 -1.5)
(check-pair "nonlinear scalar loss" (gradient (lambda (w) (exp (loss w))) point) -1.0 1.0)
(define stable-g (gradient loss #(1000.0 999.0)))
(define stable-p (/ 1.0 (+ 1.0 (exp -1.0))))
(check-pair "large logits" stable-g (- stable-p 1.0) (- 1.0 stable-p))

(define batch-point (reshape #(0.0 0.0 0.0 0.0) 2 2))
(define batch-labels (reshape #(1.0 0.0 0.0 1.0) 2 2))
(define batch-g (gradient (lambda (w) (cross-entropy-loss w batch-labels)) batch-point))
(define index-g (gradient (lambda (w) (cross-entropy-loss w #(0.0 1.0))) batch-point))
(check "batch mean 00" (tensor-ref batch-g 0 0) -0.25 1e-12)
(check "batch mean 01" (tensor-ref batch-g 0 1) 0.25 1e-12)
(check "batch mean 10" (tensor-ref batch-g 1 0) 0.25 1e-12)
(check "batch mean 11" (tensor-ref batch-g 1 1) -0.25 1e-12)
(check "indexed batch 00" (tensor-ref index-g 0 0) -0.25 1e-12)
(check "indexed batch 11" (tensor-ref index-g 1 1) -0.25 1e-12)

;; Original training example, with every weight checked (not only one slope).
(define x (reshape #(1.0 2.0 3.0 4.0) 2 2))
(define W1 (reshape #(0.1 0.2 0.3 0.4) 2 2))
(define W2 (reshape #(0.5 0.6 0.7 0.8) 2 2))
(define b1 #(0.0 0.0))
(define b2 #(0.0 0.0))
(define (batch-loss w1 w2)
  (cross-entropy-loss
    (tensor-add (matmul (gelu (tensor-add (matmul x w1) b1)) w2) b2)
    batch-labels))
(ad-reset-counters!)
(define g1 (gradient (lambda (w) (batch-loss w W2)) W1))
(define g2 (gradient (lambda (w) (batch-loss W1 w)) W2))
(check "AD does not use finite differences" (ad-finite-difference-evals) 0 0.5)
(check "gradient keeps W1 rank" (length (tensor-shape g1)) 2 0.5)
(check "gradient keeps W2 rank" (length (tensor-shape g2)) 2 0.5)
(define (perturb1 i j h)
  (let ((w (reshape (vector 0.1 0.2 0.3 0.4) 2 2)))
    (tensor-set! w i j (+ (tensor-ref w i j) h))
    w))
(define (perturb2 i j h)
  (let ((w (reshape (vector 0.5 0.6 0.7 0.8) 2 2)))
    (tensor-set! w i j (+ (tensor-ref w i j) h))
    w))
(do ((i 0 (+ i 1))) ((= i 2))
  (do ((j 0 (+ j 1))) ((= j 2))
    (let ((fd1 (/ (- (batch-loss (perturb1 i j 0.000001) W2)
                     (batch-loss (perturb1 i j -0.000001) W2)) 0.000002))
          (fd2 (/ (- (batch-loss W1 (perturb2 i j 0.000001))
                     (batch-loss W1 (perturb2 i j -0.000001))) 0.000002)))
      (check "W1 gradient vs FD" (tensor-ref g1 i j) fd1 1e-6)
      (check "W2 gradient vs FD" (tensor-ref g2 i j) fd2 1e-6))))

;; An ordinary numeric loss call after differentiation must still run.
(check "numeric loss after AD" (mse-loss #(1.0 3.0) #(0.0 1.0)) 2.5 1e-12)
(display "cross_entropy_gradient_test: ")
(display checked) (display " checks, ") (display failed) (display " failures") (newline)
(if (= failed 0)
    (display "cross_entropy_gradient_test: ALL PASS\n")
    (exit 1))
