;; tests/ad/vm_inverse_trig_orders_test.esk
;; Ledger SW-218: higher-order derivatives of the inverse trigonometric and
;; hyperbolic functions. The VM read asin/acos/atan through a first-order
;; (value, tangent) rule, so (derivative-n asin 0.3 2) answered the FIRST
;; derivative 1.048 instead of 0.3456. Each function is now the integral of
;; g(u) u' in the carrier arithmetic (s_k = (1/k) sum j u_j g_{k-j}), which
;; carries every order and nests. Expected values are the closed forms.

(define failures 0)
(define (fail name got want)
  (set! failures (+ failures 1))
  (display "FAIL: ") (display name)
  (display " got=") (display got) (display " want=") (display want) (newline))
(define (check name got want)
  (if (< (abs (- got want)) 1e-9)
      (begin (display "  ok   ") (display name) (newline))
      (fail name got want)))

(define (sq x) (* x x))
;; asin'' = x/(1-x^2)^(3/2), acos'' = -asin'', atan'' = -2x/(1+x^2)^2
(check "asin d2 at 0.3" (derivative-n asin 0.3 2) (/ 0.3 (expt (- 1 (sq 0.3)) 1.5)))
(check "acos d2 at 0.3" (derivative-n acos 0.3 2) (- (/ 0.3 (expt (- 1 (sq 0.3)) 1.5))))
(check "atan d2 at 0.7" (derivative-n atan 0.7 2) (/ (* -2 0.7) (sq (+ 1 (sq 0.7)))))
;; atan''' = (6x^2 - 2)/(1+x^2)^3
(check "atan d3 at 0.5" (derivative-n (lambda (x) (atan x)) 0.5 3) (/ (- (* 6 (sq 0.5)) 2) (expt 1.25 3)))
;; asinh'' = -x/(1+x^2)^(3/2), atanh'' = 2x/(1-x^2)^2, acosh'' = -x/(x^2-1)^(3/2)
(check "asinh d2 at 0.7" (derivative-n asinh 0.7 2) (- (/ 0.7 (expt (+ 1 (sq 0.7)) 1.5))))
(check "atanh d2 at 0.4" (derivative-n atanh 0.4 2) (/ (* 2 0.4) (sq (- 1 (sq 0.4)))))
(check "acosh d2 at 2" (derivative-n acosh 2.0 2) (- (/ 2.0 (expt 3.0 1.5))))
;; two-argument atan is atan(y/x): d2/dy2 atan(y/2) at 0.5 = -2(y/2)/(4(1+(y/2)^2)^2)
(check "atan2 d2 in y" (derivative-n (lambda (y) (atan y 2.0)) 0.5 2) (/ (* -4 0.5) (sq (+ 4 (sq 0.5)))))
;; nested through a captured variable: d/da atan''(a x) = -1.437696 at (1.5, 0.5)
(check "d/da d2/dx2 atan(a x)"
       (derivative (lambda (a) (derivative-n (lambda (x) (atan (* a x))) 0.5 2)) 1.5) -1.437696)
;; exactness at an exact point: atan's g is rational, so d3 at 0 is exact -2
(let ((v (derivative-n atan 0 3)))
  (if (and (exact? v) (= v -2))
      (begin (display "  ok   atan d3 at exact 0 is exact -2") (newline))
      (fail "atan d3 at exact 0" v -2)))

(newline)
(if (= failures 0)
    (begin (display "PASS: inverse trig orders") (newline) (exit 0))
    (begin (display "FAIL: inverse trig orders") (newline) (exit 1)))
