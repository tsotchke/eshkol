;; tests/ad/vm_math_first_class_test.esk
;; Ledger SW-220 (VM surface): asinh, acosh, atanh, log2, log10, exp2, cbrt,
;; square, inexact and atan2 are first-class values on the VM, on every
;; number kind, and carry derivatives. Before, each was an undefined variable
;; and calling one was a fatal "calling non-function".

(define failures 0)
(define (fail name got want)
  (set! failures (+ failures 1))
  (display "FAIL: ") (display name)
  (display " got=") (display got) (display " want=") (display want) (newline))
(define (check name got want)
  (if (< (magnitude (- got want)) 1e-12)
      (begin (display "  ok   ") (display name) (newline))
      (fail name got want)))

(define fs (list asinh acosh atanh log2 log10 exp2 cbrt square inexact))
(define vals (map (lambda (f) (f 0.5)) fs))
(check "asinh" (list-ref vals 0) 0.48121182505960347)
(check "atanh" (list-ref vals 2) 0.5493061443340549)
(check "log2" (list-ref vals 3) -1.0)
(check "log10" (list-ref vals 4) -0.3010299956639812)
(check "exp2" (list-ref vals 5) 1.4142135623730951)
(check "cbrt" (list-ref vals 6) 0.7937005259840998)
(check "square" (list-ref vals 7) 0.25)
(check "inexact" (list-ref vals 8) 0.5)
(check "atan2" (atan2 1.0 1.0) (atan 1.0 1.0))
(check "cbrt of a negative" (cbrt -8.0) -2.0)
(check "square of an exact rational" (square 1/2) 1/4)
(check "asinh of a complex" (asinh (make-rectangular 1.0 1.0))
       (make-rectangular 1.0612750619050357 0.6662394324925153))
(check "d2/dx2 (log2 x)^2 at 2" (derivative-n (lambda (x) (square (log2 x))) 2.0 2)
       (/ (* 2 (- 1 (log 2.0))) (* 4 (log 2.0) (log 2.0))))
(check "d/dx exp2 at 1" (derivative exp2 1.0) (* 2 (log 2.0)))
(check "d2 cbrt at 8" (derivative-n cbrt 8.0 2) (/ -2.0 (* 9 (expt 8.0 (/ 5.0 3.0)))))
(check "d/dx inexact x" (derivative (lambda (x) (inexact (* x x))) 1/3) (/ 2.0 3.0))

(newline)
(if (= failures 0)
    (begin (display "PASS: VM first-class math") (newline) (exit 0))
    (begin (display "FAIL: VM first-class math") (newline) (exit 1)))
