;; SW-214 regression: `square`, `exact->inexact`/`inexact` and `magnitude` of
;; a real number keep the derivative a forward jet, a Taylor tower or a level
;; carries, and `square` of an exact or complex number is its product.
(define failures 0)
(define checks 0)
(define (check name got expected)
  (set! checks (+ checks 1))
  (if (and (number? got)
           (<= (magnitude (- got expected)) (+ 1e-12 (* 1e-9 (magnitude expected)))))
      #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (display " got ")
             (write got) (display " want ") (write expected) (newline))))
(define (check-exact name got expected)
  (set! checks (+ checks 1))
  (if (and (exact? got) (= got expected))
      #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (display " got ")
             (write got) (display " want exact ") (write expected) (newline))))
(define (check-inexact name got expected)
  (set! checks (+ checks 1))
  (if (and (inexact? got) (= got expected))
      #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (display " got ")
             (write got) (display " want inexact ") (write expected) (newline))))

;; square
(check "square jet d1" (derivative (lambda (x) (square x)) 1.3) 2.6)
(check "square tower d1" (derivative-n (lambda (x) (square x)) 1.3 1) 2.6)
(check "square tower d2" (derivative-n (lambda (x) (square x)) 1.3 2) 2.0)
(check "square of sin d3" (derivative-n (lambda (x) (square (sin x))) 0.4 3)
       (* -4.0 (sin 0.8)))
(check "square level" (derivative-n (lambda (x) (derivative (lambda (y) (square (* x y))) 1.0)) 1.5 1)
       6.0)
(check "square nested jets" (derivative (lambda (x) (derivative (lambda (y) (square y)) x)) 1.3) 2.0)
(check "square gradient" (vector-ref (gradient (lambda (v) (square (vector-ref v 0))) (vector 3.0)) 0) 6.0)
(check-exact "square exact tower d1" (derivative-n square 3 1) 6)
(check-exact "square exact tower d2" (derivative-n square 3 2) 2)
(check-exact "square of a rational" (square 1/2) 1/4)
(check-exact "square of a bignum" (square 12345678901234567890) 152415787532388367501905199875019052100)
(check "square of a complex" (square (make-rectangular 1.0 2.0)) (make-rectangular -3.0 4.0))
(check "square complex carrier" (derivative (lambda (w) (square w)) (make-rectangular 1.0 1.0))
       (make-rectangular 2.0 2.0))

;; exact->inexact / inexact
(check "inexact jet" (derivative (lambda (x) (inexact x)) 1.3) 1.0)
(check "exact->inexact tower d1" (derivative-n (lambda (x) (exact->inexact (* x x))) 1.3 1) 2.6)
(check "inexact tower d2" (derivative-n (lambda (x) (* x (inexact (* x x)))) 1.3 2) 7.8)
(check-inexact "inexact of an exact tower" (derivative-n (lambda (x) (inexact (* x x))) 2 1) 4.0)
(check "inexact level" (derivative-n (lambda (x) (derivative (lambda (y) (inexact (* x y))) 1.0)) 1.5 1) 1.0)
(check-inexact "inexact of a rational" (inexact 1/2) 0.5)

;; magnitude and abs of a real carrier
(check "magnitude jet" (derivative magnitude -1.3) -1.0)
(check "magnitude tower" (derivative-n (lambda (x) (magnitude (* x x x))) -1.3 1) (* -3.0 1.69))
(check "magnitude tower d2" (derivative-n (lambda (x) (magnitude (* x x x))) -1.3 2) 7.8)
(check "magnitude level" (derivative-n (lambda (x) (derivative (lambda (y) (magnitude (* x y))) 1.0)) -1.5 1) -1.0)
(check "abs level" (derivative-n (lambda (x) (derivative (lambda (y) (abs (* x y))) 1.0)) -1.5 1) -1.0)

(if (= failures 0)
    (begin (display "PASS: unary_numeric_builtin_carriers ") (display checks) (newline))
    (begin (display "FAIL: ") (display failures) (display " of ") (display checks) (newline)))
