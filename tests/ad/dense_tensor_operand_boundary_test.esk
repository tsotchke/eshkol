;; ─────────────────────────────────────────────────────────────────────────
;;  A dense tensor AD node is a tensor wherever a tensor is read
;; ─────────────────────────────────────────────────────────────────────────
;;
;;  The dense reverse path publishes the result of matmul, tensor-add and the
;;  other dense operators as ONE AD node whose tensor_value is an f64 buffer.
;;  Every operator with a dense rule of its own understood that node; every
;;  other consumer read its operand through the tensor boundary
;;  (eshkol_tensor_operand_checked) or classified it by hand, and neither had
;;  a case for it. tensor-dot, reshape, tensor-scale, relu, tensor-exp,
;;  tensor-sqrt, softmax and tensor-get raised "expected tensor, got ad-node";
;;  tensor-ref returned the whole node; vector-length, vector-ref and
;;  vector->list misread it as a Scheme vector (SW-181).
;;
;;  A dense node is now resolved, in one place, to the tensor of its shape
;;  whose elements are AD_NODE_DENSE_ELEM projections, so every scalarising
;;  rule applies unchanged and the reverse sweep scatters each element's
;;  adjoint back into the dense node. Operators with dense rules keep them.
;;
;;  Every check pins the analytic value at x = (1, 2, 3) with A = I, so
;;  (matmul A x) = x and each expected gradient is the textbook one. Runs
;;  identically under -r with and without the run cache, and as a compiled
;;  binary; prints a PASS/FAIL summary and exits non-zero on any failure.
;; ─────────────────────────────────────────────────────────────────────────

(define npass 0)
(define nfail 0)

(define (rel-ok got want)
  (let ((d (abs (- got want))))
    (or (< d 1e-9)
        (< (/ d (+ 1e-30 (abs want))) 1e-9))))

(define (report-fail name got)
  (set! nfail (+ nfail 1))
  (display "FAIL: ") (display name) (display " got ") (display got) (newline))

(define (check name got want)
  (if (and (number? got) (rel-ok got want))
      (set! npass (+ npass 1))
      (report-fail name got)))

(define (check-vec name got want)
  (let loop ((i 0) (w want) (ok #t))
    (if (null? w)
        (if ok (set! npass (+ npass 1)) (report-fail name got))
        (let ((g (vref got i)))
          (loop (+ i 1) (cdr w) (and ok (number? g) (rel-ok g (car w))))))))

(define x0 #(1.0 2.0 3.0))
(define (Ax x) (matmul (eye 3) x))
(define nonsym-A (reshape #(2.0 3.0 5.0 7.0) '(2 2)))

;; Dense AD nodes remain tensor/vector values even while the tape is active
;; (SW-188), and jacobian accepts a dense tensor-valued function result
;; (SW-187).  These are representation-boundary checks, not just arithmetic
;; checks, so a CALLABLE wrapper cannot regress unnoticed.
(check-vec "tensor/vector predicates on dense result"
           (gradient (lambda (x)
                       (let ((d (Ax x)))
                         (if (and (tensor? d) (vector? d))
                             (tensor-sum d)
                             0.0)))
                    x0)
           '(1.0 1.0 1.0))
(define nonsym-J (jacobian (lambda (v) (matmul nonsym-A v)) #(1.0 2.0)))
(check "jacobian dense result nonsym [0,0]" (tensor-ref nonsym-J 0 0) 2.0)
(check "jacobian dense result nonsym [0,1]" (tensor-ref nonsym-J 0 1) 3.0)
(check "jacobian dense result nonsym [1,0]" (tensor-ref nonsym-J 1 0) 5.0)
(check "jacobian dense result nonsym [1,1]" (tensor-ref nonsym-J 1 1) 7.0)

;; ── The ledger program: x . (A x) has gradient (A + A^T) x = 2x ──────────
(check-vec "ledger: tensor-dot x (matmul A x)" (gradient (lambda (x) (tensor-dot x (Ax x))) x0) '(2.0 4.0 6.0))
(check-vec "tensor-dot (matmul A x) x"        (gradient (lambda (x) (tensor-dot (Ax x) x)) x0) '(2.0 4.0 6.0))

;; ── Every tensor builtin that refused the dense node ─────────────────────
(check-vec "reshape"      (gradient (lambda (x) (tensor-sum (reshape (Ax x) '(3 1)))) x0) '(1.0 1.0 1.0))
(check-vec "tensor-scale" (gradient (lambda (x) (tensor-sum (tensor-scale (Ax x) 2.0))) x0) '(2.0 2.0 2.0))
(check-vec "relu"         (gradient (lambda (x) (tensor-sum (relu (Ax x)))) x0) '(1.0 1.0 1.0))
(check-vec "tensor-exp"   (gradient (lambda (x) (tensor-sum (tensor-exp (Ax x)))) x0)
           (list (exp 1.0) (exp 2.0) (exp 3.0)))
(check-vec "tensor-sqrt"  (gradient (lambda (x) (tensor-sum (tensor-sqrt (Ax x)))) x0)
           (list (/ 0.5 (sqrt 1.0)) (/ 0.5 (sqrt 2.0)) (/ 0.5 (sqrt 3.0))))
;; softmax sums to 1, so the gradient of its sum is 0 everywhere.
(check-vec "softmax"      (gradient (lambda (x) (tensor-sum (softmax (Ax x)))) x0) '(0.0 0.0 0.0))
(check-vec "tensor-get"   (gradient (lambda (x) (tensor-get (Ax x) 1)) x0) '(0.0 1.0 0.0))
(check-vec "tensor-ref"   (gradient (lambda (x) (tensor-ref (Ax x) 1)) x0) '(0.0 1.0 0.0))
(check-vec "two tensor-refs"
           (gradient (lambda (x) (let ((y (Ax x))) (+ (tensor-ref y 0) (* 2.0 (tensor-ref y 2))))) x0)
           '(1.0 0.0 2.0))

;; ── The collection builtins that misread it ──────────────────────────────
(check-vec "vector-length"  (gradient (lambda (x) (let ((d (Ax x))) (* (vector-length d) (tensor-sum d)))) x0) '(3.0 3.0 3.0))
(check-vec "vector-ref"     (gradient (lambda (x) (vector-ref (Ax x) 1)) x0) '(0.0 1.0 0.0))
(check-vec "vector->list"   (gradient (lambda (x) (fold-left + 0.0 (vector->list (Ax x)))) x0) '(1.0 1.0 1.0))

;; ── A chain through both representations ────────────────────────────────
(check-vec "scale of matmul into tensor-dot"
           (gradient (lambda (x) (tensor-dot (tensor-scale (Ax x) 2.0) x)) x0) '(4.0 8.0 12.0))
;; The stdlib's tensor-norm is sqrt(tensor-dot v v) written over vref and
;; vector-length; its gradient is x / |x|.
(define inv-norm (/ 1.0 (sqrt 14.0)))
(check-vec "stdlib tensor-norm of matmul"
           (gradient (lambda (x) (tensor-norm (Ax x))) x0)
           (list (* 1.0 inv-norm) (* 2.0 inv-norm) (* 3.0 inv-norm)))

;; ── Controls: operators that already had dense rules, and plain values ───
(check-vec "control: tensor-sum of matmul"        (gradient (lambda (x) (tensor-sum (Ax x))) x0) '(1.0 1.0 1.0))
(check-vec "control: tensor-add with x"           (gradient (lambda (x) (tensor-sum (tensor-add (Ax x) x))) x0) '(2.0 2.0 2.0))
(check-vec "control: tensor-mul with x"           (gradient (lambda (x) (tensor-sum (tensor-mul (Ax x) x))) x0) '(2.0 4.0 6.0))
(check-vec "control: matmul of matmul"            (gradient (lambda (x) (tensor-sum (Ax (Ax x)))) x0) '(1.0 1.0 1.0))
(check-vec "control: tensor-max"                  (gradient (lambda (x) (tensor-max (Ax x))) x0) '(0.0 0.0 1.0))
(check-vec "control: tensor-dot of scalarised"    (gradient (lambda (x) (tensor-dot x (tensor-scale x 2.0))) x0) '(4.0 8.0 12.0))
(check "control: value outside differentiation"   (tensor-dot (Ax x0) x0) 14.0)
(check "control: tensor-ref outside differentiation" (tensor-ref (Ax x0) 1) 2.0)

(if (= nfail 0)
    (begin
      (display "PASS: dense_tensor_operand_boundary ")
      (display npass) (display "/") (display npass)
      (display " checks") (newline))
    (begin
      (display "FAIL: dense_tensor_operand_boundary ")
      (display nfail) (display " of ") (display (+ npass nfail))
      (display " checks failed") (newline)
      (exit 1)))
