;; ─────────────────────────────────────────────────────────────────────────
;;  A gradient point given as separate scalar arguments is evaluated
;; ─────────────────────────────────────────────────────────────────────────
;;
;;  `(gradient f a b ...)` is sugar for the vector point `(gradient f #(a b ...))`.
;;  The parser used to assemble its own node for that form, of a kind whose
;;  lowering only understood raw numeric literals and stored 0 for any other
;;  element. A point argument that was a variable, a parameter, a loop variable
;;  or a call was therefore read as 0: the gradient came back evaluated at the
;;  origin, with exit status 0 and no diagnostic (SW-182). A gradient-descent
;;  loop written this way repeated its first step forever.
;;
;;  The form is now parsed as the vector literal it stands for, so every point
;;  argument is an ordinary expression.
;;
;;  Every check pins the analytic value. The vector, list and `#(...)` point
;;  forms and the other operators already evaluated their points and are kept
;;  as controls, so that every operator's point goes through this file. Runs
;;  identically under -r with and without the run cache, and as a compiled
;;  binary; prints a PASS/FAIL summary and exits non-zero on any failure.
;; ─────────────────────────────────────────────────────────────────────────

(define npass 0)
(define nfail 0)

(define (rel-ok got want)
  (let ((d (abs (- got want))))
    (or (< d 1e-9)
        (< (/ d (+ 1e-30 (abs want))) 1e-9))))

(define (report-fail name got)
  (set! nfail (+ nfail 1))
  (display "FAIL: ") (display name) (display " got ") (display got) (newline))

(define (check name got want)
  (if (and (number? got) (rel-ok got want))
      (set! npass (+ npass 1))
      (report-fail name got)))

;; `want` is a list of the expected components.
(define (check-vec name got want)
  (let loop ((i 0) (w want) (ok #t))
    (if (null? w)
        (if ok (set! npass (+ npass 1)) (report-fail name got))
        (let ((g (vref got i)))
          (loop (+ i 1) (cdr w) (and ok (number? g) (rel-ok g (car w))))))))

;; `want` is a list of rows.
(define (check-mat name got want)
  (let rows ((i 0) (wr want) (ok #t))
    (if (null? wr)
        (if ok (set! npass (+ npass 1)) (report-fail name got))
        (let cols ((j 0) (wc (car wr)) (ok2 ok))
          (if (null? wc)
              (rows (+ i 1) (cdr wr) ok2)
              (let ((g (tensor-ref got i j)))
                (cols (+ j 1) (cdr wc) (and ok2 (number? g) (rel-ok g (car wc))))))))))

;; ── The ledger program ───────────────────────────────────────────────────
;; loss(a,b) = (a-3)^2 + (b-1)^2, so grad = (2(a-3), 2(b-1)); at (0.6, 0.2) it
;; is (-4.8, -1.6). At the origin it is (-6, -2), which is what every
;; non-literal form used to print.
(define (loss a b) (+ (* (- a 3.0) (- a 3.0)) (* (- b 1.0) (- b 1.0))))
(define p 0.6)
(define q 0.2)
(check-vec "ledger: literal scalars"      (gradient loss 0.6 0.2)               '(-4.8 -1.6))
(check-vec "ledger: variable scalars"     (gradient loss p q)                   '(-4.8 -1.6))
(check-vec "ledger: expression scalars"   (gradient loss (+ p 0.0) (+ q 0.0))   '(-4.8 -1.6))
(check-vec "ledger: list point"           (gradient loss (list p q))            '(-4.8 -1.6))

;; ── Every kind of point expression ───────────────────────────────────────
;; f(a,b) = a^2 b + b^3: grad = (2ab, a^2 + 3b^2) = (12, 31) at (2, 3).
(define (f2 a b) (+ (* (* a a) b) (* b (* b b))))
(define u 2.0)
(define w 3.0)
(define one 1.0)
(check-vec "scalars: globals"             (gradient f2 u w)                     '(12.0 31.0))
(check-vec "scalars: calls"               (gradient f2 (* u 1.0) (- w 0.0))     '(12.0 31.0))
(check-vec "scalars: literal then variable" (gradient f2 2.0 w)                 '(12.0 31.0))
(check-vec "scalars: variable then literal" (gradient f2 u 3.0)                 '(12.0 31.0))
(define (via-params a b) (gradient f2 a b))
(check-vec "scalars: parameters"          (via-params 2.0 3.0)                  '(12.0 31.0))
(check-vec "scalars: let-bound"           (let ((a 2.0) (b 3.0)) (gradient f2 a b)) '(12.0 31.0))
(check-vec "scalars: named-let loop variables"
           (let loop ((i 0) (a 0.0) (b 1.0))
             (if (= i 2) (gradient f2 a b) (loop (+ i 1) (+ a 1.0) (+ b 1.0))))
           '(12.0 31.0))
(check-vec "scalars: inside a lambda"     ((lambda (a b) (gradient f2 a b)) 2.0 3.0) '(12.0 31.0))
(check-vec "scalars: three arguments"
           (gradient (lambda (x y z) (* x (* y z))) one u w)
           '(6.0 3.0 2.0))

;; ── The loop the defect broke ────────────────────────────────────────────
;; 100 steps of gradient descent on `loss` from the origin with rate 0.1. The
;; error contracts by 0.8 per step, so the iterate is (3, 1) to 1e-8. With the
;; point read as 0 every step was the first step and it ended at (60, 20).
(define (descend a b n)
  (if (= n 0)
      (vector a b)
      (let ((g (gradient loss a b)))
        (descend (- a (* 0.1 (vref g 0))) (- b (* 0.1 (vref g 1))) (- n 1)))))
(define trained (descend 0.0 0.0 100))
(check "descent: a converges to 3" (if (< (abs (- (vref trained 0) 3.0)) 1e-8) 1.0 0.0) 1.0)
(check "descent: b converges to 1" (if (< (abs (- (vref trained 1) 1.0)) 1e-8) 1.0 0.0) 1.0)

;; ── Controls: point forms and operators that already evaluated the point ─
(define (fv v) (let ((a (vref v 0)) (b (vref v 1))) (+ (* (* a a) b) (* b (* b b)))))
(define (F v) (vector (* (vref v 0) (vref v 1)) (+ (vref v 0) (vref v 1))))
(define (C v) (vector (* (vref v 1) (vref v 2))
                      (* 2.0 (* (vref v 0) (vref v 2)))
                      (* 3.0 (* (vref v 0) (vref v 1)))))
(define (cube x) (* x (* x x)))
(check-vec "control: gradient (vector u w)"  (gradient fv (vector u w))   '(12.0 31.0))
(check-vec "control: gradient (list u w)"    (gradient fv (list u w))     '(12.0 31.0))
(check-vec "control: gradient #(u w)"        (gradient fv #(u w))         '(12.0 31.0))
;; H = ((2b, 2a), (2a, 6b)) = ((6, 4), (4, 18)); the Laplacian is its trace.
(check-mat "control: hessian (vector u w)"   (hessian fv (vector u w))    '((6.0 4.0) (4.0 18.0)))
(check-mat "control: hessian #(u w)"         (hessian fv #(u w))          '((6.0 4.0) (4.0 18.0)))
(check     "control: laplacian"              (laplacian fv (vector u w))  24.0)
;; J = ((v1, v0), (1, 1)) = ((3, 2), (1, 1)); the divergence is its trace.
(check-mat "control: jacobian"               (jacobian F (vector u w))    '((3.0 2.0) (1.0 1.0)))
(check     "control: divergence"             (divergence F (vector u w))  4.0)
;; curl C = (3x - 2x, y - 3y, 2z - z) = (x, -2y, z) = (1, -4, 3) at (1, 2, 3).
(check-vec "control: curl"                   (curl C (vector one u w))    '(1.0 -4.0 3.0))
(check     "control: directional-derivative" (directional-derivative fv (vector u w) (vector 1.0 0.0)) 12.0)
(check     "control: directional-derivative, computed direction"
           (directional-derivative fv (vector u w) (vector (- one 1.0) one)) 31.0)
(check     "control: derivative at a variable"   (derivative cube u)            12.0)
(check     "control: derivative at a call"       (derivative cube (+ one one))  12.0)
(define (d-param t) (derivative cube t))
(check     "control: derivative at a parameter"  (d-param 3.0)                  27.0)

(if (= nfail 0)
    (begin
      (display "PASS: gradient_scalar_point_arguments ")
      (display npass) (display "/") (display npass)
      (display " checks") (newline))
    (begin
      (display "FAIL: gradient_scalar_point_arguments ")
      (display nfail) (display " of ") (display (+ npass nfail))
      (display " checks failed") (newline)
      (exit 1)))
