(require core.ad.taylor_numerics)

(define passed 0)
(define failed 0)

(define (nth xs n)
  (if (= n 0) (car xs) (nth (cdr xs) (- n 1))))

(define (check-exact name got expected)
  (if (and (exact? got) (= got expected))
      (set! passed (+ passed 1))
      (begin
        (set! failed (+ failed 1))
        (display "FAIL ") (display name)
        (display " got=") (write got)
        (display " expected=") (write expected)
        (newline))))

(define big (+ (expt 2 100) 1))

(check-exact
 "exact zero through derivative-n order-zero projection"
 (derivative
  (lambda (y)
    (derivative-n (lambda (x) (abs (+ x y))) 0 0))
  0)
 0)

(check-exact
 "nested scalar gradients retain exact mixed readback"
 (gradient
  (lambda (z)
    (gradient
     (lambda (y)
       (with-region 'exact-remaining-nested
         (derivative-n (lambda (x) (* (* x y) z)) big 0)))
     (/ 1 3)))
  (/ 1 5))
 big)

(define (inverse-c1 y z x0)
  (nth
   (taylor-inverse-series
    (lambda (x) (+ (* x x) (* (+ y z) x)))
    x0 2)
   1))

(check-exact
 "inverse-series two foreign epochs"
 (derivative-n
  (lambda (z) (gradient (lambda (y) (inverse-c1 y z 0)) 3))
  2 1)
 (/ 2 125))

(define user-den (+ (* 2 big) 5))
(check-exact
 "inverse-series two foreign epochs at bignum base"
 (derivative-n
  (lambda (z) (gradient (lambda (y) (inverse-c1 y z big)) 3))
  2 1)
 (/ 2 (* user-den user-den user-den)))

(check-exact
 "exact ODE coefficient zeros"
 (taylor-ode-solve (lambda (t y) 1) big 0 1 2 1)
 (+ big 1))

(display "exact-remaining-compositions checks=")
(display passed) (display "/") (display (+ passed failed)) (newline)
(if (= failed 0)
    (begin (display "PASS: exact remaining compositions 5/5") (newline))
    (error "exact remaining compositions failed"))
