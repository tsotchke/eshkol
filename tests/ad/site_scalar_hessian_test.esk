;; Published AD-guide example: second derivatives retain exact rational seeds.
(define (quartic x) (expt x 4))
(define (check actual expected)
  (if (equal? actual expected) #t (error "site scalar Hessian mismatch" actual expected)))
(check (hessian quartic 1/3) 4/3)
(check (exact? (hessian quartic 1/3)) #t)
(check (hessian quartic 2) 48)
(check (hessian (lambda (x) (* x x x)) 1/3) 2)
(check (hessian (lambda (x) 7) 1/3) 0)
(check (hessian (lambda (x) x) 1/3) 0)
(if (< (abs (- (hessian quartic 0.3333333333333333) (/ 4.0 3.0))) 1e-12)
    #t (error "inexact Hessian disagrees"))
(display "site scalar Hessian PASS")
(newline)
