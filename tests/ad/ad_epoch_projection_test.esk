(define passed 0)
(define failed 0)

(define (check name got expected exact-required)
  (if (and (= got expected) (or (not exact-required) (exact? got)))
      (set! passed (+ passed 1))
      (begin
        (set! failed (+ failed 1))
        (display "FAIL ") (display name)
        (display " got=") (write got)
        (display " expected=") (write expected)
        (display " exact-required=") (write exact-required)
        (newline))))

(define big (+ (expt 2 100) 1))

(check "captured foreign inexact epoch"
       (derivative-n
        (lambda (p) (derivative-n (lambda (x) (* x p)) 2.0 0))
        3.0 1)
       2.0 #f)

(check "captured foreign exact epoch"
       (derivative-n
        (lambda (p) (derivative-n (lambda (x) (* x p)) big 0))
        (/ 1 3) 1)
       big #t)

(check "taylor gradient taylor"
       (derivative-n
        (lambda (z)
          (gradient
           (lambda (y)
             (derivative-n (lambda (x) (* x y)) z 0))
           3))
        2 1)
       1 #t)

(check "exact tagged gradient readback"
       (gradient
        (lambda (y) (derivative-n (lambda (x) (* x y)) big 0))
        (/ 1 3))
       big #t)

(check "exact tagged gradient readback through region"
       (gradient
        (lambda (y)
          (with-region 'ad-epoch-projection
            (derivative-n (lambda (x) (* x y)) big 0)))
        (/ 1 3))
       big #t)

(check "exact division adjoint readback"
       (gradient
        (lambda (y) (derivative-n (lambda (x) (/ x y)) big 0))
        3)
       (/ (- big) 9) #t)

(display "ad-epoch-projection checks=")
(display passed) (display "/") (display (+ passed failed)) (newline)
(if (= failed 0)
    (begin (display "PASS: AD epoch projection 6/6") (newline))
    (error "AD epoch projection regression failed"))
