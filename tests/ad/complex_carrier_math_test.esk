;; SW-211 regression: complex `expt`, `log`, `angle` and every complex
;; procedure with a plain complex kernel keep the derivative a complex
;; value carries. Generated by tests/ad/gen_complex_carrier_math_test.py.
(define failures 0)
(define checks 0)
(define (close? got expected)
  (<= (abs (- got expected)) (+ 1e-12 (* 1e-9 (abs expected)))))
(define (check-z name got r i)
  (set! checks (+ checks 1))
  (if (and (number? got) (close? (real-part got) r) (close? (imag-part got) i))
      #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (display " got ") (write got)
             (display " want ") (write r) (display " ") (write i) (newline))))

;; The review's cases.
(check-z "d1 of w^3 at 1+1i" (derivative (lambda (w) (expt w 3)) (make-rectangular 1 1)) 0.0 6.0)
(check-z "derivative-n log at 1+1i" (derivative-n log (make-rectangular 1 1) 1) 0.5 -0.5)
(check-z "angle along the real axis" (derivative (lambda (t) (angle (make-rectangular t 1.0))) 1.0) -0.5 0.0)
(check-z "angle along the imaginary axis" (derivative (lambda (t) (angle (make-rectangular 1.0 t))) 1.0) 0.5 0.0)

