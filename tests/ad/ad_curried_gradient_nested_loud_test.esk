;; ESH-0096 / ledger SW-05 — a first-class `gradient` closure differentiated
;; again by an enclosing REVERSE-mode pass.
;;
;; `(jacobian (gradient f) point)` used to answer `#((0))` where the direct
;; `(hessian f point)` answers `#((12))` on the same build, and for
;; `f(v) = v0*v0` the same route SIGBUSed: the runtime-closure gradient reads
;; its point components as raw doubles, so an enclosing reverse pass's
;; `ad_node_t*` components were bitcast into a subnormal ~1e-310 — the inner
;; gradient was evaluated at ~0 and its result carried no edge back to the
;; outer tape.
;;
;; The composition is NOT supported yet (it needs the forward-over-reverse
;; route the direct `hessian` already takes; see the NEEDS-DECISION section of
;; the ESH-0402 PR). Until it is, it RAISES. This test pins the raise, so a
;; regression to the silent zero — or back to the memory-unsafe read — fails
;; loudly instead of shipping a wrong derivative.
;;
;; The supported spellings below must keep working; only the composed one
;; raises, and the raise is caught here so the file still reports a verdict.

(define failures 0)

(define (check name got want)
  (if (<= (abs (- got want)) 1e-9)
      (begin (display "  ok   ") (display name) (newline))
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name)
             (display " got=") (display got)
             (display " want=") (display want) (newline))))

(define (f v) (* (vector-ref v 0) (vector-ref v 0) (vector-ref v 0)))
(define g (gradient f))

;; Supported: the curried gradient itself, and the direct second derivative.
(check "curried gradient value" (vector-ref (g (vector 2.0)) 0) 12.0)
(check "direct gradient value"  (vector-ref (gradient f (vector 2.0)) 0) 12.0)
(check "direct hessian value"   (vector-ref (vector-ref (hessian f (vector 2.0)) 0) 0) 12.0)

;; Unsupported: differentiating the first-class gradient again. Must raise,
;; never answer.
(define raised 0)
(guard (e (#t (set! raised 1)))
  (let ((j (jacobian g (vector 2.0))))
    (display "FAIL: curried gradient-of-gradient answered ")
    (display j)
    (display " instead of raising")
    (newline)
    (set! failures (+ failures 1))))

(if (= raised 1)
    (begin (display "  ok   nested curried gradient raises") (newline))
    (begin (display "FAIL: nested curried gradient did not raise") (newline)
           (set! failures (+ failures 1))))

(if (= failures 0)
    (begin (display "PASS: curried gradient nesting is loud") (newline))
    (begin (display "TOTAL FAILURES: ") (display failures) (newline)))
