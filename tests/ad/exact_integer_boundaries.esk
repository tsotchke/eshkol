(define min64 -9223372036854775808)
(define half-inverse (/ 2 min64))
(define reciprocal (/ 1 min64))
(display (if (and (= (numerator half-inverse) -1)
                  (= (denominator half-inverse) 4611686018427387904)
                  (= (numerator reciprocal) -1)
                  (= (denominator reciprocal) 9223372036854775808)
                  (= (/ min64 -1) 9223372036854775808))
             "PASS exact_integer_boundaries" "FAIL exact_integer_boundaries"))
(newline)
