;; SW-191: holomorphic derivative at a complex evaluation point.
(define npass 0)
(define nfail 0)
(define (ok? x y) (< (abs (- x y)) 1e-9))
(define (check name got want)
  (if (ok? got want)
      (set! npass (+ npass 1))
      (begin (set! nfail (+ nfail 1)) (display "FAIL: ") (display name)
             (display " got ") (display got) (newline))))
(define dz2 (derivative (lambda (z) (* z z)) (make-rectangular 1.0 1.0)))
(check "z^2 real" (real-part dz2) 2.0)
(check "z^2 imag" (imag-part dz2) 2.0)
(define de (derivative (lambda (z) (exp z)) (make-rectangular 1.0 1.0)))
(check "exp real" (real-part de) (* (exp 1.0) (cos 1.0)))
(check "exp imag" (imag-part de) (* (exp 1.0) (sin 1.0)))
(define ds (derivative (lambda (z) (sin z)) (make-rectangular 1.0 1.0)))
(check "sin real" (real-part ds) (* (cos 1.0) (cosh 1.0)))
(check "sin imag" (imag-part ds) (* (- (sin 1.0)) (sinh 1.0)))
(define di (derivative (lambda (z) (+ z 2.0)) (make-rectangular 4.0 -3.0)))
(check "identity real" (real-part di) 1.0)
(check "identity imag" (imag-part di) 0.0)
(if (= nfail 0)
    (begin (display "PASS: complex_evaluation_point ") (display npass)
           (display "/") (display npass) (newline))
    (begin (display "FAIL: complex_evaluation_point ") (display nfail)
           (display " failures") (newline) (exit 1)))
