;; tests/ad/exact_taylor_test.esk
;; ESH-0191 (P6): EXACT-coefficient Taylor towers.
;;
;; When the seed point x0 is exact (a plain integer/rational, not a double)
;; and every operator the differentiated function applies is exact-preserving
;; (+/-/*// and non-negative-integer expt), (derivative-n f x0 n) and
;; (taylor f x0 k) come back EXACT -- zero floating error, verified with `=`
;; and `exact?` rather than a numeric tolerance. The moment a transcendental
;; primitive (exp/log/sin/cos/...) is applied, the tower gracefully (and
;; correctly) demotes to the ordinary COEFF_F64 double tower -- R7RS
;; exactness contagion, applied to arbitrary-order AD. See
;; docs/design/AD_TAYLOR_TOWER.md section 9.
;;
;; Runs identically under -r (JIT) and AOT.

(define npass 0)
(define nfail 0)

(define (check-exact-eq name got expect)
  (if (and (exact? got) (= got expect))
      (set! npass (+ npass 1))
      (begin (set! nfail (+ nfail 1))
             (display "FAIL ") (display name)
             (display " got=") (display got) (display " exact?=") (display (exact? got))
             (display " expect=") (display expect) (newline))))

(define (check-inexact-close name got expect)
  (if (and (inexact? got) (<= (abs (- got expect)) (+ 1e-9 (* 1e-9 (abs expect)))))
      (set! npass (+ npass 1))
      (begin (set! nfail (+ nfail 1))
             (display "FAIL ") (display name)
             (display " got=") (display got) (display " inexact?=") (display (inexact? got))
             (display " expect=") (display expect) (newline))))

;; exact factorial (used to build reference derivative values)
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))

;; ---------------------------------------------------------------------
;; Gate 1: x^5 at x0=2 (EXACT integer point). f^(n) = 32,80,160,240,240,120,
;; 0,0,0 for n=0..8 (design doc section 15 table). Checked via both a plain
;; product chain and (expt x 5), which exercises the exact-integer-power
;; recurrence (taylor_pow_exact) instead of Cauchy-convolution multiply.
;; ---------------------------------------------------------------------
(define (x5-mul x) (* x x x x x))
(define (x5-pow x) (expt x 5))

(define x5-expected (list 32 80 160 240 240 120 0 0 0))

(let loop ((n 0) (es x5-expected))
  (if (not (null? es))
      (begin
        (check-exact-eq (string-append "x^5(mul) n=" (number->string n)) (derivative-n x5-mul 2 n) (car es))
        (check-exact-eq (string-append "x^5(pow) n=" (number->string n)) (derivative-n x5-pow 2 n) (car es))
        (loop (+ n 1) (cdr es)))))

;; (taylor f x k) coefficients must also be exact and equal f^(n)/n!.
(let ((cs (taylor x5-mul 2 8)))
  (let loop ((n 0) (cs cs) (es x5-expected))
    (if (not (null? es))
        (begin
          (check-exact-eq (string-append "x^5 taylor-coeff n=" (number->string n))
                           (* (car cs) (fact n)) (car es))
          (loop (+ n 1) (cdr cs) (cdr es))))))

;; ---------------------------------------------------------------------
;; Gate 2: rational function 1/(1-x) at x0=1/2 (EXACT rational point).
;; f^(n)(1/2) = n! * 2^(n+1) -- an exact integer, reached via genuine exact
;; RATIONAL division inside the tower (w0 = 1 - 1/2 = 1/2).
;; ---------------------------------------------------------------------
(define (geom x) (/ 1 (- 1 x)))
(define half (/ 1 2))

(let loop ((n 0))
  (if (<= n 10)
      (begin
        (check-exact-eq (string-append "geom n=" (number->string n))
                         (derivative-n geom half n)
                         (* (fact n) (expt 2 (+ n 1))))
        (loop (+ n 1)))))

;; ---------------------------------------------------------------------
;; Gate 3: bignum-scale exactness. x^20 at x0=3 stays exact through every
;; order (n=17..20 already exceed INT64_MAX ~9.22e18, so this genuinely
;; exercises the arbitrary-precision bignum substrate, not just int64).
;; f^(n)(3) = (20!/(20-n)!) * 3^(20-n).
;; ---------------------------------------------------------------------
(define (x20 x) (expt x 20))

(let loop ((n 0))
  (if (<= n 20)
      (begin
        (check-exact-eq (string-append "x^20 n=" (number->string n))
                         (derivative-n x20 3 n)
                         (* (quotient (fact 20) (fact (- 20 n))) (expt 3 (- 20 n))))
        (loop (+ n 1)))))

;; A second, even-larger-magnitude case that forces genuine bignum (not just
;; int64-adjacent) results: f(x)=x^30 at x0=7, f(7) = 7^30 (~2.25e25).
(define (x30 x) (expt x 30))
(check-exact-eq "x^30 n=0 (true bignum)" (derivative-n x30 7 0) (expt 7 30))
(check-exact-eq "x^30 n=1 (true bignum)" (derivative-n x30 7 1)
                (* 30 (expt 7 29)))

;; ---------------------------------------------------------------------
;; Gate 4: transcendental promotion. exp(x) at an EXACT integer point (2,
;; not 2.0) must still produce the CORRECT double result via graceful
;; demotion to the COEFF_F64 tower -- R7RS exactness contagion in reverse
;; (an exact input meeting an inexact-only primitive yields inexact output).
;; ---------------------------------------------------------------------
(define (expf x) (exp x))
(check-inexact-close "exp(2) n=0" (derivative-n expf 2 0) (exp 2.0))
(check-inexact-close "exp(2) n=1" (derivative-n expf 2 1) (exp 2.0))
(check-inexact-close "exp(2) n=4" (derivative-n expf 2 4) (exp 2.0))

;; mixed: a polynomial combined with a transcendental primitive over an
;; exact point must ALSO demote gracefully (not crash / not silently return
;; a garbage exact-tagged value).
(define (mixed x) (+ (* x x) (sin x)))
(check-inexact-close "mixed n=0" (derivative-n mixed 2 0) (+ (* 2.0 2.0) (sin 2.0)))
(check-inexact-close "mixed n=2" (derivative-n mixed 2 2) (- 2.0 (sin 2.0)))

;; ---------------------------------------------------------------------
;; Gate 5: inexact point still behaves exactly as the pre-P6 double tower
;; (no accidental "always exact" regression: a double x0 must give inexact
;; results even for a pure polynomial).
;; ---------------------------------------------------------------------
(if (inexact? (derivative-n x5-mul 2.0 3))
    (set! npass (+ npass 1))
    (begin (set! nfail (+ nfail 1))
           (display "FAIL x^5 with double x0 must stay inexact") (newline)))
(check-inexact-close "x^5 double x0 n=3" (derivative-n x5-mul 2.0 3) 240.0)

;; ---------------------------------------------------------------------
;; Gate 6: elementary Taylor coefficients against closed forms.
;; Every list below has K+1 entries for K=8 and is an independent reference
;; for c[n] = f^(n)(x0)/n!, rather than a comparison against another AD path.
;; abs uses the fixed-sign series on either smooth side and the zero
;; subgradient convention at its kink.
;; ---------------------------------------------------------------------
(define (check-coeff-series name f x0 expected)
  (let ((cs (taylor f x0 8)))
    (let loop ((n 0) (cs cs) (es expected))
    (if (not (null? es))
        (begin
          (check-inexact-close (string-append name " c=" (number->string n))
                               (car cs) (car es))
          (loop (+ n 1) (cdr cs) (cdr es)))))))

(check-coeff-series "sin closed form" (lambda (x) (sin x)) 0.0
                    (list 0.0 1.0 0.0 (/ -1.0 6.0) 0.0 (/ 1.0 120.0)
                          0.0 (/ -1.0 5040.0) 0.0))
(check-coeff-series "cos closed form" (lambda (x) (cos x)) 0.0
                    (list 1.0 0.0 (/ -1.0 2.0) 0.0 (/ 1.0 24.0) 0.0
                          (/ -1.0 720.0) 0.0 (/ 1.0 40320.0)))
(check-coeff-series "exp closed form" (lambda (x) (exp x)) 0.0
                    (list 1.0 1.0 (/ 1.0 2.0) (/ 1.0 6.0) (/ 1.0 24.0)
                          (/ 1.0 120.0) (/ 1.0 720.0) (/ 1.0 5040.0)
                          (/ 1.0 40320.0)))
(check-coeff-series "log closed form" (lambda (x) (log x)) 1.0
                    (list 0.0 1.0 (/ -1.0 2.0) (/ 1.0 3.0) (/ -1.0 4.0)
                          (/ 1.0 5.0) (/ -1.0 6.0) (/ 1.0 7.0) (/ -1.0 8.0)))
(check-coeff-series "sqrt closed form" (lambda (x) (sqrt x)) 1.0
                    (list 1.0 (/ 1.0 2.0) (/ -1.0 8.0) (/ 1.0 16.0)
                          (/ -5.0 128.0) (/ 7.0 256.0) (/ -21.0 1024.0)
                          (/ 33.0 2048.0) (/ -429.0 32768.0)))
(check-coeff-series "tan closed form" (lambda (x) (tan x)) 0.0
                    (list 0.0 1.0 0.0 (/ 1.0 3.0) 0.0 (/ 2.0 15.0) 0.0
                          (/ 17.0 315.0) 0.0))

(let ((abs-neg (taylor (lambda (x) (abs x)) -2 8))
      (abs-pos (taylor (lambda (x) (abs x)) 2 8))
      (abs-zero (taylor (lambda (x) (abs x)) 0 8)))
  (let loop ((n 0) (ns abs-neg) (ps abs-pos) (zs abs-zero))
    (if (<= n 8)
        (begin
          (check-exact-eq (string-append "abs negative c=" (number->string n))
                          (car ns) (if (= n 0) 2 (if (= n 1) -1 0)))
          (check-exact-eq (string-append "abs positive c=" (number->string n))
                          (car ps) (if (= n 0) 2 (if (= n 1) 1 0)))
          (check-exact-eq (string-append "abs zero c=" (number->string n))
                          (car zs) 0)
          (loop (+ n 1) (cdr ns) (cdr ps) (cdr zs))))))

(check-exact-eq "negative integer power c0"
                (car (taylor (lambda (x) (expt x -1)) 2 8)) (/ 1 2))
(check-exact-eq "negative integer power c1"
                (car (cdr (taylor (lambda (x) (expt x -1)) 2 8))) (/ -1 4))
(check-exact-eq "negative integer power derivative"
                (derivative-n (lambda (x) (expt x -1)) 2 1) (/ -1 4))

;; Audit counterexamples and dispatch coverage.
(check-inexact-close "cos derivative sign at 1"
                     (derivative-n (lambda (x) (cos x)) 1.0 1) (- (sin 1.0)))
(check-exact-eq "bignum division derivative stays exact"
                (derivative-n (lambda (x) (/ x 3)) (expt 2 100) 1) (/ 1 3))
(check-exact-eq "tiny exact denominator stays exact"
                (derivative-n (lambda (x) (/ 1 x)) (/ 1 (expt 10 400)) 0)
                (expt 10 400))
(check-exact-eq "max preserves Taylor order"
                (derivative-n (lambda (x) (max x 0)) 2 1) 1)
(check-exact-eq "relu preserves Taylor order"
                (derivative-n (lambda (x) (relu x)) 2 1) 1)
(check-inexact-close "sigmoid Taylor derivative at zero"
                     (derivative-n (lambda (x) (sigmoid x)) 0 1) 0.25)
(check-inexact-close "tanh Taylor derivative at zero"
                     (derivative-n (lambda (x) (tanh x)) 0 1) 1.0)

;; Second-audit counterexamples: branch selection is on the exact primal and
;; the selected branch carries the whole series, including negative tangent
;; coefficients.
(let ((relu-series (taylor (lambda (x) (relu (- 2 x))) 1 3)))
  (check-exact-eq "relu exact branch c0" (car relu-series) 1)
  (check-exact-eq "relu exact branch c1" (car (cdr relu-series)) -1)
  (check-exact-eq "relu exact branch c2" (car (cdr (cdr relu-series))) 0)
  (check-exact-eq "relu exact branch c3" (car (cdr (cdr (cdr relu-series)))) 0))

(define tiny-positive (/ 1 (expt 10 400)))
(let ((mx (taylor (lambda (x) (max 0 x)) tiny-positive 1))
      (rx (taylor (lambda (x) (relu x)) tiny-positive 1)))
  (check-exact-eq "max exact tiny primal" (car mx) tiny-positive)
  (check-exact-eq "max exact tiny tangent" (car (cdr mx)) 1)
  (check-exact-eq "relu exact tiny primal" (car rx) tiny-positive)
  (check-exact-eq "relu exact tiny tangent" (car (cdr rx)) 1))

;; The zero subgradient convention must survive a mixed Taylor/dual pass.
(check-inexact-close "mixed abs zero subgradient"
                     (derivative
                      (lambda (y)
                        (derivative-n (lambda (x) (abs (+ x y))) 0 0))
                      0)
                     0.0)

;; Stable tail recurrences: these are finite limits, not NaNs from an
;; unselected overflowing exponential branch.
(check-inexact-close "sigmoid(-1000) c0"
                     (derivative-n (lambda (x) (sigmoid x)) -1000 0) 0.0)
(check-inexact-close "sigmoid(-1000) c1"
                     (derivative-n (lambda (x) (sigmoid x)) -1000 1) 0.0)
(check-inexact-close "sigmoid(-1000) c2"
                     (derivative-n (lambda (x) (sigmoid x)) -1000 2) 0.0)
(check-inexact-close "tanh(1000) c0"
                     (derivative-n (lambda (x) (tanh x)) 1000 0) 1.0)
(check-inexact-close "tanh(1000) c1"
                     (derivative-n (lambda (x) (tanh x)) 1000 1) 0.0)
(check-inexact-close "tanh(1000) c2"
                     (derivative-n (lambda (x) (tanh x)) 1000 2) 0.0)

;; No exponent magnitude cutoff: -4097 remains an exact rational result.
(check-exact-eq "large negative integer power"
                (derivative-n (lambda (x) (expt x -4097)) 2 1)
                (/ -4097 (expt 2 4098)))
(check-exact-eq "abs exact scalar derivative"
                (derivative (lambda (x) (abs x)) -2) -1)
(check-exact-eq "relu exact scalar derivative"
                (derivative (lambda (x) (relu x)) 2) 1)

(display "----") (newline)
(display "exact-taylor tests: ") (display npass) (display " passed, ")
(display nfail) (display " failed") (newline)
;; Machine-readable verdict, so this file can gate in CTest. It could not before:
;; it printed only a count, and no workflow ran it, yet it is the gate on the
;; exact-coefficient tier that `derivative`/`gradient`/`hessian` now route to at
;; an exact point (ESH-0394) -- so a regression here would silently become a
;; regression in those three.
;; The verdict is a COUNT RATCHET, not merely `nfail = 0`. `(= nfail 0)` alone
;; is satisfied by a run in which nothing ran at all -- the "0 passed, 0 failed"
;; false green -- and by a run in which a `let loop` bound its limit wrong and
;; silently executed fewer iterations than the gate's name claims. Both are
;; live risks here: every gate below is a loop, and the exact tier this file
;; certifies is the oracle `derivative`/`gradient`/`hessian` route to at an
;; exact point, so a quietly-shrunken suite would take those three with it.
;; 177 = 159 original checks + 18 second-audit assertions.
;; 68 = 18 (x^5 mul/pow, n=0..8) + 9 (x^5 taylor coefficients) + 11 (geometric
;; at 1/2, n=0..10) + 21 (x^20 at 3, n=0..20) + 2 (x^30 bignum) + 5
;; (transcendental demotion) + 2 (inexact point stays inexact).
(define expected-checks 177)
(if (and (= nfail 0) (= npass expected-checks))
    (begin (display "PASS: exact-coefficient Taylor tier ")
           (display npass) (display "/") (display expected-checks)
           (display " checks") (newline))
    (begin (display "FAIL: exact-coefficient Taylor tier ")
           (display npass) (display "/") (display expected-checks)
           (display " passed, ") (display nfail) (display " failed")
           (newline)))
