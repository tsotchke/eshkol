;; SW-210 regression: the integral family of unary numeric builtins on
;; Taylor carriers. Generated by tests/ad/gen_taylor_integral_family_test.py
;; from sympy closed forms; do not edit the expected values by hand.
(define failures 0)
(define checks 0)
(define (check name got expected)
  (set! checks (+ checks 1))
  (if (and (number? got)
           (<= (abs (- got expected)) (+ 1e-12 (* 1e-9 (abs expected)))))
      #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (display " got ")
             (write got) (display " want ") (write expected) (newline))))
(define (check-exact name got expected)
  (set! checks (+ checks 1))
  (if (and (exact? got) (= got expected))
      #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (display " got ")
             (write got) (display " want exact ") (write expected) (newline))))

;; Orders 1-5 of every function through the classic tower, the same orders
;; with the pass nested inside and around a first-order `derivative` (the
;; level carrier and the reverse-seed dual tower), and the Taylor list.
(check "asin d1 at 0.3" (derivative-n asin 0.3 1) 1.0482848367219182)
(check "asin d1 lambda at 0.3" (derivative-n (lambda (x) (asin x)) 0.3 1) 1.0482848367219182)
(check "asin d2 at 0.3" (derivative-n asin 0.3 2) 0.3455884077105225)
(check "asin d2 lambda at 0.3" (derivative-n (lambda (x) (asin x)) 0.3 2) 0.3455884077105225)
(check "asin d3 at 0.3" (derivative-n asin 0.3 3) 1.4937520919355918)
(check "asin d3 lambda at 0.3" (derivative-n (lambda (x) (asin x)) 0.3 3) 1.4937520919355918)
(check "asin d4 at 0.3" (derivative-n asin 0.3 4) 3.9812986469730527)
(check "asin d4 lambda at 0.3" (derivative-n (lambda (x) (asin x)) 0.3 4) 3.9812986469730527)
(check "asin d5 at 0.3" (derivative-n asin 0.3 5) 23.96098460007004)
(check "asin d5 lambda at 0.3" (derivative-n (lambda (x) (asin x)) 0.3 5) 23.96098460007004)
(check "asin level d1 of d1 at 0.3" (derivative-n (lambda (x) (derivative asin x)) 0.3 1) 0.3455884077105225)
(check "asin d1 of d1 at 0.3" (derivative (lambda (x) (derivative-n asin x 1)) 0.3) 0.3455884077105225)
(check "asin level d2 of d1 at 0.3" (derivative-n (lambda (x) (derivative asin x)) 0.3 2) 1.4937520919355918)
(check "asin d1 of d2 at 0.3" (derivative (lambda (x) (derivative-n asin x 2)) 0.3) 1.4937520919355918)
(check "asin level d3 of d1 at 0.3" (derivative-n (lambda (x) (derivative asin x)) 0.3 3) 3.9812986469730527)
(check "asin d1 of d3 at 0.3" (derivative (lambda (x) (derivative-n asin x 3)) 0.3) 3.9812986469730527)
(check "asin level d4 of d1 at 0.3" (derivative-n (lambda (x) (derivative asin x)) 0.3 4) 23.96098460007004)
(check "asin d1 of d4 at 0.3" (derivative (lambda (x) (derivative-n asin x 4)) 0.3) 23.96098460007004)
