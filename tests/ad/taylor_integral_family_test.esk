(check "atan2 procedure d1" (derivative-n (lambda (x) (atan2 x -0.25)) 0.8 1) -0.35587188612099646)
(check "atan2 procedure d2" (derivative-n (lambda (x) (atan2 x -0.25)) 0.8 2) 0.8105267157204189)
(check "atan2 procedure d3" (derivative-n (lambda (x) (atan2 x -0.25)) 0.8 3) -2.6789205951079684)
(check "atan2 procedure d4" (derivative-n (lambda (x) (atan2 x -0.25)) 0.8 4) 11.381720373232362)
(check "atan2 procedure d5" (derivative-n (lambda (x) (atan2 x -0.25)) 0.8 5) -57.930196793439855)
