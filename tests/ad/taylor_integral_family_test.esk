(check "atan2 procedure level d2 of d1" (derivative-n (lambda (x) (derivative (lambda (x) (atan2 x -0.25)) x)) 0.8 2) -2.6789205951079684)
(check "atan2 procedure level d3 of d1" (derivative-n (lambda (x) (derivative (lambda (x) (atan2 x -0.25)) x)) 0.8 3) 11.381720373232362)

;; The review's cases.
(check "nested d1 of atan as a level" (derivative-n (lambda (a) (* a (derivative atan 1.0))) 2.0 1) 0.5)
(check "atan d2 at 1.0" (derivative-n atan 1.0 2) -0.5)
(check "atan d3 lambda at 0.5" (derivative-n (lambda (x) (atan x)) 0.5 3) -0.256)
(check "d/da of atan(a x) d2" (derivative (lambda (a) (derivative-n (lambda (x) (atan (* a x))) 0.5 2)) 1.5) -1.437696)
(check "nested jets through atan2" (derivative (lambda (a) (derivative (lambda (x) (atan x a)) 0.5)) 1.5) -0.32)

;; Exact inputs stay exact where every coefficient is rational.
(check-exact "atan d3 at exact 0" (derivative-n atan 0 3) -2)
(check-exact "atanh d3 at exact 0" (derivative-n atanh 0 3) 2)
(check-exact "cbrt d3 at exact 8" (derivative-n cbrt 8 3) 5/3456)
(check-exact "cbrt d2 at exact -27" (derivative-n cbrt -27 2) 2/2187)
(check-exact "floor d2 at 5/2" (derivative-n floor 5/2 2) 0)
(check-exact "floor d0 at 5/2" (derivative-n floor 5/2 0) 2)
(check-exact "round d0 at 5/2" (derivative-n round 5/2 0) 2)
(check-exact "exp2 d0 at 3" (derivative-n exp2 3 0) 8)
(check-exact "log2 d0 at 8" (derivative-n log2 8 0) 3)
(check-exact "level keeps the exact tail" (derivative (lambda (a) (derivative-n (lambda (x) (atan (* a x))) 1/2 2)) 3/2) -22464/15625)

;; The rounding functions are constant between their jumps.
(check "floor d1 at 1.3" (derivative-n floor 1.3 1) 0.0)
(check "floor d2 at 1.3" (derivative-n floor 1.3 2) 0.0)
(check "floor d3 at 1.3" (derivative-n floor 1.3 3) 0.0)
(check "floor level at 1.3" (derivative-n (lambda (x) (* x (floor x))) 1.3 2) 0.0)
(check "ceiling d1 at 1.3" (derivative-n ceiling 1.3 1) 0.0)
(check "ceiling d2 at 1.3" (derivative-n ceiling 1.3 2) 0.0)
(check "ceiling d3 at 1.3" (derivative-n ceiling 1.3 3) 0.0)
(check "ceiling level at 1.3" (derivative-n (lambda (x) (* x (ceiling x))) 1.3 2) 0.0)
(check "truncate d1 at 1.3" (derivative-n truncate 1.3 1) 0.0)
(check "truncate d2 at 1.3" (derivative-n truncate 1.3 2) 0.0)
(check "truncate d3 at 1.3" (derivative-n truncate 1.3 3) 0.0)
(check "truncate level at 1.3" (derivative-n (lambda (x) (* x (truncate x))) 1.3 2) 0.0)
(check "round d1 at 1.3" (derivative-n round 1.3 1) 0.0)
(check "round d2 at 1.3" (derivative-n round 1.3 2) 0.0)
(check "round d3 at 1.3" (derivative-n round 1.3 3) 0.0)
(check "round level at 1.3" (derivative-n (lambda (x) (* x (round x))) 1.3 2) 0.0)

(if (= failures 0)
    (begin (display "PASS: taylor_integral_family ") (display checks) (newline))
    (begin (display "FAIL: ") (display failures) (display " of ") (display checks) (newline)))
