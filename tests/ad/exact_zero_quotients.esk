(define n (expt 2 80))
(define (signals? thunk) (guard (condition (#t (error-object? condition))) (thunk) #f))
(define (names? thunk message)
  (guard (condition ((error-object? condition)
                     (equal? (error-object-message condition) message))
                    (#t #f))
    (thunk)
    #f))
(display (if (and (signals? (lambda () (/ n 0)))
                  (names? (lambda () (quotient n 0)) "quotient: division by zero")
                  (names? (lambda () (remainder n 0)) "remainder: division by zero")
                  (names? (lambda () (modulo n 0)) "modulo: division by zero"))
             "PASS exact_zero_quotients" "FAIL exact_zero_quotients"))
(newline)
