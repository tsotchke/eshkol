(require stdlib)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (near? a b) (< (abs (- a b)) 0.000000001))
(let samples ((i 0)) (if (< i 40)
  (let* ((x (/ (- i 20) 8.0)) (y (/ (+ i 1) 16.0))
         (actual (differentiate 'numeric (lambda (x y) (+ (* x x) (* 3 x y) (- y))) (vector x y)))
         (oracle (gradient (lambda (v) (+ (* (vector-ref v 0) (vector-ref v 0))
                         (* 3 (vector-ref v 0) (vector-ref v 1)) (- (vector-ref v 1)))) (vector x y))))
    (check "analytic first partial" (near? (vector-ref actual 0) (+ (* 2 x) (* 3 y))))
    (check "analytic second partial" (near? (vector-ref actual 1) (- (* 3 x) 1)))
    (check "existing gradient agrees" (and (near? (vector-ref actual 0) (vector-ref oracle 0))
                                         (near? (vector-ref actual 1) (vector-ref oracle 1))))
    (samples (+ i 1)))))
(define parallel (differentiate 'numeric (lambda (x y) (let ((x y) (y x)) (- (* x x) y))) (vector 2.0 3.0)))
(check "parallel let resolves old bindings" (and (near? (vector-ref parallel 0) -1) (near? (vector-ref parallel 1) 6)))
(define sequential (differentiate 'numeric (lambda (x y) (let* ((x y) (y x)) (- (* x x) y))) (vector 2.0 3.0)))
(check "sequential shadowing resolves new bindings" (and (near? (vector-ref sequential 0) 0) (near? (vector-ref sequential 1) 5)))
(define shared (differentiate 'numeric (lambda (x) (+ (* x x) (* x x))) (vector 3.0)))
(check "shared and repeated operand gradients accumulate" (near? (vector-ref shared 0) 12))
(define reciprocal (differentiate 'numeric (lambda (x y) (/ (+ x 3/7) y)) (vector 2.0 3.0)))
(check "rational constant and quotient partials" (and (near? (vector-ref reciprocal 0) 1/3)
  (near? (vector-ref reciprocal 1) (- (/ (+ 2 3/7) 9)))))
(define unary (differentiate 'numeric (lambda (x) (+ (- x) (/ x))) (vector 2.0)))
(check "unary normalization" (near? (vector-ref unary 0) -1.25))
(define constant (differentiate 'numeric (lambda (x) 17) (vector 2.0)))
(check "constant has zero gradient" (near? (vector-ref constant 0) 0))
(define point-count 0)
(define once (differentiate 'numeric (lambda (x) (* x x))
  (begin (set! point-count (+ point-count 1)) (vector 4.0))))
(check "point is evaluated once" (and (= point-count 1) (near? (vector-ref once 0) 8)))
(define __dg_point (vector 5.0))
(define collision (differentiate 'numeric (lambda (__dg_inputs) (* __dg_inputs __dg_inputs)) __dg_point))
(check "generated names cannot capture the caller point" (near? (vector-ref collision 0) 10))
(check "wrong point width refuses at runtime" (raises? (lambda ()
  (differentiate 'numeric (lambda (x y) (* x y)) (vector 1.0)))))
(check "nonvector point refuses" (raises? (lambda ()
  (differentiate 'numeric (lambda (x) x) 3))))
(check "nonnumeric point refuses" (raises? (lambda ()
  (differentiate 'numeric (lambda (x) x) (vector "bad")))))
(check "nonfinite point refuses" (raises? (lambda ()
  (differentiate 'numeric (lambda (x) x) (vector +inf.0)))))
(define (inside point) (differentiate 'numeric (lambda (x) (+ (* x x) 1)) point))
(check "form works inside a user function" (near? (vector-ref (inside (vector 7.0)) 0) 14))
(define-syntax graph-square (syntax-rules () ((_ a) (* a a))))
(check "graph extraction follows macro expansion" (near? (vector-ref
  (differentiate 'numeric (lambda (x) (graph-square x)) (vector 3.0)) 0) 6))
(define (__eshkol_graph_numeric function point) 23)
(check "ordinary marker spelling has no compiler authority"
  (= (__eshkol_graph_numeric (lambda (x) (* x x)) (vector 3)) 23))
;; Historical symbolic syntax still returns a derivative S-expression.
(check "legacy symbolic differentiate retained" (= (differentiate (* 2 x) x) 2))
(check "legacy quoted symbolic refusal retained" (raises? (lambda () (differentiate '(* x x) x))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
