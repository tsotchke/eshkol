;;; Shared check helpers for the platform language-surface tests.
(define tests-passed 0)
(define tests-failed 0)
(define (raises? thunk)
  (let ((raised #f))
    (guard (condition (#t (set! raised #t))) (thunk))
    raised))
;; A refusal by the capability policy, told apart from any other raise: the
;; condition's message names the capability that was withheld.
(define (refuses-capability? capability thunk)
  (let ((message
          (guard (condition (#t (if (error-object? condition)
                                    (error-object-message condition)
                                    "")))
            (begin (thunk) ""))))
    (and (string? message)
         (string-contains? message "capability denied")
         (string-contains? message (symbol->string capability)))))
(define (check name condition)
  (if condition
      (begin (set! tests-passed (+ tests-passed 1))
             (display "PASS: ") (display name) (newline))
      (begin (set! tests-failed (+ tests-failed 1))
             (display "FAIL: ") (display name) (newline))))
(define (report suite)
  (display suite) (display ": ") (display tests-passed) (display " passed, ")
  (display tests-failed) (display " failed") (newline))
