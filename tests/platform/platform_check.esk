;;; Shared check helpers for the platform language-surface tests.
(define tests-passed 0)
(define tests-failed 0)
(define (raises? thunk)
  (let ((raised #f))
    (guard (condition (#t (set! raised #t))) (thunk))
    raised))
;; A refusal by the capability policy, told apart from any other raise.
(define (refuses-capability? capability thunk)
  "Whether THUNK was refused by the capability policy for CAPABILITY.

The condition says so in one of two shapes: the runtime entry points put the
capability in the message (\"capability denied: shell (system)\"), while the
module wrappers raise \"capability denied\" with the capability as an irritant.
Both are read here, so the check is about the refusal and not about which layer
produced it."
  (let ((named
          (guard (condition
                  (#t (and (error-object? condition)
                           (string-contains? (error-object-message condition)
                                             "capability denied")
                           (or (string-contains? (error-object-message condition)
                                                 (symbol->string capability))
                               (and (memq capability
                                          (error-object-irritants condition))
                                    #t)))))
            (begin (thunk) #f))))
    (and named #t)))
(define (check name condition)
  (if condition
      (begin (set! tests-passed (+ tests-passed 1))
             (display "PASS: ") (display name) (newline))
      (begin (set! tests-failed (+ tests-failed 1))
             (display "FAIL: ") (display name) (newline))))
(define (report suite)
  (display suite) (display ": ") (display tests-passed) (display " passed, ")
  (display tests-failed) (display " failed") (newline))
