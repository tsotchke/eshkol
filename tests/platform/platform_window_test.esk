;;; platform.window under the offscreen backend, exercised by JIT and AOT.
(require stdlib)
(require core.capabilities)
(require platform.window)
(load "tests/platform/platform_check.esk")

(check "display backend is offscreen" (equal? (platform-backend 'display) "offscreen"))
(capability-install-policy! '(network))
(check "a policy without 'display refuses windows"
       (raises? (lambda () (window-create "denied" 10 10))))
(capability-install-policy! '(display))

(define w (window-create "eshkol" 64 48))
(check "window? recognises a window" (window? w))
(check "size is 64x48" (equal? (window-size w) (cons 64 48)))
(check "backend name" (equal? (window-backend w) "offscreen"))
(define first-ev (window-poll-event w))
(check "creation reports window-show" (and (event? first-ev) (eq? (event-type first-ev) 'window-show)))
(check "empty queue polls #f" (not (window-poll-event w)))

(window-clear! w (rgb 10 20 30))
(window-fill-rect! w 8 8 4 4 (rgb 255 0 128))
(window-set-pixel! w 63 47 (rgb 1 2 3))
(check "surface pixel after clear" (= (window-pixel w 0 0) (rgb 10 20 30)))
(check "surface pixel inside rect" (= (window-pixel w 9 10) (rgb 255 0 128)))
(check "rgb accessors" (and (= (rgb-red (window-pixel w 9 10)) 255)
                            (= (rgb-green (window-pixel w 9 10)) 0)
                            (= (rgb-blue (window-pixel w 9 10)) 128)))
(check "presented pixel needs a present first"
       (raises? (lambda () (window-presented-pixel w 0 0))))
(window-present! w)
(check "present count" (= (window-present-count w) 1))
(check "presented frame matches the surface"
       (and (= (window-presented-pixel w 9 10) (rgb 255 0 128))
            (= (window-presented-pixel w 63 47) (rgb 1 2 3))
            (= (window-presented-pixel w 30 30) (rgb 10 20 30))))
(check "out-of-range pixel raises" (raises? (lambda () (window-pixel w 64 0))))

(window-push-event! w 'key-down (key-code-of #\a) modifier-shift 65)
(window-push-event! w 'mouse-down 5 6 button-left)
(window-push-event! w 'user 7 70 700)
(define k (window-wait-event w 1000))
(check "key event" (and (key-event? k) (key-pressed? k) (= (key-code k) 97)
                        (= (key-modifiers k) modifier-shift) (= (key-unicode k) 65)))
(define m (window-poll-event w))
(check "mouse event" (and (mouse-event? m) (eq? (event-type m) 'mouse-down)
                          (= (mouse-x m) 5) (= (mouse-y m) 6) (= (mouse-button m) button-left)))
(define u (window-poll-event w))
(check "user event" (and (eq? (event-type u) 'user) (= (user-event-code u) 7)
                         (= (user-event-data1 u) 70) (= (user-event-data2 u) 700)))
(check "events carry the window id and a timestamp"
       (and (> (event-window u) 0) (> (event-timestamp u) 0)
            (<= (event-timestamp k) (event-timestamp u))))
(check "wait with timeout returns #f" (not (window-wait-event w 20)))

(window-set-size! w 80 20)
(define r (window-poll-event w))
(check "resize event" (and (window-event? r) (eq? (event-type r) 'window-resize)
                           (= (event-width r) 80) (= (event-height r) 20)))
(check "surface follows the resize" (and (= (window-width w) 80) (= (window-height w) 20)
                                         (= (window-pixel w 9 10) (rgb 255 0 128))))
(window-set-position! w 3 4)
(check "move event" (eq? (event-type (window-poll-event w)) 'window-move))
(check "position" (equal? (window-position w) (cons 3 4)))
(window-set-title! w "renamed")
(check "not closing yet" (not (window-should-close? w)))
(window-request-close! w)
(check "close requested" (window-should-close? w))
(check "close event" (eq? (event-type (window-poll-event w)) 'window-close))
(window-destroy! w)
(check "destroyed window raises" (raises? (lambda () (window-width w))))
(check "unknown flag raises" (raises? (lambda () (window-create "x" 5 5 'sideways))))
(define h (window-create "hidden" 8 8 'hidden 'resizable))
(check "hidden window has no show event" (not (window-poll-event h)))
(window-destroy! h)
(check "select offscreen by name" (equal? (platform-select-backend! 'display "offscreen") "offscreen"))
(check "unknown backend name raises"
       (raises? (lambda () (platform-select-backend! 'display "teletype"))))
(report "platform window")
