;;; platform.audio under the null backend (a device-free real-time clock).
(require stdlib)
(require core.capabilities)
(require platform.audio)
(load "tests/platform/platform_check.esk")

(capability-install-policy! '(display))
(check "a policy without 'audio refuses devices"
       (raises? (lambda () (audio-open-output 48000 2 256))))
(capability-install-policy! '(audio))

(define out (audio-open 'output 48000 1 'f32 256 4096))
(check "device?" (audio-device? out))
(check "backend is null" (equal? (audio-backend out) "null"))
(check "period and rate" (and (= (audio-stat out 'period-frames) 256)
                              (= (audio-stat out 'sample-rate) 48000)))
(define tone (let loop ((i 0) (acc '()))
               (if (= i 2048) (reverse acc) (loop (+ i 1) (cons (* 0.25 (sin (* i 0.05))) acc)))))
(check "2048 samples staged and committed" (= (audio-write-samples! out tone) 2048))
(check "queued frames visible after commit" (= (audio-stat out 'queued-frames) 2048))
(check "staging alone publishes nothing"
       (begin (audio-write! out 0.5) (= (audio-stat out 'queued-frames) 2048)))
(check "commit publishes the staged frame" (= (audio-commit! out) 1))
(audio-start! out)
(sleep-ms 200)
(audio-stop! out)
(define stats (audio-stats out))
(check "stats is an alist of every counter" (= (length stats) 14))
(check "callbacks ran on the audio thread" (> (cdr (assq 'callbacks stats)) 10))
(check "queue drained" (= (cdr (assq 'queued-frames stats)) 0))
(check "underruns counted after the queue ran dry" (> (cdr (assq 'underruns stats)) 0))
(check "frames = played + silence"
       (= (cdr (assq 'frames stats)) (+ 2049 (cdr (assq 'underrun-frames stats)))))
(check "latency in milliseconds" (> (audio-latency-ms out) 0))
(audio-close! out)
(check "closed device raises" (raises? (lambda () (audio-stat out 'frames))))

(define in (audio-open 'input 44100 2 's16 128 1024))
(audio-start! in)
(sleep-ms 60)
(audio-stop! in)
(check "captured frames available" (> (audio-available in) 0))
(define samples (audio-read-samples in 10))
(check "null capture is silence" (and (= (vector-length samples) 10)
                                      (= (vector-ref samples 0) 0.0)
                                      (= (vector-ref samples 9) 0.0)))
(check "writing to an input raises" (raises? (lambda () (audio-write! in 0.1))))
(audio-close! in)
(check "unknown format raises" (raises? (lambda () (audio-open 'output 48000 2 'f64 256 0))))
(check "invalid rate raises" (raises? (lambda () (audio-open 'output 10 2 'f32 256 0))))
(report "platform audio")
