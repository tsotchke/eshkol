;;; platform.midi under the in-process loopback backend.
(require stdlib)
(require core.capabilities)
(require platform.midi)
(load "tests/platform/platform_check.esk")

(capability-install-policy! '(audio))
(check "a policy without 'midi refuses ports"
       (raises? (lambda () (midi-open-output "eshkol-esk-out"))))
(capability-install-policy! '(midi))

(define out (midi-open-output "eshkol-esk-out"))
(define in (midi-open-input "eshkol-esk-out"))
(check "ports" (and (midi-port? out) (midi-port? in)))
(check "backend is loopback" (equal? (midi-backend out) "loopback"))
(check "source listed" (member "eshkol-esk-out" (midi-sources)))
(check "nothing received yet" (not (midi-receive in)))
(midi-note-on! out 2 60 100)
(midi-control-change! out 0 7 127)
(midi-program-change! out 15 3)
(midi-pitch-bend! out 1 8192)
(midi-send! out '(240 125 1 2 3 247))
(midi-note-off! out 2 60 0)
(check "note on" (equal? (midi-receive in 100) '(146 60 100)))
(check "timestamp recorded" (> (midi-last-timestamp in) 0))
(check "control change" (equal? (midi-receive in) '(176 7 127)))
(check "program change" (equal? (midi-receive in) '(207 3)))
(check "pitch bend centre" (equal? (midi-receive in) '(225 0 64)))
(check "sysex" (equal? (midi-receive in) '(240 125 1 2 3 247)))
(check "note off" (equal? (midi-receive in) '(130 60 0)))
(check "malformed message raises" (raises? (lambda () (midi-send! out '(144 60)))))
(check "data byte with high bit raises" (raises? (lambda () (midi-send! out '(144 200 1)))))
(check "sending on an input raises" (raises? (lambda () (midi-send! in '(144 60 1)))))
(define stats (midi-stats out))
(check "sent count" (= (cdr (assq 'sent stats)) 6))
(check "received count" (= (cdr (assq 'received (midi-stats in))) 6))
(check "unknown source raises" (raises? (lambda () (midi-open-input "no-such-source"))))
(midi-close! in)
(midi-close! out)
(check "closed port raises" (raises? (lambda () (midi-receive in))))
(report "platform midi")
