;; GENERATED by tests/control_flow/generate_capture_count_fixtures.py -- do not edit.
;; The call protocol for procedures capturing 0..66 variables.

(define tests-passed 0)
(define tests-failed 0)

(define (test-case name expected actual)
  (if (equal? expected actual)
      (begin
        (set! tests-passed (+ tests-passed 1))
        (display "PASS: ") (display name) (newline))
      (begin
        (set! tests-failed (+ tests-failed 1))
        (display "FAIL: ") (display name)
        (display " (expected ") (display expected)
        (display ", got ") (display actual) (display ")") (newline))))

;; The callee reaches each call site as a value, so the argument count is
;; checked by the call protocol when the call is made.
(define (call-with-1 f) (f 1))
(define (call-with-2 f) (f 1 2))
(define (call-with-3 f) (f 1 2 3))
(define (call-with-5 f) (f 1 2 3 4 5))
(define (outcome thunk)
  (guard (e (#t (if (error-object? e)
                    (list 'error (error-object-message e))
                    (list 'raised e))))
    (thunk)))

;; ---- 0 captured variable(s) ----
(define (make-fixed-0)
  (let ()
    (lambda (a b) (+ a b 0))))
(define (make-variadic-0)
  (let ()
    (lambda (a b . rest) (+ a b (length rest) 0))))
(define fixed-0 (make-fixed-0))
(define variadic-0 (make-variadic-0))
(test-case "0 captures, fixed arity, exact argument count" 3
           (outcome (lambda () (call-with-2 fixed-0))))
(test-case "0 captures, fixed arity, too few arguments"
           (list 'error "Arity mismatch: <procedure> expects 2 arguments but got 1")
           (outcome (lambda () (call-with-1 fixed-0))))
(test-case "0 captures, fixed arity, too many arguments"
           (list 'error "Arity mismatch: <procedure> expects 2 arguments but got 3")
           (outcome (lambda () (call-with-3 fixed-0))))
(test-case "0 captures, variadic, fewer than the fixed parameters"
           (list 'error "Arity mismatch: <procedure> expects at least 2 arguments but got 1")
           (outcome (lambda () (call-with-1 variadic-0))))
(test-case "0 captures, variadic, exactly the fixed parameters" 3
           (outcome (lambda () (call-with-2 variadic-0))))
(test-case "0 captures, variadic, one rest argument" 4
           (outcome (lambda () (call-with-3 variadic-0))))
(test-case "0 captures, variadic, three rest arguments" 6
           (outcome (lambda () (call-with-5 variadic-0))))
(test-case "0 captures, still callable after the refused calls" 3
           (outcome (lambda () (call-with-2 fixed-0))))

