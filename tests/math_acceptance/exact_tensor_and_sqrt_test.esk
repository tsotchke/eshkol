;; SW-166 / SW-167 acceptance: exact entries and exact roots.
(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (exact-and-equal? v expected) (and (exact? v) (= v expected)))

(check "a rational tensor entry survives a round trip, or the constructor refuses loudly"
       (let ((t (guard (e (#t 'refused)) (tensor (vector 1/2 1/3)))))
         (or (eq? t 'refused)
             (and (exact-and-equal? (tensor-ref t 0) 1/2) (exact-and-equal? (tensor-ref t 1) 1/3)))))
(check "(sqrt 16) is exact 4" (exact-and-equal? (sqrt 16) 4))
(check "(sqrt 1/4) is exact 1/2" (exact-and-equal? (sqrt 1/4) 1/2))
(check "(sqrt 9223372030926249001) is exact 3037000499" (exact-and-equal? (sqrt 9223372030926249001) 3037000499))
(check "(expt 4 1/2) is exact 2" (exact-and-equal? (expt 4 1/2) 2))
(check "(expt 1/3 4) is exact 1/81 (SW-152)" (exact-and-equal? (expt 1/3 4) 1/81))
(check "(sqrt 15) stays inexact" (not (exact? (sqrt 15))))
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
