(require signal.filters)

(define (near-response a b) (< (abs (- a b)) 0.0000001))
(define (low-magnitude ratio n)
  (/ 1.0 (sqrt (+ 1.0 (expt ratio (* 2 n))))))
;; The bilinear transform maps digital frequency f to tan(pi*f/fs).
(define (gain filter point)
  (vref (car (frequency-response (car filter) (cdr filter) 17)) point))
(define (check-design n)
  (let* ((lp (butterworth-lowpass n 3000.0 16000.0))
         (hp (butterworth-highpass n 1000.0 16000.0))
         (bp (butterworth-bandpass n 1000.0 3000.0 16000.0))
         (u (tan (/ (* 3.141592653589793 2000.0) 16000.0)))
         (lo (tan (/ 3.141592653589793 16.0)))
         (hi (tan (/ (* 3.0 3.141592653589793) 16.0)))
         (expected-lp (low-magnitude (/ u hi) n))
         (expected-hp (low-magnitude (/ lo u) n))
         (impulse (vector 1.0 0.0 0.0 0.0))
         (actual (apply-filter bp impulse))
         (manual (iir-filter (car hp) (cdr hp)
                             (iir-filter (car lp) (cdr lp) impulse))))
    (and (near-response (gain lp 4) expected-lp)
         (near-response (gain hp 4) expected-hp)
         (near-response (gain lp 6) (/ 1.0 (sqrt 2.0)))
         (near-response (gain hp 2) (/ 1.0 (sqrt 2.0)))
         (near-response (* (gain (car bp) 4) (gain (cadr bp) 4))
                        (* expected-lp expected-hp))
         (near-response (gain (butterworth-lowpass n 0.375) 4) expected-lp)
         (near-response (vref (apply-filter lp impulse) 0) (vref (car lp) 0))
         (near-response (vref actual 0) (vref manual 0))
         (near-response (vref actual 3) (vref manual 3)))))
(if (and (check-design 1) (check-design 2) (check-design 3))
    (display "PASS: Butterworth response")
    (begin (display "FAIL: Butterworth response") (newline) (exit 1)))
(newline)
