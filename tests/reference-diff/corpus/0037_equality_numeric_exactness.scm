;; equality / numeric_exactness  (R7RS-small portable; reference-differential corpus)
(display (equal? 6 6.0))(newline)
(display (= 6 6.0))(newline)
(display (equal? '(1 2) '(1.0 2.0)))(newline)
(display (equal? (vector 1 2) (vector 1.0 2.0)))(newline)
(display (equal? 1/2 0.5))(newline)
(display (equal? 1/2 2/4))(newline)
(display (member 2.0 '(1 2 3)))(newline)
(display (assoc 2 '((2.0 . a) (2 . b))))(newline)
