(require core.net)
(define socket (tcp-connect "127.0.0.1" @PORT@ 1000))
(if (network-error? socket)
    (begin (display "CONNECT-ERROR") (newline) (exit 2))
    (begin
      (define wrote (tcp-write socket "ping" 1000))
      (define reply (tcp-read socket 8 1000))
      (tcp-close socket)
      (if (and (= wrote 4) (equal? reply "pong"))
          (begin (display "RESULT: PASS") (newline))
          (begin (display "DATA-MISMATCH") (newline) (exit 3)))))
