(require agent.unix_stream_socket)
(define loop (make-event-loop 8))
(if loop
    (begin
      (define listener (unix-stream-socket-listen loop "/tmp/private/socket"))
      (unix-stream-socket-close! listener)
      (define first (unix-stream-socket-cleanup-ticket listener))
      (if first (unix-stream-socket-cleanup-release! first) #f)
      (define second (unix-stream-socket-cleanup-ticket listener))
      (if second (unix-stream-socket-cleanup-release! second) #f)
      (event-loop-close loop))
    #f)
