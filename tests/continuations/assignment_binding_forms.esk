;; Assignment conversion must apply to every lexical binding form that can
;; be set!, including function parameters, named-let variables, do variables,
;; let-values bindings, internal defines, and letrec bindings.
(define parameter-k #f)
(define parameter-n 0)
(define (parameter-case x)
  (call/cc (lambda (c) (set! parameter-k c)))
  (set! x (+ x 1))
  x)
(display "parameter=") (display (parameter-case 0)) (newline)
(set! parameter-n (+ parameter-n 1))
(if (< parameter-n 3) (parameter-k 'again))

(define do-k #f)
(define do-n 0)
(define (do-case)
  (do ((x 0 (+ x 1))) ((>= do-n 2) x)
    (call/cc (lambda (c) (set! do-k c)))
    (set! x (+ x 1))
    (set! do-n (+ do-n 1))))
(display "do=") (display (do-case)) (newline)
(if (< do-n 3) (do-k 'again))

(define named-k #f)
(define named-n 0)
(define (named-case)
  (let loop ((x 0))
    (call/cc (lambda (c) (set! named-k c)))
    (set! x (+ x 1))
    (if (< x 0) (loop x) x)))
(display "named=") (display (named-case)) (newline)
(set! named-n (+ named-n 1))
(if (< named-n 3) (named-k 'again))

(display "let-values=")
(let-values (((x) (values 1)))
  (set! x 2)
  (display x))
(newline)

(display "internal-define=")
(display (let ((x 1))
  (define (bump) (set! x (+ x 1)))
  (bump)
  x))
(newline)

(display "letrec=")
(display (letrec ((x 1)
         (bump (lambda () (set! x (+ x 1)))))
  (bump)
  x))
(newline)
