;;; Simple closure tests that don't require passing builtins as values
;;;
;;; Expected values come from the arithmetic each closure denotes, which was
;;; already spelled out in the trailing comments of the display-only version
;;; of this file. They are asserted here rather than printed.

(define (check name expected actual)
  (if (equal? expected actual)
      (begin (display "PASS: ") (display name) (newline))
      (begin (display "FAIL: ") (display name)
             (display " -- expected ") (write expected)
             (display ", got ") (write actual)
             (newline))))

;; Test 1: Basic closure capturing function parameter
(define (make-adder n)
  (lambda (x) (+ x n)))

(define add5 (make-adder 5))
(define add10 (make-adder 10))

(check "make-adder: (add5 10) = 10 + 5" 15 (add5 10))
(check "make-adder: (add10 7) = 7 + 10" 17 (add10 7))
;; Two closures over the same lambda must keep distinct captures.
(check "make-adder captures are independent" 15 (add5 10))

;; Test 2: Compose with explicit lambdas
(define (compose f g)
  (lambda (x) (f (g x))))

(define add1 (lambda (x) (+ x 1)))
(define double (lambda (x) (* x 2)))
(define add1-then-double (compose double add1))

(check "compose: double(add1(5)) = (5+1)*2" 12 (add1-then-double 5))

;; Test 3: Multiple captures
(define (make-linear-function a b)
  (lambda (x) (+ (* a x) b)))

(define f1 (make-linear-function 2 3))  ; 2x + 3
(define f2 (make-linear-function 5 1))  ; 5x + 1

(check "linear f1(4) = 2*4 + 3" 11 (f1 4))
(check "linear f2(2) = 5*2 + 1" 11 (f2 2))
;; f1 must not have been clobbered by constructing f2.
(check "linear f1(0) = b = 3" 3 (f1 0))
(check "linear f2(0) = b = 1" 1 (f2 0))

;; Test 4: Identity function
(define (identity x) x)

(check "identity 42" 42 (identity 42))
