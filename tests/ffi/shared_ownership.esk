(extern ptr shared-new i64 ptr :real shared_allocate)
(extern void shared-keep ptr :real shared_retain)
(extern void shared-drop ptr :real shared_release)
(extern i32 shared-count ptr :real shared_ref_count)
(extern ptr weak-new ptr :real weak_ref_create)
(extern ptr weak-lock ptr :real weak_ref_upgrade)
(extern void weak-drop ptr :real weak_ref_release)

(define value (shared-new 16 (null-ptr)))
(shared-keep value)
(define weak (weak-new value))
(define locked (weak-lock weak))
(define live (and (= (ptr->usize locked) (ptr->usize value))
                  (= (shared-count value) 3)))
(shared-drop locked)
(shared-drop value)
(shared-drop value)
(define expired (= (ptr->usize (weak-lock weak)) 0))
(weak-drop weak)
(define empty (shared-new 0 (null-ptr)))
(define empty-owned (= (shared-count empty) 1))
(shared-drop empty)
(if (and live expired empty-owned)
    (begin (display "PASS: shared ownership") (newline))
    (exit 1))
