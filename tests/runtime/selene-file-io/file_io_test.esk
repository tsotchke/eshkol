;; Native -O3 regression for write-file/append-file and real stdio failures.
(require stdlib)
(extern i32 arm-file-limit :real selene_file_io_arm)
(extern i32 restore-file-limit :real selene_file_io_restore)
(extern i32 late-control ptr :real selene_file_io_late_control)
(extern i32 short-control ptr :real selene_file_io_short_control)
(extern i32 bytes-match ptr ptr i64 :real selene_file_io_bytes)
(define checks 0)
(define failures 0)
(define (check label ok)
  (set! checks (+ checks 1))
  (if (not ok)
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display label) (newline))))

(define root (make-temp-dir "eshkol-file-io" (temp-directory)))
(define target (path-join root "bytes"))
(define payload (string-append "é" (make-string 1 (integer->char 0)) "雨"))
(check "canonical UTF-8/NUL byte count" (= (string-byte-length payload) 6))
(check "write succeeds" (eq? (write-file target payload) #t))
(check "write retains all UTF-8/NUL bytes" (= (bytes-match target payload 6) 1))
(check "append succeeds" (eq? (append-file target payload) #t))
(check "append retains complete bytes" (= (bytes-match target (string-append payload payload) 12) 1))
(check "empty append succeeds" (eq? (append-file target "") #t))
(check "empty append preserves bytes" (= (bytes-match target (string-append payload payload) 12) 1))
(check "empty write succeeds" (eq? (write-file target "") #t))
(check "write truncates existing bytes" (= (bytes-match target "" 0) 1))
(check "write existing directory fails" (eq? (write-file root "x") #f))
(check "append existing directory fails" (eq? (append-file root "x") #f))

;; Allocate all paths/data before arming the limit. This process is the child
;; launched by run_aot.cmake; neither compiler nor parent inherits the limit.
(define late-path (path-join root "late-write"))
(define late-append-path (path-join root "late-append"))
(define short-path (path-join root "short-write"))
(define short-append-path (path-join root "short-append"))
(define control-path (path-join root "late-control"))
(define large (make-string 1048576 #\x))
(define arm-status (arm-file-limit))
(if (not (= arm-status 0)) (exit 2))
(define control (late-control control-path))
(define short-control-result (short-control control-path))
(define late-write (write-file late-path "x"))
(define late-append (append-file late-append-path "x"))
(define short-write (write-file short-path large))
(define short-append (append-file short-append-path large))
(define restore-status (restore-file-limit))
;; Assertion output is safe only after restoring the exact saved process state.
(check "limit and signal restored" (= restore-status 0))
(check "host exhibits buffered fclose rejection" (= control 1))
(check "host exhibits short fwrite rejection" (= short-control-result 1))
(check "write reports late flush failure" (eq? late-write #f))
(check "append reports late flush failure" (eq? late-append #f))
(check "write reports short write" (eq? short-write #f))
(check "append reports short write" (eq? short-append #f))
(check "failed write persisted no bytes" (= (bytes-match late-path "" 0) 1))
(check "failed append persisted no bytes" (= (bytes-match late-append-path "" 0) 1))
(check "write recovers after restored limit" (eq? (write-file target payload) #t))
(check "recovered write has exact bytes" (= (bytes-match target payload 6) 1))
;; Retain fixture files for qualification evidence.
(display "file_io: ") (display checks) (display " checks, ")
(display failures) (display " failures") (newline)
(if (> failures 0) (exit 1))
