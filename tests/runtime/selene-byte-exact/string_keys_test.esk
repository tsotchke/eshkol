;; Compiler/runtime integration: literal, constructed, copied and read strings.
(require stdlib)
(define checks 0)
(define failures 0)
(define (check label ok)
  (set! checks (+ checks 1))
  (if (not ok)
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display label) (newline))))

(define a "key\x0;a")
(define z "key\x0;z")
(define copied (string-copy a))
(define made (string-append "key" (make-string 1 (integer->char 0)) "a"))
(define parsed (read (open-input-string "\"key\\x0;a\"")))
(check "literal complete byte length" (= (string-byte-length a) 5))
(check "literal differs after NUL" (not (equal? a z)))
(check "copied bytes equal literal" (equal? a copied))
(check "constructed bytes equal literal" (equal? a made))
(check "read bytes equal literal" (equal? a parsed))
(check "prefix differs from NUL-bearing string" (not (equal? "key" a)))

(define table (make-hash-table))
(hash-set! table a 1)
(hash-set! table z 2)
(check "distinct suffix keys count" (= (hash-count table) 2))
(check "literal a lookup" (= (hash-ref table a -1) 1))
(check "literal z lookup" (= (hash-ref table z -1) 2))
(check "copied key lookup" (= (hash-ref table copied -1) 1))
(check "constructed key lookup" (= (hash-ref table made -1) 1))
(check "parsed key lookup" (= (hash-ref table parsed -1) 1))
(hash-set! table made 3)
(check "equivalent update retains count" (= (hash-count table) 2))
(check "equivalent update visible" (= (hash-ref table copied -1) 3))
(check "other suffix not overwritten" (= (hash-ref table z -1) 2))
(hash-remove! table parsed)
(check "equivalent removal" (not (hash-has-key? table a)))
(check "other suffix remains" (= (hash-ref table z -1) 2))

(define edge (make-hash-table))
(hash-set! edge "" 1)
(hash-set! edge "\x0;" 2)
(hash-set! edge "\x0;a" 3)
(hash-set! edge "é\x0;雨" 4)
(hash-set! edge "é\x0;雪" 5)
(check "edge key count" (= (hash-count edge) 5))
(check "empty key" (= (hash-ref edge "" -1) 1))
(check "NUL-only key" (= (hash-ref edge (make-string 1 (integer->char 0)) -1) 2))
(check "leading NUL key" (= (hash-ref edge "\x0;a" -1) 3))
(check "UTF8 suffix one" (= (hash-ref edge (string-copy "é\x0;雨") -1) 4))
(check "UTF8 suffix two" (= (hash-ref edge "é\x0;雪" -1) 5))

(display "string_keys: ") (display checks) (display " checks, ")
(display failures) (display " failures") (newline)
(if (> failures 0) (exit 1))
