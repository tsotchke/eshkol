;; Both ends of a pair get dual protocols; using one end with the SAME
;; protocol as the other (not its dual) is rejected.
;; ENGINES: aot vm
;; EXPECT-STDERR: cannot match
(require stdlib)
(require core.sessions)
(define (server (c : (chan (? number end)))) : null
  (let-values (((x c) (session-recv c))) (session-close c)))
(define (run)
  (let-values (((a b) (make-session-pair)))
    (server a)
    (server b)))
