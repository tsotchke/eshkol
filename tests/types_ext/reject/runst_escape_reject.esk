;; The runST encapsulation: a reference created inside run-st cannot leave
;; it, because its type mentions the run's own state variable.
;; ENGINES: jit aot vm
;; EXPECT-STDERR: would escape its scope
(require stdlib)
(define (st-new (tok : (st s)) (v : a)) : (st-ref s a) (vector v))
(define (run-st (action : (forall (s) (-> (st s) a)))) : a
  (action (vector 'st-token)))
(define escaped (run-st (lambda (tok) (st-new tok 0))))
