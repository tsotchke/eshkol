; SW-58 measured stack-depth regression. The same three values are covered by
; tests/vm_parity/corpus/75_guard_tail_depth_regression.esk.
(define N 1000000)
(define zero-count 0)
(define (zero-loop)
  (guard (e (#t 0))
    (if (= zero-count N)
        zero-count
        (begin (set! zero-count (+ zero-count 1)) (zero-loop)))))
(define (handler-loop n)
  (guard (e (#t (if (= n N) n (handler-loop (+ n 1)))))
    (raise 'step)))
(define (do-loop)
  (guard (e (#t 0))
    (do ((i 0 (+ i 1))) ((= i N) i)
      (guard (inner (#t 0)) 0))))
(define a (zero-loop))
(define b (handler-loop 0))
(define c (do-loop))
(display "zero-arity 1e6: ")
(if (= a N) (display "PASS") (display "FAIL"))
(newline)
(display "handler-tail 1e6: ")
(if (= b N) (display "PASS") (display "FAIL"))
(newline)
(display "do-guard 1e6: ")
(if (= c N) (display "PASS") (display "FAIL"))
(newline)
