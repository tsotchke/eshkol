(require stdlib)
(require core.msgpack)
(define checks 0)
(define (check value label)
  (set! checks (+ checks 1))
  (if value #t (begin (display "FAIL: ") (display label) (newline) (exit 1))))
(define (refuses thunk) (guard (e (#t #t)) (thunk) #f))
(define (bytes=? a b)
  (equal? (msgpack-bytevector->bytes a) (msgpack-bytevector->bytes b)))
(define (golden scalar bytes)
  (let* ((text (string (integer->char scalar)))
         (wire (msgpack-bytes->bytevector (cons (+ 160 (length bytes)) bytes))))
    (check (bytes=? (msgpack-encode text) wire) "golden encoded scalar bytes")
    (check (equal? (msgpack-decode wire) text) "golden decoded scalar")
    (check (equal? (msgpack-decode (msgpack-encode text)) text) "scalar roundtrip")))
;; Hand-authored shortest UTF-8 encodings at the scalar boundaries.
(golden 0 '(0))
(golden 127 '(127))
(golden 128 '(194 128))
(golden 2047 '(223 191))
(golden 2048 '(224 160 128))
(golden 55295 '(237 159 191))
(golden 57344 '(238 128 128))
(golden 65535 '(239 191 191))
(golden 65536 '(240 144 128 128))
(golden 1114111 '(244 143 191 191))
(define mixed (string #\a #\nul (integer->char 955) (integer->char 128512) #\z))
(define mixed-wire (bytevector 169 97 0 206 187 240 159 152 128 122))
(check (bytes=? (msgpack-encode mixed) mixed-wire) "mixed NUL/multibyte golden encoding")
(check (equal? (msgpack-decode mixed-wire) mixed) "mixed NUL/multibyte golden decoding")
(check (equal? (msgpack-decode (bytevector 217 2 194 128)) (string (integer->char 128))) "str8 UTF-8")
(check (equal? (msgpack-decode (bytevector 218 0 2 194 128)) (string (integer->char 128))) "str16 UTF-8")
(for-each
 (lambda (wire)
   (check (refuses (lambda () (msgpack-decode wire))) "malformed UTF-8 refused")
   (check (refuses (lambda () (msgpack-decode-prefix wire))) "malformed prefix refused"))
 (list (bytevector 161 128) (bytevector 162 192 128)
       (bytevector 162 193 191) (bytevector 162 194 32)
       (bytevector 161 194) (bytevector 163 224 159 191)
       (bytevector 163 237 160 128) (bytevector 162 226 130)
       (bytevector 164 240 143 191 191) (bytevector 164 244 144 128 128)
       (bytevector 164 245 128 128 128) (bytevector 161 255)
       (bytevector 145 162 192 128) (bytevector 129 161 128 1)
       (bytevector 217 2 192 128) (bytevector 218 0 2 192 128)))
(check (refuses (lambda () (msgpack-encode (utf8->string (bytevector 192 128)))))
       "encoder refuses malformed text")
(check (bytes=? (msgpack-decode (bytevector 196 2 192 128)) (bytevector 192 128))
       "bin preserves arbitrary bytes")
(check (bytes=? (msgpack-encode (bytevector 192 128)) (bytevector 196 2 192 128))
       "bin encode preserves arbitrary bytes")
(check (refuses (lambda () (msgpack-decode (bytevector 218 0 3 194 128)))) "truncated str16 payload")
(display "PASS: MessagePack UTF-8 ") (display checks) (display " checks") (newline)
