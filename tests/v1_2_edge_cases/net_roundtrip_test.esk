(require stdlib)
(require core.net)
(define (check value label)
  (if value #t (begin (display "FAIL: ") (display label) (newline) (exit 1))))
(define (code? value code)
  (and (network-error? value) (= (network-error-code value) code)))
(check (code? (tcp-listen "invalid-host" 0) -4) "numeric hosts only")
(check (code? (tcp-listen "127.0.0.1" 65536) -4) "port range")
(check (code? (tcp-connect "127.0.0.1" 1 -1) -4) "negative timeout")
(define listener (tcp-listen "127.0.0.1" 0))
(check (not (network-error? listener)) "listen")
(define port (net-local-port listener))
(check (> port 0) "ephemeral port")
(check (equal? (net-local-address listener) "127.0.0.1") "listen address")
(check (code? (tcp-accept listener 10) -2) "accept timeout")
(define client (tcp-connect "127.0.0.1" port 1000))
(check (not (network-error? client)) "connect")
(define server (tcp-accept listener 1000))
(check (not (network-error? server)) "accept")
(check (= (net-peer-port client) port) "remote port")
(check (equal? (net-peer-address client) "127.0.0.1") "remote address")
(check (= (net-peer-port server) (net-local-port client)) "accepted peer port")
(check (code? (tcp-read server 32 10) -2) "idle read timeout")
(check (= (net-nonblocking! server #t) 0) "nonblocking mode")
(check (code? (tcp-read server 32 10000) -2) "nonblocking returns promptly")
(net-nonblocking! server #f)
(define payload (string #\a #\nul #\b))
(check (= (tcp-write client payload 1000) 3) "binary-safe TCP send")
(check (equal? (tcp-read server 32 1000) payload) "binary-safe TCP read")
(check (= (tcp-write server "reply" 1000) 5) "TCP reply send")
(check (equal? (tcp-read client 32 1000) "reply") "TCP reply receive")
(check (code? (tcp-read server 0 1000) -4) "capacity refusal")
(check (= (tcp-close client) 0) "close client")
(check (equal? (tcp-read server 32 1000) "") "EOF differs from timeout")
(check (= (tcp-close server) 0) "close accepted")
(check (= (tcp-close listener) 0) "close listener")
(check (code? (tcp-close listener) -4) "double close refuses")
(check (code? (tcp-connect "127.0.0.1" port 100) -1) "connection refusal")
(define fresh (tcp-listen "127.0.0.1" 0))
(check (not (network-error? fresh)) "new handle")
(check (code? (tcp-close listener) -4) "stale close refuses after fd reuse")
(check (> (net-local-port fresh) 0) "stale close preserves fresh socket")
(tcp-close fresh)
(display "PASS: TCP roundtrip") (newline)

(define u0 (udp-bind "127.0.0.1" 0))
(define u1 (udp-bind "127.0.0.1" 0))
(check (and (not (network-error? u0)) (not (network-error? u1))) "UDP bind")
(define p0 (net-local-port u0))
(define p1 (net-local-port u1))
(check (code? (udp-recvfrom u1 32 10) -2) "UDP timeout")
(check (= (udp-sendto u0 "127.0.0.1" p1 payload 1000) 3) "UDP binary send")
(define received (udp-recvfrom u1 32 1000))
(check (not (network-error? received)) "UDP receive")
(check (equal? (vector-ref received 0) payload) "UDP payload")
(check (equal? (vector-ref received 1) (string-append "127.0.0.1:" (number->string p0))) "UDP sender")
(check (= (udp-sendto u1 "127.0.0.1" p0 "" 1000) 0) "zero datagram send")
(check (equal? (vector-ref (udp-recvfrom u0 32 1000) 0) "") "zero datagram receive")
(udp-sendto u0 "127.0.0.1" p1 "oversized" 1000)
(check (code? (udp-recvfrom u1 2 1000) -4) "UDP truncation refuses")
(check (code? (tcp-write u1 "wrong kind" 1000) -4) "TCP rejects UDP handle")
(check (code? (udp-sendto u1 "127.0.0.1" p0 "x" 4294967296) -4) "FFI narrowing refused")
(udp-close u0) (udp-close u1)
(check (code? (udp-recvfrom u1 32 0) -4) "closed UDP refuses")
(capability-install-policy! '())
(check (guard (e (#t #t)) (tcp-listen "127.0.0.1" 0) #f) "network capability denied")
(capability-clear-policy!)
(display "PASS: UDP roundtrip") (newline)
