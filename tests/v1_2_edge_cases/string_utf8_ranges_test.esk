;; R7RS 6.9: string->utf8 ranges count characters, not bytes.
;; https://standards.scheme.org/corrected-r7rs/r7rs-Z-H-8.html
(define (check value label)
  (if value #t (begin (display "FAIL: ") (display label) (newline) (exit 1))))
(define (bytes . values)
  (let ((bv (make-bytevector (length values) 0)))
    (let loop ((rest values) (i 0))
      (if (null? rest) bv
          (begin (bytevector-u8-set! bv i (car rest))
                 (loop (cdr rest) (+ i 1)))))))
(define (bytes=? a b)
  (and (= (bytevector-length a) (bytevector-length b))
       (let loop ((i 0))
         (if (= i (bytevector-length a)) #t
             (and (= (bytevector-u8-ref a i) (bytevector-u8-ref b i)) (loop (+ i 1)))))))
(define (refuses thunk) (guard (e (#t #t)) (thunk) #f))
(define text (utf8->string (bytes 97 0 206 187 240 159 152 128 122)))
(check (bytes=? (string->utf8 text) (bytes 97 0 206 187 240 159 152 128 122)) "NUL and non-BMP full encoding")
(check (bytes=? (string->utf8 text 1) (bytes 0 206 187 240 159 152 128 122)) "start-only character range")
(check (bytes=? (string->utf8 text 2 4) (bytes 206 187 240 159 152 128)) "multibyte character range")
(check (bytes=? (string->utf8 text 1 2) (bytes 0)) "NUL character range")
(check (bytes=? (string->utf8 text 5 5) (bytes)) "empty end range")
(check (bytes=? (string->utf8 "") (bytes)) "empty string")
(check (refuses (lambda () (string->utf8 text -1))) "negative start refused")
(check (refuses (lambda () (string->utf8 text 0 -1))) "negative end refused")
(check (refuses (lambda () (string->utf8 text 3 2))) "reversed range refused")
(check (refuses (lambda () (string->utf8 text 6))) "start beyond character count refused")
(check (refuses (lambda () (string->utf8 text 0 6))) "byte-count end cannot masquerade as character count")
(check (refuses (lambda () (string->utf8 text 1.0))) "inexact integer index refused")
(check (refuses (lambda () (string->utf8 text 1.5))) "fractional index refused")
(check (refuses (lambda () (string->utf8 text #t))) "nonnumeric index refused")
(check (refuses (lambda () (string->utf8 #t))) "nonstring refused")
(check (refuses (lambda () (string->utf8 text 0 9223372036854775807))) "huge index refused before copy")
(display "PASS: string->utf8 ranges") (newline)
