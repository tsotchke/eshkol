;; Reverse mode through named-let loops that keep AD nodes only inside a list
;; (or another structure allocated outside the tape's arena). Every list
;; element must stay the node its own iteration recorded: the gradient of any
;; one element is that element's derivative, and reverse mode agrees with
;; forward mode.

(define pass-count 0)
(define fail-count 0)
(define (check name ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display name) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display name) (newline))))
(define (vclose? a b)
  (let loop ((i 0) (ok #t))
    (if (< i (vector-length a)) (loop (+ i 1) (and ok (< (abs (- (vector-ref a i) (vector-ref b i))) 1e-12))) ok)))

;; count-up loop consing exp(th_i): the last element is exp(th_0)
(define (first-elem th)
  (let loop ((i 0) (acc '()))
    (if (> i 2) (caddr acc) (loop (+ i 1) (cons (exp (vector-ref th i)) acc)))))
(check "caddr of the consed list differentiates its own iteration"
       (vclose? (gradient first-elem (vector 0.0 0.0 0.1)) (vector 1.0 0.0 0.0)))

(define (last-elem th)
  (let loop ((i 0) (acc '()))
    (if (> i 2) (car acc) (loop (+ i 1) (cons (exp (vector-ref th i)) acc)))))
(check "car of the consed list differentiates once, not once per iteration"
       (vclose? (gradient last-elem (vector 0.0 0.0 0.1)) (vector 0.0 0.0 (exp 0.1))))

;; count-down loop with two ops per element
(define (two-ops th)
  (let loop ((i 2) (acc '()))
    (if (< i 0) (+ (car acc) (* 2.0 (cadr acc))) (loop (- i 1) (cons (* 3.0 (sin (vector-ref th i))) acc)))))
(check "two ops per element, count-down"
       (vclose? (gradient two-ops (vector 0.2 0.4 0.6)) (vector (* 3.0 (cos 0.2)) (* 6.0 (cos 0.4)) 0.0)))

;; an element that is a plain sum with a constant
(define (shifted th)
  (let loop ((i 0) (acc '()))
    (if (> i 2) (+ (car acc) (cadr acc)) (loop (+ i 1) (cons (+ 0.0 (vector-ref th i)) acc)))))
(check "constant-shifted elements"
       (vclose? (gradient shifted (vector 1.0 2.0 3.0)) (vector 0.0 1.0 1.0)))

;; softmax built by list-accumulating loops, reverse == closed form
(define (softmax-first th)
  (let* ((es (let loop ((i 2) (acc '())) (if (< i 0) acc (loop (- i 1) (cons (exp (vector-ref th i)) acc)))))
         (s (let loop ((l es) (t 0.0)) (if (pair? l) (loop (cdr l) (+ t (car l))) t))))
    (/ (car es) s)))
(define th (vector 0.1 0.0 0.0))
(define p0 (softmax-first th))
(define e1 (/ (exp 0.0) (+ (exp 0.1) 2.0)))
(check "list-built softmax: closed-form gradient"
       (vclose? (gradient softmax-first th) (vector (* p0 (- 1.0 p0)) (- (* p0 e1)) (- (* p0 e1)))))

;; reverse == forward on a longer loop
(define (poly th)
  (let loop ((i 0) (acc '()))
    (if (> i 5)
        (let sum ((l acc) (k 1.0) (s 0.0)) (if (pair? l) (sum (cdr l) (+ k 1.0) (+ s (* k (car l)))) s))
        (loop (+ i 1) (cons (* (vector-ref th (modulo i 3)) (vector-ref th (modulo (+ i 1) 3))) acc)))))
(define pt (vector 0.3 -0.7 1.1))
(define g-rev (gradient poly pt))
(define g-fwd (vector (derivative (lambda (s) (poly (vector s -0.7 1.1))) 0.3)
                      (derivative (lambda (s) (poly (vector 0.3 s 1.1))) -0.7)
                      (derivative (lambda (s) (poly (vector 0.3 -0.7 s))) 1.1)))
(check "reverse == forward through a six-iteration list loop" (vclose? g-rev g-fwd))

(newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0) (begin (display "ALL TESTS PASSED") (newline)))
