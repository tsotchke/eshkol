;; Positive control for issue #550's rejection boundary: valid broadcasting
;; still computes correctly after malformed shapes are rejected.
(define result
  (tensor-add (reshape #(1.0 2.0 3.0) 1 3)
              (reshape #(10.0) 1 1)))
(if (= (tensor-ref result 0 2) 13.0)
    (display "PASS: tensor shape validation rejects malformed shapes")
    (display "FAIL: valid broadcast result"))
(newline)
