(define empty (make-tensor '(0 3) 1.0))
(define (empty-axis? thunk)
  (guard (e (#t (and (error-object? e)
                     (equal? (error-object-message e)
                             "tensor-reduce: cannot reduce a zero-length axis"))))
    (thunk) #f))
(display (if (and (empty-axis? (lambda () (tensor-sum empty 0)))
                  (empty-axis? (lambda () (derivative (lambda (x)
                      (+ x (tensor-ref (tensor-sum empty 0) 0))) 1.0)))
                  (empty-axis? (lambda () (gradient (lambda (v)
                      (+ (vref v 0) (tensor-ref (tensor-sum empty 0) 0))) (vector 1.0)))))
             "PASS reduction_empty_axis" "FAIL reduction_empty_axis"))
(newline)
