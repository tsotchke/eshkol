; rec_deep_nontco_250k.esk - historical ESH-0112 calibration row.
;
; Before ESH-0101, this row was expected to complete but regressed to a
; silent SIGILL. It is now covered by the two-sided native stack gate in
; found/deep_recursion_270k_no_diagnostic.esk, which accepts only a clean
; diagnostic on the constrained stack or successful completion with 1G.
(define (down n)
  (if (= n 0) 0 (+ 1 (down (- n 1)))))
(display "OK ") (display (down 250000)) (newline)
