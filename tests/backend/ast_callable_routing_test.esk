(define (check name expected actual)
  (if (= expected actual) (begin (display "PASS: ") (display name) (newline))
      (begin (display "FAIL: ") (display name) (display actual) (newline) (exit 1))))
(define (cube x) (* x x x))
(define df (derivative cube))
(check "curried derivative" 27 (df 3))
(check "nested derivative" 18 ((derivative (derivative cube)) 3))
(define (make-three a b c) (lambda (x) (+ a b c x)))
(define captured (make-three 10 20 30))
(check "apply multi capture" 65 (apply captured (list 5)))
(define (make-rest a b) (lambda (x . xs) (+ a b x (car xs))))
(check "variadic captures" 10 (apply (make-rest 1 2) (list 3 4)))
(define p (make-parameter 7))
(check "apply parameter get" 7 (apply p (list)))
(apply p (list 9))
(check "apply parameter set" 9 (p))
(check "apply arithmetic" 10 (apply + (list 1 2 3 4)))
(define-syntax twice (syntax-rules () ((_ x) (+ x x))))
(check "macro" 12 (twice 6))
(define (make-unary-rest a b) (lambda xs (+ a b (car xs))))
(check "parallel variadic captures" 13
       (car (parallel-map (make-unary-rest 5 7) (list 1 2 3))))
(define (make-thunk a b c) (lambda () (+ a b c)))
(check "parallel nullary captures" 6
       (car (parallel-execute (make-thunk 1 2 3) (make-thunk 4 5 6))))
(check "parallel binary" 10
       (parallel-fold (lambda (a b) (+ a b)) 0 (list 1 2 3 4)))
(define (counter a b)
  (lambda (x) (set! a (+ a x)) (+ a b)))
(define count (counter 1 10))
(check "apply mutable capture first" 13 (apply count (list 2)))
(check "apply mutable capture shared" 16 (count 3))
(define (tail-apply n total)
  (if (= n 0) total (apply tail-apply (list (- n 1) (+ total 1)))))
(check "apply tail recursion" 100000 (tail-apply 100000 0))
(display "RESULT: PASS") (newline)
