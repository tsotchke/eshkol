(require stdlib)
(require core.certified_solve_pullback)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (inside? box x) (and (<= (car box) x) (<= x (cdr box))))
(define a (vector (vector 2 1) (vector -1 3)))
(define b (vector 1 2)) (define seed (vector 3 -2))
(define result (solve-certified-native-pullback a b seed 1/1000000))
(check "native primal and transpose adjoint certify" (verify-certified-native-pullback result a b seed 1/1000000))
;; Independent 2x2 formulas: x=(1/7,5/7), lambda=(1,-1).
(check "RHS cotangent analytic formula" (and (inside? (vector-ref (vector-ref result 5) 0) 1) (inside? (vector-ref (vector-ref result 5) 1) -1)))
(check "matrix cotangent analytic formula" (and
  (inside? (vector-ref (vector-ref (vector-ref result 4) 0) 0) -1/7)
  (inside? (vector-ref (vector-ref (vector-ref result 4) 0) 1) -5/7)
  (inside? (vector-ref (vector-ref (vector-ref result 4) 1) 0) 1/7)
  (inside? (vector-ref (vector-ref (vector-ref result 4) 1) 1) 5/7)))
(define da (vector (vector 1/100 1/200) (vector 1/200 1/100)))
(define db (vector 1/100 1/100)) (define ds (vector 1/100 1/100))
(define options (list (vector 1 1) (vector 1 1) da db ds))
(define family (apply solve-certified-native-pullback a b seed 1/10 options))
(check "uniform family source verification" (apply verify-certified-native-pullback family a b seed 1/10 options))
(let sample ((k 0)) (if (< k 32)
  (let* ((sign (if (even? k) 1 -1)) (t (/ (- k 16) 1600))
         (aa (+ 2 t)) (ab (+ 1 (* sign 1/200))) (ac (- -1 (* sign 1/200))) (ad (- 3 t))
         (u (+ 1 t)) (v (- 2 t)) (s (+ 3 t)) (r (- -2 t)) (det (- (* aa ad) (* ab ac)))
         (x (/ (- (* ad u) (* ab v)) det)) (y (/ (- (* aa v) (* ac u)) det))
         (p (/ (- (* ad s) (* ac r)) det)) (q (/ (- (* aa r) (* ab s)) det)))
    (check "independent uncertain adjoint samples enclosed" (and (inside? (vector-ref (vector-ref family 5) 0) p) (inside? (vector-ref (vector-ref family 5) 1) q)))
    (check "correlated uncertain outer product enclosed" (and
      (inside? (vector-ref (vector-ref (vector-ref family 4) 0) 0) (- (* p x)))
      (inside? (vector-ref (vector-ref (vector-ref family 4) 0) 1) (- (* p y)))
      (inside? (vector-ref (vector-ref (vector-ref family 4) 1) 0) (- (* q x)))
      (inside? (vector-ref (vector-ref (vector-ref family 4) 1) 1) (- (* q y)))))
    (sample (+ k 1)))))
(check "omitted uncertainty refuses" (not (verify-certified-native-pullback family a b seed 1/10)))
(check "changed seed refuses" (not (verify-certified-native-pullback result a b (vector 3 -1) 1/1000000)))
(check "changed source refuses" (not (verify-certified-native-pullback result (vector (vector 2 0) (vector -1 3)) b seed 1/1000000)))
(define forged (vector-copy result)) (vector-set! forged 4 (vector (vector (cons 0 0) (cons 0 0)) (vector (cons 0 0) (cons 0 0))))
(check "forged gradient boxes refuse" (not (verify-certified-native-pullback forged a b seed 1/1000000)))
(define singular (solve-certified-native-pullback (vector (vector 0)) (vector 0) (vector 1) 1/10))
(check "unproved solve releases no derivatives" (and (eq? (vector-ref singular 1) 'unknown) (not (vector-ref singular 4)) (not (vector-ref singular 5))))
(check "negative uncertainty refuses" (raises? (lambda () (solve-certified-native-pullback a b seed 1/10 (vector 1 1) (vector 1 1) da db (vector -1 0)))))
(check "inexact seed refuses" (raises? (lambda () (solve-certified-native-pullback a b (vector 1.0 2) 1/10))))
(define scaled (vector (vector 1000 0) (vector 0 1)))
(define scaled-da (vector (vector 0 100) (vector 0 0)))
(define no-adjoint (solve-certified-native-pullback scaled (vector 0 0) (vector 1 1) 1
  (vector 1 1) (vector 1 1) scaled-da))
(check "primal admission alone cannot authorize adjoint" (and
  (eq? (vector-ref (vector-ref no-adjoint 2) 1) 'proved)
  (eq? (vector-ref no-adjoint 1) 'unknown) (not (vector-ref no-adjoint 4))))
(define weighted (solve-certified-native-pullback scaled (vector 0 0) (vector 1 1) 1
  (vector 1 1) (vector 1 1000) scaled-da))
(check "independently weighted transpose can certify" (verify-certified-native-pullback weighted scaled (vector 0 0) (vector 1 1) 1
  (vector 1 1) (vector 1 1000) scaled-da))
(check "changed transpose weights refuse old receipt" (not (verify-certified-native-pullback weighted scaled (vector 0 0) (vector 1 1) 1
  (vector 1 1) (vector 1 1) scaled-da)))
(define signed-result (solve-certified-native-pullback (vector (vector 1)) (vector 3) (vector -2) 0))
(check "negative adjoint product sign exact" (and (equal? (vector-ref (vector-ref (vector-ref signed-result 4) 0) 0) (cons 6 6))
  (equal? (vector-ref (vector-ref signed-result 5) 0) (cons -2 -2))))
(check "bad seed refuses even when primal cannot certify" (raises? (lambda ()
  (solve-certified-native-pullback (vector (vector 0)) (vector 0) (vector 1.0) 1/10))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
