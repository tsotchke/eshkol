;;; core.reasoning.kge: exact AD gradients against closed forms and central
;;; differences, training on a small kinship graph, link prediction, and the
;;; shared core.ml.neurosymbolic embedding tables.
(require stdlib)
(require core.ml.neurosymbolic)
(require core.reasoning.kge)

(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (close? a b tol) (<= (abs (- a b)) (* tol (max 1.0 (abs a) (abs b)))))
(define (vclose? a b tol)
  (and (= (vector-length a) (vector-length b))
       (let loop ((i 0)) (or (= i (vector-length a)) (and (close? (vector-ref a i) (vector-ref b i) tol) (loop (+ i 1)))))))

(define kin '((ann parent bob) (bob parent cal) (cal parent dan) (eve parent fay) (fay parent gus)
              (hal parent ivy) (ivy parent jon)
              (bob child ann) (cal child bob) (fay child eve) (gus child fay) (ivy child hal) (jon child ivy)
              (ann married eve) (eve married ann) (bob married hal) (hal married bob)))
(define held-out '((dan child cal)))

;; ---- TransE gradient equals the closed form (active margin)
(define mt (make-kge 'transe 4))
(define pos '(ann parent bob))
(define neg '(cal parent dan))
(define g (kge-loss-gradient mt pos neg 10.0))
(define (vsub a b) (list->vector (map - (vector->list a) (vector->list b))))
(define (vadd a b) (list->vector (map + (vector->list a) (vector->list b))))
(define (vscale k a) (list->vector (map (lambda (x) (* k x)) (vector->list a))))
(define (block v from n) (list->vector (let loop ((i 0)) (if (= i n) '() (cons (vector-ref v (+ from i)) (loop (+ i 1)))))))
(define h (kge-entity-vector mt 'ann)) (define r (kge-relation-vector mt 'parent)) (define t (kge-entity-vector mt 'bob))
(define h2 (kge-entity-vector mt 'cal)) (define t2 (kge-entity-vector mt 'dan))
(define e1 (vsub (vadd h r) t))
(define e2 (vsub (vadd h2 r) t2))
(check "TransE dL/dh = 2(h+r-t)" (vclose? (block g 0 4) (vscale 2 e1) 1e-12))
(check "TransE dL/dr (positive block)" (vclose? (block g 4 4) (vscale 2 e1) 1e-12))
(check "TransE dL/dt = -2(h+r-t)" (vclose? (block g 8 4) (vscale -2 e1) 1e-12))
(check "TransE dL/dh' = -2(h'+r-t')" (vclose? (block g 12 4) (vscale -2 e2) 1e-12))
(check "TransE dL/dt' = 2(h'+r-t')" (vclose? (block g 20 4) (vscale 2 e2) 1e-12))
(check "inactive margin gives a zero gradient"
       (let ((z (kge-loss-gradient mt pos neg -10.0)))
         (let loop ((i 0)) (or (= i (vector-length z)) (and (= (vector-ref z i) 0) (loop (+ i 1)))))))

;; ---- every model: AD gradient equals central differences
(define (fd-agrees? model)
  (let* ((m (make-kge model 3)) (grad (kge-loss-gradient m pos neg 10.0))
         (ed (vector-length (kge-entity-vector m 'ann))) (rd (vector-length (kge-relation-vector m 'parent)))
         (eps 1e-6))
    (define (fd vec i)
      (let ((x (vector-ref vec i)))
        (vector-set! vec i (+ x eps))
        (let ((up (kge-loss m pos neg 10.0)))
          (vector-set! vec i (- x eps))
          (let ((down (kge-loss m pos neg 10.0)))
            (vector-set! vec i x)
            (/ (- up down) (* 2 eps))))))
    (and (let loop ((i 0)) (or (= i ed) (and (close? (fd (kge-entity-vector m 'ann) i) (vector-ref grad i) 1e-5) (loop (+ i 1)))))
         (let loop ((i 0)) (or (= i ed) (and (close? (fd (kge-entity-vector m 'bob) i) (vector-ref grad (+ ed rd i)) 1e-5) (loop (+ i 1)))))
         ;; the relation occurs in both triples: its derivative is the sum of both blocks
         (let loop ((i 0)) (or (= i rd) (and (close? (fd (kge-relation-vector m 'parent) i)
                                                      (+ (vector-ref grad (+ ed i)) (vector-ref grad (+ (* 3 ed) rd i))) 1e-5)
                                              (loop (+ i 1)))))
         (let loop ((i 0)) (or (= i ed) (and (close? (fd (kge-entity-vector m 'dan) i) (vector-ref grad (+ (* 3 ed) (* 2 rd) i)) 1e-5) (loop (+ i 1))))))))
(for-each (lambda (model) (check (string-append (symbol->string model) " gradient matches central differences") (fd-agrees? model)))
          '(transe distmult complex rotate))

;; ---- training and link prediction
(define (train model)
  (let* ((m (make-kge model 8)) (losses (kge-train! m kin 200 0.05)))
    (list m (car losses) (list-ref losses 199) (kge-evaluate m kin kin))))
(define results (map (lambda (model) (cons model (train model))) '(transe distmult complex rotate)))
(for-each (lambda (r)
            (let ((name (symbol->string (car r))) (first (caddr r)) (last (cadddr r)) (ev (car (cddddr r))))
              (check (string-append name " loss decreases") (< last (* 0.5 first)))
              (check (string-append name " fits the training triples (hits@3 = 1)") (= (cdr (assq 'hits3 ev)) 1))
              (check (string-append name " training MRR >= 0.7") (>= (cdr (assq 'mrr ev)) 0.7))))
          results)
(define complex-model (cadr (assq 'complex results)))
(check "ComplEx ranks a held-out inverse triple in the top 3"
       (<= (kge-rank complex-model 'dan 'child 'cal (append kin held-out)) 3))
(check "scores are reals" (real? (kge-score complex-model 'ann 'parent 'bob)))

;; ---- shared neuro-symbolic tables
(define tables (kge-tables complex-model))
(check "entity table is a neurosymbolic embedding table of width 2d" (= (emb-dim (car tables)) 16))
(check "the table's vector is the model's vector" (eq? (embed! (car tables) 'ann) (kge-entity-vector complex-model 'ann)))
(check "soft unification reads the trained vectors"
       (let ((c (soft-unify (car tables) 'ann 'eve))) (and (> c 0.0) (< c 1.0))))
(check "unknown model refused" (raises? (lambda () (make-kge 'holographic 4))))
(check "entities are symbols" (raises? (lambda () (kge-score complex-model "ann" 'parent 'bob))))

(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: reasoning_kge_test") (newline)
(display "RESULT: PASS") (newline)
