(require stdlib)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (same-vector? a b) (equal? (vector->list a) (vector->list b)))
(define (satisfies? a x b)
  (let row ((i 0))
    (or (= i (vector-length a))
        (and (= (let dot ((j 0) (sum 0))
                  (if (= j (vector-length x)) sum
                      (dot (+ j 1) (+ sum (* (exact-matrix-ref a i j) (vector-ref x j))))))
                (vector-ref b i))
             (row (+ i 1))))))
(define rectangular (vector (vector 2 1 0) (vector 0 0 1)))
(define answer (exact-affine-solve rectangular (vector 1 3)))
(check "rectangular particular" (same-vector? (car answer) (vector 1/2 0 3)))
(check "rectangular complete freedom" (and (= (length (cdr answer)) 1)
  (same-vector? (car (cdr answer)) (vector -1/2 1 0))))
(define over (exact-affine-solve (vector (vector 1) (vector 2) (vector 3)) (vector 2 4 6)))
(check "overdetermined consistent" (and (null? (cdr over)) (= (vector-ref (car over) 0) 2)))
(define free (exact-affine-solve (make-vector 0 0) (make-vector 0 0) 3))
(check "empty equations preserve declared ambient dimension"
  (and (= (vector-length (car free)) 3) (= (length (cdr free)) 3)
       (same-vector? (list-ref (cdr free) 0) (vector 1 0 0))
       (same-vector? (list-ref (cdr free) 1) (vector 0 1 0))
       (same-vector? (list-ref (cdr free) 2) (vector 0 0 1))))
(check "zero dimensional consistent" (null? (cdr (exact-affine-solve
  (vector (make-vector 0 0)) (vector 0)))))
(check "zero dimensional inconsistent" (raises? (lambda ()
  (exact-affine-solve (vector (make-vector 0 0)) (vector 1)))))

;; Independent determinant/augmented-minor oracle: all 729 integer 2x2
;; systems with entries and RHS in {-1,0,1}. No row reduction in the oracle.
(define oracle-ok #t)
(define oracle-cases 0)
(for-each (lambda (a) (for-each (lambda (b) (for-each (lambda (c)
 (for-each (lambda (d) (for-each (lambda (u) (for-each (lambda (v)
  (let* ((m (vector (vector a b) (vector c d))) (rhs (vector u v))
         (det (- (* a d) (* b c)))
         (rank (if (not (= det 0)) 2 (if (and (= a 0) (= b 0) (= c 0) (= d 0)) 0 1)))
         (consistent (if (= rank 2) #t
                         (if (= rank 0) (and (= u 0) (= v 0))
                             (and (= (- (* a v) (* c u)) 0)
                                  (= (- (* b v) (* d u)) 0))))))
    (set! oracle-cases (+ oracle-cases 1))
    (if (not consistent)
        (if (not (raises? (lambda () (exact-affine-solve m rhs)))) (set! oracle-ok #f))
        (let* ((s (exact-affine-solve m rhs)) (x (car s)) (basis (cdr s)))
          (if (not (and (satisfies? m x rhs) (= (length basis) (- 2 rank))))
              (set! oracle-ok #f))
          (for-each (lambda (n)
            (if (not (and (satisfies? m n (vector 0 0))
                          (or (not (= (vector-ref n 0) 0)) (not (= (vector-ref n 1) 0)))))
                (set! oracle-ok #f))) basis)
          (if (= rank 0)
              (let ((first (car basis)) (second (cadr basis)))
                (if (= (- (* (vector-ref first 0) (vector-ref second 1))
                          (* (vector-ref first 1) (vector-ref second 0))) 0)
                    (set! oracle-ok #f))))
          (if (= rank 2)
              (if (not (and (= (vector-ref x 0) (/ (- (* u d) (* b v)) det))
                            (= (vector-ref x 1) (/ (- (* a v) (* u c)) det))))
                  (set! oracle-ok #f))))))) '(-1 0 1))) '(-1 0 1))) '(-1 0 1)))
 '(-1 0 1))) '(-1 0 1))) '(-1 0 1))
(check "729 systems agree with independent minors and Cramer oracle" (and oracle-ok (= oracle-cases 729)))

(vector-set! (car answer) 0 99)
(vector-set! (car (cdr answer)) 0 99)
(define again (exact-affine-solve rectangular (vector 1 3)))
(check "input and later results isolated from observer mutation"
  (and (= (exact-matrix-ref rectangular 0 0) 2)
       (= (vector-ref (car again) 0) 1/2)
       (= (vector-ref (car (cdr again)) 0) -1/2)))
(check "ragged refused" (raises? (lambda () (exact-affine-solve
  (vector (vector 1) (vector 1 2)) (vector 0 0)))))
(check "inexact input refused" (raises? (lambda () (exact-affine-solve (vector (vector 1.0)) (vector 1)))))
(check "RHS width refused" (raises? (lambda () (exact-affine-solve (vector (vector 1)) (vector 1 2)))))
(check "explicit width mismatch refused" (raises? (lambda () (exact-affine-solve (vector (vector 1)) (vector 1) 2))))
(check "extra width arguments refused" (raises? (lambda () (exact-affine-solve (vector (vector 1)) (vector 1) 1 1))))
(check "negative empty width refused" (raises? (lambda () (exact-affine-solve (make-vector 0 0) (make-vector 0 0) -1))))
(check "unrepresentable empty width refused before allocation" (raises? (lambda ()
  (exact-affine-solve (make-vector 0 0) (make-vector 0 0) 9223372036854775808))))
(check "large rational result stays exact or explicitly refuses"
  (guard (e (else #t))
    (let ((x (vector-ref (car (exact-affine-solve (vector (vector 2)) (vector 9223372036854775809))) 0)))
      (and (exact? x) (= (* x 2) 9223372036854775809)))))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: exact_affine_test") (newline)
(display "RESULT: PASS") (newline)
