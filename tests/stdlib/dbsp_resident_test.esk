(require stdlib)
(require core.dbsp.resident)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define circuit (make-dbsp-circuit '(a b) (list
  (list 'join 'joined 'a 'b car car (lambda (a b) (list (car a) (cadr a) (cadr b))))
  (list 'distinct 'out 'joined)) 'out))
(define saved-owner 0)
(define saved-root 0)
(define escaped
  (call-with-dbsp-resident circuit 65536 (lambda (owner initial)
    (set! saved-owner owner) (set! saved-root initial)
    (check "initial snapshot empty" (zset-empty? (dbsp-resident-output owner initial)))
    (define changes (list (list 'a (zset-singleton '(1 "left") 1))
                          (list 'b (zset-singleton '(1 "right") 1))))
    (define first (dbsp-resident-step owner initial changes))
    (check "standing join result" (= (zset-weight (dbsp-resident-output owner first) '(1 "left" "right")) 1))
    (check "inexact snapshot token refuses before FFI coercion" (raises? (lambda ()
      (dbsp-resident-output owner (exact->inexact first)))))
    (check "inexact owner token refuses before FFI coercion" (raises? (lambda ()
      (dbsp-resident-stats (exact->inexact owner)))))
    (check "invalid release cannot truncate to a live handle" (and
      (raises? (lambda () (dbsp-resident-release! owner (+ (exact->inexact first) 1/4))))
      (= (vector-ref (dbsp-resident-stats owner) 0) 2)))
    (call-with-dbsp-resident circuit 65536 (lambda (other other-initial)
      (check "snapshot handles are bound to their owner" (raises? (lambda ()
        (dbsp-resident-output other first))))))
    (check "initial fork preserved" (zset-empty? (dbsp-resident-output owner initial)))
    (define fork (dbsp-resident-step owner first (list (list 'a (zset-singleton '(1 "other") 1)))))
    (check "fork has new match" (= (zset-weight (dbsp-resident-output owner fork) '(1 "other" "right")) 1))
    (dbsp-resident-compact! owner)
    (check "retained first survives compaction" (= (zset-size (dbsp-resident-output owner first)) 1))
    (check "retained fork survives compaction" (= (zset-size (dbsp-resident-output owner fork)) 2))
    (check "released initial can be reclaimed" (= (vector-ref (dbsp-resident-stats owner) 0) 3))
    (dbsp-resident-release! owner initial)
    (check "released snapshot handle refuses" (raises? (lambda () (dbsp-resident-output owner initial))))
    (check "double release refuses" (raises? (lambda () (dbsp-resident-release! owner initial))))
    (define observation (dbsp-resident-output owner first))
    (define row (cadr (car (zset-entries observation))))
    (set-car! row 999)
    (check "nested output rows are owned copies" (= (zset-weight (dbsp-resident-output owner first) '(1 "left" "right")) 1))
    (define text-view (dbsp-resident-output owner first))
    (string-set! (cadr (cadr (car (zset-entries text-view)))) 0 #\X)
    (check "nested output strings do not alias retained rows" (= (zset-weight (dbsp-resident-output owner first) '(1 "left" "right")) 1))
    (define from-nursery (with-region
      (let ((text (string-copy "nursery")))
        (dbsp-resident-step owner first (list (list 'a (zset-singleton (list 1 text) 1)))))))
    (dbsp-resident-compact! owner)
    (check "imported caller nursery data survives" (= (zset-weight (dbsp-resident-output owner from-nursery) '(1 "nursery" "right")) 1))
    (dbsp-resident-release! owner from-nursery)
    (define ancestor-text (string-copy "shared"))
    (define from-ancestor (with-region
      (dbsp-resident-step owner first (list (list 'a (zset-singleton (list 1 ancestor-text) 1))))))
    (string-set! ancestor-text 0 #\X)
    (check "imports freeze older caller payloads too" (= (zset-weight
      (dbsp-resident-output owner from-ancestor) '(1 "shared" "right")) 1))
    (dbsp-resident-release! owner from-ancestor)
    (dbsp-resident-release! owner fork)
    (define retired (dbsp-resident-stats owner))
    (check "live-root count follows explicit releases" (= (vector-ref retired 0) 1))
    (dbsp-resident-compact! owner)
    (check "compaction work is reported" (> (vector-ref (dbsp-resident-stats owner) 3) 0))
    (dbsp-resident-output owner first))))
(check "copied observation survives owner close" (= (zset-weight escaped '(1 "left" "right")) 1))
(check "owner cannot be used beyond scope" (raises? (lambda () (dbsp-resident-output saved-owner saved-root))))
(check "owner statistics reject stale handle" (raises? (lambda () (dbsp-resident-stats saved-owner))))
(define guarded (make-dbsp-circuit '(a) (list (list 'map 'out 'a
  (lambda (x) (if (= x 99) (error "resident callback rejected row" (list x)) x)))) 'out))
(call-with-dbsp-resident guarded 65536 (lambda (owner initial)
  (check "callback exception refuses successor" (raises? (lambda ()
    (dbsp-resident-step owner initial (list (list 'a (zset-singleton 99 1)))))))
  (check "callback failure retains only original snapshot" (= (vector-ref (dbsp-resident-stats owner) 0) 1))
  (check "callback failure leaves snapshot empty" (zset-empty? (dbsp-resident-output owner initial)))
  (define next (dbsp-resident-step owner initial (list (list 'a (zset-singleton 4 1)))))
  (check "valid update after callback failure" (= (zset-weight (dbsp-resident-output owner next) 4) 1))
  (check "unknown input refuses atomically" (raises? (lambda ()
    (dbsp-resident-step owner next (list (list 'foreign (zset-empty)))))))
  (check "no hidden retained root after failure" (= (vector-ref (dbsp-resident-stats owner) 0) 2))))
(check "constructor threshold rejects malformed input" (raises? (lambda ()
  (call-with-dbsp-resident circuit 10 (lambda (owner root) root)))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
