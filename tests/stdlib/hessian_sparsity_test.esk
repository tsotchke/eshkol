(require stdlib)
(require core.ad.sparsity)
(require core.ad.sparse_guw)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define path (vector '(1) '(0 2) '(1 3) '(2)))
(define colored (hessian-color-graph path))
(check "existing degree order and color tie rules retained"
  (and (= (cdr colored) 3) (equal? (vector->list (car colored)) '(2 1 0 2))))
(define empty (hessian-color-graph (vector)))
(check "empty graph has zero colors" (and (= (cdr empty) 0) (= (vector-length (car empty)) 0)))
(define star (make-vector 12 '()))
(let leaves ((i 1) (neighbors '()))
  (if (= i 12) (vector-set! star 0 (reverse neighbors))
    (begin (vector-set! star i '(0)) (leaves (+ i 1) (cons i neighbors)))))
(check "distance-two star honestly uses one color per vertex" (= (cdr (hessian-color-graph star)) 12))
(for-each (lambda (thunk) (check "malformed structural graph refuses" (raises? thunk)))
  (list
    (lambda () (hessian-color-graph (vector '(1) '())))
    (lambda () (hessian-color-graph (vector '(0))))
    (lambda () (hessian-color-graph (vector '(1 1) '(0))))
    (lambda () (hessian-color-graph (vector '(2) '(0))))
    (lambda () (hessian-color-graph (vector '(1.0) '(0))))))
(define (numeric xs)
  (+ (* (vector-ref xs 0) (vector-ref xs 0))
     (* (vector-ref xs 1) (vector-ref xs 1))
     (* (vector-ref xs 0) (vector-ref xs 1))))
(define recovered (sparse-hessian-pat numeric (vector 1.0 2.0) '((0 1))))
(check "numeric sparse AD retains diagonal" (< (abs (- (sparse-hessian-ref recovered 0 0) 2.0)) 1e-10))
(check "numeric sparse AD retains mixed term" (< (abs (- (sparse-hessian-ref recovered 0 1) 1.0)) 1e-10))
(check "numeric sparse AD retains symmetry" (= (sparse-hessian-ref recovered 0 1) (sparse-hessian-ref recovered 1 0)))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
