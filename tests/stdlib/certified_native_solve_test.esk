(require stdlib)
(require core.certified_native_solve)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (contains? box x) (and (<= (car box) x) (<= x (cdr box))))
(for-each (lambda (scale)
 (let* ((a (vector (vector (* scale 2/3) (* scale 1/7)) (vector (* scale -1/5) (* scale 3/2))))
        (truth (vector 7/3 -5/7))
        (b (vector (* scale (- 14/9 5/49)) (* scale (- -7/15 15/14))))
        (r (solve-certified-native a b 1/1000000000000)))
  (check "native candidates certify original non-dyadic system" (eq? (vector-ref r 1) 'proved))
  (check "independent analytic answer lies in certificate" (and (contains? (vector-ref (vector-ref r 3) 0) 7/3) (contains? (vector-ref (vector-ref r 3) 1) -5/7)))
  (check "source-bound verifier" (verify-certified-native-solve r a b 1/1000000000000))
  (check "changed original coefficient refuses old result" (not (verify-certified-native-solve r (vector (vector 1 0) (vector 0 1)) b 1/1000000000000)))
  (check "cost exposes two native candidate calls" (= (vector-ref (vector-ref r 5) 2) 2)))) '(1 1000 1/1000))
(define identity (vector (vector 1 0) (vector 0 1)))
(define exact-result (solve-certified-native identity (vector 3 -2) 0 0))
(check "zero tolerance exact case" (eq? (vector-ref exact-result 1) 'proved))
(define a (vector (vector 1))) (define b (vector 1/5003))
(define initial (solve-certified-native a b 0 0))
(check "zero tolerance cannot hide non-dyadic error" (and (eq? (vector-ref initial 1) 'unknown) (not (vector-ref initial 3))))
(define refined (solve-certified-native a b 1/1000000000000000 3))
(check "exact defect correction improves received candidate" (eq? (vector-ref refined 1) 'proved))
(check "correction actually exercised" (> (vector-ref (vector-ref refined 5) 1) 0))
(check "refined independent rational" (contains? (vector-ref (vector-ref refined 3) 0) 1/5003))
(define uncertain (solve-certified-native identity (vector 1 2) 1/10 1 (vector 1 1)
  (vector (vector 0 0) (vector 0 0)) (vector 1/100 1/100)))
(check "declared uncertainty certified uniformly" (eq? (vector-ref uncertain 1) 'proved))
(check "uncertainty verified against original premises" (verify-certified-native-solve uncertain identity (vector 1 2) 1/10 (vector 1 1)
  (vector (vector 0 0) (vector 0 0)) (vector 1/100 1/100)))
(check "omitting declared uncertainty refuses receipt" (not (verify-certified-native-solve uncertain identity (vector 1 2) 1/10)))
(check "singular zero-residual problem stays unresolved" (eq? (vector-ref (solve-certified-native
  (vector (vector 1 1) (vector 1 1)) (vector 0 0) 1/10) 1) 'unknown))
(check "uncertainty beyond invertibility returns unknown" (eq? (vector-ref (solve-certified-native identity (vector 1 2) 1 0 (vector 1 1)
  (vector (vector 1 0) (vector 0 1))) 1) 'unknown))
(check "inexact model refuses" (raises? (lambda () (solve-certified-native (vector (vector 1.0)) (vector 1) 1/10))))
(check "negative tolerance refuses" (raises? (lambda () (solve-certified-native a b -1))))
(check "invalid correction budget refuses" (raises? (lambda () (solve-certified-native a b 1/10 9))))
(check "negative uncertainty refuses before native execution" (raises? (lambda () (solve-certified-native a b 1 0 (vector 1) (vector (vector -1))))))
(define forged (vector-copy exact-result)) (vector-set! forged 3 (vector (cons 0 0) (cons 0 0)))
(check "edited enclosure refuses" (not (verify-certified-native-solve forged identity (vector 3 -2) 0)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
