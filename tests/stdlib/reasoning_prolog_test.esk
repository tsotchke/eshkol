;;; core.reasoning.prolog: SLD resolution, control, tabling, KB bridge,
;;; and the classic benchmark set (naive reverse, n-queens, zebra) with
;;; answers checked against independent computations.
(require stdlib)
(require core.reasoning.prolog)

(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (vals var answers) (map (lambda (s) (walk var s)) answers))

;; ---------------------------------------------------------------- basics
(define fam (make-prolog))
(prolog-consult! fam
  '((parent tom bob) (parent tom liz) (parent bob ann) (parent bob pat) (parent pat jim)
    (<- (ancestor ?x ?y) (parent ?x ?y))
    (<- (ancestor ?x ?y) (parent ?x ?z) (ancestor ?z ?y))
    (<- (sibling ?x ?y) (parent ?p ?x) (parent ?p ?y) (/= ?x ?y))))
(check "ancestor answers in SLD order"
       (equal? (vals '?w (prolog-query fam '(ancestor tom ?w))) '(bob liz ann pat jim)))
(check "answers are engine substitutions" (substitution? (car (prolog-query fam '(parent tom ?c)))))
(check "sibling with disequality" (equal? (vals '?s (prolog-query fam '(sibling ann ?s))) '(pat)))
(check "prove? true" (prolog-prove? fam '(ancestor tom jim)))
(check "prove? false" (not (prolog-prove? fam '(ancestor jim tom))))
(check "query limit" (= (length (prolog-query fam '(ancestor ?a ?b) 3)) 3))
(check "count all ancestor pairs" (= (prolog-count fam '(ancestor ?a ?b)) 9))
(check "unknown predicate is an existence error" (raises? (lambda () (prolog-query fam '(cousin ?a ?b)))))
(check "unknown mode fail" (begin (prolog-set-unknown! fam 'fail)
                                  (let ((r (null? (prolog-query fam '(cousin ?a ?b)))))
                                    (prolog-set-unknown! fam 'error) r)))

;; append in all modes; terms are cons structure
(define lib (make-prolog))
(check "append splits" (= (prolog-count lib '(append ?x ?y (1 2 3 4))) 5))
(check "append (h . t) pattern"
       (equal? (prolog-query-terms lib '(= (?h . ?t) (1 2 3))) '((= (1 2 3) (1 2 3)))))
(check "member enumerates" (equal? (vals '?x (prolog-query lib '(member ?x (a b c)))) '(a b c)))
(check "permutation count 5! = 120" (= (prolog-count lib '(permutation (1 2 3 4 5) ?p)) 120))
(check "reverse" (equal? (walk '?r (car (prolog-query lib '(reverse (1 2 3) ?r)))) '(3 2 1)))
(check "nth1/nth0" (and (equal? (walk '?x (car (prolog-query lib '(nth1 2 (a b c) ?x)))) 'b)
                        (equal? (walk '?x (car (prolog-query lib '(nth0 2 (a b c) ?x)))) 'c)))
(check "length generates" (equal? (prolog-count lib '(and (length ?l 3) (= ?l (a ?_ c)))) 1))

;; ---------------------------------------------------------------- control
(define ctl (make-prolog))
(prolog-consult! ctl
  '((<- (max-of ?x ?y ?x) (>= ?x ?y) !)
    (max-of ?_ ?y ?y)
    (<- (first-member ?x ?l) (member ?x ?l) !)
    (<- (classify ?n neg) (< ?n 0) !)
    (<- (classify 0 zero) !)
    (classify ?_ pos)
    (<- (disj ?x) (or (= ?x 1) (= ?x 2) (= ?x 3)))
    (<- (cut-in-disj ?x) (or (and (= ?x 1) !) (= ?x 2)))
    (<- (ite ?x ?r) (if (> ?x 10) (= ?r big) (= ?r small)))
    (<- (not-member ?x ?l) (not (member ?x ?l)))))
(check "cut commits max" (equal? (prolog-query-terms ctl '(max-of 5 3 ?m)) '((max-of 5 3 5))))
(check "cut in second clause path" (equal? (prolog-query-terms ctl '(max-of 2 3 ?m)) '((max-of 2 3 3))))
(check "cut after member keeps one" (= (prolog-count ctl '(first-member ?x (a b c))) 1))
(check "classify by cut" (equal? (map (lambda (n) (walk '?c (car (prolog-query ctl (list 'classify n '?c)))))
                                      '(-4 0 9))
                                 '(neg zero pos)))
(check "disjunction" (equal? (vals '?x (prolog-query ctl '(disj ?x))) '(1 2 3)))
(check "cut inside disjunction is transparent" (equal? (vals '?x (prolog-query ctl '(cut-in-disj ?x))) '(1)))
(check "if-then-else" (equal? (list (walk '?r (car (prolog-query ctl '(ite 20 ?r))))
                                    (walk '?r (car (prolog-query ctl '(ite 2 ?r)))))
                              '(big small)))
(check "negation as failure" (and (prolog-prove? ctl '(not-member d (a b c)))
                                  (not (prolog-prove? ctl '(not-member b (a b c))))))
(check "findall" (equal? (walk '?l (car (prolog-query ctl '(findall (p ?x) (member ?x (1 2 3)) ?l))))
                         '((p 1) (p 2) (p 3))))
(check "forall" (and (prolog-prove? ctl '(forall (member ?x (2 4 6)) (num= 0 (mod ?x 2))))
                     (not (prolog-prove? ctl '(forall (member ?x (2 5)) (num= 0 (mod ?x 2)))))))
(check "call/N adds arguments" (equal? (vals '?x (prolog-query ctl '(call member ?x (u v)))) '(u v)))
(check "once" (= (prolog-count ctl '(once (member ?x (a b c)))) 1))
(check "exact arithmetic" (equal? (walk '?x (car (prolog-query ctl '(is ?x (+ (/ 1 3) (/ 1 6)))))) 1/2))
(check "bignum arithmetic" (equal? (walk '?x (car (prolog-query ctl '(is ?x (expt 2 100)))))
                                   1267650600228229401496703205376))
(check "between" (equal? (vals '?x (prolog-query ctl '(between 3 6 ?x))) '(3 4 5 6)))
(check "instantiation error in is" (raises? (lambda () (prolog-query ctl '(is ?x (+ ?y 1))))))
(check "occurs check builtin" (and (= 1 (prolog-count ctl '(= ?x (f ?x))))
                                   (not (prolog-prove? ctl '(unify-with-occurs-check ?x (f ?x))))))
(check "functor and arg" (equal? (prolog-query-terms ctl '(and (functor (f a b) ?n ?k) (arg 2 (f a b) ?z)))
                                 '((and (functor (f a b) f 2) (arg 2 (f a b) b)))))

;; dynamic database: assertz / retract under the logical update view
(define dyn (make-prolog))
(prolog-dynamic! dyn 'counter 1)
(check "dynamic predicate fails before assert" (not (prolog-prove? dyn '(counter ?n))))
(prolog-query dyn '(and (assertz (counter 0)) (assertz (counter 1))))
(check "assertz added" (= (prolog-count dyn '(counter ?n)) 2))
(prolog-query dyn '(retract (counter 0)))
(check "retract removed" (equal? (vals '?n (prolog-query dyn '(counter ?n))) '(1)))
(prolog-query dyn '(assertz (<- (twice ?x ?y) (is ?y (* 2 ?x)))))
(check "asserted rule runs" (equal? (walk '?y (car (prolog-query dyn '(twice 21 ?y)))) 42))

;; host predicates
(define host (make-prolog))
(prolog-define-builtin! host 'even-num 1 (lambda (x) (and (integer? x) (even? x))))
(prolog-define-function! host 'square 2 (lambda (x) (* x x)))
(check "host builtin and function"
       (equal? (vals '?y (prolog-query host '(and (member ?x (1 2 3 4)) (even-num ?x) (square ?x ?y))))
               '(4 16)))

;; ---------------------------------------------------------------- KB bridge
(define kb (make-kb))
(kb-assert! kb '(edge a b))
(kb-assert! kb '(edge b c))
(kb-assert! kb '(edge c d))
(define kbp (make-prolog))
(prolog-attach-kb! kbp kb)
(prolog-consult! kbp '((<- (reach ?x ?y) (edge ?x ?y))
                       (<- (reach ?x ?y) (edge ?x ?z) (reach ?z ?y))))
(check "rules over an attached make-kb knowledge base"
       (equal? (vals '?y (prolog-query kbp '(reach a ?y))) '(b c d)))
(check "bound KB goal" (prolog-prove? kbp '(edge b c)))

;; ---------------------------------------------------------------- tabling
;; Left recursion over a cyclic graph terminates with the full answer set,
;; checked against breadth-first reachability computed directly.
(define graph '((1 2) (2 3) (3 1) (3 4) (4 5) (6 6) (5 7) (7 5)))
(define tab (make-prolog))
(for-each (lambda (e) (prolog-add! tab (cons 'edge e))) graph)
(prolog-table! tab 'path 2)
(prolog-consult! tab '((<- (path ?x ?y) (path ?x ?z) (edge ?z ?y))
                       (<- (path ?x ?y) (edge ?x ?y))))
(define (bfs start)
  (let loop ((frontier (list start)) (seen '()))
    (if (null? frontier) (sort seen <)
        (let* ((next (fold-left (lambda (acc e) (if (and (= (car e) (car frontier)) (not (memv (cadr e) seen))
                                                         (not (memv (cadr e) acc)))
                                                    (cons (cadr e) acc) acc))
                                '() graph)))
          (loop (append (cdr frontier) next) (append seen next))))))
(define (tabled-reach x) (sort (vals '?y (prolog-query tab (list 'path x '?y))) <))
(check "left-recursive tabled path from 1" (equal? (tabled-reach 1) (bfs 1)))
(check "tabled path from 5" (equal? (tabled-reach 5) (bfs 5)))
(check "tabled path from 6 (self loop)" (equal? (tabled-reach 6) '(6)))
(check "all pairs tabled" (= (prolog-count tab '(path ?a ?b))
                             (fold-left + 0 (map (lambda (n) (length (bfs n))) '(1 2 3 4 5 6 7)))))
(check "table answers readable" (= (length (prolog-table-answers tab '(path 1 ?y))) (length (bfs 1))))
;; mutual left recursion: one SCC, two tabled predicates
(define mut (make-prolog))
(prolog-consult! mut '((e a b) (e b c) (e c a) (f c d) (f d e2)
                       (<- (p ?x ?y) (q ?x ?z) (e ?z ?y))
                       (<- (p ?x ?y) (e ?x ?y))
                       (<- (q ?x ?y) (p ?x ?z) (f ?z ?y))
                       (<- (q ?x ?y) (p ?x ?y))))
(prolog-table! mut 'p 2)
(prolog-table! mut 'q 2)
(check "mutually recursive tabled predicates"
       (equal? (sort (map symbol->string (vals '?y (prolog-query mut '(q a ?y)))) string<?)
               '("a" "b" "c" "d")))
;; same-generation (double recursion) with tabling
(define sg (make-prolog))
(prolog-consult! sg '((par c1 p1) (par c2 p1) (par p1 g) (par p2 g) (par c3 p2) (par g top)
                      (<- (sg ?x ?x) (par ?x ?_))
                      (<- (sg ?x ?y) (par ?x ?px) (sg ?px ?py) (par ?y ?py))))
(prolog-table! sg 'sg 2)
(check "same generation" (equal? (sort (map symbol->string (vals '?y (prolog-query sg '(sg c1 ?y)))) string<?)
                                 '("c1" "c2" "c3")))
;; negation over a table still being computed is reported
(define ns (make-prolog))
(prolog-consult! ns '((<- (win ?x) (move ?x ?y) (not (win ?y))) (move a b) (move b a)))
(prolog-table! ns 'win 1)
(check "non-stratified negation through a table is reported" (raises? (lambda () (prolog-query ns '(win a)))))

;; ---------------------------------------------------------------- benchmarks
;; naive reverse of a 30-element list: 496 logical inferences per run.
(define nrev (make-prolog))
(prolog-consult! nrev '((app () ?l ?l)
                        (<- (app (?h . ?t) ?l (?h . ?r)) (app ?t ?l ?r))
                        (nrev () ())
                        (<- (nrev (?h . ?t) ?r) (nrev ?t ?rt) (app ?rt (?h) ?r))))
(define l30 (let mk ((i 30) (acc '())) (if (= i 0) acc (mk (- i 1) (cons i acc)))))
(prolog-reset-inferences! nrev)
(define nrev-answer (prolog-query nrev (list 'nrev l30 '?r)))
(check "nrev30 result" (equal? (walk '?r (car nrev-answer)) (reverse l30)))
(check "nrev30 is 496 inferences" (= (prolog-inferences nrev) 496))
(check "nrev30 deterministic (one solution)" (= (length nrev-answer) 1))

;; n-queens: solution counts for n = 4..8 match the known sequence
;; (2, 10, 4, 40, 92), and the first 8-queens solution is valid.
(define queens (make-prolog))
(prolog-consult! queens
  '((<- (queens ?n ?qs) (numlist 1 ?n ?ns) (permutation ?ns ?qs) (safe ?qs))
    (<- (numlist ?n ?n (?n)) !)
    (<- (numlist ?l ?h (?l . ?t)) (< ?l ?h) (is ?l1 (+ ?l 1)) (numlist ?l1 ?h ?t))
    (safe ())
    (<- (safe (?q . ?qs)) (no-attack ?q ?qs 1) (safe ?qs))
    (no-attack ?_ () ?_)
    (<- (no-attack ?q (?q1 . ?qs) ?d) (num/= ?q (+ ?q1 ?d)) (num/= ?q (- ?q1 ?d))
        (is ?d1 (+ ?d 1)) (no-attack ?q ?qs ?d1))
    ;; constraint-and-generate formulation used for the larger counts
    (<- (queens2 ?n ?qs) (numlist 1 ?n ?ns) (place ?ns () ?qs))
    (place () ?qs ?qs)
    (<- (place ?unplaced ?safe ?qs) (select ?q ?unplaced ?r) (no-attack ?q ?safe 1)
        (place ?r (?q . ?safe) ?qs))))
(define (queens-valid? qs)
  (let loop ((rest qs))
    (or (null? rest)
        (and (let inner ((others (cdr rest)) (d 1))
               (or (null? others)
                   (and (not (= (car rest) (car others)))
                        (not (= (abs (- (car rest) (car others))) d))
                        (inner (cdr others) (+ d 1)))))
             (loop (cdr rest))))))
(check "6-queens by generate-and-test: 4 solutions" (= (prolog-count queens '(queens 6 ?q)) 4))
(check "queens counts 4..8 = 2 10 4 40 92"
       (equal? (map (lambda (n) (prolog-count queens (list 'queens2 n '?q))) '(4 5 6 7 8)) '(2 10 4 40 92)))
(check "first 8-queens solution is valid"
       (queens-valid? (walk '?q (car (prolog-query queens '(queens2 8 ?q) 1)))))

;; zebra puzzle (five houses): the Japanese owns the zebra, the Norwegian
;; drinks water, and the solution is unique.
(define zebra (make-prolog))
(prolog-consult! zebra
  '((<- (right-of ?a ?b (?b ?a . ?_)))
    (<- (right-of ?a ?b (?_ . ?t)) (right-of ?a ?b ?t))
    (<- (next-to ?a ?b ?l) (right-of ?a ?b ?l))
    (<- (next-to ?a ?b ?l) (right-of ?b ?a ?l))
    (<- (zebra ?houses ?zebra-owner ?water-drinker)
        (= ?houses ((h ?_ norwegian ?_ ?_ ?_) ?_ (h ?_ ?_ ?_ milk ?_) ?_ ?_))
        (member (h red english ?_ ?_ ?_) ?houses)
        (member (h ?_ spanish dog ?_ ?_) ?houses)
        (member (h green ?_ ?_ coffee ?_) ?houses)
        (member (h ?_ ukrainian ?_ tea ?_) ?houses)
        (right-of (h green ?_ ?_ ?_ ?_) (h ivory ?_ ?_ ?_ ?_) ?houses)
        (member (h ?_ ?_ snails ?_ winston) ?houses)
        (member (h yellow ?_ ?_ ?_ kools) ?houses)
        (next-to (h ?_ ?_ ?_ ?_ chesterfield) (h ?_ ?_ fox ?_ ?_) ?houses)
        (next-to (h ?_ ?_ ?_ ?_ kools) (h ?_ ?_ horse ?_ ?_) ?houses)
        (member (h ?_ ?_ ?_ orange-juice lucky-strike) ?houses)
        (member (h ?_ japanese ?_ ?_ parliament) ?houses)
        (next-to (h ?_ norwegian ?_ ?_ ?_) (h blue ?_ ?_ ?_ ?_) ?houses)
        (member (h ?_ ?zebra-owner zebra ?_ ?_) ?houses)
        (member (h ?_ ?water-drinker ?_ water ?_) ?houses))))
(define zebra-answers (prolog-query zebra '(zebra ?h ?z ?w)))
(check "zebra unique solution" (= (length zebra-answers) 1))
(check "japanese owns the zebra" (eq? (walk '?z (car zebra-answers)) 'japanese))
(check "norwegian drinks water" (eq? (walk '?w (car zebra-answers)) 'norwegian))
(check "zebra house colours"
       (equal? (map cadr (walk '?h (car zebra-answers))) '(yellow blue red ivory green)))

(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: reasoning_prolog_test") (newline)
(display "RESULT: PASS") (newline)
