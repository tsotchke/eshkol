;;; Selected MIT admission controls for the existing upstream SAT module.
(require core.reasoning.sat)
(define passed 0)
(define (check label ok) (if (not ok) (error "SAT admission" label)) (set! passed (+ passed 1)))
(define (refuses? thunk) (guard (e (else #t)) (thunk) #f))
(check 'dimacs-invalid-0 (refuses? (lambda () (dimacs-parse ""))))
(check 'dimacs-invalid-1 (refuses? (lambda () (dimacs-parse "1 0"))))
(check 'dimacs-invalid-2 (refuses? (lambda () (dimacs-parse "p dnf 1 1\n1 0\n"))))
(check 'dimacs-invalid-3 (refuses? (lambda () (dimacs-parse "p cnf 1"))))
(check 'dimacs-invalid-4 (refuses? (lambda () (dimacs-parse "p cnf -1 0"))))
(check 'dimacs-invalid-5 (refuses? (lambda () (dimacs-parse "p cnf 1 -1"))))
(check 'dimacs-invalid-6 (refuses? (lambda () (dimacs-parse "p cnf 1.0 1\n1 0\n"))))
(check 'dimacs-invalid-7 (refuses? (lambda () (dimacs-parse "p cnf 1 1/1\n1 0\n"))))
(check 'dimacs-invalid-8 (refuses? (lambda () (dimacs-parse "p cnf 1 2\n1 0\n"))))
(check 'dimacs-invalid-9 (refuses? (lambda () (dimacs-parse "p cnf 1 0\n1 0\n"))))
(check 'dimacs-invalid-10 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1\n"))))
(check 'dimacs-invalid-11 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n2 0\n"))))
(check 'dimacs-invalid-12 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1.0 0\n"))))
(check 'dimacs-invalid-13 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1/1 0\n"))))
(check 'dimacs-invalid-14 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n#x1 0\n"))))
(check 'dimacs-invalid-15 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1 1 0\n"))))
(check 'dimacs-invalid-16 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1 -1 0\n"))))
(check 'dimacs-invalid-17 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1 0 0\n"))))
(check 'dimacs-invalid-18 (refuses? (lambda () (dimacs-parse "p cnf 1 1\n1 0 p cnf 1 0\n"))))
(check 'valid-empty (equal? (dimacs-parse "p cnf 0 0\n") '(0)))
(check 'valid-empty-clause (equal? (dimacs-parse "p cnf 0 1\n0\n") '(0 ())))
(check 'valid-multiline (equal? (dimacs-parse "c test\np cnf 3 2\n1\n-2 0\nc next\n3 0\n") '(3 (1 -2) (3))))
(check 'canonical-format (equal? (dimacs-parse (dimacs-format '((1 1) (2 -2) (-1)))) '(2 (1) (-1))))
(check 'valid-unit-proof (drat-check '((1) (-1)) '((add))))
(check 'duplicate-proof-normalizes (drat-check '((1) (-1)) '((add 1 1) (add))))
(check 'canonical-drat-format (string=? (drat-format '((add 1 1) (delete 1 1) (add))) "1 0\nd 1 0\n0\n"))
(check 'unit-deletion-honored (not (drat-check '((1) (-1)) '((delete 1) (add)))))
(check 'duplicate-literal-deletion (not (drat-check '((1 1) (-1)) '((delete 1) (add)))))
(check 'one-clause-copy-deleted (drat-check '((1) (1) (-1)) '((delete 1) (add))))
(check 'source-tautology-ignored (drat-check '((1 -1) (2) (-2)) '((add))))
(check 'satisfiable-forgery (not (drat-check '((1 2)) '((add 1) (add -1) (add)))))
(check 'proof-needs-empty (not (drat-check '((1) (-1)) '((add 1)))))
(check 'proof-missing (not (drat-check '((1) (-1)) '())))
(check 'proof-kind (not (drat-check '((1) (-1)) '((bogus)))))
(check 'proof-kind-after-empty (not (drat-check '((1) (-1)) '((add) (bogus)))))
(check 'proof-atom (not (drat-check '((1) (-1)) '(oops))))
(check 'proof-improper (not (drat-check '((1) (-1)) '((add) . 1))))
(check 'step-improper (not (drat-check '((1) (-1)) '((add . 1)))))
(check 'proof-literal-zero (not (drat-check '((1) (-1)) '((add 0) (add)))))
(check 'proof-literal-inexact (not (drat-check '((1) (-1)) '((add 1.0) (add)))))
(check 'proof-literal-rational (not (drat-check '((1) (-1)) '((add 1/2) (add)))))
(check 'proof-tautology (not (drat-check '((1) (-1)) '((add 2 -2) (add)))))
(check 'cnf-improper (not (drat-check '((1) . -1) '((add)))))
(check 'clause-improper (not (drat-check '((1 . 2) (-1)) '((add)))))
(check 'cnf-literal-zero (not (drat-check '((0) ()) '((add)))))
(check 'format-kind-refuses (refuses? (lambda () (drat-format '((bogus))))))
(check 'format-zero-refuses (refuses? (lambda () (drat-format '((add 0))))))
(define cyclic-row (list 1))
(set-cdr! cyclic-row cyclic-row)
(check 'cyclic-row (not (drat-check (list cyclic-row) '((add)))))
(define cyclic-proof (list '(add)))
(set-cdr! cyclic-proof cyclic-proof)
(check 'cyclic-proof (not (drat-check '((1) (-1)) cyclic-proof)))
(display "PASS sat_admission ") (display passed) (newline)
