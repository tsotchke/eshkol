(require stdlib) (require core.sblc) (require core.dbsp.circuit)
(define checks 0)
(define (check name ok) (set! checks (+ checks 1))
  (if (not ok) (begin (display "FAIL: ") (write name) (newline) (exit 1))))
(define (raises? f) (eq? 'raised (guard (e (else 'raised)) (f) 'returned)))
(define I (blc-lam (blc-var 1)))
(define K (blc-lam (blc-lam (blc-var 2))))
(define W (blc-lam (blc-app (blc-var 1) (blc-var 1))))
(define ii (list I I)) (define ik (list I K))
(define slow (list (blc-app I I) I))
(define partial (list (sblc-choice I (blc-app W W)) I))
(define state (sblc-search-start 7 0 0 '()))
(define bag (zset-empty))
(define events (zset-empty))
(define observer (make-dbsp-circuit '(events)
  (list (list 'filter 'accepted 'events (lambda (row) (eq? (cadr row) 'accepted)))) 'accepted))
(define (examples-of current)
  (apply append (map (lambda (e)
    (let loop ((n (car e)))
      (if (= n 0) '() (cons (cons (caadr e) (cadadr e)) (loop (- n 1)))))) (zset-entries current))))
(define (same a b) (string=? (sblc-receipt->string a) (sblc-receipt->string b)))
(define (advance delta L bound)
  (let* ((old state) (before (sblc-search-checkpoint old))
         (update (sblc-search-update old delta L bound))
         (next (sblc-update-search update))
         (next-bag (zset-add bag delta))
         (step (dbsp-circuit-step observer (list (list 'events (sblc-update-delta update))))))
    (check 'update-equals-independent-fresh-model
           (same (sblc-search-receipt next) (sblc-condition 7 L bound (examples-of next-bag))))
    (check 'parent-unchanged (equal? before (sblc-search-checkpoint old)))
    (set! events (zset-add events (sblc-update-delta update)))
    (check 'actual-dbsp-observer
           (zset=? (dbsp-circuit-output (car step))
                    (zset-filter (lambda (row) (eq? (cadr row) 'accepted)) events)))
    (set! state next) (set! bag next-bag) (set! observer (car step))
    update))
(define first (advance (zset-singleton ii 1) 4 0))
(check 'new-independent-trial (= 1 (vector-ref (sblc-update-stats first) 1)))
(check 'unfinished-prior-event (= 1 (zset-weight events (list (sblc-encode I) 'timeout 1/16))))
(define completed (advance (zset-empty) 4 1))
(check 'reuse-with-refinement (= 1 (vector-ref (sblc-update-stats completed) 0)))
(check 'no-restarted-trial (= 0 (vector-ref (sblc-update-stats completed) 1)))
(check 'accepted-prior-event (= 1 (zset-weight events (list (sblc-encode I) 'accepted 1/16))))
(define contradictory (advance (zset-singleton ik 1) 4 1))
(check 'zero-support (eq? 'no-consistent-program (sblc-receipt-status (sblc-search-receipt state))))
(define recovery (advance (zset-singleton ik -1) 4 1))
(check 'recover-without-zero-division (eq? 'consistent (sblc-receipt-status (sblc-search-receipt state))))
(check 'retraction-keeps-trial (equal? (vector-ref (sblc-update-stats recovery) 0) 1))
(check 'retraction-removes-trial (= 1 (vector-ref (sblc-update-stats recovery) 2)))
(check 'retraction-selects-no-work (= 0 (vector-ref (sblc-update-stats recovery) 3)))
(define grown (advance (zset-singleton ii 1) 14 3))
(define choice-bits (sblc-encode (sblc-choice I K)))
(define choice-prior (/ 1 (expt 2 14)))
(check 'independent-cartesian-accepted (= 1 (zset-weight events (list choice-bits 'accepted (/ choice-prior 4)))))
(check 'independent-cartesian-rejected (= 1 (zset-weight events (list choice-bits 'rejected (* 3 (/ choice-prior 4))))))
(define noop (advance (zset-from-weighted (list (list 1 ik) (list -1 ik))) 14 3))
(check 'signed-cancellation-empty-outcome-delta (zset-empty? (sblc-update-delta noop)))
(check 'signed-cancellation-no-trial-start (= 0 (vector-ref (sblc-update-stats noop) 1)))
(check 'signed-cancellation-no-evaluation (= 0 (vector-ref (sblc-update-stats noop) 3)))
(advance (zset-from-weighted (list (list -2 ii) (list 1 partial))) 14 4)
(advance (zset-singleton partial -1) 14 4)
(advance (zset-from-weighted (list (list 1 slow) (list 1 ik))) 14 4)
(advance (zset-from-weighted (list (list -1 slow) (list -1 ik) (list 1 ii))) 14 5)
(define digest-before (sblc-search-checkpoint state))
(check 'negative-final-multiplicity (raises? (lambda () (sblc-search-update state (zset-singleton ii -2) 14 5))))
(check 'catalogue-shrink (raises? (lambda () (sblc-search-update state (zset-empty) 4 5))))
(check 'work-shrink (raises? (lambda () (sblc-search-update state (zset-empty) 14 4))))
(check 'example-budget (raises? (lambda () (sblc-search-update state (zset-singleton ii 64) 14 5))))
(define cyclic (list (list 1 ii))) (set-cdr! cyclic cyclic)
(check 'cyclic-delta (raises? (lambda () (sblc-search-update state (vector 'dbsp-zset-v1 cyclic) 14 5))))
(check 'forged-weight (raises? (lambda () (sblc-search-update state (vector 'dbsp-zset-v1 (list (list 1.0 ii))) 14 5))))
(check 'failures-atomic (equal? digest-before (sblc-search-checkpoint state)))
(define cold (sblc-search-restore (sblc-search-checkpoint state) 7 14 (examples-of bag)))
(define delta (zset-singleton ii 1))
(define from-cold (sblc-search-update cold delta 14 6))
(check 'checkpoint-then-update
       (same (sblc-search-receipt (sblc-update-search from-cold))
             (sblc-condition 7 14 6 (examples-of (zset-add bag delta)))))
(define old-checkpoint (sblc-search-checkpoint cold))
(define child-checkpoint (sblc-search-checkpoint (sblc-update-search from-cold)))
(define child-work (sblc-search-work (sblc-update-search from-cold)))
(define returned (sblc-update-delta from-cold))
(if (pair? (zset-entries returned))
    (string-set! (caadar (zset-entries returned)) 0 #\x))
(set-car! (zset-entries delta) '(1 invalid))
(check 'delta-and-output-detached (equal? old-checkpoint (sblc-search-checkpoint cold)))
(check 'child-also-detached (equal? child-checkpoint (sblc-search-checkpoint (sblc-update-search from-cold))))
(vector-set! (sblc-update-stats from-cold) 3 -100)
(check 'stats-detached (equal? child-work (sblc-search-work (sblc-update-search from-cold))))
(define analytic-start (sblc-search-start 7 0 0 '()))
(define analytic-half (sblc-search-update analytic-start (zset-singleton partial 1) 4 2))
(define half-events (sblc-update-delta analytic-half))
(check 'analytic-half-accepted (= 1 (zset-weight half-events (list (sblc-encode I) 'accepted 1/32))))
(check 'analytic-half-timeout (= 1 (zset-weight half-events (list (sblc-encode I) 'timeout 1/32))))
(define analytic-rejected (sblc-search-update (sblc-update-search analytic-half) (zset-singleton ik 1) 4 2))
(define rejected-events (zset-add half-events (sblc-update-delta analytic-rejected)))
(check 'contradiction-dominates-unfinished (= 1 (zset-weight rejected-events (list (sblc-encode I) 'rejected 1/16))))
(check 'no-false-unfinished-event (= 1 (zset-size rejected-events)))
(define left-order (sblc-search-update analytic-start (zset-from-weighted (list (list 1 ii) (list 1 ik))) 11 3))
(define right-order (sblc-search-update analytic-start (zset-from-weighted (list (list 1 ik) (list 1 ii))) 11 3))
(check 'insertion-order-canonical (equal? (sblc-search-checkpoint (sblc-update-search left-order))
                                       (sblc-search-checkpoint (sblc-update-search right-order))))
(display "SBLC UPDATE checks: ") (display checks) (newline)
(display "SBLC UPDATE RESULT: PASS") (newline)
