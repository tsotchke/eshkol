(require stdlib)
(require core.ad.tensor_circuit_reverse)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (near? a b) (< (abs (- a b)) 1e-9))
(define (test-tensor shape xs) (let ((out (make-tensor shape 0.0)))
  (for-each (lambda (i x) (tensor-set! out i x)) (iota (length xs)) xs) out))
(define rows (zset-from-weighted '((1 (0 0 2)) (1 (0 1 1)) (1 (1 0 1)) (1 (1 1 3)))))
(define w (test-tensor '(2) '(1 2))) (define seed (test-tensor '(1) '(1)))
(define expression '(contract
  (contract (project rows (i k) (2 2) (0 1) 2) w (k))
  (contract (project rows (i k) (2 2) (0 1) 2) w (k)) (i)))
(define initial (make-tensor-circuit-pullback (list (list 'rows 'rows rows) (list 'w '(k) w)) expression seed))
(define current initial)
(define a 2) (define x 1) (define y 2) (define s 1)
(define (test-gradient state) (cadr (assq 'w (vector-ref (tensor-circuit-pullback-output state) 1))))
(let ticks ((tick 0)) (if (< tick 8)
  (let* ((next-a (+ a 1)) (dx 1) (dy -1/4) (ds 1/2)
         (row-delta (zset-from-weighted (list (list -1 (list 0 0 a)) (list 1 (list 0 0 next-a)))))
         (old-gradient (test-gradient current))
         (step (tensor-circuit-pullback-step current
           (list (list 'rows row-delta) (list 'w (tensor-delta '(2) (list (list '(0) dx) (list '(1) dy)))))
           (tensor-delta '(1) (list (list '(0) ds)))))
         (next (vector-ref step 0)))
    (set! a next-a) (set! x (+ x dx)) (set! y (+ y dy)) (set! s (+ s ds))
    (let* ((u (+ (* a x) y)) (v (+ x (* 3 y))) (g (test-gradient next))
           (gx (* 2 s (+ (* a u) v))) (gy (* 2 s (+ u (* 3 v))))
           (delta (cadr (assq 'w (vector-ref step 2))))
           (integrated (tensor-snapshot->tensor (tensor-snapshot-apply (tensor-snapshot old-gradient) delta))))
      (check "streamed table-to-tensor objective" (near? (tensor-ref (vector-ref (tensor-circuit-pullback-output next) 0) 0) (+ (* u u) (* v v))))
      (check "simultaneous rows/parameters/seeds analytic dx" (near? (tensor-ref g 0) gx))
      (check "simultaneous rows/parameters/seeds analytic dy" (near? (tensor-ref g 1) gy))
      (check "reported gradient delta integrates dx" (near? (tensor-ref integrated 0) gx))
      (check "reported gradient delta integrates dy" (near? (tensor-ref integrated 1) gy))
      (let ((fresh (make-tensor-circuit-pullback
        (list (list 'rows 'rows (zset-from-weighted (list (list 1 (list 0 0 a)) (list 1 '(0 1 1)) (list 1 '(1 0 1)) (list 1 '(1 1 3)))))
              (list 'w '(k) (test-tensor '(2) (list x y)))) expression (test-tensor '(1) (list s)))))
        (check "fresh full reverse agrees at each prefix" (and (near? (tensor-ref (test-gradient fresh) 0) gx) (near? (tensor-ref (test-gradient fresh) 1) gy)))))
    (set! current next) (ticks (+ tick 1)))))
(check "old pullback snapshot survives" (and (near? (tensor-ref (test-gradient initial) 0) 30) (near? (tensor-ref (test-gradient initial) 1) 50)))
(tensor-set! w 0 999.0) (tensor-set! seed 0 999.0)
(check "constructor owns caller tensors" (near? (tensor-ref (test-gradient initial) 0) 30))
(define observation (test-gradient initial)) (tensor-set! observation 0 999.0)
(check "cotangent observations own storage" (near? (tensor-ref (test-gradient initial) 0) 30))
(define seed-only (vector-ref (tensor-circuit-pullback-step initial '() (tensor-delta '(1) '(((0) 1)))) 0))
(check "seed-only edit refreshes pullback" (near? (tensor-ref (test-gradient seed-only) 0) 60))
(check "bad seed edit refuses atomically" (raises? (lambda () (tensor-circuit-pullback-step initial '() (tensor-delta '(2) '(((0) 1)))))))
(check "failed tick leaves old state valid" (near? (tensor-ref (test-gradient initial) 0) 30))
(define transposed (make-tensor-circuit-pullback (list (list 'x '(i j) (test-tensor '(2 2) '(1 2 3 4))))
  '(sum (transpose x (j i)) (j)) (test-tensor '(2) '(2 3))))
(define tg (cadr (assq 'x (vector-ref (tensor-circuit-pullback-output transposed) 1))))
(for-each (lambda (i expected) (check "transpose/reduction structural adjoint" (near? (tensor-ref tg i) expected))) '(0 1 2 3) '(2 2 3 3))
(define subtracted (make-tensor-circuit-pullback (list (list 'x '(i) (test-tensor '(2) '(3 4)))) '(- x x) (test-tensor '(2) '(1 2))))
(define zg (cadr (assq 'x (vector-ref (tensor-circuit-pullback-output subtracted) 1))))
(check "shared operand signed fan-in cancels" (and (near? (tensor-ref zg 0) 0) (near? (tensor-ref zg 1) 0)))
(define work (tensor-circuit-pullback-work current))
(check "full reverse work reported honestly" (and (> (vector-ref work 0) 0) (> (vector-ref work 1) 0) (> (vector-ref work 2) 0)))
(check "row inputs are discrete, only tensor inputs have cotangents" (= (length (vector-ref (tensor-circuit-pullback-output initial) 1)) 1))
(define batched (make-tensor-circuit-pullback
  (list (list 'a '(b k) (test-tensor '(2 2) '(1 2 3 4)))
        (list 'b '(b k) (test-tensor '(2 2) '(5 6 7 8))))
  '(contract a b (k)) (test-tensor '(2) '(2 3))))
(for-each (lambda (name expected)
  (let ((g (cadr (assq name (vector-ref (tensor-circuit-pullback-output batched) 1)))))
    (for-each (lambda (i x) (check "shared free batch axis adjoint" (near? (tensor-ref g i) x))) '(0 1 2 3) expected)))
  '(a b) '((10 12 21 24) (2 4 9 12)))
(check "bad seed constructor shape refuses" (raises? (lambda () (make-tensor-circuit-pullback
  (list (list 'x '(i) (test-tensor '(2) '(1 2)))) 'x (test-tensor '(1) '(1))))))
(define fork (vector-ref (tensor-circuit-pullback-step initial '() (tensor-delta '(1) '(((0) -1)))) 0))
(check "zero seed fork has zero pullback" (and (near? (tensor-ref (test-gradient fork) 0) 0) (near? (tensor-ref (test-gradient fork) 1) 0)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
