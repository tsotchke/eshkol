(require stdlib)
(require core.certified_native_solve)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(if (and (procedure? linear-solve) (procedure? tensor-inverse))
    (let* ((matrix (vector (vector 1))) (rhs (vector 1))
           (result (solve-certified-native matrix rhs 0)))
      (check "VM native candidate certifies exact identity solve" (eq? (vector-ref result 1) 'proved))
      (check "VM native result verifies against original source" (verify-certified-native-solve result matrix rhs 0)))
    ;; The current VM gap ledger marks tensor-inverse vm-unimplemented.
    ;; Until that primitive lands, the adapter must fail closed without boxes.
    (let ((result (solve-certified-native (vector (vector 1)) (vector 1) 1/10)))
      (check "VM native solve is explicitly unavailable" (eq? (vector-ref result 1) 'unknown))
      (check "VM refusal exposes no candidate" (not (vector-ref result 2)))
      (check "VM refusal exposes no boxes or certificate" (and (not (vector-ref result 3)) (not (vector-ref result 4))))
      (check "VM refusal records unavailable candidate path" (and (eq? (vector-ref (vector-ref result 5) 0) 'candidate-unavailable) (= (vector-ref (vector-ref result 5) 1) 0) (= (vector-ref (vector-ref result 5) 2) 0)))
      (check "VM verifier refuses unresolved output" (not (verify-certified-native-solve result (vector (vector 1)) (vector 1) 1/10)))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
