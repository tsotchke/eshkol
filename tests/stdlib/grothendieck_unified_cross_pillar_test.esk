;;; Unified Cross-Pillar Grothendieckian Verification Suite (Pillars M0-M15)
;;; Verifies:
;;;   1. M13 Frontier: Weil Abelian 4-Fold extraordinary (2,2) Hodge gap basis
;;;      (certified HR1/HR2 via core.exact_psd, gap dim = 2, Weil classes tagged
;;;       'hypothesis-only vs divisor intersections 'certified-algebraic) +
;;;      bounded integer-relation hypothesis search.
;;;   2. M15 Frontier: Hirota KdV 2-soliton tau-function via native 4th-order AD
;;;      (plus wrong scattering phase rejection), Sofia Kowalevski's exact quartic
;;;      4th integral over Q[i] (plus non-Kowalevski inertia rejection), and
;;;      Painleve II Yablonskii-Vorob'ev rational solutions (alpha=1, alpha=2).
;;;   3. End-to-End Cross-Pillar Interoperability across M0-M15 in one program:
;;;      - M0 Topology + Diagram (verified commuting square + TikZ-cd export)
;;;      - M1 Operator C* Choi-PSD <-> M2 Measure Partial Markov
;;;      - M3 CNF Ordinals + M4 Higher Algebra DGA + M5 Cellular Sheaf
;;;      - M7 DEC + M10 E&M + M12 Lie E8 root count + M14 AlgGroup <-> M15 Hitchin <-> M13 Hodge!

(require stdlib)
(require core.topology)
(require core.diagram)
(require core.operator)
(require core.measure)
(require core.set)
(require core.higher_algebra)
(require core.sheaf.cellular)
(require core.hodge)
(require core.alg_group)
(require core.integrable)

(define checks 0)
(define (expect name cond)
  (set! checks (+ checks 1))
  (if (not cond)
      (begin
        (display "FAIL: ") (display name) (newline)
        (exit 1))))

;; ---------------------------------------------------------------------------
;; 1. M13 Frontier: Weil Abelian 4-Fold Extraordinary Hodge Gap
;; ---------------------------------------------------------------------------
(define wf (make-weil-fourfold-hodge-benchmark))
(define wf-audit (weil-fourfold-verify-gap wf))
(expect "weil4-hodge-decomposition-valid" (vector-ref wf-audit 1))
(expect "weil4-HR1-exact" (eq? (vector-ref wf-audit 2) #t))
(expect "weil4-HR2-certified-psd" (eq? (vector-ref (vector-ref wf-audit 3) 0) 'certified-hr2))

(define wf-report (vector-ref wf-audit 4))
(expect "weil4-status-unaccounted-hodge-gap" (eq? (vector-ref wf-report 1) 'unaccounted-hodge-gap))
(expect "weil4-Hdg2-dim=4" (= (vector-ref wf-report 2) 4))
(expect "weil4-divisor-alg-dim=2" (= (vector-ref wf-report 3) 2))
(expect "weil4-extraordinary-Weil-gap-dim=2" (= (vector-ref wf-report 4) 2))

(expect "weil4-divisor-class-certified-algebraic"
        (eq? (vector-ref (vector-ref wf-audit 5) 0) 'certified-algebraic))
(expect "weil4-weil-re-strictly-hypothesis-only"
        (eq? (vector-ref (vector-ref wf-audit 6) 0) 'hypothesis-only))
(expect "weil4-weil-im-strictly-hypothesis-only"
        (eq? (vector-ref (vector-ref wf-audit 7) 0) 'hypothesis-only))

;; Bounded integer-relation discovery: finds 2*sqrt(2) - sqrt(8) = 0 tagged 'hypothesis-only
(define hyp-rel (hodge-period-relation-hypothesis (vector (sqrt 2.0) (sqrt 8.0) 1.0) 3 1e-12))
(expect "period-relation-strictly-tagged-hypothesis-only"
        (eq? (vector-ref hyp-rel 0) 'hypothesis-only))
(expect "period-relation-residual-tiny" (< (vector-ref hyp-rel 3) 1e-12))

;; ---------------------------------------------------------------------------
;; 2. M15 Frontier: KdV 2-Soliton Hirota, Sofia Kowalevski Top, Painleve II
;; ---------------------------------------------------------------------------
;; KdV 2-soliton exact phase A12 = ((k1-k2)/(k1+k2))^2 for k1=1.0, k2=2.0 -> A12 = 1/9
(define kdv2-ok (hirota-kdv-2soliton-residual 1.0 2.0 (/ 1.0 9.0) 0.4 0.15))
(define kdv2-bad (hirota-kdv-2soliton-residual 1.0 2.0 0.5 0.4 0.15))
(expect "hirota-kdv-2soliton-exact-phase-zero" (< (abs kdv2-ok) 1e-9))
(expect "hirota-kdv-2soliton-wrong-phase-nonzero" (> (abs kdv2-bad) 1.0))

;; Sofia Kowalevski's heavy top: I1 = I2 = 2, I3 = 1, c = 3, arbitrary exact Q state!
(expect "kowalevski-top-conserves-ALL-4-integrals-exact"
        (eq? (kowalevski-top-verify-4-integrals 2 2 1 3 1/2 -3/4 5/3 2/5 -1/3 4/7) #t))
;; Negative control: generic asymmetric top I = (3, 2, 1) does NOT conserve Kowalevski K!
(expect "non-kowalevski-top-violates-4th-integral"
        (eq? (vector-ref (kowalevski-top-verify-4-integrals 3 2 1 3 1/2 -3/4 5/3 2/5 -1/3 4/7) 0)
             'kowalevski-conservation-violation))

;; Painleve II exact rational Yablonskii-Vorob'ev solutions via native 2nd-order AD!
(define p2-a1 (painleve-ii-residual (lambda (x) (/ -1.0 x)) 1.0 1.7))
(define p2-a2 (painleve-ii-residual (lambda (x) (- (/ 1.0 x) (/ (* 3.0 x x) (+ (* x x x) 4.0)))) 2.0 1.3))
(define p2-bad (painleve-ii-residual (lambda (x) (/ -1.0 x)) 2.0 1.7))
(expect "painleve-II-alpha=1-exact-rational" (< (abs p2-a1) 1e-11))
(expect "painleve-II-alpha=2-exact-rational" (< (abs p2-a2) 1e-11))
(expect "painleve-II-wrong-alpha-rejected" (> (abs p2-bad) 0.5))

;; ---------------------------------------------------------------------------
;; 3. Cross-Pillar Grothendieckian Interoperability Checks (M0..M15 Unified!)
;; ---------------------------------------------------------------------------
;; M0 Topology + Diagram: Sierpinski topology & verified commuting naturality square + TikZ-cd
(define S2 (sierpinski-topology))
(expect "cross-M0-sierpinski-T0-not-T1" (and (topo-t0? S2) (not (topo-t1? S2))))
(define diag-sq
  (diagram-square "A" "B" "C" "D"
    "f" (lambda (x) (+ x 1))
    "h" (lambda (x) (* 2 x))
    "g" (lambda (x) (* 2 x))
    "k" (lambda (x) (+ x 2))))
(define diag-res
  (diagram-verify-custom diag-sq
    (lambda (f g) (lambda (x) (f (g x))))
    (lambda (f g) (and (= (f 0) (g 0)) (= (f 3) (g 3)) (= (f -2) (g -2))))))
(expect "cross-M0-diagram-commutes" (diagram-commutes? diag-res))
(expect "cross-M0-diagram-tikz-export" (string? (diagram->tikzcd diag-sq)))

;; M1 Operator C* Choi-PSD + M2 Partial Markov exact classical/quantum coincidence
(define sig2 (make-boolean-sigma-algebra (vector 'up 'down)))
(define P0 (cmat-unit 2 0 0))
(define P1 (cmat-unit 2 1 1))
(define inst-Z (make-sigma-cp-instrument sig2 2 2
                 (vector (kraus-heisenberg-superop 2 (list P0))
                         (kraus-heisenberg-superop 2 (list P1)))))
(define st-half (make-density-state (cmat-scale 1/2 (cmat-identity 2))))
(define q-probs (instrument-outcome-probs inst-Z st-half))
(define c-dist (make-dist (list (cons 'up 1/2) (cons 'down 1/2))))
(expect "cross-M1-M2-born-equals-markov-dist"
        (and (= (vector-ref q-probs 0) (dist-prob c-dist 'up))
             (= (vector-ref q-probs 1) (dist-prob c-dist 'down))))

;; M3 CNF Ordinals: 1 + omega = omega != omega + 1
(expect "cross-M3-ordinal-noncommutativity"
        (and (= (ord-cmp (ord-add ord-one ord-omega) ord-omega) 0)
             (not (= (ord-cmp (ord-add ord-omega ord-one) ord-omega) 0))))

;; M14 Algebraic Groups <-> M15 Hitchin <-> M13 Hodge + Certified Siegel Period
(define bridge2 (hitchin-genus2-cm-bridge))
(expect "cross-M14-M15-M13-genus2-bridge"
        (and (= (vector-ref bridge2 1) 2)
             (eq? (vector-ref (vector-ref bridge2 4) 0) 'certified-siegel-period)
             (eq? (vector-ref bridge2 6) #t)
             (eq? (vector-ref (vector-ref bridge2 7) 0) 'certified-hr2)
             (eq? (vector-ref bridge2 8) #t)
             (= (length (vector-ref bridge2 10)) 4)))

(display "PASS: grothendieck_unified_cross_pillar_test (") (display checks) (display " checks)") (newline)
