(require stdlib)
(require core.ad.algebraic_qp)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define same (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define h (vector (vector 1 0) (vector 0 1)))
(define a (vector (vector 1 1)))
(define empty (vector))
(for-each (lambda (rhs)
  (let* ((b (vector rhs)) (g (vector 1 -1))
         (result (algebraic-qp-solve field h g a b empty empty))
         (solution (algebraic-qp-solution result)) (x (vector-ref solution 0))
         (bars (algebraic-qp-pullback result (vector 1 0))))
    (check "equality solution independent closed form" (and (same (vector-ref x 0) (- (/ rhs 2) 1)) (same (vector-ref x 1) (+ (/ rhs 2) 1))))
    (check "independent equality certificate verifier" (algebraic-qp-verify field h g a b empty empty result))
    (check "equality RHS pullback" (same (vector-ref (vector-ref bars 3) 0) 1/2))
    (check "linear coefficient pullback" (and (same (vector-ref (vector-ref bars 1) 0) -1/2) (same (vector-ref (vector-ref bars 1) 1) 1/2))))) '(-3 -1 0 1 2 5))
(define hh (vector (vector 1)))
(define c (vector (vector -1) (vector 1)))
(define limits (vector 0 2))
(for-each (lambda (t)
  (let* ((g (vector (- t))) (result (algebraic-qp-solve field hh g empty empty c limits))
         (solution (algebraic-qp-solution result)) (x (vector-ref (vector-ref solution 0) 0))
         (expected (max 0 (min 2 t))) (stable (not (or (= t 0) (= t 2)))))
    (check "box solution independent clipping oracle" (same x expected))
    (check "inequality KKT certificate independently verifies" (algebraic-qp-verify field hh g empty empty c limits result))
    (check "active-set boundary classification" (eq? (vector-ref (algebraic-qp-info result) 2) stable))
    (if stable
        (let ((bars (algebraic-qp-pullback result (vector 1))))
          (check "piecewise exact linear-term derivative" (same (vector-ref (vector-ref bars 1) 0) (if (and (> t 0) (< t 2)) -1 0))))
        (check "ambiguous boundary pullback refused" (raises? (lambda () (algebraic-qp-pullback result (vector 1))))))))
  '(-3 -1 0 1/2 1 3/2 2 3 5))
(define corner-c (vector (vector -1 0) (vector 0 -1)))
(define corner (algebraic-qp-solve field h (vector 2 3) empty empty corner-c (vector 0 0)))
(check "two active constraints" (equal? (vector-ref (algebraic-qp-info corner) 1) '(0 1)))
(define corner-bars (algebraic-qp-pullback corner (vector 1 2)))
(check "active bounds pullback signs" (and (same (vector-ref (vector-ref corner-bars 5) 0) -1) (same (vector-ref (vector-ref corner-bars 5) 1) -2)))
(check "active multiplier certificate" (and (same (vector-ref (vector-ref (algebraic-qp-solution corner) 2) 0) 2)
  (same (vector-ref (vector-ref (algebraic-qp-solution corner) 2) 1) 3)))
(define alpha (algebraic-generator field))
(define irrational (algebraic-qp-solve field h (vector 0 0) a (vector alpha) empty empty))
(check "irrational equality solution" (same (vector-ref (vector-ref (algebraic-qp-solution irrational) 0) 0) (algebraic-scale alpha 1/2)))
(define outer (make-algebraic-taylor field 2))
(define nested (algebraic-qp-solve outer h (vector 0 0) a (vector (algebraic-ad-seed outer 2)) empty empty))
(define nx (vector-ref (vector-ref (algebraic-qp-solution nested) 0) 0))
(check "moving constraint branch first derivative" (same (algebraic-ad-derivative nx 1) 1/2))
(check "moving constraint branch second derivative" (same (algebraic-ad-derivative nx 2) 0))
(define observed (algebraic-qp-solution corner))
(vector-set! (vector-ref observed 0) 0 99)
(check "solution observer owns coefficient storage" (same (vector-ref (vector-ref (algebraic-qp-solution corner) 0) 0) 0))
(define forged (vector-copy corner))
(vector-set! forged 2 (vector 1 0))
(check "tampered primal certificate rejected" (not (algebraic-qp-verify field h (vector 2 3) empty empty corner-c (vector 0 0) forged)))
(check "certificate bound to caller problem" (not (algebraic-qp-verify field h (vector -2 3) empty empty corner-c (vector 0 0) corner)))
(define forged-objective (vector-copy corner)) (vector-set! forged-objective 5 99)
(check "tampered objective rejected" (not (algebraic-qp-verify field h (vector 2 3) empty empty corner-c (vector 0 0) forged-objective)))
(check "indefinite Hessian refused" (raises? (lambda () (algebraic-qp-solve field (vector (vector -1)) (vector 0) empty empty empty empty))))
(check "nonsymmetric Hessian refused" (raises? (lambda () (algebraic-qp-solve field (vector (vector 1 1) (vector 0 1)) (vector 0 0) empty empty empty empty))))
(check "search budget never returns partial optimum" (raises? (lambda () (algebraic-qp-solve field hh (vector 2) empty empty c limits 1))))
(check "inconsistent inequalities refuse without claiming infeasibility proof" (raises? (lambda ()
  (algebraic-qp-solve field hh (vector 0) empty empty (vector (vector 1) (vector -1)) (vector 0 -1)))))
(check "dependent equality system refused" (raises? (lambda () (algebraic-qp-solve field hh (vector 0) (vector (vector 1) (vector 2)) (vector 1 2) empty empty))))
(check "floating problem data refused" (raises? (lambda () (algebraic-qp-solve field hh (vector 0.0) empty empty empty empty))))
(check "foreign pullback seed refused" (raises? (lambda () (algebraic-qp-pullback corner (vector 1.0 0)))))
(define (directional x dx context)
  (algebraic-ad-value context (vector x dx)))
(define (jet-vector values directions context)
  (list->vector (map (lambda (i) (directional (vector-ref values i) (vector-ref directions i) context)) (iota (vector-length values)))))
(define (jet-matrix values directions context)
  (list->vector (map (lambda (i) (jet-vector (vector-ref values i) (vector-ref directions i) context)) (iota (vector-length values)))))
(define (pair-vector left right)
  (fold-left + 0 (map (lambda (i) (* (algebraic-rational (vector-ref left i)) (vector-ref right i))) (iota (vector-length left)))))
(define (pair-matrix left right)
  (fold-left + 0 (map (lambda (i) (pair-vector (vector-ref left i) (vector-ref right i))) (iota (vector-length left)))))
(define qh (vector (vector 3 1) (vector 1 2)))
(define dh (vector (vector 1 2) (vector 2 -1)))
(define dg (vector 2 -1))
(for-each (lambda (active?)
  (let* ((g (if active? (vector -8 -9) (vector 0 0)))
         (qa (if active? empty (vector (vector 1 1))))
         (qb (if active? empty (vector 3)))
         (qc (if active? (vector (vector 1 0) (vector 0 1)) empty))
         (qd (if active? (vector 1 2) empty))
         (da (if active? empty (vector (vector 1 -2))))
         (db (if active? empty (vector 1)))
         (dc (if active? (vector (vector 1 2) (vector -1 1)) empty))
         (dd (if active? (vector 2 -1) empty))
         (record (algebraic-qp-solve field qh g qa qb qc qd))
         (bars (algebraic-qp-pullback record (vector 2 -1)))
         (context (make-algebraic-taylor field 1))
         (moving (algebraic-qp-solve context (jet-matrix qh dh context) (jet-vector g dg context)
           (jet-matrix qa da context) (jet-vector qb db context) (jet-matrix qc dc context) (jet-vector qd dd context)))
         (x (vector-ref (algebraic-qp-solution moving) 0))
         (expected (- (* 2 (algebraic-rational (algebraic-ad-derivative (vector-ref x 0) 1)))
                        (algebraic-rational (algebraic-ad-derivative (vector-ref x 1) 1))))
         (paired (+ (pair-matrix (vector-ref bars 0) dh) (pair-vector (vector-ref bars 1) dg)
                    (pair-matrix (vector-ref bars 2) da) (pair-vector (vector-ref bars 3) db)
                    (pair-matrix (vector-ref bars 4) dc) (pair-vector (vector-ref bars 5) dd))))
    (check "all six parameter pullbacks pair with independent forward Taylor solve" (= paired expected))
    (if active? (check "moving two-active-constraint derivative closed form" (= paired -4))))) '(#f #t))
(check "no finite-difference probes" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: algebraic_qp_test") (newline) (display "RESULT: PASS") (newline)
