(require stdlib)
(require core.ad.algebraic_incremental)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define expression '(pow (- (+ (* (param 0) (row 0)) (param 1)) (row 1)) 2))
(define plan (make-algebraic-incremental-plan field 2 2 expression))
(define parameters (vector alpha (algebraic-element field 1/2)))
(define tracked (vector 1 2))
(define rows (zset-from-weighted (list (list 1 tracked) (list 1 (vector 2 -1/2)) (list 1 (vector -1 alpha)))))
(define (oracle data theta)
  (let ((loss (algebraic-element field 0)) (g0 (algebraic-element field 0)) (g1 (algebraic-element field 0)))
    (for-each (lambda (entry)
      (let* ((weight (car entry)) (row (cadr entry))
             (x (if (and (number? (vector-ref row 0)) (exact? (vector-ref row 0)))
                    (algebraic-element field (vector-ref row 0)) (vector-ref row 0)))
             (y (if (and (number? (vector-ref row 1)) (exact? (vector-ref row 1)))
                    (algebraic-element field (vector-ref row 1)) (vector-ref row 1)))
             (r (algebraic-sub (algebraic-add (algebraic-mul (vector-ref theta 0) x) (vector-ref theta 1)) y)))
        (set! loss (algebraic-add loss (algebraic-scale (algebraic-mul r r) weight)))
        (set! g0 (algebraic-add g0 (algebraic-scale (algebraic-mul r x) (* 2 weight))))
        (set! g1 (algebraic-add g1 (algebraic-scale r (* 2 weight)))))) (zset-entries data))
    (vector loss (vector g0 g1))))
(define (same-output? a b)
  (and (algebraic-equal? (vector-ref a 0) (vector-ref b 0))
       (algebraic-equal? (vector-ref (vector-ref a 1) 0) (vector-ref (vector-ref b 1) 0))
       (algebraic-equal? (vector-ref (vector-ref a 1) 1) (vector-ref (vector-ref b 1) 1))))
(define initial (algebraic-incremental-new plan parameters rows))
(define initial-output (oracle rows parameters))
(define state initial)
(check "initial exact loss and gradient" (same-output? (algebraic-incremental-output state) initial-output))
(check "least-squares plan uses six row moments" (= (vector-ref (algebraic-incremental-info state) 3) 6))
(let ticks ((t 0)) (if (< t 48)
  (let* ((next-row (vector (- (modulo t 5) 2) (+ 1 (/ (modulo t 7) 3))))
         (row-delta (zset-from-weighted (list (list -1 tracked) (list 1 next-row))))
         (parameter-delta (vector (/ (- (modulo t 3) 1) 10) (/ (- (modulo t 5) 2) 20)))
         (before (oracle rows parameters)) (result (algebraic-incremental-step state row-delta parameter-delta)))
    (set! rows (zset-add rows row-delta))
    (set! parameters (vector (algebraic-add (vector-ref parameters 0) (algebraic-element field (vector-ref parameter-delta 0)))
                            (algebraic-add (vector-ref parameters 1) (algebraic-element field (vector-ref parameter-delta 1)))))
    (set! state (vector-ref result 0)) (set! tracked next-row)
    (let ((expected (oracle rows parameters)) (change (vector-ref result 1)))
      (check "simultaneous signed-row and live-parameter prefix matches full closed-form oracle"
        (same-output? (algebraic-incremental-output state) expected))
      (check "reported loss and gradient deltas integrate exactly"
        (same-output? (vector
          (algebraic-add (vector-ref before 0) (vector-ref change 0))
          (vector (algebraic-add (vector-ref (vector-ref before 1) 0) (vector-ref (vector-ref change 1) 0))
                  (algebraic-add (vector-ref (vector-ref before 1) 1) (vector-ref (vector-ref change 1) 1)))) expected)))
    (ticks (+ t 1)))))
(check "historical snapshot survives 48 successors" (same-output? (algebraic-incremental-output initial) initial-output))
(define parameter-only (algebraic-incremental-step state (zset-empty) (vector 1/10 -1/20)))
(check "parameter-only changes visit no rows or row monomials"
  (and (= (vector-ref (vector-ref parameter-only 2) 1) 0) (= (vector-ref (vector-ref parameter-only 2) 2) 0)
       (= (vector-ref (vector-ref parameter-only 2) 5) 0)))
(define fork (algebraic-incremental-step initial (zset-empty) (vector 0 0)))
(check "forked snapshot remains independent" (same-output? (algebraic-incremental-output (vector-ref fork 0)) initial-output))
(define cross-plan (make-algebraic-incremental-plan field 1 1 '(* (row 0) (pow (param 0) 2))))
(define cross-state (algebraic-incremental-new cross-plan (vector 2) (zset-singleton (vector 1) 1)))
(define cross (algebraic-incremental-step cross-state
  (zset-from-weighted (list (list -1 (vector 1)) (list 1 (vector 2)))) (vector 1)))
(check "finite row/parameter cross terms are retained"
  (and (= (algebraic-rational (vector-ref (vector-ref cross 1) 0)) 14)
       (= (algebraic-rational (vector-ref (vector-ref (vector-ref cross 1) 1) 0)) 8)))
(define canceled (algebraic-incremental-step cross-state
  (zset-from-weighted (list (list 2 (vector 3)) (list -2 (vector 3)))) (vector 0)))
(check "signed cancellation skips row-moment work" (= (vector-ref (vector-ref canceled 2) 2) 0))
(define negative (algebraic-incremental-new cross-plan (vector 2) (zset-singleton (vector 3) -2)))
(check "negative multiplicities retain signed group semantics"
  (= (algebraic-rational (vector-ref (algebraic-incremental-output negative) 0)) -24))
(define observed (algebraic-incremental-output initial))
(vector-set! (vector-ref (vector-ref observed 1) 0) 2 (vector 999 0))
(check "output observers own gradient coefficients" (same-output? (algebraic-incremental-output initial) initial-output))
(define moving (call-with-algebraic-derivative field
  (lambda (a lift)
    (let* ((outer (algebraic-ad-context a))
           (plan (make-algebraic-incremental-plan outer 1 1 '(pow (- (param 0) (row 0)) 2)))
           (state (algebraic-incremental-new plan (vector a) (zset-singleton (vector 1) 1))))
      (vector-ref (vector-ref (algebraic-incremental-output state) 1) 0))) 2 1))
(check "live gradient retains enclosing derivatives" (= (algebraic-rational moving) 2))
(define zero-state (algebraic-incremental-new (make-algebraic-incremental-plan field 0 0 0) (vector)))
(check "zero polynomial has no retained moments"
  (and (equal? (vector->list (algebraic-incremental-info zero-state)) '(0 0 0 0))
       (algebraic-zero? (vector-ref (algebraic-incremental-output zero-state) 0))))
(define foreign (make-algebraic-field '(-3 0 1) 5 1))
(for-each (lambda (thunk) (check "unsupported plan/input refuses atomically" (raises? thunk)))
  (list
    (lambda () (make-algebraic-incremental-plan field 9 1 1))
    (lambda () (make-algebraic-incremental-plan field 1 1 '(row 1)))
    (lambda () (make-algebraic-incremental-plan field 1 1 '(/ (param 0) 2)))
    (lambda () (make-algebraic-incremental-plan field 1 1 '(pow (param 0) 9)))
    (lambda () (make-algebraic-incremental-plan field 1 1 1.0))
    (lambda () (algebraic-incremental-step state (zset-empty) (vector 1)))
    (lambda () (algebraic-incremental-step state (zset-singleton (vector 1) 1) (vector 0 0)))
    (lambda () (algebraic-incremental-step state (zset-singleton (vector 1.0 2) 1) (vector 0 0)))
    (lambda () (algebraic-incremental-step state
      (vector 'dbsp-zset-v1 (list (list 1.0 (vector 1 2)))) (vector 0 0)))
    (lambda () (algebraic-incremental-step state (zset-empty) (vector (algebraic-generator foreign) 0)))))
(check "failed successors preserve the previous snapshot" (same-output? (algebraic-incremental-output initial) initial-output))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
