(require stdlib)
(require core.certified_nonlinear)
(define checks 0)
(define (check label ok)
  (if (not ok) (begin (display "FAIL: ") (display label) (newline) (exit 1)))
  (set! checks (+ checks 1)))
(define (contains? b x) (and (<= (car b) x) (<= x (cdr b))))
;; J=((2,3),(1,-1)); its exact inverse is ((1/5,3/5),(1/5,-2/5)).
;; x=(s+3t)/5,y=(s-2t)/5 supplies independent roots and both sensitivity columns.
(define model (make-certified-polynomial-system '(x y) '(s t)
  '((- (+ (* 2 x) (* 3 y)) s) (- (- x y) t))))
(define center (vector 2 1))
(define radii (vector 1/10 1/10))
(define params (vector 7 1))
(define inverse (vector (vector 1/5 3/5) (vector 1/5 -2/5)))
(define answer (certify-polynomial-root model center radii params inverse))
(check "affine two-parameter system proved" (eq? (vector-ref answer 1) 'proved))
(check "exact affine inverse contraction zero" (= (vector-ref (vector-ref answer 4) 10) 0))
(check "independent x root" (equal? (vector-ref (vector-ref answer 2) 0) (cons 2 2)))
(check "independent y root" (equal? (vector-ref (vector-ref answer 2) 1) (cons 1 1)))
(check "parameter columns for x" (equal? (vector-ref (vector-ref answer 3) 0)
  (vector (cons 1/5 1/5) (cons 3/5 3/5))))
(check "parameter columns for y" (equal? (vector-ref (vector-ref answer 3) 1)
  (vector (cons 1/5 1/5) (cons -2/5 -2/5))))
(check "source-relative replay" (verify-polynomial-root-certificate answer model center radii params inverse))
(define transposed (certify-polynomial-root model center radii params
  (vector (vector 1/5 1/5) (vector 3/5 -2/5))))
(check "wrong transpose cannot prove by zero point residual alone" (eq? (vector-ref transposed 1) 'unknown))
(check "unknown has no fabricated boxes" (and (not (vector-ref transposed 2)) (not (vector-ref transposed 3))))
;; x=y=1 solves x^2+y=t and x+y^2=t at t=2; dx/dt=dy/dt=1/3.
(define nonlinear (make-certified-polynomial-system '(x y) '(t)
  '((- (+ (* x x) y) t) (- (+ x (* y y)) t))))
(define nonlinear-inverse (vector (vector 2/3 -1/3) (vector -1/3 2/3)))
(define local (certify-polynomial-root nonlinear (vector 1 1) radii (vector 2) nonlinear-inverse))
(check "nonlinear root and implicit sensitivity" (and (eq? (vector-ref local 1) 'proved)
  (equal? (vector-ref (vector-ref local 2) 0) (cons 1 1))
  (equal? (vector-ref (vector-ref local 2) 1) (cons 1 1))
  (contains? (vector-ref (vector-ref (vector-ref local 3) 0) 0) 1/3)
  (contains? (vector-ref (vector-ref (vector-ref local 3) 1) 0) 1/3)))
(check "independent whole-box q" (= (vector-ref (vector-ref local 4) 10) 1/5))
(define boundary (certify-polynomial-root nonlinear (vector 1 1) (vector 1/2 1/2)
  (vector 2) nonlinear-inverse))
(check "strict contraction boundary q=1 refuses" (and (= (vector-ref (vector-ref boundary 4) 10) 1)
  (eq? (vector-ref boundary 1) 'unknown)))
(display "Checks: ") (display checks) (newline) (display "RESULT: PASS") (newline)
