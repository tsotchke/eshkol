(require core.sblc.resource)
(require core.sblc)
(require core.blc)
(define passed 0)
(define (check name ok) (if (not ok) (error "sblc resource assertion" name)) (set! passed (+ passed 1)))
(define (copy-data x)
  (cond ((pair? x) (cons (copy-data (car x)) (copy-data (cdr x))))
        ((vector? x) (list->vector (map copy-data (vector->list x)))) (else x)))
(define (certificate source degree)
  (let ((r (sblc-resource-analyze source degree)))
    (check 'certified (eq? (sblc-resource-status r) 'certified))
    (check 'replay (sblc-resource-verify source (sblc-resource-certificate r)))
    (sblc-resource-certificate r)))
(define (emit source degree label)
  (let ((c (certificate source degree)))
    (display "RESOURCE ") (write (list label (sblc-resource-summary c) (sblc-resource-coefficients c))) (newline)
    c))
(let leaves ((k 0))
  (if (<= k 4)
      (begin (emit (sblc-branching-source k) 24 (list 'branch k 1)) (leaves (+ k 1)))))
(for-each (lambda (mode)
  (for-each (lambda (m)
    (emit (sblc-latent-source mode 1 3 m) 24 (list mode 1 3 m))) '(2 3 8))) '(shared fresh))
(define shared-source (sblc-latent-source 'shared 1 3 2))
(define fresh-source (sblc-latent-source 'fresh 1 3 2))
(define shared (certificate shared-source 24))
(define fresh (certificate fresh-source 24))
(check 'shared-probability (= (car (sblc-resource-summary shared)) 5/9))
(check 'fresh-probability (= (car (sblc-resource-summary fresh)) 4/9))
(check 'shared-total-conditional (= (list-ref (sblc-resource-summary shared) 4) 15))
(check 'fresh-total-conditional (= (list-ref (sblc-resource-summary fresh) 4) 16))
(check 'not-timeout-divergence (eq? (list-ref (sblc-resource-summary shared) 3) 'infinite))
(define critical (certificate (sblc-branching-source 2) 24))
(check 'critical-almost-sure (= (car (sblc-resource-summary critical)) 1))
(check 'critical-infinite (eq? (list-ref (sblc-resource-summary critical) 3) 'infinite))
(for-each (lambda (source)
  (let ((proof (certificate source 24)))
    (for-each (lambda (bound)
      (let* ((dist (sblc-distribution source bound))
             (complete (let sum ((i 0) (out 0))
                         (if (> i bound) out (sum (+ i 1) (+ out (list-ref (sblc-resource-coefficients proof) i)))))))
        (check 'operational-mass (= complete (sblc-dist-normal-mass dist)))
        (check 'timeout-mass (= (+ complete (sblc-dist-timeout dist)) 1))
        (display "OBS ") (write (list (vector-ref proof 2) bound complete (sblc-dist-timeout dist))) (newline)))
      '(3 6 10 13))))
  (list (sblc-branching-source 1) (sblc-branching-source 3) shared-source fresh-source))
(define branch (sblc-branching-source 1))
(define run (sblc-run-coins branch "110000" 10))
(check 'raw-beta (= (sblc-run-beta run) 4))
(check 'raw-coins (= (sblc-run-coins-used run) 6))
(check 'raw-total (= (sblc-run-steps run) 10))
(check 'raw-identity (equal? (sblc-run-term run) '(lam (var 1))))
(define bad (copy-data shared))
(vector-set! bad 6 '(4/9 0 0 infinite 0))
(check 'false-latent-summary (not (sblc-resource-verify shared-source bad)))
(set! bad (copy-data shared))
(set-car! (vector-ref bad 5) 1)
(check 'false-coefficient (not (sblc-resource-verify shared-source bad)))
(set! bad (copy-data shared))
(vector-set! bad 1 "sblc-v1:forged")
(check 'false-source-id (not (sblc-resource-verify shared-source bad)))
(check 'changed-source (not (sblc-resource-verify fresh-source shared)))
(check 'unknown-source (let ((r (sblc-resource-analyze '(lam (var 1)) 24)))
                         (and (eq? (sblc-resource-status r) 'unknown) (not (sblc-resource-certificate r)))))
(display "SOURCE ") (write shared-source) (newline)
(display "CERTIFICATE ") (write shared) (newline)
(display "PASS sblc_resource ") (display passed) (newline)
