(require stdlib)
(require core.algebraic_update)
(require core.ad.algebraic)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define same (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define matrix (vector (vector 2 1) (vector 0 3)))
(define original (algebraic-update-factor field matrix))
(define updated (algebraic-update original (list (vector 1 2)) (list (vector 3 -1))))
;; A' = [[5,0],[6,1]], inverse [[1/5,0],[-6/5,1]].
(define answer (algebraic-update-solve updated (vector 10 7)))
(check "nonsymmetric rank-one solve independently known" (and (same (vector-ref answer 0) 2) (same (vector-ref answer 1) -5)))
(define transposed (algebraic-update-solve-transpose updated (vector 10 7)))
(check "transpose correction uses opposite factors" (and (same (vector-ref transposed 0) -32/5) (same (vector-ref transposed 1) 7)))
(check "small correction avoids a full factorization" (equal? (vector->list (algebraic-update-info updated)) '(correction 1 0 1 1)))
(check "base remains reusable" (same (vector-ref (algebraic-update-solve original (vector 1 0)) 0) 1/2))
(define pb (algebraic-update-pullback updated (vector 10 7)))
(define bars ((vector-ref pb 1) (vector 1 0)))
(check "updated pullback matrix cotangent" (same (vector-ref (vector-ref (vector-ref bars 0) 0) 1) 1))
(check "updated pullback RHS cotangent" (same (vector-ref (vector-ref bars 1) 0) 1/5))
(for-each (lambda (t)
  (let* ((u (list (vector t 1) (vector 0 t))) (v (list (vector 1 0) (vector 1 1)))
         (next (algebraic-update original u v 'correction))
         (fresh (vector (vector (+ 2 t) 1) (vector (+ 1 t) (+ 3 t))))
         (expected (algebraic-solve field fresh (vector 2 -1)))
         (actual (algebraic-update-solve next (vector 2 -1)))
         (fresh-t (algebraic-factor-solve-transpose (algebraic-factor field fresh) (vector 2 -1)))
         (actual-t (algebraic-update-solve-transpose next (vector 2 -1))))
    (check "rank-two rational grid fresh-solve parity" (and (same (vector-ref actual 0) (vector-ref expected 0)) (same (vector-ref actual 1) (vector-ref expected 1))))
    (check "rank-two transposed fresh-solve parity" (and (same (vector-ref actual-t 0) (vector-ref fresh-t 0)) (same (vector-ref actual-t 1) (vector-ref fresh-t 1)))))) '(0 1/4 1/2 1 2 3))
(define spd (algebraic-update-factor field (vector (vector 1 0) (vector 0 1)) #t))
(define pos (algebraic-update-symmetric spd (list (vector 1 2)) (vector 1)))
(check "SPD update solve" (and (same (vector-ref (algebraic-update-solve pos (vector 1 0)) 0) 5/6)
  (same (vector-ref (algebraic-update-solve pos (vector 1 0)) 1) -1/3)))
(define back (algebraic-update-symmetric pos (list (vector 1 2)) (vector -1)))
(check "exact retraction restores solution" (same (vector-ref (algebraic-update-solve back (vector 2 3)) 1) 3))
;; Intermediate I - 2e0e0^T is indefinite; final I + e0e0^T is SPD.
(define rescued (algebraic-update-symmetric spd (list (vector 1 0) (vector 1 0)) (vector -2 3)))
(check "atomic signed batch falls back on final SPD matrix" (and (same (vector-ref (algebraic-update-solve rescued (vector 2 3)) 0) 1)
  (eq? (vector-ref (algebraic-update-info rescued) 0) 'fallback) (= (vector-ref (algebraic-update-info rescued) 2) 1)))
(check "forced correction refuses inadmissible intermediate" (raises? (lambda () (algebraic-update-symmetric spd
  (list (vector 1 0) (vector 1 0)) (vector -2 3) 'correction))))
(check "indefinite final batch refuses" (raises? (lambda () (algebraic-update-symmetric spd (list (vector 1 0)) (vector -2)))))
(check "singular final batch refuses" (raises? (lambda () (algebraic-update-symmetric spd (list (vector 1 0)) (vector -1)))))
(check "historical SPD base survives failed ticks" (same (vector-ref (algebraic-update-solve spd (vector 2 3)) 0) 2))
(define chain spd)
(let loop ((i 0)) (if (< i 10)
  (begin (set! chain (algebraic-update-symmetric chain (list (vector 1 0)) (vector 1)))
    (check "bounded chain streamed closed-form solve" (same (vector-ref (algebraic-update-solve chain (vector 1 0)) 0) (/ 1 (+ i 2))))
    (check "chain depth remains bounded" (<= (vector-ref (algebraic-update-info chain) 4) 8))
    (if (= i 8) (check "depth budget performs one explicit refactor" (eq? (vector-ref (algebraic-update-info chain) 0) 'refactor)))
    (loop (+ i 1)))))
(define irrational (algebraic-generator field))
(define irr (algebraic-update-symmetric spd (list (vector irrational 0)) (vector 1)))
(check "irrational low-rank correction remains exact" (same (vector-ref (algebraic-update-solve irr (vector 1 0)) 0) 1/3))
(define context (make-algebraic-taylor field 2))
(define x (algebraic-ad-seed context 1))
(define nested (algebraic-update-symmetric
  (algebraic-update-factor context (vector (vector 1)) #t) (list (vector x)) (vector 1)))
(define coeff (algebraic-ad-coefficients (vector-ref (algebraic-update-solve nested (vector 1)) 0)))
(check "nested update primal" (same (vector-ref coeff 0) 1/2))
(check "nested update first derivative" (same (vector-ref coeff 1) -1/2))
(check "nested update second Taylor coefficient" (same (vector-ref coeff 2) 1/4))
(define input-column (vector 1 2))
(define owned (algebraic-update original (list input-column) (list (vector 3 -1))))
(vector-set! input-column 0 100) (vector-set! (vector-ref matrix 0) 0 100)
(check "update owns matrices and columns" (same (vector-ref (algebraic-update-solve owned (vector 10 7)) 0) 2))
(vector-set! (vector-ref pb 0) 0 100)
(check "pullback owns retained solution" (same (vector-ref (vector-ref (vector-ref ((vector-ref pb 1) (vector 1 0)) 0) 0) 0) -2/5))
(check "floating update coefficient refused" (raises? (lambda () (algebraic-update original (list (vector 1.0 0)) (list (vector 1 0))))))
(check "invalid update rank/shape refused" (raises? (lambda () (algebraic-update original (list (vector 1)) (list (vector 1))))))
(check "rank above bounded correction limit refused" (raises? (lambda () (algebraic-update original
  (make-list 9 (vector 1 0)) (make-list 9 (vector 0 1))))))
(check "unknown correction policy refused" (raises? (lambda () (algebraic-update original '() '() 'unchecked))))
(define foreign (make-algebraic-field '(-3 0 1) 5 1))
(check "foreign coefficient owner refused" (raises? (lambda () (algebraic-update original
  (list (vector (algebraic-generator foreign) 0)) (list (vector 1 0))))))
(check "singular Woodbury core and final matrix refused" (raises? (lambda () (algebraic-update original
  (list (vector -2 0)) (list (vector 1 0)) 'correction))))
(check "generic update cannot bypass SPD admission" (raises? (lambda () (algebraic-update spd (list (vector 1 0)) (list (vector 1 0))))))
(check "empty update reuses factor" (eq? original (algebraic-update original '() '())))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: algebraic_update_test") (newline) (display "RESULT: PASS") (newline)
