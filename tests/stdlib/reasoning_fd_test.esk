;;; core.reasoning.fd: propagation strength, puzzles with known answers,
;;; solution counts against exhaustive enumeration, optimization against
;;; brute force, and agreement with the SAT direct encoding.
(require stdlib)
(require core.reasoning.fd)

(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))

;; ---- propagation strength
(define m1 (make-fd-model))
(define a (fd-var m1 'a '(1 2)))
(define b (fd-var m1 'b '(1 2)))
(define c (fd-var m1 'c '(1 2 3)))
(fd-all-different! m1 (list a b c))
(check "all-different is domain consistent (Hall set {a,b})" (and (fd-propagate! m1) (equal? (fd-domain c) '(3))))
(define m2 (make-fd-model))
(define p (fd-var m2 'p '(1 2)))
(define q (fd-var m2 'q '(1 2)))
(define r (fd-var m2 'r '(1 2)))
(fd-all-different! m2 (list p q r))
(check "pigeonhole all-different fails at the root" (not (fd-propagate! m2)))
(define m3 (make-fd-model))
(define x (fd-var m3 'x (fd-range 0 10)))
(define y (fd-var m3 'y (fd-range 0 10)))
(fd-linear! m3 (list (cons 3 x) (cons 2 y)) '= 24)
(fd-linear! m3 (list (cons 1 x) (cons -1 y)) '>= 2)
(check "linear bounds propagation" (and (fd-propagate! m3) (= (car (fd-domain x)) 4) (<= (car (reverse (fd-domain y))) 6)))
(check "linear solutions" (equal? (fd-solutions m3) '(((x . 6) (y . 3)) ((x . 8) (y . 0)))))
(define m4 (make-fd-model))
(define u (fd-var m4 'u (fd-range 1 4)))
(define v (fd-var m4 'v (fd-range 1 4)))
(fd-relation! m4 u v (lambda (s t) (= t (* 2 s))))
(check "binary relation arc consistency" (and (fd-propagate! m4) (equal? (fd-domain u) '(1 2)) (equal? (fd-domain v) '(2 4))))
(define m5 (make-fd-model))
(define t1 (fd-var m5 't1 '(1 2 3)))
(define t2 (fd-var m5 't2 '(1 2 3)))
(fd-table! m5 (list t1 t2) '((1 3) (2 3) (3 1)))
(check "table GAC" (and (fd-propagate! m5) (equal? (fd-domain t2) '(1 3))))
(check "domain values must be integers" (raises? (lambda () (fd-var (make-fd-model) 'z '(1.5)))))

;; ---- SEND + MORE = MONEY: unique solution 9567 + 1085 = 10652
(define sm (make-fd-model))
(define letters (map (lambda (s) (fd-var sm s (fd-range 0 9))) '(s e n d m o r y)))
(define (L s) (list-ref letters (let loop ((ls '(s e n d m o r y)) (i 0)) (if (eq? (car ls) s) i (loop (cdr ls) (+ i 1))))))
(fd-all-different! sm letters)
(fd-linear! sm (list (cons 1000 (L 's)) (cons 100 (L 'e)) (cons 10 (L 'n)) (cons 1 (L 'd))
                     (cons 1000 (L 'm)) (cons 100 (L 'o)) (cons 10 (L 'r)) (cons 1 (L 'e))
                     (cons -10000 (L 'm)) (cons -1000 (L 'o)) (cons -100 (L 'n)) (cons -10 (L 'e)) (cons -1 (L 'y)))
            '= 0)
(fd-linear! sm (list (cons 1 (L 's))) '>= 1)
(fd-linear! sm (list (cons 1 (L 'm))) '>= 1)
(define sm-all (fd-solutions sm))
(check "SEND+MORE=MONEY unique" (= (length sm-all) 1))
(check "SEND+MORE=MONEY digits"
       (equal? (map cdr (car sm-all)) '(9 5 6 7 1 0 8 2)))

;; ---- n-queens counts 4..8 (2 10 4 40 92)
(define (queens-model n)
  (let* ((m (make-fd-model))
         (qs (let mk ((i 0)) (if (= i n) '() (cons (fd-var m i (fd-range 1 n)) (mk (+ i 1)))))))
    (let outer ((i 0) (rest qs))
      (if (pair? rest)
          (begin
            (let inner ((j (+ i 1)) (others (cdr rest)))
              (if (pair? others)
                  (begin (fd-ne! m (car rest) (car others) 0)
                         (fd-ne! m (car rest) (car others) (- j i))
                         (fd-ne! m (car rest) (car others) (- i j))
                         (inner (+ j 1) (cdr others)))))
            (outer (+ i 1) (cdr rest)))))
    m))
(check "queens counts 4..8" (equal? (map (lambda (n) (fd-count (queens-model n))) '(4 5 6 7 8)) '(2 10 4 40 92)))
(check "dom/deg and input orders agree"
       (and (= (length (fd-solutions (queens-model 6))) 4)
            (let ((m (queens-model 8))) (fd-solve m '((var-order . input))))
            (let ((m (queens-model 8))) (fd-solve m '((var-order . dom-deg) (value-order . max))))))

;; ---- Sudoku (a puzzle with a unique solution)
(define puzzle
  '((5 3 0 0 7 0 0 0 0) (6 0 0 1 9 5 0 0 0) (0 9 8 0 0 0 0 6 0)
    (8 0 0 0 6 0 0 0 3) (4 0 0 8 0 3 0 0 1) (7 0 0 0 2 0 0 0 6)
    (0 6 0 0 0 0 2 8 0) (0 0 0 4 1 9 0 0 5) (0 0 0 0 8 0 0 7 9)))
(define sudoku (make-fd-model))
(define cells
  (let rows ((r 0) (ps puzzle))
    (if (null? ps) '()
        (cons (let cols ((c 0) (xs (car ps)))
                (if (null? xs) '()
                    (cons (fd-var sudoku (+ (* 9 r) c) (if (= (car xs) 0) (fd-range 1 9) (list (car xs))))
                          (cols (+ c 1) (cdr xs)))))
              (rows (+ r 1) (cdr ps))))))
(define (cell r c) (list-ref (list-ref cells r) c))
(define (iota9) (fd-range 0 8))
(for-each (lambda (r) (fd-all-different! sudoku (map (lambda (c) (cell r c)) (iota9)))) (iota9))
(for-each (lambda (c) (fd-all-different! sudoku (map (lambda (r) (cell r c)) (iota9)))) (iota9))
(for-each (lambda (b)
            (let ((r0 (* 3 (quotient b 3))) (c0 (* 3 (modulo b 3))))
              (fd-all-different! sudoku (apply append (map (lambda (dr) (map (lambda (dc) (cell (+ r0 dr) (+ c0 dc))) '(0 1 2))) '(0 1 2))))))
          (iota9))
(define sudoku-solutions (fd-solutions sudoku 2))
(check "sudoku unique" (= (length sudoku-solutions) 1))
(check "sudoku first row" (equal? (map cdr (let take ((xs (car sudoku-solutions)) (k 9)) (if (= k 0) '() (cons (car xs) (take (cdr xs) (- k 1)))))) '(5 3 4 6 7 8 9 1 2)))
(check "sudoku solved by propagation alone" (< (cdr (assq 'nodes (fd-stats sudoku))) 200))

;; ---- 3x3 magic squares: 8 solutions
(define magic (make-fd-model))
(define ms (map (lambda (i) (fd-var magic i (fd-range 1 9))) (fd-range 0 8)))
(define (M i) (list-ref ms i))
(fd-all-different! magic ms)
(for-each (lambda (line) (fd-sum! magic (map M line) '= 15))
          '((0 1 2) (3 4 5) (6 7 8) (0 3 6) (1 4 7) (2 5 8) (0 4 8) (2 4 6)))
(check "magic squares of order 3" (= (fd-count magic) 8))

;; ---- random small CSPs: counts equal exhaustive enumeration
(define seed 12345)
(define (rand! k) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) k))
(define (enumerate vars doms check)
  (let loop ((ds doms) (acc '()))
    (if (null? ds) (if (check (reverse acc)) 1 0)
        (fold-left + 0 (map (lambda (x) (loop (cdr ds) (cons x acc))) (car ds))))))
(define agree #t)
(let trial ((t 0))
  (if (< t 25)
      (let* ((m (make-fd-model))
             (doms (list (fd-range 0 (+ 2 (rand! 3))) (fd-range 0 (+ 2 (rand! 3)))
                         (fd-range 0 (+ 2 (rand! 3))) (fd-range 0 (+ 2 (rand! 3)))))
             (vs (map (lambda (d i) (fd-var m i d)) doms '(0 1 2 3)))
             (c1 (list (+ 1 (rand! 3)) (- (rand! 5) 2) (+ 1 (rand! 2))))
             (k1 (rand! 8)) (i (rand! 4)) (j (modulo (+ i 1 (rand! 3)) 4)) (off (- (rand! 3) 1)))
        (fd-linear! m (list (cons (car c1) (list-ref vs 0)) (cons (if (= (cadr c1) 0) 1 (cadr c1)) (list-ref vs 1))
                            (cons (caddr c1) (list-ref vs 2))) '<= k1)
        (fd-ne! m (list-ref vs i) (list-ref vs j) off)
        (fd-relation! m (list-ref vs 3) (list-ref vs 0) (lambda (s t) (not (= (modulo (+ s t) 3) 1))))
        (if (= (rand! 2) 0) (fd-all-different! m (list (list-ref vs 1) (list-ref vs 2) (list-ref vs 3))))
        (let* ((brute (enumerate vs doms
                        (lambda (vals)
                          (let all ((cs (vector-ref m 2)))
                            (or (null? cs)
                                (and ((vector-ref (car cs) 3)
                                      (map (lambda (v) (list-ref vals (vector-ref v 1))) (vector->list (vector-ref (car cs) 1))))
                                     (all (cdr cs))))))))
               (count (fd-count m))
               (sat (fd-solve-sat m)))
          (if (not (and (= brute count) (if (= count 0) (not sat) (and sat (member sat (fd-solutions m))))))
              (set! agree #f)))
        (trial (+ t 1)))))
(check "25 random CSPs: search, exhaustive enumeration and SAT encoding agree" agree)

;; ---- optimization: a small knapsack against brute force
(define km (make-fd-model))
(define take (map (lambda (i) (fd-var km i '(0 1))) '(0 1 2 3 4 5)))
(define weights '(12 7 11 8 9 6))
(define values '(24 13 23 15 16 11))
(define cost (fd-var km 'cost (fd-range -200 0)))
(fd-linear! km (map cons weights take) '<= 26)
(fd-linear! km (cons (cons 1 cost) (map (lambda (val t) (cons val t)) values take)) '= 0)
(define best (fd-minimize km cost))
(define brute-best
  (let loop ((mask 0) (best 0))
    (if (= mask 64) best
        (let* ((bits (map (lambda (i) (modulo (quotient mask (expt 2 i)) 2)) '(0 1 2 3 4 5)))
               (w (fold-left + 0 (map * bits weights))) (val (fold-left + 0 (map * bits values))))
          (loop (+ mask 1) (if (and (<= w 26) (> val best)) val best))))))
(check "branch and bound knapsack equals brute force" (and best (= (- (car best)) brute-best)))

;; ---- SAT direct encoding on the puzzles
(check "1-queen via the SAT encoding" (equal? (map cdr (fd-solve-sat (queens-model 1))) '(1)))
(check "6-queens via the SAT encoding is a solution"
       (let* ((m (queens-model 6)) (s (fd-solve-sat m))) (and s (member s (fd-solutions m)))))
(check "unsatisfiable model via SAT" (not (fd-solve-sat (queens-model 3))))

(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: reasoning_fd_test") (newline)
(display "RESULT: PASS") (newline)
