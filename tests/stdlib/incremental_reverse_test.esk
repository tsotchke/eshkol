(require stdlib)
(require core.ad.incremental_reverse)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define domain (algebraic-domain field))
(define copy (algebraic-domain-ref domain 'copy))
(define add (algebraic-domain-ref domain 'add))
(define sub (algebraic-domain-ref domain 'sub))
(define mul (algebraic-domain-ref domain 'mul))
(define inv (algebraic-domain-ref domain 'inverse))
(define same? (algebraic-domain-ref domain 'equal?))
(define (same-vector? a b)
  (and (= (vector-length a) (vector-length b))
    (let loop ((i 0)) (or (= i (vector-length a))
      (and (same? (vector-ref a i) (vector-ref b i)) (loop (+ i 1)))))))
(define declarations '((* square x x) (* mixed square y) (+ total mixed z) (inverse reciprocal total)))
(define (fresh point seeds)
  (algebraic-value-and-pullback field (lambda (tape inputs)
    (let* ((x (vector-ref inputs 0)) (y (vector-ref inputs 1)) (z (vector-ref inputs 2))
           (square (algebraic-reverse-mul tape x x))
           (total (algebraic-reverse-add tape (algebraic-reverse-mul tape square y) z))
           (reciprocal (algebraic-reverse-inverse tape total)))
      (algebraic-reverse-add tape
        (algebraic-reverse-add tape
          (algebraic-reverse-mul tape total (algebraic-reverse-constant tape (vector-ref seeds 0)))
          (algebraic-reverse-mul tape reciprocal (algebraic-reverse-constant tape (vector-ref seeds 1))))
        (algebraic-reverse-mul tape square (algebraic-reverse-constant tape (vector-ref seeds 2)))))) point))
(define point (vector 2 3 4))
(define seeds (vector 1 2 3))
(define initial (make-incremental-pullback field '(x y z) declarations '(total reciprocal square) point seeds))
(define old-view (incremental-pullback-output initial))
(check "initial outputs independently known" (same-vector? (vector-ref old-view 0) (vector 16 1/16 4)))
(check "fresh existing reverse recorder agrees" (same-vector? (vector-ref old-view 1) ((vector-ref (fresh point seeds) 1) 1)))
(check "independent closed-form initial gradient" (same-vector? (vector-ref old-view 1)
  (vector (+ (* 12 (- 1 1/128)) 12) (* 4 (- 1 1/128)) (- 1 1/128))))
(define current initial)
(let ticks ((i 0)) (if (< i 24)
  (let* ((input-index (modulo i 3)) (seed-index (modulo (+ i 1) 3))
         (dx (if (= i 7) (algebraic-generator field) 1/16)) (ds (if (even? i) 1/8 -1/8))
         (before (incremental-pullback-output current))
         (step (incremental-pullback-step current (list (list input-index dx)) (list (list seed-index ds))))
         (next (vector-ref step 0)))
    (vector-set! point input-index (add (vector-ref point input-index) dx))
    (vector-set! seeds seed-index (add (vector-ref seeds seed-index) ds))
    (let* ((actual (incremental-pullback-output next)) (full (fresh point seeds))
           (x (vector-ref point 0)) (y (vector-ref point 1)) (z (vector-ref point 2))
           (square (mul x x)) (total (add (mul square y) z))
           (factor (sub (vector-ref seeds 0) (mul (vector-ref seeds 1) (mul (inv total) (inv total))))))
      (check "every prefix agrees with fresh exact reverse" (same-vector? (vector-ref actual 1) ((vector-ref full 1) 1)))
      (check "every prefix agrees with independent analytic gradient" (same-vector? (vector-ref actual 1)
        (vector (add (mul (mul 2 (mul x y)) factor) (mul (mul 2 x) (vector-ref seeds 2)))
                (mul square factor) factor)))
      (check "output delta integrates" (same-vector? (vector-ref actual 0)
        (list->vector (map add (vector->list (vector-ref before 0)) (vector->list (vector-ref step 1))))))
      (check "cotangent delta integrates" (same-vector? (vector-ref actual 1)
        (list->vector (map add (vector->list (vector-ref before 1)) (vector->list (vector-ref step 2)))))))
    (set! current next) (ticks (+ i 1)))))
(check "historical state survives all ticks" (same-vector? (vector-ref (incremental-pullback-output initial) 0) (vector 16 1/16 4)))
(define fork (vector-ref (incremental-pullback-step initial '((0 1)) '((0 1))) 0))
(check "fork has its own values" (same-vector? (vector-ref (incremental-pullback-output fork) 0) (vector 31 1/31 9)))
(define cancel (incremental-pullback-step current '((0 1) (0 -1)) '((0 1) (0 -1))))
(check "consolidated cancellation executes no operations" (and (= (vector-ref (vector-ref cancel 3) 0) 0)
  (= (vector-ref (vector-ref cancel 3) 1) 0)))
(define seed-only (incremental-pullback-step initial '() '((0 2))))
(check "seed-only change executes no forward operations" (= (vector-ref (vector-ref seed-only 3) 0) 0))
(check "seed-only update changes gradient" (same-vector? (vector-ref (incremental-pullback-output (vector-ref seed-only 0)) 1)
  ((vector-ref (fresh (vector 2 3 4) (vector 3 2 3)) 1) 1)))
;; Primal cancellation does not imply that the local partials are unchanged.
(define product (make-incremental-pullback field '(x y) '((* p x y)) '(p) (vector 2 3) (vector 1)))
(define swapped (vector-ref (incremental-pullback-step product '((0 1) (1 -1)) '()) 0))
(check "unchanged product still refreshes partials" (same-vector? (vector-ref (incremental-pullback-output swapped) 1) (vector 2 3)))
(define bad-point (make-incremental-pullback field '(x) '((inverse r x)) '(r) (vector 1) (vector 1)))
(check "nonunit update refuses atomically" (raises? (lambda () (incremental-pullback-step bad-point '((0 -1)) '()))))
(check "failed update preserves old gradient" (same-vector? (vector-ref (incremental-pullback-output bad-point) 1) (vector -1)))
(for-each (lambda (changes)
  (check "malformed sparse change refuses" (raises? (lambda () (incremental-pullback-step initial changes '())))))
  (list '((3 1)) '((0.0 1)) '((0 1.0)) '((0 1 2)) (cons '(0 1) 2)))
(check "foreign field delta refuses" (raises? (lambda ()
  (incremental-pullback-step initial (list (list 0 (algebraic-generator (make-algebraic-field '(-3 0 1) 5 1)))) '()))))
(check "forward reference refuses" (raises? (lambda ()
  (make-incremental-pullback field '(x) '((+ y x missing)) '(y) (vector 1) (vector 1)))))
(check "duplicate node name refuses" (raises? (lambda ()
  (make-incremental-pullback field '(x) '((* x x x)) '(x) (vector 1) (vector 1)))))
(define observed (incremental-pullback-output initial))
(vector-set! (vector-ref observed 0) 0 999)
(vector-set! (vector-ref (vector-ref observed 1) 0) 2 (vector 999 0))
(check "public values and cotangents own their storage" (same-vector? (vector-ref (incremental-pullback-output initial) 0) (vector 16 1/16 4)))
(check "cotangent observations own coefficient storage" (same-vector?
  (vector-ref (incremental-pullback-output initial) 1)
  ((vector-ref (fresh (vector 2 3 4) (vector 1 2 3)) 1) 1)))
(define context (make-algebraic-taylor field 2))
(define variable (algebraic-ad-seed context (algebraic-generator field)))
(define nested (make-incremental-pullback context '(x) '((* square x x) (* cube square x)) '(cube) (vector variable) (vector 1)))
(define nested-next (vector-ref (incremental-pullback-step nested '((0 1)) '((0 1))) 0))
(define nested-gradient (vector-ref (vector-ref (incremental-pullback-output nested-next) 1) 0))
(check "enclosing Taylor derivatives survive moving pullback" (= (algebraic-rational (algebraic-ad-derivative nested-gradient 2)) 12))
(define (family n)
  (let ((decls '((constant one 1) (* hot x x))) (previous 'cold))
    (let loop ((i 0)) (if (< i n)
      (let ((name (string->symbol (string-append "cold-" (number->string i)))))
        (set! decls (append decls (list (list '+ name previous 'one))))
        (set! previous name) (loop (+ i 1)))))
    (make-incremental-pullback field '(x cold) decls (list 'hot previous) (vector 2 1) (vector 1 1))))
(define small (incremental-pullback-step (family 16) '((0 1)) '()))
(define large (incremental-pullback-step (family 128) '((0 1)) '()))
(check "cold graph size does not increase refreshed arithmetic" (and
  (= (vector-ref (vector-ref small 3) 0) 1) (= (vector-ref (vector-ref large 3) 0) 1)
  (= (vector-ref (vector-ref small 3) 1) 1) (= (vector-ref (vector-ref large 3) 1) 1)))
(check "cold graph size does not increase sparse container or scan work" (and
  (= (vector-ref (vector-ref large 3) 3) (vector-ref (vector-ref small 3) 3))
  (= (vector-ref (vector-ref large 3) 4) (vector-ref (vector-ref small 3) 4))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
