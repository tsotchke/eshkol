;;; core.topos: Kripke-Joyal forcing against the Omega-valued interpretation on
;;; an exhaustively enumerated formula corpus, on the presheaf toposes of the
;;; walking arrow, the pseudocircle and BZ/2. The sheaf toposes are in
;;; topos_corpus_sheaf_test.esk, the Kripke and Beth reductions in
;;; topos_reductions_test.esk and the j-translation in topos_jtranslation_test.esk.
(require stdlib)
(require core.sheaf.site)
(require core.sheaf.presheaf)
(require core.topos)

(define passed 0)
(define failed 0)
(define (check label ok)
  (if ok
      (begin (set! passed (+ passed 1)) (display "PASS: "))
      (begin (set! failed (+ failed 1)) (display "FAIL: ")))
  (display label) (newline))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (any? pred (cdr xs)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (subsets-of xs) (if (null? xs) (list '()) (let ((r (subsets-of (cdr xs)))) (append r (map (lambda (s) (cons (car xs) s)) r)))))

;; ---------------------------------------------------------------------------
;; The corpus: every formula of size <= k built from the atoms by the unary and
;; binary connectives (size = number of nodes)
;; ---------------------------------------------------------------------------
(define (enum-formulas atoms unary binary k)
  (let ((by-size (make-vector (+ k 1) '())))
    (vector-set! by-size 1 atoms)
    (let loop ((s 2))
      (if (<= s k)
          (begin
            (vector-set! by-size s
                         (append
                          (apply append (map (lambda (u) (map (lambda (p) (u p)) (vector-ref by-size (- s 1)))) unary))
                          (apply append
                                 (map (lambda (i)
                                        (apply append
                                               (map (lambda (b) (apply append (map (lambda (p) (map (lambda (q) (b p q)) (vector-ref by-size (- s 1 i))))
                                                                                   (vector-ref by-size i))))
                                                    binary)))
                                      (range (- s 1))))))
            (loop (+ s 1)))))
    (apply append (map (lambda (s) (vector-ref by-size s)) (cdr (range (+ k 1)))))))
(define binary (list (lambda (p q) (list 'and p q)) (lambda (p q) (list 'or p q)) (lambda (p q) (list 'implies p q))))
(define (quantifiers specs)            ;; specs: list of (var type)
  (apply append (map (lambda (b) (list (lambda (p) (list 'forall b p)) (lambda (p) (list 'exists b p)))) specs)))
(define fo-atoms '((P x) (Q x) (P y) (= x y) false))
(define fo-unary (cons (lambda (p) (list 'not p)) (quantifiers '((x X) (y X)))))
(define fo-corpus (enum-formulas fo-atoms fo-unary binary 4))
(define ho-atoms '((in x A) (holds p) (P x) false))
(define ho-unary (cons (lambda (p) (list 'not p)) (quantifiers '((x X) (A (P X)) (p Omega)))))
(define ho-corpus (enum-formulas ho-atoms ho-unary binary 3))
(define ho-corpus-2 (enum-formulas ho-atoms ho-unary binary 2))
(show "first-order corpus (atoms P x, Q x, P y, x = y, false; size <= 4)" (length fo-corpus))
(show "higher-order corpus (atoms x in A, holds p, P x, false; quantifiers over X, P(X), Omega; size <= 3, and size <= 2 where P(X) has 40 or more elements at a stage)" (list (length ho-corpus) (length ho-corpus-2)))

;; ---------------------------------------------------------------------------
;; Sites
;; ---------------------------------------------------------------------------
;; A Kripke-style carrier on a poset site: domains D(w) of names, restriction
;; along v <= w the inclusion D(w) in D(v).
(define (inclusion-presheaf C domains)
  (make-set-presheaf C domains (lambda (a x) x)))
(define (language-of T X Pset Qset)
  (make-topos-language T (list (cons 'X X))
                       (list (topos-predicate 'P '(X) (lambda (U x) (member x (Pset U))))
                             (topos-predicate 'Q '(X) (lambda (U x) (member x (Qset U)))))))

;; walking arrow 0 -> 1 (presheaf topos; Kripke frame with root 1 and one later world 0)
(define WA (poset-category 2 (lambda (x y) (<= x y))))
(define WA-dom (vector '(u v r) '(u v)))
(define WA-P (vector '(u v) '(u)))
(define WA-Q (vector '(r) '()))
(define T-WA (presheaf-topos WA))
(define X-WA (topos-object T-WA (inclusion-presheaf WA (vector->list WA-dom))))
(define L-WA (language-of T-WA X-WA (lambda (U) (vector-ref WA-P U)) (lambda (U) (vector-ref WA-Q U))))

;; the pseudocircle: points 0, 1 below 2, 3 (presheaf topos; a Kripke frame with two roots)
(define S4 (poset-category 4 (lambda (x y) (or (= x y) (and (< x 2) (>= y 2))))))
(define S4-dom (vector '(a b c) '(a b) '(a) '(b)))
(define S4-P (vector '(a b) '(a) '(a) '()))
(define S4-Q (vector '(c) '() '() '()))
(define T-S4 (presheaf-topos S4))
(define X-S4 (topos-object T-S4 (inclusion-presheaf S4 (vector->list S4-dom))))
(define L-S4 (language-of T-S4 X-S4 (lambda (U) (vector-ref S4-P U)) (lambda (U) (vector-ref S4-Q U))))

;; BZ/2 (presheaves on a group: a Boolean topos). X = the regular orbit {e, s} plus a fixed point o.
(define (z2-nf w) (if (even? (length w)) '() (list 0)))
(define BZ2 (make-category-from-presentation 1 (list (list 0 0 's)) z2-nf 2))
(define T-BZ2 (presheaf-topos BZ2))
(define X-BZ2 (topos-object T-BZ2 (make-set-presheaf BZ2 (list '(e s o))
                                                     (lambda (a x) (if (= a (category-identity BZ2 0)) x (cdr (assq x '((e . s) (s . e) (o . o)))))))))
(define L-BZ2 (language-of T-BZ2 X-BZ2 (lambda (U) '(o)) (lambda (U) '(e s))))

;; sheaves on a finite space with the open-cover topology: the pseudocircle
;; space, X = the sheaf of locally constant {0, 1}-valued functions
(define space (make-finite-space 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define site-X (finite-space-site space))
(define CX (site-category site-X))
(define T-ShX (make-topos site-X))
(define top-X (category-object-of-label CX '(0 1 2 3)))
(define X-ShX (topos-object T-ShX (sheafify site-X (constant-set-presheaf CX '(0 1)))))
(define (restriction-of-global T X top i U)
  (topos-type-restrict X (car (category-hom (topos-category T) U top)) (topos-type-element X top i)))
(define L-ShX (language-of T-ShX X-ShX
                           (lambda (U) (list (restriction-of-global T-ShX X-ShX top-X 0 U)))
                           (lambda (U) (list (restriction-of-global T-ShX X-ShX top-X 1 U)))))

;; a finite tree with the bar topology: root 0, children 1 and 2 of 0, child 3
;; of 1, so two maximal paths 0-1-3 and 0-2; there is an arrow x -> y when y is
;; an ancestor of x (x is later)
(define parent (vector #f 0 0 1))
(define (ancestor? y x) (or (= x y) (and (vector-ref parent x) (ancestor? y (vector-ref parent x)))))
(define TR (poset-category 4 (lambda (x y) (ancestor? y x))))
(define leaves '(2 3))
;; every maximal path from w meets B
(define (path-bar? w B) (all? (lambda (l) (or (not (ancestor? w l)) (any? (lambda (b) (and (ancestor? w b) (ancestor? b l))) B))) leaves))
(define site-TR (make-site TR (lambda (c S) (path-bar? c (sieve-domains TR S)))))
(define T-TR (make-topos site-TR))
(define X-TR (topos-object T-TR (sheafify site-TR (constant-set-presheaf TR '(0 1)))))
(define L-TR (language-of T-TR X-TR
                          (lambda (U) (list (restriction-of-global T-TR X-TR 0 0 U)))
                          (lambda (U) (list (restriction-of-global T-TR X-TR 0 1 U)))))

(check "the bar sieves of the tree form a Grothendieck topology, the open covers of the space do, and every carrier is a sheaf"
       (and (grothendieck-topology? site-TR) (grothendieck-topology? site-X)
            (presheaf-sheaf? site-TR (topos-type-presheaf X-TR)) (presheaf-sheaf? site-X (topos-type-presheaf X-ShX))))

;; ---------------------------------------------------------------------------
;; 1. Forcing against the Omega-valued interpretation
;; ---------------------------------------------------------------------------
;; Each formula is compiled and checked inside its own region; only counts
;; leave it. Every type a formula can mention is created before (types are
;; owned by the topos).
(define (prepare-types! L)
  (let ((T (topos-language-topos L)))
    (for-each (lambda (e) (topos-language-type L e)) '((P X) Omega 1))))
(define (cross-check-corpus L ctx corpus)
  ;; (formulas instances disagreements monotone-failures local-failures)
  (prepare-types! L)
  (let loop ((fs corpus) (n 0) (inst 0) (bad 0) (mono 0) (loc 0))
    (if (null? fs) (list n inst bad mono loc)
        (let ((r (with-region
                  (let ((r (topos-forcing-report (topos-formula L ctx (car fs)))))
                    (list (car r) (if (cadr r) 0 1) (if (caddr r) 0 1) (if (cadddr r) 0 1))))))
          (if (= 1 (cadr r)) (begin (display "  disagreement: ") (display (car fs)) (newline)))
          (loop (cdr fs) (+ n 1) (+ inst (car r)) (+ bad (cadr r)) (+ mono (caddr r)) (+ loc (cadddr r)))))))
(define fo-ctx '((x X) (y X)))
(define ho-ctx '((x X) (A (P X)) (p Omega)))
;; (name language higher-order-corpus): the tree is the Beth frame, checked on
;; the first-order corpus; P(X) at the top stage has 40 elements on the
;; pseudocircle and 49 on the space, where the higher-order bound is 2
(define sites (list (list "walking arrow" L-WA ho-corpus) (list "pseudocircle" L-S4 ho-corpus-2) (list "BZ/2" L-BZ2 ho-corpus)))
(define total-formulas 0)
(define total-instances 0)
(for-each
 (lambda (s)
   (let ((fo (cross-check-corpus (cadr s) fo-ctx fo-corpus))
         (ho (cross-check-corpus (cadr s) ho-ctx (caddr s))))
     (show (string-append (car s) ": first-order (formulas instances disagreements non-monotone non-local)") fo)
     (show (string-append (car s) ": higher-order (formulas instances disagreements non-monotone non-local)") ho)
     (set! total-formulas (+ total-formulas (car fo) (car ho)))
     (set! total-instances (+ total-instances (cadr fo) (cadr ho)))
     (check (string-append (car s) ": U ||- phi(alpha) iff [[phi]]_U(alpha) is the maximal sieve, on every formula, stage and generalized element; every truth value is a closed sieve; forcing is monotone and local")
            (and (equal? (cddr fo) '(0 0 0)) (equal? (cddr ho) '(0 0 0))))))
 sites)
(show "corpus total (formula instances over sites, stage-environment pairs)" (list total-formulas total-instances))

(if (= failed 0)
    (begin (display "PASS: topos_corpus_test (") (display passed) (display " checks)") (newline))
    (begin (display "FAIL: topos_corpus_test (") (display failed) (display " failed)") (newline)))
