(require math)

(define m (vector 4 3 6 3))
(define rhs (vector 10 12))
(define (matrix-refused? thunk)
  (guard (e (else #t)) (thunk) #f))
(define (dimension-contract)
  (and (= (det m) -6)
       (= (det (reshape (tensor 4.0 3.0 6.0 3.0) 2 2)) -6)
       (matrix-refused? (lambda () (det (reshape (tensor 4.0 3.0 6.0 3.0) 1 4))))
       (= (det m 2) (det m))
       (equal? (inv m) (vector -1/2 1/2 1 -2/3))
       (equal? (inv m 2) (inv m))
       (equal? (solve m rhs) (vector 1 2))
       (equal? (solve m rhs 2) (solve m rhs))
       (matrix-refused? (lambda () (det (vector 1 2 3))))
       (matrix-refused? (lambda () (solve m (vector 1))))))
(if (dimension-contract)
    (display "PASS: matrix dimensions")
    (begin (display "FAIL: matrix dimensions") (newline) (exit 1)))
(newline)
