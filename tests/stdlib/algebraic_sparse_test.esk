(require stdlib)
(require core.ad.algebraic_sparse)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define (pattern n)
  (let loop ((i 0) (out '()))
    (if (= i n) (reverse out)
      (loop (+ i 1) (if (< (+ i 1) n) (cons (list i (+ i 1)) (cons (list i i) out)) (cons (list i i) out))))))
(define (point n)
  (let ((out (make-vector n #f)))
    (let loop ((i 0)) (if (< i n)
      (begin (vector-set! out i (algebraic-add alpha (algebraic-element field (modulo i 3)))) (loop (+ i 1))))) out))
(define (objective xs)
  (let* ((ctx (algebraic-ad-context (vector-ref xs 0))) (ops (algebraic-domain ctx))
         (add (algebraic-domain-ref ops 'add)) (mul (algebraic-domain-ref ops 'mul)) (n (vector-length xs)))
    (let loop ((i 0) (sum (algebraic-ad-constant ctx 0)))
      (if (= i n) sum
        (let* ((x (vector-ref xs i)) (square (mul x x)) (fourth (mul square square))
               (edge (if (< (+ i 1) n) (mul x (mul (vector-ref xs (+ i 1)) (vector-ref xs (+ i 1))))
                         (algebraic-ad-constant ctx 0))))
          (loop (+ i 1) (add sum (add fourth edge))))))))
(define (analytic xs i j)
  (cond ((= i j) (algebraic-add (algebraic-scale (algebraic-mul (vector-ref xs i) (vector-ref xs i)) 12)
            (if (> i 0) (algebraic-scale (vector-ref xs (- i 1)) 2) (algebraic-element field 0))))
        ((= (abs (- i j)) 1) (algebraic-scale (vector-ref xs (max i j)) 2))
        (else (algebraic-element field 0))))
(define callback-calls 0)
(define callback-storage (make-vector 120 #f))
(define (hvp xs direction)
  (set! callback-calls (+ callback-calls 1))
  (let ((n (vector-length xs)))
    (let rows ((i 0)) (if (< i n)
      (begin (vector-set! callback-storage i
        (let cols ((j 0) (sum (algebraic-element field 0)))
          (if (= j n) sum (cols (+ j 1) (algebraic-add sum (algebraic-scale (analytic xs i j) (vector-ref direction j)))))))
        (rows (+ i 1))))) callback-storage))
(define xs (point 12))
(define scalar (algebraic-sparse-hessian field objective xs (pattern 12)))
(check "scalar probes count upper structural entries, not colors"
  (equal? (vector->list (algebraic-sparse-hessian-summary scalar)) '(12 3 23 23 scalar)))
(let rows ((i 0)) (if (< i 12)
  (begin (let cols ((j 0)) (if (< j 12)
    (begin (check "exact sparse result agrees with independent dense analytic Hessian"
      (algebraic-equal? (algebraic-sparse-hessian-ref scalar i j) (analytic xs i j))) (cols (+ j 1)))))
    (rows (+ i 1)))))
(define large-point (point 120))
(define compressed (algebraic-sparse-hessian field #f large-point (pattern 120) hvp))
(check "120-variable exact HVP recovery makes three actual callback calls"
  (and (= callback-calls 3) (equal? (vector->list (algebraic-sparse-hessian-summary compressed)) '(120 3 3 239 hvp))))
(check "reused callback output storage cannot overwrite cached columns"
  (and (algebraic-equal? (algebraic-sparse-hessian-ref compressed 0 0) (analytic large-point 0 0))
       (algebraic-equal? (algebraic-sparse-hessian-ref compressed 118 119) (analytic large-point 118 119))))
(vector-set! callback-storage 0 (algebraic-element field 999))
(vector-set! (vector-ref large-point 0) 2 (vector 999 0))
(check "published sparse coefficients own their storage"
  (algebraic-equal? (algebraic-sparse-hessian-ref compressed 0 0) (algebraic-element field 24)))
(define observed (algebraic-sparse-hessian-ref scalar 0 0))
(vector-set! (vector-ref observed 2) 0 999)
(check "entry observers are defensive" (algebraic-equal? (algebraic-sparse-hessian-ref scalar 0 0) (analytic xs 0 0)))
(define duplicate (algebraic-sparse-hessian field objective (vector alpha) '((0 0) (0 0))))
(check "duplicate structural pairs consolidate" (= (vector-ref (algebraic-sparse-hessian-summary duplicate) 3) 1))
(define empty (algebraic-sparse-hessian field (lambda (x) (error "Must not call empty objective")) (vector) '()))
(check "empty Hessian performs no scalar calls" (= (vector-ref (algebraic-sparse-hessian-summary empty) 2) 0))
(define nested (call-with-algebraic-derivative field
  (lambda (a lift)
    (let* ((outer (algebraic-ad-context a))
           (result (algebraic-sparse-hessian outer
             (lambda (xs)
               (let ((hyper (algebraic-ad-context (vector-ref xs 0))))
                 (algebraic-ad-mul (algebraic-ad-constant hyper a)
                   (algebraic-ad-mul (vector-ref xs 0) (vector-ref xs 1)))))
             (vector 1 2) '((0 1)))))
      (algebraic-sparse-hessian-ref result 0 1))) 3 1))
(check "scalar sparse curvature retains enclosing derivatives" (= (algebraic-rational nested) 1))
(define nested-hvp (call-with-algebraic-derivative field
  (lambda (a lift)
    (let* ((outer (algebraic-ad-context a))
           (result (algebraic-sparse-hessian outer #f (vector 1 2) '((0 1))
             (lambda (xs v) (vector
               (algebraic-ad-mul a (algebraic-ad-constant outer (vector-ref v 1)))
               (algebraic-ad-mul a (algebraic-ad-constant outer (vector-ref v 0))))))))
      (algebraic-sparse-hessian-ref result 0 1))) 3 1))
(check "whole-column sparse curvature retains enclosing derivatives" (= (algebraic-rational nested-hvp) 1))
(for-each (lambda (thunk) (check "invalid sparse structure/callback/result refuses" (raises? thunk)))
  (list
    (lambda () (algebraic-sparse-hessian field objective xs '((12 12))))
    (lambda () (algebraic-sparse-hessian field objective xs '((0 1.0))))
    (lambda () (algebraic-sparse-hessian field #f xs (pattern 12) 42))
    (lambda () (algebraic-sparse-hessian field #f xs (pattern 12) (lambda (x v) (vector 1))))
    (lambda () (algebraic-sparse-hessian field #f xs (pattern 12) (lambda (x v) (make-vector 12 1.0))))
    (lambda () (algebraic-sparse-hessian field (lambda (x) (algebraic-ad-seed (make-algebraic-hyperdual field) 1))
      (vector alpha) '((0 0))))
    (lambda () (algebraic-sparse-hessian-ref scalar -1 0))))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
