;; Case-insensitive character comparison is a native LLVM surface.
(define checks 0)
(define (check name ok)
  (if ok (set! checks (+ checks 1)) (error name)))
(check "char-ci<= chain true" (char-ci<=? #\A #\b #\C))
(check "char-ci<= chain false" (not (char-ci<=? #\A #\c #\B)))
(check "char-ci>= chain true" (char-ci>=? #\C #\b #\A))
(check "char-ci>= chain false" (not (char-ci>=? #\C #\a #\B)))
(check "char-ci=? chain true" (char-ci=? #\A #\a #\A))
(check "char-ci=? chain false" (not (char-ci=? #\A #\a #\B)))
(check "char-ci<? chain true" (char-ci<? #\A #\b #\C))
(check "char-ci>? chain true" (char-ci>? #\C #\b #\A))
(define trace "")
(define count 0)
(define (operand marker ch)
  (set! trace (string-append trace marker))
  (set! count (+ count 1))
  ch)
(check "false CI chain still evaluates all operands"
       (not (char-ci<? (operand "a" #\C)
                       (operand "b" #\B)
                       (operand "c" #\A))))
(check "CI chain operand count" (= count 3))
(check "CI chain operand order" (string=? trace "abc"))
(display "Checks: ") (display checks) (newline)
(display "RESULT: PASS\n")
