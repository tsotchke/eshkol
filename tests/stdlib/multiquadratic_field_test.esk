(require stdlib)
(require core.ad.algebraic)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define inputs (list 2 3 8 6 9))
(define result (make-multiquadratic-field inputs))
(define field (vector-ref result 0))
(define images (vector-ref result 1))
(define a (vector-ref images 0))
(define b (vector-ref images 1))
(define theta (algebraic-add a b))
(check "two quadratic sources give degree four" (= (algebraic-field-degree field) 4))
(check "independent known minimal polynomial" (equal? (vector->list (algebraic-field-polynomial field)) '(1 0 -10 0 1)))
(check "positive selected generator" (= (algebraic-sign theta) 1))
(check "primitive generator equals sum" (algebraic-equal? theta (algebraic-generator field)))
(for-each (lambda (d image)
  (check "independent square equation" (= (algebraic-rational (algebraic-mul image image)) d))
  (check "positive conjugate" (= (algebraic-sign image) 1))) inputs (vector->list images))
(check "sqrt8 shares sqrt2" (algebraic-equal? (vector-ref images 2) (algebraic-scale a 2)))
(check "sqrt6 is sqrt2 times sqrt3" (algebraic-equal? (vector-ref images 3) (algebraic-mul a b)))
(check "perfect square collapses to rational" (= (algebraic-rational (vector-ref images 4)) 3))
(check "independent inverse identity" (algebraic-equal? (algebraic-inverse theta) (algebraic-sub b a)))
(check "inverse product one" (= (algebraic-rational (algebraic-mul theta (algebraic-inverse theta))) 1))
(define source (make-algebraic-field '(-2 0 1) 3 1))
(define transport (make-algebraic-embedding source field a))
(check "existing checked embedding accepts radical image" (algebraic-equal? (transport (algebraic-generator source)) a))
(check "wrong real conjugate refuses embedding" (raises? (lambda ()
  (make-algebraic-embedding source field (algebraic-scale a -1)))))
(define cert (algebraic-field-certificate field))
(check "square-class provenance is explicit" (and (eq? (car cert) 'multiquadratic)
  (equal? (vector->list (cadr cert)) '(2 3))))
(vector-set! (cadr cert) 0 999)
(check "certificate observation owns basis" (equal? (vector->list (cadr (algebraic-field-certificate field))) '(2 3)))
(define coefficients (algebraic-coefficients a))
(vector-set! coefficients 0 999)
(set-car! inputs 99)
(check "source and coefficient mutation cannot change admitted images" (= (algebraic-rational (algebraic-mul a a)) 2))
(define dependent (make-multiquadratic-field '(2 8 18 32)))
(check "dependent generators do not inflate degree" (= (algebraic-field-degree (vector-ref dependent 0)) 2))
(define rational (make-multiquadratic-field '(1 4 9)))
(check "rational-only field has degree one" (= (algebraic-field-degree (vector-ref rational 0)) 1))
(check "rational-only images" (equal? (map algebraic-rational (vector->list (vector-ref rational 1))) '(1 2 3)))
(check "rational field enclosure needs no irrational refinement" (equal?
  (algebraic-enclosure (vector-ref (vector-ref rational 1) 2) 64) '(3 3)))
(define empty (make-multiquadratic-field '()))
(check "empty radical set is Q" (and (= (algebraic-field-degree (vector-ref empty 0)) 1)
  (= (vector-length (vector-ref empty 1)) 0)))
(define rational-composition (make-algebraic-compositum (vector-ref rational 0) source))
(check "rational radical owner composes through the existing embedding path"
  (= (algebraic-field-degree (vector-ref rational-composition 0)) 2))
(check "rational transport keeps exact constants" (= (algebraic-rational
  ((vector-ref rational-composition 1) (vector-ref (vector-ref rational 1) 2))) 3))
(check "nonrational transport preserves source equation" (= (algebraic-rational
  (algebraic-mul ((vector-ref rational-composition 2) (algebraic-generator source))
                 ((vector-ref rational-composition 2) (algebraic-generator source)))) 2))
(define context (make-algebraic-taylor field 3))
(define x (algebraic-ad-seed context theta))
(define inverse (algebraic-ad-inverse x))
(define inv (algebraic-inverse theta))
(let derivatives ((i 0) (power inv) (factorial 1) (sign 1))
  (if (<= i 3)
    (begin (check "existing exact Taylor inverse in mixed radical field" (algebraic-equal?
      (algebraic-ad-derivative inverse i) (algebraic-scale power (* sign factorial))))
      (derivatives (+ i 1) (algebraic-mul power inv) (* factorial (+ i 1)) (- sign)))))
(define triple (make-multiquadratic-field '(2 3 5 30)))
(define tf (vector-ref triple 0))
(define ti (vector-ref triple 1))
(check "three independent square classes give degree eight" (= (algebraic-field-degree tf) 8))
(check "dependent product maps in degree eight" (algebraic-equal? (vector-ref ti 3)
  (algebraic-mul (algebraic-mul (vector-ref ti 0) (vector-ref ti 1)) (vector-ref ti 2))))
(define maximum (make-multiquadratic-field '(2 3 5 7)))
(check "four independent classes admit degree sixteen" (= (algebraic-field-degree (vector-ref maximum 0)) 16))
(check "degree-sixteen positive sum selects known interval" (let* ((f (vector-ref maximum 0)) (sum (algebraic-generator f)))
  (and (= (algebraic-sign (algebraic-sub sum (algebraic-element f 8))) 1)
       (= (algebraic-sign (algebraic-sub sum (algebraic-element f 81/10))) -1))))
(for-each (lambda (bad) (check "invalid radicand refuses" (raises? (lambda () (make-multiquadratic-field bad)))))
  (list '(-1) '(0) '(2.0) '(1/2) '(65536) '(2 3 5 7 11) '(1 1 1 1 1 1 1 1 1) (cons 2 3)))
(check "isolation budget refusal" (raises? (lambda () (make-multiquadratic-field '(2 3) 0))))
(check "inexact budget refuses" (raises? (lambda () (make-multiquadratic-field '(2) 4.0))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
