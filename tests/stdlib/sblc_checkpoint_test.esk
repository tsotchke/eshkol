(require stdlib)
(require core.sblc)
(require core.dbsp)
(require agent.crypto)
(define checks 0)
(define (check label ok) (set! checks (+ checks 1))
  (if (not ok) (begin (display "FAIL: ") (write label) (newline) (exit 1))))
(define (raises? f) (eq? 'raised (guard (e (else 'raised)) (f) 'returned)))
(define I (blc-lam (blc-var 1)))
(define K (blc-lam (blc-lam (blc-var 2))))
(define W (blc-lam (blc-app (blc-var 1) (blc-var 1))))
(define partial (list (cons (sblc-choice I (blc-app W W)) I)))
(define (same a b) (string=? (sblc-receipt->string a) (sblc-receipt->string b)))
(define (wire-copy x)
  (let ((out (open-output-string)))
    (write x out)
    (let* ((text (get-output-string out)) (in (open-input-string text)) (v (read in)))
      (check 'one-datum (eof-object? (read in))) (close-port in) (close-port out) v)))
(define search (sblc-search-start 7 4 2 partial))
(define saved (sblc-search-checkpoint search))
(define restored (sblc-search-restore (wire-copy saved) 7 4 partial))
(check 'restored-receipt (same (sblc-search-receipt search) (sblc-search-receipt restored)))
(check 'load-selects-no-transitions (= 0 (car (sblc-search-work restored))))
(check 'cold-continuation-equals-fresh
       (same (sblc-search-receipt (sblc-search-resume restored 6)) (sblc-condition 7 4 6 partial)))
(define (rehash p) (list 'sblc-checkpoint-v1 (sha256 (zset-row-key p)) p))
(define (refuses label mutate)
  (let ((c (wire-copy saved))) (mutate c)
    (check label (raises? (lambda () (sblc-search-restore c 7 4 partial))))))
(define (trial c) (car (cadr (car (list-ref (caddr c) 8)))))
(refuses 'digest (lambda (c) (set-car! (cdr c) (make-string 64 #\0))))
(refuses 'corrupt-payload (lambda (c) (set-car! (cdr (caddr c)) 'wrong-syntax)))
(define (refuses-sealed label mutate)
  (let ((p (caddr (wire-copy saved)))) (mutate p)
    (check label (raises? (lambda () (sblc-search-restore (rehash p) 7 4 partial))))))
(refuses-sealed 'syntax-version (lambda (p) (set-car! (cdr p) 'wrong-syntax)))
(refuses-sealed 'strategy-version (lambda (p) (set-car! (cddr p) 'wrong-strategy)))
(refuses-sealed 'rng-version (lambda (p) (set-car! (cdddr p) 'wrong-rng)))
(refuses-sealed 'job-seed (lambda (p) (set-car! (list-tail p 4) 9)))
(refuses-sealed 'missing-catalogue (lambda (p) (set-car! (list-tail p 8) '())))
(refuses-sealed 'wrong-program-id (lambda (p) (set-car! (car (list-ref p 8)) "wrong")))
(refuses-sealed 'missing-trial (lambda (p) (set-car! (cdr (car (list-ref p 8))) '())))
(refuses 'invalid-work (lambda (c) (let ((t (trial c))) (set-car! (cdr t) 0)
                                    (set-car! (cdr c) (sha256 (zset-row-key (caddr c)))))))
(refuses 'mass-partition (lambda (c) (set-cdr! (car (cadddr (trial c))) 1)
                                     (set-car! (cdr c) (sha256 (zset-row-key (caddr c))))))
(refuses 'normal-frontier (lambda (c) (set-car! (car (cadddr (trial c))) I)
                                      (set-car! (cdr c) (sha256 (zset-row-key (caddr c))))))
(check 'wrong-expected-context (raises? (lambda () (sblc-search-restore saved 7 4 (list (cons I I))))))
(check 'wrong-expected-length (raises? (lambda () (sblc-search-restore saved 7 11 partial))))
(define broken (list 'sblc-checkpoint-v1)) (set-cdr! broken broken)
(check 'cyclic-checkpoint (raises? (lambda () (sblc-search-restore broken 7 4 partial))))
(set-car! (caddr saved) 'damaged)
(check 'restoration-detaches-input
       (same (sblc-search-receipt (sblc-search-resume restored 4)) (sblc-condition 7 4 4 partial)))
(check 'source-handle-detached (same (sblc-search-receipt search) (sblc-condition 7 4 2 partial)))
(for-each (lambda (examples)
  (for-each (lambda (L)
    (let loop ((bound 0))
      (if (<= bound 3)
          (let* ((a (sblc-search-start 23 L bound examples))
                 (b (sblc-search-restore (wire-copy (sblc-search-checkpoint a)) 23 L examples)))
            (check 'wire-restored-receipt (same (sblc-search-receipt a) (sblc-search-receipt b)))
            (check 'refined-wire-receipt
                   (same (sblc-search-receipt (sblc-search-resume b 5)) (sblc-condition 23 L 5 examples)))
            (loop (+ bound 1)))))) '(3 4 11 14)))
  (list '() (list (cons I I)) (list (cons I K)) (list (cons I I) (cons I I)) partial))
(display "SBLC CHECKPOINT checks: ") (display checks) (newline)
(display "SBLC CHECKPOINT RESULT: PASS") (newline)
