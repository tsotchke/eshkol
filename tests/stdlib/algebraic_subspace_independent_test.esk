(require stdlib)
(require core.ad.algebraic_subspace)
(define n 0)
(define (check label ok) (if (not ok) (error label)) (set! n (+ n 1)))
(define owner (make-algebraic-field '(-2 0 1) 3 1))
(define same? (algebraic-domain-ref (algebraic-domain owner) 'equal?))
(define a (vector (vector -2 0) (vector 0 5)))
(define p (vector (vector 1 0) (vector 0 0)))
(define h (vector (vector 4 7) (vector 7 -6)))
(define seed (vector (vector 2 3) (vector 11 5)))
(define space (make-algebraic-subspace owner a p))
(define dp (algebraic-subspace-jvp space h))
(define adj (algebraic-subspace-vjp space seed))
(define (at m i j) (vector-ref (vector-ref m i) j))
(check "independent selected-rank" (= (vector-ref (algebraic-subspace-info space) 1) 1))
(check "JVP00" (same? (at dp 0 0) 0))
(check "JVP01 equals H01/(lambda0-lambda1)" (same? (at dp 0 1) -1))
(check "JVP10" (same? (at dp 1 0) -1))
(check "JVP11" (same? (at dp 1 1) 0))
(check "VJP00" (same? (at adj 0 0) 0))
(check "asymmetric seed VJP01" (same? (at adj 0 1) -1))
(check "asymmetric seed VJP10" (same? (at adj 1 0) -1))
(check "VJP11" (same? (at adj 1 1) 0))
(check "defining source residual" (verify-algebraic-subspace-jvp owner a p h dp))
(check "forged factor-two derivative rejected" (not (verify-algebraic-subspace-jvp owner a p h (vector (vector 0 -2) (vector -2 0)))))
(define commuting (algebraic-subspace-jvp space (vector (vector 8 0) (vector 0 3))))
(check "commuting direction gives zero projector derivative" (and (same? (at commuting 0 0) 0) (same? (at commuting 0 1) 0) (same? (at commuting 1 0) 0) (same? (at commuting 1 1) 0)))
(display "Checks: ") (display n) (newline) (display "RESULT: PASS\n")
