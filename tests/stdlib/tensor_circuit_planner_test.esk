(require stdlib)
(require core.dbsp.tensor_circuit)
(require core.ad.tensor_circuit_reverse)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (test-tensor shape xs) (let ((out (make-tensor shape 0.0)))
  (let loop ((rest xs) (i 0)) (if (pair? rest) (begin (tensor-set! out i (car rest)) (loop (cdr rest) (+ i 1))))) out))
(define (near? a b) (and (equal? (tensor-shape a) (tensor-shape b))
  (let loop ((i 0)) (or (= i (fold-left * 1 (tensor-shape a))) (and (< (abs (- (tensor-ref a i) (tensor-ref b i))) 0.00000001) (loop (+ i 1)))))))
(define a (test-tensor '(4 4) (map (lambda (i) (/ (+ i 1) 17.0)) (iota 16))))
(define b (test-tensor '(4 4) (map (lambda (i) (/ (- i 4) 19.0)) (iota 16))))
(define initial (make-tensor-circuit (list (list 'a '(i k) a) (list 'b '(k j) b)) '(contract a b (k))))
(define incremental initial) (define recompute initial) (define automatic initial)
(let ticks ((tick 0)) (if (< tick 24)
  (let* ((dense? (odd? tick)) (ids (if dense? (iota 16) (list (modulo tick 16))))
         (entries (map (lambda (i) (list (list (quotient i 4) (modulo i 4)) (if (even? tick) 0.03125 -0.015625))) ids))
         (da (tensor-delta '(4 4) entries)) (db (tensor-delta '(4 4) entries))
         (changes (list (list 'a da) (list 'b db)))
         (i (tensor-circuit-step incremental changes 'incremental))
         (r (tensor-circuit-step recompute changes 'recompute))
         (u (tensor-circuit-step automatic changes 'auto)))
    (for-each (lambda (id) (tensor-set! a id (+ (tensor-ref a id) (if (even? tick) 0.03125 -0.015625)))
                         (tensor-set! b id (+ (tensor-ref b id) (if (even? tick) 0.03125 -0.015625)))) ids)
    (set! incremental (vector-ref i 0)) (set! recompute (vector-ref r 0)) (set! automatic (vector-ref u 0))
    (define oracle (tensor-matmul a b))
    (check "forced incremental matches independent native oracle" (near? (tensor-circuit-output incremental) oracle))
    (check "forced recompute matches independent native oracle" (near? (tensor-circuit-output recompute) oracle))
    (check "auto matches independent native oracle" (near? (tensor-circuit-output automatic) oracle))
    (check "auto chooses both sides of estimated crossover" (= (vector-ref (tensor-circuit-plan-work automatic) (if dense? 1 0)) 1))
    (check "forced strategy receipt" (and (= (vector-ref (tensor-circuit-plan-work recompute) 1) 1) (= (vector-ref (tensor-circuit-plan-work incremental) 0) 1)))
    (ticks (+ tick 1)))))
(check "historical state preserved" (not (near? (tensor-circuit-output initial) (tensor-circuit-output automatic))))
(check "auto cancellation does not schedule" (equal? (vector->list (tensor-circuit-plan-work (vector-ref (tensor-circuit-step automatic '() 'auto) 0))) '(0 0 0 0 0)))
(check "unknown strategy refuses" (raises? (lambda () (tensor-circuit-step initial '() 'fastest))))
;; Shared free axes use the general contraction path, including simultaneous terms.
(define batched (make-tensor-circuit (list (list 'a '(batch k) (test-tensor '(2 2) '(1 2 3 4)))
                                         (list 'b '(batch k) (test-tensor '(2 2) '(5 6 7 8)))) '(contract a b (k))))
(define changes (list (list 'a (tensor-delta '(2 2) '(((0 0) 1) ((1 1) -1))))
                     (list 'b (tensor-delta '(2 2) '(((0 1) 2) ((1 0) 1))))))
(define bi (vector-ref (tensor-circuit-step batched changes 'incremental) 0))
(define br (vector-ref (tensor-circuit-step batched changes 'recompute) 0))
(check "general batched contraction forced strategies agree" (near? (tensor-circuit-output bi) (tensor-circuit-output br)))
(check "general oracle coordinates" (and (= (tensor-circuit-ref br '(0)) 26) (= (tensor-circuit-ref br '(1)) 48)))
;; Recomputed snapshots remain readable through the existing reverse visitor.
(define visited 0)
(tensor-circuit-visit recompute (lambda (id op children params axes shape names reader)
  (if reader (begin (reader '(0 0)) (set! visited (+ visited 1))))))
(check "pullback visitor accepts recomputed snapshots" (> visited 0))
(define huge (make-tensor-circuit (list (list 'a '(i k) (test-tensor '(1 1) '(100000000)))
  (list 'b '(k j) (test-tensor '(1 1) '(100000000)))) '(sum (contract a b (k)) (i j))))
(define huge-next (vector-ref (tensor-circuit-step huge
  (list (list 'a (tensor-delta '(1 1) '(((0 0) -99999999))))
        (list 'b (tensor-delta '(1 1) '(((0 0) -99999999))))) 'recompute) 0))
(check "fresh dense replacement survives cancellation through reductions" (= (tensor-circuit-ref huge-next '()) 1))
(define chain (make-tensor-circuit
  (list (list 'a '(i k) (make-tensor '(2 2) 100000000.0))
        (list 'b '(k j) (make-tensor '(2 2) 100000000.0))
        (list 'c '(j z) (make-tensor '(2 1) 1.0))) '(contract (contract a b (k)) c (j))))
(define all-change (tensor-delta '(2 2) '(((0 0) -99999999) ((0 1) -99999999) ((1 0) -99999999) ((1 1) -99999999))))
(define chain-next (vector-ref (tensor-circuit-step chain (list (list 'a all-change) (list 'b all-change)) 'auto) 0))
(check "auto rebases downstream contractions after cancellation" (and (= (tensor-circuit-ref chain-next '(0 0)) 4) (= (tensor-circuit-ref chain-next '(1 0)) 4)
  (= (vector-ref (tensor-circuit-plan-work chain-next) 1) 2)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
