;; The callee and earlier arguments remain live during nested initializers.
(define (check actual expected)
  (if (equal? actual expected) #t (error "named-let initializer slot mismatch")))
(check (let loop ((a (let ((x 7)) x))) a) 7)
(check (let loop ((a 2) (b (let ((x 3)) x))) (+ a b)) 5)
(check (let loop ((a (let ((x 2)) x))
                  (b (let ((x 3) (y 4)) (+ x y)))
                  (n 3))
         (if (= n 0) (+ a b) (loop a b (- n 1)))) 9)
(define (outer base)
  (let loop ((a 2) (b (let ((x base)) x)))
    (+ a b)))
(check (outer 40) 42)
(define effect 0)
(check (let loop ((a (begin (set! effect (+ effect 1)) (let ((x effect)) x)))
                  (b (begin (set! effect (+ effect 1)) (let ((x effect)) x))))
         (+ a b)) 3)
(check effect 2)
(check (let ((__operand__ 41))
         (let loop ((x __operand__) (y (let ((t __operand__)) (+ t 1))))
           (+ x y))) 83)
(check (let ((__operand__ 8)) (+ 1 (let ((t __operand__)) t))) 9)
(check (let ((__call_func__ 20) (__call_arg__ 22))
         ((lambda (a b) (+ a b)) __call_func__ __call_arg__)) 42)
(check (let ((__call_func__ 20) (__call_arg__ 22)
             (+ (lambda (a b) (- a b))))
         (+ __call_arg__ __call_func__)) 2)
(display "PASS: named_let_initializer_slots")
(newline)

(display "RESULT: PASS")
(newline)
