(require stdlib)
(require core.dbsp.tensor_circuit)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (filled shape start)
  (let ((x (make-tensor shape 0.0)) (n (fold-left * 1 shape)))
    (let loop ((i 0)) (if (< i n) (begin (tensor-set! x i (+ start i)) (loop (+ i 1))))) x))
(define a (filled '(2 2) 1)) (define b (filled '(2 2) 5))
(define initial (make-tensor-circuit (list (list 'a '(i k) a) (list 'b '(k j) b)) '(contract a b (k))))
(check "initial contraction" (and (= (tensor-circuit-ref initial '(0 0)) 19) (= (tensor-circuit-ref initial '(1 1)) 50)))
(define state initial)
(define aa a) (define bb b)
(let ticks ((t 0)) (if (< t 12)
  (let* ((da (tensor-delta '(2 2) (list (list (list (modulo t 2) (modulo (+ t 1) 2)) (- (modulo t 3) 1)))))
         (db (tensor-delta '(2 2) (list (list (list (modulo (+ t 1) 2) (modulo t 2)) 1))))
         (old (tensor-circuit-output state))
         (tick (tensor-circuit-step state (list (list 'a da) (list 'b db)))))
    (set! aa (tensor-apply-delta aa da)) (set! bb (tensor-apply-delta bb db))
    (set! state (vector-ref tick 0))
    (let ((actual (tensor-circuit-output state)) (integrated (tensor-apply-delta old (vector-ref tick 1))))
      (let rows ((i 0)) (if (< i 2)
        (begin (let cols ((j 0)) (if (< j 2)
          (let ((expected (+ (* (tensor-ref aa (* i 2)) (tensor-ref bb j))
                             (* (tensor-ref aa (+ (* i 2) 1)) (tensor-ref bb (+ 2 j))))))
            (check "prefix agrees with independent dense product" (= (tensor-ref actual (+ (* i 2) j)) expected))
            (check "integrated output delta agrees" (= (tensor-ref integrated (+ (* i 2) j)) expected))
            (cols (+ j 1))))) (rows (+ i 1))))))
    (ticks (+ t 1)))))
(check "historical circuit unchanged" (= (tensor-circuit-ref initial '(0 0)) 19))
(define self (make-tensor-circuit (list (list 'x '(i) (filled '(3) 1))) '(contract x x (i))))
(check "full contraction is explicit one-cell tensor" (= (tensor-circuit-ref self '()) 14))
(define self-next (vector-ref (tensor-circuit-step self (list (list 'x (tensor-delta '(3) '(((1) 3)))))) 0))
(check "shared operand finite square includes cross term" (= (tensor-circuit-ref self-next '()) 35))
(define shared (make-tensor-circuit (list (list 'x '(i) (filled '(3) 1)))
  '(+ (contract x x ()) (contract x x ()))))
(define shared-tick (tensor-circuit-step shared (list (list 'x (tensor-delta '(3) '(((1) 1)))))))
(check "common subexpression executes once" (= (vector-ref (vector-ref shared-tick 2) 0) 2))
(check "common subexpression accumulation" (= (tensor-circuit-ref (vector-ref shared-tick 0) '(1)) 18))
(vector-set! (vector-ref shared-tick 2) 0 999)
(check "returned receipt does not alias snapshot observations" (= (vector-ref (tensor-circuit-work (vector-ref shared-tick 0)) 0) 2))
(define batch (make-tensor-circuit
  (list (list 'a '(batch i k) (filled '(2 2 2) 1)) (list 'b '(batch k j) (filled '(2 2 2) 2)))
  '(contract a b (k))))
(check "shared free axis remains a batch axis" (and (= (tensor-circuit-ref batch '(0 0 0)) 10)
  (= (tensor-circuit-ref batch '(1 1 1)) 121)))
(define bt (tensor-circuit-step batch (list (list 'a (tensor-delta '(2 2 2) '(((1 0 1) 2)))))))
(check "batch edit touches correct batch only" (and (= (tensor-circuit-ref (vector-ref bt 0) '(0 0 0)) 10)
  (= (tensor-circuit-ref (vector-ref bt 0) '(1 0 0)) 94)))
(define reduced (make-tensor-circuit (list (list 'x '(i k) a)) '(sum (transpose x (k i)) (i))))
(check "transpose followed by named reduction" (and (= (tensor-circuit-ref reduced '(0)) 4) (= (tensor-circuit-ref reduced '(1)) 6)))
(define rows (zset-from-weighted '((1 (0 0 2)) (1 (1 1 3)))))
(define projected (make-tensor-circuit (list (list 'rows 'rows rows) (list 'b '(k j) b))
  '(contract (project rows (i k) (2 2) (0 1) 2) b (k))))
(check "table projection contracts" (= (tensor-circuit-ref projected '(1 1)) 24))
(define pt (tensor-circuit-step projected (list (list 'rows (zset-from-weighted '((-1 (1 1 3)) (1 (1 0 4)))))
                                            (list 'b (tensor-delta '(2 2) '(((0 1) 2)))))))
(check "retraction plus simultaneous matrix change" (= (tensor-circuit-ref (vector-ref pt 0) '(1 1)) 32))
(define empty-tick (tensor-circuit-step state '()))
(check "empty tick performs no tensor work" (equal? (vector->list (vector-ref empty-tick 2)) '(0 0 0)))
(check "cancelling input batches perform no work" (equal? (vector->list (vector-ref (tensor-circuit-step state
  (list (list 'a (tensor-delta '(2 2) '(((0 0) 2)))) (list 'a (tensor-delta '(2 2) '(((0 0) -2)))))) 2)) '(0 0 0)))
(check "invalid tick preserves prior version" (and (raises? (lambda () (tensor-circuit-step initial
  (list (list 'a (tensor-delta '(4) '(((0) 1)))))))) (= (tensor-circuit-ref initial '(0 0)) 19)))
(check "unknown input refused" (raises? (lambda () (tensor-circuit-step initial (list (list 'missing (tensor-delta '(2 2) '())))))))
(check "axis dimension mismatch refused" (raises? (lambda () (make-tensor-circuit
  (list (list 'a '(i k) a) (list 'b '(k j) (filled '(3 2) 1))) '(contract a b (k))))))
(check "unsupported expression refused" (raises? (lambda () (make-tensor-circuit (list (list 'a '(i k) a)) '(eval a)))))
(check "duplicate axes refused" (raises? (lambda () (make-tensor-circuit (list (list 'a '(i i) a)) 'a))))
(define observed (tensor-circuit-output initial)) (tensor-set! observed 0 999)
(check "full observation owns its cells" (= (tensor-circuit-ref initial '(0 0)) 19))
(for-each (lambda (n)
  (let* ((x (make-tensor (list n) 2.0)) (c (make-tensor-circuit (list (list 'x '(i) x)) '(contract x x ())))
         (tick (tensor-circuit-step c (list (list 'x (tensor-delta (list n) '(((0) 1))))))))
    (check "fixed sparse edit has fixed arithmetic at growing payload" (= (vector-ref (vector-ref tick 2) 1) 3))
    (check "only touched blocks copied" (= (vector-ref (vector-ref tick 2) 2) 512)))) '(512 8192))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: tensor_circuit_test") (newline) (display "RESULT: PASS") (newline)
