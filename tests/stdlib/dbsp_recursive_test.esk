(require stdlib)
(require core.dbsp.recursive)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define declarations (list
  (list 'join 'extend 'recur 'base cadr car (lambda (left right) (list (car left) (cadr right))))
  (list 'union 'paths 'base 'extend)
  (list 'distinct 'out 'paths)))
;; Independent finite-graph Floyd-Warshall oracle; no DBSP join/fixed-point
;; operator participates. Reflexive reachability arises only from graph cycles.
(define (closure edges)
  (let ((rows (make-vector 5 #f)))
    (let init ((i 0)) (if (< i 5)
      (begin (vector-set! rows i (make-vector 5 #f)) (init (+ i 1)))))
    (for-each (lambda (e) (if (> (car e) 0)
      (vector-set! (vector-ref rows (car (cadr e))) (cadr (cadr e)) #t))) (zset-entries edges))
    (let via ((k 0)) (if (< k 5)
      (begin (let from ((i 0)) (if (< i 5)
        (begin (let to ((j 0)) (if (< j 5)
          (begin (if (and (vector-ref (vector-ref rows i) k) (vector-ref (vector-ref rows k) j))
                     (vector-set! (vector-ref rows i) j #t)) (to (+ j 1)))))
               (from (+ i 1))))) (via (+ k 1)))))
    (let from ((i 0) (out '()))
      (if (= i 5) (zset-from-weighted out)
        (from (+ i 1) (let to ((j 0) (acc out))
          (if (= j 5) acc (to (+ j 1) (if (vector-ref (vector-ref rows i) j)
                                      (cons (list 1 (list i j)) acc) acc)))))))))
(define initial (make-dbsp-recursive declarations 'out 32))
(define state initial)
(define base (zset-empty))
(define integrated (zset-empty))
(define history '())
(define changes '(((1 (0 1)) (1 (1 2)) (1 (0 3)) (1 (3 2)))
                  ((1 (2 4))) ((1 (2 0))) ((-1 (1 2)))
                  ((-1 (3 2))) ((1 (1 4))) ((-1 (2 0)))
                  ((2 (0 1))) ((-2 (0 1))) ((-1 (2 4)))
                  ((-1 (0 1)) (-1 (0 3)) (-1 (1 4)))))
(for-each (lambda (entries)
  (let* ((delta (zset-from-weighted entries)) (next (dbsp-recursive-step state delta)))
    (set! base (zset-add base delta)) (set! integrated (zset-add integrated (vector-ref next 1)))
    (set! state (vector-ref next 0))
    (check "every signed prefix equals independent graph closure" (zset=? (dbsp-recursive-output state) (closure base)))
    (check "integrated output deltas equal batch closure" (zset=? integrated (closure base)))
    (check "inner round count is bounded" (<= (vector-ref (dbsp-recursive-work state) 0) 32))
    (set! history (cons (cons state (closure base)) history)))) changes)
(for-each (lambda (saved) (check "retained recursive snapshots survive later deletions"
  (zset=? (dbsp-recursive-output (car saved)) (cdr saved)))) history)
(check "initial snapshot remains empty" (zset-empty? (dbsp-recursive-output initial)))
(define seed (vector-ref (dbsp-recursive-step initial (zset-from-weighted '((1 (0 1)) (1 (1 2))))) 0))
(define fork (vector-ref (dbsp-recursive-step seed (zset-singleton '(2 4) 1)) 0))
(check "fork advances independently" (and (= (zset-weight (dbsp-recursive-output fork) '(0 4)) 1)
                                         (= (zset-weight (dbsp-recursive-output seed) '(0 4)) 0)))
(define no-op (dbsp-recursive-step seed (zset-from-weighted '((7 (0 1)) (-7 (0 1))))))
(check "consolidated no-op executes no inner rounds" (= (vector-ref (vector-ref no-op 2) 0) 0))
(check "excess retraction refused" (raises? (lambda () (dbsp-recursive-step seed (zset-singleton '(0 1) -2)))))
(check "refused tick leaves snapshot valid" (= (zset-weight (dbsp-recursive-output seed) '(0 2)) 1))
(define short (make-dbsp-recursive declarations 'out 1))
(check "insufficient round budget refuses atomically" (raises? (lambda ()
  (dbsp-recursive-step short (zset-singleton '(0 1) 1)))))
(check "budget refusal keeps previous state empty" (zset-empty? (dbsp-recursive-output short)))
(define divergent (make-dbsp-recursive (list (list 'union 'out 'base 'recur)) 'out 4))
(check "unbounded bag recurrence refuses" (raises? (lambda ()
  (dbsp-recursive-step divergent (zset-singleton 'a 1)))))
(define guarded (make-dbsp-recursive (list (list 'map 'out 'base
  (lambda (row) (if (= row 99) (error "deliberate rejection") row)))) 'out))
(check "callback failure refuses" (raises? (lambda () (dbsp-recursive-step guarded (zset-singleton 99 1)))))
(check "callback failure does not poison next update" (= (zset-weight
  (dbsp-recursive-output (vector-ref (dbsp-recursive-step guarded (zset-singleton 4 1)) 0)) 4) 1))
(for-each (lambda (f) (check "constructor refuses unsupported input" (raises? f)))
  (list (lambda () (make-dbsp-recursive declarations 'out 0))
        (lambda () (make-dbsp-recursive declarations 'out 1025))
        (lambda () (make-dbsp-recursive (list (list 'negate 'out 'base)) 'out))
        (lambda () (make-dbsp-recursive (list (list 'union 'out 'out 'base)) 'out))))
(define copied (dbsp-recursive-work fork)) (vector-set! copied 0 999)
(check "work observations are owned" (< (vector-ref (dbsp-recursive-work fork) 0) 999))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
