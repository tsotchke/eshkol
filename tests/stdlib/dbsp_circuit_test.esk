(require stdlib)
(require core.dbsp.circuit)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (key x) (modulo x 3))
(define (emit a b) (list a b))
(define (keep row) (odd? (+ (car row) (cadr row))))
(define (project row) (+ (car row) (cadr row)))
(define (batch a b)
  (zset-distinct (zset-add a (zset-map project (zset-filter keep (zset-join a b key key emit))))))
(define declarations (list
  (list 'join 'j 'a 'b key key emit)
  (list 'filter 'f 'j keep)
  (list 'project 'p 'f project)
  (list 'union 'u 'p 'a)
  (list 'distinct 'out 'u)))
(define initial (make-dbsp-circuit '(a b) declarations 'out))
(define current initial)
(define a (zset-empty))
(define b (zset-empty))
(define integrated (zset-empty))
(define prefixes-ok #t)
(let ticks ((i 0))
  (if (< i 36)
      (let* ((da (zset-from-weighted (list (list 1 (modulo i 7)) (list -1 (modulo (+ i 3) 7)))))
             (db (zset-from-weighted (list (list 2 (modulo i 5)) (list -1 (modulo (+ i 2) 5)))))
             (step (dbsp-circuit-step current (list (list 'a da) (list 'b db)))))
        (set! a (zset-add a da)) (set! b (zset-add b db))
        (set! current (car step)) (set! integrated (zset-add integrated (cdr step)))
        (if (not (and (zset=? (dbsp-circuit-output current) (batch a b))
                      (zset=? integrated (batch a b))
                      (zset=? (dbsp-circuit-input current 'a) a)))
            (set! prefixes-ok #f))
        (ticks (+ i 1)))))
(check "36 signed update prefixes equal independent full-batch composition" prefixes-ok)
(check "unadvanced circuit remains empty" (zset-empty? (dbsp-circuit-output initial)))
(define fork (car (dbsp-circuit-step initial (list (list 'a (zset-singleton 8 1))))))
(check "fork has its own result" (and (zset=? (dbsp-circuit-output fork) (zset-singleton 8 1))
  (zset-empty? (dbsp-circuit-output initial))))
(define observed (dbsp-circuit-output fork))
(vector-set! observed 1 '())
(check "output observer cannot replace retained trace" (zset=? (dbsp-circuit-output fork) (zset-singleton 8 1)))
(define cancellation (car (dbsp-circuit-step fork
  (list (list 'a (zset-singleton 8 7)) (list 'a (zset-singleton 8 -7))))))
(check "same-tick repeated input cancellation schedules no work"
  (and (equal? (vector->list (dbsp-circuit-work cancellation)) '(0 0 0 0))
       (zset=? (dbsp-circuit-output cancellation) (dbsp-circuit-output fork))))

;; A shared input supplies BOTH operands; dropping dA*dB is immediately wrong.
(define shared (make-dbsp-circuit '(a) (list (list 'join 'out 'a 'a key key emit)) 'out))
(define same-step (dbsp-circuit-step shared (list (list 'a (zset-singleton 1 2)))))
(check "shared-operand cross term preserves multiplied weights"
  (= (zset-weight (dbsp-circuit-output (car same-step)) '(1 1)) 4))
(define retract (dbsp-circuit-step (car same-step) (list (list 'a (zset-singleton 1 -1)))))
(check "shared-operand retraction exact" (= (zset-weight (cdr retract) '(1 1)) -3))

;; The two canonical strings collide under the fixed djb2 hash. Key equality
;; must still preserve separate rows through insertion and deletion.
(define collision (make-dbsp-circuit '(a) '() 'a))
(define collision-step (car (dbsp-circuit-step collision (list (list 'a
  (zset-from-weighted '((1 "Aa") (2 "B@"))))))))
(check "hash collision rows remain distinct" (and
  (= (zset-weight (dbsp-circuit-output collision-step) "Aa") 1)
  (= (zset-weight (dbsp-circuit-output collision-step) "B@") 2)))
(define collision-next (car (dbsp-circuit-step collision-step (list (list 'a (zset-singleton "Aa" -1))))))
(check "collision deletion preserves neighbour" (= (zset-weight (dbsp-circuit-output collision-next) "B@") 2))

(define (row-key row) (car row))
(define (row-emit left right) (list (car left) (cadr left) (cadr right)))
(for-each (lambda (n)
  (let* ((empty (make-dbsp-circuit '(a b) (list (list 'join 'out 'a 'b row-key row-key row-emit)) 'out))
         (rows (let build ((i 0) (out '())) (if (= i n) out (build (+ i 1) (cons (list 1 (list i i)) out)))))
         (seed (zset-from-weighted rows))
         (warm (car (dbsp-circuit-step empty (list (list 'a seed) (list 'b seed)))))
         (next (car (dbsp-circuit-step warm (list (list 'a (zset-singleton '(0 9) 1))))))
         (work (dbsp-circuit-work next)))
    (check "join probes fixed touched bucket despite increasing cold state" (= (vector-ref work 1) 2))
    (check "join result includes newly affected match" (= (zset-weight (dbsp-circuit-output next) '(0 9 0)) 1))
    (check "old standing output intact" (= (zset-size (dbsp-circuit-output warm)) n))
    (check "compiled graph physically shared" (eq? (vector-ref warm 1) (vector-ref next 1)))
    (check "untouched input-state index branch physically shared"
      (eq? (vector-ref (vector-ref warm 4) 1) (vector-ref (vector-ref next 4) 1)))
    (display "SCALE: keys=") (display n) (display " probes=") (display (vector-ref work 1)) (newline))) '(16 512))

(define guarded (make-dbsp-circuit '(a) (list (list 'map 'out 'a
  (lambda (row) (if (= row 99) (error "deliberate callback refusal") row)))) 'out))
(check "late callback failure refuses successor" (raises? (lambda ()
  (dbsp-circuit-step guarded (list (list 'a (zset-singleton 99 1)))))))
(check "failed attempt leaves input and output empty"
  (and (zset-empty? (dbsp-circuit-input guarded 'a)) (zset-empty? (dbsp-circuit-output guarded))))
(check "valid tick still works after failure" (zset=?
  (dbsp-circuit-output (car (dbsp-circuit-step guarded (list (list 'a (zset-singleton 4 1))))))
  (zset-singleton 4 1)))
(check "unknown input refused" (raises? (lambda () (dbsp-circuit-step guarded (list (list 'foreign (zset-empty)))))))
(check "duplicate names refused" (raises? (lambda () (make-dbsp-circuit '(a a) '() 'a))))
(check "forward reference/cycle refused" (raises? (lambda ()
  (make-dbsp-circuit '(a) (list (list 'union 'out 'out 'a)) 'out))))
(check "unsupported operator refused" (raises? (lambda ()
  (make-dbsp-circuit '(a) (list (list 'mystery 'out 'a)) 'out))))
(check "nonprocedure refused" (raises? (lambda ()
  (make-dbsp-circuit '(a) (list (list 'map 'out 'a 0)) 'out))))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: dbsp_circuit_test") (newline)
(display "RESULT: PASS") (newline)
