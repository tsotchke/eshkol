(require stdlib)
(require core.exact_psd)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (energy m v)
  (let row ((i 0) (sum 0))
    (if (= i (vector-length v)) sum
        (row (+ i 1) (let col ((j 0) (out sum))
          (if (= j (vector-length v)) out
              (col (+ j 1) (+ out (* (vector-ref v i) (exact-matrix-ref m i j) (vector-ref v j))))))))))
(define (reconstructs? m result)
  (let ((b (psd-factor-rows result)) (d (psd-factor-weights result)) (n (vector-length m)))
    (and (= (vector-length b) (vector-length d))
      (let row ((i 0))
        (or (= i n)
            (and (let col ((j 0))
                   (or (= j n)
                       (and (= (exact-matrix-ref m i j)
                         (let sum ((k 0) (out 0))
                           (if (= k (vector-length d)) out
                               (sum (+ k 1) (+ out (* (vector-ref d k)
                                 (exact-matrix-ref b k i) (exact-matrix-ref b k j)))))))
                         (col (+ j 1)))))
                 (row (+ i 1))))))))

;; Exhaust all 729 ternary symmetric 3x3 matrices. Classify independently
;; by all principal minors; check the actual returned factor or negative v.
(define all-ok #t)
(define cases 0)
(define positive 0)
(define negative 0)
(for-each (lambda (a) (for-each (lambda (b) (for-each (lambda (c)
 (for-each (lambda (d) (for-each (lambda (e) (for-each (lambda (f)
  (let* ((m (vector (vector a b c) (vector b d e) (vector c e f)))
         (det (+ (* a d f) (* 2 b c e) (- (* a e e)) (- (* d c c)) (- (* f b b))))
         (oracle (and (>= a 0) (>= d 0) (>= f 0)
                      (>= (- (* a d) (* b b)) 0) (>= (- (* a f) (* c c)) 0)
                      (>= (- (* d f) (* e e)) 0) (>= det 0)))
         (result (exact-psd-factor m)))
    (set! cases (+ cases 1))
    (if (not (eq? (psd-factor? result) oracle)) (set! all-ok #f))
    (if oracle
        (begin
          (set! positive (+ positive 1))
          (if (not (reconstructs? m result)) (set! all-ok #f))
          (for-each (lambda (x) (if (not (and (> x 0) (exact? x))) (set! all-ok #f)))
                    (vector->list (psd-factor-weights result))))
        (begin
          (set! negative (+ negative 1))
          (let ((v (psd-negative-direction result)))
            (if (not (and (vector? v) (< (energy m v) 0))) (set! all-ok #f))
            (for-each (lambda (x) (if (not (exact? x)) (set! all-ok #f))) (vector->list v)))))))
 '(-1 0 1))) '(-1 0 1))) '(-1 0 1))) '(-1 0 1))) '(-1 0 1))) '(-1 0 1))
(check "729 classifications and exact certificates match independent principal minors"
  (and all-ok (= cases 729) (> positive 0) (> negative 0)))
(define singular (vector (vector 1/2 1/2) (vector 1/2 1/2)))
(define factor (exact-psd-factor singular))
(check "rational singular factor has exact rank one"
  (and (psd-factor? factor) (= (vector-length (psd-factor-weights factor)) 1)
       (reconstructs? singular factor) (eq? (psd-negative-direction factor) #f)))
(define rows-copy (psd-factor-rows factor))
(define weights-copy (psd-factor-weights factor))
(vector-set! (vector-ref rows-copy 0) 0 99)
(vector-set! weights-copy 0 99)
(check "factor observations do not mutate retained data or input"
  (and (= (exact-matrix-ref singular 0 0) 1/2) (reconstructs? singular factor)))
(define indefinite (vector (vector 0 1) (vector 1 0)))
(define obstruction (exact-psd-factor indefinite))
(define negative-copy (psd-negative-direction obstruction))
(vector-set! negative-copy 0 0)
(vector-set! negative-copy 1 0)
(check "zero pivot coupling yields owned negative direction" (< (energy indefinite (psd-negative-direction obstruction)) 0))
(check "negative result refuses factor observation" (raises? (lambda () (psd-factor-rows obstruction))))
(check "zero matrix has rank zero" (= (vector-length (psd-factor-weights
  (exact-psd-factor (vector (vector 0 0) (vector 0 0))))) 0))
(check "empty matrix succeeds" (psd-factor? (exact-psd-factor (make-vector 0 0))))
(check "asymmetry refused" (raises? (lambda () (exact-psd-factor (vector (vector 1 2) (vector 0 1))))))
(check "rectangular refused" (raises? (lambda () (exact-psd-factor (vector (vector 1 2))))))
(check "inexact refused" (raises? (lambda () (exact-psd-factor (vector (vector 1.0))))))
(check "overflow never publishes a rounded certificate"
  (guard (e (else #t))
    (let* ((large 9223372036854775809) (m (vector (vector 2 large) (vector large 0)))
           (r (exact-psd-factor m)) (v (psd-negative-direction r)))
      (and (not (psd-factor? r)) (exact? (vector-ref v 0)) (exact? (vector-ref v 1))))))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: exact_psd_test") (newline)
(display "RESULT: PASS") (newline)
