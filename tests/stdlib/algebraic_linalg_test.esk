(require stdlib)
(require core.algebraic_linalg)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define matrix (vector (vector alpha 1) (vector 1 alpha)))
(define factor (algebraic-factor field matrix))
(define first (algebraic-factor-solve factor (vector 1 0)))
(define second (algebraic-factor-solve factor (vector 0 1)))
(check "irrational closed-form inverse column one"
  (and (algebraic-equal? (vector-ref first 0) alpha) (= (algebraic-rational (vector-ref first 1)) -1)))
(check "one factor reused for independent RHS"
  (and (= (algebraic-rational (vector-ref second 0)) -1) (algebraic-equal? (vector-ref second 1) alpha)))
(check "factor summary records one bottom factorization" (equal? (vector->list (algebraic-factor-summary factor)) '(2 0 1)))
(define swapped (algebraic-solve field (vector (vector 0 1) (vector 1 alpha)) (vector 1 0)))
(check "row permutation is applied to the RHS"
  (and (algebraic-equal? (vector-ref swapped 0) (algebraic-scale alpha -1))
       (= (algebraic-rational (vector-ref swapped 1)) 1)))
(define hilbert (algebraic-solve field
  (vector (vector 1 1/2 1/3) (vector 1/2 1/3 1/4) (vector 1/3 1/4 1/5)) (vector 1 1 1)))
(check "Hilbert inverse against independent integer formula"
  (equal? (map algebraic-rational (vector->list hilbert)) '(3 -24 30)))
(define context (make-algebraic-taylor field 4))
(define x (algebraic-ad-seed context 2))
(define jet-factor (algebraic-factor context (vector (vector x 1) (vector 1 x))))
(define jets (algebraic-factor-solve jet-factor (vector 1 0)))
(check "Taylor factor retains one bottom LU" (equal? (vector->list (algebraic-factor-summary jet-factor)) '(2 1 1)))
(for-each (lambda (sample)
  (let ((order (car sample)) (expected (cadr sample)))
    (check "Taylor inverse agrees with partial-fraction derivatives"
      (= (algebraic-rational (algebraic-ad-derivative (vector-ref jets 0) order)) expected))))
  '((0 2/3) (1 -5/9) (2 28/27) (4 976/81)))
(check "second Taylor solution fourth derivative"
  (= (algebraic-rational (algebraic-ad-derivative (vector-ref jets 1) 4)) -968/81))
(define hyper (make-algebraic-hyperdual field))
(define sum (algebraic-ad-value hyper '(3 1 1 0)))
(define hyper-answer (vector-ref (algebraic-solve hyper (vector (vector sum)) (vector 1)) 0))
(check "hyperdual cross coefficient recurrence"
  (equal? (map algebraic-rational (vector->list (algebraic-ad-coefficients hyper-answer))) '(1/3 -1/9 -1/9 2/27)))
(define nested (call-with-algebraic-derivative field
  (lambda (a lift-a)
    (call-with-algebraic-derivative (algebraic-ad-context a)
      (lambda (b lift-b)
        (call-with-algebraic-derivative (algebraic-ad-context b)
          (lambda (c lift-c)
            (let* ((ctx (algebraic-ad-context c))
                   (sum (algebraic-ad-add c (algebraic-ad-add (lift-c b) (lift-c (lift-b a)))))
                   (f (algebraic-factor ctx (vector (vector sum)))))
              (check "three levels still have one bottom factorization"
                (equal? (vector->list (algebraic-factor-summary f)) '(1 3 1)))
              (vector-ref (algebraic-factor-solve f (vector 1)) 0))) 3 2)) 2 2)) 1 2))
(check "three-level solve agrees with sixth mixed reciprocal derivative" (= (algebraic-rational nested) 5/1944))
(define product (algebraic-matrix-mul field matrix (vector (vector alpha -1) (vector -1 alpha))))
(check "matrix product checks the full inverse relation"
  (and (= (algebraic-rational (vector-ref (vector-ref product 0) 0)) 1)
       (algebraic-zero? (vector-ref (vector-ref product 0) 1))
       (algebraic-zero? (vector-ref (vector-ref product 1) 0))
       (= (algebraic-rational (vector-ref (vector-ref product 1) 1)) 1)))
(vector-set! (vector-ref matrix 0) 0 99)
(vector-set! (vector-ref (vector-ref first 0) 2) 0 88)
(check "factor and RHS results own storage"
  (algebraic-equal? (vector-ref (algebraic-factor-solve factor (vector 1 0)) 0) alpha))
(define domain (algebraic-domain context))
(define epsilon (algebraic-ad-seed context 0))
(check "nonzero nilpotent is not a unit"
  (and (not ((algebraic-domain-ref domain 'zero?) epsilon))
       (not ((algebraic-domain-ref domain 'unit?) epsilon))))
(define foreign (make-algebraic-field '(-3 0 1) 5 1))
(define sibling (make-algebraic-taylor field 4))
(for-each (lambda (thunk) (check "invalid matrix/domain/unit refuses" (raises? thunk)))
  (list
    (lambda () (algebraic-factor field (vector (vector 1 2) (vector 2 4))))
    (lambda () (algebraic-factor context (vector (vector epsilon))))
    (lambda () (algebraic-factor field (vector (vector 1) (vector 1 2))))
    (lambda () (algebraic-factor field (vector (vector 1 2))))
    (lambda () (algebraic-factor field (vector)))
    (lambda () (algebraic-factor field (vector (vector 1.0))))
    (lambda () (algebraic-factor-solve factor (vector 1)))
    (lambda () (algebraic-factor-solve factor (vector (algebraic-generator foreign) 0)))
    (lambda () (algebraic-factor-solve jet-factor (vector (algebraic-ad-seed sibling 2) 0)))
    (lambda () ((algebraic-domain-ref (algebraic-domain field) 'add)
      (algebraic-generator foreign) (algebraic-generator foreign)))
    (lambda () (algebraic-domain-ref domain 'unknown))))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
