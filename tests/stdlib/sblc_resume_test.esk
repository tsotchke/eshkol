(require stdlib)
(require core.sblc)
(define checks 0)
(define (check name ok)
  (set! checks (+ checks 1))
  (if (not ok) (begin (display "FAIL: ") (write name) (newline) (exit 1))))
(define (raises? thunk) (eq? 'raised (guard (e (else 'raised)) (thunk) 'returned)))
(define I (blc-lam (blc-var 1)))
(define K (blc-lam (blc-lam (blc-var 2))))
(define W (blc-lam (blc-app (blc-var 1) (blc-var 1))))
(define Omega (blc-app W W))
(define identity-examples (list (cons I I)))
(define (fresh seed L bound examples) (sblc-condition seed L bound examples))
(define (same-receipt a b) (string=? (sblc-receipt->string a) (sblc-receipt->string b)))
(define (entry bits receipt)
  (let loop ((es (sblc-receipt-programs receipt)))
    (if (null? es) #f
        (if (string=? bits (sblc-entry-bits (car es))) (car es) (loop (cdr es))))))
(define start (sblc-search-start 7 4 0 identity-examples))
(check 'unfinished-status (eq? 'unresolved (sblc-receipt-status (sblc-search-receipt start))))
(check 'zero-initial-work (equal? '(0 0) (sblc-search-work start)))
(define finished (sblc-search-resume start 1))
(check 'one-contraction (equal? '(1 1) (sblc-search-work finished)))
(check 'resolved-status (eq? 'consistent (sblc-receipt-status (sblc-search-receipt finished))))
(check 'resolved-equals-fresh (same-receipt (sblc-search-receipt finished) (fresh 7 4 1 identity-examples)))
(define complete (sblc-search-resume finished 9))
(check 'completed-trial-not-reduced-again (equal? '(0 1) (sblc-search-work complete)))
(check 'completed-equals-fresh (same-receipt (sblc-search-receipt complete) (fresh 7 4 9 identity-examples)))
(define same (sblc-search-resume start 0))
(check 'same-bound-zero-work (equal? '(0 0) (sblc-search-work same)))
(check 'same-bound-same-receipt (same-receipt (sblc-search-receipt same) (sblc-search-receipt start)))
(check 'original-handle-unchanged (eq? 'unresolved (sblc-receipt-status (sblc-search-receipt start))))
(check 'decreasing-bound-refuses (raises? (lambda () (sblc-search-resume complete 8))))
(check 'inexact-bound-refuses (raises? (lambda () (sblc-search-resume start 1.0))))
(check 'negative-bound-refuses (raises? (lambda () (sblc-search-resume start -1))))
(check 'invalid-seed-refuses (raises? (lambda () (sblc-search-start 1.0 4 0 identity-examples))))
(check 'invalid-catalogue-refuses (raises? (lambda () (sblc-search-start 7 -1 0 identity-examples))))
(check 'malformed-term-refuses (raises? (lambda () (sblc-search-start 7 4 0 (list (cons '(var 1 junk) I))))))
(define cyclic (list 'var 1))
(set-cdr! cyclic cyclic)
(check 'cyclic-input-refuses (raises? (lambda () (sblc-search-start 7 4 0 (list (cons cyclic I))))))
;; Example and receipt mutations cannot change a handle's captured computation.
(define mutable-examples (list (cons I I)))
(define owned (sblc-search-start 7 4 0 mutable-examples))
(set-car! (car mutable-examples) K)
(check 'example-snapshot
       (same-receipt (sblc-search-receipt (sblc-search-resume owned 1)) (fresh 7 4 1 identity-examples)))
(define published (sblc-search-receipt owned))
(string-set! (sblc-entry-bits (car (sblc-receipt-programs published))) 0 #\0)
(set-car! (sblc-receipt-programs published) 'damaged)
(check 'receipt-snapshot (same-receipt (sblc-search-receipt owned) (fresh 7 4 0 identity-examples)))
;; One branch has already finished; the other retains exactly half the mass.
(define partial-examples (list (cons (sblc-choice I Omega) I)))
(define partial (sblc-search-start 17 4 2 partial-examples))
(define partial-refined (sblc-search-resume partial 6))
(check 'completed-half-retained
       (equal? '(1/2) (sblc-entry-likelihoods (car (sblc-receipt-programs (sblc-search-receipt partial-refined))))))
(check 'unfinished-half-retained
       (equal? '(1/2) (sblc-entry-timeouts (car (sblc-receipt-programs (sblc-search-receipt partial-refined))))))
(check 'partial-equals-fresh
       (same-receipt (sblc-search-receipt partial-refined) (fresh 17 4 6 partial-examples)))
(check 'partial-fork-unchanged
       (same-receipt (sblc-search-receipt partial) (fresh 17 4 2 partial-examples)))
;; Repeated observations remain independent trials, each with probability 1/2.
(define repeated (list (cons I I) (cons I I)))
(define repeated-state (sblc-search-resume (sblc-search-start 19 14 0 repeated) 3))
(define repeated-entry (entry (sblc-encode (sblc-choice I K)) (sblc-search-receipt repeated-state)))
(check 'independent-likelihoods (equal? '(1/2 1/2) (sblc-entry-likelihoods repeated-entry)))
(check 'independent-product (= 1/4 (sblc-entry-likelihood repeated-entry)))
;; Cross budgets, catalogue sizes, discarded choices, contradictions and seeds.
(define panels
  (list identity-examples repeated (list (cons I K))
        (list (cons (blc-app I I) I) (cons I K))
        partial-examples '()))
(define fresh-work 0)
(define resumed-work 0)
(for-each
 (lambda (examples)
   (for-each
    (lambda (L)
      (let loop ((bound 0) (state (sblc-search-start 23 L 0 examples)))
        (if (<= bound 6)
            (let* ((receipt (sblc-search-receipt state))
                   (reference (fresh 23 L bound examples))
                   (restart (sblc-search-start 23 L bound examples)))
              (check 'resumed-equals-fresh (same-receipt receipt reference))
              (check 'resumed-cumulative-work-equals-one-fresh-run
                     (= (cadr (sblc-search-work state)) (cadr (sblc-search-work restart))))
              (set! fresh-work (+ fresh-work (car (sblc-search-work restart))))
              (set! resumed-work (+ resumed-work (car (sblc-search-work state))))
              (check 'nondecreasing-evidence
                     (>= (sblc-receipt-evidence receipt)
                         (if (= bound 0) 0
                             (sblc-receipt-evidence (fresh 23 L (- bound 1) examples)))))
              (loop (+ bound 1) (sblc-search-resume state (+ bound 1)))))))
    '(3 4 11 14)))
 panels)
(check 'resume-removes-prefix-transitions (< resumed-work fresh-work))
(display "SBLC RESUME work: ") (write (list resumed-work fresh-work)) (newline)
(display "SBLC RESUME checks: ") (display checks) (newline)
(display "SBLC RESUME RESULT: PASS") (newline)
