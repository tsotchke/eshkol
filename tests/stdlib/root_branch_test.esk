(require stdlib)
(require core.ad.root_branch)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (inside? box x) (and (<= (car box) x) (<= x (cdr box))))
;; Characteristic polynomial of symmetric A(t)=((t,1),(1,-t)). The selected
;; positive eigenvalue is sqrt(1+t^2), with no eigenvector normalization needed.
(define spectral-family (vector (vector -1 0 -1) (vector 0) (vector 1)))
(define initial (make-root-branch spectral-family 0 (cons 3/4 5/4)))
(check "exact selected start root" (equal? (root-branch-enclosure initial) (cons 1 1)))
(define first (root-branch-step initial 1/4 (cons 3/4 5/4)))
(define s1 (vector-ref first 0))
(check "whole first parameter interval verifies" (verify-root-branch-step initial s1 (vector-ref first 1)))
(define second (root-branch-step s1 1/2 (cons 3/4 3/2)))
(define s2 (vector-ref second 0))
(check "whole second interval verifies" (verify-root-branch-step s1 s2 (vector-ref second 1)))
(check "selected endpoint has correct algebraic signs" (let ((box (root-branch-enclosure s2)))
  (and (> (car box) 0) (<= (* (car box) (car box)) 5/4) (>= (* (cdr box) (cdr box)) 5/4))))
(check "certified sensitivity encloses algebraic formula" (let* ((box (root-branch-enclosure s2))
  (derivative (root-branch-sensitivity s2)))
  (and (<= (car derivative) (/ 1/2 (cdr box))) (>= (cdr derivative) (/ 1/2 (car box))))))
(check "old snapshot unchanged" (and (= (root-branch-time initial) 0)
  (equal? (root-branch-enclosure initial) (cons 1 1))))
(define negative (make-root-branch spectral-family 0 (cons -5/4 -3/4)))
(define negative-step (root-branch-step negative 1/4 (cons -5/4 -3/4)))
(check "negative branch remains distinct" (< (cdr (root-branch-enclosure (vector-ref negative-step 0))) 0))
(check "negative branch verifies" (verify-root-branch-step negative (vector-ref negative-step 0) (vector-ref negative-step 1)))
(define reversed (root-branch-step s2 0 (cons 3/4 3/2)))
(check "reverse parameter traversal" (let ((box (root-branch-enclosure (vector-ref reversed 0))))
  (and (inside? box 1) (<= (- (cdr box) (car box)) 3/16384))))
(check "reverse step verifies" (verify-root-branch-step s2 (vector-ref reversed 0) (vector-ref reversed 1)))
(define forged (vector-copy (vector-ref first 1))) (vector-set! forged 6 0)
(check "edited contraction receipt refuses" (not (verify-root-branch-step initial s1 forged)))
(define wrong (vector-copy s1)) (vector-set! wrong 3 (cons 2 2))
(check "wrong endpoint refuses" (not (verify-root-branch-step initial wrong (vector-ref first 1))))
(check "unconnected tube refuses" (raises? (lambda () (root-branch-step initial 1/4 (cons 2 3)))))
;; Both endpoints have a simple positive root 1/2. The parameter interval
;; contains t=1/2, where x^2-(t-1/2)^2 has a double root. Checking endpoints
;; alone would admit a step whose branch identity is unresolved in the middle.
(define collision-family (vector (vector -1/4 1 -1) (vector 0) (vector 1)))
(define collision-start (make-root-branch collision-family 0 (cons 1/4 3/4)))
(define collision-end (make-root-branch collision-family 1 (cons 1/4 3/4)))
(check "endpoint-only fixtures each select a simple root" (and
  (equal? (root-branch-enclosure collision-start) (cons 1/2 1/2))
  (equal? (root-branch-enclosure collision-end) (cons 1/2 1/2))))
(check "interior collision refuses entire step" (raises? (lambda ()
  (root-branch-step collision-start 1 (cons 1/4 3/4)))))
(check "singular root constructor refuses" (raises? (lambda ()
  (make-root-branch collision-family 1/2 (cons 0 0)))))
;; Original non-dyadic model coefficients, independent exact moving root.
(define linear-family (vector (vector -1/3 -2/5) (vector 1)))
(define linear (make-root-branch linear-family 0 (cons 0 1)))
(define linear-step (root-branch-step linear 1 (cons 0 1)))
(check "rational moving root enclosed" (inside? (root-branch-enclosure (vector-ref linear-step 0)) 11/15))
(check "linear branch exact derivative" (equal? (root-branch-sensitivity (vector-ref linear-step 0)) (cons 2/5 2/5)))
(check "linear whole interval verifies" (verify-root-branch-step linear (vector-ref linear-step 0) (vector-ref linear-step 1)))
(define observed (root-branch-enclosure s1)) (set-car! observed 99)
(check "enclosure observer owns its pair" (< (car (root-branch-enclosure s1)) 2))
(vector-set! (vector-ref spectral-family 0) 0 999)
(check "caller family mutation cannot alter branch" (equal? (root-branch-enclosure initial) (cons 1 1)))
(check "later steps retain owned family" (verify-root-branch-step initial s1 (vector-ref first 1)))
(for-each (lambda (f) (check "invalid inputs refuse" (raises? f)))
  (list (lambda () (make-root-branch (vector (vector 1) (vector 0)) 0 (cons 0 1)))
        (lambda () (make-root-branch linear-family 0.0 (cons 0 1)))
        (lambda () (make-root-branch linear-family 0 (cons 1 0)))
        (lambda () (root-branch-step linear 1 (cons 0 1) 65))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
