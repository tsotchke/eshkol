(require stdlib) (require core.sblc)
(define I (blc-lam (blc-var 1)))
(define K (blc-lam (blc-lam (blc-var 2))))
(define W (blc-lam (blc-app (blc-var 1) (blc-var 1))))
(define Omega (blc-app W W))
(define panels (list I (sblc-choice I K) (sblc-choice Omega I)
                    (blc-app (blc-app K I) (sblc-choice Omega K))
                    (blc-app (sblc-choice I K) (sblc-choice K I))
                    (sblc-choice (sblc-choice I K) (sblc-choice K I))))
(define cases 0)
(for-each (lambda (term)
  (for-each (lambda (seed)
    (for-each (lambda (bound)
      (let* ((a (sblc-sample term seed bound)) (b (sblc-sample term seed bound)))
        (if (not (equal? a b)) (exit 1))
        (write (list seed bound (sblc-run-status a) (sblc-encode (sblc-run-term a))
                     (sblc-run-beta a) (sblc-run-coins-used a) (sblc-run-trace a))) (newline)
        (set! cases (+ cases 1)))) '(0 1 2 3 6))) '(0 7 -1 1099511627783))) panels)
(for-each (lambda (seed)
  (let* ((coins (sblc-coins-from-prng (make-prng seed)))
         (first (coins)) (second ((cdr first)))
         (sample (sblc-sample-prng (make-prng seed) (sblc-choice I K) 3))
         (raw (sblc-sample-program (make-prng seed) 14))
         (closed (sblc-sample-closed-program (make-prng seed) 14))
         (receipt (sblc-condition seed 4 3 (list (cons I I)))))
    (if (or (not (sblc-closed? closed))
            (not (string=? (sblc-run-trace sample) (sblc-run-trace (sblc-sample (sblc-choice I K) seed 3))))
            (not (eq? (sblc-receipt-status receipt) 'consistent))) (exit 1))
    (write (list 'api seed (car first) (car second) sample
                 (if raw (sblc-encode raw) #f) (sblc-encode closed)
                 (sblc-receipt->string receipt))) (newline))) '(0 7 -1 1099511627783))
(display "SBLC RNG API panels: 4") (newline)
(display "SBLC RNG cases: ") (display cases) (newline)
(display "SBLC RNG RESULT: PASS") (newline)
