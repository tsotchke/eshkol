(require stdlib)
(require core.ad.algebraic_subspace)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define d (algebraic-domain field))
(define same? (algebraic-domain-ref d 'equal?))
(define add (algebraic-domain-ref d 'add))
(define mul (algebraic-domain-ref d 'mul))
(define (matrix=? a b)
  (let rows ((i 0)) (or (= i (vector-length a))
    (and (let cols ((j 0)) (or (= j (vector-length a))
      (and (same? (vector-ref (vector-ref a i) j) (vector-ref (vector-ref b i) j)) (cols (+ j 1)))))
      (rows (+ i 1))))))
(define (dot a b)
  (let rows ((i 0) (out 0))
    (if (= i (vector-length a)) out
      (rows (+ i 1) (let cols ((j 0) (out out))
        (if (= j (vector-length a)) out
          (cols (+ j 1) (add out (mul (vector-ref (vector-ref a i) j) (vector-ref (vector-ref b i) j))))))))))
(define p (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 0)))
(define expected (vector (vector 0 0 -2) (vector 0 0 3) (vector -2 3 0)))
(define seed (vector (vector 1 2 3) (vector 4 5 6) (vector 7 8 9)))
(define last #f)
(for-each (lambda (t)
  (let* ((a (vector (vector (+ 1 t) 0 0) (vector 0 (- 1 t) 0) (vector 0 0 4)))
         (h (vector (vector 1 0 (- 6 (* 2 t))) (vector 0 -1 (- -9 (* 3 t)))
                    (vector (- 6 (* 2 t)) (- -9 (* 3 t)) 0)))
         (subspace (make-algebraic-subspace field a p))
         (dp (algebraic-subspace-jvp subspace h))
         (cotangent (algebraic-subspace-vjp subspace seed)))
    (check "internal eigenvalue crossing preserves a certified rank-two space" (= (vector-ref (algebraic-subspace-info subspace) 1) 2))
    (check "independent infinitesimal rotation projector derivative" (matrix=? dp expected))
    (check "source-bound linearized identities verify" (verify-algebraic-subspace-jvp field a p h dp))
    (check "JVP VJP pairing uses symmetric parameterization" (same? (dot seed dp) (dot cotangent h)))
    (set! last subspace))) '(-1 0 1))
;; A rational orthogonal basis change gives a dense projector without sqrt.
(define rotation (vector (vector 3/5 0 4/5) (vector 0 1 0) (vector -4/5 0 3/5)))
(define transpose (vector (vector 3/5 0 -4/5) (vector 0 1 0) (vector 4/5 0 3/5)))
(define (rotate a) (algebraic-matrix-mul field (algebraic-matrix-mul field rotation a) transpose))
(define a0 (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 4)))
(define h0 (vector (vector 0 0 6) (vector 0 0 -9) (vector 6 -9 0)))
(define dense (make-algebraic-subspace field (rotate a0) (rotate p)))
(check "basis covariance of projector" (matrix=? (algebraic-subspace-projector dense) (rotate p)))
(check "basis covariance of derivative" (matrix=? (algebraic-subspace-jvp dense (rotate h0)) (rotate expected)))
(define complement (vector (vector 0 0 0) (vector 0 0 0) (vector 0 0 1)))
(define cspace (make-algebraic-subspace field a0 complement))
(check "complement derivative is negative" (matrix=? (algebraic-subspace-jvp cspace h0)
  (vector (vector 0 0 2) (vector 0 0 -3) (vector 2 -3 0))))
(define owned (algebraic-subspace-projector dense))
(vector-set! (vector-ref owned 0) 0 999)
(check "projector observation is independently owned" (matrix=? (algebraic-subspace-projector dense) (rotate p)))
(define source-a (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 4)))
(define source-p (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 0)))
(define frozen (make-algebraic-subspace field source-a source-p))
(vector-set! (vector-ref source-a 0) 0 99)
(vector-set! (vector-ref source-p 0) 0 99)
(check "constructor owns source matrix and projector" (matrix=? (algebraic-subspace-jvp frozen h0) expected))
(define wrong (vector (vector 0 0 1) (vector 0 0 0) (vector 1 0 0)))
(check "forged derivative fails exact equations" (not (verify-algebraic-subspace-jvp field a0 p h0 wrong)))
(check "external spectral collision refuses" (raises? (lambda ()
  (make-algebraic-subspace field (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 1)) p))))
(check "invariant but unseparated selected space refuses" (raises? (lambda ()
  (make-algebraic-subspace field (vector (vector 1 0 0) (vector 0 2 0) (vector 0 0 1)) p))))
(check "noninvariant projector refuses" (raises? (lambda ()
  (make-algebraic-subspace field h0 p))))
(check "nonidempotent symmetric matrix refuses" (raises? (lambda ()
  (make-algebraic-subspace field a0 (vector (vector 1 0 0) (vector 0 1/2 0) (vector 0 0 0))))))
(check "nonsymmetric direction refuses" (raises? (lambda ()
  (algebraic-subspace-jvp frozen (vector (vector 0 0 1) (vector 0 0 0) (vector 0 0 0))))))
(check "inexact matrix refuses" (raises? (lambda ()
  (make-algebraic-subspace field (vector (vector 1.0 0) (vector 0 2)) (vector (vector 1 0) (vector 0 0))))))
(check "trivial full-space projector refuses" (raises? (lambda ()
  (make-algebraic-subspace field a0 (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 1))))))
(define context (make-algebraic-taylor field 2))
(define t (algebraic-ad-seed context 0))
(define at (vector (vector (algebraic-ad-add (algebraic-ad-constant context 1) t) 0 0)
                  (vector 0 (algebraic-ad-sub (algebraic-ad-constant context 1) t) 0) (vector 0 0 4)))
(define nested (make-algebraic-subspace context at p))
(define nested-dp (algebraic-subspace-jvp nested h0))
(define entry (vector-ref (vector-ref nested-dp 0) 2))
(for-each (lambda (order expected)
  (check "enclosing Taylor derivatives of subspace sensitivity" (= (algebraic-rational
    (algebraic-ad-derivative entry order)) expected))) '(0 1 2) '(-2 -2/3 -4/9))
(check "nested full-coefficient tangent equations verify" (verify-algebraic-subspace-jvp context at p h0 nested-dp))
(define a4 (vector (vector 0 0 0 0) (vector 0 0 0 0) (vector 0 0 4 0) (vector 0 0 0 4)))
(define p4 (vector (vector 1 0 0 0) (vector 0 1 0 0) (vector 0 0 0 0) (vector 0 0 0 0)))
(define h4 (vector (vector 0 0 4 8) (vector 0 0 12 16) (vector 4 12 0 0) (vector 8 16 0 0)))
(define space4 (make-algebraic-subspace field a4 p4))
(check "maximum size with degeneracy in both blocks" (matrix=? (algebraic-subspace-jvp space4 h4)
  (vector (vector 0 0 -1 -2) (vector 0 0 -3 -4) (vector -1 -3 0 0) (vector -2 -4 0 0))))
(define alpha (algebraic-generator field))
(define irrational-a (vector (vector alpha 0 0) (vector 0 alpha 0) (vector 0 0 (mul 3 alpha))))
(define irrational-space (make-algebraic-subspace field irrational-a p))
(define irrational-dp (algebraic-subspace-jvp irrational-space
  (vector (vector 0 0 1) (vector 0 0 0) (vector 1 0 0))))
(check "irrational spectral separation stays exact" (same? (vector-ref (vector-ref irrational-dp 0) 2) (mul -1/4 alpha)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
