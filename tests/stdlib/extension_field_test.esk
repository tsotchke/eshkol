(require core.extension_field)
(define passed 0)
(define (check label value)
  (if (not value) (error "extension-field assertion failed" label))
  (set! passed (+ passed 1)))
(define (refuses? thunk) (guard (e (else #t)) (thunk) #f))
(define fields (list (list 2 '(1 1 1)) (list 3 '(1 0 1))
                     (list 2 '(1 1 0 0 1)) (list 5 '(2 0 1))))
(for-each (lambda (spec)
  (let* ((F (make-extension-field (car spec) (cadr spec)))
         (q (extension-order F)) (m (extension-degree F)) (p (extension-prime F)))
    (let outer ((i 0))
      (if (< i q)
          (let ((a (extension-index->element F i)))
            (check 'index-roundtrip (= i (extension-element->index F a)))
            (check 'frobenius-cycle (r= F a (extension-frobenius F a m)))
            (if (> i 0) (check 'inverse (r-one? F (r* F a (r-inv F a)))))
            (let inner ((j 0))
              (if (< j q)
                  (let* ((b (extension-index->element F j)) (sum (r+ F a b)) (product (r* F a b)))
                    (display "PAIR ") (write (list p m i j (extension-element->index F sum)
                                                   (extension-element->index F product))) (newline)
                    (check 'frobenius-add (r= F (extension-frobenius F sum)
                                               (r+ F (extension-frobenius F a) (extension-frobenius F b))))
                    (inner (+ j 1)))))
            (display "MINPOLY ") (write (list p m i (extension-minimal-polynomial F a))) (newline)
            (outer (+ i 1))))))) fields)
(define A (make-extension-field 2 '(1 1 0 1 1 0 0 0 1)))
(define a (extension-index->element A 87))
(define b (extension-index->element A 131))
(check 'aes-product (= 193 (extension-element->index A (r* A a b))))
(check 'integer-map (r-zero? A (r-int A 2)))
(check 'index-is-not-integer-map (not (r-zero? A (extension-index->element A 2))))
(define J (make-jets A 3))
(define t (jet-seed J a))
(define square (r* J t t))
(check 'jet-value (r= A (jet-coefficient square 0) (r* A a a)))
(check 'jet-characteristic-two (r-zero? A (jet-coefficient square 1)))
(check 'jet-second (r-one? A (jet-coefficient square 2)))
(check 'determinant (r= A (ring-det A (list (list a b) (list (r1 A) (r0 A)))) (r-neg A b)))
(check 'minimal-aes (equal? (extension-minimal-polynomial A (extension-index->element A 2)) '(1 1 0 1 1 0 0 0 1)))
(for-each (lambda (spec) (check 'bad-field (refuses? (lambda () (make-extension-field (car spec) (cadr spec))))))
          (list (list 4 '(1 1 1)) (list 1 '(1 1)) (list 2 '(1 0 1))
                (list 3 '(1 2 1)) (list 3 '(1 1 2)) (list 2 '(1 1.0 1))
                (list 2 '()) (list 2 '(1))))
(check 'zero-inverse (refuses? (lambda () (r-inv A (r0 A)))))
(check 'wrong-field (refuses? (lambda () (r+ A a (extension-index->element (make-extension-field 2 '(1 1 1)) 1)))))
(check 'negative-index (refuses? (lambda () (extension-index->element A -1))))
(check 'oversized-index (refuses? (lambda () (extension-index->element A 256))))
(check 'inexact-element (refuses? (lambda () (extension-element A '(1.0)))))
(check 'wrong-width (refuses? (lambda () (extension-element A '(0 0 0 0 0 0 0 0 1)))))
(check 'negative-frobenius (refuses? (lambda () (extension-frobenius A a -1))))
(define supplied (list 1 1 1))
(define owned (make-extension-field 2 supplied))
(set-car! supplied 0)
(check 'owned-modulus (equal? (extension-modulus owned) '(1 1 1)))
(define returned (extension-modulus owned))
(set-car! returned 0)
(check 'fresh-modulus (equal? (extension-modulus owned) '(1 1 1)))
(define input (list 1 1))
(define element (extension-element owned input))
(set-car! input 0)
(check 'owned-coefficients (equal? (extension-coefficients owned element) '(1 1)))
(display "PASS extension_field ") (display passed) (newline)
