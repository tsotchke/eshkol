(require core.compiler.mix)
(require core.compiler.mix.verify)
(define checks 0)
(define (check name ok)
  (set! checks (+ checks 1))
  (if (not ok) (begin (display "FAIL: ") (write name) (newline) (exit 1))))
(define budget (mix-verification-limits 100000 64 256 300000))
(define runtime-budget (mix-limits 20000000 4096 2000000 300000))
(define (artifact p inputs) (vector 'mix-result-v1 'normal p 0 0 inputs 'untrusted-origin))
(define (verify p statics q inputs)
  (mix-verify-specialization p statics (artifact q inputs) budget))
(define (expect label p statics q inputs status)
  (check label (eq? status (mix-verification-status (verify p statics q inputs)))))
(define id '(program () (var x)))
(define square '(program () (prim * (var x) (var x))))
(define expanded '(program () (prim + (prim * (var x) (var x))
                                        (prim + (prim * 2 (var x)) 1))))
(define factored '(program () (prim * (prim + (var x) 1) (prim + 1 (var x)))))
(expect 'identity id '() id '(x) 'equivalent)
(expect 'factorization expanded '() factored '(x) 'equivalent)
(expect 'difference square '() id '(x) 'different)
(expect 'static-first-binding '(program () (prim + (var x) (var k))) '((k . 3) (k . 99))
        '(program () (prim + 3 (var x))) '(x) 'equivalent)
(expect 'sequential-shadow '(program () (let ((x (prim + (var x) 1)) (x (prim * (var x) 2))) (var x))) '()
        '(program () (prim + (prim * 2 (var x)) 2)) '(x) 'equivalent)
(expect 'closed-function-scope
        '(program ((f (x) (prim + (var x) 1))) (let ((x 100)) (call f (var y)))) '()
        '(program () (prim + (var y) 1)) '(y) 'equivalent)
(expect 'acyclic-calls '(program ((f (a) (call g (var a))) (g (b) (prim * (var b) (var b)))) (call f (var x))) '()
        square '(x) 'equivalent)
(expect 'structured-function-name '(program (((residual f 1) (x) (prim + (var x) 1))) (call (residual f 1) (var x))) '()
        '(program () (prim + 1 (var x))) '(x) 'equivalent)
(expect 'two-variables '(program () (prim * (prim + (var x) (var y)) (prim - (var x) (var y)))) '()
        '(program () (prim - (prim * (var x) (var x)) (prim * (var y) (var y)))) '(x y) 'equivalent)
(expect 'cancellation-keeps-input id '()
        '(program () (prim + (var x) (prim - (var y) (var y)))) '(x) 'unknown)
(expect 'erased-input-contract '(program () (prim - (var x) (var x))) '() '(program () 0) '(x) 'equivalent)
(expect 'erased-input-missing '(program () (prim - (var x) (var x))) '() '(program () 0) '() 'unknown)
(expect 'extra-input id '() id '(x y) 'unknown)
(expect 'duplicate-input id '() id '(x x) 'unknown)
(expect 'quoted-integer '(program () (quote 7)) '() '(program () 7) '() 'equivalent)
(expect 'large-exact '(program () (prim * 4294967296 (var x))) '()
        '(program () (prim + (prim * 4294967295 (var x)) (var x))) '(x) 'equivalent)
(expect 'constant-zero '(program () (prim * 0 123)) '() '(program () 0) '() 'equivalent)
(expect 'constant-mismatch '(program () 7) '() '(program () 8) '() 'different)
(expect 'conditional '(program () (if (prim < (var x) 0) 0 1)) '() id '(x) 'unknown)
(expect 'modulo '(program () (prim mod (var x) 2)) '() id '(x) 'unknown)
(expect 'shift '(program () (prim shr (var x) 1)) '() id '(x) 'unknown)
(expect 'noninteger-static '(program () (var k)) '((k . false)) '(program () 0) '() 'unknown)
(expect 'noninteger-quote '(program () (quote false)) '() '(program () 0) '() 'unknown)
(expect 'strict-unused-binding '(program () (let ((unused (prim mod (var x) 2))) 0)) '() '(program () 0) '(x) 'unknown)
(expect 'strict-zero-multiplication '(program () (prim * 0 (prim mod (var x) 2))) '() '(program () 0) '(x) 'unknown)
(expect 'strict-unused-argument '(program ((f (a) 0)) (call f (prim mod (var x) 2))) '() '(program () 0) '(x) 'unknown)
(expect 'recursion '(program ((f (x) (call f (var x)))) (call f (var x))) '() id '(x) 'unknown)
(expect 'mutual-recursion '(program ((f (x) (call g (var x))) (g (x) (call f (var x)))) (call f (var x))) '()
        id '(x) 'unknown)
(expect 'malformed-source '(program () (prim + 1)) '() '(program () 1) '() 'unknown)
(expect 'malformed-residual id '() '(program () (prim + 1)) '(x) 'unknown)
(expect 'inexact-data '(program () (quote 1.5)) '() '(program () 1) '() 'unknown)
(check 'invalid-result
       (eq? 'unknown (mix-verification-status (mix-verify-specialization id '() (vector 'bad) budget))))
(check 'refused-result
       (eq? 'unknown (mix-verification-status
                     (mix-verify-specialization id '() (vector 'mix-result-v1 'work-bound id 0 0 '(x) '()) budget))))
(define actual-source '(program () (prim + (prim * (var x) (var x)) (var k))))
(define actual (mix-specialize actual-source '((k . 4)) (mix-options 256 512) runtime-budget))
(check 'real-specializer-normal (eq? 'normal (mix-result-status actual)))
(check 'real-specialization-equivalent
       (eq? 'equivalent (mix-verification-status
                        (mix-verify-specialization actual-source '((k . 4)) actual budget))))
;; A counterfeit origin is irrelevant: the claimed residual must still agree.
(check 'counterfeit-origin-refuses
       (eq? 'different (mix-verification-status
                       (mix-verify-specialization actual-source '((k . 4))
                         (vector 'mix-result-v1 'normal '(program () 0) 0 0 '(x) (vector-ref actual 6)) budget))))
;; This counterfeit agrees at every point in the old [-7,7] sample battery.
(define vanishing
  (let loop ((k -7) (e 1))
    (if (> k 7) e (loop (+ k 1) (list 'prim '* e (list 'prim '- '(var x) k))))))
(define counterfeit (list 'program '() (list 'prim '+ '(var x) vanishing)))
(let loop ((x -7))
  (if (<= x 7)
      (begin
        (check 'sample-battery-misses-counterfeit
               (= x (mix-result-value (mix-run counterfeit (list (cons 'x x)) runtime-budget))))
        (loop (+ x 1)))))
(expect 'polynomial-checker-catches-counterfeit id '() counterfeit '(x) 'different)
(define (bound name limits expected-reason)
  (let ((r (mix-verify-specialization expanded '() (artifact factored '(x)) limits)))
    (check name (and (eq? 'unknown (mix-verification-status r))
                     (eq? expected-reason (mix-verification-reason r))))))
(bound 'work-bound (mix-verification-limits 0 64 256 300000) 'work-bound)
(bound 'depth-bound (mix-verification-limits 100000 0 256 300000) 'depth-bound)
(bound 'term-product-bound (mix-verification-limits 100000 64 2 300000) 'term-bound)
(bound 'data-bound (mix-verification-limits 100000 64 256 1) 'data-bound)
(bound 'profile-cap (mix-verification-limits 100000 129 256 300000) 'invalid-limits)
(define cyclic (list 'var 'x))
(set-cdr! cyclic cyclic)
(check 'cyclic-abi
       (eq? 'unknown (mix-verification-status
                     (mix-verify-specialization id '() (artifact id cyclic)
                                                (mix-verification-limits 1000 32 32 1000)))))
(expect 'identical-unsupported '(program () (prim mod (var x) 2)) '()
        '(program () (prim mod (var x) 2)) '(x) 'unknown)
(expect 'reordered-abi '(program () (prim + (var x) (var y))) '()
        '(program () (prim + (var x) (var y))) '(y x) 'unknown)
(expect 'improper-abi id '() id '(x . 1) 'unknown)
(define (squaring-program seed count)
  (list 'program '()
        (list 'let (cons (list 'p seed)
                         (let loop ((n count))
                           (if (= n 0) '()
                               (cons '(p (prim * (var p) (var p))) (loop (- n 1)))))) '(var p))))
(expect 'coefficient-profile (squaring-program 2 12) '() '(program () 0) '() 'unknown)
(expect 'degree-profile (squaring-program '(var x) 20) '() id '(x) 'unknown)
(check 'different-reason
       (eq? 'polynomial-difference (mix-verification-reason (verify square '() id '(x)))))
(display "MIX VERIFY checks: ") (display checks) (newline)
(display "MIX VERIFY RESULT: PASS") (newline)
