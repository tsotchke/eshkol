(require stdlib)
(require core.algebraic_field)
(require core.exact_linalg)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (power a n)
  (let loop ((i n) (out (algebraic-element (vector-ref a 1) 1)))
    (if (= i 0) out (loop (- i 1) (algebraic-mul out a)))))
(define (multiplication-matrix field a)
  (let* ((n (algebraic-field-degree field)) (m (make-vector n #f)) (x (algebraic-generator field)))
    (let rows ((i 0))
      (if (< i n) (begin (vector-set! m i (make-vector n 0)) (rows (+ i 1)))))
    (let columns ((j 0) (basis (algebraic-element field 1)))
      (if (< j n)
          (let ((coeff (algebraic-coefficients (algebraic-mul a basis))))
            (let copy ((i 0))
              (if (< i n) (begin (vector-set! (vector-ref m i) j (vector-ref coeff i)) (copy (+ i 1)))))
            (columns (+ j 1) (algebraic-mul basis x))))) m))
(for-each (lambda (fixture)
  (let* ((degree (car fixture)) (prime (cadr fixture)) (index (caddr fixture))
         (coeff (make-vector (+ degree 1) 0)))
    (vector-set! coeff 0 -2) (vector-set! coeff degree 1)
    (let* ((field (make-algebraic-field coeff prime index)) (x (algebraic-generator field))
           (one (algebraic-element field 1)) (a (algebraic-add x (algebraic-element field 2)))
           (b (algebraic-sub (algebraic-mul x x) one))
           (rhs (make-vector degree 0)))
      (vector-set! rhs 0 1)
      (check "generator satisfies defining polynomial exactly" (= (algebraic-rational (power x degree)) 2))
      (check "exact field inverse" (algebraic-equal? (algebraic-mul a (algebraic-inverse a)) one))
      (check "field distributivity" (algebraic-equal?
        (algebraic-mul a (algebraic-add b x)) (algebraic-add (algebraic-mul a b) (algebraic-mul a x))))
      (check "Euclid inverse equals independent Gaussian solve" (equal?
        (vector->list (algebraic-coefficients (algebraic-inverse a)))
        (vector->list (exact-solve (multiplication-matrix field a) rhs))))
      (check "exact cancellation" (algebraic-zero? (algebraic-sub a a)))
      (check "rational scaling remains exact" (let ((v (algebraic-coefficients (algebraic-scale a 1/3))))
        (let loop ((i 0)) (or (= i degree) (and (exact? (vector-ref v i)) (loop (+ i 1))))))))))
 '((2 3 1) (3 7 0) (4 5 1) (5 11 0)))

(define source (vector -2 0 1))
(define positive (make-algebraic-field source 3 1))
(define negative (make-algebraic-field '(-2 0 1) 3 0))
(define x (algebraic-generator positive))
(define minus-x (algebraic-generator negative))
(check "certified positive/negative conjugate signs" (and (= (algebraic-sign x) 1) (= (algebraic-sign minus-x) -1)))
(check "certified comparisons with rational neighbours" (and
  (= (algebraic-sign (algebraic-sub x (algebraic-element positive 7/5))) 1)
  (= (algebraic-sign (algebraic-sub x (algebraic-element positive 3/2))) -1)))
(check "exact zero decided without refinement" (= (algebraic-sign (algebraic-sub x x) 0) 0))
(check "enclosure narrows and remains certified"
  (let ((bounds (algebraic-enclosure x 12)))
    (and (< (car bounds) (cadr bounds)) (> (car bounds) 0)
         (< (* (car bounds) (car bounds)) 2) (> (* (cadr bounds) (cadr bounds)) 2)
         (< (- (cadr bounds) (car bounds)) 1/1000))))
(check "budget exhaustion refuses rather than reports zero" (raises? (lambda ()
  (algebraic-sign (algebraic-sub x (algebraic-element positive 1)) 0))))
(check "wrong conjugate embedding refused" (raises? (lambda () (make-algebraic-embedding positive negative minus-x))))
(define transport (make-algebraic-embedding positive negative (algebraic-scale minus-x -1)))
(check "checked transport preserves selected real embedding" (algebraic-equal? (transport x) (algebraic-scale minus-x -1)))
(check "checked transport preserves products" (algebraic-equal?
  (transport (algebraic-mul x x)) (algebraic-mul (transport x) (transport x))))
(check "untransported foreign fields refused" (raises? (lambda () (algebraic-add x minus-x))))
(check "foreign source argument to transport refused" (raises? (lambda () (transport minus-x))))
(check "incorrect polynomial image refused" (raises? (lambda () (make-algebraic-embedding positive negative (algebraic-element negative 1)))))
(vector-set! source 0 99)
(define observed (algebraic-coefficients x))
(vector-set! observed 1 99)
(define polynomial-copy (algebraic-field-polynomial positive))
(vector-set! polynomial-copy 0 99)
(check "constructor and observers own coefficient storage" (and
  (= (algebraic-rational (algebraic-mul x x)) 2)
  (= (vector-ref (algebraic-coefficients x) 1) 1)
  (= (vector-ref (algebraic-field-polynomial positive) 0) -2)))
(check "composite prime witness refused" (raises? (lambda () (make-algebraic-field '(-2 0 1) 9 0))))
(check "bad prime reduction refused" (raises? (lambda () (make-algebraic-field '(-2 0 1) 2 0))))
(check "reducible polynomial refused" (raises? (lambda () (make-algebraic-field '(-1 0 1) 3 0))))
(check "no real root refused" (raises? (lambda () (make-algebraic-field '(1 0 1) 3 0))))
(check "out-of-range root refused" (raises? (lambda () (make-algebraic-field '(-2 0 1) 3 2))))
(check "inexact coefficients refused" (raises? (lambda () (algebraic-element positive '(0 0.5)))))
(check "zero inverse refused" (raises? (lambda () (algebraic-inverse (algebraic-element positive 0)))))
(define three-negative (make-algebraic-field '(1 -3 0 1) 2 0))
(define three-positive (make-algebraic-field '(1 -3 0 1) 2 2))
(check "automatic selection among three irrational real roots" (and
  (= (algebraic-sign (algebraic-generator three-negative)) -1)
  (= (algebraic-sign (algebraic-generator three-positive)) 1)))

;; Independent irreducibility oracle: enumerate products of all proper monic
;; factor pairs over F2/F3, without Euclid or Frobenius. Lift the constant term
;; to a negative integer so every tested Q-polynomial has a real root.
(define (small-power base exponent)
  (let loop ((n exponent) (out 1)) (if (= n 0) out (loop (- n 1) (* out base)))))
(define (small-monic code degree prime)
  (let ((out (make-vector (+ degree 1) 0)))
    (vector-set! out degree 1)
    (let fill ((i 0) (value code))
      (if (< i degree)
          (begin (vector-set! out i (modulo value prime)) (fill (+ i 1) (quotient value prime))))) out))
(define (small-product a b prime)
  (let ((out (make-vector (- (+ (vector-length a) (vector-length b)) 1) 0)))
    (let rows ((i 0))
      (if (< i (vector-length a))
          (begin
            (let cols ((j 0))
              (if (< j (vector-length b))
                  (begin (vector-set! out (+ i j)
                    (modulo (+ (vector-ref out (+ i j)) (* (vector-ref a i) (vector-ref b j))) prime))
                    (cols (+ j 1)))))
            (rows (+ i 1)))))
    (vector->list out)))
(define certificate-oracle-ok #t)
(define certificate-cases 0)
(define certificate-admitted 0)
(for-each (lambda (prime)
  (for-each (lambda (degree)
    (let ((reducibles '()))
      (let factor-degrees ((k 1))
        (if (<= k (quotient degree 2))
            (begin
              (let left-factors ((a 0))
                (if (< a (small-power prime k))
                    (begin
                      (let right-factors ((b 0))
                        (if (< b (small-power prime (- degree k)))
                            (begin (set! reducibles (cons
                              (small-product (small-monic a k prime) (small-monic b (- degree k) prime) prime)
                              reducibles)) (right-factors (+ b 1)))))
                      (left-factors (+ a 1)))))
              (factor-degrees (+ k 1)))))
      (let polynomials ((code 0))
        (if (< code (small-power prime degree))
            (let* ((p (small-monic code degree prime))
                   (expected (not (member (vector->list p) reducibles))))
              (vector-set! p 0 (- (vector-ref p 0) (* 2 prime)))
              (let ((admitted (guard (e (else #f)) (make-algebraic-field p prime 0) #t)))
                (set! certificate-cases (+ certificate-cases 1))
                (if admitted (set! certificate-admitted (+ certificate-admitted 1)))
                (if (not (eq? admitted expected)) (set! certificate-oracle-ok #f)))
              (polynomials (+ code 1))))))) '(2 3 4))) '(2 3))
(check "145 prime-certificate decisions match independent factor enumeration"
  (and certificate-oracle-ok (= certificate-cases 145) (= certificate-admitted 35)))
(check "reducible polynomial without linear modular factors refused" (raises? (lambda ()
  (make-algebraic-field '(6 0 -5 0 1) 5 0))))
(check "repeated irreducible modular factors refused" (raises? (lambda ()
  (make-algebraic-field '(4 0 -4 0 1) 3 0))))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: algebraic_field_test") (newline)
(display "RESULT: PASS") (newline)
