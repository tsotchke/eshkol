(require stdlib)
(require core.sblc.relax)

(define checks 0)
(define (check label value)
  (set! checks (+ 1 checks))
  (if (not value) (begin (display "FAIL: ") (write label) (newline) (exit 1))))
(define (near a b tol) (< (abs (- a b)) tol))
(define (vector-distance a b)
  (if (not (= (vector-length a) (vector-length b))) +inf.0
      (let loop ((i 0) (m 0.0))
        (if (= i (vector-length a)) m
            (loop (+ i 1) (max m (abs (- (vector-ref a i) (vector-ref b i)))))))))
(define I (blc-lam (blc-var 1)))
(define K (blc-lam (blc-lam (blc-var 2))))
(define coin (sblc-choice I K))
(define nested (sblc-choice I coin))
(define programs (list I K coin nested))
(define examples (list (cons I I)))
(define catalogue (sblc-relax-program-domain programs examples 8))
(define bounded (sblc-relax-enumerated-domain 7 examples 8))
(define grammar (sblc-relax-grammar-domain 3 '() 8))
(define logits (vector -1.0 -1.0 1.0 1.0))
(define zeros (vector 0.0 0.0 0.0 0.0))
(define oracle (sblc-relax-exact-oracle catalogue logits '()))
(define (emit r) (display (sblc-relax-receipt->string r)) (newline))
(emit oracle)
(check 'receipt (sblc-relax-receipt? oracle))
(check 'tag (eq? 'sblc-relax-receipt-v1 (sblc-relax-receipt-version oracle)))
(check 'exact (sblc-relax-receipt-exact? oracle))
(check 'oracle-ok (eq? 'ok (sblc-relax-receipt-status oracle)))
(check 'ad (< (vector-distance (sblc-relax-receipt-gradient oracle)
                               (sblc-relax-exact-ad-gradient catalogue logits '())) 1e-12))
(check 'method (eq? 'exact-oracle (sblc-relax-receipt-method oracle)))
(check 'oracle-confidence (eq? 'exact-zero-variance (sblc-relax-receipt-confidence oracle)))
(check 'oracle-naive (= 0.0 (sblc-relax-receipt-baseline-variance oracle)))
(check 'oracle-rb (= 0.0 (sblc-relax-receipt-post-rb-variance oracle)))
(check 'oracle-ratio (= 1.0 (sblc-relax-receipt-variance-reduction-ratio oracle)))
(check 'oracle-bound (= 0.0 (sblc-relax-receipt-variance-bound oracle)))
(check 'oracle-residual (= 0.0 (sblc-relax-receipt-projection-residual oracle)))
(check 'oracle-detail (not (sblc-relax-receipt-error-detail oracle)))
(check 'uniform-expectation (near (sblc-relax-exact-expectation catalogue zeros '()) 0.5625 1e-15))
(check 'uniform-gradient (< (vector-distance (sblc-relax-exact-gradient catalogue zeros '())
                             (vector 0.109375 -0.140625 -0.015625 0.046875)) 1e-15))
(check 'candidate-count (= 4 (length (sblc-relax-receipt-candidates oracle))))
(define (verified e)
  (let* ((m (sblc-relax-candidate-term e)) (bits (sblc-relax-candidate-bits e))
         (prior (sblc-relax-candidate-prior e)) (lk (sblc-relax-candidate-likelihood e))
         (w (sblc-relax-candidate-weight e)))
    (and (sblc-relax-candidate-verified? e) (sblc-closed? m)
         (equal? m (sblc-decode bits)) (string=? bits (sblc-encode m))
         (exact? prior) (= prior (/ 1 (expt 2 (string-length bits))))
         (exact? lk) (exact? w) (= w (* prior lk)))))
(let loop ((xs (sblc-relax-receipt-candidates oracle)) (p programs)
           (masses '(1 0 1/2 3/4)) (q (softmax logits)) (i 0))
  (if (pair? xs)
      (begin (check 'candidate-fields (verified (car xs)))
             (check 'exact-match (equal? (car masses) (sblc-relax-candidate-likelihood (car xs))))
             (check 'term (equal? (car p) (sblc-relax-candidate-term (car xs))))
             (check 'proposal (= (vector-ref q i) (sblc-relax-candidate-probability (car xs))))
             (loop (cdr xs) (cdr p) (cdr masses) q (+ i 1)))))
(check 'best-witness (equal? I (sblc-relax-candidate-term (sblc-relax-receipt-best oracle))))
(check 'joint-trials (= 1/4 (sblc-relax-candidate-likelihood (sblc-relax-receipt-best
  (sblc-relax-exact-oracle (sblc-relax-program-domain (list coin) (append examples examples) 8)
                           (vector 0.0) '())))))
(define custom (list (cons 'reward-mode 'custom)
                     (cons 'reward-fn (lambda (term mass prior) (+ (* mass mass) prior)))))
(check 'custom (near (sblc-relax-exact-expectation
  (sblc-relax-program-domain (list coin) examples 8) (vector 1.0) custom)
  (exact->inexact (+ 1/4 (sblc-weight coin))) 1e-15))
(define (refused domain method l opts)
  (let ((r (sblc-relax-sample domain method l opts)))
    (and (eq? (sblc-relax-receipt-status r) 'domain-error)
         (sblc-relax-receipt-error-detail r) (not (sblc-relax-receipt-exact? r))
         (not (sblc-relax-receipt-best r)) (null? (sblc-relax-receipt-candidates r)))))
(check 'exact-grammar (refused grammar 'exact-oracle zeros '()))
(check 'explicit-method (refused catalogue 'auto zeros '()))
(check 'grammar-only (refused catalogue 'gumbel-softmax zeros '()))
(check 'rb-finite-only (refused grammar 'reinforce-rb zeros '()))
(check 'grammar-width (refused grammar 'gumbel-softmax zeros '()))
(check 'finite-width (refused catalogue 'exact-oracle (vector 0.0) '()))
(check 'length-cap (refused (sblc-relax-enumerated-domain 17 '() 0) 'exact-oracle zeros '()))
(check 'empty-domain (refused (sblc-relax-program-domain '() '() 0) 'exact-oracle (vector) '()))
(check 'open-domain (refused (sblc-relax-program-domain (list (blc-var 1)) '() 0)
                            'exact-oracle (vector 0.0) '()))
(check 'bad-temperature (refused catalogue 'reinforce-rb zeros '((tau . 0))))
(check 'bad-count (refused catalogue 'reinforce-rb zeros '((samples . 0))))
(check 'missing-reward (refused catalogue 'exact-oracle zeros '((reward-mode . custom))))

(define rb-opts '((seed . 101) (samples . 128)))
(define rb (sblc-relax-reinforce-rb catalogue logits rb-opts))
(emit rb)
(check 'rb-ok (eq? 'ok (sblc-relax-receipt-status rb)))
(check 'rb-method (eq? 'reinforce-rb (sblc-relax-receipt-method rb)))
(check 'rb-approximate (not (sblc-relax-receipt-exact? rb)))
(check 'rb-candidates (every verified (sblc-relax-receipt-candidates rb)))
(check 'distinct (= 4 (length (sblc-relax-receipt-candidates rb))))
(check 'rb-count (= 128 (sblc-relax-receipt-sample-count rb)))
(check 'rb-variance (> (sblc-relax-receipt-baseline-variance rb) (sblc-relax-receipt-post-rb-variance rb)))
(check 'rb-reduction (> (sblc-relax-receipt-variance-reduction-ratio rb) 0.5))
(check 'rb-confidence (eq? 'high (sblc-relax-receipt-confidence rb)))
(check 'rb-bound (> (sblc-relax-receipt-variance-bound rb) 0.0))
(check 'low-confidence (eq? 'low-confidence (sblc-relax-receipt-confidence
   (sblc-relax-reinforce-rb catalogue logits (cons '(confidence-threshold . 0.99999) rb-opts)))))
(check 'rb-seed (string=? (sblc-relax-receipt->string rb)
  (sblc-relax-receipt->string (sblc-relax-reinforce-rb catalogue logits rb-opts))))
(define averages (make-vector 4 0.0))
(let loop ((i 0))
  (if (< i 8)
      (let ((g (sblc-relax-receipt-gradient (sblc-relax-reinforce-rb catalogue logits
                      (list (cons 'seed (+ 200 i)) '(samples . 128))))))
        (let add ((j 0))
          (if (< j 4)
              (begin (vector-set! averages j (+ (vector-ref averages j) (/ (vector-ref g j) 8.0)))
                     (add (+ j 1)))))
        (loop (+ i 1)))))
(check 'rb-unbiased (< (vector-distance averages (sblc-relax-receipt-gradient oracle)) 0.012))
(define singleton (sblc-relax-program-domain (list coin) examples 8))
(check 'rb-zero (eq? 'exact-zero-variance (sblc-relax-receipt-confidence
   (sblc-relax-reinforce-rb singleton (vector 0.0) '((baseline-mode . none) (inner-coin-trials . 3))))))

(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(check 'no-exact-gradient (raises? (lambda () (sblc-relax-exact-gradient grammar logits '()))))
;; Two paired draws give an independent two-pass variance calculation. Replay
;; the outer draws and three inner trials without consulting the estimator.
(define paired-prng (make-prng 81))
(define (paired-draw)
  (let* ((k (gumbel-max-sample logits (sample-gumbel-noise 4 paired-prng)))
         (term (list-ref programs k)) (lk (list-ref '(1.0 0.0 0.5 0.75) k)))
    (let trial ((i 0) (hits 0))
      (if (= i 3) (list k lk (/ (exact->inexact hits) 3.0))
          (let ((run (sblc-sample-prng paired-prng (blc-app term I) 8)))
            (trial (+ i 1) (+ hits (if (and (eq? 'normal (sblc-run-status run))
                                             (equal? I (sblc-run-term run))) 1 0))))))))
(define first-draw (paired-draw))
(define second-draw (paired-draw))
(define (paired-moments mode col)
  (let* ((a (list-ref first-draw col)) (b (list-ref second-draw col))
         (m (/ (+ a b) 2.0))
         (ga (score-function-gradient logits (car first-draw)
               (- a (cond ((eq? mode 'mean) m) ((eq? mode 'loo) b) (else 0.0)))))
         (gb (score-function-gradient logits (car second-draw)
               (- b (cond ((eq? mode 'mean) m) ((eq? mode 'loo) a) (else 0.0)))))
         (avg (make-vector 4 0.0)))
    (let loop ((i 0) (v 0.0))
      (if (= i 4) (list avg v)
          (let ((x (vector-ref ga i)) (y (vector-ref gb i)))
            (vector-set! avg i (/ (+ x y) 2.0))
            (loop (+ i 1) (+ v (* 0.5 (- x y) (- x y)))))))))
(let loop ((modes '(none mean loo)))
  (if (pair? modes)
      (let* ((mode (car modes)) (opts (list '(seed . 81) '(samples . 2)
                                           '(inner-coin-trials . 3) (cons 'baseline-mode mode)))
             (r (sblc-relax-reinforce-rb catalogue logits opts))
             (post (paired-moments mode 1)) (base (paired-moments mode 2)))
        (check 'paired-gradient (< (vector-distance (sblc-relax-receipt-gradient r) (car post)) 1e-14))
        (check 'paired-rb (near (cadr post) (sblc-relax-receipt-post-rb-variance r) 1e-14))
        (check 'paired-noisy (near (cadr base) (sblc-relax-receipt-baseline-variance r) 1e-14))
        (loop (cdr modes)))))
(check 'custom-rb (eq? 'ok (sblc-relax-receipt-status
   (sblc-relax-reinforce-rb catalogue logits (cons '(samples . 5) custom)))))

;; Sample three binders with competing indices. Independently replay each
;; Gumbel draw to check the surrogate derivative and the full L1 residual.
(define gl (vector -4.0 3.0 -18.0 -18.0 0.1 0.0 -0.3 0.5))
(define warm '((samples . 1) (seed . 7) (tau . 1.0)))
(define cold '((samples . 1) (seed . 7) (tau . 0.1)))
(define gr (sblc-relax-gumbel-grammar grammar gl warm))
(define gc (sblc-relax-gumbel-grammar grammar gl cold))
(emit gr)
(check 'grammar-ok (eq? 'ok (sblc-relax-receipt-status gr)))
(check 'grammar-method (eq? 'gumbel-softmax (sblc-relax-receipt-method gr)))
(check 'grammar-approximate (not (sblc-relax-receipt-exact? gr)))
(define gm (sblc-relax-candidate-term (sblc-relax-receipt-best gr)))
(check 'grammar-witness (verified (sblc-relax-receipt-best gr)))
(check 'grammar-template (blc-lam? gm))
(check 'same-hard-path (equal? gm (sblc-relax-candidate-term (sblc-relax-receipt-best gc))))
(check 'anneal (> (sblc-relax-receipt-projection-residual gr) (sblc-relax-receipt-projection-residual gc)))
(define gg (sblc-relax-receipt-gradient gr))
(check 'grammar-width-eight (= 8 (vector-length gg)))
(check 'constructor-ad (> (abs (vector-ref gg 1)) 0.00001))
(check 'var-ad (> (abs (vector-ref gg 4)) 0.00001))
(check 'masked-index (= (vector-ref gg 7) 0.0))
(check 'finite (let loop ((i 0)) (or (= i 8) (and (finite? (vector-ref gg i)) (loop (+ i 1))))))

;; Reference path for this seed: lam, lam, lam, var, index. Its scalar
;; reward is one. The product rule therefore sums the selected softmax rows.
(define reference-prng (make-prng 7))
(define reference-grad (make-vector 8 0.0))
(define reference-distance 0.0)
(define reference-probability 1.0)
(define (reference-site offset coordinates selected)
  (let* ((noise (sample-gumbel-noise (vector-length coordinates) reference-prng))
         (y (gumbel-softmax-relaxed coordinates noise 1.0)) (yk (vector-ref y selected)))
    (check 'selected-index (= selected (gumbel-max-sample coordinates noise)))
    (set! reference-probability (* reference-probability (vector-ref (softmax coordinates) selected)))
    (let loop ((j 0))
      (if (< j (vector-length y))
          (let ((h (if (= j selected) 1.0 0.0)) (yj (vector-ref y j)))
            (set! reference-distance (+ reference-distance (abs (- yj h))))
            (vector-set! reference-grad (+ offset j)
              (+ (vector-ref reference-grad (+ offset j)) (* yk (- h yj))))
            (loop (+ j 1)))))))
(reference-site 1 (vector 3.0 -18.0 -18.0) 0)
(reference-site 0 (vector -4.0 3.0 -18.0 -18.0) 1)
(reference-site 0 (vector -4.0 3.0 -18.0 -18.0) 1)
(reference-site 0 (vector -4.0) 0)
(reference-site 4 (vector 0.1 0.0 -0.3) 1)
(check 'all-sites-native-ad (< (vector-distance gg reference-grad) 1e-12))
(check 'all-sites-l1 (near reference-distance (sblc-relax-receipt-projection-residual gr) 1e-12))
(check 'hard-path-probability (near reference-probability
  (sblc-relax-candidate-probability (sblc-relax-receipt-best gr)) 1e-14))

(define rejected (sblc-relax-gumbel-grammar grammar gl (cons (cons 'constraint (lambda (m) #f)) warm)))
(check 'constraint-status (eq? 'projection-error (sblc-relax-receipt-status rejected)))
(check 'constraint-detail (eq? 'constraint-rejected (sblc-relax-receipt-error-detail rejected)))
(check 'constraint-distance (= (sblc-relax-receipt-projection-residual gr)
                               (sblc-relax-receipt-projection-residual rejected)))
(check 'no-substitute (not (sblc-relax-receipt-best rejected)))
(define impossible (sblc-relax-gumbel-grammar (sblc-relax-grammar-domain 0 examples 2) gl warm))
(check 'empty-mask (eq? 'projection-error (sblc-relax-receipt-status impossible)))
(check 'empty-distance (> (sblc-relax-receipt-projection-residual impossible) 0.0))
(check 'open-projection (eq? 'open-term (sblc-relax-receipt-error-detail
  (sblc-relax-project-strict (blc-var 1) #f 0.25))))
(check 'malformed-projection (eq? 'projection-error (sblc-relax-receipt-status
  (sblc-relax-project-strict '(var 1 2) #f 0.25))))
(check 'valid-projection (equal? I (sblc-relax-project-strict I sblc-closed? 0.2)))
(check 'min-grammar-width (eq? 'ok (sblc-relax-receipt-status (sblc-relax-gumbel-grammar
  grammar (vector 20.0 20.0 -100.0 -100.0 0.0) warm))))

(check 'explicit-generator (raises? (lambda () (sblc-relax-grammar-step gl 0 1 1.0 #f))))
(define (binary-branch l)
  (vector-ref (sblc-relax-grammar-step l 1 1 0.5 (make-prng 19)) 0))
(check 'application-branch (equal? '(app (var 1) (var 1)) (binary-branch (vector 0.0 0.0 200.0 0.0 0.0))))
(check 'choice-branch (equal? '(choice (var 1) (var 1)) (binary-branch (vector 0.0 0.0 0.0 200.0 0.0))))
(define miss (sblc-relax-gumbel-grammar (sblc-relax-grammar-domain 1 examples 0)
               (vector 200.0 100.0 -100.0 -100.0 0.0) warm))
(check 'grammar-exact-timeout (equal? 0 (sblc-relax-candidate-likelihood (sblc-relax-receipt-best miss))))
(check 'grammar-zero-reward (= 0.0 (sblc-relax-receipt-expected-reward miss)))
(define reject-all (list (cons 'constraint (lambda (m) #f))))
(check 'exact-hard-constraint (eq? 'projection-error (sblc-relax-receipt-status
  (sblc-relax-exact-oracle catalogue logits reject-all))))
(check 'rb-hard-constraint (eq? 'projection-error (sblc-relax-receipt-status
  (sblc-relax-reinforce-rb catalogue logits (cons '(samples . 1) reject-all)))))

(check 'explicit-invariance (sblc-relax-verify-invariance catalogue logits (vector 1000.0 -800.0 -500.0 700.0)))
(define bounded-logits (make-vector (+ (sblc-count-closed 4) (sblc-count-closed 5)
                                       (sblc-count-closed 6) (sblc-count-closed 7)) 0.0))
(define bounded-alt (make-vector (vector-length bounded-logits) -1000.0))
(vector-set! bounded-alt 0 1000.0)
(check 'bounded-invariance (sblc-relax-verify-invariance bounded bounded-logits bounded-alt))
(check 'bounded-mdl (string=? (sblc-entry-bits (sblc-receipt-mdl (sblc-condition 42 7 8 examples)))
                              (sblc-relax-candidate-bits (sblc-relax-receipt-best
                                (sblc-relax-exact-oracle bounded bounded-alt '())))))

(define (trained method)
  (let* ((opts '((reward-mode . mdl) (samples . 32))) (res (sblc-relax-optimize-logits
                catalogue method zeros 60.0 5 opts)) (l (car res)) (hist (cadr res)) (final (caddr res)))
    (check 'history-length (= 6 (length hist)))
    (check 'improved (> (sblc-relax-exact-expectation catalogue l opts)
                        (sblc-relax-exact-expectation catalogue zeros opts)))
    (check 'history-increases (> (car (reverse hist)) (car hist)))
    (check 'concentrates (> (vector-ref (softmax l) 0) 0.8))
    (check 'trained-mdl (equal? I (sblc-relax-candidate-term (sblc-relax-receipt-best final))))
    (check 'final-receipt (string=? (sblc-relax-receipt->string final)
                                   (sblc-relax-receipt->string (sblc-relax-sample catalogue method l opts))))))
(trained 'exact-oracle)
(trained 'reinforce-rb)
(check 'grammar-ascent (eq? 'ok (sblc-relax-receipt-status
  (caddr (sblc-relax-optimize-logits grammar 'gumbel-softmax gl 0.1 1 warm)))))
(check 'initial-logits (equal? zeros (vector 0.0 0.0 0.0 0.0)))
(display "SBLC RELAX checks: ") (display checks) (newline)
(display "SBLC RELAX RESULT: PASS") (newline)
