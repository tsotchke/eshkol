;;; Bounded classical BLC byte observations: semantics, collection and refusal.
(require core.blc_bytes)
(require core.list.query)
(require core.list.transform)
(require core.list.search)
(define checks 0)
(define (check name value)
  (set! checks (+ checks 1))
  (if (not value) (begin (display "FAIL: ") (display name) (newline) (exit 1))))
(define (run program input heap)
  (blc-run-bytes program input 2000000 heap 512))
(define (success? receipt bytes)
  (and (eq? (car receipt) 'normal) (equal? (cadr receipt) bytes)))
(define (pair-code head tail) (blc-app (blc-app blc-pair head) tail))
(define (constant bytes) (blc-lam (blc-bytes->term bytes)))
(define bytes (let loop ((i 255) (out '()))
                (if (< i 0) out (loop (- i 1) (cons i out)))))
(check 'all-bytes (success? (run blc-I bytes 8192) bytes))
(check 'empty (success? (run blc-I '() 256) '()))
(check 'capture (success? (run (blc-app (blc-lam (blc-lam (blc-var 2)))
                                        (blc-bytes->term '(7 129))) '(255) 1024) '(7 129)))
(check 'lazy (success? (run (blc-lam (blc-app (blc-lam (blc-bytes->term '(42))) blc-omega))
                           '() 1024) '(42)))
;; The same object must survive collection at both byte and list observers.
(let loop ((capacities '(128 256 512 1024)))
  (if (not (null? capacities))
      (let ((r (run blc-I '(0 255 1 128 0 255 1 128) (car capacities))))
        (check 'collection-output (success? r '(0 255 1 128 0 255 1 128)))
        (check 'collection-ran (> (list-ref r 6) 0))
        (check 'live-bound (< (list-ref r 7) (car capacities)))
        (check 'work-bound (<= (list-ref r 2) 2000000))
        (loop (cdr capacities)))))
(check 'determinism (equal? (run blc-I '(3 5 8) 256) (run blc-I '(3 5 8) 256)))
(check 'zero-work (eq? (car (blc-run-bytes blc-I '() 0 128 0)) 'work-bound))
(check 'omega (eq? (car (blc-run-bytes (blc-lam blc-omega) '() 1000 4096 1)) 'work-bound))
(check 'small-heap (eq? (car (run blc-I '(1) 16)) 'heap-bound))
(check 'zero-output-empty (success? (blc-run-bytes blc-I '() 10000 256 0) '()))
(check 'zero-output-nonempty (eq? (car (blc-run-bytes blc-I '(1) 10000 256 0)) 'output-bound))
(check 'output-prefix (equal? (cadr (blc-run-bytes blc-I '(1 2) 10000 256 1)) '(1)))
(check 'bad-byte (eq? (car (run blc-I '(256) 256)) 'invalid-input))
(check 'improper-input (eq? (car (run blc-I '(0 . 1) 256)) 'invalid-input))
(check 'free-variable (eq? (car (run (blc-var 1) '() 256)) 'invalid-term))
(check 'bad-constructor (eq? (car (run '(lam) '() 256)) 'invalid-term))
(check 'extra-field (eq? (car (run '(var 1 extra) '() 256)) 'invalid-term))
(check 'bad-output (eq? (car (run (constant '(1)) '() 16)) 'heap-bound))
(check 'non-byte-output (eq? (car (run (blc-lam blc-I) '() 256)) 'invalid-output))
;; Sharing must cache forced thunks without changing the result.
(let ((r (run blc-I '(1 1 1) 256))) (check 'memoized (> (list-ref r 5) 0)))
;; Independent strong tree reduction is the semantic oracle on small terms.
(let loop ((frames '(() (0) (1) (255) (0 1 128 255))))
  (if (not (null? frames))
      (let* ((frame (car frames))
             (tree (blc-term->bytes (blc-apply blc-I (blc-bytes->term frame)))))
        (check 'tree-parity (success? (run blc-I frame 2048) tree))
        (loop (cdr frames)))))
(check 'short-byte
       (eq? (car (run (blc-lam (blc-cons (blc-cons blc-true blc-nil) blc-nil)) '() 1024))
            'invalid-output))
(let* ((shared (blc-lam
                (blc-app (blc-lam (pair-code (blc-var 1) (pair-code (blc-var 1) blc-nil)))
                         (blc-app (blc-var 1) blc-true))))
       (r (run shared '(77) 256)))
  (check 'shared-output (success? r '(77 77)))
  (check 'shared-cached (> (list-ref r 5) 0)))
(display "BLC-BYTES checks: ") (display checks) (newline)
(display "BLC-BYTES RESULT: PASS") (newline)
