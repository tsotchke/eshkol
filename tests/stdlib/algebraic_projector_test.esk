(require stdlib)
(require core.ad.algebraic_subspace)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define d (algebraic-domain field))
(define same? (algebraic-domain-ref d 'equal?))
(define (matrix=? a b) (let rows ((i 0)) (or (= i (vector-length a)) (and
  (let cols ((j 0)) (or (= j (vector-length a)) (and (same? (vector-ref (vector-ref a i) j) (vector-ref (vector-ref b i) j)) (cols (+ j 1))))) (rows (+ i 1))))))
(define (madd a b) (list->vector (map (lambda (i) (list->vector (map (lambda (j)
 ((algebraic-domain-ref d 'add) (vector-ref (vector-ref a i) j) (vector-ref (vector-ref b i) j))) (iota (vector-length a))))) (iota (vector-length a)))))
(define rotation (vector (vector 3/5 0 4/5) (vector 0 1 0) (vector -4/5 0 3/5)))
(define transpose (vector (vector 3/5 0 -4/5) (vector 0 1 0) (vector 4/5 0 3/5)))
(define (rotate a) (algebraic-matrix-mul field (algebraic-matrix-mul field rotation a) transpose))
(define p (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 0)))
(for-each (lambda (t)
  (let* ((a (rotate (vector (vector (+ 1 t) 0 0) (vector 0 (- 1 t) 0) (vector 0 0 4))))
         (f (vector (- 1 (* t t)) -2 1)) (g (vector -4 1))
         (space (make-algebraic-subspace-from-factors field a f g))
         (other (make-algebraic-subspace-from-factors field a g f))
         (h (rotate (vector (vector 0 0 (- 6 (* 2 t))) (vector 0 0 (- -9 (* 3 t))) (vector (- 6 (* 2 t)) (- -9 (* 3 t)) 0))))
         (dp (algebraic-subspace-jvp space h)))
    (check "rotated cluster projector agrees with independent basis" (matrix=? (algebraic-subspace-projector space) (rotate p)))
    (check "cluster rank includes repeated roots" (= (vector-ref (algebraic-subspace-info space) 1) 2))
    (check "complement factor selects complementary space" (matrix=? (madd (algebraic-subspace-projector space) (algebraic-subspace-projector other))
      (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 1))))
    (check "constructed space differentiates through internal crossings" (matrix=? dp (rotate (vector (vector 0 0 -2) (vector 0 0 3) (vector -2 3 0)))))
    (check "original matrix tangent residual verifies" (verify-algebraic-subspace-jvp field a (algebraic-subspace-projector space) h dp)))) '(-1 0 1 2))
;; Irreducible rational factor selects both irrational conjugates together.
(define a (vector (vector 1 1 0) (vector 1 -1 0) (vector 0 0 5)))
(check "irreducible quadratic cluster" (matrix=? (algebraic-subspace-projector
  (make-algebraic-subspace-from-factors field a '(-2 0 1) '(-5 1))) p))
(define alpha (algebraic-generator field))
(define irrational-a (vector (vector alpha 0 0) (vector 0 ((algebraic-domain-ref d 'sub) 0 alpha) 0) (vector 0 0 5)))
(check "rational factors of algebraic-entry matrix" (matrix=? (algebraic-subspace-projector
  (make-algebraic-subspace-from-factors field irrational-a '(-2 0 1) '(-5 1))) p))
(define f (vector 1 -2 1)) (define g (vector -4 1))
(define frozen (make-algebraic-subspace-from-factors field
  (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 4)) f g))
(vector-set! f 0 99) (vector-set! g 0 99)
(check "factor input ownership" (matrix=? (algebraic-subspace-projector frozen) p))
(check "wrong factorization refuses" (raises? (lambda () (make-algebraic-subspace-from-factors field a '(-3 0 1) '(-5 1)))))
(check "shared root across selection boundary refuses" (raises? (lambda () (make-algebraic-subspace-from-factors field
  (vector (vector 1 0 0) (vector 0 1 0) (vector 0 0 4)) '(-1 1) '(4 -5 1)))))
(check "nonmonic split refuses" (raises? (lambda () (make-algebraic-subspace-from-factors field a '(-8 0 2) '(-5 1)))))
(check "constant cluster refuses" (raises? (lambda () (make-algebraic-subspace-from-factors field a '(1) '(20 -4 -5 1)))))
(check "inexact factors refuse" (raises? (lambda () (make-algebraic-subspace-from-factors field a '(-4.0 0 1) '(-5 1)))))
(check "nonsymmetric original matrix refuses" (raises? (lambda () (make-algebraic-subspace-from-factors field
  (vector (vector 1 2) (vector 0 4)) '(-1 1) '(-4 1)))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
