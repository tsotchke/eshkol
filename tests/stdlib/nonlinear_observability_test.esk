(require core.nonlinear_observability)
(require core.exact_linalg)
(define checks 0)
(define (check name ok) (if (not ok) (begin (display "FAIL ") (write name) (newline) (error "FAIL nonlinear observability"))) (set! checks (+ checks 1)))
(define vs '(x0 x1 x2 x3))
(define f '((expt x0 2) (expt x1 2) (expt x2 2) (expt x3 2)))
(define h '((+ x0 x1) (+ x1 x2) (+ x2 x3) (+ x3 x0)))
(define task '(- (+ x0 x2) (+ x1 x3)))
(define active (append h '((+ x0 (* 2 x1)))))
(define cert (certify-observation-task vs f active 1 task 1 '(5 2 -1 0 -4 0 0 0 0 0)))
(check 'admit cert)
(check 'replay (verify-observation-task cert vs f active 1 task))
(check 'source-binding (not (verify-observation-task cert vs f h 1 task)))
(check 'task-binding (not (verify-observation-task cert vs f active 1 'x0)))
(check 'bad-witness (not (verify-observation-task (vector 'observation-task-v1 1 '(5 2 -1 0 -3 0 0 0 0 0)) vs f active 1 task)))
(check 'zero-power (not (verify-observation-task (vector 'observation-task-v1 0 '(5 2 -1 0 -4 0 0 0 0 0)) vs f active 1 task)))
(check 'inexact (not (verify-observation-task (vector 'observation-task-v1 1 '(5.0 2 -1 0 -4 0 0 0 0 0)) vs f active 1 task)))
(check 'symmetry (observation-symmetry? vs f h task '(a b) '(a b a b) '((expt a 2) (expt b 2)) '(b a)))
(check 'active-breaks-symmetry (not (observation-symmetry? vs f active task '(a b) '(a b a b) '((expt a 2) (expt b 2)) '(b a))))
(check 'wrong-flow (not (observation-symmetry? vs '((expt x0 2) (expt x1 2) 0 (expt x3 2)) h task '(a b) '(a b a b) '((expt a 2) (expt b 2)) '(b a))))
(check 'hint-unknown (eq? (observation-task-hint '(x) '(0) '((expt x 2)) 0 'x) 'unknown))
(check 'hint-proof (eq? (observation-task-hint '(x) '(0) '(x) 0 'x) 'ideal-consequence))
;; A positive power proves real vanishing even without ordinary ideal membership.
(check 'radical (certify-observation-task '(x) '(0) '((expt x 3) (expt x 2)) 0 'x 3 '(4 (* -3 (+ x observation$x)))))
(define (observation-jacobian a b c d)
 (vector (vector 1 1 0 0) (vector 0 1 1 0) (vector 0 0 1 1) (vector 1 0 0 1)
         (vector (* 2 a) (* 2 b) 0 0) (vector 0 (* 2 b) (* 2 c) 0)
         (vector 0 0 (* 2 c) (* 2 d)) (vector (* 2 a) 0 0 (* 2 d))))
(check 'full-local-rank (equal? (exact-rank (observation-jacobian 1 2 1 2)) 4))
(check 'singular-diagonal (equal? (exact-rank (observation-jacobian 3 3 3 3)) 3))
(display "PASS nonlinear_observability ") (display checks) (newline)
