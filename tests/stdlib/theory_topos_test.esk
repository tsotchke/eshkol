;;; theory_topos_test.esk -- core.theory.topos (ADR-0039): the truth values
;;; Omega_J(c) of toposes of finite sites as models of the theory of Heyting
;;; algebras, laws exhaustive; Boolean exactly where core.topos says so;
;;; restriction maps are Heyting homomorphisms; agreement with the word
;;; problem of core.theory.free on seeded identities.
;;;
;;; Ends with "PASS: theory_topos_test" and "RESULT: PASS", or FAIL lines and
;;; "RESULT: FAIL".

(require stdlib)
(require core.sheaf.site)
(require core.sheaf.presheaf)
(require core.topos)
(require core.theory)
(require core.theory.topos)

(define passed 0)
(define failed 0)
(define (check label ok)
  (if ok
      (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display label) (newline))))
(define (all? p xs) (cond ((null? xs) #t) ((p (car xs)) (all? p (cdr xs))) (else #f)))

;; Sites: the walking arrow and BZ/2 (presheaf toposes), the pseudocircle
;; with the open-cover topology, the three-element chain 0 <= 1 <= 2.
(define WA (poset-category 2 (lambda (x y) (<= x y))))
(define (z2-nf w) (if (even? (length w)) '() (list 0)))
(define BZ2 (make-category-from-presentation 1 (list (list 0 0 's)) z2-nf 2))
(define space (make-finite-space 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define toposes
  (list (list "walking arrow" (presheaf-topos WA))
        (list "BZ/2" (presheaf-topos BZ2))
        (list "chain of three" (presheaf-topos (poset-category 3 (lambda (x y) (<= x y)))))
        (list "sheaves on the pseudocircle" (make-topos (finite-space-site space)))))
(define (objects T) (iota (category-object-count (topos-category T))))
(define stages
  (apply append (map (lambda (e) (map (lambda (c) (list (car e) (cadr e) c)) (objects (cadr e)))) toposes)))

(define law-evaluations 0)
(define (lawful? M)
  (for-each (lambda (e) (set! law-evaluations (+ law-evaluations (expt (model-size M) (length (equation-variables e))))))
            (theory-equations (model-theory M)))
  (null? (model-law-violations M)))

(check "Omega_J(c) is a Heyting algebra at every stage of every site (exhaustive)"
       (all? (lambda (s) (lawful? (topos-omega-model (cadr s) (caddr s)))) stages))
(check "Omega_J(c) satisfies the Boolean algebra laws exactly when topos-omega-boolean? holds"
       (all? (lambda (s) (eq? (lawful? (topos-omega-boolean-model (cadr s) (caddr s)))
                              (if (topos-omega-boolean? (cadr s) (caddr s)) #t #f)))
             stages))
(define T-WA (cadr (car toposes)))
(define Om0 (topos-omega-model T-WA 0))
(define Om1 (topos-omega-model T-WA 1))
(check "on the walking arrow, Omega(1) has three truth values and is not Boolean; BZ/2's Omega is Boolean"
       (and (= 3 (model-size Om1)) (not (topos-omega-boolean? T-WA 1))
            (topos-omega-boolean? (cadr (cadr toposes)) 0)))
(check "Omega(1) of the walking arrow is isomorphic to the three-element chain as a Heyting algebra"
       (model-isomorphic? Om1 (finite-heyting-algebra "C3" '(0 1 2) (lambda (a b) (<= a b)))))
(define C-WA (topos-category T-WA))
(check "restriction along every arrow is a homomorphism of Heyting algebras"
       (all? (lambda (T)
               (let ((C (topos-category T)))
                 (all? (lambda (f)
                         (model-homomorphism? (topos-omega-restriction T f)
                                              (topos-omega-model T (arrow-target C f))
                                              (topos-omega-model T (arrow-source C f))))
                       (iota (category-arrow-count C)))))
             (map (lambda (e) (cadr e)) toposes)))
;; The free Heyting algebra's identities hold in every Omega; excluded middle
;; holds exactly in the Boolean ones.
(define identities
  (list '((implies (implies (implies x (bottom)) (bottom)) (bottom)) (implies x (bottom)))
        '((implies (join x y) z) (meet (implies x z) (implies y z)))
        '((implies x (implies y z)) (implies (meet x y) z))
        '((meet x (join y z)) (join (meet x y) (meet x z)))))
(check "the word problem's identities (G4ip) hold in every Omega_J(c)"
       (and (all? (lambda (p) (theory-word-problem heyting-algebra-theory (car p) (cadr p))) identities)
            (all? (lambda (s)
                    (null? (equations-violations (topos-omega-model (cadr s) (caddr s))
                                                 (map (lambda (p) (make-equation 'identity (car p) (cadr p))) identities)
                                                 (model-elements (topos-omega-model (cadr s) (caddr s))))))
                  stages)))
(check "excluded middle fails in some Omega_J(c) exactly where it is not Boolean"
       (all? (lambda (s)
               (let ((M (topos-omega-model (cadr s) (caddr s))))
                 (eq? (null? (equations-violations M (list (make-equation 'excluded-middle '(join x (implies x (bottom))) '(top)))
                                                   (model-elements M)))
                      (if (topos-omega-boolean? (cadr s) (caddr s)) #t #f))))
             stages))

(display "stages: ") (display (length stages)) (display ", law evaluations: ") (display law-evaluations) (newline)
(display "checks: ") (display passed) (display " passed, ") (display failed) (display " failed") (newline)
(if (= failed 0)
    (begin (display "PASS: theory_topos_test") (newline) (display "RESULT: PASS") (newline))
    (begin (display "RESULT: FAIL") (newline)))
