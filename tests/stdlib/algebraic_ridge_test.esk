(require stdlib)
(require core.ad.algebraic_ridge)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define same (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define a (algebraic-generator field))
(define irrational (algebraic-ridge-new field 1 1 (zset-singleton (vector a 2) 1)))
(define io (algebraic-ridge-output irrational))
(check "irrational fitted coefficient" (same (vector-ref (vector-ref io 0) 0) (algebraic-scale a 2/3)))
(check "irrational regularization sensitivity" (same (vector-ref (vector-ref io 1) 0) (algebraic-scale a -2/9)))
(check "irrational optimum objective" (same (vector-ref io 2) 4/3))
(check "ridge scalar pullback" (same (vector-ref (algebraic-ridge-pullback irrational (vector 1)) 2) (algebraic-scale a -2/9)))
(define data (zset-from-weighted (list (list 1 (vector 1 0 1)) (list 1 (vector 0 1 2)))))
(define tracked (vector 0 1 2))
(define lambda-value 1)
(define initial (algebraic-ridge-new field 2 lambda-value data))
(define state initial)
(define foreign-owner (make-algebraic-field '(-2 0 1) 3 1))
(define (oracle rows regularization)
  (let ((g00 0) (g01 0) (g11 0) (b0 0) (b1 0) (c 0))
    (for-each (lambda (entry)
      (let* ((w (car entry)) (r (cadr entry)) (x (vector-ref r 0)) (y (vector-ref r 1)) (z (vector-ref r 2)))
        (set! g00 (+ g00 (* w x x))) (set! g01 (+ g01 (* w x y))) (set! g11 (+ g11 (* w y y)))
        (set! b0 (+ b0 (* w x z))) (set! b1 (+ b1 (* w y z))) (set! c (+ c (* w z z))))) (zset-entries rows))
    (let* ((u (+ g00 regularization)) (v (+ g11 regularization)) (det (- (* u v) (* g01 g01)))
           (x (/ (- (* b0 v) (* b1 g01)) det)) (y (/ (- (* b1 u) (* b0 g01)) det)))
      (vector (vector x y) (vector (/ (- (* g01 y) (* v x)) det) (/ (- (* g01 x) (* u y)) det)) (- c (* b0 x) (* b1 y))))))
(define (same-output actual expected)
  (and (same (vector-ref (vector-ref actual 0) 0) (vector-ref (vector-ref expected 0) 0))
       (same (vector-ref (vector-ref actual 0) 1) (vector-ref (vector-ref expected 0) 1))
       (same (vector-ref (vector-ref actual 1) 0) (vector-ref (vector-ref expected 1) 0))
       (same (vector-ref (vector-ref actual 1) 1) (vector-ref (vector-ref expected 1) 1))
       (same (vector-ref actual 2) (vector-ref expected 2))))
(check "initial batch parity" (same-output (algebraic-ridge-output state) (oracle data lambda-value)))
(let ticks ((t 0)) (if (< t 24)
  (let* ((row (vector (- (modulo t 3) 1) (+ 1 (modulo t 2)) (- (modulo t 5) 2)))
         (delta (zset-from-weighted (list (list -1 tracked) (list 1 row))))
         (dl (if (= (modulo t 2) 0) 1/2 -1/2)) (before (algebraic-ridge-output state))
         (tick (algebraic-ridge-step state delta dl)))
    (set! data (zset-add data delta)) (set! lambda-value (+ lambda-value dl)) (set! tracked row)
    (set! state (vector-ref tick 0))
    (let* ((out (algebraic-ridge-output state)) (expected (oracle data lambda-value))
           (change (vector-ref tick 1)) (bars (algebraic-ridge-pullback state (vector 2 -1))))
      (check "simultaneous retraction insertion and lambda update matches closed-form batch fit" (same-output out expected))
      (check "coefficient delta integrates exactly" (and
        (same (algebraic-add (vector-ref (vector-ref before 0) 0) (vector-ref change 0)) (vector-ref (vector-ref out 0) 0))
        (same (algebraic-add (vector-ref (vector-ref before 0) 1) (vector-ref change 1)) (vector-ref (vector-ref out 0) 1))))
      (check "lambda pullback agrees with independent directional sensitivity"
        (same (vector-ref bars 2) (- (* 2 (vector-ref (vector-ref expected 1) 0)) (vector-ref (vector-ref expected 1) 1))))
      (check "one LU per tick" (= (vector-ref (vector-ref tick 2) 4) 1))
      (check "fixed seven-moment state" (= (vector-ref (algebraic-ridge-info state) 1) 7)))
    (ticks (+ t 1)))))
(check "historical snapshot survives successors" (same-output (algebraic-ridge-output initial)
  (oracle (zset-from-weighted (list (list 1 (vector 1 0 1)) (list 1 (vector 0 1 2)))) 1)))
(define parameter-only (algebraic-ridge-step state (zset-empty) 1/2))
(check "parameter-only tick visits zero rows and row monomials" (and (= (vector-ref (vector-ref parameter-only 2) 1) 0) (= (vector-ref (vector-ref parameter-only 2) 2) 0)))
(check "parameter-only fit matches full batch" (same-output (algebraic-ridge-output (vector-ref parameter-only 0)) (oracle data (+ lambda-value 1/2))))
(define output (algebraic-ridge-output state))
(vector-set! (vector-ref (vector-ref output 0) 0) 2 (vector 99 0))
(check "output copies do not corrupt retained fit" (same-output (algebraic-ridge-output state) (oracle data lambda-value)))
(define outer (make-algebraic-taylor field 2))
(define nested (algebraic-ridge-new outer 1 (algebraic-ad-seed outer 1) (zset-singleton (vector a 2) 1)))
(define beta (vector-ref (vector-ref (algebraic-ridge-output nested) 0) 0))
(check "nested fit first lambda derivative" (same (algebraic-ad-derivative beta 1) (algebraic-scale a -2/9)))
(check "nested fit second lambda derivative" (same (algebraic-ad-derivative beta 2) (algebraic-scale a 4/27)))
(check "nested sensitivity retains next derivative" (same (algebraic-ad-derivative
  (vector-ref (vector-ref (algebraic-ridge-output nested) 1) 0) 1) (algebraic-scale a 4/27)))
(define wide (algebraic-ridge-new field 7 1))
(check "maximum bounded dimension" (and (= (vector-ref (algebraic-ridge-info wide) 0) 7) (= (vector-ref (algebraic-ridge-info wide) 1) 37)))
(check "empty ridge solution" (same (vector-ref (vector-ref (algebraic-ridge-output wide) 0) 6) 0))
(check "SPD admission accepts symmetric positive matrix" (algebraic-factor-positive-definite? (algebraic-factor field (vector (vector 2 1) (vector 1 2)))))
(check "SPD admission rejects indefinite matrix" (not (algebraic-factor-positive-definite? (algebraic-factor field (vector (vector 1 2) (vector 2 1))))))
(check "SPD admission rejects nonsymmetric matrix" (not (algebraic-factor-positive-definite? (algebraic-factor field (vector (vector 2 1) (vector 0 2))))))
(define p (make-algebraic-incremental-plan field 2 0 '(+ 1 (pow (row 0) 2))))
(define m (algebraic-incremental-new p (vector) (zset-singleton (vector 2 3) 1)))
(define observed (algebraic-incremental-moment-ref m (vector 2 0)))
(vector-set! observed 2 (vector 55 0))
(check "moment observer owns coefficients" (same (algebraic-incremental-moment-ref m (vector 2 0)) 4))
(for-each (lambda (thunk) (check "ridge and moment refusal" (raises? thunk)))
  (list (lambda () (algebraic-ridge-new field 0 1)) (lambda () (algebraic-ridge-new field 8 1))
    (lambda () (algebraic-ridge-new field 1 -1)) (lambda () (algebraic-ridge-new field 1 0))
    (lambda () (algebraic-ridge-new field 1 1 (zset-from-weighted (list (list -2 (vector 10 1))))))
    (lambda () (algebraic-ridge-step state (zset-empty) -99))
    (lambda () (algebraic-ridge-step state (zset-singleton (vector 1 2 3.0) 1) 0))
    (lambda () (algebraic-ridge-pullback state (vector 1)))
    (lambda () (algebraic-incremental-moment-ref m (vector 0 1)))
    (lambda () (algebraic-incremental-moment-ref m (vector -1 0)))
    (lambda () (algebraic-incremental-moment-ref m (vector 1)))))
(check "refused successors preserve snapshot" (same-output (algebraic-ridge-output state) (oracle data lambda-value)))
(check "foreign owner cannot initialize a ridge snapshot" (raises? (lambda ()
  (algebraic-ridge-new foreign-owner 1 (algebraic-element field 1)))))
(check "foreign owner cannot update regularization" (raises? (lambda ()
  (algebraic-ridge-step state (zset-empty) (algebraic-element foreign-owner 1)))))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
