(require core.testing)
(reset-tests!)
(register-test "condition matching"
  (lambda ()
    (check-raises (lambda () (raise 'any)))
    (check-raises 'bounds (lambda () (raise 'bounds)))
    (check-raises error-object? (lambda () (error "typed error")))
    (check-raises 'bounds (lambda () (raise 'unrelated)))
    (check-raises 'bounds (lambda () 42))))
(call-with-values (lambda () (run-tests))
  (lambda (passed failed)
    (if (and (= passed 3) (= failed 2)
             (= *test-pass-count* 3) (= *test-fail-count* 2))
        (display "PASS: condition counts")
        (begin (display "unexpected condition counts") (newline) (exit 1)))))
(newline)
