(require stdlib)
(require core.certified_solve)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (m2 a b c d) (vector (vector a b) (vector c d)))
(define (inside? box value) (and (<= (car box) value) (<= value (cdr box))))
(define (proved? cert) (eq? (vector-ref cert 1) 'proved))
(define a (m2 2 1 1 3))
(define b (vector 1 2))
(define x (vector 1/4 1/2))
(define r (m2 3/5 -1/5 -1/5 2/5))
(define certificate (certify-linear-solve a b x r))
(check "known exact enclosure" (equal? (vector-ref certificate 2) (vector (cons 1/5 3/10) (cons 2/5 3/5))))
(check "source-bound verifier" (verify-linear-solve-certificate certificate a b x r))
(check "changed source refuses old certificate" (not (verify-linear-solve-certificate certificate a (vector 1 3) x r)))
(define forged (vector-copy certificate))
(vector-set! forged 2 (vector (cons 0 0) (cons 0 0)))
(check "edited enclosure refuses" (not (verify-linear-solve-certificate forged a b x r)))
(define copied (certify-linear-solve a b x r))
(vector-set! (vector-ref (vector-ref copied 3) 0) 0 (vector 99 99))
(check "receipt does not alias input" (= (vector-ref (vector-ref a 0) 0) 2))
(check "observations do not affect next call" (equal? certificate (certify-linear-solve a b x r)))
(define zero-r (m2 0 0 0 0))
(check "zero residual is not invertibility proof" (not (proved? (certify-linear-solve (m2 1 1 1 1) (vector 2 2) (vector 1 1) zero-r))))
(define identity (m2 1 0 0 1))
(define skew-r (m2 1 -4 0 1))
(check "unweighted failed contraction is unknown" (not (proved? (certify-linear-solve identity b x skew-r))))
(define weighted (certify-linear-solve identity b x skew-r (vector 8 1)))
(check "weighted admission" (and (proved? weighted) (= (vector-ref (vector-ref weighted 3) 11) 1/2)))
(check "weighted enclosure" (and (inside? (vector-ref (vector-ref weighted 2) 0) 1)
                                (inside? (vector-ref (vector-ref weighted 2) 1) 2)))
;; Candidate from an actual floating division. Decoding is explicit, preserving
;; the nonzero original rational residual even when the numeric residual rounds.
(define received (inexact->exact (/ 1.0 3.0)))
(define decoded (certify-linear-solve (vector (vector 3)) (vector 1) (vector received) (vector (vector 1/3))))
(check "numeric candidate is independently admitted" (proved? decoded))
(check "decoded candidate retains exact nonzero residual" (not (= (vector-ref (vector-ref (vector-ref decoded 3) 7) 0) 0)))
(check "numeric candidate enclosure contains true solution" (inside? (vector-ref (vector-ref decoded 2) 0) 1/3))
;; Every coefficient/RHS within these declared boxes must share the enclosure.
(define uncertain (certify-linear-solve (vector (vector 2)) (vector 1) (vector 1/2)
  (vector (vector 1/2)) (vector 1) (vector (vector 1/10)) (vector 1/20)))
(check "uniform family admitted" (proved? uncertain))
(for-each (lambda (av) (for-each (lambda (bv)
  (check "uncertain corners enclosed" (inside? (vector-ref (vector-ref uncertain 2) 0) (/ bv av)))) '(19/20 21/20))) '(19/10 21/10))
;; Independent 2x2 Cramer's-rule oracle. Five received inverse scalings include
;; both proved and unknown cases; the exact boundary theta=1 must refuse.
(define (oracle-case entries)
  (let* ((aa (list-ref entries 0)) (ab (list-ref entries 1))
         (ac (list-ref entries 2)) (ad (list-ref entries 3))
         (det (- (* aa ad) (* ab ac)))
         (mat (m2 aa ab ac ad))
         (true-x (vector (/ (- ad (* 2 ab)) det) (/ (- (* 2 aa) ac) det))))
    (for-each
      (lambda (scale)
        (let* ((rr (m2 (* scale (/ ad det)) (* scale (/ (- ab) det))
                       (* scale (/ (- ac) det)) (* scale (/ aa det))))
               (candidate (vector (+ (vector-ref true-x 0) 1/7) (- (vector-ref true-x 1) 1/9)))
               (cert (certify-linear-solve mat b candidate rr)))
          (check "oracle admission matches strict contraction"
            (eq? (proved? cert) (and (> scale 0) (< scale 2))))
          (if (proved? cert)
            (check "Cramer oracle inside published box"
              (and (inside? (vector-ref (vector-ref cert 2) 0) (vector-ref true-x 0))
                   (inside? (vector-ref (vector-ref cert 2) 1) (vector-ref true-x 1)))))))
      '(0 1/2 1 3/2 2))))
(for-each oracle-case '((2 1 1 3) (0 1 1 0) (-2 3 4 1) (1 1 1 2) (3 0 0 -2)))
(for-each (lambda (thunk) (check "malformed or inexact input refused" (raises? thunk)))
  (list (lambda () (certify-linear-solve a b (vector 1.0 2) r))
        (lambda () (certify-linear-solve a b x r (vector 0 1)))
        (lambda () (certify-linear-solve a b x r (vector 1 1) (m2 0 -1 0 0)))
        (lambda () (certify-linear-solve (m2 1 2 3 4) (vector 1) x r))
        (lambda () (certify-linear-solve a b x r #f))
        (lambda () (certify-linear-solve (vector) (vector) (vector) (vector)))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
