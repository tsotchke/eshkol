(require stdlib)
(require core.ad.certified_continuation)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (contains? b x) (and (<= (car b) x) (<= x (cdr b))))
;; Coupled, nonlinear in the parameter, with independently known branch (1+t, (1+t)^2).
(define system (make-certified-polynomial-system '(x y) '(t) '((- (* x x) (* (+ 1 t) (+ 1 t))) (- y (* x x)))))
(define initial (make-certified-continuation system 0 (vector 1 1) (vector 1/32 1/16)
  (vector (vector 1/2 0) (vector 1 1))))
(define result (certified-continuation-advance initial 1/2 1/2 128))
(check "adaptive coupled continuation reaches target" (eq? (vector-ref result 1) 'complete))
(define final (vector-ref result 2))
(define boxes (vector-ref (certified-continuation-enclosure final) 1))
(check "independent algebraic endpoint x" (contains? (vector-ref boxes 0) 3/2))
(check "independent algebraic endpoint y" (contains? (vector-ref boxes 1) 9/4))
(check "large trial required subdivision" (> (vector-ref result 4) (length (vector-ref result 3))))
(check "source-bound complete replay verifies" (verify-certified-continuation result initial 1/2 1/2 128))
(check "old snapshot remains at starting time" (= (vector-ref (certified-continuation-enclosure initial) 0) 0))
(define reverse-result (certified-continuation-advance final 0 1/4 128))
(check "reverse traversal reaches starting parameter" (eq? (vector-ref reverse-result 1) 'complete))
(check "reverse traversal retains selected branch" (contains? (vector-ref (vector-ref (certified-continuation-enclosure (vector-ref reverse-result 2)) 1) 0) 1))
(define exhausted (certified-continuation-advance initial 1/2 1/2 1))
(check "bounded refusal retains a certified prefix" (and (eq? (vector-ref exhausted 1) 'partial)
  (= (vector-ref (certified-continuation-enclosure (vector-ref exhausted 2)) 0) 0)))
(check "partial replay verifies without asserting completion" (verify-certified-continuation exhausted initial 1/2 1/2 1))
;; Both endpoints admit simple roots but an interior collision blocks connection.
(define singular (make-certified-polynomial-system '(x) '(t) '((- (* x x) (* t t)))))
(define before (make-certified-continuation singular -1 (vector 1) (vector 1/32) (vector (vector 1/2))))
(define collision (certified-continuation-advance before 1 2 12))
(check "interior collision cannot be skipped" (eq? (vector-ref collision 1) 'partial))
(check "collision prefix never crosses zero" (< (vector-ref (certified-continuation-enclosure (vector-ref collision 2)) 0) 0))
(define forged (vector-copy result)) (vector-set! forged 3 '())
(check "edited whole-step chain refuses" (not (verify-certified-continuation forged initial 1/2 1/2 128)))
(check "different target refuses old result" (not (verify-certified-continuation result initial 1/4 1/2 128)))
(check "zero budget performs no attempts" (= (vector-ref (certified-continuation-advance initial 1 1 0) 4) 0))
(check "zero maximum step refuses" (raises? (lambda () (certified-continuation-advance initial 1 0 4))))
(check "unresolved starting root refuses" (raises? (lambda () (make-certified-continuation singular 0 (vector 0) (vector 1) (vector (vector 1))))))
(define edited-start (vector-copy initial))
(vector-set! edited-start 2 99)
(check "edited start cannot borrow an old root certificate" (not (verify-certified-continuation result edited-start 1/2 1/2 128)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
