;; Q1 uses the ordinary region -> qapply-circuit -> qmeasure -> backend path.
(require core.quantum.register)
(define (q1-check name ok)
  (if (not ok) (error (string-append "FAIL: " name))))
(define q1-apply (vector-ref statevector-backend 4))
(define q1-calls 0)
(define q1-delivery '())
(define q1-region #f)
(define q1-register #f)
(define q1-before #f)
(define q1-state-box #f)
(define q1-at-entry #f)
(define q1-after-check (lambda () #t))
(define q1-fail-backend #f)
(define q1-source '((Sdg 1) (CNOT 0 1) (S 1) (CNOT 0 1)))
(define (q1-snapshot region)
  (let ((copy (lambda (xs) (map (lambda (g) (map (lambda (x) x) g)) xs)))
        (layout (vector-ref region 11)))
    (list (copy (vector-ref region 5)) (and layout (vector->list layout))
          (copy (qregion-gate-log region))
          (vector->list (vector-ref (quantum-region-state region) 0)))))
(define (q1-record state width gates)
  (set! q1-calls (+ q1-calls 1))
  (set! q1-at-entry (q1-snapshot q1-region))
  (q1-after-check)
  (set! q1-delivery gates)
  (if q1-fail-backend
      (begin (vector-set! (vector-ref state 0) 0 17)
             (error "Q1 simulated backend failure")))
  (q1-apply state width gates))
(define (q1-run gates optimize?)
  (set! q1-calls 0)
  (set! q1-delivery '())
  (set! q1-at-entry #f)
  (set-quantum-region-options! (list (cons 'optimize optimize?) (cons 'seed 1)))
  (guard (e (#t (if (error-object? e) (error-object-message e) "unexpected non-error object")))
    (call-with-quantum-region
     (lambda (r)
       (set! q1-region r)
       (let ((q (qapply-circuit (qalloc r 2) (make-qcircuit 2 gates))))
         (set! q1-register q)
         (set! q1-before (q1-snapshot r))
         (set! q1-state-box (quantum-region-state r))
         (qmeasure q)
         'executed)))))
(define (q1-success gates optimize? expected)
  (let ((result (q1-run gates optimize?)))
    (q1-check "region execution" (eq? result 'executed))
    (q1-check "stable state handle" (eq? q1-state-box (quantum-region-state q1-region)))
    (q1-check "one backend call" (= 1 q1-calls))
    (q1-check "no publication at backend entry" (equal? q1-before q1-at-entry))
    (q1-check "backend tape" (equal? q1-delivery expected))
    (q1-check "logged tape" (equal? (qregion-gate-log q1-region) expected))
    (q1-check "pending cleared" (null? (vector-ref q1-region 5)))))
(define (q1-rejection message expected-calls)
  (let ((result (q1-run q1-source #t)))
    (q1-check "specific rejection" (equal? result message))
    (q1-check "backend call count on failure" (= expected-calls q1-calls))
    (q1-check "region rollback" (equal? q1-before (q1-snapshot q1-region)))
    (q1-check "register still live" (qreg-live? q1-register))))

(vector-set! statevector-backend 4 q1-record)
(q1-success q1-source #t '((CZ 0 1) (S 0)))
(q1-success '((Sdg 0) (CNOT 1 0) (S 0) (CNOT 1 0)) #t '((CZ 1 0) (S 1)))
(q1-success q1-source #f q1-source)
(q1-success '((RX 0 0.25) (RX 0 -0.25)) #t '((RX 0 0.25) (RX 0 -0.25)))
;; T X T differs from X by a scalar. The ordinary optimizer may return X.
(q1-success '((T 0) (X 0) (T 0)) #t '((T 0) (X 0) (T 0)))
(set! q1-fail-backend #t)
(q1-rejection "Q1 simulated backend failure" 1)
(set! q1-fail-backend #f)
;; The release replay injects emitter faults here in a disposable source tree.
(vector-set! statevector-backend 4 q1-apply)
(display "PASS: quantum_authority_test") (newline)
(display "RESULT: PASS") (newline)
