(require stdlib)
(require core.ad.incremental_reverse)
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define checks 0)
(define (check label ok)
  (if (not ok) (begin (display "FAIL: ") (display label) (newline) (exit 1)))
  (set! checks (+ checks 1)))
(define (rational-vector xs)
  (list->vector (map algebraic-rational (vector->list xs))))
(define (view state) (incremental-pullback-output state))
(define initial (make-incremental-pullback field '(x y)
  '((* p x y) (+ sum x y) (inverse reciprocal sum)) '(p p x reciprocal)
  (vector 1/2 -3/2) (vector 2 -3 5 7)))
;; Independent calculus: L=-xy+5x+7/(x+y).
(check "repeated and direct output primals" (equal? (rational-vector (vector-ref (view initial) 0))
  (vector -3/4 -3/4 1/2 -1)))
(check "closed form original cotangents" (equal? (rational-vector (vector-ref (view initial) 1))
  (vector -1/2 -15/2)))
(define step (incremental-pullback-step initial '((0 1/2) (1 2)) '((0 1) (2 -2) (3 -4))))
(define next (vector-ref step 0))
;; Now x=1,y=1/2; repeated product seeds cancel and L=3x+3/(x+y).
(check "simultaneous edit outputs" (equal? (rational-vector (vector-ref (view next) 0))
  (vector 1/2 1/2 1 2/3)))
(check "seed alias cancellation and direct input seed" (equal? (rational-vector (vector-ref (view next) 1))
  (vector 5/3 -4/3)))
(check "independent primal delta" (equal? (rational-vector (vector-ref step 1))
  (vector 5/4 5/4 1/2 5/3)))
(check "independent cotangent delta" (equal? (rational-vector (vector-ref step 2))
  (vector 13/6 37/6)))
(define seeded (incremental-pullback-step next '() '((1 1))))
(check "uncancel one repeated seed" (equal? (rational-vector (vector-ref (view (vector-ref seeded 0)) 1))
  (vector 13/6 -1/3)))
(check "seed only avoids forward arithmetic" (= (vector-ref (vector-ref seeded 3) 0) 0))
(check "history original intact" (equal? (rational-vector (vector-ref (view initial) 1))
  (vector -1/2 -15/2)))
(check "history successor intact" (equal? (rational-vector (vector-ref (view next) 1))
  (vector 5/3 -4/3)))
(check "nonunit update refuses" (guard (e (else #t))
  (incremental-pullback-step initial '((1 1)) '()) #f))
(check "failed edit preserves retained point" (equal? (rational-vector (vector-ref (view initial) 0))
  (vector -3/4 -3/4 1/2 -1)))
(display "Checks: ") (display checks) (newline) (display "RESULT: PASS") (newline)
