(require stdlib)
(require agent.crypto)
(define passed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (error name)))
(define nul (string (integer->char 0)))
(define unicode-data (string-append "λ" nul "🙂"))
(check "sha empty" (string=? (sha256 "") "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))
(check "sha abc" (string=? (sha256 "abc") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))
(check "sha blocks" (string=? (sha256 (make-string 1000 #\a)) "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3"))
(check "sha utf8 NUL" (string=? (sha256 unicode-data) "7ba6ffc4ade251241d0c5f18256ea72b37e23213b4f61ae3cf36db5e5325503e"))
(check "hmac empty" (string=? (hmac-sha256 "" "") "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad"))
(check "hmac ASCII" (string=? (hmac-sha256 "key" "The quick brown fox jumps over the lazy dog") "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"))
(check "hmac long key" (string=? (hmac-sha256 (make-string 100 #\k) unicode-data) "cd0fd5ad60ac800cf93270f8f8aa259681f124ed44f765fd2bcb4f79eef301b7"))
(check "hmac utf8 NUL key" (string=? (hmac-sha256 unicode-data "abc") "584bd1de5d94c9a5b2ce48b1581f7d7a8c4e3c9c7bd5028cdd0264cdcf44073e"))
(define entropy (random-bytes 32))
(check "native random-byte length" (= (string-byte-length entropy) 32))
(define hex (random-hex 32))
(check "native random-hex length" (= (string-length hex) 32))
(check "native random-hex alphabet" (let loop ((i 0)) (or (= i 32) (and (let ((c (string-ref hex i))) (or (and (char>=? c #\0) (char<=? c #\9)) (and (char>=? c #\a) (char<=? c #\f)))) (loop (+ i 1))))))
(define uuid (uuid-v4))
(check "uuid version" (and (= (string-length uuid) 36) (char=? (string-ref uuid 14) #\4)))
(display "Checks: ") (display passed) (newline)
(display "RESULT: PASS\n")
