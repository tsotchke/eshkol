(require core.quantum.qec)
(define checks 0)
(define (check name ok) (if (not ok) (begin (display "FAIL ") (write name) (newline) (error "QEC check failed"))) (set! checks (+ checks 1)))
(define (refuses? f) (guard (e (else #t)) (f) #f))
(define (letters s)
  (map (lambda (c) (string->symbol (string c)))
    (string->list (if (or (char=? (string-ref s 0) #\-) (char=? (string-ref s 0) #\+)) (substring s 1 (string-length s)) s))))
(for-each (lambda (code)
  (let* ((n (qec-code-width code)) (gs (qec-code-checks code))
         (c (stabilizer-prepare n gs)) (state (qcircuit-run c)) (cert (qec-certificate code)))
    (check 'preparation (verify-stabilizer-preparation n gs c))
    (check 'decoder (verify-qec-certificate cert n gs))
    (for-each (lambda (s) (check 'native-circuit-consumer (< (abs (- (qstate-pauli-expectation n state (letters s)) 1.0)) 1e-10))) gs)
    (check 'norm (< (abs (- (qstate-norm2 state) 1.0)) 1e-10))
    (check 'missing-table (not (verify-qec-certificate (vector 'qec-decoder-v1 n gs '()) n gs)))
    (check 'source-binding (not (verify-qec-certificate cert (+ n 1) gs)))
    (display "CODE ") (write (list n gs (qcircuit-gates c) cert)) (newline)))
  (list (steane-qec) (shor-qec) (surface-d3-qec)))
(check 'negative-y (verify-stabilizer-preparation 1 '("-Y") (stabilizer-prepare 1 '("-Y"))))
(check 'signed-replay-refuses (not (verify-stabilizer-preparation 1 '("-Y") (stabilizer-prepare 1 '("Y")))))
(check 'anticommuting (refuses? (lambda () (stabilizer-prepare 1 '("X" "Z")))))
(check 'derived-minus-identity (refuses? (lambda () (stabilizer-prepare 2 '("XX" "ZZ" "YY")))))
(check 'non-hermitian (refuses? (lambda () (stabilizer-prepare 1 '("+iX")))))
(check 'wrong-width (refuses? (lambda () (make-qec-code 2 '("X")))))
(check 'empty-invalid-width (refuses? (lambda () (make-qec-code 0 '()))))
(check 'dependent (verify-stabilizer-preparation 2 '("XX" "ZZ" "-YY") (stabilizer-prepare 2 '("XX" "ZZ" "-YY"))))
(check 'uncorrectable-code (not (verify-qec-certificate (qec-certificate (make-qec-code 3 '("ZZI" "IZZ"))) 3 '("ZZI" "IZZ"))))
(display "PASS quantum_qec ") (display checks) (newline)
