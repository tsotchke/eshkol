(require stdlib)
(require core.ad.incremental_reverse)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define same? (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define (family size)
  (let ((decls '((constant one 1) (* hot x x))) (last 'cold))
    (let loop ((i 0)) (if (< i size)
      (let ((name (string->symbol (string-append "cold-" (number->string i)))))
        (set! decls (append decls (list (list '+ name last 'one)))) (set! last name) (loop (+ i 1)))))
    (make-incremental-pullback field '(x cold) decls (list 'hot last) (vector 2 1) (vector 1 1))))
(define small (family 1)) (define large (family 1000))
(define s (incremental-pullback-step small '((0 1)) '()))
(define l (incremental-pullback-step large '((0 1)) '()))
(check "sparse receipt has seven explicit counters" (= (vector-length (vector-ref l 3)) 7))
(check "1000 cold nodes add no tick slots or queue visits" (and
  (= (vector-ref (vector-ref s 3) 3) (vector-ref (vector-ref l 3) 3))
  (= (vector-ref (vector-ref s 3) 4) (vector-ref (vector-ref l 3) 4))
  (<= (abs (- (vector-ref (vector-ref s 3) 5) (vector-ref (vector-ref l 3) 5))) 22)))
(define current large)
(let ticks ((i 0)) (if (< i 64)
  (let* ((step (incremental-pullback-step current '((0 1/16)) '((0 1/32))))
         (next (vector-ref step 0)) (view (incremental-pullback-output next))
         (x (+ 2 (/ (+ i 1) 16))) (seed (+ 1 (/ (+ i 1) 32))) (work (vector-ref step 3)))
    (check "each prefix matches independent square value" (same? (vector-ref (vector-ref view 0) 0) (* x x)))
    (check "each simultaneous prefix matches analytic cotangent" (same? (vector-ref (vector-ref view 1) 0) (* 2 x seed)))
    (check "cold cotangent unchanged" (same? (vector-ref (vector-ref view 1) 1) 1))
    (check "bounded touched-node and trie work" (and (<= (vector-ref work 4) 4) (< (vector-ref work 3) 500) (< (vector-ref work 5) 900)))
    (set! current next) (ticks (+ i 1)))))
(check "initial history still owned" (same? (vector-ref (vector-ref (incremental-pullback-output large) 0) 0) 4))
(define fork (vector-ref (incremental-pullback-step large '((0 -1)) '((0 2))) 0))
(check "fork from old tree has independent cotangent" (same? (vector-ref (vector-ref (incremental-pullback-output fork) 1) 0) 6))
(define repeated (make-incremental-pullback field '(x) '((* square x x)) '(square square) (vector 2) (vector 2 3)))
(define moved (vector-ref (incremental-pullback-step repeated '((0 1)) '((0 1))) 0))
(check "duplicate parents and targets retain cross terms" (same? (vector-ref (vector-ref (incremental-pullback-output moved) 1) 0) 36))
(define empty (incremental-pullback-step current '((0 1) (0 -1)) '()))
(check "cancellation copies no nodes or work sets" (and (= (vector-ref (vector-ref empty 3) 3) 0) (= (vector-ref (vector-ref empty 3) 4) 0)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
