(require stdlib)
(require core.ad.derived_operator)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define op (make-derived-operator '(x y) '(+ (* x x) (* x y))))
(check "forward definition" (= (derived-operator-value op (vector 2 3)) 10))
(check "generated gradient" (equal? (vector->list (derived-operator-vjp op (vector 2 3) 1)) '(7 2)))
(check "generated directional derivative" (= (derived-operator-jvp op (vector 2 3) (vector 1 -2)) 3))
(check "finite changes retain all cross terms" (= (derived-operator-delta op (vector 2 3) (vector 1 -2)) 2))
(check "derivative differs from finite update" (not (= (derived-operator-jvp op (vector 2 3) (vector 1 -2))
                                                      (derived-operator-delta op (vector 2 3) (vector 1 -2)))))
(define (forward x y) (+ (* x x) (* x y)))
(for-each (lambda (point)
  (for-each (lambda (delta)
    (let* ((x (car point)) (y (cadr point)) (dx (car delta)) (dy (cadr delta))
           (p (vector x y)) (d (vector dx dy)) (seed 3/7)
           (vjp (derived-operator-vjp op p seed)))
      (check "batch finite-update identity" (= (derived-operator-delta op p d)
        (- (forward (+ x dx) (+ y dy)) (forward x y))))
      (check "JVP/VJP adjoint pairing" (= (* seed (derived-operator-jvp op p d))
        (+ (* (vector-ref vjp 0) dx) (* (vector-ref vjp 1) dy))))
      (check "independent analytic JVP" (= (derived-operator-jvp op p d) (+ (* (+ (* 2 x) y) dx) (* x dy))))))
    '((0 0) (1 -2) (2/3 3/5) (-3 1)))) '((0 0) (2 3) (-1 7/3) (5/4 -9/7)))
(define product (make-derived-operator '(x y z) '(* (* x y) z)))
(check "triple finite change includes cubic term" (= (derived-operator-delta product (vector 0 0 0) (vector 2 3 4)) 24))
(define scaled (make-derived-operator '(u) '(/ (- (pow u 4) 2) 3)))
(check "constant division and power derivative" (= (vector-ref (derived-operator-vjp scaled (vector 2) 1) 0) 32/3))
(check "polynomial compiler AD compatibility" (= (derivative (lambda (u) (derived-operator-value scaled (vector u))) 2) 32/3))
(define names (list 'x))
(define syntax (list '* 'x 'x))
(define owned (make-derived-operator names syntax))
(set-car! names 'other) (set-car! syntax 'malicious)
(check "operator does not retain mutable source syntax" (= (derived-operator-value owned (vector 3)) 9))
(define bars (derived-operator-vjp op (vector 2 3) 1)) (vector-set! bars 0 999)
(check "returned cotangents are isolated" (= (vector-ref (derived-operator-vjp op (vector 2 3) 1) 0) 7))
(define info (derived-operator-info op)) (vector-set! info 0 999)
(check "returned metadata are isolated" (= (vector-ref (derived-operator-info op) 0) 2))
(for-each (lambda (f) (check "unsupported and malformed definitions refuse" (raises? f)))
  (list (lambda () (make-derived-operator '(x x) 'x))
        (lambda () (make-derived-operator '(x) 'y))
        (lambda () (make-derived-operator '(x) '(sin x)))
        (lambda () (make-derived-operator '(x) '(set! x 1)))
        (lambda () (make-derived-operator '(x) '(/ x x)))
        (lambda () (make-derived-operator '(x) '(/ x 0)))
        (lambda () (make-derived-operator '(x) '(pow x 9)))
        (lambda () (make-derived-operator '(x) '(* (pow x 8) x)))
        (lambda () (make-derived-operator '(x) '(+ x 1.0)))
        (lambda () (derived-operator-value op (vector 1)))
        (lambda () (derived-operator-jvp op (vector 1 2) (vector 1)))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
