(require stdlib)
(require core.dbsp.circuit)
(require core.data.radix)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define integers (make-dbsp-group (lambda () 0) + - (lambda (x) (= x 0))))
(define (row-key row) (car row))
(define (row-value row) (cadr row))
(define (emit key value) (list key value))
(define (make-sum group emitter)
  (make-dbsp-circuit '(rows) (list (list 'aggregate 'out 'rows row-key row-value group emitter)) 'out))
(define empty (make-sum integers emit))
(define seeded (car (dbsp-circuit-step empty (list (list 'rows
  (zset-from-weighted '((2 (a 3)) (-1 (a 4)) (1 (b 7)))))))))
(check "signed weighted groups" (zset=? (dbsp-circuit-output seeded)
  (zset-from-weighted '((1 (a 2)) (1 (b 7))))))
(define replacement (dbsp-circuit-step seeded
  (list (list 'rows (zset-from-weighted '((-2 (a 3)) (2 (a 5))))))))
(check "one retraction and insertion per changed aggregate" (zset=? (cdr replacement)
  (zset-from-weighted '((-1 (a 2)) (1 (a 6))))))
(check "old groups survive replacement" (zset=? (dbsp-circuit-output seeded)
  (zset-from-weighted '((1 (a 2)) (1 (b 7))))))
(define removed (car (dbsp-circuit-step seeded (list (list 'rows
  (zset-from-weighted '((-2 (a 3)) (1 (a 4)))))))))
(check "zero sum removes group" (zset=? (dbsp-circuit-output removed) (zset-singleton '(b 7) 1)))
(define negative (car (dbsp-circuit-step empty (list (list 'rows (zset-singleton '(a 3) -2))))))
(check "negative aggregate values retained" (zset=? (dbsp-circuit-output negative) (zset-singleton '(a -6) 1)))
(define zero-count (car (dbsp-circuit-step empty (list (list 'rows
  (zset-from-weighted '((1 (a 5)) (-1 (a 2)))))))))
(check "zero total multiplicity does not erase nonzero value"
  (zset=? (dbsp-circuit-output zero-count) (zset-singleton '(a 3) 1)))
(define emit-calls 0)
(define counted (make-sum integers (lambda (key value) (set! emit-calls (+ emit-calls 1)) (list key value))))
(define cancelled (dbsp-circuit-step counted (list (list 'rows
  (zset-from-weighted '((1 (a 2)) (1 (a 3)) (-1 (a 5))))))))
(check "per-key cancellation emits no intermediate state"
  (and (= emit-calls 0) (zset-empty? (cdr cancelled)) (zset-empty? (dbsp-circuit-output (car cancelled)))))
(define big (car (dbsp-circuit-step empty (list (list 'rows (zset-singleton '(a 1) 9223372036854775808))))))
(check "bignum weights use binary scaling" (zset=? (dbsp-circuit-output big)
  (zset-singleton (list 'a 9223372036854775808) 1)))
;; #f is a NONZERO value in this presentation of the two-element group.
(define false-group (make-dbsp-group (lambda () #t) eq? (lambda (x) x) (lambda (x) x)))
(define false-sum (car (dbsp-circuit-step (make-sum false-group emit)
  (list (list 'rows (zset-singleton '(a #f) 1))))))
(check "false nonidentity group value survives storage" (zset=? (dbsp-circuit-output false-sum)
  (zset-singleton '(a #f) 1)))
(define false-zero (car (dbsp-circuit-step false-sum (list (list 'rows (zset-singleton '(a #f) 1))))))
(check "false-valued group obeys cancellation" (zset-empty? (dbsp-circuit-output false-zero)))
(define collisions (car (dbsp-circuit-step empty (list (list 'rows
  (zset-from-weighted '((1 ("Aa" 3)) (1 ("B@" 5)))))))))
(check "colliding keys retain independent sums" (zset=? (dbsp-circuit-output collisions)
  (zset-from-weighted '((1 ("Aa" 3)) (1 ("B@" 5))))))
(define downstream (make-dbsp-circuit '(rows) (list
  (list 'aggregate 'sum 'rows row-key row-value integers emit)
  (list 'map 'out 'sum (lambda (row) (* 2 (cadr row))))) 'out))
(define d1 (dbsp-circuit-step downstream (list (list 'rows (zset-singleton '(a 4) 1)))))
(define d2 (dbsp-circuit-step (car d1) (list (list 'rows (zset-singleton '(a 1) 1)))))
(check "downstream receives signed replacement" (and
  (zset=? (cdr d2) (zset-from-weighted '((-1 8) (1 10))))
  (zset=? (dbsp-circuit-output (car d2)) (zset-singleton 10 1))))
(define collapsed (make-sum integers (lambda (key value) 'same)))
(define c1 (car (dbsp-circuit-step collapsed (list (list 'rows (zset-singleton '(a 1) 1))))))
(define c2 (dbsp-circuit-step c1 (list (list 'rows (zset-singleton '(a 2) 1)))))
(check "colliding emitted rows cancel while group cache advances" (and
  (zset-empty? (cdr c2)) (= (zset-weight (dbsp-circuit-output (car c2)) 'same) 1)))
(define c3 (dbsp-circuit-step (car c2) (list (list 'rows (zset-singleton '(a 3) -1)))))
(check "hidden aggregate change retained for later cancellation"
  (zset-empty? (dbsp-circuit-output (car c3))))

;; Declarations and group descriptors are owned by the compiled circuit.
(define owned-group (make-dbsp-group (lambda () 0) + - zero?))
(define owned-spec (list 'aggregate 'out 'rows row-key row-value owned-group emit))
(define owned-circuit (make-dbsp-circuit '(rows) (list owned-spec) 'out))
(set-car! (list-tail owned-spec 3) (lambda (row) 'wrong))
(vector-set! owned-group 2 (lambda (a b) 99))
(check "caller mutation cannot rewrite compiled aggregate declaration" (zset=?
  (dbsp-circuit-output (car (dbsp-circuit-step owned-circuit
    (list (list 'rows (zset-singleton '(a 3) 1)))))) (zset-singleton '(a 3) 1)))

(define lifts 0)
(define (stored-group runtime key)
  (let ((state (radix-ref (vector-ref runtime 4) 1 #f)))
    (radix-fold (vector-ref state 1)
      (lambda (hash bucket found) (or (assoc key bucket) found)) #f)))
(define cold (make-dbsp-circuit '(rows) (list (list 'aggregate 'out 'rows car
  (lambda (r) (set! lifts (+ lifts 1)) (cadr r)) integers emit)) 'out))
(for-each (lambda (n)
  (let* ((seed (zset-from-weighted (let rows ((i 0) (out '()))
                  (if (= i n) out (rows (+ i 1) (cons (list 1 (list i 1)) out))))))
         (warm (car (dbsp-circuit-step cold (list (list 'rows seed))))))
    (set! lifts 0)
    (let ((next (dbsp-circuit-step warm (list (list 'rows (zset-singleton '(0 2) 1))))))
      (check "one changed key invokes one lift despite cold groups" (= lifts 1))
      (check "cold group values are physically shared"
        (eq? (cdr (stored-group warm 1)) (cdr (stored-group (car next) 1))))
      (check "fixed key update produces only its replacement"
        (zset=? (cdr next) (zset-from-weighted '((-1 (0 1)) (1 (0 3))))))))) '(16 512))

;; Independent batch oracle over signed rows, with known three-key domain.
(define (batch rows)
  (zset-from-weighted (fold-left (lambda (out key)
    (let ((total (fold-left (lambda (s e) (if (eq? (caadr e) key)
      (+ s (* (car e) (cadadr e))) s)) 0 (zset-entries rows))))
      (if (= total 0) out (cons (list 1 (list key total)) out)))) '() '(a b c))))
(define current empty)
(define rows (zset-empty))
(define integrated (zset-empty))
(define parity #t)
(let ticks ((i 0))
  (if (< i 60)
      (let* ((delta (zset-from-weighted (list
              (list (- (modulo i 5) 2) (list (list-ref '(a b c) (modulo i 3)) (- (modulo i 9) 4)))
              (list -1 (list (list-ref '(a b c) (modulo (+ i 1) 3)) 2)))))
             (tick (dbsp-circuit-step current (list (list 'rows delta)))))
        (set! current (car tick)) (set! rows (zset-add rows delta))
        (set! integrated (zset-add integrated (cdr tick)))
        (if (not (and (zset=? (dbsp-circuit-output current) (batch rows))
                      (zset=? integrated (batch rows)))) (set! parity #f))
        (ticks (+ i 1)))))
(check "60 signed prefixes match independent batch and integrated deltas" parity)
(check "fork remains independent" (zset-empty? (dbsp-circuit-output empty)))

(define refusing (make-sum integers (lambda (key value)
  (if (= value 99) (error "deliberate aggregate emit failure") (list key value)))))
(check "emit failure refuses publication" (raises? (lambda ()
  (dbsp-circuit-step refusing (list (list 'rows (zset-singleton '(a 99) 1)))))))
(check "failed snapshot reusable" (and (zset-empty? (dbsp-circuit-output refusing))
  (zset=? (dbsp-circuit-output (car (dbsp-circuit-step refusing
    (list (list 'rows (zset-singleton '(a 4) 1)))))) (zset-singleton '(a 4) 1))))
(check "bad group identity refused" (raises? (lambda ()
  (make-dbsp-group (lambda () 1) + - zero?))))
(check "nonprocedure group operation refused" (raises? (lambda ()
  (make-dbsp-group 0 + - zero?))))
(check "malformed aggregate refused" (raises? (lambda ()
  (make-dbsp-circuit '(rows) (list (list 'aggregate 'out 'rows row-key)) 'out))))
(check "foreign group refused" (raises? (lambda () (make-sum (vector 0) emit))))
(check "nonprocedure aggregate callback refused" (raises? (lambda ()
  (make-dbsp-circuit '(rows) (list (list 'aggregate 'out 'rows 0 row-value integers emit)) 'out))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: dbsp_aggregate_test") (newline)
(display "RESULT: PASS") (newline)
