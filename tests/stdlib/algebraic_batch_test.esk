(require stdlib)
(require core.algebraic_batch)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 0 1) 7 0))
(define alpha (algebraic-generator field))
(define (compare owner left right)
  (let* ((domain (algebraic-domain owner)) (plan (make-algebraic-multiplication-plan owner))
         (result (algebraic-batch-mul plan left right)) (outputs (vector-ref result 0))
         (mul (algebraic-domain-ref domain 'mul)) (equal? (algebraic-domain-ref domain 'equal?)))
    (let loop ((i 0)) (if (< i (vector-length left))
      (begin (check "packed product equals independent generic field/carrier product"
        (equal? (vector-ref outputs i) (mul (vector-ref left i) (vector-ref right i)))) (loop (+ i 1)))))
    result))
(define plain (compare field
  (vector (algebraic-element field '(1/2 -1/3 1/5)) alpha (algebraic-element field -7))
  (vector (algebraic-element field '(-2/5 1/2 3/4)) alpha (algebraic-element field 3))))
(check "field defining equation is preserved in packed multiplication"
  (algebraic-equal? (vector-ref (vector-ref plain 0) 1) (algebraic-mul alpha alpha)))
(define hyper (make-algebraic-hyperdual field))
(define ha (algebraic-ad-value hyper (list alpha 1/2 (algebraic-add alpha (algebraic-element field 1)) -1/3)))
(define hb (algebraic-ad-value hyper (list (algebraic-inverse alpha) 2 -1/2 alpha)))
(define hr (compare hyper (vector ha hb) (vector hb ha)))
(check "batch receipt counts one packed kernel call"
  (and (eq? (vector-ref (vector-ref hr 1) 0) 'native-scheme-integer)
       (= (vector-ref (vector-ref hr 1) 1) 2) (= (vector-ref (vector-ref hr 1) 2) 12)
       (= (vector-ref (vector-ref hr 1) 6) 1)))
(define taylor (make-algebraic-taylor field 4))
(define jet (algebraic-ad-value taylor (list alpha 1/2 -1/3 1/5 -1/7)))
(compare taylor (vector jet) (vector (algebraic-ad-constant taylor alpha)))
(define quadratic (make-algebraic-field '(-2 0 1) 3 1))
(define outer (make-algebraic-taylor quadratic 1))
(define inner (make-algebraic-hyperdual outer))
(define nested (algebraic-ad-value inner
  (list (algebraic-ad-seed outer 2) 1/2 (algebraic-ad-seed outer 3) -1)))
(compare inner (vector nested) (vector nested))
(define empty (algebraic-batch-mul (make-algebraic-multiplication-plan hyper) (vector) (vector)))
(check "empty batch makes no kernel call"
  (and (= (vector-length (vector-ref empty 0)) 0) (= (vector-ref (vector-ref empty 1) 6) 0)))
(define plan (make-algebraic-multiplication-plan field))
(define left (vector (algebraic-element field 3/7)))
(define saved (algebraic-batch-mul plan left (vector (algebraic-element field -2/5))))
(vector-set! (vector-ref (vector-ref left 0) 2) 0 99)
(check "batch results own restored rational coefficients"
  (= (algebraic-rational (vector-ref (vector-ref saved 0) 0)) -6/35))
(define max-result (algebraic-batch-mul plan (vector (algebraic-element field 2147483647))
  (vector (algebraic-element field 1))))
(check "signed-32-bit upper boundary executes exactly"
  (= (algebraic-rational (vector-ref (vector-ref max-result 0) 0)) 2147483647))
(define foreign (make-algebraic-field '(-3 0 1) 5 1))
(for-each (lambda (thunk) (check "packed admission refuses contamination/overflow/budget" (raises? thunk)))
  (list
    (lambda () (algebraic-batch-mul plan (vector 1) (vector)))
    (lambda () (algebraic-batch-mul plan (vector 1.0) (vector 1)))
    (lambda () (algebraic-batch-mul plan (vector (algebraic-generator foreign)) (vector 1)))
    (lambda () (algebraic-batch-mul plan (vector 2147483648) (vector 1)))
    (lambda () (algebraic-batch-mul plan (vector 65536) (vector 65536)))
    (lambda () (algebraic-batch-mul plan (vector 1/65536) (vector 1/65536)))
    (lambda () (algebraic-batch-mul plan (vector 1 65536) (vector 1 65536)))
    (lambda () (make-algebraic-multiplication-plan hyper 11))
    (lambda () (make-algebraic-multiplication-plan hyper 65))
    (lambda () (make-algebraic-multiplication-plan hyper 12.0))
    (lambda () (make-algebraic-multiplication-plan (make-algebraic-taylor field 16) 32))
    (lambda () (algebraic-batch-mul (make-algebraic-multiplication-plan hyper)
      (vector (algebraic-ad-seed (make-algebraic-hyperdual field) 1)) (vector ha)))))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
