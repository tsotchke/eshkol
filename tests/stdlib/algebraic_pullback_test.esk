(require stdlib)
(require core.ad.algebraic_pullback)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define a (algebraic-generator field))
(define d (algebraic-domain field)) (define same (algebraic-domain-ref d 'equal?))
(define matrix (vector (vector 0 2) (vector 3 4)))
(define factor (algebraic-factor field matrix))
(define transposed (algebraic-factor-solve-transpose factor (vector 5 6)))
(check "transpose solve includes row permutation" (and (same (vector-ref transposed 0) -1/3) (same (vector-ref transposed 1) 5/3)))
(define record (algebraic-solve-with-pullback field matrix (vector 2 7)))
(define pull (vector-ref record 1)) (define bars (pull (vector 5 6)))
(check "forward known solution" (and (same (vector-ref (vector-ref record 0) 0) 1) (same (vector-ref (vector-ref record 0) 1) 1)))
(check "one retained bottom LU" (equal? (vector->list (vector-ref record 2)) '(2 0 1)))
(check "RHS adjoint" (and (same (vector-ref (vector-ref bars 1) 0) -1/3) (same (vector-ref (vector-ref bars 1) 1) 5/3)))
(check "matrix adjoint outer product" (and (same (vector-ref (vector-ref (vector-ref bars 0) 0) 1) 1/3) (same (vector-ref (vector-ref (vector-ref bars 0) 1) 0) -5/3)))
(define zero-bars (pull (vector 0 0)))
(check "zero vector seed" (and (same (vector-ref (vector-ref zero-bars 1) 0) 0) (same (vector-ref (vector-ref (vector-ref zero-bars 0) 1) 1) 0)))
(vector-set! (vector-ref matrix 1) 0 99)
(vector-set! (vector-ref (vector-ref record 0) 0) 2 (vector 77 0))
(vector-set! (vector-ref (vector-ref bars 1) 0) 2 (vector 66 0))
(check "retained solve owns matrix solution and returned bars" (same (vector-ref (vector-ref (pull (vector 5 6)) 1) 1) 5/3))
(define (fit-function tape xs)
  (let* ((theta (vector-ref xs 0)) (zero (algebraic-reverse-constant tape 0))
         (one (algebraic-reverse-constant tape 1)) (two (algebraic-reverse-constant tape 2))
         (three (algebraic-reverse-constant tape 3)) (four (algebraic-reverse-constant tape 4))
         (answer (algebraic-reverse-solve tape (vector (vector theta one) (vector zero two)) (vector three four))))
    (algebraic-reverse-add tape (algebraic-reverse-pow tape (vector-ref answer 0) 2) (vector-ref answer 1))))
(define h (algebraic-hvp field fit-function (vector a) (vector 3)))
(check "solve reverse gradient closed form" (same (vector-ref (vector-ref h 1) 0) (algebraic-scale a -1/2)))
(check "solve HVP closed form" (same (vector-ref (vector-ref h 0) 0) 9/2))
(for-each (lambda (theta)
  (let* ((r (algebraic-value-and-pullback field fit-function (vector theta)))
         (g ((vector-ref r 1) 1)) (v (algebraic-hvp field fit-function (vector theta) (vector 2))))
    (check "independent reciprocal-square objective" (same (vector-ref r 0) (+ 2 (/ 1 (* theta theta)))))
    (check "independent solver gradient grid" (same (vector-ref g 0) (/ -2 (* theta theta theta))))
    (check "independent solver curvature grid" (same (vector-ref (vector-ref v 0) 0) (/ 12 (* theta theta theta theta)))))) '(1 2 3 4))
(define multi-calls 0)
(define grouped (algebraic-value-and-pullback field
  (lambda (t xs)
    (let* ((x (vector-ref xs 0)) (out (record-multi-op! t (list x) (list (algebraic-reverse-value t x) (algebraic-scale (algebraic-reverse-value t x) 2))
      (lambda (gs) (set! multi-calls (+ multi-calls 1)) (list (+ (algebraic-rational (car gs)) (* 2 (algebraic-rational (cadr gs)))))))))
      (algebraic-reverse-add t (car out) (cadr out)))) (vector 2)))
(check "grouped outputs yield combined gradient" (same (vector-ref ((vector-ref grouped 1) 1) 0) 3))
(check "grouped outputs call backward once" (= multi-calls 1))
((vector-ref grouped 1) 0)
(check "zero grouped seed skips backward" (= multi-calls 1))
(define equations (vector (list (list 1 (vector 2 0)) (list 1 (vector 0 1)) (list -5 (vector 0 0)))
                         (list (list 1 (vector 1 0)) (list 1 (vector 0 1)) (list -3 (vector 0 0)))))
(define system (algebraic-system-with-pullback field equations (vector 2 1)))
(define cb ((vector-ref system 1) (vector 1 0)))
;; J=[[4,1],[1,1]], J^T lambda=[1,0] => lambda=(1/3,-1/3).
(check "coupled implicit coefficient first row" (and (same (car (vector-ref cb 0)) -4/3) (same (caddr (vector-ref cb 0)) -1/3)))
(check "coupled implicit coefficient second row" (and (same (car (vector-ref cb 1)) 2/3) (same (caddr (vector-ref cb 1)) 1/3)))
(define root-record (algebraic-value-and-pullback field
  (lambda (t xs)
    (let* ((one (algebraic-reverse-constant t 1)) (zero (algebraic-reverse-constant t 0))
           (negative (algebraic-reverse-sub t zero (vector-ref xs 0)))
           (out (algebraic-reverse-system t (vector (list (list one (vector 2)) (list negative (vector 0)))) (vector a))))
      (vector-ref out 0))) (vector 2)))
(check "implicit reverse square-root sensitivity" (same (vector-ref ((vector-ref root-record 1) 1) 0) (algebraic-scale a 1/4)))
(define context (make-algebraic-taylor field 1))
(define c (algebraic-ad-seed context 2))
(define root (algebraic-ad-root context (list (algebraic-ad-sub (algebraic-ad-constant context 0) c) 0 1) a))
(define nested (algebraic-system-with-pullback context
  (vector (list (list 1 (vector 2)) (list (algebraic-ad-sub (algebraic-ad-constant context 0) c) (vector 0)))) (vector root)))
(define coefficient-bar (cadr (vector-ref ((vector-ref nested 1) (vector 1)) 0)))
(check "implicit pullback retains enclosing value" (same (algebraic-ad-derivative coefficient-bar 0) (algebraic-scale a -1/4)))
(check "implicit pullback retains enclosing derivative" (same (algebraic-ad-derivative coefficient-bar 1) (algebraic-scale a 1/16)))
(define jets (algebraic-factor context (vector (vector (algebraic-ad-seed context 2) 1) (vector 0 3))))
(define tj (algebraic-factor-solve-transpose jets (vector 1 0)))
(check "transpose Taylor coefficient recurrence" (and (same (algebraic-ad-derivative (vector-ref tj 0) 1) -1/4) (same (algebraic-ad-derivative (vector-ref tj 1) 1) 1/12)))
(for-each (lambda (thunk) (check "solver refusal" (raises? thunk)))
  (list (lambda () (pull (vector 1)))
    (lambda () (pull (vector 1.0 0)))
    (lambda () (algebraic-solve-with-pullback field (vector (vector 0)) (vector 1)))
    (lambda () (algebraic-system-with-pullback field equations (vector 2 2)))
    (lambda () (algebraic-system-with-pullback field (vector (list (list 1 (vector 2)))) (vector 0)))
    (lambda () (algebraic-factor-solve-transpose factor (vector 1)))
    (lambda () (algebraic-system-linearization field (vector '()) (vector 1 2)))))
(check "failed seed preserves solve reuse" (same (vector-ref (vector-ref (pull (vector 5 6)) 1) 0) -1/3))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
