(require stdlib)
(require core.dbsp.sqlite_changefeed)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (template) (make-dbsp-resumable '(x) '((distinct y x)) 'y '() '(signed-rows-v1)))
(define (batch row weight) (list (list 'x (zset-singleton row weight))))
(with-db ":memory:" (lambda (db)
  (check "create persistent source" (eq? (dbsp-sqlite-create! db "source'λ" (template)) 'created))
  (check "idempotent template open" (eq? (dbsp-sqlite-create! db "source'λ" (template)) 'existing))
  (check "gap rejected" (raises? (lambda () (dbsp-sqlite-enqueue! db "source'λ" 2 (batch 'row 1)))))
  (check "first negative batch queued" (eq? (dbsp-sqlite-enqueue! db "source'λ" 1 (batch 'row -2)) 'queued))
  (check "same replay deduplicated" (eq? (dbsp-sqlite-enqueue! db "source'λ" 1 (batch 'row -2)) 'duplicate))
  (check "conflicting replay rejected" (raises? (lambda () (dbsp-sqlite-enqueue! db "source'λ" 1 (batch 'row 2)))))
  (check "enqueue alone does not integrate" (= (dbsp-resumable-tick (dbsp-sqlite-state db "source'λ" (template))) 0))
  (define first (dbsp-sqlite-consume! db "source'λ" (template)))
  (check "negative hidden count consumed" (and (eq? (vector-ref first 0) 'advanced) (= (dbsp-resumable-tick (vector-ref first 1)) 1)))
  (dbsp-sqlite-enqueue! db "source'λ" 2 (batch 'row 3))
  (sqlite-exec db "CREATE TRIGGER fail_checkpoint BEFORE UPDATE OF consumed ON eshkol_dbsp_stream_v1 BEGIN SELECT RAISE(ABORT,'injected'); END")
  (check "SQLite step error is raised" (raises? (lambda () (dbsp-sqlite-consume! db "source'λ" (template)))))
  (check "failed publish rolls back checkpoint and cursor" (= (dbsp-resumable-tick (dbsp-sqlite-state db "source'λ" (template))) 1))
  (sqlite-exec db "DROP TRIGGER fail_checkpoint")
  (define second (dbsp-sqlite-consume! db "source'λ" (template)))
  (check "retry integrates hidden distinct state once" (= (zset-weight (dbsp-resumable-output (vector-ref second 1)) 'row) 1))
  (check "idle returns no duplicate delta" (let ((idle (dbsp-sqlite-consume! db "source'λ" (template))))
    (and (eq? (vector-ref idle 0) 'idle) (zset-empty? (vector-ref idle 2)))))
  (check "old source replay still deduplicates after consume" (eq? (dbsp-sqlite-enqueue! db "source'λ" 1 (batch 'row -2)) 'duplicate))
  (check "schema mismatch refused" (raises? (lambda () (dbsp-sqlite-state db "source'λ" (make-dbsp-resumable '(x) '((distinct y x)) 'y '() '(changed))))))
  (check "float row refuses before queue commit" (raises? (lambda () (dbsp-sqlite-enqueue! db "source'λ" 3 (batch '(1.0) 1)))))
  (dbsp-sqlite-enqueue! db "source'λ" 3 (batch (list "quote\" newline\n λ" 3/7) 1))
  (check "typed Unicode checkpoint payload roundtrip" (= (dbsp-resumable-tick (vector-ref (dbsp-sqlite-consume! db "source'λ" (template)) 1)) 3))
  (with-statement db "SELECT 42" (lambda (s)
    (check "checked ROW true" (sqlite-step-checked s)) (check "checked DONE false" (not (sqlite-step-checked s)))))
  (with-statement db "SELECT 42" (lambda (s)
    (check "raw code exposes ROW" (= (sqlite-step-code s) SQLITE_ROW)) (check "raw code exposes DONE" (= (sqlite-step-code s) SQLITE_DONE))))
  (with-statement db "SELECT 42" (lambda (s)
    (check "legacy boolean remains compatible" (and (sqlite-step s) (not (sqlite-step s))))))
  (check "bad sequence refuses" (raises? (lambda () (dbsp-sqlite-enqueue! db "source'λ" 4.0 '()))))
  (dbsp-sqlite-enqueue! db "source'λ" 4 (batch 'companion 1))
  (sqlite-exec db "CREATE TABLE outbox(seq INTEGER)")
  (check "companion failure rolls back checkpoint and companion write" (raises? (lambda ()
    (dbsp-sqlite-consume! db "source'λ" (template) (lambda (seq)
      (sqlite-exec db "INSERT INTO outbox VALUES(4)") (error "abort companion"))))))
  (check "companion rollback keeps cursor" (= (dbsp-resumable-tick (dbsp-sqlite-state db "source'λ" (template))) 3))
  (with-statement db "SELECT count(*) FROM outbox" (lambda (stmt)
    (sqlite-step-checked stmt) (check "companion write rolled back" (= (sqlite-column-int stmt 0) 0))))
  (dbsp-sqlite-consume! db "source'λ" (template) (lambda (seq) (check "companion sees staged sequence" (= seq 4))
    (sqlite-exec db "INSERT INTO outbox VALUES(4)")))
  (with-statement db "SELECT count(*) FROM outbox" (lambda (stmt)
    (sqlite-step-checked stmt) (check "companion committed once" (= (sqlite-column-int stmt 0) 1))))
  (dbsp-sqlite-create! db "other" (template))
  (check "source identities isolated" (= (dbsp-resumable-tick (dbsp-sqlite-state db "other" (template))) 0))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
