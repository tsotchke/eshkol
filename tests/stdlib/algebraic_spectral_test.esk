(require stdlib)
(require core.ad.algebraic_spectral)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define same (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define a (algebraic-generator field))
(define domain (algebraic-domain field))
(define add (algebraic-domain-ref domain 'add))
(define matrix (vector (vector 0 1) (vector 1 2)))
(define polynomial (algebraic-characteristic field matrix))
(check "characteristic polynomial independently known" (and (same (vector-ref polynomial 0) -1)
  (same (vector-ref polynomial 1) -2) (same (vector-ref polynomial 2) 1)))
(define result (algebraic-eigenvalue-with-pullback field matrix (add 1 a)))
(define p (vector-ref result 1))
(check "irrational eigenvalue retained" (same (vector-ref result 0) (add 1 a)))
(check "projector first diagonal independent formula" (same (vector-ref (vector-ref p 0) 0) (add 1/2 (algebraic-scale a -1/4))))
(check "projector off diagonal independent formula" (same (vector-ref (vector-ref p 0) 1) (algebraic-scale a 1/4)))
(check "projector second diagonal independent formula" (same (vector-ref (vector-ref p 1) 1) (add 1/2 (algebraic-scale a 1/4))))
(define bars ((vector-ref result 2) 2))
(check "eigenvalue pullback scales projector transpose" (same (vector-ref (vector-ref bars 1) 0) (algebraic-scale a 1/2)))
(vector-set! (vector-ref p 0) 0 99)
(check "projector observation does not corrupt pullback" (same (vector-ref (vector-ref ((vector-ref result 2) 1) 0) 0) (add 1/2 (algebraic-scale a -1/4))))
(define context (make-algebraic-taylor field 4))
(define t (algebraic-ad-seed context 0))
(define moving (vector (vector t 1) (vector 1 0)))
(define value (algebraic-eigenvalue-lift context moving 1))
(define coefficients (algebraic-ad-coefficients value))
;; lambda(t)=(t+sqrt(t^2+4))/2 = 1+t/2+t^2/8-t^4/128+...
(for-each (lambda (i expected) (check "fourth-order spectral Taylor coefficient independent formula"
  (same (vector-ref coefficients i) expected))) '(0 1 2 3 4) '(1 1/2 1/8 0 -1/128))
(define moving-record (algebraic-eigenvalue-with-pullback context moving value))
(define moving-bar ((vector-ref moving-record 2) 1))
(check "projector retains derivative of sensitivity" (same (algebraic-ad-derivative (vector-ref (vector-ref moving-bar 0) 0) 1) 1/4))
(for-each (lambda (r)
  (let* ((diagonal (vector (vector r 0 0) (vector 0 (+ r 1) 0) (vector 0 0 (+ r 3))))
         (record (algebraic-eigenvalue-with-pullback field diagonal (+ r 1)))
         (projector (vector-ref record 1)) (poly (algebraic-characteristic field diagonal)))
    (check "three-dimensional diagonal selected projector" (and (same (vector-ref (vector-ref projector 1) 1) 1)
      (same (vector-ref (vector-ref projector 0) 0) 0) (same (vector-ref (vector-ref projector 2) 2) 0)))
    (check "characteristic determinant coefficient" (same (vector-ref poly 0) (- (* r (+ r 1) (+ r 3)))))
    (check "characteristic trace coefficient" (same (vector-ref poly 2) (- (+ (* 3 r) 4)))))) '(-2 -1 0 1 2))
(define scalar (algebraic-eigenvalue-with-pullback field (vector (vector a)) a))
(check "one-dimensional branch" (same (vector-ref (vector-ref (vector-ref scalar 1) 0) 0) 1))
(check "repeated eigenvalue refuses" (raises? (lambda () (algebraic-eigenvalue-with-pullback field
  (vector (vector 1 0) (vector 0 1)) 1))))
(check "wrong selected value refuses" (raises? (lambda () (algebraic-eigenvalue-with-pullback field matrix 1))))
(check "nonsymmetric selected branch refuses" (raises? (lambda () (algebraic-eigenvalue-with-pullback field
  (vector (vector 1 1) (vector 0 2)) 1))))
(check "floating matrix entries refuse" (raises? (lambda () (algebraic-characteristic field (vector (vector 1.0))))))
(check "ragged matrices refuse" (raises? (lambda () (algebraic-characteristic field (vector (vector 1 0) (vector 0))))))
(check "foreign eigenvalue field refuses" (raises? (lambda () (algebraic-eigenvalue-with-pullback field matrix
  (algebraic-generator (make-algebraic-field '(-3 0 1) 5 1))))))
(check "sibling perturbation owner refuses" (raises? (lambda () (algebraic-eigenvalue-lift context
  (vector (vector (algebraic-ad-seed (make-algebraic-taylor field 1) 0) 1) (vector 1 0)) 1))))
(check "no finite-difference probes" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: algebraic_spectral_test") (newline) (display "RESULT: PASS") (newline)
