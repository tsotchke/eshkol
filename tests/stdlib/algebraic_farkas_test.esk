(require stdlib)
(require core.ad.algebraic_farkas)
(require core.ad.algebraic_qp)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define empty (vector)) (define a (vector (vector 1) (vector 1))) (define b (vector 0 1))
(define equality (algebraic-farkas-search field 1 a b empty empty))
(check "dependent inconsistent equalities certified" (algebraic-farkas-verify field 1 a b empty empty equality))
(check "source RHS changed refuses" (not (algebraic-farkas-verify field 1 a (vector 0 0) empty empty equality)))
(define c (vector (vector 1) (vector -1))) (define limits (vector 0 -1))
(define inequality (algebraic-farkas-search field 1 empty empty c limits))
(check "contradictory inequalities certified" (algebraic-farkas-verify field 1 empty empty c limits inequality))
(define forged (vector-copy inequality)) (vector-set! forged 4 (vector -1 -1))
(check "negative dual multiplier refuses" (not (algebraic-farkas-verify field 1 empty empty c limits forged)))
(define feasible (algebraic-farkas-search field 1 empty empty c (vector 1 1)))
(check "feasible system never certified by exhaustion" (and (eq? (vector-ref feasible 1) 'unknown) (not (vector-ref feasible 3)) (eq? (vector-ref feasible 6) 'enumeration-complete)))
(define budgeted (algebraic-farkas-search field 1 empty empty c limits 1))
(check "bounded search unresolved is explicit" (and (eq? (vector-ref budgeted 1) 'unknown) (eq? (vector-ref budgeted 6) 'budget-exhausted) (= (vector-ref budgeted 5) 1)))
(define mixed-a (vector (vector 1 0))) (define mixed-b (vector 1))
(define mixed-c (vector (vector -1 1) (vector 0 -1))) (define mixed-d (vector -2 0))
(define mixed (algebraic-farkas-search field 2 mixed-a mixed-b mixed-c mixed-d))
(check "mixed equality and inequality certificate" (algebraic-farkas-verify field 2 mixed-a mixed-b mixed-c mixed-d mixed))
(define sqrt2 (algebraic-generator field))
(define algebraic-c (vector (vector sqrt2) (vector -1)))
(define algebraic-d (vector 0 -1))
(define algebraic (algebraic-farkas-search field 1 empty empty algebraic-c algebraic-d))
(check "selected algebraic coefficients and signs certify" (algebraic-farkas-verify field 1 empty empty algebraic-c algebraic-d algebraic))
(check "zero-row contradiction certifies" (algebraic-farkas-verify field 1 empty empty (vector (vector 0)) (vector -1)
  (algebraic-farkas-search field 1 empty empty (vector (vector 0)) (vector -1))))
(check "empty constraints stay unknown" (eq? (vector-ref (algebraic-farkas-search field 2 empty empty empty empty) 1) 'unknown))
(check "QP search refusal remains a refusal" (raises? (lambda () (algebraic-qp-solve field (vector (vector 1)) (vector 0) empty empty c limits))))
(check "separate Farkas result proves QP feasible set empty" (algebraic-farkas-verify field 1 empty empty c limits inequality))
(check "Taylor ring refuses order theorem" (raises? (lambda () (algebraic-farkas-search (make-algebraic-taylor field 1) 1 empty empty c limits))))
(check "inexact model refuses" (raises? (lambda () (algebraic-farkas-search field 1 empty empty (vector (vector 1.0)) (vector -1)))))
(check "bad budget refuses" (raises? (lambda () (algebraic-farkas-search field 1 a b empty empty 0))))
(for-each (lambda (scale)
  (let* ((cc (vector (vector scale) (vector (- scale)))) (dd (vector 0 (- scale)))
         (r (algebraic-farkas-search field 1 empty empty cc dd)))
    (check "positive scaling preserves proof" (algebraic-farkas-verify field 1 empty empty cc dd r)))) '(1/17 1 123))
(define broken (vector-copy inequality)) (vector-set! broken 4 (vector 1 0))
(check "nonannihilating ray refuses" (not (algebraic-farkas-verify field 1 empty empty c limits broken)))
(define nonnegative (vector-copy inequality)) (vector-set! nonnegative 4 (vector 0 0))
(check "zero separating margin refuses" (not (algebraic-farkas-verify field 1 empty empty c limits nonnegative)))
(check "unknown result is no certificate" (not (algebraic-farkas-verify field 1 empty empty c limits budgeted)))
(define negative-field (make-algebraic-field '(-2 0 1) 3 0))
(define nc (vector (vector (algebraic-generator negative-field)) (vector 1)))
(define nr (algebraic-farkas-search negative-field 1 empty empty nc (vector 0 -1)))
(check "selected negative embedding controls dual signs" (algebraic-farkas-verify negative-field 1 empty empty nc (vector 0 -1) nr))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
