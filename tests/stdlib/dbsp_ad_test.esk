(require stdlib)
(require core.dbsp.ad)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (near a b) (< (abs (- a b)) 1e-10))
(define (vector-near a b)
  (and (= (vector-length a) (vector-length b))
    (let cells ((i 0)) (or (= i (vector-length a))
      (and (near (vector-ref a i) (vector-ref b i)) (cells (+ i 1)))))))
(define (loss-builder tape parameters row)
  (let* ((p0 (tape-mul tape (car parameters) (tape-const tape (car row))))
         (p1 (tape-mul tape (cadr parameters) (tape-const tape (cadr row))))
         (prediction (tape-add tape p0 p1))
         (error (tape-sub tape prediction (tape-const tape (caddr row)))))
    (tape-square tape error)))
(define point (vector 0.5 -1.0))
(define lift (dbsp-ad-lift point loss-builder))
(define contribution (lift '(2 3 4)))
(check "AD loss and both derivatives match closed form" (vector-near contribution (vector 36 -24 -36)))
(vector-set! point 0 99)
(check "fixed parameter point is owned" (vector-near (lift '(2 3 4)) (vector 36 -24 -36)))
(vector-set! contribution 0 99)
(check "lift results do not alias later evaluations" (vector-near (lift '(2 3 4)) (vector 36 -24 -36)))
(check "analytic tape path uses no finite differences" (= (ad-finite-difference-evals) 0))
(define group (dbsp-vector-group 3))
(define (key row) 'all)
(define (emit k v) (cons k (vector->list v)))
(define graph (make-dbsp-circuit '(rows) (list (list 'aggregate 'out 'rows key lift group emit)) 'out))
(define current graph)
(define rows (zset-empty))
(define integrated (zset-empty))
(define oracle-ok #t)
(define (closed rows)
  (fold-left (lambda (out entry)
    (let* ((w (car entry)) (r (cadr entry)) (x (car r)) (z (cadr r)) (y (caddr r))
           (e (- (- (* 0.5 x) z) y)))
      (vector (+ (vector-ref out 0) (* w e e))
              (+ (vector-ref out 1) (* w 2 e x))
              (+ (vector-ref out 2) (* w 2 e z))))) (vector 0 0 0) (zset-entries rows)))
(define (observed runtime)
  (let ((entries (zset-entries (dbsp-circuit-output runtime))))
    (if (null? entries) (vector 0 0 0) (list->vector (cdadr (car entries))))))
(let ticks ((i 0))
  (if (< i 48)
      (let* ((delta (zset-from-weighted (list
                (list (- (modulo i 5) 2) (list (- (modulo i 7) 3) (modulo i 3) (modulo i 4)))
                (list -1 '(1 2 3)))))
             (next (dbsp-circuit-step current (list (list 'rows delta)))))
        (set! current (car next)) (set! rows (zset-add rows delta))
        (set! integrated (zset-add integrated (cdr next)))
        (if (not (and (vector-near (observed current) (closed rows))
                      (zset=? integrated (dbsp-circuit-output current)))) (set! oracle-ok #f))
        (ticks (+ i 1)))))
(check "48 signed loss/gradient prefixes match independent full-row oracle" oracle-ok)
(check "initial snapshot stays empty" (zset-empty? (dbsp-circuit-output graph)))
(define before current)
(define fork (car (dbsp-circuit-step current (list (list 'rows (zset-singleton '(2 3 4) 1))))))
(check "fork adds only its row contribution" (vector-near (observed fork)
  (vector (+ 36 (vector-ref (observed before) 0))
          (- (vector-ref (observed before) 1) 24)
          (- (vector-ref (observed before) 2) 36))))
(check "old output remains unchanged after fork" (vector-near (observed before) (closed rows)))
(check "vector group rejects malformed dimension" (raises? (lambda () (dbsp-vector-group -1))))
(define bad-width (make-dbsp-circuit '(rows) (list (list 'aggregate 'out 'rows key
  (lambda (r) (vector 1 2)) group emit)) 'out))
(check "vector group rejects mismatched lifted width" (raises? (lambda ()
  (dbsp-circuit-step bad-width (list (list 'rows (zset-singleton '(1) 1)))))))
(check "mismatched attempt leaves previous state intact" (zset-empty? (dbsp-circuit-output bad-width)))
(check "nonfinite point refused" (raises? (lambda () (dbsp-ad-lift (vector +inf.0) loss-builder))))
(check "nonprocedure builder refused" (raises? (lambda () (dbsp-ad-lift (vector 1) 0))))
(check "nonscalar loss node refused" (raises? (lambda ()
  ((dbsp-ad-lift (vector 1) (lambda (t p row) (tape-input t (vector 1)))) '(1)))))
(check "invalid builder result refused" (raises? (lambda ()
  ((dbsp-ad-lift (vector 1) (lambda (t p row) 9)) '(1)))))
(check "zero-dimensional vector group is lawful" (vector? (dbsp-vector-group 0)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: dbsp_ad_test") (newline)
(display "RESULT: PASS") (newline)
