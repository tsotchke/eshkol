(require stdlib)
(require core.polynomial_exact)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (same a b) (equal? (vector->list a) (vector->list b)))
(define division (exact-poly-divmod '(-1 0 0 1) '(-1 1)))
(check "exact division independently known quotient" (and (same (car division) (vector 1 1 1)) (exact-poly-zero? (cdr division))))
(check "division reconstruction" (exact-poly-zero? (exact-poly-sub '(-1 0 0 1)
  (exact-poly-sub (exact-poly-mul (car division) '(-1 1)) (exact-poly-scale (cdr division) -1)))))
(check "rational Euclid inverse independently known" (same (exact-poly-inverse-mod '(1 1) '(1 0 1)) (vector 1/2 -1/2)))
(check "Horner exact rational evaluation" (= (exact-poly-eval '(1 2 3) 1/2) 11/4))
(check "empty and trailing zero normalization" (and (same (exact-poly '()) (vector 0)) (same (exact-poly '(1 0 0)) (vector 1))))
(define original (vector 1 2))
(define owned (exact-poly original))
(vector-set! original 0 99)
(check "constructor owns input coefficients" (= (vector-ref owned 0) 1))
(define short-rem (cdr (exact-poly-divmod owned '(1 0 1))))
(vector-set! short-rem 0 99)
(check "borrowed canonical inputs never alias arithmetic results" (= (vector-ref owned 0) 1))
(check "zero factors do not bypass exactness admission" (raises? (lambda ()
  (exact-poly-mul (vector 0.0) (vector 0)))))
(check "padded arithmetic operands retain exact canonical results" (and
  (same (exact-poly-mul (vector 1 0 0) (vector 2 0)) (vector 2))
  (same (exact-poly-inverse-mod (vector 1 1 0) (vector 1 0 1 0)) (vector 1/2 -1/2))
  (= (length (exact-poly-isolate (vector -2 0 1 0))) 2)))
(for-each (lambda (c)
  (let* ((p (vector (- c) 0 1)) (expected (cond ((< c 0) 0) ((= c 0) 1) (else 2)))
         (roots (exact-poly-isolate p)))
    (check "quadratic distinct real-root count" (= (exact-poly-real-root-count p -4 4) expected))
    (check "isolating intervals each contain one root" (and (= (length roots) expected)
      (let loop ((rest roots) (previous -4))
        (or (null? rest)
            (and (>= (caar rest) previous)
                 (= (exact-poly-real-root-count p (caar rest) (cdar rest)) 1)
                 (loop (cdr rest) (cdar rest))))))))) '(-3 -2 -1 0 1 2 3))
(check "repeated roots counted once" (= (exact-poly-real-root-count '(1 0 -2 0 1) -3 3) 2))
(check "rational midpoint roots avoided" (= (length (exact-poly-isolate '(0 -1 0 1))) 3))
(check "three irrational roots isolated" (= (length (exact-poly-isolate '(1 -3 0 1))) 3))
(check "zero polynomial refused" (raises? (lambda () (exact-poly-isolate '(0)))))
(check "root endpoint refused" (raises? (lambda () (exact-poly-real-root-count '(-1 1) 1 2))))
(check "split exhaustion never returns partial roots" (raises? (lambda () (exact-poly-isolate '(-2 0 1) 0))))
(check "division by zero refused" (raises? (lambda () (exact-poly-divmod '(1) '(0)))))
(check "nonunit refused" (raises? (lambda () (exact-poly-inverse-mod '(1 1) '(-1 0 1)))))
(check "inexact coefficient refused" (raises? (lambda () (exact-poly '(1 0.5)))))
(check "arithmetic never publishes demoted rational coefficients"
  (guard (e (else #t))
    (let ((v (car (exact-poly-divmod '(9223372036854775809) '(2)))))
      (and (exact? (vector-ref v 0)) (= (* (vector-ref v 0) 2) 9223372036854775809)))))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: polynomial_exact_test") (newline)
(display "RESULT: PASS") (newline)
