(require core.observable_closure)
(define passed 0)
(define (check name ok) (if (not ok) (error "observable closure assertion" name)) (set! passed (+ passed 1)))
(define (copy-data x)
  (cond ((pair? x) (cons (copy-data (car x)) (copy-data (cdr x))))
        ((vector? x) (list->vector (map copy-data (vector->list x)))) (else x)))
(define (closed qs gs)
  (let ((r (compile-observable-closure qs gs)))
    (check 'closed (eq? (observable-status r) 'closed))
    (check 'independent-replay (verify-observable-closure qs gs (observable-certificate r))) r))
(define qs '((1 1)))
(define gs '((g (2 0) (0 2))))
(define result (closed qs gs))
(define proof (observable-certificate result))
(check 'linear-combination (= (observable-dimension result) 1))
(check 'available (equal? (project-observations qs gs proof '((3 3))) '(available ((3)))))
(check 'missing (eq? (car (project-observations qs gs proof '((1 0)))) 'reconstruction-required))
(for-each (lambda (slot)
  (let ((bad (copy-data proof)))
    (set-car! (car (vector-ref bad slot)) 99)
    (check 'tamper (not (verify-observable-closure qs gs bad))))) '(2 3 6))
(define redundant (vector 'observable-closure-v1 2 '((1 0) (0 1)) '((1 1))
                   '((g (2 0) (0 2))) '((0 ()) (0 (g))) '((1 0) (0 1))))
(check 'nonminimal (not (verify-observable-closure qs gs redundant)))
(check 'changed-source (not (verify-observable-closure qs '((g (2 1) (0 2))) proof)))
(define family '((zero (0 0) (0 0)) (parameter (0 1) (1 0))))
(define point (closed '((1 0)) '((zero (0 0) (0 0)))))
(define common (closed '((1 0)) family))
(check 'parameter-family (= (observable-dimension common) 2))
(check 'point-is-not-family (not (verify-observable-closure '((1 0)) family (observable-certificate point))))
(for-each (lambda (limits)
  (let ((r (compile-observable-closure '((1 0)) '((g (0 1) (1 0))) limits)))
    (check 'unknown (and (eq? (observable-status r) 'unknown) (not (observable-certificate r)))))) '((1 100) (2 0)))
(define zero (closed '((0 0)) '()))
(check 'zero-space (= (observable-dimension zero) 0))
(let masks ((mask 0))
  (if (< mask 16)
      (begin
        (let queries ((code 0))
          (if (< code 4)
              (let* ((query (list (modulo code 2) (modulo (quotient code 2) 2)))
                     (matrix (list (list (modulo mask 2) (modulo (quotient mask 2) 2))
                                   (list (modulo (quotient mask 4) 2) (modulo (quotient mask 8) 2))))
                     (r (closed (list query) (list (cons 'g matrix)))))
                (display "SPAN ") (write (list mask code (observable-dimension r))) (newline)
                (queries (+ code 1)))))
        (masks (+ mask 1)))))
(define (exact-degree n d)
  (if (= n 1) (list (list d))
      (let loop ((i 0) (out '()))
        (if (> i d) out
            (loop (+ i 1) (append out (map (lambda (tail) (cons i tail)) (exact-degree (- n 1) (- d i)))))))))
(define basis (append (exact-degree 4 0) (exact-degree 4 1) (exact-degree 4 2)))
(define (hawkes observations)
  (list '(variables x1 x2 n1 n2) '(parameters w) (cons 'basis basis)
        '(drift (* -2 x1) (* -3 x2) 0 0)
        '(jumps ((+ 1/2 x1) ((+ x1 w) (+ x2 1/4) (+ n1 1) n2))
                ((+ 2/3 x2) ((+ x1 1/3) (+ x2 w) n1 (+ n2 1))))
        (cons 'observations observations)))
(define mean-source (hawkes '(n1)))
(define covariance-source (hawkes '(n1 n2 (* n1 n2))))
(define mean (compile-generator-closure mean-source))
(define covariance (compile-generator-closure covariance-source))
(check 'mean-closed (eq? (observable-status mean) 'closed))
(check 'mean-four (= (observable-dimension mean) 4))
(check 'covariance-closed (eq? (observable-status covariance) 'closed))
(check 'covariance-eleven (= (observable-dimension covariance) 11))
(check 'source-mean (verify-generator-closure mean-source (observable-certificate mean)))
(check 'source-covariance (verify-generator-closure covariance-source (observable-certificate covariance)))
(display "HAWKES ") (write (list (length basis) (observable-dimension mean) (observable-dimension covariance))) (newline)
(display "SOURCE ") (write mean-source) (newline)
(display "CERTIFICATE ") (write (observable-certificate mean)) (newline)
(define changed (copy-data mean-source))
(set-car! (cdr (car (cadr (assq 'jumps changed)))) 7)
(check 'changed-generator (not (verify-generator-closure changed (observable-certificate mean))))
(define nonlinear '((variables x) (parameters) (basis (0) (1)) (drift (* x x)) (jumps) (observations x)))
(check 'outside-basis (eq? (observable-status (compile-generator-closure nonlinear)) 'outside-basis))
(define zero-query '((variables x) (parameters) (basis (0) (1)) (drift (* x x)) (jumps) (observations 1)))
(define constant (compile-generator-closure zero-query))
(check 'unrequested-outside-does-not-block (and (eq? (observable-status constant) 'closed) (= (observable-dimension constant) 1)))
(define mutable-query (list (list 1 1)))
(define owned (compile-observable-closure mutable-query gs))
(set-car! (car mutable-query) 55)
(check 'owned-input (verify-observable-closure qs gs (observable-certificate owned)))
(display "PASS observable_closure ") (display passed) (newline)
