(require stdlib)
(require core.ad.algebraic_reverse)
(require core.ad.algebraic_sparse)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define a (algebraic-generator field))
(define same (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define (poly tape xs)
  (let ((x (vector-ref xs 0)) (y (vector-ref xs 1)))
    (algebraic-reverse-add tape (algebraic-reverse-pow tape x 3)
      (algebraic-reverse-mul tape y (algebraic-reverse-mul tape x x)))))
(define calls 0)
(define saved-tape #f) (define saved-node #f)
(define point (vector a 3))
(define r (algebraic-value-and-pullback field
  (lambda (t xs) (set! calls (+ calls 1)) (set! saved-tape t) (set! saved-node (vector-ref xs 0)) (poly t xs)) point))
(check "one forward invocation" (= calls 1))
(check "irrational value" (same (vector-ref r 0) (algebraic-add (algebraic-scale a 2) (algebraic-element field 6))))
(define pull (vector-ref r 1))
(define g (pull 1))
(check "whole gradient x" (same (vector-ref g 0) (algebraic-add (algebraic-element field 6) (algebraic-scale a 6))))
(check "whole gradient y" (same (vector-ref g 1) 2))
(check "zero seed resets gradients" (let ((z (pull 0))) (and (same (vector-ref z 0) 0) (same (vector-ref z 1) 0))))
(check "signed seed and repeated parents" (same (vector-ref (pull -2) 1) -4))
(check "pullbacks never reevaluate forward" (= calls 1))
(check "sealed recorder refuses new operations" (raises? (lambda () (algebraic-reverse-pow saved-tape saved-node 2))))
(define observed (algebraic-reverse-value saved-tape saved-node))
(vector-set! (vector-ref observed 2) 0 99)
(vector-set! (vector-ref (vector-ref point 0) 2) 0 88)
(vector-set! (vector-ref (vector-ref r 0) 2) 0 77)
(vector-set! (vector-ref (vector-ref g 1) 2) 0 66)
(check "input output and observer mutation do not alter recorded derivatives" (same (vector-ref (pull 1) 1) 2))
(define snap (tape-snapshot saved-tape))
(vector-set! (vector-ref (car snap) 2) 0 123)
(check "exact tape snapshots own their values" (same (vector-ref (pull 1) 1) 2))
(check "sealed tape refuses snapshot restore" (raises? (lambda () (tape-restore saved-tape snap))))
(define clean-a (algebraic-generator field))
(define h (algebraic-hvp field poly (vector clean-a 3) (vector 2 -1)))
(check "HVP irrational component" (same (vector-ref (vector-ref h 0) 0) (algebraic-add (algebraic-element field 12) (algebraic-scale clean-a 10))))
(check "HVP cross component" (same (vector-ref (vector-ref h 0) 1) (algebraic-scale clean-a 4)))
(check "directional output" (same (vector-ref h 3) (algebraic-add (algebraic-element field 10) (algebraic-scale clean-a 12))))
(for-each (lambda (x) (for-each (lambda (y)
  (let* ((rec (algebraic-value-and-pullback field poly (vector x y))) (grad ((vector-ref rec 1) 1))
         (hv (vector-ref (algebraic-hvp field poly (vector x y) (vector 2 -1)) 0)))
    (check "independent polynomial gradient grid" (and (same (vector-ref grad 0) (+ (* 3 x x) (* 2 y x))) (same (vector-ref grad 1) (* x x))))
    (check "independent Hessian action grid" (and (same (vector-ref hv 0) (+ (* 10 x) (* 4 y))) (same (vector-ref hv 1) (* 4 x)))))) '(0 1 2 3))) '(-2 -1 0 1 2))
(define reciprocal (lambda (t xs) (algebraic-reverse-inverse t (vector-ref xs 0))))
(define inv (algebraic-hvp field reciprocal (vector 2) (vector 3)))
(check "inverse gradient" (same (vector-ref (vector-ref inv 1) 0) -1/4))
(check "inverse HVP" (same (vector-ref (vector-ref inv 0) 0) 3/4))
(define outer (make-algebraic-taylor field 2))
(define nested (algebraic-value-and-pullback outer
  (lambda (t xs) (algebraic-reverse-pow t (vector-ref xs 0) 3)) (vector (algebraic-ad-seed outer clean-a))))
(define ng (vector-ref ((vector-ref nested 1) 1) 0))
(check "enclosing gradient value" (same (algebraic-ad-derivative ng 0) 6))
(check "enclosing gradient first derivative" (same (algebraic-ad-derivative ng 1) (algebraic-scale clean-a 6)))
(check "enclosing gradient second derivative" (same (algebraic-ad-derivative ng 2) 6))
(define empty (algebraic-value-and-pullback field (lambda (t xs) (algebraic-reverse-constant t 7)) (vector)))
(check "constant empty-input pullback" (= (vector-length ((vector-ref empty 1) 2)) 0))
(define probes 0)
(define recovered (algebraic-sparse-hessian field
  (lambda (xs) (let ((x (vector-ref xs 0)) (y (vector-ref xs 1)))
    (algebraic-ad-add (algebraic-ad-mul x (algebraic-ad-mul x x)) (algebraic-ad-mul y (algebraic-ad-mul x x)))))
  (vector clean-a 3) '((0 0) (0 1))
  (lambda (p v) (set! probes (+ probes 1)) (vector-ref (algebraic-hvp field poly p v) 0))))
(check "reverse HVP feeds sparse recovery" (and (same (algebraic-sparse-hessian-ref recovered 0 1) (algebraic-scale clean-a 2)) (> probes 0)))
(define foreign (make-algebraic-field '(-3 0 1) 5 1))
(for-each (lambda (thunk) (check "ownership and admission refusal" (raises? thunk)))
  (list (lambda () (pull (algebraic-generator foreign)))
    (lambda () (algebraic-value-and-pullback field poly (vector 1.0 2)))
    (lambda () (algebraic-value-and-pullback field (lambda (t xs) saved-node) (vector 1)))
    (lambda () (algebraic-value-and-pullback field reciprocal (vector 0)))
    (lambda () (algebraic-hvp field poly (vector 1 2) (vector 1)))
    (lambda () (algebraic-value-and-pullback field (lambda (t xs) (algebraic-reverse-pow t (vector-ref xs 0) -1)) (vector 1)))
    (lambda () (algebraic-value-and-pullback field (lambda (t xs) (algebraic-reverse-add t (vector-ref xs 0) saved-node)) (vector 1)))))
(check "failed seed does not poison reuse" (same (vector-ref (pull 1) 1) 2))
(check "zero finite differences" (= (ad-finite-difference-evals) 0))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
