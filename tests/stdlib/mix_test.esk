;;; Independent bytecode answers, actual self-application, refusals and emission.
(require core.compiler.mix)
(require core.compiler.mix.runtime)
(require core.compiler.mix.source)
(require core.list.transform)
(require core.list.query)
(require core.list.search)
(require core.list.compound)
(require core.list.higher_order)
(require stdlib.mix_fixtures)
(define checks 0)
(define comparisons 0)
(define emissions 0)
(define (check label value)
  (set! checks (+ checks 1))
  (if (not value) (begin (display "FAIL: ") (write label) (newline) (exit 1))))
(define limits (mix-limits 20000000 4096 2000000 300000))
(define options (mix-options 256 512))
(define (normal r) (eq? (mix-result-status r) 'normal))
(define (value p env) (let ((r (mix-run p env limits))) (check 'normal (normal r)) (mix-result-value r)))
(define (answer p env expected)
  (set! comparisons (+ comparisons 1)) (check 'independent-answer (= expected (value p env))))
(define (status p env l expected) (check expected (eq? expected (mix-result-status (mix-run p env l)))))
(check 'sequential-shadow (= 8 (value '(program () (let ((x 7) (x (prim + (var x) 1))) (var x))) '())))
(check 'zero-is-true (= 7 (value '(program () (if 0 7 9)) '())))
(check 'nil-is-false (= 9 (value '(program () (if (quote ()) 7 9)) '())))
(check 'false-is-false (= 9 (value '(program () (if (quote false) 7 9)) '())))
(check 'first-binding (= 3 (value '(program () (var x)) '((x . 3) (x . 9)))))
(check 'nil-is-symbol (eq? 'true (value '(program () (prim symbolp (quote ()))) '())))
(check 'nil-selector (null? (value '(program () (prim car (quote ()))) '())))
(check 'negative-mod (= 2 (value '(program () (prim mod -7 3)) '())))
(check 'negative-divisor (= -2 (value '(program () (prim mod 7 -3)) '())))
(check 'zero-divisor (= 0 (value '(program () (prim mod 7 0)) '())))
(check 'signed-shift (= -2 (value '(program () (prim shr -3 1)) '())))
(check 'masked-shift (= -2 (value '(program () (prim shr -3 65)) '())))
(check 'big-exact (= 18446744073709551616 (value '(program () (prim * 4294967296 4294967296)) '())))
(check 'pair-alias (eq? 'true (value '(program () (let ((x (prim cons 1 (quote ())))) (prim eq (var x) (var x)))) '())))
(check 'fresh-pairs (eq? 'false (value '(program () (prim eq (prim cons 1 (quote ())) (prim cons 1 (quote ())))) '())))
(status '(program () (prim eq 1 1)) '() limits 'unsupported-identity)
(status '(program () (prim + 1)) '() limits 'invalid-program)
(status '(program () (quote 1.5)) '() limits 'invalid-data)
(status '(program () (var missing)) '() limits 'unbound-variable)
(status '(program () (call unknown)) '() limits 'invalid-program)
(status '(program ((f (x) (var x))) (call f (var missing))) '() limits 'unbound-variable)
(status '(program ((f (x) (var missing))) 1) '() limits 'invalid-program)
(status '(program () 7) '() (mix-limits 0 512 100 100) 'work-bound)
(status '(program () (prim cons 1 2)) '() (mix-limits 100 512 0 100) 'allocation-bound)
(status '(program () (quote (1 2 3))) '() (mix-limits 100 512 100 3) 'data-bound)
(status '(program ((loop () (call loop))) (call loop)) '() (mix-limits 200 32 100 1000) 'depth-bound)
(status '(program ((loop () (call loop))) (prim * 0 (call loop))) '() (mix-limits 100 512 100 1000) 'work-bound)
(status '(program () 1) '() (mix-limits -1 10 10 10) 'invalid-limits)
(let* ((data (list 1 2)) (p (list 'program '() (list 'quote data))) (r (mix-run p '() limits)))
  (set-car! data 99)
  (check 'owned-output (equal? (mix-result-value r) '(1 2))))
(let* ((data (cons 1 2)) (env (list (cons 'x data) (cons 'y data))))
  (check 'snapshot-preserves-alias (eq? 'true (value '(program () (prim eq (var x) (var y))) env))))
(let ((env (list (cons 'x (cons 1 2)) (cons 'y (cons 1 2)))))
  (check 'snapshot-preserves-distinct-cells (eq? 'false (value '(program () (prim eq (var x) (var y))) env))))
(let ((data (mix-source))) (set-car! data 'broken) (check 'fresh-object-source (eq? (car (mix-source)) 'program)))
(let ((cycle (cons 1 '())))
  (set-cdr! cycle cycle)
  (status (list 'program '() (list 'quote cycle)) '() (mix-limits 100 32 100 1000) 'data-bound))
(let ((cycle (cons 'program '())))
  (set-cdr! cycle cycle)
  (check 'invalid-compiler-refuses-before-snapshot
         (eq? (mix-result-status (mix-apply-compiler cycle '(program () 1) '() options limits)) 'invalid-specialization)))

(define source (mix-source))
(define (f2-origin? result interpreter)
  (and (normal result) (let ((o (vector-ref result 6)))
                        (and (pair? o) (eq? (car o) 'specialize) (equal? (cadr o) source)
                             (equal? (caddr o) source) (equal? (cadddr o) (list (cons 'program interpreter)))))))
(define (cogen-origin? result) (f2-origin? result source))
(define cogen-result (mix-specialize source (list (cons 'program source)) options limits))
(check 'actual-cogen (cogen-origin? cogen-result))
(check 'host-generator-refused (not (cogen-origin? (mix-run '(program () (quote (program () 0))) '() limits))))
(let interpreters ((is (list (mix-bytecode-interpreter) (mix-bytecode-interpreter-alt))))
  (if (pair? is)
      (let* ((interpreter (car is))
             (f2 (mix-specialize source (list (cons 'program interpreter)) options limits))
             (f3 (mix-apply-compiler (mix-result-value cogen-result) source (list (cons 'program interpreter)) options limits)))
        (check 'actual-f2 (f2-origin? f2 interpreter))
        (check 'f2-cannot-be-cogen (not (cogen-origin? f2)))
        (check 'actual-f3 (and (normal f3) (eq? (car (vector-ref f3 6)) 'compiler-application)
                               (equal? (cadr (vector-ref f3 6)) (mix-result-value cogen-result))))
        (let programs ((ss mix-fixture-statics) (answers mix-fixture-answers) (index 0))
          (if (pair? ss)
              (let* ((statics (car ss)) (f1 (mix-specialize interpreter statics options limits))
                     (r2 (mix-apply-compiler (mix-result-value f2) interpreter statics options limits))
                     (r3 (mix-apply-compiler (mix-result-value f3) interpreter statics options limits)))
                (if (not (normal f1)) (begin (display "F1 diagnostic: ") (write (list index (mix-result-status f1) (mix-result-work f1) statics)) (newline)))
                (check 'f1 (normal f1)) (check 'f2-output (normal r2)) (check 'f3-output (normal r3))
                (check 'projection-output-agreement (equal? (mix-result-value r2) (mix-result-value r3)))
                (check 'abi-before-cleanup (equal? (mix-inputs f1) '(x)))
                (let inputs ((xs mix-fixture-inputs) (ys (car answers)))
                  (if (pair? xs)
                      (let ((env (list (cons 'x (car xs)) (cons 'x 999))))
                        (answer interpreter (append statics env) (car ys))
                        (answer (mix-result-value f1) env (car ys))
                        (answer (mix-result-value r2) env (car ys))
                        (answer (mix-result-value r3) env (car ys))
                        (inputs (cdr xs) (cdr ys)))))
                (let* ((name (string->symbol (string-append "mix-output-" (number->string emissions))))
                       (emitted (mix-emit-eshkol r3 name)))
                  (set! emissions (+ emissions 1))
                  (check 'scalar-emission (eq? (vector-ref emitted 1) 'normal))
                  (for-each (lambda (form) (display "MIX-SOURCE ") (write form) (newline)) (vector-ref emitted 2))
                  (let drivers ((xs mix-fixture-inputs) (ys (car answers)))
                    (if (pair? xs)
                        (begin (display "MIX-SOURCE ")
                               (write (list 'if (list 'not (list '= (list name (car xs)) (car ys))) (list 'exit 1)))
                               (newline) (drivers (cdr xs) (cdr ys))))))
                (programs (cdr ss) (cdr answers) (+ index 1)))))
        (interpreters (cdr is)))))
;; A wrong static input is caught by actual evaluation, not a source hash.
(let ((r (mix-specialize '(program () (var x)) '((x . 0)) options limits)))
  (check 'wrong-static-caught (not (= 7 (value (mix-result-value r) '((x . 7)))))))
(let* ((r (mix-specialize '(program () (prim * (var x) 0)) '() options limits))
       (e (mix-emit-eshkol r 'mix-generated)))
  (check 'required-input-retained (equal? (vector-ref e 3) '(x))))
(check 'data-emission-refused
       (eq? (vector-ref (mix-emit-eshkol (mix-specialize '(program () (prim cons 1 2)) '() options limits) 'mix-generated) 1)
            'unsupported-residual))
(check 'unary-emission-refused
       (eq? (vector-ref (mix-emit-eshkol (mix-specialize '(program () (prim not (var x))) '() options limits) 'mix-generated) 1)
            'unsupported-residual))
(check 'reserved-entry-refused
       (eq? (vector-ref (mix-emit-eshkol (mix-specialize '(program () 1) '() options limits) 'if) 1) 'invalid-result))
(let ((r (mix-specialize '(program () (var x)) '() options limits)))
  (check 'wrapper-predicate-capture-refused (eq? (vector-ref (mix-emit-eshkol r 'not) 1) 'invalid-result))
  (check 'wrapper-arithmetic-capture-refused (eq? (vector-ref (mix-emit-eshkol r 'modulo) 1) 'invalid-result))
  (check 'wrapper-shift-capture-refused (eq? (vector-ref (mix-emit-eshkol r 'expt) 1) 'invalid-result)))
(check 'recursive-emission-refused
       (eq? (vector-ref (mix-emit-eshkol
                        (mix-specialize '(program ((f (x) (call f (var x)))) (call f (var x))) '() options limits)
                        'mix-generated) 1) 'unsupported-residual))
(let ((r (mix-specialize '(program () 1) '() options limits)))
  (vector-set! r 5 '(x x))
  (check 'duplicate-emission-inputs (eq? (vector-ref (mix-emit-eshkol r 'mix-generated) 1) 'invalid-residual)))
(let ((r (mix-specialize '(program () 1) '() options limits)) (cycle (cons 'x '())))
  (set-cdr! cycle cycle) (vector-set! r 5 cycle)
  (check 'cyclic-emission-metadata (eq? (vector-ref (mix-emit-eshkol r 'mix-generated) 1) 'invalid-residual)))
(define (emit-numeric p env expected name)
  (answer p env expected)
  (let* ((r (mix-specialize p '() options limits)) (e (mix-emit-eshkol r name)))
    (check 'numeric-emission (eq? (vector-ref e 1) 'normal))
    (for-each (lambda (form) (display "MIX-SOURCE ") (write form) (newline)) (vector-ref e 2))
    (display "MIX-SOURCE ")
    (write (list 'if (list 'not (list '= (cons name (map (lambda (key) (cdr (assoc key env))) (mix-inputs r))) expected)) (list 'exit 1)))
    (newline)))
(emit-numeric '(program () (prim mod (var x) (var y))) '((x . -7) (y . 3)) 2 'mix-numeric-a)
(emit-numeric '(program () (prim mod (var x) (var y))) '((x . 7) (y . -3)) -2 'mix-numeric-b)
(emit-numeric '(program () (prim mod (var x) (var y))) '((x . 7) (y . 0)) 0 'mix-numeric-c)
(emit-numeric '(program () (prim shr (var x) (var y))) '((x . -3) (y . 65)) -2 'mix-numeric-d)
(emit-numeric '(program () (prim shr (var x) (var y))) '((x . -3) (y . -1)) -1 'mix-numeric-e)
(emit-numeric '(program () (let ((x (var x)) (x (prim + (var x) 1))) (prim * (var x) (var x)))) '((x . -2)) 1 'mix-numeric-f)
(emit-numeric '(program () (if (var x) 7 9)) '((x . 0)) 7 'mix-numeric-g)
(emit-numeric '(program () (if (prim < (var x) 0) 7 9)) '((x . -2)) 7 'mix-numeric-h)
;; The scanner must distinguish constructor positions from binding identity.
;; These programs crashed or refused under the original generic list walk.
(emit-numeric '(program () (prim + (var call) 1)) '((call . 5)) 6 'mix-identity-a)
(emit-numeric '(program () (let ((call (var x)) (quote (prim + (var call) 1)))
                            (prim * (var quote) (var call)))) '((x . 3)) 12 'mix-identity-b)
(emit-numeric '(program ((quote (a) (prim + (var a) 1)) (f (x) (prim * (var x) 2)))
                        (call quote (call f (var call)))) '((call . 3)) 7 'mix-identity-c)
(display "MIX comparisons: ") (display comparisons) (newline)
(display "MIX checks: ") (display checks) (newline)
(display "MIX RESULT: PASS") (newline)
