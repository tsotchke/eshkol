(require stdlib)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (begin (set! passed (+ passed 1)) (display "PASS: "))
         (begin (set! failed (+ failed 1)) (display "FAIL: ")))
  (display name) (newline))
(define (codes s) (map char->integer (string->list s)))
(check "empty" (equal? (string->list "") '()))
(check "ASCII" (equal? (codes "Az!") '(65 122 33)))
(check "two three four byte characters" (equal? (codes "éλ中🙂") '(233 955 20013 128578)))
(check "combining marks stay separate" (equal? (codes "é") '(101 769)))
(define original (list #\A (integer->char 0) (integer->char 955) (integer->char 128578) #\Z))
(define embedded (list->string original))
(check "embedded NUL length" (= (length (string->list embedded)) 5))
(check "embedded NUL and suffix" (equal? (string->list embedded) original))
(check "first-class conversion preserves characters" (let ((convert string->list))
  (equal? (convert embedded) original)))
(check "character boundaries agree" (equal? (string->list embedded)
  (map (lambda (i) (string-ref embedded i)) '(0 1 2 3 4))))
(for-each (lambda (s) (check "roundtrip" (string=? s (list->string (string->list s)))))
  (list "" "hello" "Καλημέρα" "日本語🙂" embedded))
(define large (make-string 8192 (integer->char 128578)))
(define large-list (string->list large))
(check "long multibyte count" (= (length large-list) 8192))
(check "long multibyte final character" (= (char->integer (list-ref large-list 8191)) 128578))
(check "long multibyte roundtrip" (string=? large (list->string large-list)))
(check "new list does not mutate input" (let* ((source (string-copy "λx")) (xs (string->list source)))
  (set-car! xs #\a) (and (= (char->integer (string-ref source 0)) 955)
                            (char=? (string-ref source 1) #\x))))
(check "reject non-string" (guard (e (#t #t)) (string->list 17) #f))
(check "first-class rejects non-string" (let ((convert string->list))
  (guard (e (#t #t)) (convert 17) #f)))
(check "region result survives" (equal? (codes (with-region (string-copy "中🙂"))) '(20013 128578)))
(display "Passed: ") (display passed) (newline)
(display "Failed: ") (display failed) (newline)
(if (= failed 0) (display "RESULT: PASS\n") (begin (display "RESULT: FAIL\n") (exit 1)))
