(require core.data.base64)
(require core.json)
(require core.data.dataframe)

(define checks 0)
(define (check name ok)
  (if ok
      (set! checks (+ checks 1))
      (error name)))

;; Empty and ASCII inputs cover the direct byte conversion and padded base64 paths.
(check "empty string encodes to empty base64" (string=? (base64-encode-string "") ""))
(check "empty base64 decodes to empty bytes" (null? (base64-decode "")))
(check "ASCII bytes" (equal? (string->bytes "A") '(65)))
(check "ASCII base64 encode" (string=? (base64-encode-string "Man") "TWFu"))
(check "ASCII base64 decode" (equal? (base64-decode "TWE=") '(77 97)))
(check "ASCII base64 string roundtrip" (string=? (base64-decode-string "SGVsbG8=") "Hello"))
(check "whitespace bytes roundtrip" (string=? (bytes->string (string->bytes "a b\tc\n")) "a b\tc\n"))
(check "whitespace content base64 roundtrip"
       (string=? (base64-decode-string (base64-encode-string "a b\tc\n")) "a b\tc\n"))

;; alist->json is checked through the public serializer and parser APIs.
(define json-text (alist->json '(("name" . "test") ("value" . 42))))
(define json-value (json-parse json-text))
(check "alist->json string field" (string=? (hash-ref json-value "name" #f) "test"))
(check "alist->json numeric field" (= (hash-ref json-value "value" #f) 42))

;; Result predicates accept only the documented json-ok/json-err tagged pairs.
(check "json result accepts ok" (json-parse-result? (cons 'json-ok 17)))
(check "json result accepts err" (json-parse-result? (cons 'json-err "bad")))
(check "json result rejects empty list" (not (json-parse-result? '())))
(check "json result rejects unrelated tag" (not (json-parse-result? (cons 'other 17))))
(define parsed-null (json-try-parse "null"))
(check "json null parse result shape" (and (json-parse-result? parsed-null) (json-result-ok? parsed-null) (null? (json-result-value parsed-null))))
(define parsed-bad (json-try-parse "{"))
(check "malformed JSON is tagged error" (and (json-parse-result? parsed-bad) (not (json-result-ok? parsed-bad))))

;; CSV type inference preserves quoted commas; selection preserves requested order.
(define frame (csv-parse-typed "name,count,note\nalpha,7,\"a,b\"\nbeta,0,plain"))
(check "typed CSV header" (equal? (csv-header frame) '("name" "count" "note")))
(check "typed CSV quoted field and numeric values"
       (equal? (csv-rows frame) '(("alpha" 7 "a,b") ("beta" 0 "plain"))))
(check "CSV selector order and values"
       (equal? (csv-select frame '("note" "count"))
               '(("note" "count") ("a,b" 7) ("plain" 0))))

(display "Checks: ")
(display checks)
(newline)
(display "RESULT: PASS\n")
