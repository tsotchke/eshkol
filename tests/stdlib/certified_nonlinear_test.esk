(require stdlib)
(require core.certified_nonlinear)
(require core.ad.derived_operator)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define (contains? box x) (and (<= (car box) x) (<= x (cdr box))))
(define equations (list '(- (* x x) p) '(- y x)))
(define system (make-certified-polynomial-system '(x y) '(p) equations))
(define center (vector 3/2 3/2))
(define radii (vector 1/4 1/4))
(define parameters (vector 2))
(define preconditioner (vector (vector 1/3 0) (vector 1/3 1)))
(define cert (certify-polynomial-root system center radii parameters preconditioner))
(check "coupled irrational root proved" (eq? (vector-ref cert 1) 'proved))
(check "source-bound certificate replays" (verify-polynomial-root-certificate cert system center radii parameters preconditioner))
(for-each (lambda (box)
  (check "independent positive square-root enclosure" (and (> (car box) 0)
    (<= (* (car box) (car box)) 2) (>= (* (cdr box) (cdr box)) 2)))) (vector->list (vector-ref cert 2)))
(for-each (lambda (row)
  (let ((box (vector-ref row 0)))
    (check "implicit derivative encloses independent reciprocal square root" (and (> (car box) 0)
      (<= (* (car box) (car box)) 1/8) (>= (* (cdr box) (cdr box)) 1/8)))))
  (vector->list (vector-ref cert 3)))
(check "whole-box Jacobian contraction is exact" (= (vector-ref (vector-ref cert 4) 10) 1/6))
(check "root error improves trial radius" (< (- (cdr (vector-ref (vector-ref cert 2) 0))
  (car (vector-ref (vector-ref cert 2) 0))) 1/2))
(define moving (make-certified-polynomial-system '(x y) '(t) '((- x t) (- y (* x x)))))
(define mc (vector 3/2 9/4))
(define mr (vector 1/8 1/2))
(define mp (vector 3/2))
(define mi (vector (vector 1 0) (vector 3 1)))
(define known (certify-polynomial-root moving mc mr mp mi))
(check "exact rational moving root proved" (eq? (vector-ref known 1) 'proved))
(check "zero residual yields exact known root" (and
  (equal? (vector-ref (vector-ref known 2) 0) (cons 3/2 3/2))
  (equal? (vector-ref (vector-ref known 2) 1) (cons 9/4 9/4))))
(check "moving root sensitivity matches closed form" (and
  (contains? (vector-ref (vector-ref (vector-ref known 3) 0) 0) 1)
  (contains? (vector-ref (vector-ref (vector-ref known 3) 1) 0) 3)))
(define empty-parameters (make-certified-polynomial-system '(x) '() '((- (* x x) 2))))
(define unparam (certify-polynomial-root empty-parameters (vector 3/2) (vector 1/4) (vector) (vector (vector 1/3))))
(check "parameter-free source is supported" (and (eq? (vector-ref unparam 1) 'proved)
  (= (vector-length (vector-ref (vector-ref unparam 3) 0)) 0)))
(define no-root (make-certified-polynomial-system '(x) '() '((+ (* x x) 1))))
(define no-root-result (certify-polynomial-root no-root (vector 1) (vector 2) (vector) (vector (vector 1/2))))
(check "whole-box derivative rejects misleading point Jacobian" (and (eq? (vector-ref no-root-result 1) 'unknown)
  (not (vector-ref no-root-result 2)) (not (vector-ref no-root-result 3))))
(define small-no-root (certify-polynomial-root no-root (vector 1) (vector 1/8) (vector) (vector (vector 1/2))))
(check "contraction without self-inclusion is not a root proof" (and
  (< (vector-ref (vector-ref small-no-root 4) 10) 1)
  (eq? (vector-ref small-no-root 1) 'unknown)))
(define boundary (make-certified-polynomial-system '(x) '() '((- (* x x) 1))))
(check "strict q equals one boundary refuses" (eq? (vector-ref
  (certify-polynomial-root boundary (vector 1) (vector 1) (vector) (vector (vector 1/2))) 1) 'unknown))
(define singular (make-certified-polynomial-system '(x y) '() '((+ x y) (+ x y))))
(check "singular coupled system cannot certify uniqueness" (eq? (vector-ref
  (certify-polynomial-root singular (vector 0 0) (vector 1 1) (vector) (vector (vector 1 0) (vector 0 1))) 1) 'unknown))
(define forged (certify-polynomial-root system center radii parameters preconditioner))
(vector-set! (vector-ref forged 4) 10 0)
(check "forged contraction fails replay" (not (verify-polynomial-root-certificate forged system center radii parameters preconditioner)))
(define changed-source (make-certified-polynomial-system '(x y) '(p) '((- (* x x) p) (- y (+ x 1)))))
(check "certificate bound to original source" (not (verify-polynomial-root-certificate cert changed-source center radii parameters preconditioner)))
(define observations (certify-polynomial-root system center radii parameters preconditioner))
(vector-set! center 0 99)
(vector-set! (vector-ref preconditioner 0) 0 99)
(check "certificate input copies survive caller mutation" (verify-polynomial-root-certificate observations system
  (vector 3/2 3/2) radii parameters (vector (vector 1/3 0) (vector 1/3 1))))
(set-car! equations '(* x x))
(check "system owns compiled source" (eq? (vector-ref (certify-polynomial-root system (vector 3/2 3/2) radii parameters
  (vector (vector 1/3 0) (vector 1/3 1))) 1) 'proved))
;; Verify the shared interval extension against independent values and partials.
(define op (make-derived-operator '(x y) '(- (* (* x x) y) (/ y 2))))
(define box-result (derived-operator-enclosure op (vector (cons -1 2) (cons 1 3))))
(for-each (lambda (x) (for-each (lambda (y)
  (check "source interval contains independent value" (contains? (vector-ref box-result 0) (- (* x x y) (/ y 2))))
  (check "Jacobian interval contains independent dx" (contains? (vector-ref (vector-ref box-result 1) 0) (* 2 x y)))
  (check "Jacobian interval contains independent dy" (contains? (vector-ref (vector-ref box-result 1) 1) (- (* x x) 1/2))))
  '(1 2 3))) '(-1 0 1 2))
(for-each (lambda (bad)
  (check "invalid root input refuses" (raises? (lambda ()
    (certify-polynomial-root empty-parameters (vector 3/2) bad (vector) (vector (vector 1/3)))))))
  (list (vector 0) (vector -1) (vector 0.25) (vector 1/4 1/4)))
(check "inexact center refuses" (raises? (lambda ()
  (certify-polynomial-root empty-parameters (vector 1.5) (vector 1/4) (vector) (vector (vector 1/3))))))
(check "unvalidated calls cannot enter source" (raises? (lambda ()
  (make-certified-polynomial-system '(x) '() '((sin x))))))
(check "duplicate variable refuses" (raises? (lambda ()
  (make-certified-polynomial-system '(x) '(x) '(x)))))
(check "malformed interval refuses" (raises? (lambda ()
  (derived-operator-enclosure op (vector (cons 2 1) (cons 1 3))))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
