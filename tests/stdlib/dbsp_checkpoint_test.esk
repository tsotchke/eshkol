(require stdlib)
(require core.dbsp.checkpoint)
(define passes 0) (define failures 0)
(define (check name ok) (if ok (set! passes (+ passes 1))
  (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define registry (list (list 'pair "1" 'join car car (lambda (a b) (list (car a) (+ (cadr a) (cadr b)))))
                      (list 'double "1" 'map (lambda (row) (list (car row) (* 2 (cadr row)))))))
(define plan '((join pairs a b pair) (distinct unique pairs) (map output unique double)))
(define (template) (make-dbsp-resumable '(a b) plan 'output registry '(row-v1 exact-key exact-value)))
(define (events tick)
  (let* ((row-a (list (modulo tick 3) tick)) (row-b (list (modulo tick 3) (+ tick 10)))
         (a (if (> tick 3) (list (list 1 row-a) (list -1 (list (modulo (- tick 3) 3) (- tick 3)))) (list (list 1 row-a))))
         (b (if (> tick 6) (list (list 1 row-b) (list -1 (list (modulo (- tick 6) 3) (+ (- tick 6) 10)))) (list (list 1 row-b)))))
    (list (list 'a (zset-from-weighted a)) (list 'b (zset-from-weighted b)))))
(define state (template)) (define aa (zset-empty)) (define bb (zset-empty))
(define initial-bytes (dbsp-resumable-checkpoint state))
(check "empty checkpoint roundtrip" (string=? initial-bytes (dbsp-resumable-checkpoint (dbsp-resumable-restore (template) initial-bytes))))
(let loop ((tick 1)) (if (<= tick 12)
  (let* ((changes (events tick)) (old (dbsp-resumable-output state)) (step (dbsp-resumable-step state tick changes)))
    (set! aa (zset-add aa (cadar changes))) (set! bb (zset-add bb (cadadr changes))) (set! state (vector-ref step 0))
    (let* ((bytes (dbsp-resumable-checkpoint state)) (restored (dbsp-resumable-restore (template) bytes))
           (oracle (zset-map (lambda (r) (list (car r) (* 2 (cadr r))))
             (zset-distinct (zset-join aa bb car car (lambda (a b) (list (car a) (+ (cadr a) (cadr b))))))))
           (next-a (dbsp-resumable-step state (+ tick 1) (events (+ tick 1))))
           (next-b (dbsp-resumable-step restored (+ tick 1) (events (+ tick 1)))))
      (check "streamed output agrees with independent batch oracle" (zset=? (dbsp-resumable-output state) oracle))
      (check "integrated output delta agrees" (zset=? (zset-add old (vector-ref step 1)) oracle))
      (check "checkpoint preserves clock" (= (dbsp-resumable-tick restored) tick))
      (check "canonical recheckpoint is byte-identical" (string=? bytes (dbsp-resumable-checkpoint restored)))
      (check "next suffix output delta agrees" (zset=? (vector-ref next-a 1) (vector-ref next-b 1)))
      (check "next suffix complete hidden state agrees" (string=? (dbsp-resumable-checkpoint (vector-ref next-a 0))
                                                               (dbsp-resumable-checkpoint (vector-ref next-b 0)))))
    (loop (+ tick 1)))))
(define bytes (dbsp-resumable-checkpoint state))
(check "truncated checkpoint refused" (raises? (lambda () (dbsp-resumable-restore (template) (substring bytes 0 (- (string-length bytes) 1))))))
(check "trailing datum refused" (raises? (lambda () (dbsp-resumable-restore (template) (string-append bytes " ()")))))
(check "noncanonical trailing whitespace refused" (raises? (lambda () (dbsp-resumable-restore (template) (string-append bytes " ")))))
(define corrupt (string-copy bytes)) (string-set! corrupt 23 (if (char=? (string-ref corrupt 23) #\0) #\1 #\0))
(check "corruption refused" (raises? (lambda () (dbsp-resumable-restore (template) corrupt))))
(check "schema change refuses cached state" (raises? (lambda () (dbsp-resumable-restore
  (make-dbsp-resumable '(a b) plan 'output registry '(row-v2)) bytes))))
(define newer (list (list 'pair "2" 'join car car (lambda (a b) (list (car a) (+ (cadr a) (cadr b))))) (cadr registry)))
(check "operator version change refuses" (raises? (lambda () (dbsp-resumable-restore
  (make-dbsp-resumable '(a b) plan 'output newer '(row-v1 exact-key exact-value)) bytes))))
(define changed (list (car registry) (list 'double "1" 'map (lambda (row) (list (car row) (+ 1 (* 2 (cadr row))))))))
(check "changed callback state detected even under unchanged declared version" (raises? (lambda () (dbsp-resumable-restore
  (make-dbsp-resumable '(a b) plan 'output changed '(row-v1 exact-key exact-value)) bytes))))
(check "duplicate tick refused" (raises? (lambda () (dbsp-resumable-step state 12 (events 12)))))
(check "skipped tick refused" (raises? (lambda () (dbsp-resumable-step state 14 (events 14)))))
(define identity-registry (list (list 'id "1" 'map (lambda (row) row))))
(define identity-template (make-dbsp-resumable '(x) '((map y x id)) 'y identity-registry '(exact-tree)))
(define text (string-copy "quotes\" newline\n backslash\\ λ"))
(define data-row (vector text (string->symbol "symbol with spaces") #\newline #t 3/7 (cons 1 2)))
(define identity-state (vector-ref (dbsp-resumable-step identity-template 1 (list (list 'x (zset-singleton data-row 1)))) 0))
(define roundtrip (dbsp-resumable-restore identity-template (dbsp-resumable-checkpoint identity-state)))
(check "typed codec preserves escaped text and exact composite rows" (zset=? (dbsp-resumable-output identity-state) (dbsp-resumable-output roundtrip)))
(vector-set! data-row 0 "mutated") (string-set! text 0 #\x)
(check "input deltas are captured by value" (not (string=? (vector-ref (cadar (zset-entries (dbsp-resumable-output identity-state))) 0) "mutated")))
(check "floating row data refuses at admission" (raises? (lambda () (dbsp-resumable-step identity-template 1 (list (list 'x (zset-singleton '(1.0) 1)))))))
(define negative-template (make-dbsp-resumable '(x) '((distinct y x)) 'y '() '(signed)))
(define negative (vector-ref (dbsp-resumable-step negative-template 1 (list (list 'x (zset-singleton 'row -2)))) 0))
(define nr (dbsp-resumable-restore negative-template (dbsp-resumable-checkpoint negative)))
(define ns (dbsp-resumable-step nr 2 (list (list 'x (zset-singleton 'row 3)))))
(check "hidden negative distinct counts survive restart" (= (zset-weight (dbsp-resumable-output (vector-ref ns 0)) 'row) 1))
(check "malformed checkpoint envelope fields refused"
  (raises? (lambda () (dbsp-resumable-restore (template) "()"))))
(check "checkpoint larger than 4 MiB refused"
  (raises? (lambda () (dbsp-resumable-restore (template) (make-string 4194305 #\x)))))
(check "duplicate declared input names refused"
  (raises? (lambda () (make-dbsp-resumable '(x x) '() 'x '() '(duplicate-inputs)))))
(define failing-template
  (make-dbsp-resumable '(x) '((map y x maybe-fail)) 'y
    (list (list 'maybe-fail "1" 'map
      (lambda (row) (if (= (car row) 999) (error "deliberate callback failure") row)))) '(exact-row)))
(define stable-snapshot
  (vector-ref (dbsp-resumable-step failing-template 1
    (list (list 'x (zset-singleton '(1) 1)))) 0))
(define stable-bytes (dbsp-resumable-checkpoint stable-snapshot))
(check "callback failure refuses step" (raises? (lambda ()
  (dbsp-resumable-step stable-snapshot 2 (list (list 'x (zset-singleton '(999) 1)))))))
(check "callback failure leaves old snapshot unchanged"
  (string=? stable-bytes (dbsp-resumable-checkpoint stable-snapshot)))
(define phase (getenv "ESHKOL_CHECKPOINT_PHASE"))
(if phase
  (let* ((path (getenv "ESHKOL_CHECKPOINT_FILE")) (cut (string->number (getenv "ESHKOL_CHECKPOINT_CUT")))
         (runtime (if (string=? phase "resume") (dbsp-checkpoint-load path (template)) (template))))
    (let loop ((tick (+ 1 (dbsp-resumable-tick runtime))))
      (if (<= tick (if (string=? phase "save") cut 12))
          (begin (set! runtime (vector-ref (dbsp-resumable-step runtime tick (events tick)) 0)) (loop (+ tick 1)))))
    (if (string=? phase "save") (dbsp-checkpoint-save path runtime)
        (begin (display "CHECKPOINT-FINAL: ") (display (sha256 (dbsp-resumable-checkpoint runtime))) (newline)))))
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "PASS: dbsp_checkpoint_test") (newline) (display "RESULT: PASS") (newline)
