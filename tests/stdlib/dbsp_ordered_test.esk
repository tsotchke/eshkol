(require stdlib)
(require core.dbsp.ordered)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
;; Independent batch oracle: explicit row counts, expansion and full sort.
(define (batch-step table delta)
  (fold-left (lambda (out entry)
    (let* ((row (cadr entry)) (old (assoc row out)) (next (+ (if old (cdr old) 0) (car entry)))
           (rest (filter (lambda (pair) (not (equal? (car pair) row))) out)))
      (if (= next 0) rest (cons (cons row next) rest)))) table (zset-entries delta)))
(define (batch-sort table)
  (sort (fold-left (lambda (out pair)
    (let copies ((n (cdr pair)) (out out))
      (if (= n 0) out (copies (- n 1) (cons (car pair) out))))) '() table)
    (lambda (a b) (or (< (car a) (car b)) (and (= (car a) (car b)) (< (cadr a) (cadr b)))))))
(define (batch-top rows k)
  (zset-from-weighted (map (lambda (row) (list 1 row)) (take (reverse rows) (min k (length rows))))))
(define initial (make-dbsp-ordered car 4))
(check "empty metadata" (equal? (vector->list (dbsp-ordered-info initial)) '(0 0 0)))
(check "empty top view" (zset-empty? (dbsp-ordered-top initial 4)))
(check "empty quantile refuses" (raises? (lambda () (dbsp-ordered-quantile initial 1/2))))
(define rows (list->vector (map (lambda (i) (list (modulo i 3) i)) (iota 8))))
(define weights (list->vector (map (lambda (i) (+ 1 (modulo i 3))) (iota 8))))
(define start-delta (zset-from-weighted (map (lambda (weight row) (list weight row))
  (vector->list weights) (vector->list rows))))
(define current (vector-ref (dbsp-ordered-step initial start-delta) 0))
(define saved current)
(define table (batch-step '() start-delta))
(let ticks ((i 0)) (if (< i 24)
  (let* ((id (modulo i 8)) (old (vector-ref rows id)) (old-weight (vector-ref weights id))
         (row (list (/ (- (modulo (+ i 2) 7) 3) 2) id)) (weight (+ 1 (modulo (+ i 1) 3)))
         (delta (zset-from-weighted (list (list (- old-weight) old) (list weight row))))
         (old-top (dbsp-ordered-top current 4)) (step (dbsp-ordered-step current delta))
         (next (vector-ref step 0)))
    (set! table (batch-step table delta))
    (vector-set! rows id row) (vector-set! weights id weight)
    (let ((expected (batch-sort table)))
      (check "every prefix weighted mass agrees with batch" (= (vector-ref (dbsp-ordered-info next) 1) (length expected)))
      (let ranks ((k 0)) (if (< k (length expected))
        (begin
          (check "every weighted rank agrees with independent full sort" (equal?
            (vector-ref (dbsp-ordered-select next k) 0) (list-ref expected k)))
          (ranks (+ k 1)))))
      (for-each (lambda (q)
        (check "nearest-rank quantile agrees at every prefix" (equal?
          (vector-ref (dbsp-ordered-quantile next q) 0)
          (list-ref expected (max 0 (- (ceiling (* q (length expected))) 1)))))) '(0 1/4 1/2 3/4 1))
      (check "top-k matches independent full sort" (zset=? (dbsp-ordered-top next 4) (batch-top expected 4)))
      (check "signed top-k changes integrate" (zset=? (zset-add old-top (vector-ref step 1)) (batch-top expected 4)))
      (for-each (lambda (pair)
        (let* ((row (car pair)) (range (dbsp-ordered-rank next row)))
          (check "weighted rank interval has the row multiplicity" (= (- (cdr range) (car range)) (cdr pair)))
          (check "rank interval selects its row" (equal? (vector-ref (dbsp-ordered-select next (car range)) 0) row)))) table))
    (set! current next) (ticks (+ i 1)))))
(check "initial fork remains unchanged" (zset=? (dbsp-ordered-top saved 4)
  (batch-top (batch-sort (batch-step '() start-delta)) 4)))
(check "absent row rank is false" (not (dbsp-ordered-rank current '(999 999))))
(define no-op (dbsp-ordered-step current (zset-from-weighted '((1 (9 9)) (-1 (9 9))))))
(check "cancelled changes do no index work" (equal? (vector->list (vector-ref no-op 2)) '(0 0 0 0)))
(check "cancelled top view delta is empty" (zset-empty? (vector-ref no-op 1)))
(check "excess retraction refuses atomically" (raises? (lambda ()
  (dbsp-ordered-step current (zset-singleton (vector-ref rows 0) -999)))))
(check "absent retraction refuses" (raises? (lambda () (dbsp-ordered-step current (zset-singleton '(99 99) -1)))))
(check "inexact score refuses" (raises? (lambda () (dbsp-ordered-step current (zset-singleton '(0.5 99) 1)))))
(check "failure preserves previous view" (zset=? (dbsp-ordered-top current 4) (batch-top (batch-sort table) 4)))
(for-each (lambda (q) (check "invalid quantile refuses" (raises? (lambda () (dbsp-ordered-quantile current q))))) '(-1/2 3/2 0.5))
(for-each (lambda (rank) (check "invalid rank refuses" (raises? (lambda () (dbsp-ordered-select current rank))))) '(-1 999 1.0))
(define all (dbsp-ordered-top current 65536))
(check "oversized top request returns complete current multiset" (zset=? all (zset-from-weighted
  (map (lambda (pair) (list (cdr pair) (car pair))) table))))
(check "top zero is empty" (zset-empty? (dbsp-ordered-top current 0)))
(define tied (vector-ref (dbsp-ordered-step (make-dbsp-ordered car 3)
  (zset-from-weighted '((2 (1 1)) (2 (1 2)) (2 (1 3))))) 0))
(check "tie boundary splits multiplicity deterministically" (zset=? (dbsp-ordered-top tied 3)
  (zset-from-weighted '((1 (1 2)) (2 (1 3))))))
(check "tie quantile includes multiplicities" (equal? (vector-ref (dbsp-ordered-quantile tied 1/2) 0) '(1 2)))
(define no-view (dbsp-ordered-step (make-dbsp-ordered car) (zset-singleton '(1 1) 1)))
(check "unconfigured top view does no output materialization" (not (vector-ref no-view 1)))
(define guarded (make-dbsp-ordered (lambda (row) (if (= (cadr row) 99) (error "bad score") (car row))) 2))
(check "scorer failure refuses successor" (raises? (lambda () (dbsp-ordered-step guarded (zset-singleton '(1 99) 1)))))
(check "scorer failure leaves empty source" (= (vector-ref (dbsp-ordered-info guarded) 1) 0))
(define (family n descending?)
  (let loop ((i 0) (state (make-dbsp-ordered car)))
    (if (= i n) state
      (loop (+ i 1) (vector-ref (dbsp-ordered-step state
        (zset-singleton (list (if descending? (- n i) i) i) 1)) 0)))))
(define small (family 16 #f))
(define large (family 1024 #f))
(define descending (family 1024 #t))
(check "ascending construction remains balanced" (<= (vector-ref (dbsp-ordered-info large) 2) 20))
(check "descending construction remains balanced" (<= (vector-ref (dbsp-ordered-info descending) 2) 20))
(check "large index selects both endpoints" (and (equal? (vector-ref (dbsp-ordered-select large 0) 0) '(0 0))
  (equal? (vector-ref (dbsp-ordered-select large 1023) 0) '(1023 1023))))
(define local (dbsp-ordered-step large (zset-singleton '(7 7) 1)))
(check "local update visits a bounded logarithmic path" (and (> (vector-ref (vector-ref local 2) 1) 0)
  (< (vector-ref (vector-ref local 2) 1) 32) (< (vector-ref (vector-ref local 2) 2) 64)))
(check "local update preserves retained large snapshot" (= (vector-ref (dbsp-ordered-info large) 1) 1024))
(check "local update advances mass" (= (vector-ref (dbsp-ordered-info (vector-ref local 0)) 1) 1025))
;; Remove all rows in alternating orders to exercise both successor deletion
;; and single/double rotations, while the historical root remains intact.
(let deletes ((state descending) (i 0))
  (if (= i 1024) (check "complete deletion leaves empty balanced tree" (equal? (vector->list (dbsp-ordered-info state)) '(0 0 0)))
    (let ((next (vector-ref (dbsp-ordered-step state (zset-singleton (list (- 1024 i) i) -1)) 0)))
      (if (= (modulo i 128) 0) (check "deletion keeps weighted metadata" (= (vector-ref (dbsp-ordered-info next) 1) (- 1023 i))))
      (deletes next (+ i 1)))))
(check "history survives complete deletion" (= (vector-ref (dbsp-ordered-info descending) 1) 1024))
(define huge (string->number "1208925819614629174706176"))
(define huge-state (vector-ref (dbsp-ordered-step (make-dbsp-ordered car 2)
  (zset-singleton '(1 1) huge)) 0))
(check "bignum multiplicity remains exact" (= (vector-ref (dbsp-ordered-info huge-state) 1) huge))
(check "bignum weighted rank selects without expansion" (equal?
  (vector-ref (dbsp-ordered-select huge-state (- huge 1)) 0) '(1 1)))
(check "top-k splits bignum weight without expansion" (= (zset-weight (dbsp-ordered-top huge-state 2) '(1 1)) 2))
(check "bignum retraction empties view" (= (vector-ref (dbsp-ordered-info
  (vector-ref (dbsp-ordered-step huge-state (zset-singleton '(1 1) (- huge))) 0)) 1) 0))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1)))
(display "RESULT: PASS\n")
