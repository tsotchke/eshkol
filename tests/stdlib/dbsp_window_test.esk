(require stdlib)
(require core.dbsp.window)
(require core.dbsp.ordered)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define empty (make-dbsp-window car 10 3 'reject 0))
(define first-delta (zset-from-weighted '((1 (1 20)) (2 (7 30)) (1 (12 50)))))
(define first (vector-ref (dbsp-window-step empty first-delta 7) 0))
(check "future events buffered" (zset=? (dbsp-window-output first) (zset-from-weighted '((1 (1 20)) (2 (7 30))))))
(define next-step (dbsp-window-step first (zset-empty) 12))
(define next (vector-ref next-step 0))
(check "lower boundary expires while future event enters" (zset=? (dbsp-window-output next) (zset-from-weighted '((2 (7 30)) (1 (12 50))))))
(check "expiration and activation share signed delta" (zset=? (vector-ref next-step 1) (zset-from-weighted '((-1 (1 20)) (1 (12 50))))))
(check "history survives watermark advancement" (zset=? (dbsp-window-output first) (zset-from-weighted '((1 (1 20)) (2 (7 30))))))
(check "late insertion rejects atomically" (raises? (lambda () (dbsp-window-step next (zset-singleton '(8 11) 1) 13))))
(check "known late retraction is still allowed" (zset=? (dbsp-window-output (vector-ref (dbsp-window-step next (zset-singleton '(7 30) -1) 12) 0))
  (zset-from-weighted '((1 (7 30)) (1 (12 50))))))
(check "watermark reversal refuses" (raises? (lambda () (dbsp-window-step next (zset-empty) 11))))
(check "expired retraction refuses" (raises? (lambda () (dbsp-window-step next (zset-singleton '(1 20) -1) 12))))
(check "excess retraction refuses" (raises? (lambda () (dbsp-window-step next (zset-singleton '(7 30) -3) 12))))
(define drop (make-dbsp-window car 10 3 'drop 12))
(define dropped (dbsp-window-step drop (zset-from-weighted '((2 (8 4)) (1 (9 5)) (1 (12 6)))) 12))
(check "strict lateness boundary" (zset=? (dbsp-window-output (vector-ref dropped 0)) (zset-from-weighted '((1 (9 5)) (1 (12 6))))))
(check "dropped late multiplicity is explicit" (zset=? (vector-ref dropped 2) (zset-singleton '(8 4) 2)))
(check "drop policy cannot hide nonexistent deletion" (raises? (lambda () (dbsp-window-step drop (zset-singleton '(0 0) -1) 12))))
(check "consolidated zero batch needs no lateness admission" (zset-empty? (vector-ref (dbsp-window-step drop (zset-from-weighted '((1 (0 1)) (-1 (0 1)))) 12) 1)))
;; Every prefix uses an independent integrated relation + direct time filter.
(define current (make-dbsp-window car 5 100 'reject 0))
(define integrated (zset-empty)) (define relation (zset-empty))
(define ordered (make-dbsp-ordered cadr 3))
(let ticks ((t 0)) (if (< t 24)
  (let* ((delta (zset-from-weighted (list (list 1 (list t (* t t))) (list 2 (list (+ t 2) (+ t 5))))))
         (step (dbsp-window-step current delta t)) (new (vector-ref step 0))
         (expected-all (zset-add relation delta))
         (expected (zset-filter (lambda (row) (and (> (car row) (- t 5)) (<= (car row) t))) expected-all))
         (order-step (dbsp-ordered-step ordered (vector-ref step 1))))
    (set! relation expected-all) (set! integrated (zset-add integrated (vector-ref step 1)))
    (check "every prefix direct batch window oracle" (zset=? (dbsp-window-output new) expected))
    (check "every signed delta integrates" (zset=? integrated expected))
    (let* ((expanded (sort (fold-left (lambda (out entry)
       (append (make-list (car entry) (cadr entry)) out)) '() (zset-entries expected))
       (lambda (a b) (< (cadr a) (cadr b))))))
      (check "rolling exact median agrees with full sort" (= (vector-ref (dbsp-ordered-quantile (vector-ref order-step 0) 1/2) 1)
        (cadr (list-ref expanded (- (ceiling (/ (length expanded) 2)) 1))))))
    (set! ordered (vector-ref order-step 0)) (set! current new) (ticks (+ t 1)))))
(define perm-a (dbsp-window-step empty (zset-from-weighted '((1 (3 1)) (1 (2 2)) (1 (1 3)))) 3))
(define perm-b (dbsp-window-step empty (zset-from-weighted '((1 (1 3)) (1 (3 1)) (1 (2 2)))) 3))
(check "arrival order within a batch is irrelevant" (zset=? (dbsp-window-output (vector-ref perm-a 0)) (dbsp-window-output (vector-ref perm-b 0))))
(check "exact rational timestamp boundary" (zset=? (dbsp-window-output (vector-ref (dbsp-window-step (make-dbsp-window car 1/2 1 'reject 0)
  (zset-from-weighted '((1 (1/2 a)) (1 (1 b)))) 1) 0)) (zset-singleton '(1 b) 1)))
(check "nonpositive width refuses" (raises? (lambda () (make-dbsp-window car 0 1 'drop 0))))
(check "inexact timestamp refuses" (raises? (lambda () (dbsp-window-step empty (zset-singleton '(1.0 a) 1) 1))))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
