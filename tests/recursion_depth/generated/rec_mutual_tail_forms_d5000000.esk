; recursion-depth probe -- generated by scripts/gen_recursion_depth.py
; mutual tail recursion, 6-cycle through cond/when/or/case/unless/and -- proper tail call, O(1) stack
; KIND: mutual_tail_forms
; DEPTH: 5000000
; EXPECT: pass
(define (mfa n acc) (cond ((= n 0) acc) (else (mfb (- n 1) (+ acc n)))))
(define (mfb n acc) (if (= n 0) acc (when #t (mfc (- n 1) (+ acc n)))))
(define (mfc n acc) (if (= n 0) acc (or #f (mfd (- n 1) (+ acc n)))))
(define (mfd n acc) (case n ((0) acc) (else (mfe (- n 1) (+ acc n)))))
(define (mfe n acc) (if (= n 0) acc (unless #f (mff (- n 1) (+ acc n)))))
(define (mff n acc) (if (= n 0) acc (and #t (mfa (- n 1) (+ acc n)))))
(define __want (quotient (* 5000000 (+ 5000000 1)) 2))
(define __got (mfa 5000000 0))
(if (= __got __want)
    (begin (display "PASS: mutual_tail_forms d=5000000 v=") (display __got) (newline))
    (begin (display "WRONG: mutual_tail_forms d=5000000 got=") (display __got)
           (display " want=") (display __want) (newline)))
