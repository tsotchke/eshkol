;; merkle_domain_separation_test.esk — leaf hashes and interior hashes live in
;; separate domains (RFC 6962 section 2.1), and a node cannot be presented as
;; a leaf.
;;
;; The property under test: for any interior node of a tree, the data whose
;; leaf hash would equal that node's hash does not exist, because the two
;; hashes are computed over different prefixes. Without the prefixes, the hex
;; rendering of two child hashes IS such data, and a proof for a subtree reads
;; as a proof for a leaf whose content is that rendering.

(require stdlib)
(require core.merkle)

(define passed 0)
(define failed 0)
(define (check label expected actual)
  (if (equal? expected actual)
      (begin (display "PASS: ") (display label) (newline)
             (set! passed (+ passed 1)))
      (begin (display "FAIL: ") (display label)
             (display " (expected ") (display expected)
             (display ", got ") (display actual) (display ")") (newline)
             (set! failed (+ failed 1)))))

;; ── The prefixes are the bytes RFC 6962 names ──────────────────────
(check "leaf domain is one byte" 1 (string-length (merkle-leaf-domain)))
(check "node domain is one byte" 1 (string-length (merkle-node-domain)))
(check "leaf domain is 0x00" 0 (char->integer (string-ref (merkle-leaf-domain) 0)))
(check "node domain is 0x01" 1 (char->integer (string-ref (merkle-node-domain) 0)))
(check "the two domains differ"
       #t (not (string=? (merkle-leaf-domain) (merkle-node-domain))))
(check "format version" 2 (merkle-format-version))

;; A NUL prefix must actually reach the hash. If the prefix were dropped at
;; the string boundary, these two leaves would hash alike.
(check "the leaf prefix is part of what is hashed"
       #t (not (= (merkle-root (merkle-leaf "x"))
                  (merkle-root (merkle-leaf-v1 "x")))))
(check "leaves still differ by their data"
       #t (not (= (merkle-root (merkle-leaf "x"))
                  (merkle-root (merkle-leaf "y")))))

;; ── A node cannot be presented as a leaf ───────────────────────────
;;
;; Build a two-leaf tree. Its root is the interior hash over the hex
;; renderings of the two leaf hashes. The data a forger would offer is exactly
;; that concatenation: under version 1 the root is the leaf hash of it, so a
;; one-element proof is unnecessary and `merkle-verify` with an empty proof
;; accepts. Under version 2 it does not, because the leaf domain is not the
;; interior domain.
(define two (merkle-tree (list "left" "right")))
(define forged-data
  (string-append (hash->hex (merkle-root (merkle-leaf "left")))
                 (hash->hex (merkle-root (merkle-leaf "right")))))

(check "the interior hash is not the leaf hash of the children's renderings"
       #t (not (= (merkle-root two)
                  (merkle-root (merkle-leaf forged-data)))))
(check "an interior node cannot be presented as a leaf"
       #f (merkle-verify (merkle-root two) forged-data '()))

;; The same forgery against the version-1 computation succeeds, which is why
;; the domains exist. This is the control: it shows the test is testing the
;; prefixes and not something else.
(define two-v1 (merkle-tree-v1 (list "left" "right")))
(define forged-data-v1
  (string-append (hash->hex (merkle-root (merkle-leaf-v1 "left")))
                 (hash->hex (merkle-root (merkle-leaf-v1 "right")))))
(check "under version 1 the same forgery is accepted"
       #t (merkle-verify-v1 (merkle-root two-v1) forged-data-v1 '()))

;; ── Honest proofs still verify, at every size ──────────────────────
(define data (list "a" "b" "c" "d" "e"))
(define tree (merkle-tree data))
(define root (merkle-root tree))

(check "proof for leaf 0" #t (merkle-verify root "a" (merkle-proof tree 0)))
(check "proof for leaf 1" #t (merkle-verify root "b" (merkle-proof tree 1)))
(check "proof for leaf 2" #t (merkle-verify root "c" (merkle-proof tree 2)))
(check "proof for leaf 3" #t (merkle-verify root "d" (merkle-proof tree 3)))
(check "proof for leaf 4" #t (merkle-verify root "e" (merkle-proof tree 4)))
(check "a proof does not verify other data"
       #f (merkle-verify root "z" (merkle-proof tree 0)))
(check "a proof does not verify under another root"
       #f (merkle-verify (merkle-root (merkle-tree (list "x" "y")))
                         "a" (merkle-proof tree 0)))
(check "leaves round-trip" data (merkle-leaves tree))

;; Version 2 and version 1 produce different roots over the same data, which
;; is the reason the version is named and version 1 kept.
(check "the two format versions differ over the same data"
       #t (not (= (merkle-root (merkle-tree data))
                  (merkle-root (merkle-tree-v1 data)))))
(check "version 1 proofs verify under version 1"
       #t (let ((t (merkle-tree-v1 data)))
            (merkle-verify-v1 (merkle-root t) "c" (merkle-proof-v1 t 2))))
(check "a version-1 proof does not verify under version 2"
       #f (let ((t (merkle-tree-v1 data)))
            (merkle-verify (merkle-root t) "c" (merkle-proof-v1 t 2))))

;; ── Content-addressable storage is unchanged ───────────────────────
;; cas-put! hashes the content itself, not a leaf, so keys recorded by a CAS
;; are the same values they always were.
(define store (make-cas))
(define key (cas-put! store "payload"))
(check "cas key is the content hash" (hash->hex (fnv1a-64 "payload")) key)
(check "cas round-trips" "payload" (cas-get store key))

(display "merkle domain separation: ")
(display passed) (display " passed, ")
(display failed) (display " failed")
(newline)
(if (= failed 0)
    (display "MERKLE-DOMAIN-SEPARATION OK\n")
    (display "MERKLE-DOMAIN-SEPARATION FAILED\n"))
