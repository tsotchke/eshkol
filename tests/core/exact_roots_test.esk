;;; core.exact_roots — MS-05 / SW-167: `sqrt` of an exact perfect square
;;; (integer or rational) and `expt` with an exact rational exponent stay
;;; exact when the exact root exists, on both engines.
;;;
;;; Before this fix, `(sqrt 16)` returned the INEXACT 4.0 (`(exact? (sqrt
;;; 16))` => #f), `(sqrt 1/4)` returned the inexact 0.5, and `(expt 4 1/2)`
;;; returned the inexact 2.0. R7RS 6.2.6 requires the exact result whenever
;;; the exact root exists ("if z is an exact nonnegative number and the
;;; exact square root of z is exact, then (sqrt z) is exact"). The general
;;; form extends the same rule to exact-integer-sqrt-shaped n-th roots via
;;; expt with a rational exponent.
;;;
;;; Root cause (native): neither `sqrt` nor `expt`'s codegen (llvm_codegen.cpp
;;; / arithmetic_codegen.cpp) ever attempted an exact root for an exact
;;; operand -- `sqrt` always called libm sqrt() on the extracted double once
;;; the negative-exact-promotes-to-complex case was ruled out, and `expt`'s
;;; only exact path was an exact INTEGER exponent (eshkol_bignum_pow_tagged /
;;; eshkol_rational_pow_tagged); a fractional exact rational exponent fell
;;; straight through to double pow().
;;;
;;; Root cause (VM): lib/backend/vm_native.c's native call id 25 (sqrt) and
;;; id 32 (expt/pow) had the identical gap -- id 25 always computed
;;; `sqrt(as_number(a))` once vm_math_promote_negative ruled out the negative
;;; case, and id 32's only exact path was an exact INTEGER exponent.
;;;
;;; Fixed by, both engines sharing one exact-tower primitive:
;;;   - lib/core/bignum.cpp: new eshkol_bignum_iroot(arena, a, n, *out_exact)
;;;     -- exact/floor n-th integer root via Newton's method, seeded from a
;;;     bit-length estimate, verified by re-raising to the n-th power.
;;;   - lib/core/rational.cpp: new eshkol_exact_sqrt_tagged and
;;;     eshkol_exact_rational_pow_tagged, both built on eshkol_bignum_iroot,
;;;     taking numerator/denominator roots independently and falling back to
;;;     the caller-supplied double only when the exact root doesn't exist.
;;;   - lib/backend/llvm_codegen.cpp (sqrt's real-domain branch) and
;;;     lib/backend/arithmetic_codegen.cpp (ArithmeticCodegen::pow) call the
;;;     new native entry points.
;;;   - lib/backend/vm_bignum.c: mirror bignum_iroot (VM's own base-2^32
;;;     bignum representation). lib/backend/vm_native.c: vm_exact_sqrt /
;;;     vm_exact_rational_pow wire it into native call ids 25 and 32.
;;;
;;; docs/breakdown/EXACT_ARITHMETIC.md documents the numeric tower's
;;; exactness-preservation contract for expt's exact-integer-exponent path;
;;; this fix and test extend that documented contract to sqrt and to a
;;; fractional exact rational exponent, per R7RS 6.2.6. A negative exact
;;; base is NOT promoted to an exact result here: sqrt/log already promote a
;;; negative exact real to a (necessarily inexact, per EXACT_ARITHMETIC.md
;;; sec 1 "complex ... always inexact") complex value, which this test pins
;;; as unchanged; expt keeps ordinary IEEE pow() semantics for a negative
;;; base with a fractional exponent, since Eshkol's expt has never promoted
;;; to complex the way sqrt/log do and R7RS does not require it to.

(define pass 0)
(define fail 0)
(define (check nm ok)
  (if ok
      (begin (set! pass (+ pass 1)) (display "PASS: ") (display nm) (newline))
      (begin (set! fail (+ fail 1)) (display "FAIL: ") (display nm) (newline))))

;; ---- the reported defects, verbatim ----

(check "(sqrt 16) = 4" (= (sqrt 16) 4))
(check "(sqrt 16) is exact" (exact? (sqrt 16)))
(check "(sqrt 1/4) = 1/2" (= (sqrt 1/4) 1/2))
(check "(sqrt 1/4) is exact" (exact? (sqrt 1/4)))
(check "(expt 4 1/2) = 2" (= (expt 4 1/2) 2))
(check "(expt 4 1/2) is exact" (exact? (expt 4 1/2)))

;; ---- sqrt of a perfect square: small integers, 0, 1 ----

(check "(sqrt 0) = 0 exact" (and (exact? (sqrt 0)) (= (sqrt 0) 0)))
(check "(sqrt 1) = 1 exact" (and (exact? (sqrt 1)) (= (sqrt 1) 1)))
(check "(sqrt 9) = 3 exact" (and (exact? (sqrt 9)) (= (sqrt 9) 3)))
(check "(sqrt 144) = 12 exact" (and (exact? (sqrt 144)) (= (sqrt 144) 12)))

;; ---- sqrt of a perfect-square RATIONAL (numerator and denominator both
;; perfect squares) ----

(check "(sqrt 4/9) = 2/3 exact" (and (exact? (sqrt 4/9)) (= (sqrt 4/9) 2/3)))
(check "(sqrt 25/16) = 5/4 exact" (and (exact? (sqrt 25/16)) (= (sqrt 25/16) 5/4)))
(check "(sqrt 1/9) = 1/3 exact" (and (exact? (sqrt 1/9)) (= (sqrt 1/9) 1/3)))

;; ---- sqrt of a perfect-square BIGNUM (exercises eshkol_bignum_iroot on a
;; magnitude that does not fit int64) ----

(define big-square (* (expt 10 20) (expt 10 20)))
(check "(expt 10 20)^2 built as an exact bignum" (exact? big-square))
(check "(sqrt bignum-perfect-square) is exact" (exact? (sqrt big-square)))
(check "(sqrt bignum-perfect-square) = 10^20" (= (sqrt big-square) (expt 10 20)))

;; ---- negative controls: NOT a perfect square/rational stays inexact, and
;; the inexact VALUE is still numerically correct (sqrt(15), sqrt(0.5)) ----

(check "(sqrt 15) is inexact" (not (exact? (sqrt 15))))
(check "(sqrt 15) value" (< (abs (- (sqrt 15) 3.872983346207417)) 1e-12))
(check "(sqrt 2) is inexact" (not (exact? (sqrt 2))))
(check "(sqrt 1/2) is inexact" (not (exact? (sqrt 1/2))))
(check "(sqrt 1/2) value" (< (abs (- (sqrt 1/2) 0.7071067811865476)) 1e-12))
;; A rational whose NUMERATOR alone is a perfect square (denominator is not)
;; must still be inexact -- both halves must verify independently.
(check "(sqrt 4/3) is inexact (denominator 3 not a perfect square)"
       (not (exact? (sqrt 4/3))))
(check "(sqrt 2/9) is inexact (numerator 2 not a perfect square)"
       (not (exact? (sqrt 2/9))))

;; ---- sqrt on an inexact (double) operand is untouched: always inexact,
;; even when the value happens to be integral ----

(check "(sqrt 16.0) is inexact" (not (exact? (sqrt 16.0))))
(check "(sqrt 16.0) = 4." (= (sqrt 16.0) 4.0))

;; ---- negative exact base: unchanged pre-existing complex-promotion
;; behavior (regression pin, not part of this fix) ----

(check "(sqrt -4) is not real (promoted to complex)" (not (real? (sqrt -4))))
(check "(sqrt -4) is not exact" (not (exact? (sqrt -4))))

;; ---- expt with an exact rational exponent: the R7RS 6.2.6 cases from the
;; ticket, plus denominators other than 2 ----

(check "(expt 8 2/3) = 4 exact" (and (exact? (expt 8 2/3)) (= (expt 8 2/3) 4)))
(check "(expt 1/27 1/3) = 1/3 exact" (and (exact? (expt 1/27 1/3)) (= (expt 1/27 1/3) 1/3)))
(check "(expt 9 1/2) = 3 exact" (and (exact? (expt 9 1/2)) (= (expt 9 1/2) 3)))
(check "(expt 1/4 1/2) = 1/2 exact" (and (exact? (expt 1/4 1/2)) (= (expt 1/4 1/2) 1/2)))
;; Negative rational exponent numerator: root-then-invert.
(check "(expt 9 -1/2) = 1/3 exact" (and (exact? (expt 9 -1/2)) (= (expt 9 -1/2) 1/3)))
(check "(expt 4 -1/2) = 1/2 exact" (and (exact? (expt 4 -1/2)) (= (expt 4 -1/2) 1/2)))
;; Exponent numerator other than 1: root raised to a power.
(check "(expt 4 3/2) = 8 exact" (and (exact? (expt 4 3/2)) (= (expt 4 3/2) 8)))
(check "(expt 9 3/2) = 27 exact" (and (exact? (expt 9 3/2)) (= (expt 9 3/2) 27)))

;; ---- negative controls: no exact n-th root exists -> stays inexact, value
;; still numerically correct ----

(check "(expt 2 1/2) is inexact" (not (exact? (expt 2 1/2))))
(check "(expt 2 1/2) value" (< (abs (- (expt 2 1/2) 1.4142135623730951)) 1e-12))
(check "(expt 4 1/3) is inexact (4 not a perfect cube)" (not (exact? (expt 4 1/3))))
(check "(expt 2 3/2) is inexact" (not (exact? (expt 2 3/2))))
(check "(expt 2 3/2) value" (< (abs (- (expt 2 3/2) 2.8284271247461903)) 1e-12))

;; ---- expt with an exact INTEGER exponent is untouched (pre-existing
;; SW-152 path, regression pin against a shared-dispatch break) ----

(check "(expt 1/3 50) is exact (unrelated pre-existing path)" (exact? (expt 1/3 50)))
(check "(expt 2 10) = 1024 exact" (and (exact? (expt 2 10)) (= (expt 2 10) 1024)))

;; ---- negative exact base with a fractional exponent: R7RS does not
;; require an exact (or even real) result and Eshkol's expt does not
;; promote to complex; must stay inexact regardless ----

(check "(expt -8 1/3) is not exact" (not (exact? (expt -8 1/3))))
(check "(expt -4 1/2) is not exact" (not (exact? (expt -4 1/2))))

;; ---- exactness contagion: an inexact participant on either side demotes
;; the whole expt, matching the pre-existing rule for integer exponents ----

(check "(expt 4 0.5) is inexact" (not (exact? (expt 4 0.5))))
(check "(expt 4 0.5) = 2." (= (expt 4 0.5) 2.0))
(check "(expt 4.0 1/2) is inexact" (not (exact? (expt 4.0 1/2))))

(newline) (display "Passed: ") (display pass) (newline)
(display "Failed: ") (display fail) (newline)
(if (> fail 0) (exit 1))
