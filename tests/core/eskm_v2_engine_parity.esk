;; Inputs and exact-byte expectations come from Python, never an engine output.
(define failures 0)
(define (list-count value) (if (null? value) 0 (+ 1 (list-count (cdr value)))))
(define (check name ok)
  (if ok #t (begin (set! failures (+ failures 1))
                   (display "FAIL: ") (display name) (newline))))
(define (check-tensor name value shape count)
  (check name (tensor? value))
  (if (tensor? value)
      (begin
        (check "shape" (equal? (tensor-shape value) shape))
        (check "size" (= (vector-length (tensor-data value)) count))
        (check "dtype" (or (equal? (tensor-dtype value) 'f64)
                            (equal? (tensor-dtype value) "f64")))) #f))
(define (tensor-roundtrip stem shape count)
  (let ((value (tensor-load (string-append stem ".eskm"))))
    (check-tensor stem value shape count)
    (if (tensor? value)
        (check "tensor save" (tensor-save (string-append "tensor-" stem ".eskm") value)) #f)))
(define (model-roundtrip stem count)
  (let ((value (model-load (string-append stem ".eskm"))))
    (check "model count" (= (list-count value) count))
    (check "model save" (model-save (string-append "model-" stem ".eskm") value))))
(define (roundtrip)
  (tensor-roundtrip "scalar" '() 1)
  (tensor-roundtrip "empty" '(0 3) 0)
  (tensor-roundtrip "ordinary" '(2 3) 6)
  (tensor-roundtrip "rank8" '(1 1 1 1 1 1 1 1) 1)
  (model-roundtrip "scalar" 1)
  (model-roundtrip "empty" 1)
  (model-roundtrip "ordinary" 1)
  (model-roundtrip "rank8" 1)
  (model-roundtrip "multi" 2)
  (model-roundtrip "empty-model" 0)
  (let ((value (model-load "multi.eskm")))
    (check "duplicate names and order"
      (and (equal? (car (car value)) "duplicate")
           (equal? (car (car (cdr value))) "duplicate")
           (equal? (tensor-shape (cdr (car value))) '())
           (equal? (tensor-shape (cdr (car (cdr value)))) '(0 3))))))
(define (region-tensor stem shape count)
  (let ((value (with-region 'checkpoint (tensor-load (string-append stem ".eskm")))))
    (with-region 'churn (make-vector 4096 123.0))
    (check-tensor "escaped tensor" value shape count)
    (if (tensor? value)
        (check "escaped tensor save" (tensor-save (string-append "tensor-" stem ".eskm") value)) #f)))
(define (region-model stem shape count)
  (let ((value (with-region 'checkpoint (model-load (string-append stem ".eskm")))))
    (with-region 'churn (make-vector 4096 456.0))
    (check "escaped model" (pair? value))
    (if (pair? value)
        (begin (check-tensor "escaped model tensor" (cdr (car value)) shape count)
               (check "escaped model save" (model-save (string-append "model-" stem ".eskm") value))) #f)))
(define (reject stem)
  (check "tensor refused" (null? (tensor-load (string-append stem ".eskm"))))
  (check "model refused" (null? (model-load (string-append stem ".eskm")))))
(define mode (getenv "ESKM_V2_PARITY_MODE"))
(cond
  ((equal? mode "roundtrip") (roundtrip))
  ((equal? mode "annotated") (tensor-roundtrip "annotated" '() 1) (model-roundtrip "annotated" 1))
  ((equal? mode "region")
    (region-tensor "scalar" '() 1) (region-tensor "empty" '(0 3) 0)
    (region-model "scalar" '() 1) (region-model "empty" '(0 3) 0))
  ((equal? mode "reject")
    (reject "mandatory") (reject "rank9") (reject "signed-empty") (reject "nul-name")
    (reject "version") (reject "tlv") (reject "crc") (reject "trailing"))
  ((equal? mode "off") (reject "scalar"))
  ((equal? mode "unknown")
    (reject "scalar")
    (check "unknown mode write refused" (not (tensor-save "refused.eskm" (tensor 1 2.0)))))
  (else (check "known test mode" #f)))
(if (= failures 0)
    (begin (display "ESKM-V2-PARITY:PASS") (newline))
    (begin (display "ESKM-V2-PARITY:FAIL") (newline) (exit 1)))
