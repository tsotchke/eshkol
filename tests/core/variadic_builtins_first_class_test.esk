;;; variadic_builtins_first_class_test.esk
;;;
;;; SW-173: a VARIADIC builtin referenced as a first-class value did not
;;; behave like its call-position form. Two distinct defects, one class.
;;;
;;; 1. `map` resolves its procedure through resolveLambdaFunction and calls
;;;    it with as many arguments as it has lists. That site carried a
;;;    hand-written per-arity factory for `list` which terminated the cons
;;;    chain with a tagged INTEGER 0 instead of nil, so
;;;    `(map list (list 1 2 3))` answered `((1 . 0) (2 . 0) (3 . 0))` --
;;;    improper lists, from a program with no error in it; `(length (car
;;;    (map list (list 1 2))))` then raised "cdr: argument is not a pair".
;;;    Every other variadic builtin reached the same site with no row at
;;;    all and was wrapped at a FIXED arity, so `(map vector xs ys)`
;;;    silently dropped the second list.
;;;
;;; 2. A variadic builtin referenced as a VALUE materialised as a
;;;    fixed-arity closure, so every argument past that arity was dropped:
;;;    `(apply vector (list 1 2 3))` -> `#(1)`,
;;;    `(define f string-append) (f "a" "b" "c")` -> `"ab"`.
;;;    And `apply` itself spread the argument list into separate parameters
;;;    even for a closure flagged VARIADIC, whose entry point takes ONE rest
;;;    list -- `(apply string-append '("a" "b" "c"))` answered a raw word.
;;;
;;; Fix: the first-class builtin table declares which rows are variadic and
;;; how each computes its answer from a REST LIST (identity for `list`, a
;;; unary builtin for `vector`/`string`, a left fold over the binary form
;;; for `string-append`/`max`/...); resolveLambdaFunction wraps a variadic
;;; row at the CALL SITE's arity through the same generator the call
;;; position uses; and apply honours CLOSURE_FLAG_VARIADIC. No second
;;; hand-written implementation of any builtin.
;;;
;;; Written in the core-Scheme subset so it runs on both engines.

(define failures 0)

(define (check name ok)
  (if ok
      (begin (display "PASS: ") (display name) (newline))
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (newline))))

;; hN calls its first argument with N further arguments -- a bare PARAMETER,
;; so there is no name for the call-site lowering to special-case.
(define (h2 f a b) (f a b))
(define (h3 f a b c) (f a b c))

;; ---- the SW-173 acceptance case ------------------------------------------
(check "map list, 1 list"
       (equal? (map list (list 1 2)) (list (list 1) (list 2))))
(check "map list, 1 list, proper (length of an element)"
       (= (length (car (map list (list 1 2)))) 1))
(check "map list, 2 lists"
       (equal? (map list (list 1 2) (list 3 4))
               (list (list 1 3) (list 2 4))))
(check "map lambda list, control"
       (equal? (map (lambda (x) (list x)) (list 1 2))
               (list (list 1) (list 2))))

;; ---- list ----------------------------------------------------------------
(define alias-list list)
(check "apply list"      (equal? (apply list (list 1 2 3)) (list 1 2 3)))
(check "alias list, 3"   (equal? (alias-list 1 2 3) (list 1 2 3)))
(check "h3 list"         (equal? (h3 list 1 2 3) (list 1 2 3)))

;; ---- vector --------------------------------------------------------------
(define alias-vector vector)
(check "map vector, 1 list"
       (equal? (map vector (list 1 2)) (list (vector 1) (vector 2))))
(check "map vector, 2 lists"
       (equal? (map vector (list 1 2) (list 3 4))
               (list (vector 1 3) (vector 2 4))))
(check "apply vector"    (equal? (apply vector (list 1 2 3)) (vector 1 2 3)))
(check "alias vector, 3" (equal? (alias-vector 1 2 3) (vector 1 2 3)))
(check "h3 vector"       (equal? (h3 vector 1 2 3) (vector 1 2 3)))

;; ---- string-append -------------------------------------------------------
(define alias-string-append string-append)
(check "map string-append, 2 lists"
       (equal? (map string-append (list "a" "b") (list "x" "y"))
               (list "ax" "by")))
(check "apply string-append"
       (equal? (apply string-append (list "a" "b" "c")) "abc"))
(check "alias string-append, 3"
       (equal? (alias-string-append "a" "b" "c") "abc"))
(check "h3 string-append" (equal? (h3 string-append "a" "b" "c") "abc"))
(check "h2 string-append" (equal? (h2 string-append "a" "b") "ab"))

;; ---- append --------------------------------------------------------------
(define alias-append append)
(check "apply append"
       (equal? (apply append (list (list 1) (list 2) (list 3)))
               (list 1 2 3)))
(check "alias append, 3"
       (equal? (alias-append (list 1) (list 2) (list 3)) (list 1 2 3)))

;; ---- + -------------------------------------------------------------------
(define alias-plus +)
(check "map +, 2 lists"  (equal? (map + (list 1 5) (list 4 2)) (list 5 7)))
(check "apply +"         (= (apply + (list 1 2 3)) 6))
(check "alias +, 3"      (= (alias-plus 1 2 3) 6))
(check "h3 +"            (= (h3 + 1 2 3) 6))

;; ---- max -----------------------------------------------------------------
;; The ORDER matters: a wrapper that keeps only the first two arguments
;; answers 3 here, which is why the largest element is last.
(define alias-max max)
(check "map max, 2 lists" (equal? (map max (list 1 5) (list 4 2)) (list 4 5)))
(check "apply max, max last"   (= (apply max (list 1 3 9)) 9))
(check "alias max, max last"   (= (alias-max 1 3 9) 9))
(check "h3 max, max last"      (= (h3 max 1 3 9) 9))

(if (= failures 0)
    (begin (display "PASS: variadic first-class builtins -- 0 failures") (newline))
    (begin (display "FAIL: variadic first-class builtins -- ")
           (display failures)
           (display " failure(s)")
           (newline)))
