;;; builtins_first_class_test_16.esk — AUTO-GENERATED, do not hand-edit.
;;;
;;; Chunk 16 of 17 of the LE-16 first-class-builtins audit. Regenerate
;;; ALL chunks (this file is one of several — see the module docstring in
;;; the generator for why) with:
;;;     python3 scripts/gen_builtins_first_class_test.py
;;; Source of truth: tests/coverage/language_surface.json +
;;; tests/coverage/builtins_first_class_known_args.json. See LE-16 in
;;; .icc/ledger/entries/LE-16.yaml for the root cause and the fix.
;;;
;;; Every builtin that can be called in operator position must also be a
;;; first-class value: it must evaluate to a procedure, survive being
;;; stored (let), passed to a user higher-order procedure, mapped, and
;;; applied — and, wherever this audit could verify a real call safely
;;; (i.e. without executing an FFI/GPU/atomics/pointer side effect), a
;;; value-position call must compute the identical answer to the same
;;; call in operator position. This chunk carries 50 such checks.

;; hN calls its first argument with N further arguments. Each is a bare
;; PARAMETER, so its value must be a real callable — there is no name here
;; for codegenCall to special-case; this is what forces the value-position
;; route (codegenVariable / resolveLambdaFunction) rather than the call-site
;; lowering, which was never broken.
(define (h0 f) (f))
(define (h1 f a) (f a))
(define (h2 f a b) (f a b))
(define (h3 f a b c) (f a b c))
(define (h4 f a b c d) (f a b c d))
(define (h5 f a b c d e) (f a b c d e))
(define (__id x) x)
;; Shared hash-table fixture for the hash-category call-correctness checks
;; below (mirrors scripts/run_value_position_sweep.py's own __ht convention).
(define __ht (make-hash-table))
(hash-table-set! __ht 1 10)

(define failures 0)
(define checked 0)
(define (check name ok)
  (set! checked (+ checked 1))
  (if ok
      (begin (display "PASS ") (display name) (newline))
      (begin (set! failures (+ failures 1))
             (display "FAIL ") (display name) (newline))))

(check "zero-grad!::value" (and (procedure? zero-grad!) (let ((f zero-grad!)) (procedure? f)) (procedure? (__id zero-grad!)) (procedure? (car (map __id (list zero-grad!)))) (procedure? (apply __id (list zero-grad!)))))
(check "zero?::value" (and (procedure? zero?) (let ((f zero?)) (procedure? f)) (procedure? (__id zero?)) (procedure? (car (map __id (list zero?)))) (procedure? (apply __id (list zero?)))))
(check "zeros::value" (and (procedure? zeros) (let ((f zeros)) (procedure? f)) (procedure? (__id zeros)) (procedure? (car (map __id (list zeros)))) (procedure? (apply __id (list zeros)))))
(check "%::calls" (equal? (% 3 5) (h2 % 3 5)))
(check "/rational::calls" (equal? (/rational 1 2) (h2 /rational 1 2)))
(check "angle::calls" (equal? (angle 3) (h1 angle 3)))
(check "apply::calls" (equal? (apply (lambda (x) x) (list 1 2 3)) (h2 apply (lambda (x) x) (list 1 2 3))))
(check "arithmetic-shift::calls" (equal? (arithmetic-shift 3 5) (h2 arithmetic-shift 3 5)))
(check "binary-port?::calls" (equal? (binary-port? 3) (h1 binary-port? 3)))
(check "bit-count::calls" (equal? (bit-count 3) (h1 bit-count 3)))
(check "bit-shift-left::calls" (equal? (bit-shift-left 3 5) (h2 bit-shift-left 3 5)))
(check "bit-shift-right::calls" (equal? (bit-shift-right 3 5) (h2 bit-shift-right 3 5)))
(check "bitwise-and::calls" (equal? (bitwise-and 3 5) (h2 bitwise-and 3 5)))
(check "bitwise-not::calls" (equal? (bitwise-not 3) (h1 bitwise-not 3)))
(check "bitwise-or::calls" (equal? (bitwise-or 3 5) (h2 bitwise-or 3 5)))
(check "bitwise-xor::calls" (equal? (bitwise-xor 3 5) (h2 bitwise-xor 3 5)))
(check "bytevector-length::calls" (equal? (bytevector-length (vector 1 2 3)) (h1 bytevector-length (vector 1 2 3))))
(check "bytevector-u8-ref::calls" (equal? (bytevector-u8-ref (vector 1 2 3) 1) (h2 bytevector-u8-ref (vector 1 2 3) 1)))
(check "bytevector?::calls" (equal? (bytevector? 3) (h1 bytevector? 3)))
(check "char-ready?::calls" (equal? (char-ready? 3) (h1 char-ready? 3)))
(check "error-object?::calls" (equal? (error-object? 3) (h1 error-object? 3)))
(check "exact-rational?::calls" (equal? (exact-rational? 3) (h1 exact-rational? 3)))
(check "executable-exists?::calls" (equal? (executable-exists? 3) (h1 executable-exists? 3)))
(check "floor-quotient::calls" (equal? (floor-quotient 3 5) (h2 floor-quotient 3 5)))
(check "floor-remainder::calls" (equal? (floor-remainder 3 5) (h2 floor-remainder 3 5)))
(check "hash-clear!::calls" (equal? (hash-clear! __ht) (h1 hash-clear! __ht)))
(check "hash-count::calls" (equal? (hash-count __ht) (h1 hash-count __ht)))
(check "hash-has-key?::calls" (equal? (hash-has-key? __ht 1) (h2 hash-has-key? __ht 1)))
(check "hash-keys::calls" (equal? (hash-keys __ht) (h1 hash-keys __ht)))
(check "hash-ref::calls" (equal? (hash-ref __ht 1) (h2 hash-ref __ht 1)))
(check "hash-set!::calls" (equal? (hash-set! __ht 1 2) (h3 hash-set! __ht 1 2)))
(check "hash-table-clear!::calls" (equal? (hash-table-clear! __ht) (h1 hash-table-clear! __ht)))
(check "hash-table-contains?::calls" (equal? (hash-table-contains? __ht 1) (h2 hash-table-contains? __ht 1)))
(check "hash-table-exists?::calls" (equal? (hash-table-exists? __ht 1) (h2 hash-table-exists? __ht 1)))
(check "hash-table-keys::calls" (equal? (hash-table-keys __ht) (h1 hash-table-keys __ht)))
(check "hash-table-ref::calls" (equal? (hash-table-ref __ht 1) (h2 hash-table-ref __ht 1)))
(check "hash-table-ref/default::calls" (equal? (hash-table-ref/default __ht 1 2) (h3 hash-table-ref/default __ht 1 2)))
(check "hash-table-set!::calls" (equal? (hash-table-set! __ht 1 2) (h3 hash-table-set! __ht 1 2)))
(check "hash-table-size::calls" (equal? (hash-table-size __ht) (h1 hash-table-size __ht)))
(check "hash-table-values::calls" (equal? (hash-table-values __ht) (h1 hash-table-values __ht)))
(check "hash-table/count::calls" (equal? (hash-table/count __ht) (h1 hash-table/count __ht)))
(check "hash-table?::calls" (equal? (hash-table? __ht) (h1 hash-table? __ht)))
(check "hash-values::calls" (equal? (hash-values __ht) (h1 hash-values __ht)))
(check "imag-part::calls" (equal? (imag-part 3) (h1 imag-part 3)))
(check "input-port-open?::calls" (equal? (input-port-open? 3) (h1 input-port-open? 3)))
(check "last::calls" (equal? (last (list 1 2 3)) (h1 last (list 1 2 3))))
(check "last-pair::calls" (equal? (last-pair (list 1 2 3)) (h1 last-pair (list 1 2 3))))
(check "list*::calls" (equal? (list* (list 1 2 3)) (h1 list* (list 1 2 3))))
(check "magnitude::calls" (equal? (magnitude 3) (h1 magnitude 3)))
(check "make-polar::calls" (equal? (make-polar 3 5) (h2 make-polar 3 5)))

(display "checked=") (display checked) (newline)
(display "failures=") (display failures) (newline)
(if (= failures 0)
    (begin (display "PASS: builtins first-class -- 0 failures") (newline))
    (begin (display "FAIL: builtins first-class -- ")
           (display failures) (display " failure(s)") (newline)))
(if (> failures 0) (exit 1) (exit 0))
