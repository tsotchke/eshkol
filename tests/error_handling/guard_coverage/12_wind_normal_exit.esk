;; ESH-0101 guard coverage — `dynamic-wind` NORMAL exit around/inside a `guard`.
;; Split across three files on purpose: each block below compiles and runs
;; correctly on every axis ALONE, but all three in ONE module fail native LLVM
;; module verification ("Instruction does not dominate all uses"). That
;; interaction is filed as found/guard_wind_multi_module_dominance.esk; keeping
;; the blocks separate here preserves the per-construct coverage on the native
;; axes instead of losing all of it to one module-level defect.

(define (chk name ok)
  (if ok
      (begin (display "PASS:") (display name) (display " "))
      (begin (display "FAIL:") (display name) (display " "))))

;; no exception at all: before/after each run exactly once, body value returned
(define b1 0) (define a1 0)
(define r1
  (guard (e (#t "unreached"))
    (dynamic-wind (lambda () (set! b1 (+ b1 1)))
                  (lambda () 42)
                  (lambda () (set! a1 (+ a1 1))))))
(chk "wind-normal-value" (equal? r1 42))
(chk "wind-normal-before-once" (equal? b1 1))
(chk "wind-normal-after-once" (equal? a1 1))
