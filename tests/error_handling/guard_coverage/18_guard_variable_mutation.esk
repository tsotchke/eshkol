;; ESH-0101 guard coverage — `set!` on the guard VARIABLE inside a clause.
;; R7RS derives `guard` through `(let ((var condition)) ...)` and a let-bound
;; variable is assignable, so this is legal. Own case because it is the one
;; place the NATIVE axes are the wrong ones: they reject the assignment
;; outright while both VM axes accept it and answer correctly.
;; Repro: found/native_setbang_on_guard_variable_rejected.esk (ledger SW-87).

(define (chk name ok)
  (if ok
      (begin (display "PASS:") (display name) (display " "))
      (begin (display "FAIL:") (display name) (display " "))))

(define e "outer-value")
(chk "set-guard-var"
     (equal? (guard (e (#t (set! e (list 'mutated e)) e)) (raise 'orig))
             (list 'mutated 'orig)))
(chk "outer-still-intact" (equal? e "outer-value"))
