;; R7RS Exception Handling Tests
;; Tests with-exception-handler, raise, guard

(display "=== Exception Handling Tests ===") (newline)

;; Test 1: a returned handler causes a secondary exception, caught by guard.
;; The sentinel differs from the handler's old return value so the old
;; swallowing behaviour cannot pass this smoke test.
(display "Test 1 - basic raise/handler: ")
(display (guard (secondary (#t 'secondary-handler-return))
  (with-exception-handler
    (lambda (err) 42)
    (lambda () (raise "error!")))))
(newline)

;; Test 2: guard expression (R7RS: exn bound to raised value)
(display "Test 2 - guard: ")
(display (guard (exn (#t (+ 100 exn)))
  (raise 5)))
(newline)

;; Test 3: Normal return (no exception)
(display "Test 3 - no exception: ")
(display (with-exception-handler
  (lambda (err) 0)
  (lambda () (+ 10 20))))
(newline)

;; Test 4: nested handlers, with the outer returned-handler secondary caught
(display "Test 4 - nested: ")
(display (guard (secondary (#t 1005))
  (with-exception-handler
    (lambda (err) (+ err 1000))
    (lambda ()
      (with-exception-handler
        (lambda (err) (raise (+ err 100)))
        (lambda () (raise 5)))))))
(newline)

(display "=== Exception Tests Complete ===") (newline)
