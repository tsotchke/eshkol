;;; tests/memory/vm_region_evac_level_carrier_test.esk
;;; ADR-0027: a nested differentiation level is a VmDual whose lcoeff array
;;; holds further VmDuals, at any depth. When such a carrier is built inside a
;;; with-region and returned out of it, the region evacuator must keep the
;;; whole tree alive, not only the top struct. Run under ESHKOL_ARENA_POISON=1
;;; so a coefficient left in the freed region reads as poison, not as a
;;; plausible stale value.

(define pass 0)
(define fail 0)
(define (check label got want)
  (if (< (abs (- got want)) 1e-9)
      (set! pass (+ pass 1))
      (begin (set! fail (+ fail 1))
             (display "FAIL: ") (display label) (display " got=") (display got)
             (display " want=") (display want) (newline))))

;; d/dx d^2/da^2 d/db (x a^3 b^3) at x=1, a=2, b=3  =  6a * 3b^2 = 324.
;; The with-region body returns the middle level's coefficient: a level of the
;; outer epoch whose own coefficients are carriers of the enclosing passes.
(let loop ((i 0))
  (if (< i 6)
      (begin
        (check "level carrier escapes a region"
               (derivative-n
                (lambda (x)
                  (derivative-n
                   (lambda (a)
                     (with-region 'level-carrier
                       (derivative (lambda (b) (* x a a a b b b)) 3.0)))
                   2.0 2))
                1.0 1)
               324.0)
        (check "exact level carrier escapes a region"
               (derivative-n
                (lambda (a)
                  (with-region 'exact-level
                    (derivative-n (lambda (b) (* a a a b b b)) 1/5 2)))
                1/3 2)
               2.4)
        (loop (+ i 1)))
      #f))

(display "vm-region-evac-level-carrier: ")
(display pass) (display " passed, ") (display fail) (display " failed") (newline)
(if (= fail 0)
    (begin (display "PASS: VM region-evac level carrier") (newline))
    (begin (display "FAIL: VM region-evac level carrier") (newline)))
