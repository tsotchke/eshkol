;;; Ownership wrappers evaluate their operand once on every supported route.
(define failures 0)
(define (check name ok)
  (if ok
      (begin (display "PASS: ") (display name) (newline))
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (newline))))

(define calls 0)
(define last-produced #f)
(define (produce-list n)
  (set! calls (+ calls 1))
  (set! last-produced (cons n '()))
  last-produced)
(define (produce-rational)
  (set! calls (+ calls 1))
  1/3)
(define (produce-big)
  (set! calls (+ calls 1))
  12345678901234567890123456789012345678901234567890)
(define (produce-f64)
  (set! calls (+ calls 1))
  1.25)
(define (produce-false)
  (set! calls (+ calls 1))
  #f)
(define (produce-nil)
  (set! calls (+ calls 1))
  '())
(define (produce-zero)
  (set! calls (+ calls 1))
  0)
(define (produce-min)
  (set! calls (+ calls 1))
  -9223372036854775808)
(define (produce-max)
  (set! calls (+ calls 1))
  9223372036854775807)

(set! calls 0)
(define owned-value (owned (produce-list 7)))
(check "owned operand called once" (= calls 1))
(check "owned retains heap identity" (eq? owned-value last-produced))
(check "owned retains heap contents" (= (car owned-value) 7))

(set! calls 0)
(define shared-value (shared (produce-list 8)))
(check "shared operand called once" (= calls 1))
(check "shared retains heap identity" (eq? shared-value last-produced))
(check "shared retains heap contents" (= (car shared-value) 8))

(set! calls 0)
(define move-value (move (produce-list 9)))
(check "move operand called once" (= calls 1))
(check "move retains heap identity" (eq? move-value last-produced))
(check "move retains heap contents" (= (car move-value) 9))

(set! calls 0)
(define rational-value (owned (produce-rational)))
(check "rational operand called once" (= calls 1))
(check "owned preserves exact rational" (and (exact? rational-value) (= rational-value 1/3)))
(check "rational wrapper preserves exact arithmetic" (and (exact? (* rational-value 3)) (= (* rational-value 3) 1)))

(set! calls 0)
(define big-value (shared (produce-big)))
(check "bignum operand called once" (= calls 1))
(check "shared preserves exact bignum" (and (exact? big-value)
  (= big-value 12345678901234567890123456789012345678901234567890)))

(set! calls 0)
(define float-value (move (produce-f64)))
(check "f64 operand called once" (= calls 1))
(check "move preserves inexact f64" (and (not (exact? float-value)) (= float-value 1.25)))
(check "f64 wrapper preserves inexact arithmetic" (and (not (exact? (+ float-value 0.75))) (= (+ float-value 0.75) 2.0)))

(set! calls 0)
(define false-value (owned (produce-false)))
(check "#f operand called once" (= calls 1))
(check "owned retains #f" (eq? false-value #f))

(set! calls 0)
(define nil-value (shared (produce-nil)))
(check "nil operand called once" (= calls 1))
(check "shared retains nil" (null? nil-value))

(set! calls 0)
(define zero-value (owned (produce-zero)))
(check "zero operand called once" (= calls 1))
(check "owned retains scalar zero" (= zero-value 0))

(set! calls 0)
(define min-value (shared (produce-min)))
(check "INT64_MIN operand called once" (= calls 1))
(check "shared retains INT64_MIN" (= min-value -9223372036854775808))

(set! calls 0)
(define max-value (move (produce-max)))
(check "INT64_MAX operand called once" (= calls 1))
(check "move retains INT64_MAX" (= max-value 9223372036854775807))

(set! calls 0)
(define nested-shared (shared (owned (produce-list 10))))
(check "shared-owned nested operand called once" (= calls 1))
(check "shared-owned nested identity retained" (eq? nested-shared last-produced))
(check "shared-owned nested contents retained" (= (car nested-shared) 10))

(set! calls 0)
(define nested-owned (owned (shared (produce-list 11))))
(check "owned-shared nested operand called once" (= calls 1))
(check "owned-shared nested identity retained" (eq? nested-owned last-produced))
(check "owned-shared nested contents retained" (= (car nested-owned) 11))

(set! calls 0)
(define global-source (owned (produce-list 12)))
(define global-destination (move global-source))
(check "global move does not reevaluate source" (= calls 1))
(check "global move transfers heap identity" (eq? global-destination last-produced))
(check "global move transfers heap contents" (= (car global-destination) 12))

(set! calls 0)
(define (local-move)
  (let ((source (owned (produce-list 13))))
    (move source)))
(define local-destination (local-move))
(check "local move does not reevaluate source" (= calls 1))
(check "local move transfers heap identity" (eq? local-destination last-produced))
(check "local move transfers heap contents" (= (car local-destination) 13))

(if (= failures 0)
    (begin (display "RESULT: PASS 39 ownership single-evaluation assertions") (newline))
    (begin (display "RESULT: FAIL ") (display failures) (newline) (exit 1)))
