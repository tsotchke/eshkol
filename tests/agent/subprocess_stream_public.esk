(require stdlib)
(require agent.subprocess)

(define passed 0)
(define (check name ok)
  (if ok
      (begin (set! passed (+ passed 1)) (display "PASS: ") (display name) (newline))
      (error "subprocess stream public check" name)))
(define child (get-environment-variable "ESHKOL_STREAM_TEST_CHILD"))
(define loop (make-event-loop 8))
(define saved-session 0)
(define (raises? thunk)
  (guard (e (#t #t)) (thunk) #f))
(define (argv mode) (list child (string-append "--child=" mode)))
(define (wait-readable session which buffer)
  (let again ((attempt 0))
    (let ((result (process-stream-read! session which buffer 0 (bytevector-length buffer))))
      (if (eq? (process-stream-read-status result) 'would-block)
          (if (> attempt 500) (error "child readiness deadline")
              (begin (process-stream-poll session 10) (again (+ attempt 1))))
          result))))
(define (retire-cleanup)
  (process-cleanup-drain! loop 1000)
  (for-each (lambda (ticket)
              (check "deferred child reaped" (eq? (process-cleanup-status ticket) 'reaped))
              (process-cleanup-consume! ticket))
            (process-cleanup-tickets)))

(define binary
  (call-with-subprocess-streams loop (argv "binary") '()
    (lambda (session)
      (set! saved-session session)
      (check "fractional identity rejected before FFI"
             (raises? (lambda () (process-stream-poll (+ session 0.5) 0))))
      (check "invalid read bounds rejected before FFI"
             (raises? (lambda ()
               (process-stream-read! session 'stdout (make-bytevector 4 0) 3 2))))
      (let ((out (make-bytevector 16 170)) (err (make-bytevector 16 170)))
        (let ((a (wait-readable session 'stdout out))
              (b (wait-readable session 'stderr err)))
          (check "binary byte counts" (and (= (process-stream-read-count a) 5)
                                           (= (process-stream-read-count b) 4)))
          (check "NUL and high bytes survive"
                 (and (= (bytevector-u8-ref out 0) 97) (= (bytevector-u8-ref out 1) 0)
                      (= (bytevector-u8-ref out 3) 255) (= (bytevector-u8-ref err 0) 0)))
          (check "caller buffer tail preserved" (= (bytevector-u8-ref out 5) 170))
          (let again ((attempt 0))
            (let ((status (process-stream-status session)))
              (if status status
                  (if (> attempt 500) (error "exit status deadline")
                      (begin (process-stream-poll session 10) (again (+ attempt 1))))))))))))
(check "exit code is exact" (and (= (process-stream-result-value binary) 7)
                                 (exact? (process-stream-result-value binary))))
(check "normal scope cleanup" (eq? (process-stream-result-cleanup-status binary) 'reaped))
(check "closed session cannot read"
       (eq? (process-stream-read-status
             (process-stream-read! saved-session 'stdout (make-bytevector 8 0) 0 8)) 'error))
(check "legacy spawn rejects event-loop mode"
       (raises? (lambda ()
         (process-spawn-argv-options (argv "idle") '((io-mode . event-loop))))))

(define timed
  (call-with-subprocess-streams loop (argv "ignore-term") '()
    (lambda (session)
      (wait-readable session 'stdout (make-bytevector 1 0))
      (let* ((start (current-time-ns)) (ready (process-stream-poll session 0))
             (elapsed (/ (- (current-time-ns) start) 1000000.0)))
        (check "zero timeout is nonblocking" (and (= ready 0) (< elapsed 100))))
      (let* ((start (current-time-ns)) (ready (process-stream-poll session 80))
             (elapsed (/ (- (current-time-ns) start) 1000000.0)))
        (check "positive timeout honors deadline" (and (= ready 0) (>= elapsed 40) (< elapsed 500))))
      (process-cancel! session 0)
      (let again ((attempt 0))
        (let ((status (process-stream-status session)))
          (if status status
              (if (> attempt 500) (error "cancellation deadline")
                  (begin (process-stream-poll session 10) (again (+ attempt 1))))))))))
(check "forced cancellation exit status" (= (process-stream-result-value timed) 137))

(define pending
  (call-with-subprocess-streams loop (argv "ignore-term")
    '((teardown-ms . 0) (term-grace-ms . 100))
    (lambda (session)
      (wait-readable session 'stdout (make-bytevector 1 0))
      'receiver-value)))
(check "bounded teardown returns pending and receiver value"
       (and (eq? (process-stream-result-cleanup-status pending) 'cleanup-pending)
            (eq? (process-stream-result-value pending) 'receiver-value)))
(check "original loop closes after detach" (event-loop-close loop))
(set! loop (make-event-loop 8))
(retire-cleanup)

(define caught #f)
(guard (e (#t (set! caught (eq? e 'stream-expected))))
  (call-with-subprocess-streams loop (argv "idle") '()
    (lambda (session) (raise 'stream-expected))))
(check "receiver exception preserved" caught)
(retire-cleanup)

(define resumed
  (with-exception-handler
    (lambda (condition)
      (unless (eq? condition 'stream-resume) (raise condition))
      (check "resumable exception keeps session active"
             (not (process-stream-status saved-session)))
      10)
    (lambda ()
      (call-with-subprocess-streams loop (argv "idle") '()
        (lambda (session)
          (set! saved-session session)
          (+ 1 (raise-continuable 'stream-resume)))))))
(check "resumable receiver result preserved" (= (process-stream-result-value resumed) 11))
(check "resumable scope cleanup" (eq? (process-stream-result-cleanup-status resumed) 'reaped))

(define escaped
  (call/cc (lambda (escape)
    (call-with-subprocess-streams loop (argv "idle") '()
      (lambda (session) (escape 'stream-escaped))))))
(check "continuation escape preserved" (eq? escaped 'stream-escaped))
(retire-cleanup)

(capability-install-policy! '())
(set! caught #f)
(guard (e (#t (set! caught #t)))
  (call-with-subprocess-streams loop (argv "idle") '() (lambda (session) #f)))
(capability-clear-policy!)
(check "capability denial raises" caught)
(set! caught #f)
(guard (e (#t (set! caught #t)))
  (call-with-subprocess-streams loop (argv "idle") '()
    (lambda (session)
      (capability-install-policy! '())
      (process-stream-poll session 0))))
(capability-clear-policy!)
(check "policy revocation preserves cleanup" caught)
(retire-cleanup)
(check "cleanup records consumed" (null? (process-cleanup-tickets)))
(event-loop-close loop)
(display "PUBLIC STREAM CHECKS: ") (display passed) (newline)
(display "PASS: subprocess_stream_public") (newline)
