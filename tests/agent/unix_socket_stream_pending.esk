;; Pending public acceptance. The helper observes clock/fd/errno and supplies
;; the labelled Darwin private-path EAGAIN control. Socket ownership and I/O
;; use agent.unix_stream_socket and the product FFI.
(require stdlib)
(require core.capabilities)
(require agent.unix_stream_socket)
(extern i32 -fixture-fds :real eshkol_unix_socket_test_fd_count)
(extern i64 -fixture-now :real eshkol_unix_socket_test_monotonic_ms)
(extern i32 -fixture-sleep i32 :real eshkol_unix_socket_test_sleep_ms)
(extern i32 -fixture-errno i32 :real eshkol_unix_socket_test_errno)
(extern i32 -loop-close-code i64 :real eshkol_event_loop_close_handle)
(define scenario (get-environment-variable "ESHKOL_UNIX_STREAM_SOCKET_SCENARIO"))
(define scratch (get-environment-variable "ESHKOL_UNIX_STREAM_SOCKET_SCRATCH"))
(define path (string-append scratch "/public.sock"))
(define peer-path (string-append scratch "/stream.sock"))
(define loop (make-event-loop 64))
(define owners '())
(define checks 0)
(define (check what ok)
  (set! checks (+ checks 1)) (unless ok (error "Unix stream acceptance" what)))
(define (remember id) (set! owners (cons id owners)) id)
(define (close! id)
  (check "close accepted" (= (unix-stream-socket-close! id) 0))
  (set! owners (filter (lambda (other) (not (= id other))) owners)))
(define (outcome? thunk operation code . os-code)
  (guard (e
          ((error-object? e)
           (let ((args (error-object-irritants e)))
             (and (equal? (error-object-message e) operation)
                  (pair? args) (pair? (cdr args)) (= (cadr args) code)
                  (or (null? os-code)
                      (and (pair? (cddr args))
                           (= (caddr args) (car os-code))))))))
    (thunk)
    #f))
(define (denied? thunk)
  (guard (e ((error-object? e)
             (and (equal? (error-object-message e) "capability denied")
                  (equal? (error-object-irritants e) '(network)))))
    (thunk) #f))
(define (open-pair)
  (let* ((listener (remember (unix-stream-socket-listen loop path)))
         (client (remember (unix-stream-socket-connect-begin loop path 1000)))
         (accepted (remember (unix-stream-socket-accept listener 1000))))
    (check "connect finished" (= (unix-stream-socket-connect-finish! client) 0))
    (vector listener client accepted)))
(define (close-pair p) (close! (vector-ref p 2)) (close! (vector-ref p 1)) (close! (vector-ref p 0)))
(define (poll! id interests timeout)
  (let* ((r (unix-stream-socket-poll id interests timeout)) (status (unix-stream-socket-poll-status r)))
    (check "readiness or timeout" (or (eq? status 'ready) (eq? status 'timeout)))
    (check "requested readiness only"
      (if (eq? status 'ready)
          (= (unix-stream-socket-poll-interests r) interests)
          (= (unix-stream-socket-poll-interests r) 0)))
    r))
(define (transfer size slow?)
  (let* ((p (open-pair)) (client (vector-ref p 1)) (accepted (vector-ref p 2))
         (sent (make-bytevector size 7)) (got (make-bytevector size 170))
         (deadline (+ (-fixture-now) 30000)))
    (bytevector-u8-set! sent 5 0) (bytevector-u8-set! sent (- size 1) 255)
    (let progress ((written 0) (received 0) (short 0) (blocked 0))
      (check "finite transfer deadline" (< (-fixture-now) deadline))
      (if (= received size)
          (begin
            (check "all sent bytes received" (and (= written size) (equal? sent got)))
            (when slow? (check "observed partial progress" (> (+ short blocked) 0)))
            (display "MEASURE: bytes=") (display received)
            (display " short-writes=") (display short) (display " would-block=") (display blocked) (newline))
          (let ((next-written written) (next-short short) (next-blocked blocked))
            (when (< written size)
              (let* ((want (min 65536 (- size written)))
                     (r (unix-stream-socket-write! client sent written want))
                     (status (unix-stream-socket-write-status r)) (n (unix-stream-socket-write-count r)))
                (cond ((eq? status 'data)
                       (check "positive bounded write" (and (> n 0) (<= n want)))
                       (set! next-written (+ written n))
                       (when (< n want) (set! next-short (+ short 1))))
                      ((eq? status 'would-block) (set! next-blocked (+ blocked 1)) (poll! client 2 0))
                      (else (error "write outcome" (unix-stream-socket-write-error r))))))
            (let* ((want (min 4096 (- size received)))
                   (r (unix-stream-socket-read! accepted got received want))
                   (status (unix-stream-socket-read-status r)) (n (unix-stream-socket-read-count r)))
              (cond ((eq? status 'data)
                     (check "positive bounded read" (and (> n 0) (<= n want)))
                     (when slow? (-fixture-sleep 1))
                     (progress next-written (+ received n) next-short next-blocked))
                    ((eq? status 'would-block) (poll! accepted 1 25)
                     (progress next-written received next-short next-blocked))
                    (else (error "read outcome" (unix-stream-socket-read-error r))))))))
    (close-pair p)))
(define (run-case)
  (cond
    ((equal? scenario "connect_accept") (transfer 257 #f))
    ((equal? scenario "partial_slow_peer") (transfer (* 2 1024 1024) #t))
    ((equal? scenario "nul_and_large_payload") (transfer (+ (* 16 1024 1024) 37) #t))
    ((equal? scenario "deadline_accept")
     (let ((listener (remember (unix-stream-socket-listen loop path))) (start (-fixture-now)))
       (check "specific accept timeout" (outcome? (lambda () (unix-stream-socket-accept listener 150)) "unix-stream-socket-accept" -2))
       (let ((elapsed (- (-fixture-now) start))) (check "measured accept deadline" (and (>= elapsed 140) (< elapsed 1500))))))
    ((equal? scenario "deadline_connect")
     (let* ((start (-fixture-now)) (id (remember (unix-stream-socket-connect-begin loop peer-path 250))))
       (check "begin publishes before wait" (< (- (-fixture-now) start) 150))
       (-fixture-sleep 350)
       (let ((finish (-fixture-now)))
         (check "specific original deadline" (outcome? (lambda () (unix-stream-socket-connect-finish! id)) "unix-stream-socket-connect-finish!" -2))
         (check "finish does not renew deadline" (< (- (-fixture-now) finish) 150)))))
    ((equal? scenario "destination_errors")
     (check "missing destination is not timeout"
       (outcome? (lambda () (unix-stream-socket-connect-begin loop path 1000)) "unix-stream-socket-connect-begin" -1 (-fixture-errno 1)))
     (check "refused destination is not timeout"
       (or (outcome? (lambda () (unix-stream-socket-connect-begin loop peer-path 1000)) "unix-stream-socket-connect-begin" -9)
           (outcome? (lambda () (unix-stream-socket-connect-begin loop peer-path 1000)) "unix-stream-socket-connect-begin" -1 (-fixture-errno 2)))))
    ((equal? scenario "cancellation")
     (let ((id (remember (unix-stream-socket-listen loop path))))
       (check "cancel accepted" (= (unix-stream-socket-cancel! id) 0))
       (check "cancel idempotent" (= (unix-stream-socket-cancel! id) 0))
       (check "next accept observes sticky cancellation" (outcome? (lambda () (unix-stream-socket-accept id 0)) "unix-stream-socket-accept" -6))))
    ((equal? scenario "connect_cancellation")
     (let ((id (remember (unix-stream-socket-connect-begin loop peer-path 2500))))
       (check "pending-connect cancellation accepted" (= (unix-stream-socket-cancel! id) 0))
       (check "pending-connect cancellation idempotent" (= (unix-stream-socket-cancel! id) 0))
       (check "published pending operation cancelled" (outcome? (lambda () (unix-stream-socket-connect-finish! id)) "unix-stream-socket-connect-finish!" -6))
       (let* ((r (unix-stream-socket-poll id 2 0)) (e (unix-stream-socket-poll-error r)))
         (check "later waits stay cancelled" (and (eq? (unix-stream-socket-poll-status r) 'error)
           (eq? (unix-stream-socket-error-operation e) 'unix-stream-socket-poll) (= (unix-stream-socket-error-code e) -6))))))
    ((equal? scenario "capability_denial")
     (capability-install-policy! '())
     (check "network denial identified" (denied? (lambda () (unix-stream-socket-listen loop path)))))
    ((equal? scenario "capability_revocation")
     (let ((p (open-pair)))
       (capability-install-policy! '())
       (check "I/O remains denied" (denied? (lambda () (unix-stream-socket-read! (vector-ref p 2) (make-bytevector 1 0) 0 1))))
       (check "cancel survives revocation" (= (unix-stream-socket-cancel! (vector-ref p 1)) 0))
       (close-pair p)))
    ((equal? scenario "loop_lifetime")
     (let ((p (open-pair)))
       (check "retained loop refuses close" (= (-loop-close-code loop) -7))
       (close! (vector-ref p 0))
       (check "accepted peers retain inherited loop" (= (-loop-close-code loop) -7))
       (close! (vector-ref p 1)) (close! (vector-ref p 2))))
    ((equal? scenario "zero_budget")
     (let ((id (remember (unix-stream-socket-listen loop path))) (start (-fixture-now)))
       (check "zero accept is a specific timeout" (outcome? (lambda () (unix-stream-socket-accept id 0)) "unix-stream-socket-accept" -2))
       (check "zero accept never waits" (< (- (-fixture-now) start) 150)))
     (let ((before (-fixture-fds)) (start (-fixture-now)))
       (check "zero pending begin rolls back" (outcome? (lambda () (unix-stream-socket-connect-begin loop peer-path 0)) "unix-stream-socket-connect-begin" -2))
       (check "zero begin never waits" (< (- (-fixture-now) start) 150))
       (check "zero rollback retains no descriptor" (= before (-fixture-fds)))))
    ((equal? scenario "descriptor_count_check")
     (close-pair (open-pair))
     (let ((before (-fixture-fds)))
       (check "descriptor observation available" (>= before 0))
       (do ((i 0 (+ i 1))) ((= i 1000)) (close-pair (open-pair)))
       (check "actual descriptor count unchanged" (= before (-fixture-fds)))))
    ((equal? scenario "path_lifecycle")
     (let ((id (remember (unix-stream-socket-listen loop path)))) (close! id))
     (check "listener path removed" (not (file-exists? path)))
     (let ((id (remember (unix-stream-socket-listen loop path)))) (close! id)))
    ((equal? scenario "peer_close_epipe")
     (let* ((p (open-pair)) (client (vector-ref p 1)) (deadline (+ (-fixture-now) 1500)) (bytes (make-bytevector 4096 0)))
       (close! (vector-ref p 2))
       (let observe ()
         (check "finite peer-close observation" (< (-fixture-now) deadline))
         (let* ((r (unix-stream-socket-write! client bytes 0 4096)) (status (unix-stream-socket-write-status r)))
           (cond ((eq? status 'error)
                  (let ((e (unix-stream-socket-write-error r)))
                    (check "operation-labelled peer-close outcome"
                      (and (eq? (unix-stream-socket-error-operation e) 'unix-stream-socket-write!)
                        (or (= (unix-stream-socket-error-code e) -7)
                            (and (= (unix-stream-socket-error-code e) -1)
                              (or (= (unix-stream-socket-error-os-code e) (-fixture-errno 5))
                                  (= (unix-stream-socket-error-os-code e) (-fixture-errno 6)))))))))
                 ((eq? status 'would-block) (poll! client 2 25) (observe))
                 (else (check "positive peer-close progress" (> (unix-stream-socket-write-count r) 0)) (observe)))))
       (close! client) (close! (vector-ref p 0))))
    (else (error "unknown Unix stream acceptance case" scenario))))
(dynamic-wind
  (lambda () #t)
  run-case
  (lambda ()
    (for-each (lambda (id) (unix-stream-socket-close! id)) owners)
    (set! owners '())
    (check "caller releases loop" (= (-loop-close-code loop) 0))))
(display "PASS: unix-socket ") (display scenario) (newline)
(display "CHECKS: ") (display checks) (newline)
