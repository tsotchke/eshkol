;; http_hostile_input_test.esk — the request grammar as a program sees it.
;;
;; The C++ grammar tests link the header directly. This one goes the other
;; way: it drives the HTTP and WebSocket entry points with hostile values and
;; asserts the refusal is an ordinary Eshkol error a program can catch, on
;; whichever engine is running the file.
;;
;; There is deliberately no (require agent.http) here. The grammar lives in
;; the native layer that every engine shares, and the bytecode VM does not
;; admit that module's externs, so driving the builtins directly is what lets
;; one file state the parity claim on the JIT, the AOT path and the VM.
;;
;; Nothing here opens a socket: every case is refused before a connection is
;; attempted, which is the property the refusals are supposed to have.

(require stdlib)

(define passed 0)
(define failed 0)
(define (check label expected actual)
  (if (equal? expected actual)
      (begin (display "PASS: ") (display label) (newline)
             (set! passed (+ passed 1)))
      (begin (display "FAIL: ") (display label)
             (display " (expected ") (display expected)
             (display ", got ") (display actual) (display ")") (newline)
             (set! failed (+ failed 1)))))

;; True when the thunk raises rather than returning. A refusal that is not
;; catchable is as bad as no refusal: the program cannot act on it.
(define (raises? thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e) (k #t))
        (lambda () (thunk) #f)))))

(define (request method url headers body)
  (http-request method url headers body 1))

;; ── The request line ────────────────────────────────────────────────
(check "a method carrying CRLF is refused" #t
       (raises? (lambda () (request "GET\r\nX: 1" "http://127.0.0.1:1/" "" ""))))
(check "a URL carrying a second request line is refused" #t
       (raises? (lambda ()
                  (request "GET" "http://127.0.0.1:1/a HTTP/1.1\r\nX: 1" "" ""))))
(check "a URL carrying a space is refused" #t
       (raises? (lambda () (request "GET" "http://127.0.0.1:1/a b" "" ""))))

;; ── Header lines ────────────────────────────────────────────────────
;; CRLF separates two header lines in a block, and each is validated on its
;; own, so the injection to refuse here is a bare CR inside one line.
(check "a header line carrying a bare CR is refused" #t
       (raises? (lambda ()
                  (request "GET" "http://127.0.0.1:1/"
                           "X: a\rInjected: 1" ""))))
(check "a header name carrying a space is refused" #t
       (raises? (lambda ()
                  (request "GET" "http://127.0.0.1:1/" "Bad Header: 1" ""))))

;; ── Fields the client sets itself (RFC 9112 section 6.3) ────────────
(check "a caller Transfer-Encoding is refused" #t
       (raises? (lambda ()
                  (request "POST" "http://127.0.0.1:1/x"
                           "Transfer-Encoding: chunked"
                           "0\r\n\r\nGET /admin HTTP/1.1\r\nHost: internal\r\nX: "))))
(check "a caller Content-Length is refused" #t
       (raises? (lambda ()
                  (request "POST" "http://127.0.0.1:1/x"
                           "Content-Length: 0" "body"))))
(check "a caller Host is refused" #t
       (raises? (lambda ()
                  (request "GET" "http://127.0.0.1:1/" "Host: internal" ""))))
(check "a caller Connection is refused" #t
       (raises? (lambda ()
                  (request "GET" "http://127.0.0.1:1/"
                           "Connection: keep-alive" ""))))
(check "the reserved match is case-insensitive" #t
       (raises? (lambda ()
                  (request "POST" "http://127.0.0.1:1/x"
                           "transfer-ENCODING: chunked" ""))))

;; ── The WebSocket handshake ─────────────────────────────────────────
(check "a WebSocket URL carrying CRLF is refused" #t
       (raises? (lambda ()
                  (websocket-connect "ws://127.0.0.1:1/a\r\nX: 1" ""))))
(check "a caller Sec-WebSocket-Key is refused" #t
       (raises? (lambda ()
                  (websocket-connect
                    "ws://127.0.0.1:1/"
                    "Sec-WebSocket-Key: AAAAAAAAAAAAAAAAAAAAAA=="))))
(check "a caller Sec-WebSocket-Version is refused" #t
       (raises? (lambda ()
                  (websocket-connect "ws://127.0.0.1:1/"
                                     "Sec-WebSocket-Version: 13"))))

(display "passed: ") (display passed) (newline)
(display "failed: ") (display failed) (newline)
(if (= failed 0)
    (begin (display "HTTP-HOSTILE-INPUT OK") (newline))
    (begin (display "HTTP-HOSTILE-INPUT FAILED") (newline)))
