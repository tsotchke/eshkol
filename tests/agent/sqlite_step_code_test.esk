;;; Public sqlite-step-code contract: preserve raw SQLite completion/error
;;; codes while sqlite-step remains the boolean row-loop compatibility API.

(require stdlib)
(require agent.sqlite)

(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok
      (begin (set! passed (+ passed 1)) (display "PASS: ") (display name) (newline))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))

(define db (sqlite-open ":memory:"))
(check "sqlite opens in-memory database" (> db 0))

(define ddl (sqlite-prepare db "CREATE TABLE items (id INTEGER PRIMARY KEY)"))
(check "DDL sqlite-step-code returns SQLITE_DONE"
       (= (sqlite-step-code ddl) SQLITE_DONE))
(sqlite-finalize ddl)

(define insert (sqlite-prepare db "INSERT INTO items (id) VALUES (1)"))
(check "INSERT sqlite-step-code returns SQLITE_DONE"
       (= (sqlite-step-code insert) SQLITE_DONE))
(sqlite-finalize insert)

(define selected (sqlite-prepare db "SELECT id FROM items"))
(check "SELECT sqlite-step-code first returns SQLITE_ROW"
       (= (sqlite-step-code selected) SQLITE_ROW))
(check "SELECT sqlite-step-code then returns SQLITE_DONE"
       (= (sqlite-step-code selected) SQLITE_DONE))
(sqlite-finalize selected)

(define boolean-selected (sqlite-prepare db "SELECT id FROM items"))
(check "sqlite-step boolean wrapper remains true for a row"
       (eq? (sqlite-step boolean-selected) #t))
(check "sqlite-step boolean wrapper remains false at completion"
       (eq? (sqlite-step boolean-selected) #f))
(sqlite-finalize boolean-selected)

(define duplicate (sqlite-prepare db "INSERT INTO items (id) VALUES (1)"))
(define error-code (sqlite-step-code duplicate))
(check "sqlite-step-code exposes execution error distinct from ROW and DONE"
       (and (not (= error-code SQLITE_ROW)) (not (= error-code SQLITE_DONE))))
(sqlite-finalize duplicate)
(sqlite-close db)

(display "Passed: ") (display passed) (newline)
(display "Failed: ") (display failed) (newline)
(if (> failed 0) (exit 1) (exit 0))
