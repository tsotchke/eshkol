;; Exercise the production native bridge only with a policy denying keychain.
;; No SecItem function may be reached under this policy.
(require core.capabilities)
(extern i64 kc-size ptr i64 :real eshkol_keychain_size)
(extern i64 kc-get ptr i64 ptr i64 :real eshkol_keychain_get_into)
(extern i32 kc-set ptr i64 ptr i64 :real eshkol_keychain_set)
(extern i32 kc-delete ptr i64 :real eshkol_keychain_delete)
(extern i32 kc-has ptr i64 :real eshkol_keychain_has)
(define (check ok text) (unless ok (error text)))
(define account "eshkol-denied-regression")
(define output "sentinel")
(capability-install-policy! '(file-read))
(check (= (kc-size account (string-byte-length account)) -1) "native size bypassed denial")
(check (= (kc-get account (string-byte-length account) output 8) -1) "native get bypassed denial")
(check (string=? output "sentinel") "denied native get modified output")
(check (= (kc-set account (string-byte-length account) "value" 5) 0) "native set bypassed denial")
(check (= (kc-delete account (string-byte-length account)) 0) "native delete bypassed denial")
(check (= (kc-has account (string-byte-length account)) 0) "native has bypassed denial")
(display "PASS: production keychain raw helpers deny before OS access\n")
