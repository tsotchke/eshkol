(require stdlib)
(require agent.subprocess)
(define loop (make-event-loop 8))
(define child (get-environment-variable "ESHKOL_STREAM_TEST_CHILD"))
(define expected (+ (* 17 1024 1024) 37))
(define result
  (call-with-subprocess-streams loop (list child "--child=large") '()
    (lambda (session)
      (let ((buffer (make-bytevector 65536 0)))
        (let again ((out 0) (err 0) (out-eof #f) (err-eof #f))
          (let* ((a (process-stream-read! session 'stdout buffer 0 65536))
                 (na (process-stream-read-count a))
                 (b (process-stream-read! session 'stderr buffer 0 65536))
                 (nb (process-stream-read-count b)))
            (when (or (eq? (process-stream-read-status a) 'error)
                      (eq? (process-stream-read-status b) 'error))
              (error "large stream read error"))
            (let ((next-out (+ out na)) (next-err (+ err nb))
                  (done-out (eq? (process-stream-read-status a) 'eof))
                  (done-err (eq? (process-stream-read-status b) 'eof))
                  (status (process-stream-status session)))
              (if (and done-out done-err status)
                  (if (and (= next-out expected) (= next-err expected) (= status 19))
                      (vector next-out next-err status)
                      (error "large stream counts/status" next-out next-err status))
                  (begin
                    (process-stream-poll session 10)
                    (again next-out next-err done-out done-err))))))))))
(unless (eq? (process-stream-result-cleanup-status result) 'reaped)
  (error "large stream cleanup"))
(display "LARGE STREAM BYTES: ")
(display (process-stream-result-value result)) (newline)
(event-loop-close loop)
(display "PASS: subprocess_stream_large") (newline)
