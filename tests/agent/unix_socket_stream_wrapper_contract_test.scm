;; R7RS wrapper unit checks. Native externs are controlled test doubles;
;; these checks do not qualify Eshkol JIT/AOT or a socket implementation.
(import (scheme base) (scheme cxr) (scheme char) (scheme file) (scheme load)
        (scheme process-context) (scheme read) (scheme repl) (scheme eval) (scheme write))
(define root (cadr (command-line)))
(define calls '())
(define reply 0)
(define path-error 0)
(define scope-mode #f)
(define scope-retries 0)
(define scope-releases 0)
(define scope-detaches 0)
(define (fake-native name args)
  (set! calls (cons name calls))
  (cond ((eq? name '-unix-stream-socket-os-error-raw) 77)
        ((eq? name '-unix-stream-socket-path-error-raw) path-error)
        ((and scope-mode (eq? name '-unix-stream-socket-listen-raw)) 41)
        ((and scope-mode (eq? name '-unix-stream-socket-close-request-raw)) 42)
        ((and scope-mode (eq? name '-unix-stream-socket-cleanup-result-raw))
         (cond ((eq? scope-mode 'pending) 0)
               ((= scope-retries 0) (+ (* 13 64) 32 (* 3 4) 2))
               (else (+ (* 13 64) (* 3 4) 2))))
        ((and scope-mode (eq? name '-unix-stream-socket-cleanup-retry-raw))
         (set! scope-retries (+ scope-retries 1)) 0)
        ((and scope-mode (eq? name '-unix-stream-socket-cleanup-release-raw))
         (set! scope-releases (+ scope-releases 1)) 0)
        ((and scope-mode (eq? name '-unix-stream-socket-cleanup-detach-raw))
         (set! scope-detaches (+ scope-detaches 1)) 0)
        ((memq name '(capability-runtime-clear-raw capability-runtime-begin-install-raw capability-runtime-allow-raw)) 0)
        (else reply)))
(define-syntax require (syntax-rules () ((_ x ...) #t)))
(define-syntax provide (syntax-rules () ((_ x ...) #t)))
(define-syntax extern
  (syntax-rules () ((_ type name rest ...)
                    (define (name . args) (fake-native 'name args)))))
(define (inexact->exact x) (exact x))
(load (string-append root "/lib/core/capabilities.esk"))
(load (string-append root "/lib/agent/unix_stream_socket.esk"))
;; Evaluate the actual public fixture's error predicates, not copies of them.
(call-with-input-file (string-append root "/tests/agent/unix_socket_stream_pending.esk")
  (lambda (port)
    (let scan ()
      (let ((form (read port)))
        (unless (eof-object? form)
          (when (and (pair? form) (eq? (car form) 'define) (pair? (cadr form))
                     (memq (caadr form) '(outcome? denied?)))
            (eval form (interaction-environment)))
          (scan))))))
(define count 0)
(define (assert name value)
  (set! count (+ count 1))
  (unless value (error "wrapper contract assertion" name)))
(capability-install-policy! '(network))
(set! calls '())
(assert "loop zero rejected" (guard (e ((error-object? e) (equal? (error-object-message e) "unix-stream-socket-listen")))
                               (unix-stream-socket-listen 0 "/tmp/socket") #f))
(assert "loop validation precedes native" (null? calls))
(assert "relative path rejected" (guard (e ((error-object? e) #t)) (unix-stream-socket-listen 1 "relative") #f))
(assert "NUL path rejected" (guard (e ((error-object? e) #t)) (unix-stream-socket-listen 1 (string #\/ #\a (integer->char 0) #\b)) #f))
(assert "bad deadline rejected" (guard (e ((error-object? e) #t)) (unix-stream-socket-connect-begin 1 "/tmp/socket" 2147483648) #f))
(assert "invalid interest rejected" (guard (e ((error-object? e) #t)) (unix-stream-socket-poll 1 4 0) #f))
(assert "argument controls do not call native" (null? calls))
(set! reply -100)
(assert "planned is not timeout" (not (outcome? (lambda () (unix-stream-socket-listen 1 "/tmp/socket")) "unix-stream-socket-listen" -2)))
(assert "unrelated error is not timeout" (not (outcome? (lambda () (error "unrelated" -2)) "unix-stream-socket-accept" -2)))
(set! reply -2)
(assert "specific accept timeout recognized" (outcome? (lambda () (unix-stream-socket-accept 1 10)) "unix-stream-socket-accept" -2 77))
(set! reply -6)
(assert "specific finish cancellation recognized" (outcome? (lambda () (unix-stream-socket-connect-finish! 1)) "unix-stream-socket-connect-finish!" -6 77))
(let* ((r (unix-stream-socket-read! 1 (make-bytevector 4 0) 0 4)) (e (unix-stream-socket-read-error r)))
  (assert "read carries shared code" (and (eq? (unix-stream-socket-read-status r) 'error) (= (unix-stream-socket-error-code e) -6)))
  (assert "read carries operation/OS code" (and (eq? (unix-stream-socket-error-operation e) 'unix-stream-socket-read!) (= (unix-stream-socket-error-os-code e) 77))))
(set! reply -2)
(assert "would-block remains distinct from EOF" (eq? (unix-stream-socket-read-status (unix-stream-socket-read! 1 (make-bytevector 1 0) 0 1)) 'would-block))
(set! reply 0)
(assert "read zero means EOF" (eq? (unix-stream-socket-read-status (unix-stream-socket-read! 1 (make-bytevector 1 0) 0 1)) 'eof))
(set! reply 2)
(let ((r (unix-stream-socket-poll 1 3 0)))
  (assert "poll reports exact readiness" (and (eq? (unix-stream-socket-poll-status r) 'ready) (= (unix-stream-socket-poll-interests r) 2))))
(set! reply -2)
(let ((r (unix-stream-socket-poll 1 1 0)))
  (assert "poll timeout has no readiness" (and (eq? (unix-stream-socket-poll-status r) 'timeout) (= (unix-stream-socket-poll-interests r) 0))))
(set! reply -6)
(let ((r (unix-stream-socket-poll 1 1 0)))
  (assert "poll cancellation is explicit"
    (and (eq? (unix-stream-socket-poll-status r) 'cancelled)
         (= (unix-stream-socket-error-code (unix-stream-socket-poll-error r)) -6))))
(set! reply -1)
(set! path-error 13)
(assert "rollback failure names residual pathname"
  (guard (e ((error-object? e)
    (and (equal? (error-object-message e) "unix-stream-socket-listen")
         (member "/tmp/socket" (error-object-irritants e))
         (member 13 (error-object-irritants e)))))
    (unix-stream-socket-listen 1 "/tmp/socket") #f))
(set! path-error 0)
(set! reply 0)
(capability-install-policy! '())
(set! calls '())
(assert "revoked read denied specifically" (denied? (lambda () (unix-stream-socket-read! 1 (make-bytevector 1 0) 0 1))))
(assert "denied I/O never reaches native" (null? calls))
(assert "cleanup cancellation survives revocation" (= (unix-stream-socket-cancel! 1) 0))
(assert "cleanup close survives revocation" (= (unix-stream-socket-close! 1) 0))
(assert "cleanup uses only ownership operations" (equal? calls '(-unix-stream-socket-close-raw -unix-stream-socket-cancel-raw)))
(assert "invalid cleanup handle still rejected" (guard (e ((error-object? e) #t)) (unix-stream-socket-close! 0) #f))
;; Scope-owned terminal tickets are released even when cleanup fails. Normal
;; returns report a plain snapshot; exceptional exits preserve their object.
(capability-install-policy! '(network))
(set! scope-mode 'terminal)
(set! scope-retries 0) (set! scope-releases 0) (set! scope-detaches 0)
(assert "normal scope reports terminal path cleanup"
  (guard (e ((error-object? e)
      (let ((args (error-object-irritants e)))
        (and (equal? (error-object-message e) "call-with-unix-stream-listener")
             (equal? (car args) "socket cleanup failed")
             (equal? (cadr args) "/tmp/scoped")
             (= (caddr args) 41)
             (equal? (cadddr args) (vector 'failed 'path 13 #f))))))
    (call-with-unix-stream-listener 1 "/tmp/scoped" (lambda (id) 'returned)) #f))
(assert "normal scope bounded retry releases ticket"
  (and (= scope-retries 1) (= scope-releases 1) (= scope-detaches 0)))
(set! scope-retries 0) (set! scope-releases 0)
(define original-exception (guard (e (else e)) (error "original scope exception")))
(assert "failed cleanup preserves original exception object"
  (guard (e (else (eq? e original-exception)))
    (call-with-unix-stream-listener 1 "/tmp/scoped"
      (lambda (id) (raise original-exception))) #f))
(assert "exception scope bounded retry releases ticket"
  (and (= scope-retries 1) (= scope-releases 1)))
(set! scope-retries 0) (set! scope-releases 0)
(assert "failed cleanup preserves continuation destination"
  (eq? (call/cc (lambda (escape)
    (call-with-unix-stream-listener 1 "/tmp/scoped"
      (lambda (id) (escape 'escaped))))) 'escaped))
(assert "escape scope releases terminal ticket" (= scope-releases 1))
(set! scope-mode 'pending)
(set! scope-releases 0) (set! scope-detaches 0)
(assert "unresolved scope reports pending responsibility"
  (guard (e ((error-object? e) #t))
    (call-with-unix-stream-listener 1 "/tmp/scoped" (lambda (id) 0)) #f))
(assert "unresolved ownership stays detached rather than released"
  (and (= scope-detaches 1) (= scope-releases 0)))
(set! scope-mode #f)
(display "PASS: Unix stream Scheme wrapper unit contract (") (display count) (display " checks)") (newline)
