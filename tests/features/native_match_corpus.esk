;; Match corpus shared with the bytecode compiler. Native literals use
;; eqv? for numbers and equal? for strings, including fresh allocations.
(define expected
  (list 1 2 3 4 5 6 7 6 101 10 11 7 3 13 1
        "match: no clause matched — non-exhaustive pattern match"
        5 1 2 0 4 2000 #t 0 1))
(define (show value)
  (if (and (pair? expected) (equal? value (car expected)))
      (set! expected (cdr expected))
      (error "unexpected match result" value expected)))
(define (classify x)
  (match x
    ('red 1)
    (#t 2)
    (#\a 3)
    (4.5 4)
    ("text" 5)
    (() 6)
    ((or 8 9) 7)
    ((list (cons h t) (? number? n)) (+ h t n))
    ((? (lambda (v) (and (number? v) (> v 100))) big) big)
    ((? vector?) 10)
    (else 11)))
(show (classify 'red))
(show (classify #t))
(show (classify #\a))
(show (classify 4.5))
(show (classify "text"))
(show (classify '()))
(show (classify 9))
(show (classify (list (cons 1 2) 3)))
(show (classify 101))
(show (classify (vector 1 2)))
(show (classify (list 1 2 3)))
(show (match (cons 3 7) ((cons _ n) n)))
(show (match `(tag ,(+ 1 2)) ((list 'tag n) n)))
(define count 0)
(show (match (begin (set! count (+ count 1)) 12) (0 0) (x (+ x count))))
(show count)
(show (guard (e ((error-object? e) (error-object-message e)))
        (match 3 (1 2))))
(show (classify (string-copy "text")))
(show (classify (string->symbol "red")))
(show (match 1/2 (1/2 2) (_ 0)))
(show (match 120000000000000000000 (120000000000000000000 0) (_ 3)))
(show (match 4 (else else)))
(define (count-down n acc)
  (match n (0 acc) (k (count-down (- k 1) (+ acc 1)))))
(show (count-down 2000 0))
(let ((seen 0))
  (show (null? (match (begin (set! seen 1) seen))))
  (show seen))
(show (match 1+2i (1+2i 1) (_ 2)))

(if (null? expected) (display "RESULT: PASS") (error "missing corpus results" expected))
(newline)
