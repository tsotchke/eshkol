(define checks 0)
(define failures 0)
(define (check name ok)
  (set! checks (+ checks 1))
  (if ok #t (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))

(define empty (bytevector))
(define edges (bytevector 0 1 127 254 255))
(check "empty" (and (bytevector? empty) (= (bytevector-length empty) 0)))
(check "edges and NUL" (and (= (bytevector-length edges) 5)
  (= (bytevector-u8-ref edges 0) 0) (= (bytevector-u8-ref edges 4) 255)))

(define (builtin_bytevector_rest_v1 x) x)
(check "generated helper name collision" (= (builtin_bytevector_rest_v1 19) 19))
(define ctor bytevector)
(define (same? a b)
  (and (bytevector? a) (= (bytevector-length a) (bytevector-length b))
       (let loop ((i 0))
         (if (= i (bytevector-length b)) #t
             (and (= (bytevector-u8-ref a i) (bytevector-u8-ref b i))
                  (loop (+ i 1)))))))
(check "first class zero" (same? (ctor) empty))
(check "first class many" (same? (ctor 3 0 255 19) (bytevector 3 0 255 19)))
(check "apply zero" (same? (apply ctor '()) empty))
(check "apply many" (same? (apply ctor '(3 0 255 19)) (bytevector 3 0 255 19)))
(define mapped (map ctor '(0 255)))
(check "map use" (and (= (length mapped) 2)
  (= (bytevector-u8-ref (car mapped) 0) 0)
  (= (bytevector-u8-ref (car (cdr mapped)) 0) 255)))
(define mutable (bytevector 7 8))
(bytevector-u8-set! mutable 1 255)
(check "mutation" (= (bytevector-u8-ref mutable 1) 255))
(check "upper boundary" (= (bytevector-u8-ref (bytevector 255) 0) 255))

(check "reject noninteger" (guard (e (#t #t)) (bytevector 'bad) #f))
(check "reject fraction" (guard (e (#t #t)) (bytevector 2.5) #f))
(check "reject negative" (guard (e (#t #t)) (bytevector -1) #f))
(check "reject high" (guard (e (#t #t)) (bytevector 256) #f))
(check "reject huge bignum" (guard (e (#t #t)) (bytevector (expt 2 100)) #f))
(define effects 0)
(guard (e (#t #t))
  (bytevector -1 (begin (set! effects (+ effects 1)) 8)) #f)
(check "evaluate all args before validation" (= effects 1))

(display "Passed: ") (display checks) (newline)
(display "Failed: ") (display failures) (newline)
(display (if (= failures 0) "RESULT: PASS" "RESULT: FAIL")) (newline)
