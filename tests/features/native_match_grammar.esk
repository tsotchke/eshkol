(define (check label expected actual)
  (if (equal? expected actual) #t (error label expected actual)))

(define (shape v)
  (match v
    (#() 'empty)
    ((vector (list h t) #(x)) (list h t x))
    (#(a b) (list a b))
    (_ 'other)))
(check 'empty 'empty (shape (vector)))
(check 'nested '(1 2 3) (shape (vector '(1 2) (vector 3))))
(check 'two '(a b) (shape '#(a b)))
(check 'short 'other (shape (vector 1)))
(check 'long 'other (shape (vector 1 2 3)))
(check 'list 'other (shape '(1 2)))
(check 'string 'other (shape "ab"))
(check 'atom 'other (shape 42))
(check 'reader-vector #t
       (match #(2.0 3.0) (#(2.0 x) (= x 3.0)) (_ #f)))

(define (decode value)
  (match value
    (`(event #(start ,x) . ,tail) (list x tail))
    ((quasiquote (end (unquote (cons a b)))) (cons b a))
    (_ 'other)))
(check 'dotted '(4 (more)) (decode (list 'event (vector 'start 4) 'more)))
(check 'symbol 'other (decode (list 'event (vector 'stop 4) 'more)))
(check 'subpattern '(2 . 1) (decode (list 'end (cons 1 2))))
(check 'depth 7
       (match '(tag (quasiquote (unquote a)) 7)
         (`(tag `,a ,v) v) (_ #f)))

(define visits 0)
(define (visit value) (set! visits (+ visits 1)) value)
(let ((x 'outer))
  (check 'ordered '(outer 5)
         (match (visit (vector 5 'tag))
           (#(x 'skip) #:when (visit #t) 'unused)
           (#(x 'tag) (when (visit #f)) 'unused)
           ((or (vector 'tag x) #(x 'tag)) #:when (visit 0)
            (list 'outer x))
           (_ 'other)))
  (check 'scope 'outer x))
(check 'visits 3 visits)
(check 'projected-alternative 8
       (match (vector 0 8)
         ((or #(9 a) #(0 a)) #:when (= a 8) a) (_ #f)))
(check 'let-match '(3 2)
       (let-match (((vector a b) (vector 2 3))) (list b a)))
(check 'mutable 7
       (match (vector 6)
         (#(n) #:when (begin (set! n (+ n 1)) #t) n)))
(define (accept-above threshold)
  (lambda (value)
    (match value
      (#((? (lambda (n) (> n threshold)) n)) (lambda () n))
      (_ (lambda () 0)))))
(define above-three (accept-above 3))
(check 'captured-predicate 4 ((above-three (vector 4))))
(check 'captured-predicate-false 0 ((above-three (vector 2))))
(check 'ordinary-when 3
       (match 'a (_ (when #f (visit 0)) visits)))
(check 'guard-condition 'raised
       (guard (e (else 'raised))
         (match 0 (_ #:when (raise 'stop) 1) (_ 2))))
(check 'exhaustion 'raised
       (guard (e ((error-object? e) 'raised))
         (match 'a (_ #:when #f 0))))
(check 'exactness #f (match 1.0 (1 #t) (_ #f)))
(check 'char-and-number #f (match 65 (#\A #t) (_ #f)))
(check 'string-and-symbol #f (match 'label ("label" #t) (_ #f)))
(check 'quoted-string #t (match (string-copy "text") ('"text" #t) (_ #f)))
(check 'unequal-strings #f (match "texts" ("text" #t) (_ #f)))
(display "RESULT: PASS") (newline)
