(require core.quantum.circuit)
(define checks 0)
(define failures 0)
(define (check label condition)
  (set! checks (+ checks 1))
  (if (not condition)
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display label) (newline))))
(define (refuses? thunk) (guard (err (else #t)) (thunk) #f))
(define bell-ops '((h 0) (cx 0 1) (measure 0 0) (measure 1 1)))
(define bell (make-quantum-circuit 2 2 bell-ops))
(check "Bell QASM and explicit initial state"
  (string=? (quantum-circuit->openqasm3 bell)
    "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nqubit[2] q;\nbit[2] c;\nreset q;\nh q[0];\ncx q[0], q[1];\nc[0] = measure q[0];\nc[1] = measure q[1];\n"))
(check "logical resource accounting"
  (equal? (quantum-circuit-resources bell)
    '((qubits . 2) (classical-bits . 2) (operations . 4) (gates . 2)
      (two-qubit-gates . 1) (measurements . 2) (resets . 0) (barriers . 0)
      (initialization-resets . 2))))
(check "zero classical bits omit classical declaration"
  (string=? (quantum-circuit->openqasm3 (make-quantum-circuit 1 0 '()))
    "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nqubit[1] q;\nreset q;\n"))
(check "reset and barrier counted separately"
  (equal? (quantum-circuit-resources (make-quantum-circuit 2 0 '((reset 1) (barrier 0 1))))
    '((qubits . 2) (classical-bits . 0) (operations . 2) (gates . 0)
      (two-qubit-gates . 0) (measurements . 0) (resets . 1) (barriers . 1)
      (initialization-resets . 2))))
(check "nonpositive qubit count" (refuses? (lambda () (make-quantum-circuit 0 0 '()))))
(check "negative bit count" (refuses? (lambda () (make-quantum-circuit 2 -1 '()))))
(check "inexact register size" (refuses? (lambda () (make-quantum-circuit 2.0 0 '()))))
(check "improper operations" (refuses? (lambda () (make-quantum-circuit 2 0 '(h . 0)))))
(check "empty operation" (refuses? (lambda () (make-quantum-circuit 2 0 '(())))))
(check "unknown gate" (refuses? (lambda () (make-quantum-circuit 2 0 '((oracle 0))))))
(check "string gate injection" (refuses? (lambda () (make-quantum-circuit 2 0 '(("h; reset q" 0))))))
(check "missing wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((cx 0))))))
(check "extra wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((h 0 1))))))
(check "negative wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((x -1))))))
(check "out-of-range wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((x 2))))))
(check "inexact wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((x 1.0))))))
(check "aliased control and target" (refuses? (lambda () (make-quantum-circuit 2 0 '((cx 1 1))))))
(check "aliased Toffoli wires" (refuses? (lambda () (make-quantum-circuit 3 0 '((ccx 0 1 0))))))
(check "measurement without classical register" (refuses? (lambda () (make-quantum-circuit 2 0 '((measure 0 0))))))
(check "measurement destination bounds" (refuses? (lambda () (make-quantum-circuit 2 1 '((measure 0 1))))))
(check "measurement wrong arity" (refuses? (lambda () (make-quantum-circuit 2 1 '((measure 0))))))
(check "empty barrier" (refuses? (lambda () (make-quantum-circuit 2 0 '((barrier))))))
(check "repeated barrier wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((barrier 0 0))))))
(check "NaN angle" (refuses? (lambda () (make-quantum-circuit 2 0 (list (list 'rx +nan.0 0))))))
(check "infinite angle" (refuses? (lambda () (make-quantum-circuit 2 0 (list (list 'ry +inf.0 0))))))
(check "complex angle" (refuses? (lambda () (make-quantum-circuit 2 0 (list (list 'rz 1+2i 0))))))
(check "string angle" (refuses? (lambda () (make-quantum-circuit 2 0 '((rx "0); x q[1]" 0))))))
(define changed (make-quantum-circuit 2 0 '((h 0))))
(vector-set! changed 1 0)
(check "export revalidates mutated metadata" (refuses? (lambda () (quantum-circuit->openqasm3 changed))))
(check "resources revalidate mutated metadata" (refuses? (lambda () (quantum-circuit-resources changed))))
(define owned-ops (list (list 'x 0)))
(define copied (make-quantum-circuit 2 0 owned-ops))
(set-car! (cdr (car owned-ops)) 99)
(check "constructor snapshots input list structure"
  (string=? (quantum-circuit->openqasm3 copied)
    "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nqubit[2] q;\nreset q;\nx q[0];\n"))
(check "boolean register size" (refuses? (lambda () (make-quantum-circuit #t 0 '()))))
(check "boolean wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((x #f))))))
(check "fractional wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((h 1/2))))))
(check "improper operation" (refuses? (lambda () (make-quantum-circuit 2 0 '((x . 0))))))
(check "missing reset wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((reset))))))
(check "extra reset wire" (refuses? (lambda () (make-quantum-circuit 2 0 '((reset 0 1))))))
(check "nonvector circuit" (refuses? (lambda () (quantum-circuit->openqasm3 '()))))
(check "wrong vector size" (refuses? (lambda () (quantum-circuit-resources (vector 1 2)))))
(check "wrong circuit tag"
  (refuses? (lambda () (quantum-circuit->openqasm3 (vector 'other-circuit 2 0 '())))))
(define changed-ops (make-quantum-circuit 2 0 '((x 0))))
(set-car! (car (vector-ref changed-ops 3)) 'unsupported)
(check "export revalidates mutated operations"
  (refuses? (lambda () (quantum-circuit->openqasm3 changed-ops))))
(check "resources revalidate mutated operations"
  (refuses? (lambda () (quantum-circuit-resources changed-ops))))
(check "three-qubit gates are not counted as two-qubit gates"
  (equal? (quantum-circuit-resources
    (make-quantum-circuit 3 0 '((cx 2 0) (ccx 0 1 2) (cswap 2 0 1))))
    '((qubits . 3) (classical-bits . 0) (operations . 3) (gates . 3)
      (two-qubit-gates . 1) (measurements . 0) (resets . 0) (barriers . 0)
      (initialization-resets . 3))))
(define outer-cycle (list '(x 0)))
(set-cdr! outer-cycle outer-cycle)
(check "constructor rejects outer self-cycle"
  (refuses? (lambda () (make-quantum-circuit 2 0 outer-cycle))))
(define outer-tail-cycle (list '(x 0) '(h 1) '(cx 0 1) '(z 0)))
(set-cdr! (cdr (cdr (cdr outer-tail-cycle))) (cdr outer-tail-cycle))
(check "constructor rejects outer non-head cycle"
  (refuses? (lambda () (make-quantum-circuit 2 0 outer-tail-cycle))))
(define inner-cycle (list 'x 0))
(set-cdr! inner-cycle inner-cycle)
(check "constructor rejects operation self-cycle"
  (refuses? (lambda () (make-quantum-circuit 2 0 (list inner-cycle)))))
(define inner-tail-cycle (list 'rx 0.2 0 1))
(set-cdr! (cdr (cdr (cdr inner-tail-cycle))) (cdr inner-tail-cycle))
(check "constructor rejects operation non-head cycle"
  (refuses? (lambda () (make-quantum-circuit 2 0 (list inner-tail-cycle)))))
(define changed-outer (make-quantum-circuit 2 0 '((x 0) (h 1) (cx 0 1))))
(define changed-outer-ops (vector-ref changed-outer 3))
(set-cdr! (cdr (cdr changed-outer-ops)) (cdr changed-outer-ops))
(check "export rejects later outer cycle"
  (refuses? (lambda () (quantum-circuit->openqasm3 changed-outer))))
(check "resources reject later outer cycle"
  (refuses? (lambda () (quantum-circuit-resources changed-outer))))
(define changed-inner (make-quantum-circuit 2 0 '((x 0))))
(define changed-inner-op (car (vector-ref changed-inner 3)))
(set-cdr! (cdr changed-inner-op) (cdr changed-inner-op))
(check "export rejects later operation cycle"
  (refuses? (lambda () (quantum-circuit->openqasm3 changed-inner))))
(check "resources reject later operation cycle"
  (refuses? (lambda () (quantum-circuit-resources changed-inner))))
(display "circuit_export_test: ") (display checks) (display " checks, ")
(display failures) (display " failed") (newline)
(if (= failures 0) (exit 0) (exit 1))
