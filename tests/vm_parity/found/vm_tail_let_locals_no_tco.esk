; FILED (LE-13): a tail call in a `let` body that allocated locals is not
; tail-call-optimized on the VM. vm_compiler.c drops `tail` to 0 for any
; let-family scope needing OP_POPN cleanup, so the call becomes OP_CALL:
; FRAME OVERFLOW at ~256 frames, stderr diagnostic, EXIT 0, no output (LE-07).
; The same program with the `let` removed runs flat.
; vm-src : FRAME OVERFLOW, exit 0
; native : ok, 20000100000
(define (lping n acc) (if (= n 0) acc (let ((m (- n 1))) (lpong m (+ acc n)))))
(define (lpong n acc) (if (= n 0) acc (let ((m (- n 1))) (lping m (+ acc n)))))
(display (lping 200000 0))
(newline)
