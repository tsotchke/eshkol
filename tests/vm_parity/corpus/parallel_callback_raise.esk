;; SW-196: a raise inside a parallel callback belongs to the caller's
;; interpreter. Worker-admitted (pure) callbacks that fail are re-evaluated on
;; the caller after the join, so the callback's own condition reaches the
;; caller's handler; guarded callbacks resume the callback; nothing after the
;; parallel form is lost.
(define inputs '(1 2 3 4 5 6 7 8))
(define (classify e)
  (cond ((error-object? e) 'error-object)
        ((symbol? e) e)
        (else 'other)))

;; Pure callback that faults for one element: car of a non-pair. The
;; caller's handler receives the callback's own condition, not a scheduler one.
(display (guard (e ((error-object? e) (error-object-message e)))
  (parallel-map (lambda (x) (car (if (= x 5) x (list x)))) inputs)))
(newline)
(display (guard (e ((error-object? e) (error-object-message e)))
  (parallel-execute (lambda () 1) (lambda () (car 2)) (lambda () 3))))
(newline)

;; The same callback with no failing element still runs to completion.
(display (parallel-map (lambda (x) (* x x)) inputs))
(newline)

;; The caller's handler sees the callback's own raised object.
(display (guard (e ((symbol? e) (list 'caught e)))
  (parallel-map (lambda (x) (if (= x 6) (raise 'six) x)) inputs)))
(newline)
(display (guard (e ((error-object? e) (error-object-irritants e)))
  (parallel-map (lambda (x) (if (= x 3) (error "bad element" x (* x 10)) x))
                inputs)))
(newline)

;; A locally guarded callback resumes the callback, element by element.
(display (parallel-map (lambda (x) (guard (e (#t (- x))) (if (odd? x) (raise x) x)))
                       '(1 2 3)))
(newline)
(display "after local guard")
(newline)

;; parallel-filter and parallel-for-each follow the same boundary.
(display (guard (e (#t (classify e)))
  (parallel-filter (lambda (x) (< (car (if (= x 2) x (list x))) 4)) inputs)))
(newline)
(display (guard (e (#t (classify e)))
  (parallel-for-each (lambda (x) (car (if (= x 7) x (list x)))) inputs)))
(newline)

;; parallel-execute thunks.
(display (guard (e (#t (classify e)))
  (parallel-execute (lambda () 1) (lambda () (car 2)) (lambda () 3))))
(newline)
(display (parallel-execute (lambda () 1) (lambda () 2) (lambda () 3)))
(newline)
(display (parallel-filter (lambda (x) (< (car (list x)) 4)) inputs))
(newline)

;; An escape to an outer continuation resumes its owning scope.
(display (call-with-current-continuation
  (lambda (k)
    (parallel-map (lambda (x) (if (= x 4) (k 'escaped) x)) inputs))))
(newline)
(display "parallel callback raise PASS")
(newline)
