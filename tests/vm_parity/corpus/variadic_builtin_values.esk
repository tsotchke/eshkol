;; SW-241: a variadic builtin passed as a value is the variadic procedure, not
;; its 2-argument lowering, on every engine.
(define curry (lambda (f . a) (lambda m (apply f (append a m)))))
(display ((curry + 1) 2 3)) (newline)
(display ((curry * 2) 3 4 5)) (newline)
(define (call f . args) (apply f args))
(display (list (call +) (call *) (call + 7) (call - 7) (call / 4) (call - 10 1 2) (call / 60 2 3)))
(newline)
(display (list (call < 1 2 3) (call < 1 3 2) (call = 2 2 2) (call >= 3 3 1) (guard (e (#t (quote caught))) (call < 5))))
(newline)
(display (list (call string<? "a" "b" "c") (call string=? "x" "x" "y") (call char<? #\a #\b #\c)))
(newline)
(define p +)
(display (p 1 2 3 4)) (newline)
(display (map + '(1 2) '(3 4) '(5 6))) (newline)
(display (apply max (list 3 9 2))) (newline)
(display (guard (e (#t 'caught)) (call -))) (newline)
(display "variadic builtin values PASS") (newline)
