; core.ad.rigorous_interval / core.ad.rigorous_taylor_models must agree
; between the native and VM engines: fl-next-up/fl-next-down (native id
; 2228/2229 in the VM, codegenNextafter in native codegen), the outward-
; rounded ia+/ia-/ia*/ia/, the rigorous transcendentals, and a rigorous
; Taylor-model containment + polynomial no-root certification. Only a
; final PASS/FAIL line is printed (not raw doubles) so this stays
; byte-identical across -r, vm-src and vm-eskb regardless of any engine's
; float-formatting quirks -- the parity harness diffs stdout.
(require core.ad.taylor_models)

(define (contains-exact? iv x)
  (and (<= (inexact->exact (car iv)) x)
       (>= (inexact->exact (cdr iv)) x)))

(define (exact-power-two n)
  (let loop ((i n) (acc 1))
    (if (= i 0) acc (loop (- i 1) (* acc 2)))))

(define ok
  (and
    ;; directed rounding brackets its argument and round-trips exactly
    (> (fl-next-up 0.1) 0.1)
    (< (fl-next-down 0.1) 0.1)
    (= (fl-next-down (fl-next-up 0.1)) 0.1)
    (= (fl-next-up (fl-next-down 5e-324)) 5e-324)

    ;; exact stays exact; inexact gets a genuine outward nudge
    (let ((r (ia+ (cons 1/3 1/3) (cons 1/6 1/6))))
      (and (exact? (car r)) (= (car r) 1/2) (= (cdr r) 1/2)))
    (let ((r (ia+ (cons 0.1 0.1) (cons 0.2 0.2))))
      (and (not (exact? (car r))) (< (car r) (cdr r))
           (<= (car r) (+ 0.1 0.2)) (>= (cdr r) (+ 0.1 0.2))))
    ;; Mixed exact/inexact conversion must be outward before cancellation.
    (let* ((x 9007199254740993)
           (exact-sum (+ x (inexact->exact -9007199254740992.0)))
           (r (ia+ (cons x x) (cons -9007199254740992.0 -9007199254740992.0)))
           (nearest (+ (exact->inexact x) -9007199254740992.0)))
      (and (= nearest 0.0) (contains-exact? r exact-sum)
           (not (and (<= (inexact->exact (fl-next-down nearest)) exact-sum)
                     (>= (inexact->exact (fl-next-up nearest)) exact-sum)))))
    (let* ((power (let loop ((n 70) (a 1))
                    (if (= n 0) a (loop (- n 1) (* a 2)))))
           (x (+ power 1))
           (y (exact->inexact (- power)))
           (reference (+ x (inexact->exact y)))
           (r (ia+ (cons x x) (cons y y))))
      (contains-exact? r reference))
    (let* ((reference (+ 1/10 (inexact->exact -0.1)))
           (r (ia+ (cons 1/10 1/10) (cons -0.1 -0.1))))
      (contains-exact? r reference))
    ;; This exact rational's separately rounded numerator/denominator place
    ;; exact->inexact more than one representable step from the exact ratio.
    (let* ((x (/ 1812779959422046853 5126478537316945397))
           (d (exact->inexact x))
           (reference (+ x (inexact->exact (- d))))
           (r (ia+ (cons x x) (cons (- d) (- d))))
           (mirror-reference (+ (- x) (inexact->exact d)))
           (mirror (ia+ (cons (- x) (- x)) (cons d d))))
      (and (contains-exact? r reference)
           (not (contains-exact? (cons (fl-next-down d) (fl-next-up d)) x))
           (contains-exact? mirror mirror-reference)))
    (let* ((dyadic (inexact->exact 0.1))
           (sub (ia- (cons 1/3 1/3) (cons 0.1 0.1)))
           (mul (ia* (cons 1/3 1/3) (cons 0.1 0.1)))
           (div (ia/ (cons 1/3 1/3) (cons 0.1 0.1))))
      (and (contains-exact? sub (- 1/3 dyadic))
           (contains-exact? mul (* 1/3 dyadic))
           (contains-exact? div (/ 1/3 dyadic))))
    (let* ((tiny (/ 1 (exact-power-two 1075)))
           (r (ia+ (cons tiny tiny) (cons 0.0 0.0))))
      (contains-exact? r tiny))
    (let* ((huge (exact-power-two 1100))
           (r (ia/ (cons 1.0 1.0) (cons huge huge))))
      (contains-exact? r (/ 1 huge)))
    (let* ((tiny (/ 1 (exact-power-two 1075)))
           (division (guard (exn (else 'caught))
                        (ia/ (cons 1.0 1.0) (cons tiny tiny)) 'not-caught))
           (huge (exact-power-two 1100))
           (product (guard (exn (else 'caught))
                        (ia* (cons huge huge) (cons 0.0 0.0)) 'not-caught)))
      (and (eq? division 'caught) (eq? product 'caught))

    ;; rigorous transcendentals contain their libm point value
    (let ((e (ia-exp (cons 1/2 1/2)))) (and (<= (car e) (exp 0.5)) (>= (cdr e) (exp 0.5))))
    (let ((e (ia-sqrt (cons 2 2)))) (and (<= (car e) (sqrt 2.0)) (>= (cdr e) (sqrt 2.0))))
    (let ((e (ia-sin (cons 1.0 1.0)))) (and (<= (car e) (sin 1.0)) (>= (cdr e) (sin 1.0))))
    (let ((e (ia-atan (cons 3.0 3.0)))) (and (<= (car e) (atan 3.0)) (>= (cdr e) (atan 3.0))))

    ;; rigorous Taylor-model containment of exp on a rational interval
    (let* ((tm (tm-enclose (lambda (x) (tm-exp x 10)) 0 1/2 6))
           (rng (tm-bound tm)))
      (and (tm-rigorous? tm)
           (interval-contains? rng (exp 0.0))
           (interval-contains? rng (exp 0.4))
           (interval-contains? rng (exp -0.4))))

    ;; application: certify x^2-4 has no root on [0,1], but does on [1,3]
    (let* ((p (lambda (x0 r k)
                (let ((xv (tm-var x0 r k))) (tm+ (tm* xv xv) (tm-const -4 x0 r k))))))
      (and (tm-prove-nonzero (p 1/2 1/2 2))
           (not (tm-prove-nonzero (p 2 1 2)))))

    ;; rigorous? flag on core.ad.interval: opt-in matches ia+ exactly
    (let ((d (interval-add (cons 0.1 0.1) (cons 0.2 0.2) #t))
          (r (ia+ (cons 0.1 0.1) (cons 0.2 0.2))))
      (and (= (car d) (car r)) (= (cdr d) (cdr r)))))))

(if ok
    (begin (display "PASS: certified_enclosures native/VM parity") (newline))
    (begin (display "FAIL: certified_enclosures native/VM parity") (newline)))
