;; unary: negation and magnitude must stay in the operand's domain
(show "neg fix" (- fix))
(show "abs fix" (abs fix))
(show "neg nfix" (- nfix))
(show "abs nfix" (abs nfix))
(show "neg rat" (- rat))
(show "abs rat" (abs rat))
(show "neg nrat" (- nrat))
(show "abs nrat" (abs nrat))
(show "neg flo" (- flo))
(show "abs flo" (abs flo))
(show "neg nflo" (- nflo))
(show "abs nflo" (abs nflo))
(show "neg floi" (- floi))
(show "abs floi" (abs floi))
(show "neg floc" (- floc))
(show "abs floc" (abs floc))

;; the two reported reproductions, verbatim
(show "div-of-float-diffs" (/ (- 2.0 1.0) (+ 2.0 1.0)))
(show "flonum-times-ratnum" (* 0.5493061443340549 (/ (- 2.0 1.0) (+ 2.0 1.0))))

;; first-class / variadic route (the prelude folds with add2..div2 and
;; the comparison natives, a dispatch surface distinct from the opcodes)
(show "apply + rat flo" (apply + (list rat flo)))
(show "apply + flo rat" (apply + (list flo rat)))
(show "apply + rat floi" (apply + (list rat floi)))
(show "apply + nrat nflo" (apply + (list nrat nflo)))
(show "apply - rat flo" (apply - (list rat flo)))
(show "apply - flo rat" (apply - (list flo rat)))
(show "apply - rat floi" (apply - (list rat floi)))
(show "apply - nrat nflo" (apply - (list nrat nflo)))
(show "apply * rat flo" (apply * (list rat flo)))
(show "apply * flo rat" (apply * (list flo rat)))
(show "apply * rat floi" (apply * (list rat floi)))
(show "apply * nrat nflo" (apply * (list nrat nflo)))
(show "apply / rat flo" (apply / (list rat flo)))
(show "apply / flo rat" (apply / (list flo rat)))
(show "apply / rat floi" (apply / (list rat floi)))
(show "apply / nrat nflo" (apply / (list nrat nflo)))
(display "apply = rat flo = ") (display (apply = (list rat flo))) (newline)
(display "apply = flo rat = ") (display (apply = (list flo rat))) (newline)
(display "apply < rat flo = ") (display (apply < (list rat flo))) (newline)
(display "apply < flo rat = ") (display (apply < (list flo rat))) (newline)
