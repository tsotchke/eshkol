;; VM-parity differential over the numeric TAG-DISPATCH matrix.
;;
;; Every binary arithmetic and comparison op against every ordered pair
;; of runtime numeric tags (fixnum / ratnum / flonum / bignum), printing
;; the value AND its exactness so the differential gates the result TAG
;; and not only the printed digits — an integral-valued flonum and the
;; exact integer both display as `2`, which is exactly how the collapse
;; this file guards against stayed invisible.
;;
;; The paired R7RS oracle (explicit expected values, run on the VM) is
;; tests/vm/numeric_tag_dispatch_surface_regression.esk.  This file proves
;; native and VM agree; that file proves the shared answer is correct.
;;
;; bignum-with-ratnum pairs are deliberately absent: their exact result
;; needs a bignum-over-bignum rational, which is outside the VM's numeric
;; tower (tests/vm_parity/found/bignum_rational_mixed.esk).

;; floi exercises the runtime number_val() path, floc the compile-time
;; constant fold — the two independent places exactness was decided by
;; the result's value shape instead of the operand tags.
(define f125 1.25)
(define f075 0.75)
(define fix 6)
(define nfix (- 0 6))
(define rat (/ 1 3))
(define nrat (/ -2 7))
(define flo 1.5)
(define nflo (- 0.0 2.5))
(define floi (+ f125 f075))
(define floc (+ 1.25 0.75))

(define (show label v)
  (display label) (display " = ") (display v)
  (display " exact=") (display (exact? v)) (newline))

