; VM<->native parity: a derivative carried through a tensor literal (SW-197).
;
; A forward-mode carrier stored into `(tensor ...)` makes it a jet tensor and is
; read back whole by tensor-ref (ADR-0020 amendment 2). Native once read an
; exact point's Taylor tower as 0 and refused a dual; the VM kept only the
; primal. Exact points stay exact; a tensor kernel answers inexactly.

(define (sq y) (* y y))
(display (derivative (lambda (x) (fold-left + 0 (map sq (list x x x x)))) 1/3)) (newline)
; 8/3
(display (derivative (lambda (x) (let ((t (tensor x (* x x)))) (+ (tensor-ref t 0) (tensor-ref t 1)))) 1/3)) (newline)
; 5/3
(display (derivative (lambda (x) (tensor-ref (tensor (list x (* x x))) 1)) 1/3)) (newline)
; 2/3
(display (derivative-n (lambda (x) (tensor-ref (tensor x (* x x x)) 1)) 1/3 2)) (newline)
; 2
(display (taylor (lambda (x) (tensor-ref (tensor x (* x x)) 1)) 1/2 2)) (newline)
; (1/4 1 1)
(display (derivative (lambda (x) (tensor-ref (tensor x (* x x)) 1)) 0.5)) (newline)
; 1
(display (gradient (lambda (v) (let ((t (tensor (vref v 0) (* (vref v 1) (vref v 1))))) (+ (tensor-ref t 0) (tensor-ref t 1)))) #(1.0 2.0))) (newline)
; #(1 4)
(display (derivative (lambda (x) (tensor-sum (tensor x (* x x)))) 1/2)) (newline)
; 2

; Deferred constructor slots must be initialized before a carrier widens the
; whole buffer. Exercise repeated exact/inexact carriers and reused storage.
(define (constructor-reuse-check n)
  (if (= n 0)
      #t
      (let ((x (if (= (modulo n 2) 0) 0.5 0.25)))
        (and (= (derivative (lambda (y)
                             (tensor-ref (tensor y (* y y)) 1)) x)
                (* 2.0 x))
             (= (derivative (lambda (y)
                              (tensor-sum (tensor y (* y y)))) 1/2)
                2)
             (constructor-reuse-check (- n 1))))))
(display (constructor-reuse-check 32)) (newline)
