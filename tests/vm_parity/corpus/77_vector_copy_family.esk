;; LE-16: vector-copy / vector-copy! / vector-append had NO representation
;; at all on the VM (PARITY.tsv carried them as `gap`) -- not merely a
;; value-position defect but a call-position one: `(vector-copy (vector 1 2))`
;; raised "undefined variable 'vector-copy'" and then crashed the VM
;; ("calling non-function"). Native already implemented all three directly in
;; IR (collection_codegen.cpp); the VM now gets the same R7RS semantics from
;; a Scheme-level prelude definition over vector-ref/vector-set!/
;; vector-length (vm_prelude_source.h), the same shape as the pre-existing
;; vector-map/vector-for-each prelude wrappers.
;;
;; This file exercises: the full-copy and ranged forms of vector-copy, the
;; ranged forms of the mutating vector-copy!, variadic vector-append, both
;; #(...) tensor-backed literals and vector/make-vector-built vectors, and —
;; the actual LE-16 repro shape — each of the three referenced as a VALUE
;; through map, not just in call position.

(display (vector-copy (vector 1 2 3))) (newline)
(display (vector-copy (vector 1 2 3 4 5) 1 3)) (newline)
(display (vector-copy #(10 20 30 40))) (newline)
(display (vector-copy #(10 20 30 40) 2)) (newline)

(define v1 (vector 0 0 0 0 0))
(vector-copy! v1 1 (vector 9 8 7))
(display v1) (newline)

(define v2 (make-vector 6 0))
(vector-copy! v2 1 (vector 1 2 3 4 5) 1 3)
(display v2) (newline)

(display (vector-append (vector 1 2) (vector 3 4))) (newline)
(display (vector-append (vector 1) (vector 2) (vector 3))) (newline)
(display (vector-append #(1 2) #(3 4))) (newline)

;; The value-position shape from the LE-16 repro itself.
(display (map vector-copy (list (vector 1 2) (vector 3 4 5)))) (newline)
(display (map vector-length (list (vector 1 2) (vector 3 4 5)))) (newline)
(display (let ((f vector-copy)) (f (vector 7 8 9)))) (newline)
