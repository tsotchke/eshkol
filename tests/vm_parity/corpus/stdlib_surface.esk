; The VM bootstrap must expose the same canonical stdlib surface as desktop.
(require stdlib)

(define ok
  (and
    (equal? (assq 'a '((a 1) (b 2))) '(a 1))
    (equal? (assv 2 '((1 one) (2 two))) '(2 two))
    (member? 3 '(1 2 3))
    (equal? (zip '(1 2 3) '(4 5 6)) '((1 4) (2 5) (3 6)))
    (equal? (iota-from 3 5) '(5 6 7))
    (equal? (iota-step 3 0 2) '(0 2 4))
    (string-contains "stdlib" "lib")
    (string-starts-with? "stdlib" "std")
    (string-ends-with? "stdlib" "lib")
    (equal? ((compose (lambda (x) (+ x 1)) (lambda (x) (* x 2))) 4) 9)
    (equal? (((curry2 +) 4) 5) 9)
    (equal? (stream->list (stream-take (stream-from 1) 3)) '(1 2 3))))

(if ok
    (begin (display "PASS: VM canonical stdlib surface") (newline))
    (begin (display "FAIL: VM canonical stdlib surface") (newline)))
