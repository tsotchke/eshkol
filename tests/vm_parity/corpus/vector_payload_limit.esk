; The first vector capacity at the shared boundary must be rejected before
; any heap allocation. The same source is run by native, VM, and WASM.
(define (expect-rejection n)
  (guard (exn
           (else #t))
    (begin (make-vector n) #f)))
(display (and (expect-rejection 268435456)
              (expect-rejection 268435457)))
(newline)
