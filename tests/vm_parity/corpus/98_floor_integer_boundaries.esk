(require stdlib)
(define (check label ok)
  (if (not ok) (begin (display "FAIL: ") (display label) (newline) (exit 1))))
(define minimum -9223372036854775808)
(define promoted 9223372036854775808)
(check "floor quotient promotes MIN/-1" (= (floor-quotient minimum -1) promoted))
(check "promoted result remains exact" (exact? (floor-quotient minimum -1)))
(check "floor remainder MIN/-1" (= (floor-remainder minimum -1) 0))
(check "modulo MIN/-1" (= (modulo minimum -1) 0))
(check "remainder MIN/-1" (= (remainder minimum -1) 0))
(check "exact division promotes MIN/-1" (= (/ minimum -1) promoted))
(check "quotient control" (= (quotient minimum -1) promoted))
(check "floor quotient keeps fixnum low bits" (= (floor-quotient 9223372036854775806 2) 4611686018427387903))
(check "modulo keeps fixnum low bits" (= (modulo 9223372036854775807 2) 1))
(check "remainder keeps fixnum low bits" (= (remainder 9223372036854775807 2) 1))
(check "negative dividend floor" (= (floor-quotient -7 3) -3))
(check "negative divisor floor" (= (floor-quotient 7 -3) -3))
(check "both negative floor" (= (floor-quotient -7 -3) 2))
(check "negative floor remainder" (= (floor-remainder 7 -3) -2))
(check "inexact contagion" (and (inexact? (floor-quotient -7.0 3.0)) (= (floor-quotient -7.0 3.0) -3.0)))
(check "fractional inexact divisor" (and (inexact? (floor-quotient 1.0 0.5)) (= (floor-quotient 1.0 0.5) 2.0)))
(display "PASS: exact floor division boundaries") (newline)
