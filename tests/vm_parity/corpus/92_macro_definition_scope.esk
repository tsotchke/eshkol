;; R7RS 4.3: template identifiers keep definition scope; substituted syntax
;; keeps caller scope. Numeric expectations are independent of either engine.
(define (macro-check label expected actual)
  (if (equal? expected actual)
      (begin (display "PASS macro: ") (display label) (newline))
      (begin (display "FAIL macro: ") (display label)
             (display " expected ") (write expected)
             (display " got ") (write actual) (newline))))

(define-syntax when (syntax-rules () ((when test body) (if test body #f))))
(macro-check "keyword shadow" #f (when #f 9))
(define-syntax outer-m (syntax-rules () ((outer-m) 1)))
(define-syntax global-m (syntax-rules () ((global-m) (outer-m))))
(macro-check "let-syntax definition environment" 1
  (let-syntax ((outer-m (syntax-rules () ((outer-m) 2)))
               (inner-n (syntax-rules () ((inner-n) (outer-m)))))
    (inner-n)))
(macro-check "letrec-syntax definition environment" 2
  (letrec-syntax ((outer-m (syntax-rules () ((outer-m) 2)))
                  (inner-n (syntax-rules () ((inner-n) (outer-m)))))
    (inner-n)))
(let-syntax ((outer-m (syntax-rules () ((outer-m) 2)))
             (caller (syntax-rules () ((caller x) x))))
  (macro-check "global template binding" 1 (global-m))
  (macro-check "substituted caller binding" 2 (caller (outer-m))))
(macro-check "restored outer macro" 1 (outer-m))
(macro-check "recursive group forward reference" 7
  (letrec-syntax ((first-m (syntax-rules () ((first-m x) (second-m x))))
                  (second-m (syntax-rules () ((second-m x) (+ x 3)))))
    (first-m 4)))
(let ((x 11))
  (let-syntax ((get-x (syntax-rules () ((get-x) x)))
               (put-x (syntax-rules () ((put-x v) (set! x v)))))
    (let ((x 22))
      (macro-check "free value binding" 11 (get-x))
      (macro-check "free value through closure" 11 ((lambda () (get-x))))
      (put-x 33)
      (macro-check "definition-site assignment" 33 (get-x))
      (macro-check "caller value survives assignment" 22 x)
      ((lambda () (put-x 44)))
      (macro-check "definition-site closure assignment" 44 (get-x))
      (macro-check "caller value survives closure assignment" 22 x))))
(let-syntax ((add-m (syntax-rules () ((add-m x) (+ x 1)))))
  (let ((+ (lambda (a b) 99)))
    (macro-check "template procedure binding" 6 (add-m 5))))
