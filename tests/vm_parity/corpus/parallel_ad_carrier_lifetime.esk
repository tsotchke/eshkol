;; Worker results own their exact halves and Taylor coefficient arrays.
(define (check a b)
  (if (equal? a b) #t (error "parallel AD transfer mismatch" a b)))
(define (loss x)
  (fold-left + 0 (parallel-map (lambda (y) (* y y)) (list x x x x))))
(define (serial-loss x)
  (fold-left + 0 (map (lambda (y) (* y y)) (list x x x x))))
(check (derivative serial-loss 1/3) 8/3)
(check (exact? (derivative serial-loss 1/3)) #t)
(check (derivative loss 3) 24)
(check (exact? (derivative loss 3)) #t)
(check (derivative loss 1/3) 8/3)
(check (hessian loss 3.0) 8.0)
(check (exact? (hessian loss 3.0)) #f)
(check (hessian loss 3) 8)
(check (exact? (hessian loss 3)) #t)
(define tiny (/ 1 (expt 2 2000)))
(check (derivative loss tiny) (* 8 tiny))
(check (exact? (derivative loss tiny)) #t)
(define (region-loss x) (with-region ('ad-result 65536) (loss x)))
(check (derivative region-loss 1/3) 8/3)
(check (hessian region-loss 3.0) 8.0)
(check
  (derivative-n (lambda (x)
    (derivative-n (lambda (y)
      (with-region ('nested-ad 65536) (* y y y))) x 2)) 3 1) 6)
(display "parallel AD carrier lifetime PASS") (newline)
