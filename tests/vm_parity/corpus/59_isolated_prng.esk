;; Integer-domain drand48-msb-v1 contract, including aliases and region escape.
(define checks 0)
(define (check label ok) (set! checks (+ checks 1))
  (if (not ok) (begin (display "FAIL: ") (write label) (newline) (exit 1))))
(define p (make-prng 7))
(check 'is-prng (prng? p))
(check 'not-parameter (not (prng? (make-parameter 7))))
(check 'not-scalar (not (prng? 7)))
(check 'not-vector (not (prng? (vector 7))))
(check 'identity (eq? p p))
(define expected '(26644 68203 26549 12911 49460 29757 15996 72044 1005 9334))
(let loop ((xs expected))
  (if (pair? xs) (begin (check 'independent-lcg-golden (= (car xs) (prng-random-integer p 100000))) (loop (cdr xs)))))
(define a (make-prng -1)) (define b (make-prng -1))
(check 'distinct-state (not (eq? a b)))
(check 'empty-bound (= 0 (prng-random-integer a 0)))
(check 'negative-bound (= 0 (prng-random-integer a -7)))
(let loop ((i 0))
  (if (< i 64)
      (begin (check 'same-seed-no-empty-range-draw (= (prng-random-integer a 4294967296) (prng-random-integer b 4294967296)))
             (loop (+ i 1)))))
(define f (make-prng 1099511627783)) (define g (make-prng 1099511627783))
(let loop ((i 0))
  (if (< i 32) (begin (check 'same-double (= (prng-random f) (prng-random g))) (loop (+ i 1)))))
(set-random-seed! 29) (define global-first (random))
(set-random-seed! 29)
(define isolated (make-prng 7)) (prng-random isolated)
(check 'isolated-from-global (= global-first (random)))
(define escaped (with-region ('prng-scratch 8192)
  (let ((r (make-prng 7))) (cons r r))))
(check 'region-preserves-type (prng? (car escaped)))
(check 'region-preserves-alias (eq? (car escaped) (cdr escaped)))
(check 'region-first (= 26644 (prng-random-integer (car escaped) 100000)))
(check 'region-alias-advances-one-state (= 68203 (prng-random-integer (cdr escaped) 100000)))
(define draw (with-region ('closure-scratch 8192)
  (let ((r (make-prng 7))) (lambda () (prng-random-integer r 100000)))))
(check 'closure-escape-first (= 26644 (draw)))
(check 'closure-escape-second (= 68203 (draw)))
(display "ISOLATED PRNG checks: ") (display checks) (newline)
(display "ISOLATED PRNG RESULT: PASS") (newline)
