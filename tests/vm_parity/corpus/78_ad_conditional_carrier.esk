; VM<->native parity for comparisons/branch-selection over a live AD carrier
; (SW-158). A forward-mode dual (`derivative`) or reverse-mode AD node
; (`gradient`) compared against an EXACT RATIONAL LITERAL used to be able to
; let the rational steal the dispatch on both substrates -- native's
; ArithmeticCodegen::compare() (bignum/rational tiers before the AD-carrier
; tier) and the VM's vm_exec_lt/gt/le/ge/eq() (vm_either_exact_wide() before
; vm_either_ad_carrier()) -- reading the carrier's raw bits instead of its
; primal and silently taking the wrong branch. Every seed point here is
; INEXACT (op:DERIVATIVE / op:GRADIENT are native-only at an exact point,
; PARITY.tsv ESH-0394); the RATIONAL operand lives inside the differentiand
; body, which is exactly where the defect was.

(define w 2/5)

; --- < with a rational literal on the right; t=0.1 < 2/5 selects t^3 ---
(define (bump-lt t) (if (< t w) (* t t t) 0))
(display (derivative bump-lt 0.1)) (newline)          ; 0.03

; --- > with a rational literal on the right; t=0.9 > 2/5 selects -t ---
(define (bump-gt t) (if (> t w) (- t) (* t t t)))
(display (derivative bump-gt 0.9)) (newline)           ; -1

; --- <= / >= at points away from the boundary, rational on the LEFT ---
(define (bump-le t) (if (<= w t) (* t t) t))
(display (derivative bump-le 0.9)) (newline)           ; 1.8
(define (bump-ge t) (if (>= w t) t (* t t)))
(display (derivative bump-ge 0.1)) (newline)           ; 1

; --- = selects between two constant branches: derivative must be exact 0 ---
(define (flat-eq t) (if (= t w) 99 (+ t 0)))
(display (derivative flat-eq 0.1)) (newline)           ; 1 (t=0.1 != w, identity branch)

; --- min / max against a rational literal ---
(define (mn t) (min t w))
(display (derivative mn 0.1)) (newline)                ; 1 (t < w, t selected)
(define (mx t) (max t w))
(display (derivative mx 0.1)) (newline)                ; 0 (t < w, w selected -> constant)

; --- abs kink around a rational literal ---
(define (ab t) (abs (- t w)))
(display (derivative ab 0.1)) (newline)                ; -1 (t < w)
(display (derivative ab 0.9)) (newline)                ; 1  (t > w)

; --- cond, condition compares carrier vs rational (when/unless + internal
;     define/set! mutation is exercised natively only, in
;     tests/ad/conditional_differentiand_test.esk -- that combination has an
;     unrelated, pre-existing VM limitation with internal `define` bodies,
;     tracked separately from SW-158 and outside this parity probe's scope) ---
(define (wu t) (cond ((< t w) (* t t t)) (else (- t))))
(display (derivative wu 0.1)) (newline)                ; 0.03
(display (derivative wu 0.9)) (newline)                ; -1

; --- reverse-mode: gradient of a scalar closure with the same comparison ---
(display (gradient bump-lt 0.1)) (newline)              ; 0.03
(display (gradient bump-gt 0.9)) (newline)               ; -1

; --- negative control: a branch that is genuinely constant, still exact 0 ---
(define (const-branch t) (if (< t w) (+ 5 5) (+ 3 3)))
(display (derivative const-branch 0.1)) (newline)       ; 0
