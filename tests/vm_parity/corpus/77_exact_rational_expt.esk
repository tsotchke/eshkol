; SW-152: `expt` over an exact rational/bignum base, and negative exponents,
; must be exact and must agree between native and the VM. Before the fix,
; native's eshkol_bignum_pow_tagged and the VM's expt dispatch (native id 32)
; each mis-extracted a rational base's heap payload as a bignum's (native) or
; skipped straight to a heap-unaware as_number() (VM), both landing on 0.0.
(display (expt 1/3 50)) (newline)
(display (exact? (expt 1/3 50))) (newline)
(display (expt 1/2 3)) (newline)
(display (expt -1/2 3)) (newline)
(display (expt -1/2 2)) (newline)
(display (expt 1/3 -2)) (newline)
(display (expt 2 -2)) (newline)
(display (exact? (expt 2 -2))) (newline)
(display (expt 10 -30)) (newline)
(display (expt 0 0)) (newline)
(display (expt 5 0)) (newline)
(display (expt 0 5)) (newline)
(define r (/ (expt 7 30) (expt 11 25)))
(display (exact? (* r r))) (newline)
(display (exact? (expt 1/3 2.0))) (newline)
