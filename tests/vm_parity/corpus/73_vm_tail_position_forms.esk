;; LE-13: all requested R7RS tail-position spellings stay bounded on the VM.
(define (when-a n) (if (= n 0) 0 (when #t (when-b (- n 1)))))
(define (when-b n) (if (= n 0) 0 (when #t (when-a (- n 1)))))

(define (unless-a n) (if (= n 0) 0 (unless #f (unless-b (- n 1)))))
(define (unless-b n) (if (= n 0) 0 (unless #f (unless-a (- n 1)))))

(define (and-a n) (if (= n 0) 0 (and #t (and-b (- n 1)))))
(define (and-b n) (if (= n 0) 0 (and #t (and-a (- n 1)))))

(define (or-a n) (if (= n 0) 0 (or #f (or-b (- n 1)))))
(define (or-b n) (if (= n 0) 0 (or #f (or-a (- n 1)))))

(define (let-a n) (if (= n 0) 0 (let ((next (- n 1))) (let-b next))))
(define (let-b n) (if (= n 0) 0 (let ((next (- n 1))) (let-a next))))

(display (when-a 5000))
(display (unless-a 5000))
(display (and-a 5000))
(display (or-a 5000))
(display (let-a 5000))
(display "PASS: VM tail-position forms")
