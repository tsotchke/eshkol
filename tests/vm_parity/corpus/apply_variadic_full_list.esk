;; Dynamic apply must preserve the entire variadic tail, not only eight slots.
(define (check label a b)
  (if (equal? a b) #t
      (begin (display "FAILED: ") (display label) (newline)
             (display a) (newline) (display b) (newline)
             (error "apply rest regression" a b))))
(define xs
  (let loop ((n 256) (out '()))
    (if (= n 0) out (loop (- n 1) (cons n out)))))
(define list-alias list)
(define vector-alias vector)
(define string-alias string)
(check "list" (apply list-alias xs) xs)
(define v (apply vector-alias xs))
(check "vector length" (vector-length v) 256)
(check "vector last" (vector-ref v 255) 256)
(define chars
  (let loop ((n 256) (out '()))
    (if (= n 0) out (loop (- n 1) (cons #\x out)))))
(define s (apply string-alias chars))
(check "string length" (string-length s) 256)
(check "string last" (string-ref s 255) #\x)
(define collect ((lambda () (lambda args args))))
(check "rest closure" (apply collect xs) xs)
(define prefixed
  (let ((bias 5))
    (lambda (a b . rest) (list (+ a bias) b (length rest) (car rest)))))
(check "leading prefix" (apply prefixed 10 20 xs) '(15 20 256 1))
(check "list prefix" (apply prefixed (cons 10 (cons 20 xs))) '(15 20 256 1))
(define p (make-parameter 7))
(check "parameter getter" (apply p '()) 7)
(apply p '(9))
(check "parameter setter" (p) 9)
(display "apply complete variadic list PASS") (newline)
