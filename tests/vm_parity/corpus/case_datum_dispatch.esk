;; case compares quoted datums with eqv?, evaluates its key once, and leaves
;; one result. In particular, distinct symbols must not become numeric zeros.
(define checks 0)
(define (check name ok)
  (set! checks (+ checks 1))
  (if (not ok) (begin (display "FAIL: ") (write name) (newline) (exit 1))))
(define (dispatch request)
  (case request ((receipt) 'receipt) ((checkpoint) 'checkpoint) (else 'other)))
(check 'first-symbol (eq? 'receipt (dispatch 'receipt)))
(check 'later-symbol (eq? 'checkpoint (dispatch 'checkpoint)))
(check 'symbol-fallback (eq? 'other (dispatch 'work)))
(check 'computed-symbol (eq? 'checkpoint (dispatch (string->symbol "checkpoint"))))
(check 'symbol-is-not-zero (eq? 'other (dispatch 0)))
(check 'string-is-not-symbol (eq? 'other (dispatch "receipt")))
(define (capture)
  (let ((receipt 7))
    (lambda (request value)
      (case request ((receipt) (+ receipt value)) ((checkpoint) 11) (else 13)))))
(define handle (capture))
(check 'captured-first (= 10 (handle 'receipt 3)))
(check 'captured-later (= 11 (handle 'checkpoint 3)))
(check 'captured-fallback (= 13 (handle 'work 3)))
(check 'multiple-datums (eq? 'hit (case 'gamma ((alpha beta gamma) 'hit) (else 'miss))))
(define key-count 0)
(define body-count 0)
(define selected
  (case (begin (set! key-count (+ key-count 1)) 'target)
    ((wrong) (set! body-count 100) 'wrong)
    ((target alias) (set! body-count (+ body-count 1)) 'selected)
    (else (set! body-count 1000) 'wrong)))
(check 'key-once (= 1 key-count))
(check 'body-once (= 1 body-count))
(check 'last-body-value (eq? 'selected selected))
(check 'surrounding-operands (= 25 (+ 10 (case 'second ((first) 1) ((second) 2) (else 3)) 13)))
(check 'surrounding-binding (= 15 (let ((before 5)) (+ before (case 'second ((first) 1) ((second) 10) (else 100))))))
(check 'nested-cases (eq? 'ok (case 'outer ((wrong) 'bad) ((outer) (case 'inner ((wrong) 'bad) ((inner) 'ok) (else 'bad))) (else 'bad))))
(check 'local-eqv-shadow
       (eq? 'hit (let ((eqv? (lambda (a b) #t)))
                   (case 'target ((wrong) 'miss) ((target) 'hit) (else 'miss)))))
(check 'boolean-false (eq? 'false (case #f ((#t) 'true) ((#f) 'false) (else 'miss))))
(check 'boolean-vs-zero (eq? 'boolean (case #f ((0) 'number) ((#f) 'boolean) (else 'miss))))
(check 'character (eq? 'b (case #\b ((#\a) 'a) ((#\b) 'b) (else 'miss))))
(check 'character-vs-integer (eq? 'character (case #\a ((97) 'number) ((#\a) 'character) (else 'miss))))
(check 'integer-later (eq? 'two (case 2 ((1) 'one) ((2) 'two) (else 'miss))))
(check 'integer-fallback (eq? 'other (case 9 ((1) 'one) ((2) 'two) (else 'other))))
(check 'exactness (eq? 'inexact (case 1.0 ((1) 'exact) ((1.0) 'inexact) (else 'miss))))
(check 'numeric-equality-stays-numeric (= 1 1.0))
(check 'numeric-key-is-not-symbol (eq? 'zero (case 0 ((symbol) 'symbol) ((0) 'zero) (else 'miss))))
(check 'null-vs-symbol (eq? 'empty (case '() ((symbol) 'symbol) ((()) 'empty) (else 'miss))))
(display "CASE DATUM checks: ") (display checks) (newline)
(display "CASE DATUM RESULT: PASS") (newline)
