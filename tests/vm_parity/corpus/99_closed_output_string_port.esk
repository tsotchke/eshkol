(require stdlib)
(define (check label ok)
  (if (not ok) (begin (display "FAIL: ") (display label) (newline) (exit 1))))
(define p (open-output-string))
(display "x" p)
(define first (get-output-string p))
(check "open snapshot contains output" (string=? first "x"))
(display "y" p)
(check "later snapshot contains appended output" (string=? (get-output-string p) "xy"))
(check "earlier snapshot is independent" (string=? first "x"))
(close-port p)
(check "closed snapshot matches hosted empty contract" (string=? (get-output-string p) ""))
(check "returned snapshot survives close" (string=? first "x"))
(close-port p)
(check "repeated close stays empty" (string=? (get-output-string p) ""))
(display "PASS: closed output-string snapshots") (newline)
