; MS-05 / SW-167: `sqrt` of an exact perfect square (integer or rational) and
; `expt` with an exact rational exponent stay exact when the exact root
; exists, on both engines (R7RS 6.2.6). Negative controls: a non-square
; radicand/base stays inexact, and the value is still numerically correct
; either way.
(display (sqrt 16)) (newline)
(display (exact? (sqrt 16))) (newline)
(display (exact? (sqrt 15))) (newline)
(display (sqrt 1/4)) (newline)
(display (exact? (sqrt 1/4))) (newline)
(display (sqrt 4/9)) (newline)
(display (exact? (sqrt 1/2))) (newline)
(display (expt 4 1/2)) (newline)
(display (exact? (expt 4 1/2))) (newline)
(display (expt 8 2/3)) (newline)
(display (expt 1/27 1/3)) (newline)
(display (exact? (expt 2 1/2))) (newline)
(display (exact? (expt 4 1/3))) (newline)
