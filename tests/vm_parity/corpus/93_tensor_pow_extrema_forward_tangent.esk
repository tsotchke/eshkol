;; SW-186: forward tangents through tensor-pow/maximum/minimum (both operands).
(define failures 0)
(define (close? a b) (< (abs (- a b)) 1e-8))
(define (check name got want)
  (if (close? got want) #t
      (begin (set! failures (+ failures 1)) (display "FAIL: ")
             (display name) (display " got ") (display got) (newline))))
(define base #(2.0 3.0))
(define exps #(2.0 3.0))
(define gb (gradient (lambda (v) (tensor-sum (tensor-pow v exps))) base))
(check "pow base[0]" (vref gb 0) 4.0)
(check "pow base[1]" (vref gb 1) 27.0)
(define ge (gradient (lambda (v) (tensor-sum (tensor-pow base v))) exps))
(check "pow exponent[0]" (vref ge 0) (* 4.0 (log 2.0)))
(check "pow exponent[1]" (vref ge 1) (* 27.0 (log 3.0)))
(define hi-a #(1.0 4.0))
(define hi-b #(2.0 3.0))
(define gmax-a (gradient (lambda (v) (tensor-sum (tensor-maximum v hi-b))) hi-a))
(define gmax-b (gradient (lambda (v) (tensor-sum (tensor-maximum hi-a v))) hi-b))
(check "max left[0]" (vref gmax-a 0) 0.0)
(check "max left[1]" (vref gmax-a 1) 1.0)
(check "max right[0]" (vref gmax-b 0) 1.0)
(check "max right[1]" (vref gmax-b 1) 0.0)
;; Native's strict comparison selects the second operand on an equal tie.
(define tie #(2.0))
(define gmax-tie-a (gradient (lambda (v) (tensor-sum (tensor-maximum v tie))) tie))
(define gmax-tie-b (gradient (lambda (v) (tensor-sum (tensor-maximum tie v))) tie))
(check "max tie left" (vref gmax-tie-a 0) 0.0)
(check "max tie right" (vref gmax-tie-b 0) 1.0)
(define gmin-a (gradient (lambda (v) (tensor-sum (tensor-minimum v hi-b))) hi-a))
(define gmin-b (gradient (lambda (v) (tensor-sum (tensor-minimum hi-a v))) hi-b))
(check "min left[0]" (vref gmin-a 0) 1.0)
(check "min left[1]" (vref gmin-a 1) 0.0)
(check "min right[0]" (vref gmin-b 0) 0.0)
(check "min right[1]" (vref gmin-b 1) 1.0)
(define gc (gradient (lambda (v) (tensor-sum (tensor-pow #(2.0 3.0) #(2.0 3.0)))) base))
(check "constant control" (vref gc 0) 0.0)
(if (= failures 0)
    (begin (display "PASS: tensor_pow_extrema_forward_tangent") (newline))
    (begin (display "FAIL: tensor_pow_extrema_forward_tangent") (newline) (exit 1)))
