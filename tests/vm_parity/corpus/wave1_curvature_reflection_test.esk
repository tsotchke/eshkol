;;; Wave 1: core.curvature (ADR-0018 signed-curvature chart, 25 ops)
;;; plus procedure-arity, features, and % modulo alias.

(define (r12 x) (/ (round (* x 1000000000000.0)) 1000000000000.0))
(define (r12-list xs) (map r12 xs))
(define (r12-vec1 t)
  (let ((n (car (tensor-shape t))))
    (let loop ((i 0) (acc '()))
      (if (= i n) (reverse acc)
          (loop (+ i 1) (cons (r12 (tensor-ref t i)) acc))))))

(display "conv-id:") (display (chart-convention-id)) (newline)
(display "alpha:") (display (chart-alpha)) (newline)

(let ((hdr (make-geometry-header -1.0)))
  (display "hdr:") (display hdr) (newline)
  (display "hdr-chk:") (display (geometry-header-check hdr)) (newline))

(let ((x (tensor 0.2 -0.1 0.05))
      (y (tensor -0.15 0.25 0.1))
      (v (tensor 0.1 0.05 -0.05))
      (g (tensor 0.3 -0.2 0.1)))
  (display "dist-neg:") (display (r12 (chart-distance x y -1.0))) (newline)
  (display "dist-zero:") (display (r12 (chart-distance x y 0.0))) (newline)
  (display "dist-pos:") (display (r12 (chart-distance x y 1.0))) (newline)
  (display "sqdist-neg:") (display (r12 (chart-sq-distance x y -1.0))) (newline)
  (display "conf-neg:") (display (r12 (chart-conformal-factor x -1.0))) (newline)
  (display "djet-0:") (display (r12-list (chart-distance-jet x y 0.0))) (newline)
  (display "sqjet-neg:") (display (r12-list (chart-sq-distance-jet x y -1.0))) (newline)
  (display "sqgrad-neg:") (display (r12-vec1 (chart-sq-distance-gradient x y -1.0))) (newline)
  (display "exp-neg:") (display (r12-vec1 (chart-exp-map x v -1.0))) (newline)
  (display "log-neg:") (display (r12-vec1 (chart-log-map x y -1.0))) (newline)
  (display "trans-neg:") (display (r12-vec1 (chart-transport x y v -1.0))) (newline)
  (display "madd-neg:") (display (r12-vec1 (chart-mobius-add x y -1.0))) (newline)
  (display "mscal-neg:") (display (r12-vec1 (chart-mobius-scalar 0.5 x -1.0))) (newline)
  (display "proj-neg:") (display (r12-vec1 (chart-project x -1.0))) (newline)
  (display "rgrad-neg:") (display (r12-vec1 (chart-riemannian-grad g x -1.0))) (newline)
  (display "def-temp:") (display (r12 (chart-default-temperature 4))) (newline)
  (let ((sp (chart->sphere x 1.0)))
    (display "c2s:") (display (r12-vec1 sp)) (newline)
    (display "s2c:") (display (r12-vec1 (sphere->chart sp 1.0))) (newline))
  (display "mig-pt:") (display (r12-vec1 (migrate-legacy-ball-point x -1.0))) (newline)
  (display "mig-tan:") (display (r12-vec1 (migrate-legacy-ball-tangent v -1.0))) (newline)
  (display "mig-temp:") (display (r12 (migrate-legacy-temperature 2.0 1.5))) (newline))

(let ((q (make-tensor '(1 2) 0.1))
      (k (make-tensor '(2 2) 0.2))
      (val (make-tensor '(2 2) 0.5)))
  (display "attn:") (display (chart-attention q k val -1.0)) (newline)
  (display "attn-w:") (display (chart-attention-weights q k val -1.0)) (newline))

;; procedure-arity, features, and %
(display "arity-1:") (display (procedure-arity (lambda (x) x))) (newline)
(display "arity-2:") (display (procedure-arity (lambda (x y) (+ x y)))) (newline)
(display "feat-r7rs:") (display (if (memq 'r7rs (features)) #t #f)) (newline)
(display "feat-eshkol:") (display (if (memq 'eshkol (features)) #t #f)) (newline)
(display "mod-pct:") (display (% 17 5)) (newline)
