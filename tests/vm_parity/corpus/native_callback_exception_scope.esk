;; A locally handled raise must resume its callback, not terminate the C
;; higher-order operation. A handler outside it must escape to that caller.
(define (check a b)
  (if (equal? a b) #t (error "native callback scope mismatch" a b)))
(define xs '(1 2 3 4 5 6 7 8))
(define (caught n)
  (guard (e (#t (car (error-object-irritants e)))) (error "local" n)))
(check (map caught xs) xs)
(check (parallel-map caught xs) xs)
(check (guard (e (#t (if (member (car (error-object-irritants e)) xs) #t #f)))
         (parallel-map (lambda (n) (error "outer" n)) xs)) #t)
(check (map (lambda (n) (guard (e (#t (+ n 10))) (error "local"))) xs)
       '(11 12 13 14 15 16 17 18))
(check (guard (e (#t 99))
         (map (lambda (n) (error "outer" n)) xs)) 99)
(check (call/cc (lambda (escape)
         (map (lambda (n) (if (= n 3) (escape 73) n)) xs))) 73)
(check (map (lambda (n) (call/cc (lambda (k) (k (+ n 1))))) xs)
       '(2 3 4 5 6 7 8 9))
(display "native callback exception scope PASS") (newline)
