;; SW-186: elementwise tensor unary operators retain forward tangents on VM.
(define failures 0)
(define (close? a b) (< (abs (- a b)) 1e-8))
(define (check name got want)
  (if (close? got want) #t
      (begin (set! failures (+ failures 1)) (display "FAIL: ")
             (display name) (display " got ") (display got) (newline))))
(define x #(1.0 2.0 3.0))
(define ge (gradient (lambda (v) (tensor-sum (tensor-neg v))) x))
(check "neg[0]" (vref ge 0) -1.0)
(define gx (gradient (lambda (v) (tensor-sum (tensor-exp v))) x))
(check "exp[0]" (vref gx 0) (exp 1.0))
(define gs (gradient (lambda (v) (tensor-sum (tensor-sin v))) x))
(check "sin[1]" (vref gs 1) (cos 2.0))
(define gc (gradient (lambda (v) (tensor-sum (tensor-cos v))) x))
(check "cos[2]" (vref gc 2) (- (sin 3.0)))
(define gq (gradient (lambda (v) (tensor-sum (tensor-sqrt v))) x))
(check "sqrt[0]" (vref gq 0) 0.5)
(define xa #(-1.0 0.5 2.0))
(define ga (gradient (lambda (v) (tensor-sum (tensor-abs v))) xa))
(check "abs[-1]" (vref ga 0) -1.0)
(check "abs[+.5]" (vref ga 1) 1.0)
(define gl (gradient (lambda (v) (tensor-sum (tensor-log v))) x))
(check "log[2]" (vref gl 1) 0.5)
(define gr (gradient (lambda (v) (tensor-sum (relu v))) xa))
(check "relu[-1]" (vref gr 0) 0.0)
(check "relu[+.5]" (vref gr 1) 1.0)
(define e1 (exp 1.0))
(define gsig (gradient (lambda (v) (tensor-sum (sigmoid v))) x))
(check "sigmoid[1]" (vref gsig 0) (/ e1 (* (+ 1.0 e1) (+ 1.0 e1))))
;; Weighted softmax exposes off-diagonal Jacobian terms; sum(softmax)=1
;; would incorrectly make every gradient zero.
(define gsoft (gradient (lambda (v) (tensor-dot (softmax v) #(1.0 3.0 2.0))) x))
(check "softmax[0]" (vref gsoft 0) -0.10395811358516752)
(check "softmax[1]" (vref gsoft 1) 0.20686949103015304)
(check "softmax[2]" (vref gsoft 2) -0.10291137744498545)
;; A constant tensor has no tangent, even inside a differentiated function.
(define gconst (gradient (lambda (v) (tensor-sum #(4.0 5.0 6.0))) x))
(check "constant[0]" (vref gconst 0) 0.0)
(if (= failures 0)
    (begin (display "PASS: tensor_unary_forward_tangent") (newline))
    (begin (display "FAIL: tensor_unary_forward_tangent") (newline) (exit 1)))
