(define q (make-tensor '(2 2 1) 0.0))
(define k q)
(define v (reshape (tensor 5.0 9.0 2.0 6.0) '(2 2 1)))
(define w (make-tensor '(1 1) 1.0))
(define mask (padding-mask #(1 2) 2))
(define (answers t)
  (and (= (tensor-ref t 0 0 0) 5.0) (= (tensor-ref t 0 1 0) 5.0)
       (= (tensor-ref t 1 0 0) 4.0) (= (tensor-ref t 1 1 0) 4.0)))
(define float-refused
  (guard (e ((error-object? e)
             (equal? (error-object-message e)
                     "Type error in padding-mask: expected nonnegative integer maximum length"))
            (#t #f))
    (padding-mask #(1 2) 2.0)
    #f))
(display (if (and float-refused (answers (scaled-dot-attention q k v mask))
                  (answers (multi-head-attention q k v 1 w w w w mask)))
             "PASS padding_mask_attention" "FAIL padding_mask_attention"))
(newline)
