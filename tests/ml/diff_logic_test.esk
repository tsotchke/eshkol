;; core.ml.diff_logic — differentiable logic programs: soft forward chaining
;; over relations read from the knowledge base, exact gradients through rule
;; application, and rule learning (kinship) that generalizes to a family never
;; seen in training.

(require core.ml.diff_logic)

(define pass-count 0)
(define fail-count 0)
(define (check name ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display name) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display name) (newline))))

(define (vmaxabs-diff a b)
  (let loop ((i 0) (m 0.0))
    (if (< i (vector-length a)) (loop (+ i 1) (max m (abs (- (vector-ref a i) (vector-ref b i))))) m)))

(define (forward-gradient f theta)
  (let* ((n (vector-length theta)) (g (make-vector n 0.0)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set! g i
              (derivative (lambda (s)
                            (let ((th (make-vector n 0.0)))
                              (let fill ((k 0))
                                (if (< k n)
                                    (begin (vector-set! th k (if (= k i) (+ (vector-ref theta k) s) (vector-ref theta k)))
                                           (fill (+ k 1)))))
                              (f th)))
                          0.0))
            (loop (+ i 1)))))
    g))

(define (sgd! theta loss steps lr)
  (let train ((k 0))
    (if (< k steps)
        (let ((g (gradient loss theta)))
          (let upd ((i 0))
            (if (< i (vector-length theta))
                (begin (vector-set! theta i (- (vector-ref theta i) (* lr (vector-ref g i)))) (upd (+ i 1)))))
          (train (+ k 1))))))

;; ── crisp semantics: the soft operators agree with relational algebra on 0/1 ──
(define d3 (dl-domain '(a b c)))
(define r (dl-relation-zero d3))
(dl-relation-set! d3 r 0 1 1.0)
(dl-relation-set! d3 r 1 2 1.0)
(define rr (dl-compose d3 r r))
(check "compose: a->b->c gives (a, c)" (= (dl-relation-ref d3 rr 0 2) 1.0))
(check "compose: nothing else" (= (let loop ((i 0) (s 0.0)) (if (< i 9) (loop (+ i 1) (+ s (vector-ref rr i))) s)) 1.0))
(check "inverse" (= (dl-relation-ref d3 (dl-inverse d3 r) 2 1) 1.0))
(check "or/and/not truth tables"
       (and (= (dl-or 1.0 0.0) 1.0) (= (dl-or 0.0 0.0) 0.0) (= (dl-and 1.0 0.0) 0.0) (= (dl-not 1.0) 0.0)))
(check "soft compose = noisy-or over z" (< (abs (- (dl-or 0.25 0.25) (- 1.0 (* 0.75 0.75)))) 1e-15))

;; ── family one: the training KB ──
;;        ann - bob - cid - dan
;;              bob - eli
;;        ann = spouse of fox; cid and eli are siblings
(define kb1 (make-kb))
(kb-assert! kb1 (make-fact 'parent 'ann 'bob))
(kb-assert! kb1 (make-fact 'parent 'bob 'cid))
(kb-assert! kb1 (make-fact 'parent 'bob 'eli))
(kb-assert! kb1 (make-fact 'parent 'cid 'dan))
(kb-assert! kb1 (make-fact 'spouse 'ann 'fox))
(kb-assert! kb1 (make-fact 'spouse 'fox 'ann))
(kb-assert! kb1 (make-fact 'sibling 'cid 'eli))
(kb-assert! kb1 (make-fact 'sibling 'eli 'cid))
(define dom1 (dl-domain-from-kb kb1 '(parent spouse sibling)))
(check "domain from the KB" (= (dl-domain-size dom1) 6))
(define (base-of kb dom) (list (cons 'parent (dl-relation-from-kb dom kb 'parent))
                               (cons 'spouse (dl-relation-from-kb dom kb 'spouse))
                               (cons 'sibling (dl-relation-from-kb dom kb 'sibling))))
(define base1 (base-of kb1 dom1))

;; target grandparent relation: exactly parent o parent
(define gp-true1 (dl-compose dom1 (dl-valuation-ref base1 'parent) (dl-valuation-ref base1 'parent)))

;; ── learn grandparent(x, y) <- P(x, z), Q(z, y) ──
(define gp-prog (make-dl-program '(parent spouse sibling) '((grandparent chain))))
(check "program parameter count" (= (dl-program-param-count gp-prog) 6))
(define (gp-loss theta)
  (dl-cross-entropy (dl-valuation-ref (dl-forward-chain theta gp-prog dom1 base1 1) 'grandparent) gp-true1))

;; exact gradient check at a non-symmetric point
(define theta-probe (vector 0.3 -0.2 0.1 -0.4 0.2 0.05))
(define g-rev (gradient gp-loss theta-probe))
(check "rule application: gradient is non-trivial" (> (vmaxabs-diff g-rev (make-vector 6 0.0)) 1e-2))
(check "rule application: reverse == forward (1e-10)" (< (vmaxabs-diff g-rev (forward-gradient gp-loss theta-probe)) 1e-10))

(define theta-gp (dl-program-init-params gp-prog))
(define gp-loss0 (gp-loss theta-gp))
(sgd! theta-gp gp-loss 120 0.5)
(check "grandparent: training lowers the loss 20x" (< (gp-loss theta-gp) (/ gp-loss0 20.0)))
(define gp-rule (car (dl-extract-rules theta-gp gp-prog)))
(display "learned: ") (display gp-rule) (newline)
(check "grandparent: learned clause is parent o parent"
       (equal? (car gp-rule) '((grandparent ?x ?y) <- (parent ?x ?z) (parent ?z ?y))))
(check "grandparent: rule confidence > 0.9" (> (cdr gp-rule) 0.9))

;; ── family two: never seen in training ──
(define kb2 (make-kb))
(kb-assert! kb2 (make-fact 'parent 'gil 'hal))
(kb-assert! kb2 (make-fact 'parent 'hal 'ivy))
(kb-assert! kb2 (make-fact 'parent 'hal 'jon))
(kb-assert! kb2 (make-fact 'parent 'jon 'kim))
(kb-assert! kb2 (make-fact 'parent 'kim 'lee))
(kb-assert! kb2 (make-fact 'spouse 'gil 'mae))
(kb-assert! kb2 (make-fact 'spouse 'mae 'gil))
(kb-assert! kb2 (make-fact 'sibling 'ivy 'jon))
(kb-assert! kb2 (make-fact 'sibling 'jon 'ivy))
(define dom2 (dl-domain-from-kb kb2 '(parent spouse sibling)))
(define base2 (base-of kb2 dom2))
(define gp2 (dl-valuation-ref (dl-forward-chain theta-gp gp-prog dom2 base2 1) 'grandparent))
(define gp-true2 (dl-compose dom2 (dl-valuation-ref base2 'parent) (dl-valuation-ref base2 'parent)))
(check "held-out family: every grandparent atom decided correctly at 0.5"
       (equal? (dl-true-atoms dom2 gp2 'grandparent 0.5) (dl-true-atoms dom2 gp-true2 'grandparent 0.5)))
(check "held-out family: four grandparent atoms" (= (length (dl-true-atoms dom2 gp2 'grandparent 0.5)) 4))

;; derived atoms go back into the KB and the exact engine answers from them
(check "assert derived atoms into the KB" (= (dl-assert-derived! kb2 dom2 gp2 'grandparent 0.5) 4))
(check "re-asserting adds nothing" (= (dl-assert-derived! kb2 dom2 gp2 'grandparent 0.5) 0))
(define who (kb-query kb2 '(grandparent hal ?g)))
(check "engine: grandchildren of hal are kim" (and (= (length who) 1) (eq? (walk '?g (car who)) 'kim)))

;; ── recursion: ancestor <- P ; ancestor <- Q o R, with ancestor a candidate ──
(define anc-prog (make-dl-program '(parent spouse ancestor) '((ancestor copy) (ancestor chain))))
(define (closure dom r)
  (let loop ((acc r) (k 0))
    (if (< k (dl-domain-size dom)) (loop (dl-disjoin acc (dl-compose dom acc r)) (+ k 1)) acc)))
(define base1a (list (cons 'parent (dl-valuation-ref base1 'parent)) (cons 'spouse (dl-valuation-ref base1 'spouse))))
(define anc-true1 (closure dom1 (dl-valuation-ref base1 'parent)))
(define (anc-loss theta)
  (dl-cross-entropy (dl-valuation-ref (dl-forward-chain theta anc-prog dom1 base1a 3) 'ancestor) anc-true1))
(define theta-anc (dl-program-init-params anc-prog))
(define anc-loss0 (anc-loss theta-anc))
(sgd! theta-anc anc-loss 150 0.5)
(check "ancestor: training lowers the loss 20x" (< (anc-loss theta-anc) (/ anc-loss0 20.0)))
(define anc-rules (dl-extract-rules theta-anc anc-prog))
(display "learned: ") (display anc-rules) (newline)
(check "ancestor: base clause is parent" (equal? (car (car anc-rules)) '((ancestor ?x ?y) <- (parent ?x ?y))))
(define rec-clause (car (cadr anc-rules)))
(check "ancestor: recursive clause is parent o ancestor or ancestor o parent"
       (or (equal? rec-clause '((ancestor ?x ?y) <- (parent ?x ?z) (ancestor ?z ?y)))
           (equal? rec-clause '((ancestor ?x ?y) <- (ancestor ?x ?z) (parent ?z ?y)))))
;; the learned recursive program on the deeper held-out family (depth 4)
(define base2a (list (cons 'parent (dl-valuation-ref base2 'parent)) (cons 'spouse (dl-valuation-ref base2 'spouse))))
(define anc2 (dl-valuation-ref (dl-forward-chain theta-anc anc-prog dom2 base2a 5) 'ancestor))
(check "held-out family: ancestor closure decided correctly at 0.5"
       (equal? (dl-true-atoms dom2 anc2 'ancestor 0.5)
               (dl-true-atoms dom2 (closure dom2 (dl-valuation-ref base2 'parent)) 'ancestor 0.5)))

(check "no finite differences anywhere" (= (ad-finite-difference-evals) 0))

(newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0) (begin (display "ALL TESTS PASSED") (newline)))
