;; core.ml.hnsw — approximate nearest neighbours: exact answers on small sets,
;; recall against the linear scan on a larger random set, both metrics, the
;; dimension guard, and nearest-fact queries over a knowledge base.

(require core.ml.hnsw)

(define pass-count 0)
(define fail-count 0)
(define (check name ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display name) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display name) (newline))))

;; deterministic points
(define seed 42)
(define (rand!)
  (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648))
  (- (/ (exact->inexact seed) 1073741824.0) 1.0))
(define (rand-vec n) (let ((v (make-vector n 0.0))) (let loop ((i 0)) (if (< i n) (begin (vector-set! v i (rand!)) (loop (+ i 1))) v))))

;; small exact case
(define small (make-hnsw 2 'l2))
(hnsw-insert! small (vector 0.0 0.0) 'origin)
(hnsw-insert! small (vector 1.0 0.0) 'east)
(hnsw-insert! small (vector 0.0 1.0) 'north)
(hnsw-insert! small (vector 5.0 5.0) 'far)
(check "count" (= (hnsw-count small) 4))
(check "nearest to (0.9, 0.1) is east" (eq? (car (car (hnsw-search small (vector 0.9 0.1) 1 8))) 'east))
(check "squared distance reported" (< (abs (- (cdr (car (hnsw-search small (vector 0.9 0.1) 1 8))) 0.02)) 1e-12))
(check "k = 3, nearest first" (equal? (map car (hnsw-search small (vector 0.2 0.1) 3 8)) '(origin east north)))
(check "empty index answers nothing" (null? (hnsw-search (make-hnsw 2 'l2) (vector 0.0 0.0) 3 8)))
(check "dimension guard" (guard (e (#t #t)) (hnsw-insert! small (vector 1.0) 'bad) #f))

;; recall@10 against the linear scan: 400 points in 8 dimensions
(define idx (make-hnsw 8 'l2 8 64))
(let loop ((i 0)) (if (< i 400) (begin (hnsw-insert! idx (rand-vec 8) i) (loop (+ i 1)))))
(define (recall-at q k ef)
  (let ((approx (map car (hnsw-search idx q k ef)))
        (exact (map car (hnsw-brute-force idx q k))))
    (/ (length (filter (lambda (p) (memv p exact)) approx)) (exact->inexact k))))
(define queries (let loop ((i 0) (acc '())) (if (< i 30) (loop (+ i 1) (cons (rand-vec 8) acc)) acc)))
(define mean-recall (/ (apply + (map (lambda (q) (recall-at q 10 64)) queries)) 30.0))
(display "mean recall@10 (ef 64): ") (display mean-recall) (newline)
(check "recall@10 >= 0.95" (>= mean-recall 0.95))
(check "an indexed point finds itself at distance 0"
       (let ((r (car (hnsw-search idx (hnsw-vector idx 123) 1 32)))) (and (= (car r) 123) (= (cdr r) 0.0))))

;; cosine metric
(define cidx (make-hnsw 3 'cosine))
(hnsw-insert! cidx (vector 1.0 0.0 0.0) 'x)
(hnsw-insert! cidx (vector 0.0 1.0 0.0) 'y)
(hnsw-insert! cidx (vector 0.0 0.0 1.0) 'z)
(check "cosine ignores scale" (eq? (car (car (hnsw-search cidx (vector 0.0 7.0 0.5) 1 8))) 'y))

;; nearest facts of a knowledge base
(define kb (make-kb))
(kb-assert! kb (make-fact 'at 'paris 48.86 2.35))
(kb-assert! kb (make-fact 'at 'london 51.51 -0.13))
(kb-assert! kb (make-fact 'at 'rome 41.90 12.50))
(kb-assert! kb (make-fact 'at 'madrid 40.42 -3.70))
(define geo (make-hnsw 2 'l2))
(check "indexes every fact" (= (hnsw-index-kb! geo kb 'at 3 (lambda (f) (vector (caddr f) (cadddr f)))) 4))
(check "nearest fact to Brussels is Paris then London"
       (equal? (map cadr (kb-query-nearest geo (vector 50.85 4.35) 2)) '(paris london)))

(newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0) (begin (display "ALL TESTS PASSED") (newline)))
