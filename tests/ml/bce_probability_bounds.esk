(define p (make-tensor '(1) 1.0))
(define y (make-tensor '(1) 0.0))
(define (check predictions targets expected)
  (let ((a (bce-loss predictions targets))
        (b (binary-cross-entropy-loss predictions targets)))
    (and (= a b) (< (abs (- a expected)) 1e-9))))
(display (if (and (check p y (- (log (- 1.0 (- 1.0 1e-7)))))
                  (check y p (- (log 1e-7))))
             "PASS bce_probability_bounds" "FAIL bce_probability_bounds"))
(newline)
