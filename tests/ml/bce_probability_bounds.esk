(define p (make-tensor '(1) 1.0))
(define y (make-tensor '(1) 0.0))
(define nan-prediction (make-tensor '(1) (/ 0.0 0.0)))
(define nan-pair (make-tensor '(2) 0.5))
(tensor-set! nan-pair 1 (/ 0.0 0.0))
(define pair-targets #(1.0 0.0))
(define (check predictions targets expected)
  (let ((a (bce-loss predictions targets))
        (b (binary-cross-entropy-loss predictions targets)))
    (and (= a b) (< (abs (- a expected)) 1e-9))))
(define (check-nan predictions targets)
  (and (nan? (bce-loss predictions targets))
       (nan? (binary-cross-entropy-loss predictions targets))))
(display (if (and (check p y (- (log (- 1.0 (- 1.0 1e-7)))))
                  (check y p (- (log 1e-7)))
                  (check-nan nan-prediction y)
                  (check-nan nan-prediction p)
                  (check-nan nan-pair pair-targets))
             "PASS bce_probability_bounds" "FAIL bce_probability_bounds"))
(newline)
