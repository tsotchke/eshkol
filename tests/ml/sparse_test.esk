;; core.ml.sparse — CSR matrices: construction (duplicates summed, zeros not
;; stored), lookup, products and sums against dense arithmetic, transpose,
;; and exact gradients with respect to the stored values.

(require core.ml.sparse)

(define pass-count 0)
(define fail-count 0)
(define (check name ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display name) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display name) (newline))))
(define (vclose? a b)
  (and (= (vector-length a) (vector-length b))
       (let loop ((i 0)) (or (= i (vector-length a)) (and (< (abs (- (vector-ref a i) (vector-ref b i))) 1e-12) (loop (+ i 1)))))))
(define (mclose? a b) (let loop ((i 0)) (or (= i (vector-length a)) (and (vclose? (vector-ref a i) (vector-ref b i)) (loop (+ i 1))))))
(define (dense-matvec m x)
  (let ((y (make-vector (vector-length m) 0.0)))
    (let li ((i 0)) (if (< i (vector-length m)) (begin (vector-set! y i (let lj ((j 0) (s 0.0)) (if (< j (vector-length x)) (lj (+ j 1) (+ s (* (vector-ref (vector-ref m i) j) (vector-ref x j)))) s))) (li (+ i 1))) y))))
(define (dense-matmul a b)
  (let* ((n (vector-length a)) (p (vector-length (vector-ref b 0))) (out (make-vector n #f)))
    (let li ((i 0))
      (if (< i n)
          (let ((row (make-vector p 0.0)))
            (let lj ((j 0)) (if (< j p) (begin (vector-set! row j (let lk ((k 0) (s 0.0)) (if (< k (vector-length b)) (lk (+ k 1) (+ s (* (vector-ref (vector-ref a i) k) (vector-ref (vector-ref b k) j)))) s))) (lj (+ j 1)))))
            (vector-set! out i row) (li (+ i 1)))
          out))))

(define s (sparse-from-triplets 3 4 '((0 0 2.0) (1 2 -1.0) (2 1 4.0) (0 3 1.5) (1 2 0.5) (2 3 -2.0))))
(check "duplicates summed" (= (sparse-ref s 1 2) -0.5))
(check "nnz counts distinct entries" (= (sparse-nnz s) 5))
(check "missing entry reads 0" (= (sparse-ref s 0 1) 0.0))
(check "range guard" (guard (e (#t #t)) (sparse-ref s 3 0) #f))
(define d (sparse->dense s))
(check "dense round trip" (equal? (sparse->triplets (sparse-from-dense d)) (sparse->triplets s)))
(check "zeros are not stored" (= (sparse-nnz (sparse-from-dense (vector (vector 0.0 1.0) (vector 0 0.0)))) 1))
(define x (vector 1.0 -2.0 0.5 3.0))
(check "matvec = dense matvec" (vclose? (sparse-matvec s x) (dense-matvec d x)))
(check "transpose" (mclose? (sparse->dense (sparse-transpose (sparse-transpose s))) d))
(check "transpose shape" (and (= (sparse-rows (sparse-transpose s)) 4) (= (sparse-cols (sparse-transpose s)) 3)))
(define p (sparse-matmul s (sparse-transpose s)))
(check "matmul = dense matmul" (mclose? (sparse->dense p) (dense-matmul d (sparse->dense (sparse-transpose s)))))
(check "identity is neutral" (mclose? (sparse->dense (sparse-matmul (sparse-identity 3) s)) d))
(check "add and scale" (mclose? (sparse->dense (sparse-add s (sparse-scale -1.0 s))) (sparse->dense (sparse-from-triplets 3 4 '()))))

;; gradients with respect to the stored values: d(u . S x)/d s_k = u_i x_j
(define u (vector 0.3 -1.0 2.0))
(define (loss vals) (let ((y (sparse-matvec (sparse-with-values s vals) x)))
                      (let loop ((i 0) (acc 0.0)) (if (< i 3) (loop (+ i 1) (+ acc (* (vector-ref u i) (vector-ref y i)))) acc))))
(define g (gradient loss (sparse-values s)))
(check "gradient wrt nonzeros = u_i x_j"
       (vclose? g (list->vector (map (lambda (t) (* (vector-ref u (car t)) (vector-ref x (cadr t)))) (sparse->triplets s)))))
(define (loss2 vals) (let ((m (sparse-matmul (sparse-with-values s vals) (sparse-transpose (sparse-with-values s vals)))))
                       (let loop ((k 0) (acc 0.0)) (if (< k (sparse-nnz m)) (loop (+ k 1) (+ acc (* (vector-ref (sparse-values m) k) (vector-ref (sparse-values m) k)))) acc))))
(define g2 (gradient loss2 (sparse-values s)))
(define g2f (let ((v (sparse-values s)) (r (make-vector (sparse-nnz s) 0.0)))
              (let loop ((k 0))
                (if (< k (sparse-nnz s))
                    (begin (vector-set! r k (derivative (lambda (t) (let ((w (vector-map (lambda (z) z) v))) (vector-set! w k (+ (vector-ref v k) t)) (loss2 w))) 0.0))
                           (loop (+ k 1)))
                    r))))
(check "gradient through S S^T: reverse == forward" (vclose? g2 g2f))
(check "no finite differences" (= (ad-finite-difference-evals) 0))

(newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0) (begin (display "ALL TESTS PASSED") (newline)))
