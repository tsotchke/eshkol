(require stdlib)
(define passed 0) (define failed 0)
(define (check name ok) (if ok (set! passed (+ passed 1))
  (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (e (else #t)) (thunk) #f))
(define (oracle x y) (+ (* x y) (* x x)))
(define point (vector 2 3))
(define s (differentiate 'incremental (lambda (x y) (+ (* x y) (* x x))) point))
(vector-set! point 0 999)
(check "initializer owns its inputs" (= (s 'output #f) 10))
(define delta (vector 1 2))
(define result (s 'step delta))
(define successor (vector-ref result 0))
(vector-set! delta 0 999)
(check "finite product cross terms" (= (successor 'output #f) (oracle 3 5)))
(check "finite output change" (= (vector-ref result 1) 14))
(check "successor owns its input delta" (= (successor 'output #f) 24))
(check "original state persists" (= (s 'output #f) 10))
(check "all affected kernels once" (= (vector-ref (vector-ref result 2) 0) 3))
(define receipt (vector-ref result 2))
(vector-set! receipt 0 999)
(define receipt-copy (successor 'work #f))
(check "step work receipt is owned" (= (vector-ref receipt-copy 0) 3))
(vector-set! receipt-copy 0 998)
(check "state work receipt is owned" (= (vector-ref (successor 'work #f) 0) 3))
(define info (s 'info #f))
(check "topology and repeated edges" (and (= (vector-ref info 0) 5) (= (vector-ref info 1) 6)
  (= (vector-ref info 2) 2) (= (vector-ref info 3) 3)))
(vector-set! info 0 999)
(check "topology receipt is owned" (= (vector-ref (s 'info #f) 0) 5))
(define branch (vector-ref (s 'step (vector -1 4)) 0))
(check "forks are independent" (and (= (branch 'output #f) 8) (= (successor 'output #f) 24) (= (s 'output #f) 10)))
(define zero (successor 'step (vector 0 0)))
(check "zero tick has no kernels or trie copies" (and (= (vector-ref (vector-ref zero 2) 0) 0)
  (= (vector-ref (vector-ref zero 2) 3) 0) (= (vector-ref (vector-ref zero 2) 5) 2)))

;; Independent batch oracle after every prefix, exact rational finite changes.
(let prefixes ((i 0) (x 2) (y 3) (state s) (total 10))
  (if (< i 96)
    (let* ((dx (/ (- (modulo i 5) 2) 7)) (dy (/ (- (modulo i 7) 3) 11))
           (nx (+ x dx)) (ny (+ y dy)) (step (state 'step (vector dx dy)))
           (next (vector-ref step 0)) (change (vector-ref step 1)) (fresh (oracle nx ny)))
      (check "every prefix agrees with fresh batch" (= (next 'output #f) fresh))
      (check "finite deltas telescope exactly" (= (+ total change) fresh))
      (check "exact arithmetic remains exact" (and (exact? change) (exact? (next 'output #f))))
      (check "prior prefix remains readable" (= (state 'output #f) (oracle x y)))
      (prefixes (+ i 1) nx ny next (+ total change)))))

(define cancellation (differentiate 'incremental (lambda (x y) (+ (- x x) (* y y))) (vector 7 3)))
(define cancelled (cancellation 'step (vector 9 0)))
(check "unchanged intermediate prunes downstream" (and (= (vector-ref (vector-ref cancelled 2) 0) 1)
  (= (vector-ref cancelled 1) 0) (= ((vector-ref cancelled 0) 'output #f) 9)))
(define f64 (differentiate 'incremental (lambda (x) (+ x 1.0)) (vector 1e20)))
(define f64-next (f64 'step (vector -1e20)))
(check "fresh floating snapshot survives output-delta cancellation" (= ((vector-ref f64-next 0) 'output #f) 1.0))
(check "old floating snapshot persists" (= (f64 'output #f) (+ 1e20 1.0)))
(define identity (differentiate 'incremental (lambda (x) x) (vector -0.0)))
(check "initial signed zero retained" (eqv? (identity 'output #f) -0.0))
(check "signed zero change retained" (eqv? ((vector-ref (identity 'step (vector 0.0)) 0) 'output #f) 0.0))
(define promotion (differentiate 'incremental (lambda (x) (* x x)) (vector 2)))
(check "equal numeric input promotion propagates" (not (exact? ((vector-ref (promotion 'step (vector 0.0)) 0) 'output #f))))

(define ratio (differentiate 'incremental (lambda (x y) (/ x y)) (vector 4 2)))
(check "zero denominator fails" (raises? (lambda () (ratio 'step (vector 1 -2)))))
(check "failed update leaves source state usable" (and (= (ratio 'output #f) 2)
  (= ((vector-ref (ratio 'step (vector 0 1)) 0) 'output #f) 4/3)))
(check "partially applied bad delta fails atomically" (and
  (raises? (lambda () (s 'step (vector 1 +inf.0)))) (= (s 'output #f) 10)))
(check "nonfinite initialization refuses" (raises? (lambda ()
  (differentiate 'incremental (lambda (x) (* x x)) (vector 1e200)))))
(define overflow (differentiate 'incremental (lambda (x) (* x x)) (vector 1e150)))
(check "nonfinite arithmetic fails atomically" (and (raises? (lambda () (overflow 'step (vector 1e200))))
  (= (overflow 'output #f) (* 1e150 1e150))))
(define change-overflow (differentiate 'incremental (lambda (x) (* x 1e308)) (vector -1)))
(check "nonfinite output change fails atomically" (and (raises? (lambda () (change-overflow 'step (vector 2))))
  (= (change-overflow 'output #f) -1e308)))
(check "delta width refuses" (raises? (lambda () (s 'step (vector 1)))))
(check "nonvector delta refuses" (raises? (lambda () (s 'step 7))))
(check "nonnumeric delta refuses" (raises? (lambda () (s 'step (vector 1 "bad")))))
(check "complex delta refuses" (raises? (lambda () (s 'step (vector 1 2+3i)))))
(check "active AD values refuse persistent storage" (raises? (lambda ()
  (gradient (lambda (v) (differentiate 'incremental (lambda (x) x) v) 1) (vector 1.0)))))
(check "unknown state action refuses" (raises? (lambda () (s 'private #f))))
(check "initializer width refuses" (raises? (lambda ()
  (differentiate 'incremental (lambda (x y) (+ x y)) (vector 1)))))
(check "unused partial expression still evaluates" (raises? (lambda ()
  (differentiate 'incremental (lambda (x) (let ((unused (/ 1 x))) 5)) (vector 0)))))
(define huge (expt 2 1200))
(define big (differentiate 'incremental (lambda (x) (+ x 1)) (vector huge)))
(check "large exact inputs need no double conversion" (and (exact? (big 'output #f))
  (= ((vector-ref (big 'step (vector 1)) 0) 'output #f) (+ huge 2))))
(define __ig_point (vector 3))
(define collision (differentiate 'incremental (lambda (__ig_context) (* __ig_context __ig_context)) __ig_point))
(check "generated names cannot capture caller point" (= (collision 'output #f) 9))
(check "lexical marker spelling cannot rename incremental mode"
  (let ((__eshkol_graph_incremental (lambda (function point) 99)))
    (= ((differentiate 'incremental (lambda (x) (* x x)) (vector 3)) 'output #f) 9)))
(define (inside point) (differentiate 'incremental (lambda (x) (+ x 3)) point))
(check "initializer inside user function" (= ((inside (vector 2)) 'output #f) 5))
(define-syntax graph-square (syntax-rules () ((_ x) (* x x))))
(define-syntax graph-incremental (syntax-rules () ((_ f point) (differentiate 'incremental f point))))
(check "macro may generate incremental interpretation" (= ((graph-incremental (lambda (x) (* x x)) (vector 4)) 'output #f) 16))
(define macro-state (differentiate 'incremental (lambda (x) (graph-square x)) (vector 4)))
(check "macro expansion precedes graph extraction" (= ((vector-ref (macro-state 'step (vector 1)) 0) 'output #f) 25))
(define escaped (with-region 'compiler-incremental
  (differentiate 'incremental (lambda (x y) (+ (* x y) (* x x))) (vector 2/3 5/7))))
(with-region 'clobber (make-vector 10000 99))
(check "persistent state survives initializer region" (= (escaped 'output #f) (oracle 2/3 5/7)))
(define escaped-next (with-region 'compiler-incremental-step (vector-ref (escaped 'step (vector 1/11 2/13)) 0)))
(with-region 'clobber-again (make-vector 10000 98))
(check "successor survives step region" (= (escaped-next 'output #f) (oracle (+ 2/3 1/11) (+ 5/7 2/13))))
(check "history survives successor region" (= (escaped 'output #f) (oracle 2/3 5/7)))
(display "Passed: ") (display passed) (display " Failed: ") (display failed) (newline)
(if (> failed 0) (begin (display "RESULT: FAIL\n") (exit 1))) (display "RESULT: PASS\n")
