;; core.net on the SOCKET lease layer: byte-counted TCP and UDP, partial
;; writes against a slow peer, peer reset, deadlines, cancellation, shutdown,
;; truncation, guaranteed close on return and exception, a constant descriptor
;; count across 1,000 cycles, and network capability checks. Continuation exits
;; are covered by net_scope_continuation_test.esk.
(require stdlib)
(require core.net)
(require core.threads)

(define failures 0)
(define (check value label)
  (if value #t
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display label) (newline))))
(define (reason? value reason)
  (and (network-error? value) (eq? (network-error-reason value) reason)))
(define (fill! bv seed)
  (let loop ((i 0))
    (if (< i (bytevector-length bv))
        (begin (bytevector-u8-set! bv i (modulo (+ seed (* i 7) (quotient i 509)) 256))
               (loop (+ i 1))))))
;; Content comparison of two bytevectors, byte by byte.
(define (bytes=? a b)
  (and (= (bytevector-length a) (bytevector-length b))
       (let loop ((i 0))
         (or (= i (bytevector-length a))
             (and (= (bytevector-u8-ref a i) (bytevector-u8-ref b i)) (loop (+ i 1)))))))
(define (descriptor-count)
  (length (directory-list (if (file-exists? "/proc/self/fd") "/proc/self/fd" "/dev/fd"))))

;; ── TCP round trip with byte-counted I/O ──────────────────────────────
(define listener (tcp-listen "127.0.0.1" 0))
(check (not (network-error? listener)) "listen")
(define port (net-local-port listener))
(define client (tcp-connect "127.0.0.1" port 1000))
(define server (tcp-accept listener 1000))
(check (and (not (network-error? client)) (not (network-error? server))) "connect and accept")
(define out (make-bytevector 64 0))
(define in (make-bytevector 64 0))
(fill! out 3)
(check (= (tcp-write! client out 8 32 1000) 32) "byte-counted write of a range")
(check (= (tcp-read! server in 0 32 1000) 32) "byte-counted read into a range")
(check (let loop ((i 0))
         (or (= i 32) (and (= (bytevector-u8-ref in i) (bytevector-u8-ref out (+ i 8)))
                           (loop (+ i 1)))))
       "round trip preserves the range")
(check (reason? (tcp-read! server in 60 8 0) 'invalid) "a range past the end is refused")
(check (reason? (tcp-read! server in 0 0 0) 'invalid) "an empty read is refused")

;; ── Deadlines ──────────────────────────────────────────────────────────
(define t0 (current-time-ms))
(check (reason? (tcp-read! server in 0 8 150) 'timeout) "idle read reaches its deadline")
(define waited (- (current-time-ms) t0))
(check (and (>= waited 140) (< waited 2000)) "read deadline is honoured")
(check (reason? (tcp-accept listener 50) 'timeout) "idle accept reaches its deadline")

;; ── Cancellation ───────────────────────────────────────────────────────
(check (= (net-cancel! server) 0) "cancel with no operation in flight")
(define t1 (current-time-ms))
(check (reason? (tcp-read! server in 0 8 10000) 'cancelled) "the next wait observes cancellation")
(check (< (- (current-time-ms) t1) 2000) "cancellation does not wait for the deadline")
(check (reason? (tcp-read! server in 0 8 20) 'timeout) "cancellation is consumed once")
(define canceller
  (make-thread (lambda () (sleep-ms 150) (net-cancel! listener))))
(define t2 (current-time-ms))
(check (reason? (tcp-accept listener 20000) 'cancelled) "another thread cancels a blocked accept")
(check (< (- (current-time-ms) t2) 5000) "the blocked accept wakes promptly")
(thread-join canceller)

;; ── Shutdown ───────────────────────────────────────────────────────────
(check (= (tcp-shutdown client 'write) 0) "shut down the write direction")
(check (eof-object? (tcp-read! server in 0 8 1000)) "peer reads end of stream")
(check (= (tcp-write! server out 0 4 1000) 4) "peer still writes back")
(check (= (tcp-read! client in 0 4 1000) 4) "half-closed side still reads")
(check (reason? (tcp-shutdown client 'sideways) 'invalid) "unknown direction refused")
(tcp-close client)
(tcp-close server)

;; ── Partial writes against a slow peer ─────────────────────────────────
(define total (* 16 1024 1024))
(define payload (make-bytevector total 0))
(define received (make-bytevector total 0))
(fill! payload 11)
(define slow-client (tcp-connect "127.0.0.1" port 1000))
(define slow-server (tcp-accept listener 1000))
(define first-write (tcp-write! slow-client payload 0 total 1000))
(check (and (integer? first-write) (> first-write 0) (< first-write total))
       "a large write to a slow peer is partial")
(define (offer sent)
  (let ((n (tcp-write! slow-client payload sent (- total sent) 0)))
    (if (network-error? n) (cons sent n) (if (= (+ sent n) total) (cons total #f) (offer (+ sent n))))))
(define offered (offer first-write))
(check (reason? (cdr offered) 'timeout) "a zero deadline on a full stream reports would-block")
(define (drain sent got)
  (if (< got total)
      (let* ((want (min 262144 (- total got)))
             (n (tcp-read! slow-server received got want 5000)))
        (if (or (network-error? n) (eof-object? n))
            got
            (let* ((now (+ got n))
                   (more (if (< sent total) (tcp-write! slow-client payload sent (- total sent) 0) 0))
                   (sent2 (if (network-error? more) sent (+ sent more))))
              (drain sent2 now))))
      got))
(check (= (drain (car offered) 0) total) "the slow reader receives every byte")
(check (bytes=? received payload) "slow-peer stream preserves every byte in order")
(tcp-close slow-client)
(tcp-close slow-server)

;; ── Peer reset ─────────────────────────────────────────────────────────
(define reset-client (tcp-connect "127.0.0.1" port 1000))
(define reset-server (tcp-accept listener 1000))
(check (= (tcp-write! reset-client out 0 6 1000) 6) "send bytes the peer never reads")
(sleep-ms 50)
(tcp-close reset-server)
(check (reason? (tcp-read! reset-client in 0 8 2000) 'reset) "read after a peer reset reports reset")
(define (write-until-error n)
  (let ((r (tcp-write! reset-client out 0 6 1000)))
    (if (or (network-error? r) (= n 0)) r (write-until-error (- n 1)))))
(check (reason? (write-until-error 4) 'reset) "write after a peer reset reports reset")
(tcp-close reset-client)

;; ── Guaranteed close on every exit path ────────────────────────────────
(define seen #f)
(define normal (call-with-tcp-listener "127.0.0.1" 0 (lambda (l) (set! seen l) 'value)))
(check (eq? normal 'value) "normal return carries the receiver value")
(check (reason? (tcp-close seen) 'invalid) "normal return closed the listener")
(define raised
  (guard (e ((symbol? e) e))
    (call-with-tcp-listener "127.0.0.1" 0 (lambda (l) (set! seen l) (raise 'boom)))))
(check (eq? raised 'boom) "the original exception propagates")
(check (reason? (tcp-close seen) 'invalid) "an exception closed the listener")
(check (reason? (call-with-tcp-connection "127.0.0.1" 1 1000 (lambda (c) 'never)) 'refused)
       "a failed acquisition returns its error without calling proc")

;; ── 1,000 cycles keep the descriptor count constant ────────────────────
(define ping (make-bytevector 4 7))
(define pong (make-bytevector 4 0))
(define (cycles n ok)
  (if (= n 0) ok
      (cycles (- n 1)
        (and ok
             (eqv? 4 (call-with-tcp-connection "127.0.0.1" port 1000
                       (lambda (c)
                         (call-with-tcp-accept listener 1000
                           (lambda (s)
                             (tcp-write! c ping 0 4 1000)
                             (tcp-read! s pong 0 4 1000))))))))))
(define fds-before (descriptor-count))
(check (cycles 1000 #t) "1,000 scoped connect/accept/transfer cycles")
(check (= (descriptor-count) fds-before) "descriptor count is unchanged after 1,000 cycles")
(tcp-close listener)
(display "PASS: TCP leases") (newline)

;; ── UDP round trip and truncation ──────────────────────────────────────
(define u0 (udp-bind "127.0.0.1" 0))
(define u1 (udp-bind "127.0.0.1" 0))
(define p0 (net-local-port u0))
(define p1 (net-local-port u1))
(define dgram (make-bytevector 1200 0))
(define inbox (make-bytevector 1200 0))
(fill! dgram 5)
(check (= (udp-send-to! u0 "127.0.0.1" p1 dgram 100 1000 1000) 1000) "datagram send of a range")
(define got (udp-receive-from! u1 inbox 0 1200 1000))
(check (and (vector? got) (= (vector-ref got 0) 1000) (not (vector-ref got 2))) "datagram receive")
(check (equal? (vector-ref got 1) (string-append "127.0.0.1:" (number->string p0))) "datagram sender")
(check (= (udp-send-to! u0 "127.0.0.1" p1 dgram 0 1200 1000) 1200) "large datagram send")
(define cut (udp-receive-from! u1 inbox 0 16 1000))
(check (and (vector? cut) (= (vector-ref cut 0) 16) (eq? (vector-ref cut 2) #t))
       "a datagram beyond capacity reports truncation")
(check (= (bytevector-u8-ref inbox 15) (bytevector-u8-ref dgram 15)) "truncation keeps the prefix")
(check (reason? (udp-receive-from! u1 inbox 0 16 0) 'timeout) "the truncated datagram was consumed")
(check (reason? (udp-recvfrom u1 2 0) 'timeout) "nothing else is queued")
(udp-send-to! u0 "127.0.0.1" p1 dgram 0 64 1000)
(check (reason? (udp-recvfrom u1 2 1000) 'truncated) "the string receive refuses truncation explicitly")
(check (reason? (tcp-close u0) 'invalid) "TCP close refuses a UDP handle")
(check (= (udp-close u0) 0) "UDP close")
(check (= (call-with-udp-socket "127.0.0.1" 0 (lambda (u) (udp-close u1))) 0) "scoped UDP socket")
(display "PASS: UDP leases") (newline)

;; ── Network capability ─────────────────────────────────────────────────
(capability-install-policy! '())
(check (guard (e (#t #t)) (tcp-listen "127.0.0.1" 0) #f) "network capability denied for listen")
(check (guard (e (#t #t)) (call-with-tcp-connection "127.0.0.1" 1 100 (lambda (c) c)) #f)
       "network capability denied for scoped connect")
(capability-clear-policy!)

(if (= failures 0)
    (begin (display "RESULT: PASS") (newline))
    (begin (display "RESULT: FAIL") (newline) (exit 1)))
