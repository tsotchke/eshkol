; VM-only regression for loaded-source prescans and canonical load identity.
(define loaded-count 0)
(load "fixtures/vm_load_semantics_module.esk")
(if (and (= (loaded-even? 10) #t)
         (= loaded-redefined-value 3)
         (= (loaded-read-boxed) 3))
    (display "PASS: loaded prescan and redefinition")
    (display "FAIL: loaded prescan and redefinition"))
(if (= loaded-count 1)
    (display "PASS: entry cycle protection")
    (display "FAIL: entry cycle protection"))
(define long-load-count 0)
(load "fixtures/long_module_path_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/submodule_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/effect.esk")
(load "./fixtures/long_module_path_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/submodule_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/effect.esk")
(if (= long-load-count 1)
    (display "PASS: long canonical load identity")
    (display "FAIL: long canonical load identity"))
(display "PASS: VM load semantics")
