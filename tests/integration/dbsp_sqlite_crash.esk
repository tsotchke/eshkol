(require stdlib)
(require core.dbsp.sqlite_changefeed)
(define path (getenv "ESHKOL_FEED_FILE"))
(define phase (getenv "ESHKOL_FEED_PHASE"))
(define (template) (make-dbsp-resumable '(x) '((distinct y x)) 'y '() '(crash-v1)))
(define (assert! ok) (if (not ok) (error "Crash recovery invariant failed")))
(define (wait-for-kill marker)
  (display marker) (newline) (flush-output-port (current-output-port))
  (read-char (current-input-port)) (error "Expected the harness to kill this process"))
(with-db path (lambda (db)
  (cond
    ((string=? phase "seed")
     (dbsp-sqlite-create! db "crash" (template))
     (dbsp-sqlite-enqueue! db "crash" 1 (list (list 'x (zset-singleton 'row -2))))
     (dbsp-sqlite-enqueue! db "crash" 2 (list (list 'x (zset-singleton 'row 3)))))
    ((string=? phase "stage")
     (dbsp-sqlite-consume! db "crash" (template) (lambda (seq)
       (assert! (= seq 1))
       ;; Both durable fields have been written, but their transaction is open.
       (assert! (= (dbsp-resumable-tick (dbsp-sqlite-state db "crash" (template))) 1))
       (wait-for-kill "STAGED"))))
    ((string=? phase "recover")
     (assert! (= (dbsp-resumable-tick (dbsp-sqlite-state db "crash" (template))) 0))
     (define step (dbsp-sqlite-consume! db "crash" (template)))
     (assert! (= (dbsp-resumable-tick (vector-ref step 1)) 1))
     (assert! (zset-empty? (dbsp-resumable-output (vector-ref step 1)))))
    ((string=? phase "commit")
     (define step (dbsp-sqlite-consume! db "crash" (template)))
     (assert! (= (dbsp-resumable-tick (vector-ref step 1)) 2))
     (assert! (= (zset-weight (dbsp-resumable-output (vector-ref step 1)) 'row) 1))
     (wait-for-kill "COMMITTED"))
    ((string=? phase "verify")
     (define state (dbsp-sqlite-state db "crash" (template)))
     (assert! (= (dbsp-resumable-tick state) 2))
     (assert! (= (zset-weight (dbsp-resumable-output state) 'row) 1))
     (assert! (eq? (vector-ref (dbsp-sqlite-consume! db "crash" (template)) 0) 'idle))
     (assert! (eq? (dbsp-sqlite-enqueue! db "crash" 2 (list (list 'x (zset-singleton 'row 3)))) 'duplicate)))
    (else (error "Unknown crash fixture phase")))))
(display "RESULT: PASS\n")
