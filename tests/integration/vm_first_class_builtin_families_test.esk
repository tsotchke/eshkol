;;; VM first-class builtin family coverage for SW-38 and SW-39.
;;; Every indirect call is compared with the corresponding direct call in
;;; this same program.  Each builtin is exercised both as an HOF argument and
;;; through a stored binding.

(define failures 0)

(define (check label actual expected)
  (if (equal? actual expected)
      #t
      (begin
        (set! failures (+ failures 1))
        (display (string-append "FAIL: " label)))))

(define (h1 f a) (f a))
(define (h2 f a b) (f a b))

(define (raises? thunk)
  (guard (condition (#t #t))
    (thunk)
    #f))

;; Every branch has at least four elements at every level, so all c[ad]+r
;; accessors through four levels are valid on this shared value.
(define access-leaf (list 1 2 3 4 5))
(define access-l3 (list access-leaf access-leaf access-leaf access-leaf access-leaf))
(define access-l2 (list access-l3 access-l3 access-l3 access-l3 access-l3))
(define access-tree (list access-l2 access-l2 access-l2 access-l2 access-l2))

(define (check-accessor label f stored value direct)
  (check (string-append label " passed") (h1 f value) direct)
  (check (string-append label " stored") (h1 stored value) direct))

(define stored-cadr cadr)
(define stored-cddr cddr)
(define stored-caar caar)
(define stored-caddr caddr)
(define stored-cdar cdar)
(define stored-caaar caaar)
(define stored-caadr caadr)
(define stored-cadar cadar)
(define stored-cdaar cdaar)
(define stored-cdadr cdadr)
(define stored-cddar cddar)
(define stored-cdddr cdddr)
(define stored-caaaar caaaar)
(define stored-caaadr caaadr)
(define stored-caadar caadar)
(define stored-caaddr caaddr)
(define stored-cadaar cadaar)
(define stored-cadadr cadadr)
(define stored-caddar caddar)
(define stored-cadddr cadddr)
(define stored-cdaaar cdaaar)
(define stored-cdaadr cdaadr)
(define stored-cdadar cdadar)
(define stored-cdaddr cdaddr)
(define stored-cddaar cddaar)
(define stored-cddadr cddadr)
(define stored-cdddar cdddar)
(define stored-cddddr cddddr)

(check-accessor "cadr" cadr stored-cadr access-tree (cadr access-tree))
(check-accessor "cddr" cddr stored-cddr access-tree (cddr access-tree))
(check-accessor "caar" caar stored-caar access-tree (caar access-tree))
(check-accessor "caddr" caddr stored-caddr access-tree (caddr access-tree))
(check-accessor "cdar" cdar stored-cdar access-tree (cdar access-tree))
(check-accessor "caaar" caaar stored-caaar access-tree (caaar access-tree))
(check-accessor "caadr" caadr stored-caadr access-tree (caadr access-tree))
(check-accessor "cadar" cadar stored-cadar access-tree (cadar access-tree))
(check-accessor "cdaar" cdaar stored-cdaar access-tree (cdaar access-tree))
(check-accessor "cdadr" cdadr stored-cdadr access-tree (cdadr access-tree))
(check-accessor "cddar" cddar stored-cddar access-tree (cddar access-tree))
(check-accessor "cdddr" cdddr stored-cdddr access-tree (cdddr access-tree))
(check-accessor "caaaar" caaaar stored-caaaar access-tree (caaaar access-tree))
(check-accessor "caaadr" caaadr stored-caaadr access-tree (caaadr access-tree))
(check-accessor "caadar" caadar stored-caadar access-tree (caadar access-tree))
(check-accessor "caaddr" caaddr stored-caaddr access-tree (caaddr access-tree))
(check-accessor "cadaar" cadaar stored-cadaar access-tree (cadaar access-tree))
(check-accessor "cadadr" cadadr stored-cadadr access-tree (cadadr access-tree))
(check-accessor "caddar" caddar stored-caddar access-tree (caddar access-tree))
(check-accessor "cadddr" cadddr stored-cadddr access-tree (cadddr access-tree))
(check-accessor "cdaaar" cdaaar stored-cdaaar access-tree (cdaaar access-tree))
(check-accessor "cdaadr" cdaadr stored-cdaadr access-tree (cdaadr access-tree))
(check-accessor "cdadar" cdadar stored-cdadar access-tree (cdadar access-tree))
(check-accessor "cdaddr" cdaddr stored-cdaddr access-tree (cdaddr access-tree))
(check-accessor "cddaar" cddaar stored-cddaar access-tree (cddaar access-tree))
(check-accessor "cddadr" cddadr stored-cddadr access-tree (cddadr access-tree))
(check-accessor "cdddar" cdddar stored-cdddar access-tree (cdddar access-tree))
(check-accessor "cddddr" cddddr stored-cddddr access-tree (cddddr access-tree))

;; The first-class VM dispatcher must preserve the checked car/cdr failure
;; contract too; it must not fabricate () when the path runs off the list.
(check "cadddr passed off-end raises"
       (raises? (lambda () (h1 cadddr (list 7 8)))) #t)
(check "cadddr stored off-end raises"
       (raises? (lambda () (h1 stored-cadddr (list 7 8)))) #t)

(define string-value "hello")
(define vector-value (vector 10 20 30))
(define stored-string-length string-length)
(define stored-string-ref string-ref)
(define stored-vector-ref vector-ref)
(define stored-vref vref)
(define stored-vector-length vector-length)

(check "string-length passed" (h1 string-length string-value)
       (string-length string-value))
(check "string-length stored" (h1 stored-string-length string-value)
       (string-length string-value))
(define (return-string-length) string-length)
(check "string-length returned" (h1 (return-string-length) string-value)
       (string-length string-value))
(check "string-ref passed" (h2 string-ref string-value 1)
       (string-ref string-value 1))
(check "string-ref stored" (h2 stored-string-ref string-value 1)
       (string-ref string-value 1))
(define (return-string-ref) string-ref)
(check "string-ref returned" (h2 (return-string-ref) string-value 1)
       (string-ref string-value 1))
(check "vector-ref passed" (h2 vector-ref vector-value 1)
       (vector-ref vector-value 1))
(check "vector-ref stored" (h2 stored-vector-ref vector-value 1)
       (vector-ref vector-value 1))
(check "vref passed" (h2 vref vector-value 1)
       (vref vector-value 1))
(check "vref stored" (h2 stored-vref vector-value 1)
       (vref vector-value 1))
(define (return-vref) vref)
(check "vref returned" (h2 (return-vref) vector-value 1)
       (vref vector-value 1))
(check "vector-length passed" (h1 vector-length vector-value)
       (vector-length vector-value))
(check "vector-length stored" (h1 stored-vector-length vector-value)
       (vector-length vector-value))

(if (= failures 0)
    (display "PASS: VM first-class builtin families")
    (display "FAIL: VM first-class builtin families"))
