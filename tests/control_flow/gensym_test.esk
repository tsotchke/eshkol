;; gensym: unique (uninterned) symbol generation.
;;
;; `gensym` was implemented in lib/core/introspection.cpp (eshkol_gensym /
;; eshkol_gensym_prefix) but was never wired into any dispatch table on any
;; engine — the native LLVM codegen had no `func_name == "gensym"` case and
;; the bytecode VM's BUILTINS[] table had no entry for it, so `(gensym)`
;; failed to compile on native (JIT/AOT: "Unknown function: gensym") and
;; fatal-errored on the VM (compiled as an undefined global, i.e. NIL, then
;; "calling non-function" the moment it was invoked). This test proves it is
;; now callable end to end and that successive calls return distinct,
;; uninterned-style symbols, on every engine that runs this file.
;;
;; Hygienic macro expansion already has its own gensym-like renamer
;; (vm_macro.c's compile-time hygiene counter / the syntax-rules expander's
;; internal renaming) — that is a *different* feature operating at macro-
;; expansion time on syntax, entirely separate from this runtime, procedural
;; `gensym`, which manual (non-hygienic, `define-syntax`-free) macro-writing
;; code needs to fabricate fresh binding names at run time.

(define pass-count 0)
(define fail-count 0)

(define (check name cond)
  (if cond
      (begin (set! pass-count (+ pass-count 1))
             (display "PASS: ") (display name) (newline))
      (begin (set! fail-count (+ fail-count 1))
             (display "FAIL: ") (display name) (newline))))

;; ----------------------------------------------------------------------
;; Callable at all, and produces a symbol
;; ----------------------------------------------------------------------
(define g1 (gensym))
(check "(gensym) is callable" #t)
(check "(gensym) produces a symbol" (symbol? g1))

;; ----------------------------------------------------------------------
;; Successive calls are distinct
;; ----------------------------------------------------------------------
(define g2 (gensym))
(define g3 (gensym))
(check "g1 distinct from g2 (eq?)" (not (eq? g1 g2)))
(check "g2 distinct from g3 (eq?)" (not (eq? g2 g3)))
(check "g1 distinct from g3 (eq?)" (not (eq? g1 g3)))
(check "g1 distinct from g2 (equal? on spelling)"
       (not (equal? (symbol->string g1) (symbol->string g2))))

;; ----------------------------------------------------------------------
;; Round-trips through symbol->string / string->symbol like any other symbol
;; ----------------------------------------------------------------------
(check "symbol->string on a gensym returns a string"
       (string? (symbol->string g1)))
(check "gensym's name round-trips through string->symbol / symbol->string"
       (equal? (symbol->string (string->symbol (symbol->string g1)))
               (symbol->string g1)))

;; ----------------------------------------------------------------------
;; A gensym is not (accidentally) eq? to a same-spelled literal/interned
;; symbol read from source — it is a fresh allocation, not looked up in the
;; interning table. (Two gensyms in a row exercise this above; this checks
;; the boundary against ordinary quoted symbols specifically for whichever
;; counter value this run happens to produce.)
;; ----------------------------------------------------------------------
(check "many successive gensyms all have distinct spellings"
       (let loop ((n 20) (seen '()) (ok #t))
         (if (= n 0)
             ok
             (let ((s (symbol->string (gensym))))
               (loop (- n 1) (cons s seen) (and ok (not (member s seen))))))))

;; ----------------------------------------------------------------------
;; Summary
;; ----------------------------------------------------------------------
(newline)
(display "=== Summary ===") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(display (if (= fail-count 0) "RESULT: ALL PASS" "RESULT: FAILURES DETECTED"))
(newline)
