;;; Comprehensive execution-backed verification suite for the Wave 9 stdlib,
;;; rigorous numerics, interval AD, Taylor models, torus fields, Riemannian
;;; manifolds, algebraic effects, streams, plotting, and core runtime surface.

(require stdlib)
(require core.ad.rigorous_interval)
(require core.ad.interval)
(require core.ad.interval_jet)
(require core.ad.interval_tensor)
(require core.ad.compact_bounds)
(require core.ad.taylor_models)
(require core.ad.rigorous_taylor_models)
(require core.torus)
(require core.manifold)
(require core.control.effects)
(require core.streams)
(require core.pde.ns-residual)
(require core.symbolic)
(require core.plot)
(require core.alist)
(require core.data.base64)
(require core.data.csv)
(require core.json)
(require core.json_schema)
(require core.io)
(require core.operators.compare)
(require core.sexp)
(require core.strings)
(require core.capabilities)
(require core.channels)

(define failures 0)
(define (check label cond)
  (if cond
      #t
      (begin
        (set! failures (+ failures 1))
        (display "FAIL: ")
        (display label)
        (newline)
        #f)))

;; 1. Rigorous intervals & interval.esk
(let* ((a (cons -2 3))
       (b (cons 1 4))
       (pt (interval-point 2.0))
       (hu (ia-hull a b))
       (inter (ia-intersect a b))
       (iv-inter (interval-intersect a b))
       (ab (ia-abs-interval a))
       (sq (ia-sqr a))
       (pi-iv (interval-pi)))
  (check "iv-rel-pad positive" (> iv-rel-pad 0.0))
  (check "iv-abs-pad positive" (> iv-abs-pad 0.0))
  (check "ia-mag" (>= (ia-mag a) 3.0))
  (check "ia-to-double-down" (<= (ia-to-double-down 1/3) 0.34))
  (check "ia-to-double-up" (>= (ia-to-double-up 1/3) 0.33))
  (check "ia-exact-up" (= (ia-exact-up 0) 0))
  (check "ia-hull" (and (<= (car hu) -2) (>= (cdr hu) 4)))
  (check "ia-intersect" (and (= (car inter) 1) (= (cdr inter) 3)))
  (check "interval-intersect" (equal? iv-inter inter))
  (check "ia-contains?" (ia-contains? a 0))
  (check "interval-subset?" (interval-subset? pt b))
  (check "interval-point" (= (car pt) 2.0))
  (check "ia-abs-interval" (= (car ab) 0))
  (check "interval-abs" (= (car (interval-abs a)) 0))
  (check "ia-sqr" (= (car sq) 0))
  (check "interval-sqr" (= (car (interval-sqr a)) 0))
  (check "interval-atan" (pair? (interval-atan (interval-point 1.0))))
  (check "interval-pi" (and (> (car pi-iv) 3.14) (< (cdr pi-iv) 3.15))))

;; 2. Interval jets & gradients
(let* ((jc (ijet-const 2.0 3))
       (jv (ijet-var 1.0 3))
       (gc (igrad-const 5.0 2))
       (gv (igrad-var (interval-point 2.0) 0 2))
       (r-log (rn-log (interval-point 2.0)))
       (r-sqrt (rn-sqrt (interval-point 4.0)))
       (r-atan (rn-atan (interval-point 1.0)))
       (r-iv (rn->interval 3.0))
       (ev (interval-eval (lambda (x) (rn+ x x)) (interval-point 3.0)))
       (tc (interval-taylor-coeffs (lambda (x) (rn* x x)) (interval-point 2.0) 2)))
  (check "ijet?" (ijet? jc))
  (check "ijet-order" (= (ijet-order jc) 3))
  (check "ijet-value" (pair? (ijet-value jv)))
  (check "ijet-coeffs" (= (length (ijet-coeffs jc)) 4))
  (check "igrad?" (igrad? gc))
  (check "igrad-dim" (= (igrad-dim gv) 2))
  (check "igrad-value" (pair? (igrad-value gv)))
  (check "igrad-partials" (= (vector-length (igrad-partials gv)) 2))
  (check "igrad-partial" (pair? (igrad-partial gv 0)))
  (check "rn-log" (pair? r-log))
  (check "rn-sqrt" (pair? r-sqrt))
  (check "rn-atan" (pair? r-atan))
  (check "rn->interval" (pair? r-iv))
  (check "interval-eval" (pair? ev))
  (check "interval-taylor-coeffs" (= (length tc) 3)))

;; 3. Interval tensors
(let* ((it1 (make-itensor '(2 2) (interval-point 2.0)))
       (it2 (make-itensor '(2 2) (interval-point 4.0)))
       (it-add (itensor+ it1 it2))
       (it-sub (itensor- it2 it1))
       (it-mul (itensor* it1 it2))
       (it-neg (itensor-neg it1))
       (it-log (itensor-log it1))
       (it-sin (itensor-sin it1))
       (it-cos (itensor-cos it1))
       (it-sqrt (itensor-sqrt it2))
       (it-atan (itensor-atan it1))
       (it-tr (itensor-transpose it1))
       (it-m1 (itensor-map ia-sqr it1))
       (it-m2 (itensor-map2 ia-hull it1 it2))
       (pt-t (make-tensor '(2 2) 2.0)))
  (check "itensor?" (itensor? it1))
  (check "itensor-shape" (equal? (itensor-shape it1) '(2 2)))
  (check "itensor-size" (= (itensor-size it1) 4))
  (check "itensor-flat-ref" (pair? (itensor-flat-ref it-add 0)))
  (check "itensor-ref" (pair? (itensor-ref it-sub 0 1)))
  (check "itensor ops"
    (and (itensor? it-mul) (itensor? it-neg) (itensor? it-log)
         (itensor? it-sin) (itensor? it-cos) (itensor? it-sqrt)
         (itensor? it-atan) (itensor? it-tr) (itensor? it-m1) (itensor? it-m2)))
  (check "itensor-contains-tensor?" (itensor-contains-tensor? it1 pt-t)))

;; 4. Compact bounds & Taylor models
(let* ((box (vector (cons 0 1)))
       (mid (box-midpoint box))
       (w (box-width box))
       (enc (box-enclose (lambda (v) (rn* (vector-ref v 0) (vector-ref v 0))) box))
       (cb (box-sup (lambda (v) (rn* (vector-ref v 0) (vector-ref v 0))) box 0.1))
       (tm1 (taylor-model (lambda (x) (* x x)) 0.0 0.5 3))
       (tm2 (taylor-model (lambda (x) (+ x 1.0)) 0.0 0.5 3))
       (tm-p (tm-mul tm1 tm2))
       (rtm1 (tm-var 0 1 2))
       (rtm2 (tm-const 1/2 0 1 2))
       (rtm-c (tm-compose rtm1 rtm2)))
  (check "box-midpoint" (= (vector-length mid) 1))
  (check "box-width" (>= w 1))
  (check "box-enclose" (pair? enc))
  (check "compact-bound?" (compact-bound? cb))
  (check "compact-bound-witness" (vector? (compact-bound-witness cb)))
  (check "compact-bound-boxes" (>= (compact-bound-boxes cb) 1))
  (check "compact-bound-pruned" (>= (compact-bound-pruned cb) 0))
  (check "tm-nsamp" (> tm-nsamp 0))
  (check "tm-safety" (> tm-safety 1.0))
  (check "tm-mul" (vector? tm-p))
  (check "tm-compose" (vector? rtm-c)))

;; 5. Torus trigonometric polynomials & fields
(let* ((p1 (torus-cos '(1 0)))
       (p2 (torus-sin '(0 1)))
       (pn (torus-neg p1))
       (f1 (torus-field-from-trig p1))
       (f2 (torus-field-from-trig p2))
       (fsum (torus-field+ f1 f2))
       (fder (torus-field-deriv f1 0)))
  (check "torus-trig?" (torus-trig? p1))
  (check "torus-dimension" (= (torus-dimension p1) 2))
  (check "torus-neg" (torus-trig? pn))
  (check "torus-coefficient" (pair? (torus-coefficient p1 '(1 0))))
  (check "torus-degree" (= (torus-degree p1) 1))
  (check "torus-support-intersect"
    (list? (torus-support-intersect '(((0 . 1/2) (0 . 1/2)))
                                    '(((1/4 . 3/4) (1/4 . 3/4))))))
  (check "torus-field?" (torus-field? f1))
  (check "torus-field-proc" (procedure? (torus-field-proc f1)))
  (check "torus-field-eval" (number? (torus-field-eval fsum '(0.0 0.0))))
  (check "torus-field-deriv" (torus-field? fder)))

;; 6. Riemannian manifolds
(let* ((H (make-hyperbolic-manifold 2))
       (a (vector 0.1 0.0))
       (b (vector 0.2 0.1))
       (v (vector 1.0 0.0))
       (pt (manifold-parallel-transport H a b v))
       (ginv (manifold-metric-inverse H a))
       (sec (manifold-sectional-curvature H))
       (ric (manifold-ricci H a)))
  (check "manifold-type" (eq? (manifold-type H) 'hyperbolic))
  (check "manifold-parallel-transport" (= (vector-length pt) 2))
  (check "manifold-metric-inverse" (vector? ginv))
  (check "manifold-sectional-curvature" (< sec 0.0))
  (check "manifold-ricci" (vector? ric)))

;; 7. Algebraic effects (define-effect, declare-effects, handle, handle-shallow, metadata)
(define-effect CovAsk (cov-ask))
(declare-effects cov-fn (CovAsk))
(define (cov-fn) (cov-ask))
(let ((r-deep (handle (list (cov-fn) (effect-handled? cov-ask))
                ((cov-ask) k (k 42))))
      (r-shallow (handle-shallow (cov-ask)
                   ((cov-ask) k (k 99))))
      (ctx-old (%effect-context)))
  (%effect-context-set! ctx-old)
  (check "effect?" (effect? CovAsk))
  (check "effect-operation-name" (eq? (effect-operation-name cov-ask) 'cov-ask))
  (check "effect-operation-effect" (eq? (effect-operation-effect cov-ask) CovAsk))
  (check "effect-handled?" (equal? r-deep '(42 #t)))
  (check "handle-shallow" (= r-shallow 99))
  (check "%effect-identity" (= (%effect-identity 7) 7))
  (check "%effect-declare" (eq? (%effect-declare 'cov-fn '(CovAsk)) 'cov-fn)))

;; 8. Streams
(let* ((s1 (list->stream '(1 2 3 4 5)))
       (s-from (stream-from 10))
       (s-iter (stream-iterate (lambda (x) (+ x 2)) 0))
       (s-cons (stream-cons 0 (delay s1)))
       (s-map (stream-map (lambda (x) (* x 2)) s1))
       (s-filt (stream-filter even? s1))
       (s-zip (stream-zip s1 s-from))
       (s-app (stream-append (list->stream '(1 2)) (list->stream '(3 4))))
       (s-tw (stream-take-while (lambda (x) (< x 4)) s1))
       (s-dw (stream-drop-while (lambda (x) (< x 3)) s1))
       (acc 0))
  (stream-for-each (lambda (x) (set! acc (+ acc x))) (list->stream '(1 2 3)))
  (check "stream-null?" (stream-null? stream-null))
  (check "stream-pair?" (stream-pair? s1))
  (check "stream?" (and (stream? s1) (stream? stream-null)))
  (check "stream-car/cdr" (and (= (stream-car s-cons) 0) (= (stream-car (stream-cdr s-cons)) 1)))
  (check "stream-take/drop/ref"
    (and (equal? (stream-take s-iter 3) '(0 2 4))
         (= (stream-car (stream-drop s1 2)) 3)
         (= (stream-ref s-from 5) 15)))
  (check "stream-map/filter/zip/append"
    (and (= (stream-length s-map) 5)
         (equal? (stream->list s-filt) '(2 4))
         (equal? (stream-take s-zip 2) '((1 10) (2 11)))
         (equal? (stream->list s-app) '(1 2 3 4))))
  (check "stream-take-while/drop-while/for-each"
    (and (equal? (stream->list s-tw) '(1 2 3))
         (equal? (stream->list s-dw) '(3 4 5))
         (= acc 6))))

;; 9. PDE ns-divergence-cartesian & symbolic power series
(let* ((cflow (ns-cflow
                (lambda (x y z t) (vector x (- y) 0.0))
                (lambda (x y z t) 0.0)
                1.0))
       (div-fn (ns-divergence-cartesian cflow))
       (s1 (series '(x) '(((1) . 1)) 4))
       (s2 (series '(x) '(((0) . 1)) 4))
       (sd (series- s1 s2)))
  (check "ns-divergence-cartesian" (< (abs (div-fn 1.0 2.0 3.0 0.0)) 1e-6))
  (check "series?" (series? s1))
  (check "series-field" (and (vector? (series-field s1))
                             (eq? (vector-ref (series-field s1) 0) 'eshkol-coefficient-field)))
  (check "series-" (series? sd)))

;; 10. Plot, alist, base64, csv, json, json-schema, io, compare, sexp, strings, capabilities, stdlib
(let* ((tmp-json "/tmp/eshkol_wave9_cov_alist.json")
       (tmp-app "/tmp/eshkol_wave9_cov_append.txt")
       (tmp-onnx "/tmp/eshkol_wave9_cov_tensor.onnx")
       (al (alist-set '((a . 1)) 'b 2))
       (b64-rem (base64-remove-padding "YQ=="))
       (b64-val (base64-value #\A))
       (b64-bytes (string->bytes-helper "hi" 0 2))
       (b64-dec (base64-decode-helper "SGk=" 0 4 '()))
       (csv-f (csv-split-fields "a,b,c"))
       (schema (list (cons "type" "integer")))
       (sp (sparkline '(1.0 2.0 3.0 2.0)))
       (bc (bar-chart (list (list "a" 2.0) (list "b" 4.0))))
       (hs (histogram '(1.0 2.0 2.5 3.0) 3))
       (sx (sexp->string '(+ 1 2)))
       (tr (string-trim-right "abc   "))
       (so (string-split-ordered "a,b,c" ","))
       (rt (random-tensor '(2 2)))
       (rnt (random-normal-tensor '(2 2)))
       (tns (time-ns (lambda () (+ 1 2))))
       (tus (time-us (lambda () (+ 1 2)))))
  (alist-write-json tmp-json '(("k" . 1)))
  (delete-file tmp-json)
  (let ((p (open-output-file-append tmp-app)))
    (write-string "ok" p)
    (close-output-port p))
  (let* ((ip (open-input-file tmp-app))
         (pk (peek-char ip)))
    (close-input-port ip)
    (delete-file tmp-app)
    (check "open-output-file-append + peek-char" (char=? pk #\o)))
  (let ((img (make-tensor '(4 4 3) 0.0)))
    (tensor-rect-fill! img 0 0 2 2 1.0 0.5 0.25)
    (tensor-disk-fill! img 2 2 1 0.2 0.4 0.6)
    (check "tensor-rect-fill! & tensor-disk-fill!" (> (tensor-ref img 0 0 0) 0.5)))
  (let ((t-ex (make-tensor '(2 2) 1.0)))
    (onnx-export-tensor tmp-onnx t-ex)
    (delete-file tmp-onnx)
    (check "onnx-export-tensor" #t))
  (print "")
  (println "cov-io-ok")
  (check "alist-set" (= (cdr (assoc 'b al)) 2))
  (check "base64 helpers"
    (and (string=? b64-rem "YQ") (= b64-val 0) (list? b64-bytes) (list? b64-dec)))
  (check "csv-split-fields" (equal? csv-f '("a" "b" "c")))
  (check "json-schema"
    (and (json-schema-valid? schema 42)
         (null? (json-schema-validate schema 42))))
  (check "plot helpers" (and (string? sp) (null? bc) (null? hs)))
  (check "gt/le" (and (gt 3 2) (le 2 2)))
  (check "sexp->string" (string? sx))
  (check "string-trim-right & string-split-ordered"
    (and (string=? tr "abc") (equal? so '("a" "b" "c"))))
  (check "capability-policy & clear (inactive)"
    (and (not (capability-policy)) (capability-clear-policy!)))
  (check "stdlib random/time"
    (and (tensor? rt) (tensor? rnt) (integer? tns) (real? tus) (>= tus 0.0))))

;; 11. Core runtime forms: shared, procedure-arity, channel-try-recv!, make-logic-var,
;;     raise-continuable, let-syntax, letrec-syntax, type-name, hott, hott-eval
(hott
  (import circle)
  (example (Path Int (winding (trans 0 S1 base base base loop loop)) (pos 2))
           (refl 0 Int (pos 2))))

(let* ((sh (shared (vector 1 2 3)))
       (ch (make-channel 4))
       (tr (channel-try-recv! ch))
       (ar (procedure-arity (lambda (a b) (+ a b))))
       (tn (type-name 42))
       (rc (with-exception-handler
             (lambda (e) (+ e 1))
             (lambda () (raise-continuable 41))))
       (ls (let-syntax ((m1 (syntax-rules () ((_ x) (+ x 1))))) (m1 41)))
       (lrs (letrec-syntax ((m2 (syntax-rules () ((_ x) (+ x 2))))) (m2 40)))
       (he (hott-eval (winding (trans 0 S1 base base base loop loop)))))
  (check "shared" (vector? sh))
  (check "channel-try-recv!" (not tr))
  (check "procedure-arity" (or (integer? ar) (pair? ar)))
  (check "type-name" (eq? tn 'integer))
  (check "raise-continuable" (= rc 42))
  (check "let-syntax" (= ls 42))
  (check "letrec-syntax" (= lrs 42))
  (check "hott-eval" (not (not he))))

;; 12. core.pde.ns-residual flow/cflow accessors and Simpson quadrature helpers
(let* ((flow (ns-flow (lambda (r z t) 0)
                      (lambda (r z t) (* 1/3 r))
                      (lambda (r z t) 0)
                      (lambda (r z t) (* 1/2 1/3 1/3 r r))
                      1/5))
       (cflow (ns-cflow (lambda (x y z t) (vector x 0 0))
                        (lambda (x y z t) 0)
                        1/6)))
  (check "ns-flow accessors"
    (and (= ((ns-flow-ur flow) 2 1/3 1/2) 0)
         (= ((ns-flow-utheta flow) 2 1/3 1/2) 2/3)
         (= ((ns-flow-uz flow) 2 1/3 1/2) 0)
         (= ((ns-flow-p flow) 2 1/3 1/2) 2/9)
         (= (ns-flow-nu flow) 1/5)))
  (check "ns-cflow accessors"
    (and (= (vector-ref ((ns-cflow-u cflow) 3 5 7 0) 0) 3)
         (= ((ns-cflow-p cflow) 3 5 7 0) 0)
         (= (ns-cflow-nu cflow) 1/6)))
  (check "ns-simpson & ns-grid-integral"
    (and (equal? (ns-simpson-nodes 0 1 2) (list 0 1/2 1))
         (equal? (ns-simpson-weights 2) (list 1 4 1))
         (= (ns-simpson-step 0 1 2) 1/2)
         (= (ns-grid-integral (lambda (x y z t) (* x x)) 0 1 2 0 1 2 0 1 2 0) 1/3))))

;; 13. Wave 1 VM parity surface: core.curvature (25 ops), features, sum-tag, sum-value
(let* ((hdr (make-geometry-header -1.0))
       (x (tensor 0.2 -0.1 0.05))
       (y (tensor -0.15 0.25 0.1))
       (v (tensor 0.1 0.05 -0.05))
       (g (tensor 0.3 -0.2 0.1))
       (sp (chart->sphere x 1.0))
       (q (make-tensor '(1 2) 0.1))
       (k (make-tensor '(2 2) 0.2))
       (val (make-tensor '(2 2) 0.5))
       (sl (inject-left 42)))
  (check "core.curvature surface"
    (and (integer? (chart-convention-id))
         (real? (chart-alpha))
         (list? hdr)
         (real? (geometry-header-check hdr))
         (real? (chart-distance x y -1.0))
         (real? (chart-sq-distance x y -1.0))
         (real? (chart-conformal-factor x -1.0))
         (list? (chart-distance-jet x y 0.0))
         (list? (chart-sq-distance-jet x y -1.0))
         (tensor? (chart-sq-distance-gradient x y -1.0))
         (tensor? (chart-exp-map x v -1.0))
         (tensor? (chart-log-map x y -1.0))
         (tensor? (chart-transport x y v -1.0))
         (tensor? (chart-mobius-add x y -1.0))
         (tensor? (chart-mobius-scalar 0.5 x -1.0))
         (tensor? (chart-project x -1.0))
         (tensor? (chart-riemannian-grad g x -1.0))
         (real? (chart-default-temperature 4))
         (tensor? (sphere->chart sp 1.0))
         (tensor? (migrate-legacy-ball-point x -1.0))
         (tensor? (migrate-legacy-ball-tangent v -1.0))
         (real? (migrate-legacy-temperature 2.0 1.5))
         (tensor? (chart-attention q k val -1.0))
         (tensor? (chart-attention-weights q k val -1.0))))
  (check "features & sum-tag/sum-value"
    (and (pair? (memq 'eshkol (features)))
         (= (sum-tag sl) 0)
         (= (sum-value sl) 42))))

(if (= failures 0)
    (begin
      (display "PASS: wave9_surface_execution_test")
      (newline))
    (begin
      (display "FAIL: wave9_surface_execution_test failures=")
      (display failures)
      (newline)
      (exit 1)))
