;; Inexact tensor division has the same IEEE 754 behavior as scalar /.
(display (/ 1.0 0.0)) (newline)
(display (/ 1.0 -0.0)) (newline)
(display (/ 0.0 0.0)) (newline)
(display (tensor-div (make-tensor '(1 1) 1.0)
                     (make-tensor '(1 1) 0.0))) (newline)
(display (tensor-div (make-tensor '(1 1) 0.0)
                     (make-tensor '(1 1) 0.0))) (newline)
(display (tensor-div (tensor 1.0 -1.0 0.0)
                     (tensor 0.0 -0.0 0.0))) (newline)
(display (tensor-div (make-tensor '(2 2) 1.0)
                     (tensor 0.0 -0.0))) (newline)
(display (tensor-div (make-tensor '(8 8) 1.0)
                     (make-tensor '(1 1) -0.0))) (newline)
