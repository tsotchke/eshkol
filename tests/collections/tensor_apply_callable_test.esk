;; Every callable syntax uses ordinary application, including AD carriers.
(define failures 0)
(define (check name ok)
  (display (if ok "PASS: " "FAIL: ")) (display name) (newline)
  (if (not ok) (set! failures (+ failures 1))))
(define (near a b) (< (abs (- a b)) 0.000001))
(define (triple t a b c)
  (and (near (vector-ref t 0) a) (near (vector-ref t 1) b)
       (near (vector-ref t 2) c)))
(define point #(1.0 4.0 9.0))
(define (custom x) (+ (* x x) 3.0))
;; A name from the old whitelist must mean the actual bound procedure.
(define (square x) (+ x 7.0))
(define (maker offset) (lambda (x) (+ (* x x) offset)))
(check "builtin sqrt" (triple (tensor-apply point sqrt) 1.0 2.0 3.0))
(check "builtin exp" (triple (tensor-apply #(0.0 0.0 0.0) exp) 1.0 1.0 1.0))
(check "builtin arithmetic" (triple (tensor-apply point -) -1.0 -4.0 -9.0))
(check "named procedure" (triple (tensor-apply point custom) 4.0 19.0 84.0))
(check "rebound whitelist name" (triple (tensor-apply point square) 8.0 11.0 16.0))
(check "inline lambda" (triple (tensor-apply point (lambda (x) (+ x 2.0))) 3.0 6.0 11.0))
(let ((offset 5.0))
  (check "captured lambda" (triple (tensor-apply point (lambda (x) (+ x offset))) 6.0 9.0 14.0)))
(let ((f custom))
  (check "callable variable" (triple (tensor-apply point f) 4.0 19.0 84.0)))
(check "callable result" (triple (tensor-apply point (maker 3.0)) 4.0 19.0 84.0))
(check "conditional callable" (triple (tensor-apply point (if #t custom sqrt)) 4.0 19.0 84.0))
(check "integer result" (triple (tensor-apply point (lambda (x) 7)) 7.0 7.0 7.0))
(define evals 0)
(define calls 0)
(define once (tensor-apply point
  (begin (set! evals (+ evals 1))
    (lambda (x) (set! calls (+ calls 1)) (+ x 1.0)))))
(check "evaluation counts" (and (= evals 1) (= calls 3) (triple once 2.0 5.0 10.0)))
(check "shape preserved" (equal? (tensor-shape
  (tensor-apply (reshape point '(1 3)) custom)) '(1 3)))

(check "variadic callable" (triple (tensor-apply point (lambda xs (car xs))) 1.0 4.0 9.0))
(check "continuation callable" (= (call/cc (lambda (k) (tensor-apply point k))) 1.0))
(check "non-callable raises" (guard (e (#t #t)) (tensor-apply point 42) #f))
(define empty-count 0)
(define empty-result (tensor-apply (make-tensor '(0) 0.0)
  (lambda (x) (set! empty-count (+ empty-count 1)) x)))
(check "empty tensor" (and (= empty-count 0) (equal? (tensor-shape empty-result) '(0))))
(check "empty non-callable raises" (guard (e (#t #t))
  (tensor-apply (make-tensor '(0) 0.0) #f) #f))

(define (loss-named t) (tensor-sum (tensor-apply t custom)))
(define (loss-lambda t) (tensor-sum (tensor-apply t (lambda (x) (+ (* x x) 3.0)))))
(define (loss-capture t) (let ((offset 3.0))
  (tensor-sum (tensor-apply t (lambda (x) (+ (* x x) offset))))))
(define (loss-variable t) (let ((f custom)) (tensor-sum (tensor-apply t f))))
(define (loss-result t) (tensor-sum (tensor-apply t (maker 3.0))))
(check "gradient named" (triple (gradient loss-named point) 2.0 8.0 18.0))
(check "gradient lambda" (triple (gradient loss-lambda point) 2.0 8.0 18.0))
(check "gradient capture" (triple (gradient loss-capture point) 2.0 8.0 18.0))
(check "gradient variable" (triple (gradient loss-variable point) 2.0 8.0 18.0))
(check "gradient result" (triple (gradient loss-result point) 2.0 8.0 18.0))
(check "gradient builtin" (triple
  (gradient (lambda (t) (tensor-sum (tensor-apply t sqrt))) point)
  0.5 0.25 (/ 1.0 6.0)))
(check "differentiable capture" (near (derivative
  (lambda (s) (tensor-sum (tensor-apply point (lambda (x) (* s x))))) 2.0) 14.0))
(define (hessian-ok f)
  (let ((h (hessian f (vector 1.0 4.0 9.0))))
    (and (near (tensor-ref h '(0 0)) 2.0)
         (near (tensor-ref h '(1 1)) 2.0)
         (near (tensor-ref h '(2 2)) 2.0)
         (near (tensor-ref h '(0 1)) 0.0))))
(check "hessian named" (hessian-ok loss-named))
(check "hessian lambda" (hessian-ok loss-lambda))
(check "hessian capture" (hessian-ok loss-capture))
(check "hessian variable" (hessian-ok loss-variable))
(check "hessian result" (hessian-ok loss-result))
(check "exact AD without finite differences" (= (ad-finite-difference-evals) 0))
(if (= failures 0) (display "RESULT: PASS\n") (begin (display "RESULT: FAIL\n") (exit 1)))
