; Basic macro tests for Eshkol
; Tests the define-syntax/syntax-rules system
;
; Each case asserts the value the expansion must produce. The expectations are
; the arithmetic the macro template denotes -- they were already written into
; the prompt strings of the display-only version of this file.

(define (check name expected actual)
  (if (equal? expected actual)
      (begin (display "PASS: ") (display name) (newline))
      (begin (display "FAIL: ") (display name)
             (display " -- expected ") (write expected)
             (display ", got ") (write actual)
             (newline))))

; Test 1: Simple transformation macro
(define-syntax double
  (syntax-rules ()
    ((double x) (* x 2))))

(check "double macro: (double 5) = 5*2" 10 (double 5))

; Forward references to ordinary macro names remain supported.
(check "forward ordinary macro reference" 9 (forward-nine))
(define-syntax forward-nine
  (syntax-rules () ((forward-nine) 9)))

; Test 2: Macro with two arguments
(define-syntax my-add
  (syntax-rules ()
    ((my-add a b) (+ a b))))

(check "my-add macro: (my-add 3 4)" 7 (my-add 3 4))

; Test 3: Nested macro calls
(check "nested macros: (double (my-add 2 3)) = (2+3)*2" 10 (double (my-add 2 3)))

; Test 4: Macro with literal keyword
; Use a non-special-form name: `when` is a built-in form lowered before
; user macro expansion, so defining `when` here would not exercise CALL
; macro expansion.
(define-syntax my-when
  (syntax-rules ()
    ((my-when test body)
     (if test body #f))))

(check "my-when macro, true test" 42 (my-when #t 42))
(check "my-when macro, false test" #f (my-when #f 42))

; Test 5: unless macro
(define-syntax my-unless
  (syntax-rules ()
    ((my-unless test body)
     (if test #f body))))

(check "my-unless macro, false test" 99 (my-unless #f 99))
(check "my-unless macro, true test" #f (my-unless #t 99))

; Argument expressions must be substituted, not re-evaluated into the wrong
; place: (double (+ 1 2)) must be (* (+ 1 2) 2) = 6, never (* 1 2) or (+ 1 4).
(check "double macro over a compound argument" 6 (double (+ 1 2)))
