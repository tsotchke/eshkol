(require stdlib)
(require agent.crypto)
(define passed 0)
(define (check name ok) (if ok (set! passed (+ passed 1)) (error name)))
(define (raises? f) (guard (e (else #t)) (f) #f))
(define output (make-string 70 #\x))
(define alias output)
(check "raw prefix status" (= (sha256-raw "abc" 2 output 65) 0))
(check "raw prefix bytes" (string=? (substring output 0 64) "fb8e20fc2e4c3f248c60c39bd652f3c1347298bb977b8b4d5903b85055620603"))
(check "output alias observes mutation" (string=? alias output))
(check "output keeps capacity" (= (string-byte-length output) 70))
(check "output terminator" (= (char->integer (string-ref output 64)) 0))
(check "untouched output suffix" (string=? (substring output 65 70) "xxxxx"))
(define short (make-string 64 #\x))
(check "short buffer returns error" (= (sha256-raw "abc" 3 short 64) -1))
(check "short buffer unchanged" (string=? short (make-string 64 #\x)))
(check "input size checked" (raises? (lambda () (sha256-raw "a" 2 output 65))))
(check "negative input size checked" (raises? (lambda () (sha256-raw "a" -1 output 65))))
(check "output size checked" (raises? (lambda () (sha256-raw "a" 1 output 71))))
(check "key size checked" (raises? (lambda () (hmac-sha256-raw "k" 2 "a" 1 output 65))))
(check "entropy output size checked" (raises? (lambda () (random-bytes-raw output 71))))
(display "Checks: ") (display passed) (newline)
(display "RESULT: PASS\n")
