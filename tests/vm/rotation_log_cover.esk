(define (equal-axes a b)
  (and (= (tensor-ref a 0) (tensor-ref b 0))
       (= (tensor-ref a 1) (tensor-ref b 1))
       (= (tensor-ref a 2) (tensor-ref b 2))))
(display (if (and (equal-axes (so3-log (tensor 1.0 -2.0 0.0 1.0))
                              (so3-log (tensor -1.0 2.0 0.0 -1.0)))
                  (equal-axes (so3-log (tensor 0.0 0.0 1.0 0.0))
                              (so3-log (tensor 0.0 0.0 -1.0 0.0))))
             "PASS rotation_log_cover" "FAIL rotation_log_cover"))
(newline)
