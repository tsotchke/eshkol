;; VM's first-class R7RS bytevector constructor checks.
(define empty (bytevector))
(define boundary (bytevector 0 1 127 254 255))
(define ctor bytevector)
(define one (ctor 255))

(display (if (and (bytevector? empty) (= (bytevector-length empty) 0)) "PASS" "FAIL")) (display ": empty") (newline)
(display (if (and (= (bytevector-length boundary) 5)
                  (= (bytevector-u8-ref boundary 0) 0)
                  (= (bytevector-u8-ref boundary 4) 255)) "PASS" "FAIL")) (display ": byte boundaries and embedded NUL") (newline)
(display (if (and (= (bytevector-length one) 1) (= (bytevector-u8-ref one 0) 255)) "PASS" "FAIL")) (display ": first-class constructor") (newline)
