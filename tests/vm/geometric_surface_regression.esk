;; Standalone VM geometric builtin surface regression.
;; The default build may not link qLLM geometry, but these names must resolve
;; and their portable fallback must consume the right number of arguments.

(define t (make-tensor '(2) 0.0))
;; frechet-mean is the only op here whose arguments have a domain: the weights
;; must sum to something positive, or the Riemannian center of mass is undefined
;; and the op raises (a catchable error) rather than returning a number. `t` is
;; all zeros, so it cannot serve as the weight vector — give it real points and
;; weights. Still an arity/resolution probe, just with in-domain arguments.
(define frechet-pts (make-tensor '(2 2) 0.1))
(define frechet-w (make-tensor '(2) 1.0))
;; "make-euclidean-manifold"/"make-hyperbolic-manifold"/"make-spherical-
;; manifold"/"manifold-type" are lib/core/manifold.esk's public record API
;; now; this probe wants the distinct, lower-level, arena-backed handle
;; constructors/accessor instead, so it calls them by their own "-handle"-
;; suffixed names (same native ids, unchanged arities).
(define m (make-euclidean-manifold-handle 2))
(define h (make-hyperbolic-manifold-handle 2 -1.0))
(define s (make-spherical-manifold-handle 2))

(make-product-manifold m h)
(manifold-curvature h)
(hyperbolic-exp-map t t -1.0)
(hyperbolic-log-map t t -1.0)
(geodesic-distance t t -1.0)
(parallel-transport t t t -1.0)
;; "manifold-parallel-transport" is no longer an alias for this raw-tensor
;; op (see lib/backend/eshkol_vm.c): it is lib/core/manifold.esk's public
;; (manifold-parallel-transport m base-a base-b v), which "parallel-transport"
;; above already exercises the same native id under its real, unaliased name.
(manifold-project t -1.0)
(mobius-add t t -1.0)
(mobius-scalar-mul 0.5 t -1.0)
(poincare-distance t t -1.0)
(frechet-mean frechet-pts frechet-w -1.0)
(great-circle-distance t t)
(slerp t t 0.5)
(spherical-exp t t)
(spherical-exp-map t t)
(spherical-log t t)
(spherical-log-map t t)
(spherical-project t)
(so3-exp t)
(so3-log t)
(se3-exp t)
(se3-log t)
(quaternion-mul t t)
(metric-tensor h)
(christoffel h t)
(riemann-curvature h)
(ricci-scalar h)
(sectional-curvature h t t)
(wedge-product t t)
(exterior-derivative t)
(hodge-star t t)
(interior-product t t)
(pullback t t)
(riemannian-sgd-step t t 0.01 -1.0)
(riemannian-adam-step t t 0.01 0.9 0.999 -1.0)
(define adam-state (make-riemannian-adam-state t))
(riemannian-adam-step! adam-state t t 0.01 0.9 0.999 -1.0)
(riemannian-grad t t -1.0)
(retraction t t -1.0)
(vector-transport t t t -1.0)
(geodesic-attention-scores t t -1.0)
(geodesic-attention-values t t -1.0)
(curvature-softmax t -1.0)
(geodesic-attention-forward t t t -1.0)
(set-curvature! h -0.5)
(get-curvature h)
(curvature-gradient h t)
(transition-geometry! h -1.0 0.1)
(manifold-interpolate h s 0.5)
(curvature-hessian h t)
(adaptive-curvature-step h t)
(manifold-handle-type h)
(manifold-dim h)
(manifold-dimension h)
(manifold-destroy! h)

(display "PASS: geometric builtin surface is registered and stack-safe")
(newline)
