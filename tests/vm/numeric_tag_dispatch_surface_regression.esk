;; R7RS oracle for the VM numeric TAG-DISPATCH matrix.
;;
;; Self-checking against expected values derived from R7RS 6.2 rather than
;; from the other back end, so a defect SHARED by native and the VM cannot
;; pass by agreement.  The paired differential is
;; tests/vm_parity/corpus/52_numeric_tag_dispatch.esk.
;;
;; Invariants asserted here:
;;   R7RS 6.2.2 inexact contagion — any inexact operand makes the result
;;     inexact, for + - * / and for min/max/floor/abs; an integral-valued
;;     flonum result may NOT come back as an exact integer.
;;   exact/exact stays exact — (/ 1 3) is the exact 1/3, and mixing a
;;     ratnum with a fixnum stays in the rational domain.
;;   mixed flonum/ratnum computes with BOTH operands — the flonum is not
;;     truncated into the rational's numerator (which answered 0).

(display "=== VM numeric tag-dispatch surface regression ===") (newline)
(define f125 1.25)
(define f075 0.75)
(define fix 6)
(define nfix (- 0 6))
(define rat (/ 1 3))
(define nrat (/ -2 7))
(define flo 1.5)
(define nflo (- 0.0 2.5))
(define floi (+ f125 f075))
(define floc (+ 1.25 0.75))

(define failures 0)
(define (check label got want)
  (display label) (display ": ")
  (if (equal? got want)
      (display "PASS")
      (begin (set! failures (+ failures 1))
             (display "FAIL got ") (display got)
             (display " want ") (display want)))
  (newline))

;; exactness of a result is a function of the OPERAND TAGS
(define (check-exact label v want)
  (display label) (display ": ")
  (if (eq? (exact? v) want)
      (display "PASS")
      (begin (set! failures (+ failures 1))
             (display "FAIL ") (display v)
             (display " exact=") (display (exact? v))
             (display " want exact=") (display want)))
  (newline))

(check-exact "T1 exact (+ fix fix)" (+ fix fix) #t)
(check "T2 value (+ fix fix)" (+ fix fix) 12)
(check-exact "T3 exact (+ fix nfix)" (+ fix nfix) #t)
(check "T4 value (+ fix nfix)" (+ fix nfix) 0)
