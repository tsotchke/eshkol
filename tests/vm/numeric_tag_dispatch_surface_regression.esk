;; the two reported reproductions
(check "T513 (/ (- 2.0 1.0) (+ 2.0 1.0))" (/ (- 2.0 1.0) (+ 2.0 1.0)) 0.3333333333333333)
(check-exact "T514 that quotient is inexact" (/ (- 2.0 1.0) (+ 2.0 1.0)) #f)
(check "T515 (* 0.5493061443340549 (/ (- 2.0 1.0) (+ 2.0 1.0)))" (* 0.5493061443340549 (/ (- 2.0 1.0) (+ 2.0 1.0))) 0.1831020481113516)

;; exact/exact division stays exact; a bignum is an exact number
(check "T516 (/ 1 3)" (/ 1 3) (/ 1 3))
(check "T517 (/ 6 3)" (/ 6 3) 2)
(check-exact "T518 (/ 1 3) is exact" (/ 1 3) #t)
(check-exact "T519 (expt 10 30) is exact" (expt 10 30) #t)

;; unary and rounding families share the same contagion rule
(check "T520 (- flo)" (- flo) -1.5)
(check "T521 (abs nflo)" (abs nflo) 2.5)
(check "T522 (- rat)" (- rat) (/ -1 3))
(check "T523 (abs nrat)" (abs nrat) (/ 2 7))
(check "T524 (- floi)" (- floi) -2.0)
(check "T525 (abs floi)" (abs floi) 2.0)
(check-exact "T526 exactness of (- floi)" (- floi) #f)
(check-exact "T527 exactness of (abs floi)" (abs floi) #f)
(check-exact "T528 exactness of (- rat)" (- rat) #t)
(check-exact "T529 exactness of (abs nrat)" (abs nrat) #t)
(check-exact "T530 exactness of (floor 2.5)" (floor 2.5) #f)
(check-exact "T531 exactness of (ceiling 2.5)" (ceiling 2.5) #f)
(check-exact "T532 exactness of (round 2.5)" (round 2.5) #f)
(check-exact "T533 exactness of (floor (/ 5 2))" (floor (/ 5 2)) #t)
(check-exact "T534 exactness of (max 1.0 2.0)" (max 1.0 2.0) #f)
(check-exact "T535 exactness of (min 1.0 2)" (min 1.0 2) #f)
(check-exact "T536 exactness of (max 1 2)" (max 1 2) #t)

;; the first-class / variadic route must dispatch identically
(check "T537 (apply + (list rat flo))" (apply + (list rat flo)) 1.8333333333333333)
(check "T538 (apply * (list rat flo))" (apply * (list rat flo)) 0.5)
(check "T539 (apply - (list flo rat))" (apply - (list flo rat)) 1.1666666666666667)
(check "T540 (apply / (list flo rat))" (apply / (list flo rat)) 4.5)
(check "T541 (apply < (list 0.2 rat))" (apply < (list 0.2 rat)) #t)
(check "T542 (apply > (list 0.2 rat))" (apply > (list 0.2 rat)) #f)
(check "T543 (+ fix fix rat)" (+ fix fix rat) (/ 37 3))
(check "T544 (* fix rat flo)" (* fix rat flo) 3.0)

(display "failures: ") (display failures) (newline)
(if (> failures 0) (display "FAIL") (display "all numeric tag-dispatch checks PASS")) (newline)
(display "=== VM numeric tag-dispatch surface complete ===") (newline)
