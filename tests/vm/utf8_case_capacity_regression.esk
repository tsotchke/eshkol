;; Read malformed UTF-8 from a binary file through the public read-line route.
;; Each invalid byte becomes U+FFFD, expanding the output from 128 to 384 bytes.
(define path (string-append "/tmp/eshkol-utf8-case-" (number->string (process-pid)) ".bin"))
(define raw (make-bytevector 128 #xff))
(define out (open-binary-output-file path))
(write-bytevector raw out)
(write-u8 10 out)
(close-port out)
(define in (open-binary-input-file path))
(define malformed (read-line in))
(close-port in)
(delete-file path)
(define expected (make-string 128 (integer->char #xfffd)))
(define upper (string-upcase malformed))
(define lower (string-downcase malformed))
(define upper-correct-before-allocations (string=? upper expected))
(define lower-correct-before-allocations (string=? lower expected))
;; Tiny follow-up allocations must not overwrite either returned string.
(define noise (make-vector 64 "x"))
(do ((i 0 (+ i 1))) ((= i 64))
  (vector-set! noise i (make-string (+ 1 (modulo i 3)) #\a)))
(define extents-ok
  (and (= (string-length malformed) 128)
       (= (string-length upper) 128)
       (= (string-length lower) 128)
       (= (bytevector-length (string->utf8 upper)) 384)
       (= (bytevector-length (string->utf8 lower)) 384)))
(define controls-ok
  (and (string=? (string-upcase "aZ09") "AZ09")
       (string=? (string-downcase "Az09") "az09")))
(if (and upper-correct-before-allocations
         lower-correct-before-allocations
         (string=? upper expected)
         (string=? lower expected)
         extents-ok
         controls-ok)
    (begin (display "RESULT: PASS") (newline))
    (begin
      (display "FAIL: UTF-8 case conversion; read-line chars=")
      (display (string-length malformed))
      (display " bytes=")
      (display (bytevector-length (string->utf8 malformed)))
      (display " upper chars=")
      (display (string-length upper))
      (display " upper bytes=")
      (display (bytevector-length (string->utf8 upper)))
      (display " lower chars=")
      (display (string-length lower))
      (display " lower bytes=")
      (display (bytevector-length (string->utf8 lower)))
      (display " before-allocation-match=")
      (display (and upper-correct-before-allocations lower-correct-before-allocations))
      (display " after-allocation-match=")
      (display (and (string=? upper expected) (string=? lower expected)))
      (display " valid-upper=")
      (display (string-upcase "aZ09"))
      (display " valid-lower=")
      (display (string-downcase "Az09"))
      (display " extents-ok=")
      (display extents-ok)
      (display " controls-ok=")
      (display controls-ok)
      (newline)
      (exit 1)))
