;; The testing reset extern is backed by the VM's own portable variable and
;; term intern registries. Exercise it between two independent test batches.
(import (core testing))

(register-test "first logic registry batch"
  (lambda ()
    (let fill ((i 0))
      (if (< i 4096)
          (begin
            (make-logic-var (string-append "?batch-" (number->string i)))
            (fill (+ i 1)))
          #t))
    (check-true (logic-var? (make-logic-var "?batch-4095")))))
(define first-batch-result (run-tests))

(reset-tests!)
(register-test "second logic registry batch after reset"
  (lambda ()
    (let ((first (make-logic-var "?after-reset-first"))
          (second (make-logic-var "?after-reset-second"))
          (subst (make-substitution)))
      (let ((bound (unify first 7 subst)))
        (check-equal? (walk first bound) 7)
        ;; If reset-tests! were a no-op, the full registry would reject both
        ;; new names. They would remain ordinary symbols, and unification
        ;; would fail to bind FIRST to 7.
        (check-true (eq? (walk second bound) second))))))
(define second-batch-result (run-tests))
(display (if (and first-batch-result second-batch-result) "RESULT: PASS" "RESULT: FAIL")) (newline)
