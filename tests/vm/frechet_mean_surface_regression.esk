;; Fréchet (Karcher) mean on the Poincaré ball — VM behaviour regression.
;;
;; frechet-mean used to return the EUCLIDEAN weighted average and discard its
;; curvature argument entirely. On the Poincaré ball that is not the Riemannian
;; center of mass and not an approximation of one: geodesics are arcs orthogonal
;; to the boundary, so the true mean pulls away from the chord midpoint, further
;; and further as points approach the boundary. It agreed with the real answer
;; only at the origin or at zero curvature — and nothing in the output revealed
;; that the curvature had been dropped.
;;
;; Case 2 is the load-bearing one: it has a closed form independent of the
;; implementation. On a diameter of the disc the arc-length coordinate is
;; t = 2*artanh(x), and the weighted Fréchet mean is the weighted average in t.
;; For x = +/-0.8 with weights 3 and 1:
;;   t* = (3*2a - 1*2a)/4 = a,   a = artanh(0.8)
;;   x* = tanh(t*/2) = tanh(artanh(0.8)/2)
;; and tanh(artanh(0.5)) = 0.5 with artanh(0.8)/2 = artanh(0.5), so x* = 0.5
;; EXACTLY, against a Euclidean average of 0.4.

(define (approx= a b tol) (< (abs (- a b)) tol))

(define (check name ok)
  (display name)
  (display ": ")
  (display (if ok "PASS" "FAIL"))
  (newline))

(define TOL 1e-12)

;; ---- Case 1: two symmetric points, equal weights -> the origin ----------
(define sym (make-tensor '(2 2) 0.0))
(tensor-set! sym '(0 0) 0.8)
(tensor-set! sym '(1 0) -0.8)
(define w-eq (make-tensor '(2) 1.0))
(define m1 (frechet-mean sym w-eq -1.0))
(check "symmetric pair means the origin"
       (and (approx= (tensor-ref m1 '(0)) 0.0 TOL)
            (approx= (tensor-ref m1 '(1)) 0.0 TOL)))

;; ---- Case 2: closed form on a diameter, weights 3:1 -> exactly 0.5 ------
(define w-31 (make-tensor '(2) 1.0))
(tensor-set! w-31 '(0) 3.0)
(define m2 (frechet-mean sym w-31 -1.0))
(check "weighted mean matches the 1-D closed form (0.5)"
       (and (approx= (tensor-ref m2 '(0)) 0.5 TOL)
            (approx= (tensor-ref m2 '(1)) 0.0 TOL)))

;; ---- Case 3: the curvature argument actually changes the answer ---------
(define m3 (frechet-mean sym w-31 0.0))
(check "K=0 gives the Euclidean average (0.4)"
       (approx= (tensor-ref m3 '(0)) 0.4 TOL))
(check "hyperbolic mean differs from the Euclidean one"
       (> (abs (- (tensor-ref m2 '(0)) (tensor-ref m3 '(0)))) 0.09))

;; ---- Case 4: coincident points -> that point, residual exactly zero -----
;; Every log_mu(x_i) vanishes to rounding here, so a convergence bar taken
;; purely relative to the log magnitudes would divide by noise and reject the
;; most exact input there is.
(define same (make-tensor '(2 2) 0.1))
(define m4 (frechet-mean same w-eq -1.0))
(check "coincident points mean that point"
       (and (approx= (tensor-ref m4 '(0)) 0.1 TOL)
            (approx= (tensor-ref m4 '(1)) 0.1 TOL)))

;; ---- Case 5: domain and convergence gates raise CATCHABLE errors --------
;; An implicit derivative taken at a non-stationary point is a plausible wrong
;; number, so the forward must refuse rather than hand one downstream. These
;; must be `guard`-able conditions, not process exits.
(define outside (make-tensor '(2 2) 0.0))
(tensor-set! outside '(0 0) 1.5)
(check "point outside the ball raises a catchable error"
       (eq? 'caught (guard (e (#t 'caught)) (frechet-mean outside w-eq -1.0))))

(define w-zero (make-tensor '(2) 0.0))
(check "zero total weight raises a catchable error"
       (eq? 'caught (guard (e (#t 'caught)) (frechet-mean sym w-zero -1.0))))

(check "positive curvature raises a catchable error"
       (eq? 'caught (guard (e (#t 'caught)) (frechet-mean sym w-eq 1.0))))

;; ---- Case 6: near the boundary the mean is REFUSED, not approximated -----
;; The ball's ambient f64 coordinates cannot resolve hyperbolic position near
;; the boundary: one ulp of x is O(0.1) units of arc length once |x| is within
;; ~1e-13 of 1, and the stationarity residual reaches the precision floor of its
;; own evaluation well before that. Three separate things used to let a wrong
;; answer out of this regime, and each has a case here.
;;
;; The reference values are the 1-D closed form again: points at +/-x0 with
;; weights 2:1 have the mean tanh(artanh(x0)/3), evaluated to 20 digits.
(define (mean-2to1 x0)
  (let ((pts (make-tensor '(2 2) 0.0))
        (w   (make-tensor '(2) 1.0)))
    (tensor-set! pts '(0 0) x0)
    (tensor-set! pts '(1 0) (- x0))
    (tensor-set! w '(0) 2.0)
    (guard (e (#t 'caught)) (tensor-ref (frechet-mean pts w -1.0) '(0)))))

;; 6a. Inside the resolvable region the answer is accurate, not merely accepted.
;; This is the control: the refusals below must not be a blanket refusal of
;; everything near the boundary.
(check "x0=0.9 matches the closed form"
       (approx= (mean-2to1 0.9) 0.45480342898199512 1e-14))
(check "x0=1-1e-3 matches the closed form"
       (approx= (mean-2to1 0.999) 0.85290992286246344 1e-12))
(check "x0=1-1e-6 matches the closed form"
       (approx= (mean-2to1 0.999999) 0.98425098685564609 1e-10))

;; 6b. Residual scale. The gate compares the residual against wsum*(1 + max|log|)
;; in RIEMANNIAN units. Measured in the ambient coordinates the logs are stored
;; in, the conformal factor collapses every |log| toward zero as the mean
;; approaches the boundary, the absolute floor swamps the relative term, and the
;; bar degenerates to something a mean wrong by a whole unit of hyperbolic
;; distance satisfies. With the ambient scale this returned 0.99841382813968
;; against a true mean of 0.99841385788455 and called it converged.
(check "x0=1-1e-9 is refused, not answered to 3e-8"
       (eq? 'caught (mean-2to1 0.999999999)))

;; 6c. Noise-floor lottery. One sub-tolerance residual sample is not evidence:
;; on this input the residual oscillated between 2.4e-7 and 4.9e-6 for 131
;; iterations and then produced a single 9.86e-10 draw by rounding luck, which a
;; one-sample test accepted. Acceptance now needs two consecutive sub-tolerance
;; iterates, and a residual that stops improving ends the run.
(check "x0=1-1e-7 is refused rather than drawing until it passes"
       (eq? 'caught (mean-2to1 0.9999999)))

;; 6d. Fabricated log magnitude. u = (-mu) (+)_c x is formed by cancellation, so
;; a mu and an x more than ~19 units of hyperbolic distance apart drive |u| to 1
;; even though both are strictly interior. artanh has no value there. The log map
;; used to clamp to 1-1e-15 and hand back a fabricated magnitude of ~17.6, which
;; the iteration then converged on; it now reports no finite log and the caller
;; refuses. x0 one ulp inside the boundary reaches this on the first iteration.
(check "one ulp inside the boundary is refused, not clamped"
       (eq? 'caught (mean-2to1 0.9999999999999999)))

(display "frechet-mean surface regression complete")
(newline)
