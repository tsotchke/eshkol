;; tests/vm/vm_exact_ad_test.esk
;; SW-85: forward-mode AD at an EXACT point must answer exactly on the VM,
;; agreeing with native in value AND in exactness.
;;
;; Before this, the VM's forward-mode carrier was two raw C doubles, so an
;; exact point was flattened at the SEED: `(derivative (lambda (x) (* x x)) 1/3)`
;; answered 0.6666666666666666 on the VM where native answered 2/3. The two are
;; numerically EQUAL — (= 2/3 0.6666666666666666) is #t — so nothing raised and
;; no value differential could see it. Only `exact?` separates them, which is
;; what makes this file assert exactness explicitly rather than by tolerance.
;;
;; The contagion half matters just as much: the moment a transcendental runs,
;; the result must go back to being INEXACT. An "always exact" answer would be
;; just as wrong as an always-inexact one, so the demotion cases below are
;; negative controls, not filler.
;;
;; Runs identically on the VM and on native — that is the entire point.

(define pass 0)
(define fail 0)

(define (chk name got expect want-exact)
  (if (and (= got expect) (eq? (exact? got) want-exact))
      (set! pass (+ pass 1))
      (begin (set! fail (+ fail 1))
             (display "FAIL ") (display name)
             (display " got=") (display got)
             (display " exact?=") (display (exact? got))
             (display " expect=") (display expect)
             (display " want-exact?=") (display want-exact)
             (newline))))

;; ── exact scalar points: derivative ──────────────────────────────────────
(define (sq x) (* x x))
(chk "d/dx x^2 at 1/3"      (derivative sq (/ 1 3))  (/ 2 3)  #t)
(chk "d/dx x^2 at 2"        (derivative sq 2)        4        #t)
(chk "d/dx x^2 at -3/5"     (derivative sq (/ -3 5)) (/ -6 5) #t)

;; the coordinator's reported case: 8/3 * x at 1/3 style, via a cubic
(define (cube x) (* x (* x x)))
(chk "d/dx x^3 at 1/3"      (derivative cube (/ 1 3)) (/ 1 3) #t)

;; ── + and - keep exactness ───────────────────────────────────────────────
(define (poly x) (+ (* 3 (* x x)) (- (* 2 x) 5)))
;; p'(x) = 6x + 2 ; at 1/3 -> 4
(chk "d/dx 3x^2+2x-5 at 1/3" (derivative poly (/ 1 3)) 4 #t)

;; ── division keeps exactness ─────────────────────────────────────────────
(define (recip x) (/ 1 x))
;; d/dx 1/x = -1/x^2 ; at 1/3 -> -9
(chk "d/dx 1/x at 1/3"       (derivative recip (/ 1 3)) -9 #t)

;; ── integer expt keeps exactness ─────────────────────────────────────────
(define (p5 x) (expt x 5))
;; 5x^4 at 2 -> 80
(chk "d/dx x^5 at 2"         (derivative p5 2) 80 #t)

;; ── gradient agrees with derivative, exactly ─────────────────────────────
(chk "grad x^2 at 1/3"       (gradient sq (/ 1 3)) (/ 2 3) #t)
(chk "grad 3x^2+2x-5 at 1/3" (gradient poly (/ 1 3)) 4 #t)

;; The higher-order VM surface uses the same exact carrier, so derivative-n
;; order one is identical to derivative and higher coefficients remain exact.
(chk "derivative-n x^2 at 1/3, n=1"
     (derivative-n sq (/ 1 3) 1) (/ 2 3) #t)
(chk "derivative-n x^5 at 2, n=3"
     (derivative-n p5 2 3) 240 #t)
(define (geom x) (/ 1 (- 1 x)))
(chk "derivative-n 1/(1-x) at 1/2, n=2"
     (derivative-n geom (/ 1 2) 2) 16 #t)
(chk "derivative-n 1/(1-x) at 1/2, n=3"
     (derivative-n geom (/ 1 2) 3) 96 #t)
(chk "taylor x^2 c0 at 1/3"
     (car (taylor sq (/ 1 3) 1)) (/ 1 9) #t)
(chk "taylor x^2 c1 at 1/3"
     (car (cdr (taylor sq (/ 1 3) 1))) (/ 2 3) #t)

;; ── negative controls: exactness CONTAGION must demote ───────────────────
;; A transcendental makes the answer inexact even at an exact point. This is
;; R7RS behaviour and matches native's COEFF_F64 demotion; an always-exact
;; carrier would pass every check above and still be wrong here.
(define (sinf x) (sin x))
(if (inexact? (derivative sinf 0))
    (set! pass (+ pass 1))
    (begin (set! fail (+ fail 1))
           (display "FAIL d/dx sin at exact 0 must be INEXACT") (newline)))

(define (mixed x) (+ (* x x) (sin x)))
(if (inexact? (derivative mixed 1))
    (set! pass (+ pass 1))
    (begin (set! fail (+ fail 1))
           (display "FAIL d/dx (x^2 + sin x) at exact 1 must be INEXACT") (newline)))

;; An INEXACT point must stay inexact even through exact-only arithmetic —
;; the other direction of the same contagion rule.
(if (inexact? (derivative sq 2.0))
    (set! pass (+ pass 1))
    (begin (set! fail (+ fail 1))
           (display "FAIL d/dx x^2 at INEXACT 2.0 must stay inexact") (newline)))

;; and its value must still be right
(chk "d/dx x^2 at 2.0 (inexact)" (derivative sq 2.0) 4.0 #f)

(display "----") (newline)
(display "vm-exact-ad tests: ") (display pass) (display " passed, ")
(display fail) (display " failed") (newline)

;; Count ratchet, same discipline as the Taylor suites: "0 failed" alone is
;; satisfied by a run that executed nothing.
;; 19 = 16 exactness assertions (value AND exact? together) + 3 contagion
;; negative controls (two transcendental demotions, one inexact-point).
(define expected-checks 19)
(if (and (= fail 0) (= pass expected-checks))
    (begin (display "PASS: exact AD at exact points ")
           (display pass) (display "/") (display expected-checks)
           (display " checks") (newline))
    (begin (display "FAIL: exact AD at exact points ")
           (display pass) (display "/") (display expected-checks)
           (display " passed, ") (display fail) (display " failed") (newline)))
