;; SW-217 (VM): a closure arity mismatch is a catchable condition carrying the
;; canonical "Arity mismatch: " wording shared with native, not a fatal exit.
(define (check label got want)
  (if (equal? got want) #t
      (begin (display "FAIL: ") (display label) (display " got ") (write got)
             (newline) (error "closure arity mismatch" label))))
(define (message-of thunk)
  (guard (e ((error-object? e) (error-object-message e))) (thunk)))
(define (h1 f a) (f a))
(define (h2 f a b) (f a b))
(check "surplus" (message-of (lambda () (h2 (lambda (x) x) 1 2)))
       "Arity mismatch: <procedure> expects 1 argument but got 2")
(check "missing" (message-of (lambda () (h1 (lambda (x y) x) 1)))
       "Arity mismatch: <procedure> expects 2 arguments but got 1")
(check "direct" (message-of (lambda () ((lambda (x) x) 1 2)))
       "Arity mismatch: <procedure> expects 1 argument but got 2")
(check "variadic minimum" (message-of (lambda () (h1 (lambda (a b . r) a) 1)))
       "Arity mismatch: <procedure> expects at least 2 arguments but got 1")
(check "tail position" (message-of (lambda () (let loop ((f (lambda (x) x))) (f 1 2))))
       "Arity mismatch: <procedure> expects 1 argument but got 2")
(check "non-procedure" (message-of (lambda () (h1 5 1)))
       "Type error in apply: expected procedure")
(display "closure arity catchable PASS")
(newline)
