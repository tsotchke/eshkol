;; Standalone VM portable geometric fallback regression.
;; These assertions exercise the no-qLLM path: arena-backed manifold handles,
;; constant-curvature tensors, pullbacks, and simple tangent-space updates.

(define h (make-hyperbolic-manifold 2 -1.0))
(define s (make-spherical-manifold 2))
(define e (make-euclidean-manifold 3))
(define p (make-tensor '(2) 1.0))
(define j (make-tensor '(2 2) 1.0))

(display (if h "PASS" "FAIL")) (display ": hyperbolic handle") (newline)
(display (if (= (manifold-type h) 1) "PASS" "FAIL")) (display ": manifold type") (newline)
(display (if (= (manifold-dim h) 2) "PASS" "FAIL")) (display ": manifold dim") (newline)
;; SW-72: manifold-dim (native id 858, vm_geometric_manifold_dim) used to
;; return 0 unconditionally under ESHKOL_GEOMETRIC_ENABLED regardless of the
;; manifold's real dimension. Cover a second manifold (Euclidean, distinct
;; dim) so a regression that hardcodes one dimension cannot pass silently;
;; the companion native-side check lives in tests/manifold/manifold_test.esk.
(display (if (= (manifold-dim e) 3) "PASS" "FAIL")) (display ": manifold dim euclidean") (newline)
(display (if (= (get-curvature h) -1.0) "PASS" "FAIL")) (display ": get curvature") (newline)

(define metric (metric-tensor h))
(display (if (= (tensor-ref metric 0) 1.0) "PASS" "FAIL")) (display ": metric diag 0") (newline)
(display (if (= (tensor-ref metric 1) 0.0) "PASS" "FAIL")) (display ": metric offdiag") (newline)
(display (if (= (tensor-ref metric 3) 1.0) "PASS" "FAIL")) (display ": metric diag 1") (newline)

(define gamma (christoffel h p))
(display (if (= (tensor-ref gamma 0) 1.0) "PASS" "FAIL")) (display ": christoffel 000") (newline)
(display (if (= (tensor-ref gamma 3) -1.0) "PASS" "FAIL")) (display ": christoffel 011") (newline)

(display (if (= (ricci-scalar h) -2.0) "PASS" "FAIL")) (display ": ricci scalar") (newline)
(display (if (= (sectional-curvature h p p) -1.0) "PASS" "FAIL")) (display ": sectional curvature") (newline)

(define pb (pullback p j))
(display (if (= (tensor-ref pb 0) 2.0) "PASS" "FAIL")) (display ": pullback 0") (newline)
(display (if (= (tensor-ref pb 1) 2.0) "PASS" "FAIL")) (display ": pullback 1") (newline)

(define wedge (wedge-product p p))
(display (if (= (tensor-ref wedge 0) 0.0) "PASS" "FAIL")) (display ": wedge antisymmetry") (newline)

(define interior (interior-product p p))
(display (if (= (tensor-ref interior 0) 2.0) "PASS" "FAIL")) (display ": interior product") (newline)

(define step (riemannian-sgd-step p p 0.25 -1.0))
(display (if (= (tensor-ref step 0) 0.75) "PASS" "FAIL")) (display ": riemannian sgd") (newline)

(define probs (curvature-softmax (make-tensor '(2) 0.0) -1.0))
(display (if (= (tensor-ref probs 0) 0.5) "PASS" "FAIL")) (display ": curvature softmax 0") (newline)
(display (if (= (tensor-ref probs 1) 0.5) "PASS" "FAIL")) (display ": curvature softmax 1") (newline)

(define quat (so3-exp (make-tensor '(3) 0.0)))
(display (if (= (tensor-ref quat 0) 1.0) "PASS" "FAIL")) (display ": so3 zero exp") (newline)

(set-curvature! h -0.5)
(display (if (= (get-curvature h) -0.5) "PASS" "FAIL")) (display ": set curvature") (newline)
(display (if (= (transition-geometry! h -1.0 0.5) -0.75) "PASS" "FAIL")) (display ": transition geometry") (newline)
(display (if (= (manifold-interpolate h s 0.5) 0.125) "PASS" "FAIL")) (display ": manifold interpolate") (newline)

;; The spherical cut locus is a genuine domain error on both VM dispatch
;; bodies. A clamped acos value of pi is not a substitute for a missing log
;; direction, so both public operations must raise a catchable condition.
(define sphere-x (tensor 3 1.0 0.0 0.0))
(define sphere-y (tensor 3 -1.0 0.0 0.0))
(define distance-cut (guard (e (#t 'caught))
                            (great-circle-distance sphere-x sphere-y)))
(define log-cut (guard (e (#t 'caught))
                       (spherical-log sphere-x sphere-y)))
(display (if (and (eq? distance-cut 'caught) (eq? log-cut 'caught))
             "PASS" "FAIL")) (display ": spherical cut locus refuses") (newline)

;; The angle path must normalize before multiplying or squaring.  These are
;; orthogonal nonzero vectors at opposite ends of binary64's exponent range;
;; raw dot/norm arithmetic would underflow or overflow and report zero.
(define half-pi (/ (acos -1.0) 2.0))
(define sub-x (tensor 2 4.9406564584124654e-324 0.0))
(define sub-y (tensor 2 0.0 4.9406564584124654e-324))
(define wide-x (tensor 2 1e300 0.0))
(define wide-y (tensor 2 0.0 1e-300))
(define (angle-close? a b) (< (abs (- a b)) 1e-15))
(display (if (and (angle-close? (great-circle-distance sub-x sub-y) half-pi)
                  (angle-close? (great-circle-distance wide-x wide-y) half-pi))
             "PASS" "FAIL")) (display ": scale-invariant spherical angle") (newline)

;; Bit-exact denormal-pivot counterexample. The old exact-collinearity test
;; multiplied a denormal pivot by every normalized coordinate, so the products
;; all underflowed to zero and this valid theta ~= 3.0352963674903606 pair was
;; falsely reported as an antipode.
(define denormal-x
  (tensor 3 4.9406564584124654e-324 0.99498743710662 -0.1))
(define denormal-y
  (tensor 3 -4.9406564584124654e-324 -0.9787619731068428 0.205))
(define denormal-angle
  (guard (e (#t 'caught))
         (great-circle-distance denormal-x denormal-y)))
(display (if (and (number? denormal-angle)
                  (angle-close? denormal-angle 3.0352963674903606))
             "PASS" "FAIL"))
(display ": denormal pivot keeps valid spherical pair") (newline)

;; Non-finite coordinates follow IEEE propagation rather than the old
;; !(norm > 0) zero fallback, in both the portable and linked VM dispatches.
(define nan-angle
  (great-circle-distance (tensor 2 +nan.0 1.0)
                         (tensor 2 0.0 1.0)))
(display (if (nan? nan-angle) "PASS" "FAIL"))
(display ": NaN spherical coordinate propagates") (newline)

(manifold-destroy! h)
(display "PASS: geometric fallback numeric regression complete")
(newline)
