;; Exercise the successful agent SQLite ABI through the standalone VM. Missing
;; SQLite symbols make open fail, so this fixture cannot pass by catching an
;; unavailable-host error.
(require agent.sqlite)
(define passed 0)
(define failed 0)
(define (check name ok)
  (if ok
      (set! passed (+ passed 1))
      (begin (set! failed (+ failed 1))
             (display "FAIL: ") (display name) (newline))))
(define (raises? thunk) (guard (condition (else #t)) (thunk) #f))

(define db (sqlite-open ":memory:"))
(check "SQLite host symbol is linked" (> db 0))
(check "table creation succeeds" (= (sqlite-exec db "CREATE TABLE t(value TEXT)") 0))
(define payload (string-append "left" (string (integer->char 0)) "λright"))
(define insert (sqlite-prepare db "INSERT INTO t(value) VALUES(?)"))
(check "prepare insert succeeds" (> insert 0))
(check "VM string length is passed to SQLite with embedded NUL" (= (sqlite-bind-text insert 1 payload) 0))
(check "insert reaches SQLITE_DONE" (= (sqlite-step-code insert) SQLITE_DONE))
(sqlite-finalize insert)

(define query (sqlite-prepare db "SELECT value AS \"column λ\" FROM t"))
(check "prepare query succeeds" (> query 0))
(check "query reaches SQLITE_ROW" (sqlite-step query))
(check "UTF-8 column name round-trips"
  (string=? (sqlite-column-name query 0) "column λ"))
(check "UTF-8 and embedded NUL column text round-trips"
  (string=? (sqlite-column-text query 0) payload))
(check "query reaches SQLITE_DONE" (not (sqlite-step query)))
(sqlite-finalize query)

(check "invalid statement text access raises"
  (raises? (lambda () (sqlite-column-text 999999 0))))
(check "invalid statement name access raises"
  (raises? (lambda () (sqlite-column-name 999999 0))))
(check "invalid database error access raises"
  (raises? (lambda () (sqlite-last-error 999999))))
(sqlite-close db)

(display "Checks: ") (display passed) (newline)
(if (> failed 0)
    (error "typed VM SQLite extern regression failed")
    (display "RESULT: PASS\n"))
