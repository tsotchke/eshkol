;;; fib_checksum.esk -- a bare-metal Eshkol program.
;;;
;;; Built with a freestanding profile for every reference board (see
;;; docs/platform/EMBEDDED_TARGETS.md):
;;;   eshkol-run --profile freestanding-mcu-native --target <triple> \
;;;              -o fib_checksum.o tests/embedded/fib_checksum.esk
;;; It uses only machine-typed integer arithmetic (u32, modulo 2^32), a
;;; board-provided console register written with volatile-store!, and a
;;; C-ABI entry point `uint32_t eshkol_main(void)` that the runtime
;;; subset's startup code calls.  The exit status is 0 when the checksum
;;; of fib(0..63) (computed in u32) equals 429027928.

(extern ptr board-console :real eshkol_board_console_register)

(define (emit (c : u32)) : null
  (volatile-store! u8 (board-console) c))

(define (emit-decimal (n : u32)) : null
  (begin
    (if (>= n 10) (emit-decimal (quotient n 10)) '())
    (emit (+ 48 (remainder n 10)))))

(define (fib (n : u32) (a : u32) (b : u32)) : u32
  (if (= n 0) a (fib (- n 1) b (+ a b))))

(define (checksum (i : u32) (acc : u32)) : u32
  (if (= i 64)
      acc
      (checksum (+ i 1) (bitwise-xor (* acc 31) (fib i 0 1)))))

(define (eshkol-main) : u32
  (let ((sum (checksum 0 0)))
    (begin
      (emit 101)
      (emit 115)
      (emit 104)
      (emit 107)
      (emit 111)
      (emit 108)
      (emit 32)
      (emit 98)
      (emit 97)
      (emit 114)
      (emit 101)
      (emit 45)
      (emit 109)
      (emit 101)
      (emit 116)
      (emit 97)
      (emit 108)
      (emit 32)
      (emit 102)
      (emit 105)
      (emit 98)
      (emit 32)
      (emit 99)
      (emit 104)
      (emit 101)
      (emit 99)
      (emit 107)
      (emit 115)
      (emit 117)
      (emit 109)
      (emit 32)
      (emit-decimal sum)
      (emit 10)
      (if (= sum 429027928) 0 1)))
  :export-symbol eshkol_main)
