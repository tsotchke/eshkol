;;; fib_checksum_x86_64.esk -- bare-metal x86_64 kernel-profile program.
;;;
;;; Built with `--profile freestanding-kernel-native --target x86_64-unknown-none`:
;;; enforces `-mno-red-zone`, `no-implicit-float`, soft-float/no-SSE, and static
;;; NoAlloc/NoFPU verification, driving COM1 (0x3F8) directly via Eshkol's
;;; typed privileged `target-intrinsic` (`eshkol.cpu.outb`).

(define (emit (c : u32)) : null
  (target-intrinsic null "eshkol.cpu.outb" u16 1016 u8 c))

(define (emit-decimal (n : u32)) : null
  (begin
    (if (>= n 10) (emit-decimal (quotient n 10)) '())
    (emit (+ 48 (remainder n 10)))))

(define (fib (n : u32) (a : u32) (b : u32)) : u32
  (if (= n 0) a (fib (- n 1) b (+ a b))))

(define (checksum (i : u32) (acc : u32)) : u32
  (if (= i 64)
      acc
      (checksum (+ i 1) (bitwise-xor (* acc 31) (fib i 0 1)))))

(define (eshkol-main) : u32
  (let ((sum (checksum 0 0)))
    (begin
      (emit 101) (emit 115) (emit 104) (emit 107) (emit 111) (emit 108)
      (emit 32)  (emit 98)  (emit 97)  (emit 114) (emit 101) (emit 45)
      (emit 109) (emit 101) (emit 116) (emit 97)  (emit 108) (emit 32)
      (emit 102) (emit 105) (emit 98)  (emit 32)  (emit 99)  (emit 104)
      (emit 101) (emit 99)  (emit 107) (emit 115) (emit 117) (emit 109)
      (emit 32)
      (emit-decimal sum)
      (emit 10)
      (if (= sum 429027928) 0 1)))
  :export-symbol eshkol_main)
