;; Direct list->string must encode Unicode characters as UTF-8 bytes while
;; retaining embedded NULs and reporting character indexes.
(define value (list->string (list #\A (integer->char 0) (integer->char 955) #\Z)))
(define constructed (string #\A (integer->char 0) (integer->char 955) #\Z))
(if (not (= (string-length value) 4)) (error "list->string Unicode length"))
(if (not (= (char->integer (string-ref value 0)) 65)) (error "list->string ASCII character"))
(if (not (= (char->integer (string-ref value 1)) 0)) (error "list->string embedded NUL"))
(if (not (= (char->integer (string-ref value 2)) 955)) (error "list->string Unicode character"))
(if (not (= (string-find value "Z") 3)) (error "list->string suffix index"))
(if (not (string=? value constructed)) (error "list->string and string parity"))
(define widths (list->string (list (integer->char 127) (integer->char 128)
                                   (integer->char 2047) (integer->char 2048)
                                   (integer->char 65535) (integer->char 65536)
                                   (integer->char 128512))))
(if (not (= (string-length widths) 7)) (error "list->string UTF-8 width transitions"))
(if (not (= (char->integer (string-ref widths 0)) 127)) (error "string-ref ASCII prefix"))
(if (not (= (char->integer (string-ref widths 1)) 128)) (error "string-ref two-byte character"))
(if (not (= (char->integer (string-ref widths 2)) 2047)) (error "string-ref two-byte maximum"))
(if (not (= (char->integer (string-ref widths 3)) 2048)) (error "string-ref three-byte character"))
(if (not (= (char->integer (string-ref widths 4)) 65535)) (error "string-ref three-byte maximum"))
(if (not (= (char->integer (string-ref widths 5)) 65536)) (error "string-ref four-byte character"))
(if (not (= (char->integer (string-ref widths 6)) 128512)) (error "string-ref four-byte character 2"))
(display "PASS: direct list->string Unicode and NUL\n")
