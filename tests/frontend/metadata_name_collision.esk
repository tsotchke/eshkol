(require stdlib)
(define (__eshkol_metadata_cons x) (+ x 1))
(define (__eshkol_metadata_cons.1 x y z) (+ x y z))
(define (__eshkol_metadata_cons.2 x) (+ x 3))
(define (make-adder x) (lambda (y) (+ x y)))
(define add-four (make-adder 4))
(define checks 0)
(define (check value)
  (if value (set! checks (+ checks 1))
      (begin (display "FAIL: metadata helper identity\n") (exit 1))))
(check (= (__eshkol_metadata_cons 6) 7))
(check (= (__eshkol_metadata_cons.1 1 2 3) 6))
(check (= (__eshkol_metadata_cons.2 4) 7))
(check (= (add-four 3) 7))
(check (equal? (map __eshkol_metadata_cons '(1 2 3)) '(2 3 4)))
(display "Checks: ") (display checks) (newline)
(display "RESULT: PASS\n")
