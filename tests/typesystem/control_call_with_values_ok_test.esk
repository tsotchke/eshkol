;; Type System Test: well-typed code inside `call-with-values`'s producer and consumer stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (via-values x)
  (call-with-values (lambda () (values x 2))
                    (lambda (a b) (area a b))))
(display (via-values 3))
(newline)

(display (area 2 3))
(newline)
