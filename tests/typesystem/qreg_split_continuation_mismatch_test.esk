;; Type System Test: qsplit's continuation receives qreg<1> and qreg<2>; declaring qreg<2> is rejected
;; EXPECT-MODE: default
;; EXPECT-COMPILE: fail
;; EXPECT-STDERR: quantum register dimension mismatch in parameter 1 of the procedure passed to 'qsplit': it receives qreg<1>, declared qreg<2>
;; EXPECT-STDERR: Refusing to generate code

(require core.quantum)

(define-quantum-region qr (split-wrong)
  (qsplit (qalloc qr 3) 1
          (lambda ((a : qreg<2>) (b : qreg<2>))
            (append (qmeasure a) (qmeasure b)))))

(display (split-wrong))
