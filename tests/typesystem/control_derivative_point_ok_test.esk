;; Type System Test: well-typed code inside a `derivative` evaluation point stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (slope-at x)
  (derivative (lambda (t) (* t t)) (area x 2.0)))
(display (slope-at 3.0))
(newline)

(display (area 2 3))
(newline)
