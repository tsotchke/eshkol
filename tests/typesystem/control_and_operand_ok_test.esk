;; Type System Test: well-typed code inside an `and` operand stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (checked-area x)
  (and (number? x) (area x 2)))
(display (checked-area 3))
(newline)

(display (area 2 3))
(newline)
