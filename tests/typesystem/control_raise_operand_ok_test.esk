;; Type System Test: well-typed code inside a `raise` operand stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (fail-with x)
  (guard (e (#t e))
    (raise (area x 2))))
(display (fail-with 3))
(newline)

(display (area 2 3))
(newline)
