;; Type System Test: well-typed code inside an `unless` test and body stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (maybe-label x)
  (unless (number? x)
    (label "not a number")))
(display (maybe-label "s"))
(newline)

(display (area 2 3))
(newline)
