;; Type System Test: an ordinary (non-loop) function called with a genuinely
;; incompatible argument is reported. Guards the call-site check that the
;; named-let widening rule sits in front of.
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-STDERR: [WARN]
;; EXPECT-STDERR: argument 1 of 'area': expected Number, got String

(define (area (w : number) (h : number)) (* w h))

(define (never-called) (area "wide" 3))

(display (area 2 3))
(newline)
