;; Type System Test: well-typed code inside a `guard` body, handler test and handler body stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (safe-area x)
  (guard (e ((string? e) (label e))
            (else 0))
    (area x 2)))
(display (safe-area 3))
(newline)

(display (area 2 3))
(newline)
