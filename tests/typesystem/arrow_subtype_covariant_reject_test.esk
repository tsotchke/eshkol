;; Type System Test: arrow subtyping is covariant in the result, so a function
;; that returns a Number cannot stand in for one that must return an integer,
;; and one that returns a String cannot stand in for one that returns a Number.
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-STDERR: [WARN]
;; EXPECT-STDERR: argument 1 of 'use-int-result': expected (-> Number Int64), got (-> Number Number)
;; EXPECT-STDERR: argument 1 of 'use-num-fn': expected (-> Number Number), got (-> Number String)

(define (gives-number (x : number)) : number (* x 1.5))
(define (gives-string (x : number)) : string "s")
(define (use-int-result (f : (-> number integer))) (f 2))
(define (use-num-fn (f : (-> number number))) (f 2.5))

(define (never-called)
  (use-int-result gives-number)
  (use-num-fn gives-string))

(display (gives-number 2))
(newline)
