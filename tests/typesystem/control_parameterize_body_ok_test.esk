;; Type System Test: well-typed code inside a `parameterize` body stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define width (make-parameter 1))
(define (scaled x)
  (parameterize ((width 2))
    (area x (width))))
(display (scaled 3))
(newline)

(display (area 2 3))
(newline)
