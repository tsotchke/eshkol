;; Type System Test: a continuation receiving registers must declare them, or their linearity would go unchecked
;; EXPECT-MODE: default
;; EXPECT-COMPILE: fail
;; EXPECT-STDERR: parameter 1 of the procedure passed to 'qsplit' receives qreg<1>; declare it with that type
;; EXPECT-STDERR: Refusing to generate code

(require core.quantum)

(define-quantum-region qr (split-untyped)
  (qsplit (qalloc qr 3) 1
          (lambda (a b)
            (append (qmeasure a) (qmeasure b)))))

(display (split-untyped))
