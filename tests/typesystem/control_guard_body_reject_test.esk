;; Type System Test: a wrong argument inside a `guard` body, handler test and handler body is reported, with the
;; same message it gets at top level. The checker used to give this form a
;; fixed type without synthesizing its subexpressions, so it was silent.
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-STDERR: [WARN]
;; EXPECT-STDERR: argument 1 of 'label': expected String, got Int64
;; EXPECT-STDERR: argument 1 of 'area': expected Number, got String
;; EXPECT-STDERR: argument 2 of 'area': expected Number, got String

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (never-called)
  (guard (e ((label 42) (area 5 "tall"))
            (else 0))
    (area "wide" 3)))

(display (area 2 3))
(newline)
