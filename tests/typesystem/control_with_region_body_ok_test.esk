;; Type System Test: well-typed code inside a `with-region` body stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (regional x)
  (with-region (area x 2)))
(display (regional 3))
(newline)

(display (area 2 3))
(newline)
