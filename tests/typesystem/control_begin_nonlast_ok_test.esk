;; Type System Test: well-typed code inside a non-final expression of `begin` and of a function body stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (two-steps x)
  (begin (area x 2) (label "done")))
(display (two-steps 3))
(newline)

(display (area 2 3))
(newline)
