;; Type System Test: well-typed code inside the value of `set!` stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define total 0)
(define (accumulate! x)
  (set! total (+ total (area x 2))))
(accumulate! 3)
(display total)
(newline)

(display (area 2 3))
(newline)
