;; Type System Test: well-typed code inside a `call/cc` procedure stays silent now that
;; the checker synthesizes it (no false positive from descending into it).
;; EXPECT-MODE: default
;; EXPECT-COMPILE: ok
;; EXPECT-NO-STDERR: Type warning

(define (area (w : number) (h : number)) (* w h))
(define (label (s : string)) (string-length s))

(define (early x)
  (call/cc (lambda (k) (if (number? x) (k (area x 2)) 0))))
(display (early 3))
(newline)

(display (area 2 3))
(newline)
