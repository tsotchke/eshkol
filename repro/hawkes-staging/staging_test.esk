(load "../hawkes-forecast/source.esk")
(load "../hawkes-forecast/forecast.esk")
(load "staging.esk")
(define stage-plan (forecast-plan sc-mean-source))
(define stage-checks 0)
(define (stage-check ok) (if (not ok) (error "Staging check")) (set! stage-checks (+ 1 stage-checks)))
(for-each (lambda (row)
  (let* ((artifact (stage-model-row stage-plan row 4 (string->symbol (string-append "hawkes_row_" (number->string row)))))
         (source (vector-ref artifact 1)) (result (vector-ref artifact 2))
         (program (vector-ref source 1)) (statics (vector-ref source 2)))
    (stage-check (eq? (mix-verification-status (mix-verify-specialization program statics result
                    (mix-verification-limits 1000000 128 512 300000))) 'equivalent))
    (let ((bad (vector-copy result)))
      (vector-set! bad 2 '(program () 987654321))
      (stage-check (eq? (mix-verification-status (mix-verify-specialization program statics bad
                    (mix-verification-limits 1000000 128 512 300000))) 'different)))
    (display "STAGE ") (write artifact) (newline))) '(0 1 2 3))
(display "MODEL ") (write stage-plan) (newline)
(display "PASS staging ") (display stage-checks) (newline)
