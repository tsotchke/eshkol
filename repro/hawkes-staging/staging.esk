;;; Clear denominators at the integer Mix boundary; retain their contract.
;;; Copyright (c) 2026 Richard Hoekstra. SPDX-License-Identifier: MIT
(require core.compiler.mix)
(require core.compiler.mix.verify)
(define (st-power expression degree)
  (if (= degree 0) 1 (list 'prim '* expression (st-power expression (- degree 1)))))
(define (st-var name) (list 'var name))
(define (st-source plan row denominator-w)
  (if (not (and (forecast-plan-valid? plan) (integer? row) (<= 0 row)
         (< row (forecast-plan-dimension plan)) (integer? denominator-w) (> denominator-w 0)
         (equal? (cdr (assq 'parameters (vector-ref plan 1))) '(w))))
      (error "Expected admitted one-parameter model, row and positive denominator"))
  (let* ((proof (vector-ref plan 2)) (linear (vector-ref proof 4))
         (actions (vector-ref linear 4)) (powers (vector-ref proof 1))
         (terms '()) (dynamic (cons 'wn (map (lambda (i) (string->symbol (string-append "u" (number->string i))))
                  (iota (forecast-plan-dimension plan))))))
    (for-each (lambda (action exponent)
      (for-each (lambda (coefficient variable)
        (if (not (= coefficient 0))
          (let ((coefficient (/ coefficient (expt denominator-w (car exponent)))))
            (if (not (fc-rational? coefficient)) (error "Staging coefficient lost exactness"))
            (set! terms (cons (list coefficient (list 'prim '* (st-power (st-var 'wn) (car exponent)) (st-var variable))) terms)))))
        (list-ref (cdr action) row) (cdr dynamic))) actions powers)
    (let* ((terms (reverse terms)) (den (fold-left lcm 1 (map (lambda (t) (denominator (car t))) terms)))
           (names (map (lambda (i) (string->symbol (string-append "c" (number->string i)))) (iota (length terms))))
           (statics (map (lambda (name term) (cons name (* den (car term)))) names terms))
           (body (fold-left (lambda (out term) (list 'prim '+ out term)) 0
                   (map (lambda (name term) (list 'prim '* (st-var name) (cadr term))) names terms))))
      ;; Dynamic ABI includes erased coordinates, for a stable model interface.
      (let ((body (list 'let (map (lambda (name) (list (string->symbol (string-append "keep_" (symbol->string name))) (st-var name))) dynamic) body)))
        (vector 'staged-model-source-v1 (list 'program '() body) statics den dynamic row denominator-w)))))
(define (stage-model-row plan row denominator-w export)
  (let* ((source (st-source plan row denominator-w)) (program (vector-ref source 1)) (statics (vector-ref source 2))
         (start (current-jiffy))
         (result (mix-specialize program statics (mix-options 256 512) (mix-limits 20000000 4096 2000000 300000)))
         (specialization-jiffies (- (current-jiffy) start)) (check-start (current-jiffy))
         (check (mix-verify-specialization program statics result (mix-verification-limits 1000000 128 512 300000)))
         (checking-jiffies (- (current-jiffy) check-start)))
    (if (not (eq? (mix-verification-status check) 'equivalent)) (error "Independent residual replay refused"))
    (let ((emission (mix-emit-eshkol result export)))
      (if (not (eq? (vector-ref emission 1) 'normal)) (error "Model emission refused" (vector-ref emission 1)))
      (vector 'staged-model-row-v1 source result emission specialization-jiffies checking-jiffies (jiffies-per-second)))))
