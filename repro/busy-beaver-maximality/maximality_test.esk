(load "checker.esk")
(define (check-cover file)
  (call-with-input-file file (lambda (port) (bb-verify-cover port))))
(define passed 0)
(define (check label ok) (if (not ok) (error "Maximality assertion failed" label)) (set! passed (+ passed 1)))
(define (check-data text) (let ((port (open-input-string text))) (bb-verify-cover port)))
(define small (check-cover "bb2-cover.sexp"))
(check 'small (equal? small '(2 20736 20736 0 9784 10952 6 6 4 4 445 0 0)))
(display "BB2 ") (write small) (newline)
(define large (check-cover "bb3-cover.sexp"))
(check 'large (equal? large '(3 16777216 16777216 0 7571840 9205376 21 21 6 6 115409 512 216)))
(display "BB3 ") (write large) (newline)
(define missing (check-cover "bb3-withdrawn.sexp"))
(check 'missing (equal? missing '(3 16777216 16777215 1 7571840 9205375 21 unknown 6 unknown 115409 511 216)))
(display "WITHDRAWN ") (write missing) (newline)
(define (refuses? thunk) (guard (e (else #t)) (thunk) #f))
(check 'valid-unknown (equal? (check-data "(bb-cover-v1 2 1) (unknown)") '(2 20736 0 20736 0 0 0 unknown 0 unknown 1 0 0)))
(check 'duplicate-split (refuses? (lambda () (check-data "(bb-cover-v1 2 2) (split 0) (split 0)"))))
(check 'missing-branch (refuses? (lambda () (check-data "(bb-cover-v1 2 2) (split 0) (unknown)"))))
(check 'trailing (refuses? (lambda () (check-data "(bb-cover-v1 2 1) (unknown) (unknown)"))))
(check 'unassigned (refuses? (lambda () (check-data "(bb-cover-v1 2 1) (closed-control)"))))
(define all-zero (make-vector 6 0))
(check 'bad-padding (refuses? (lambda () (bb-regular all-zero 3 '(regular (1 1 0 0) (0 0) (0))))))
(check 'missing-initial (refuses? (lambda () (bb-regular all-zero 3 '(regular (0 0) (0 0) (1))))))
(check 'not-closed (refuses? (lambda () (bb-regular (make-vector 6 4) 3 '(regular (0 0) (0 0) (0))))))
(check 'ngram-initial (refuses? (lambda () (bb-ngram all-zero 3 '(ngram 2 1 (0))))))
(check 'false-halt (refuses? (lambda () (bb-replay all-zero 3 '(halt 6)))))
(check 'valid-regular (bb-regular all-zero 3 '(regular (0 0) (0 0) (0 1))))
(check 'valid-ngram (bb-ngram all-zero 3 '(ngram 2 1 (0 2 16))))
(check 'valid-ray (equal? (bb-replay all-zero 3 '(repeat 0 1 left)) '(nonhalt 0 0)))
(display "PASS bb_maximality ") (display passed) (newline)
