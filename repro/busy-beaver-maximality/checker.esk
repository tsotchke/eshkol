;;; Complete finite-class proof replay. Selected source donation: MIT.
;;; Data is read, never evaluated. No proof discovery or table enumeration.
(define (bb-require ok message) (if (not ok) (error message)))
(define (bb-int? x lo hi) (and (number? x) (exact? x) (integer? x) (<= lo x) (<= x hi)))
(define (bb-list? xs limit)
  (let loop ((xs xs) (left limit))
    (cond ((null? xs) #t) ((or (= left 0) (not (pair? xs))) #f) (else (loop (cdr xs) (- left 1))))))
(define (bb-shape? xs n) (and (bb-list? xs n) (= (length xs) n)))
(define (bb-row digits q read)
  (let ((digit (vector-ref digits (+ (* 2 q) read))))
    (bb-require (>= digit 0) "Proof reads an unspecified source row")
    (list (quotient digit 4) (modulo digit 2) (if (= (modulo (quotient digit 2) 2) 0) -1 1))))
(define (bb-closed-control digits states)
  (let ((seen (make-vector states #f)))
    (let loop ((pending '(0)))
      (if (pair? pending)
          (let ((q (car pending)))
            (if (vector-ref seen q) (loop (cdr pending))
                (begin (vector-set! seen q #t)
                  (let ((a (car (bb-row digits q 0))) (b (car (bb-row digits q 1))))
                    (bb-require (and (< a states) (< b states)) "Halt is control-reachable")
                    (loop (cons a (cons b (cdr pending)))))))))))
  #t)
(define (bb-cell tape position)
  (if (and (<= 0 position) (< position (vector-length tape))) (vector-ref tape position) 0))
(define (bb-replay digits states proof)
  (let* ((halt? (eq? (car proof) 'halt))
         (steps (if halt? (cadr proof) (caddr proof)))
         (start (if halt? 0 (cadr proof))))
    (bb-require (and (bb-int? steps 1 64) (bb-int? start 0 (- steps 1))) "Invalid finite replay budget")
    (let* ((size (+ (* 2 steps) 3)) (tape (make-vector size 0)) (q 0) (head (+ steps 1))
           (before #f) (before-state 0) (before-head 0) (minimum size) (maximum 0))
      (let run ((i 0))
        (if (< i steps)
            (begin
              (bb-require (< q states) "Proof continued after an earlier halt")
              (if (= i start) (begin (set! before (vector-copy tape)) (set! before-state q) (set! before-head head)))
              (if (>= i start) (begin (set! minimum (min minimum head)) (set! maximum (max maximum head))))
              (let ((row (bb-row digits q (vector-ref tape head))))
                (vector-set! tape head (cadr row)) (set! head (+ head (caddr row))) (set! q (car row)))
              (run (+ i 1)))))
      (if halt?
          (begin (bb-require (= q states) "Finite prefix does not halt")
                 (list 'halt steps (fold-left + 0 (vector->list tape))))
          (let* ((side (list-ref proof 3)) (delta (- head before-head)))
            (bb-require (and (< before-state states) (= q before-state)) "Repeat has different control states")
            (cond ((eq? side 'whole)
                   (bb-require (and (= delta 0) (equal? (vector->list before) (vector->list tape))) "Whole configuration does not repeat"))
                  ((eq? side 'right)
                   (bb-require (> delta 0) "Right ray does not move right")
                   (let compare ((x minimum))
                     (if (< x (+ size (abs delta)))
                         (begin (bb-require (= (bb-cell before x) (bb-cell tape (+ x delta))) "Right-infinite suffix differs")
                                (compare (+ x 1))))))
                  ((eq? side 'left)
                   (bb-require (< delta 0) "Left ray does not move left")
                   (let compare ((x (- (abs delta))))
                     (if (<= x maximum)
                         (begin (bb-require (= (bb-cell before x) (bb-cell tape (+ x delta))) "Left-infinite suffix differs")
                                (compare (+ x 1))))))
                  (else (error "Invalid repeat side")))
            '(nonhalt 0 0))))))

(define (bb-dfa table)
  (bb-require (and (bb-list? table 16) (>= (length table) 2) (even? (length table)) (= (car table) 0))
              "Invalid DFA shape or blank padding")
  (let ((n (quotient (length table) 2)))
    (bb-require (every (lambda (x) (bb-int? x 0 (- n 1))) table) "DFA transition outside its states")
    (list->vector table)))
(define (bb-code left q read right states nr)
  (+ right (* nr (+ read (* 2 (+ q (* states left)))))))
(define (bb-regular digits states proof)
  (let* ((left (bb-dfa (cadr proof))) (right (bb-dfa (caddr proof)))
         (nl (quotient (vector-length left) 2)) (nr (quotient (vector-length right) 2))
         (bound (* states 2 nl nr)) (relation (list-ref proof 3)) (seen (make-vector bound #f)))
    (bb-require (and (bb-list? relation bound) (pair? relation)) "Regular relation budget")
    (for-each (lambda (code)
      (bb-require (bb-int? code 0 (- bound 1)) "Invalid regular tuple")
      (bb-require (not (vector-ref seen code)) "Duplicate regular tuple")
      (vector-set! seen code #t)) relation)
    (bb-require (vector-ref seen 0) "Regular relation omits the initial blank configuration")
    (for-each (lambda (code)
      (let* ((r (modulo code nr)) (rest (quotient code nr)) (read (modulo rest 2))
             (rest (quotient rest 2)) (q (modulo rest states)) (l (quotient rest states))
             (row (bb-row digits q read)) (next (car row)) (write (cadr row)) (direction (caddr row)))
        (bb-require (< next states) "Regular invariant reaches halt")
        (let* ((pop (if (= direction 1) right left)) (count (if (= direction 1) nr nl))
               (target (if (= direction 1) r l))
               (pushed (if (= direction 1) (vector-ref left (+ (* 2 l) write))
                                            (vector-ref right (+ (* 2 r) write)))))
          ;; Every DFA preimage is an admissible stack pop, not one chosen pop.
          (let previous ((state 0))
            (if (< state count)
                (begin
                  (let symbols ((symbol 0))
                    (if (< symbol 2)
                        (begin
                          (if (= (vector-ref pop (+ (* 2 state) symbol)) target)
                              (bb-require (vector-ref seen
                                (if (= direction 1) (bb-code pushed next symbol state states nr)
                                                     (bb-code state next symbol pushed states nr)))
                                "Regular relation is not closed under every pop"))
                          (symbols (+ symbol 1)))))
                  (previous (+ state 1)))))))) relation)
    #t))
(define (bb-word code base length)
  (let ((out (make-vector length 0)))
    (let loop ((i (- length 1)) (rest code))
      (if (>= i 0) (begin (vector-set! out i (modulo rest base)) (loop (- i 1) (quotient rest base))))) out))
(define (bb-word-code word base)
  (fold-left (lambda (a b) (+ (* a base) b)) 0 (vector->list word)))
(define (bb-ngram digits states proof)
  (let* ((width (cadr proof)) (modulus (caddr proof)) (words (list-ref proof 3)) (base (* 2 (+ states 1))))
    (bb-require (and (bb-int? width 2 8) (bb-int? modulus 1 8) (bb-list? words 1024)) "Invalid ngram profile")
    (let ((bound (* modulus (expt base width))) (overlap (expt base (- width 1))) (joins 0) (seen '()))
      (for-each (lambda (key)
        (bb-require (and (bb-int? key 0 (- bound 1)) (not (member key seen))) "Invalid or duplicate ngram")
        (bb-require (<= (length (filter (lambda (x) (>= x 2)) (vector->list (bb-word (quotient key modulus) base width)))) 1)
                    "Ngram contains multiple heads")
        (set! seen (cons key seen))) words)
      (let phases ((phase 0))
        (if (< phase modulus) (begin (bb-require (member phase words) "Ngram omits initial blank window") (phases (+ phase 1)))))
      (let heads ((i 0))
        (if (< i width)
            (begin (bb-require (member (+ (* modulus 2 (expt base (- width 1 i))) (modulo (- i) modulus)) words)
                               "Ngram omits an initial head window") (heads (+ i 1)))))
      (for-each (lambda (akey)
        (let* ((a (quotient akey modulus)) (phase (modulo akey modulus)) (next-phase (modulo (+ phase 1) modulus)))
          (for-each (lambda (bkey)
            (let ((b (quotient bkey modulus)))
              (if (and (= (modulo bkey modulus) next-phase) (= (modulo a overlap) (quotient b base)))
                  (begin
                    (set! joins (+ joins 1)) (bb-require (<= joins 100000) "Ngram join budget")
                    (let* ((word (bb-word (+ (* a base) (modulo b base)) base (+ width 1)))
                           (heads 0) (head 0))
                      (let scan ((i 0))
                        (if (<= i width) (begin (if (>= (vector-ref word i) 2) (begin (set! heads (+ heads 1)) (set! head i))) (scan (+ i 1)))))
                      (if (= heads 1)
                          (let* ((token (- (vector-ref word head) 2)) (q (quotient token 2)) (read (modulo token 2))
                                 (row (bb-row digits q read)) (next (car row)) (neighbor (+ head (caddr row))))
                            (bb-require (< next states) "Ngram invariant reaches halt")
                            (vector-set! word head (cadr row))
                            (if (and (<= 0 neighbor) (<= neighbor width))
                                (vector-set! word neighbor (+ 2 (* 2 next) (vector-ref word neighbor))))
                            (let ((after (bb-word-code word base)))
                              (bb-require (and (member (+ (* modulus (quotient after base)) phase) words)
                                               (member (+ (* modulus (modulo after (expt base width))) next-phase) words))
                                          "Ngram invariant is not transition-closed"))))))))) words))) words)
      #t)))

(define (bb-verify-cover port)
  (let ((header (read port)))
    (bb-require (and (bb-shape? header 3) (eq? (car header) 'bb-cover-v1)
                     (bb-int? (cadr header) 2 3) (bb-int? (caddr header) 1 200000)) "Invalid cover header")
    (let* ((states (cadr header)) (nodes (caddr header)) (slots (* states 2)) (radix (* 4 (+ states 1)))
           (digits (make-vector slots -1)) (stats (make-vector 10 0)))
      (define (inc slot amount) (vector-set! stats slot (+ (vector-ref stats slot) amount)))
      (define (visit remaining)
        (with-region
          (inc 3 1) (bb-require (<= (vector-ref stats 3) nodes) "Cover node budget")
          (let* ((node (read port)) (mass (expt radix remaining))
                 (before (+ (vector-ref stats 0) (vector-ref stats 1) (vector-ref stats 2))))
            (bb-require (and (bb-list? node 4) (pair? node)) "Malformed cover node")
            (cond
              ((eq? (car node) 'split)
               (bb-require (and (bb-shape? node 2) (bb-int? (cadr node) 0 (- slots 1))
                                (= (vector-ref digits (cadr node)) -1)) "Split repeats a fixed source row")
               (inc 9 1)
               (let children ((digit 0))
                 (if (< digit radix)
                     (begin (vector-set! digits (cadr node) digit) (visit (- remaining 1)) (children (+ digit 1)))))
               (vector-set! digits (cadr node) -1))
              ((eq? (car node) 'unknown) (bb-require (bb-shape? node 1) "Malformed unknown leaf") (inc 2 mass))
              (else
                (let ((result
                  (cond ((eq? (car node) 'closed-control)
                         (bb-require (bb-shape? node 1) "Malformed control proof") (bb-closed-control digits states) '(nonhalt 0 0))
                        ((memq (car node) '(halt repeat))
                         (bb-require (bb-shape? node (if (eq? (car node) 'halt) 2 4)) "Malformed replay proof") (bb-replay digits states node))
                        ((eq? (car node) 'regular)
                         (bb-require (bb-shape? node 4) "Malformed regular proof") (bb-regular digits states node) (inc 6 1) '(nonhalt 0 0))
                        ((eq? (car node) 'ngram)
                         (bb-require (bb-shape? node 4) "Malformed ngram proof") (bb-ngram digits states node) (inc 7 1) '(nonhalt 0 0))
                        (else (error "Unknown proof rule")))))
                  (inc 8 1)
                  (inc (if (eq? (car result) 'halt) 0 1) mass)
                  (vector-set! stats 4 (max (vector-ref stats 4) (cadr result)))
                  (vector-set! stats 5 (max (vector-ref stats 5) (caddr result))))))
            (bb-require (= mass (- (+ (vector-ref stats 0) (vector-ref stats 1) (vector-ref stats 2)) before))
                        "Cylinder does not partition all source completions"))))
      (visit slots)
      (bb-require (= (vector-ref stats 3) nodes) "Missing cover nodes")
      (bb-require (eof-object? (read port)) "Trailing cover data")
      (let ((unknown (vector-ref stats 2)))
        (list states (expt radix slots) (+ (vector-ref stats 0) (vector-ref stats 1)) unknown
              (vector-ref stats 0) (vector-ref stats 1) (vector-ref stats 4)
              (if (= unknown 0) (vector-ref stats 4) 'unknown) (vector-ref stats 5)
              (if (= unknown 0) (vector-ref stats 5) 'unknown) (vector-ref stats 3)
              (vector-ref stats 6) (vector-ref stats 7))))))
