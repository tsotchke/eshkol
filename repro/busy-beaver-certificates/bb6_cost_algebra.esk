;;; Six-coefficient algebra used by the guarded six-state A.4 cost checker.
;;; This verifies the algebra, not the complete A.4 word theorem or orbit.
(require core.symbolic)
(define (bb6-compose outer inner add mul)
  (let ((po (list-ref outer 0)) (qo (list-ref outer 1)) (ro (list-ref outer 2))
        (uo (list-ref outer 3)) (vo (list-ref outer 4)) (to (list-ref outer 5))
        (pi (list-ref inner 0)) (qi (list-ref inner 1)) (ri (list-ref inner 2))
        (ui (list-ref inner 3)) (vi (list-ref inner 4)) (ti (list-ref inner 5)))
    (list (mul po pi) (add qi (mul qo pi)) (add ri ro)
          (add ui (mul uo (mul pi pi))) (add vi (mul vo pi)) (add ti to))))
(define (bb6-matrix op zero one mul)
  (let ((p (list-ref op 0)) (q (list-ref op 1)) (r (list-ref op 2))
        (u (list-ref op 3)) (v (list-ref op 4)) (t (list-ref op 5)))
    (list (list (mul p p) zero zero zero zero)
          (list zero p zero zero zero) (list zero q one zero r)
          (list u v zero one t) (list zero zero zero zero one))))
(define (bb6-matmul a b zero add mul)
  (map (lambda (row)
    (map (lambda (column)
      (let sum ((i 0) (out zero))
        (if (= i 5) out
          (sum (+ i 1) (add out (mul (list-ref row i) (list-ref (list-ref b i) column)))))))
      '(0 1 2 3 4))) a))
(define (bb6-power op n)
  (let loop ((base op) (n n) (out '(1 0 0 0 0 0)))
    (if (= n 0) out
      (let ((next (if (odd? n) (bb6-compose base out + *) out)) (half (quotient n 2)))
        (loop (if (= half 0) base (bb6-compose base base + *)) half next)))))
(define (bb6-matrix-power op n)
  (let ((base (bb6-matrix op 0 1 *)) (unit (bb6-matrix '(1 0 0 0 0 0) 0 1 *)))
    (let loop ((base base) (n n) (out unit))
      (if (= n 0) out
        (let ((next (if (odd? n) (bb6-matmul base out 0 + *) out)) (half (quotient n 2)))
          (loop (if (= half 0) base (bb6-matmul base base 0 + *)) half next))))))
(define (bb6-same? a b)
  (every (lambda (row) (every (lambda (value) value) row))
         (map (lambda (x y) (map poly=? x y)) a b)))
(define (bb6-check-algebra)
  (let* ((outer (map poly-var '(po qo ro uo vo to)))
         (inner (map poly-var '(pi qi ri ui vi ti)))
         (zero (poly-const 0)) (one (poly-const 1))
         (left (bb6-matrix (bb6-compose outer inner poly+ poly*) zero one poly*))
         (right (bb6-matmul (bb6-matrix outer zero one poly*)
                           (bb6-matrix inner zero one poly*) zero poly+ poly*)))
    (if (not (bb6-same? left right)) (error "Universal cost-carrier identity fails"))
    ;; A damaged composition order must differ as a polynomial, without samples.
    (if (bb6-same? left (bb6-matrix (bb6-compose inner outer poly+ poly*) zero one poly*))
        (error "Noncommuting control did not distinguish order"))
    #t))
(define (bb6-check-powers)
  (for-each
    (lambda (op)
      (for-each
        (lambda (n)
          (let ((structured (bb6-matrix (bb6-power op n) 0 1 *))
                (dense (bb6-matrix-power op n)))
            (if (not (and (every (lambda (row) (every exact? row)) structured)
                          (every (lambda (row) (every exact? row)) dense)
                          (equal? structured dense)))
                (error "Six-coefficient and dense powers differ or lose exactness"))))
        '(0 1 2 11 23 67 1024 4608)))
    '((2 -2 2 4 -4 4) (3/2 0 0 3 -4 0)))
  #t)
