;;; Source-bound weighted word proof for the published five-state champion.
;;; One raw transition includes the write/move into state Z. These rules are
;;; specific to this machine; they do not establish Busy Beaver maximality.
(require core.ring)

(define bb5-table "1RB1LC_1RC1RB_1RD0LE_1LA1LD_1RZ0LA")
(define (bb5-assert ok message) (if (not ok) (error message)))
(define (bb5-aff c . rest) (append (list c) rest (make-list (- 3 (length rest)) 0)))
(define (bb5-add a b) (map + a b))
(define (bb5-scale k a) (map (lambda (x) (* k x)) a))
(define (bb5-natural? a)
  (and (= (length a) 4) (every (lambda (n) (and (integer? n) (exact? n) (>= n 0))) a)))
(define (bb5-power word count) (list word count))
(define (bb5-normalize tokens)
  (let loop ((xs tokens) (out '()))
    (if (null? xs)
        (let trim ((out out))
          (if (and (pair? out) (equal? (caar out) '(0)))
              (trim (cdr out)) (reverse out)))
        (let* ((word (caar xs)) (count (cadar xs))
               (uniform (every (lambda (b) (= b (car word))) word))
               (n (if uniform (bb5-scale (length word) count) count))
               (w (if uniform (list (car word)) word)))
          (bb5-assert (and (pair? word) (every (lambda (b) (or (= b 0) (= b 1))) word)
                          (bb5-natural? n)) "Invalid symbolic word")
          (cond ((equal? n '(0 0 0 0)) (loop (cdr xs) out))
                ((and (pair? out) (equal? w (caar out)))
                 (loop (cdr xs) (cons (bb5-power w (bb5-add n (cadar out))) (cdr out))))
                (else (loop (cdr xs) (cons (bb5-power w n) out))))))))
(define (bb5-config state side left right)
  (vector state side (bb5-normalize left) (bb5-normalize right) (bb5-aff 0) (bb5-aff 0)))
(define (bb5-normalize! c)
  (vector-set! c 2 (bb5-normalize (vector-ref c 2)))
  (vector-set! c 3 (bb5-normalize (vector-ref c 3))) c)
(define (bb5-shape c) (list (vector-ref c 0) (vector-ref c 1) (vector-ref c 2) (vector-ref c 3)))
(define (bb5-g n) (bb5-config 0 -1 '() (list (bb5-power '(1) n))))
(define (bb5-c m n)
  (bb5-config 0 -1 '() (list (bb5-power '(1) m) (bb5-power '(0 0 1) n) (bb5-power '(1) (bb5-aff 1)))))
(define (bb5-take tokens)
  (if (null? tokens) (cons 0 '())
    (let* ((word (caar tokens)) (n (cadar tokens)))
      (bb5-assert (> (car n) 0) "Cannot read a possibly empty symbolic block")
      (cons (car word)
        (bb5-normalize
          (append (if (null? (cdr word)) '() (list (bb5-power (cdr word) (bb5-aff 1))))
                  (list (bb5-power word (bb5-add n (bb5-aff -1)))) (cdr tokens)))))))
(define (bb5-rows text)
  (bb5-assert (= (string-length text) 34) "Wrong transition table length")
  (let state-loop ((s 0) (out '()))
    (if (= s 5) (reverse out)
      (begin
        (if (< s 4) (bb5-assert (char=? (string-ref text (+ (* 7 s) 6)) #\_) "Missing table separator"))
        (let bit-loop ((b 0) (out out))
          (if (= b 2) (state-loop (+ s 1) out)
            (let* ((i (+ (* 7 s) (* 3 b)))
                   (w (- (char->integer (string-ref text i)) (char->integer #\0)))
                   (d (string-ref text (+ i 1))) (c (string-ref text (+ i 2)))
                   (next (if (char=? c #\Z) 5 (- (char->integer c) (char->integer #\A)))))
              (bb5-assert (and (or (= w 0) (= w 1)) (or (char=? d #\R) (char=? d #\L))
                              (<= 0 next 5)) "Malformed machine instruction")
              (bit-loop (+ b 1) (cons (list s b next w (if (char=? d #\R) 1 -1)) out)))))))))
(define (bb5-transition rows state bit)
  (let loop ((rows rows))
    (bb5-assert (pair? rows) "Undefined transition")
    (if (and (= state (caar rows)) (= bit (cadar rows))) (car rows) (loop (cdr rows)))))
(define (bb5-step! c rows)
  (bb5-assert (< (vector-ref c 0) 5) "Stepping after halt")
  (let* ((slot (if (= (vector-ref c 1) -1) 2 3))
         (taken (bb5-take (vector-ref c slot)))
         (row (bb5-transition rows (vector-ref c 0) (car taken)))
         (next (list-ref row 2)) (write (list-ref row 3)) (dir (list-ref row 4)))
    (vector-set! c slot (cdr taken))
    (let ((destination (if (= dir 1) 2 3)))
      (vector-set! c destination (cons (bb5-power (list write) (bb5-aff 1)) (vector-ref c destination))))
    (vector-set! c 0 next) (vector-set! c 1 dir)
    (vector-set! c 4 (bb5-add (vector-ref c 4) (bb5-aff 1)))
    (vector-set! c 5 (bb5-add (vector-ref c 5) (bb5-aff dir)))
    (bb5-normalize! c)))
(define (bb5-steps! c rows n)
  (if (= n 0) c (begin (bb5-step! c rows) (bb5-steps! c rows (- n 1)))))

;; A monotone sweep checks every cell in one period. Disjoint repetition then
;; has additive cost and displacement for every natural repetition count.
;; Sweep records are (state direction input output).
(define (bb5-check-sweep rows sweep)
  (let* ((state (car sweep)) (dir (cadr sweep)) (input (caddr sweep)) (output (cadddr sweep))
         (n (length input)) (cells (list->vector input)) (first (if (= dir 1) 0 (- n 1))))
    (bb5-assert (and (<= 1 n 8) (= n (length output)) (or (= dir 1) (= dir -1))) "Invalid sweep")
    (let loop ((i 0) (head first) (current state))
      (if (= i n)
        (bb5-assert (and (= current state) (= head (if (= dir 1) n -1))
                        (equal? output (vector->list cells))) "Sweep output disagrees with source")
        (begin
          (bb5-assert (<= 0 head (- n 1)) "Sweep leaves frame early")
          (let ((row (bb5-transition rows current (vector-ref cells head))))
            (bb5-assert (= dir (list-ref row 4)) "Nonmonotone sweep")
            (vector-set! cells head (list-ref row 3))
            (loop (+ i 1) (+ head dir) (list-ref row 2))))))))
(define (bb5-sweep! c sweep count)
  (bb5-assert (bb5-natural? count) "Sweep count not universally natural")
  (let* ((dir (cadr sweep)) (input (caddr sweep)) (output (cadddr sweep))
         (slot (if (= dir -1) 2 3)) (other (if (= dir -1) 3 2))
         (side (vector-ref c slot))
         (wanted (bb5-normalize (list (bb5-power (if (= dir -1) (reverse input) input) count)))))
    (bb5-assert (and (= (vector-ref c 0) (car sweep)) (= (vector-ref c 1) dir)) "Sweep port mismatch")
    (if (pair? wanted)
      (begin
        (bb5-assert (and (pair? side) (equal? (caar wanted) (caar side))) "Sweep word mismatch")
        (let ((remaining (bb5-add (cadar side) (bb5-scale -1 (cadar wanted)))))
          (bb5-assert (bb5-natural? remaining) "Sweep exceeds symbolic block")
          (vector-set! c slot (bb5-normalize (cons (bb5-power (caar side) remaining) (cdr side)))))))
    (vector-set! c other (bb5-normalize (cons (bb5-power (if (= dir -1) output (reverse output)) count)
                                             (vector-ref c other))))
    (vector-set! c 4 (bb5-add (vector-ref c 4) (bb5-scale (length input) count)))
    (vector-set! c 5 (bb5-add (vector-ref c 5) (bb5-scale (* dir (length input)) count))) c))

;; (sweeps transfer-cost transfer-head sum0 sum3 branches); branches contain
;; exact polynomial coefficient lists (cost next head), lowest degree first.
(define (bb5-proof)
  (vector '((1 1 (1) (1)) (3 -1 (1) (1)) (0 -1 (1 1 1) (0 0 1)))
          '(8 2 0 0) '(-2 0 0 0) '(0 3 5) '(0 9 5)
          '(((15 19 5) (6 5) (-3 -2)) ((27 25 5) (9 5) (-5 -2)) ((12 6) (-1) (0)))))
(define bb5-P (make-polys rationals 't))
(define (bb5-poly cs)
  (bb5-assert (and (list? cs) (<= (length cs) 4)
                  (every (lambda (x) (and (integer? x) (exact? x))) cs)) "Invalid polynomial witness")
  (ring-poly bb5-P cs))
(define (bb5-shift cs)
  (ring-map-apply (ring-poly-evaluation bb5-P bb5-P (bb5-poly '(1 1))) (bb5-poly cs)))
(define (bb5-check-sum m cs)
  (let ((s (bb5-poly cs)))
    (bb5-assert (and (= (ring-poly-eval s 0) 0)
                    (r= bb5-P (r- bb5-P (bb5-shift cs) s) (bb5-poly (list (+ (* 2 m) 8) 10))))
                "Summation induction fails")))
(define (bb5-check-proof text proof)
  (bb5-assert (equal? text bb5-table) "Certificate is for a different machine")
  (bb5-assert (and (vector? proof) (= (vector-length proof) 6)) "Wrong schema")
  (let* ((rows (bb5-rows text)) (sweeps (vector-ref proof 0))
         (bs (car sweeps)) (ds (cadr sweeps)) (as (caddr sweeps)))
    (bb5-assert (= (length sweeps) 3) "Wrong sweep inventory")
    (for-each (lambda (s) (bb5-check-sweep rows s)) sweeps)
    (let ((c (bb5-c (bb5-aff 0 1) (bb5-aff 1 0 1))))
      (bb5-step! c rows) (bb5-sweep! c bs (bb5-aff 0 1)) (bb5-steps! c rows 3)
      (bb5-sweep! c ds (bb5-aff 3 1)) (bb5-step! c rows)
      (bb5-assert (and (equal? (bb5-shape c) (bb5-shape (bb5-c (bb5-aff 5 1) (bb5-aff 0 0 1))))
                      (equal? (vector-ref c 4) (vector-ref proof 1))
                      (equal? (vector-ref c 4) '(8 2 0 0))
                      (equal? (vector-ref c 5) (vector-ref proof 2))
                      (equal? (vector-ref c 5) '(-2 0 0 0))) "Parametric C transfer fails"))
    (for-each
      (lambda (r)
        (let* ((c (bb5-g (bb5-aff r 0 0 3))) (m (if (= r 0) 0 3))
               (branch (list-ref (vector-ref proof 5) r)))
          (bb5-step! c rows) (bb5-sweep! c bs (bb5-aff r 0 0 3))
          (bb5-steps! c rows 3) (bb5-sweep! c as (bb5-aff 1 0 0 1))
          (bb5-steps! c rows (cond ((= r 0) 0) ((= r 1) 5) (else 3)))
          (if (= r 2)
            (let ((wanted (bb5-config 5 1 (list (bb5-power '(1) (bb5-aff 1)))
                            (list (bb5-power '(0) (bb5-aff 1)) (bb5-power '(1) (bb5-aff 1))
                                  (bb5-power '(0 0 1) (bb5-aff 1 0 0 1)) (bb5-power '(1) (bb5-aff 1))))))
              (bb5-assert (and (equal? (bb5-shape c) (bb5-shape wanted))
                              (equal? (vector-ref c 4) '(12 0 0 6)) (equal? (vector-ref c 5) '(0 0 0 0))
                              (equal? branch '((12 6) (-1) (0)))) "Halting branch fails"))
            (let* ((sum (vector-ref proof (if (= r 0) 3 4)))
                   (prefix (bb5-poly (list (car (vector-ref c 4)) (list-ref (vector-ref c 4) 3))))
                   (total (r+ bb5-P prefix (bb5-shift sum))))
              (bb5-assert (and (equal? (bb5-shape c) (bb5-shape (bb5-c (bb5-aff m) (bb5-aff 1 0 0 1))))
                              (equal? (vector-ref c 4) (bb5-aff (if (= r 0) 7 13) 0 0 6))
                              (equal? (vector-ref c 5) (bb5-aff (if (= r 0) -1 -3)))) "Preparation framing fails")
              (bb5-check-sum m sum)
              (bb5-assert (and (r= bb5-P total (bb5-poly (car branch)))
                              (equal? (cadr branch) (list (+ m 6) 5))
                              (equal? (caddr branch) (list (if (= r 0) -3 -5) -2))) "Composed cost fails")))))
      '(0 1 2))) #t)
(define (bb5-eval cs k) (ring-poly-eval (bb5-poly cs) k))
(define (bb5-query proof n)
  (bb5-assert (and (integer? n) (exact? n) (>= n 0) (< n (expt 2 2048))) "Input exceeds exact domain")
  (let* ((k (quotient n 3)) (r (modulo n 3)) (branch (list-ref (vector-ref proof 5) r))
         (next (bb5-eval (cadr branch) k)))
    (list n k r next (bb5-eval (car branch) k) (bb5-eval (caddr branch) k)
          (if (= r 2) (+ k 4) next))))
(define (bb5-blank proof)
  (bb5-check-proof bb5-table proof)
  (let loop ((n 0) (steps 0) (head 0) (macros 0))
    (bb5-assert (< macros 64) "Macro bound exhausted")
    (let* ((q (bb5-query proof n)) (next (list-ref q 3))
           (count (+ steps (list-ref q 4))) (position (+ head (list-ref q 5))))
      (if (= next -1) (list count position (list-ref q 6) (+ macros 1) (cadr q))
        (loop next count position (+ macros 1))))))
