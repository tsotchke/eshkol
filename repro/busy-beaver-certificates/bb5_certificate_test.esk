;;; Run from this example directory. Certificate checking never calls a TM simulator.
(load "bb5_certificate.esk")
(load "bb6_cost_algebra.esk")
(define bb5-checks 0)
(define (check name value)
  (if (not value) (begin (display "FAIL ") (write name) (newline) (error "BB5 witness failed")))
  (set! bb5-checks (+ bb5-checks 1)))
(define (refuses thunk) (guard (e (else #t)) (thunk) #f))
;; The released runtime's `write` duplicates the sign of some large negative
;; bignums. Serialize an explicit sign and a nonnegative magnitude instead.
(define (write-query q)
  (display "(QUERY")
  (for-each (lambda (n) (display " ") (if (< n 0) (display "-")) (display (abs n))) q)
  (display ")") (newline))
(define proof (bb5-proof))
(check 'symbolic-source-proof (bb5-check-proof bb5-table proof))
(check 'blank-target (equal? (bb5-blank proof) '(47176870 -12242 4098 15 4094)))
(check 'bb6-universal-polynomial-embedding (bb6-check-algebra))
(check 'bb6-exact-powers (bb6-check-powers))
(check 'wrong-source
  (refuses (lambda () (bb5-check-proof "0RB1LC_1RC1RB_1RD0LE_1LA1LD_1RZ0LA" proof))))
(for-each
  (lambda (index)
    (let ((bad (bb5-proof)))
      (vector-set! bad index (cons (+ 1 (car (vector-ref bad index))) (cdr (vector-ref bad index))))
      (check 'bad-affine-or-sum (refuses (lambda () (bb5-check-proof bb5-table bad))))))
  '(1 2 3 4))
(let ((bad (bb5-proof)))
  (vector-set! bad 0 '((1 1 (1) (0)) (3 -1 (1) (1)) (0 -1 (1 1 1) (0 0 1))))
  (check 'bad-sweep (refuses (lambda () (bb5-check-proof bb5-table bad)))))
(let ((bad (bb5-proof)))
  (vector-set! bad 5 '(((16 19 5) (6 5) (-3 -2)) ((27 25 5) (9 5) (-5 -2)) ((12 6) (-1) (0))))
  (check 'bad-composed-cost (refuses (lambda () (bb5-check-proof bb5-table bad)))))
(let ((bad (bb5-proof)))
  (vector-set! bad 3 '(0 3.0 5))
  (check 'inexact-polynomial (refuses (lambda () (bb5-check-proof bb5-table bad)))))
(check 'possibly-empty-word
  (refuses (lambda () (bb5-take (list (bb5-power '(1) (bb5-aff 0 1)))))))
(check 'negative-input (refuses (lambda () (bb5-query proof -1))))
(check 'over-budget (refuses (lambda () (bb5-query proof (expt 2 2048)))))
(check 'inexact-input (refuses (lambda () (bb5-query proof 3.0))))
(for-each
 (lambda (k)
   (for-each
    (lambda (r)
      (let* ((n (+ (* 3 k) r)) (q (bb5-query proof n))
             (cost (cond ((= r 0) (+ (* 5 k k) (* 19 k) 15))
                         ((= r 1) (+ (* 5 k k) (* 25 k) 27)) (else (+ (* 6 k) 12)))))
        (check 'independent-scalar-cost (= (list-ref q 4) cost))
        (write-query q))) '(0 1 2)))
 (list 0 1 113 257 (expt 2 128) (expt 2 1024)))
(display "BB5-CERTIFICATE ") (write (bb5-blank proof)) (newline)
(display "PASS bb5_certificate ") (display bb5-checks) (newline)
