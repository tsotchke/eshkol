;;;; Replay annotated source staging and independently encode the closed programs.
;;;; Requires SBCL only. No ASDF registry, RSH installation or network access.
(load (merge-pathnames "stager.lisp" *load-truename*))
(in-package #:staging)
(defparameter *directory* (make-pathname :name nil :type nil :defaults *load-truename*))
(defun read-data (name)
  (with-open-file (in (merge-pathnames name *directory*))
    (let ((*package* (find-package :staging-source)) (*read-eval* nil))
      (let ((value (read in)))
        (unless (eq :eof (read in nil :eof)) (error "Trailing source data")) value))))
(defun named (x name) (and (symbolp x) (string= (symbol-name x) name)))
(defun small-literals (x)
  (cond ((and (integerp x) (> x 64))
         (list (intern "ADD" :staging-source) 64 (small-literals (- x 64))))
        ((consp x) (cons (small-literals (car x)) (small-literals (cdr x)))) (t x)))
(defun contains-source (tree source)
  (or (equal tree source)
      (and (consp tree) (or (contains-source (car tree) source) (contains-source (cdr tree) source)))))

;; A small independent encoder for the closed, pure named source in this packet.
;; It has no opaque constants or primitive arithmetic. Unsupported/free forms fail.
(defun lower (form &optional env)
  (labels ((lam (params body scope)
             (let ((v (lower body (append (reverse params) scope))))
               (dolist (p params v) (declare (ignore p)) (setf v (list :lam v)))))
           (app (f a) (list :app f a)))
    (cond
      ((symbolp form)
       (let ((i (position form env))) (unless i (error "Free source name ~S" form)) (list :var i)))
      ((typep form '(integer 0 64))
       (let ((body '(:var 0)))
         (dotimes (i form) (setf body (app '(:var 1) body)))
         (list :lam (list :lam body))))
      ((not (consp form)) (error "Unsupported source literal"))
      ((named (first form) "LAMBDA") (lam (second form) (third form) env))
      ((or (named (first form) "LET") (named (first form) "LET*"))
       (let ((bindings (second form)) (body (third form)))
         (if (named (first form) "LET*")
             (labels ((nest (rows scope)
                        (if (null rows) (lower body scope)
                            (app (list :lam (nest (cdr rows) (cons (caar rows) scope)))
                                 (lower (cadar rows) scope)))))
               (nest bindings env))
             (reduce #'app (mapcar (lambda (r) (lower (second r) env)) bindings)
                     :initial-value (lam (mapcar #'first bindings) body env)))))
      ((named (first form) "IF")
       (app (app (lower (second form) env) (lower (third form) env)) (lower (fourth form) env)))
      (t (reduce #'app (mapcar (lambda (x) (lower x env)) (rest form))
                 :initial-value (lower (first form) env))))))
(defun bit-source (term)
  (with-output-to-string (out)
    (labels ((walk (x)
               (ecase (car x)
                 (:var (dotimes (i (1+ (second x))) (write-char #\1 out)) (write-char #\0 out))
                 (:lam (write-string "00" out) (walk (second x)))
                 (:app (write-string "01" out) (walk (second x)) (walk (third x))))))
      (walk term))))
(defun check-bits (id source)
  (let* ((bits (bit-source (lower source)))
         (path (merge-pathnames (format nil "~(~A~).blc" id) *directory*))
         (retained (with-open-file (in path) (read-line in))))
    (unless (equal bits retained) (error "Closed source does not rebuild ~A" id))))

(let ((definitions (read-data "definitions.sexp")) (programs (read-data "programs.sexp"))
      (closed (read-data "closed-sources.sexp")))
  (dolist (row programs)
    (let* ((id (symbol-name (first row))) (source (second row)) (wanted (third row))
           (arity (if (search "ATTENTION" id) (if (char= (char id (1- (length id))) #\0) 11 12)
                      (if (char= (char id (1- (length id))) #\0) 3 4))))
      (multiple-value-bind (actual receipt)
          (stage-source source definitions :work-limit 500000 :depth-limit 4096
                        :list-cell-limit 524288
                        :byte-parameters (mapcar #'symbol-name (second source)))
        (unless (and (equal actual wanted) (eq (getf receipt :status) :complete)
                     (= (length (second source)) arity)
                     (contains-source (second (assoc (first row) closed)) (small-literals actual)))
          (error "Original annotated source no longer stages to ~A" id)))))
  (dolist (row closed) (check-bits (first row) (second row))))
(format t "STAGING-PRODUCER PASS: six residuals and seven closed binary rebuilds~%")
