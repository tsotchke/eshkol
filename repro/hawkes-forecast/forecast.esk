;;; Certified closure -> parameter jets -> a finite discrete forecast.
;;; Copyright (c) 2026 Richard Hoekstra. SPDX-License-Identifier: MIT
(require core.observable_closure)
(require core.ring)

(define (fc-list? xs maximum)
  (let loop ((xs xs) (n maximum))
    (cond ((null? xs) #t) ((or (= n 0) (not (pair? xs))) #f) (else (loop (cdr xs) (- n 1))))))
(define (fc-rational? x) (and (number? x) (rational? x) (exact? x)))
(define (fc-copy x)
  (let ((left 65536))
    (define (walk x depth)
      (set! left (- left 1))
      (if (or (< left 0) (> depth 64)) (error "Forecast snapshot budget"))
      (cond ((pair? x) (cons (walk (car x) (+ depth 1)) (walk (cdr x) (+ depth 1))))
            ((vector? x) (list->vector (map (lambda (v) (walk v (+ depth 1))) (vector->list x))))
            ((or (fc-rational? x) (symbol? x) (boolean? x) (string? x) (null? x)) x)
            (else (error "Unsupported forecast snapshot datum"))))
    (walk x 0)))
(define (forecast-plan source)
  (let* ((owned (fc-copy source)) (result (compile-generator-closure owned)))
    (if (not (eq? (observable-status result) 'closed)) (error "Forecast source did not close" (observable-status result)))
    (let ((proof (observable-certificate result)))
      (if (not (verify-generator-closure owned proof)) (error "Forecast source replay refused"))
      (vector 'forecast-plan-v1 owned proof))))
(define (forecast-plan-valid? plan)
  (and (vector? plan) (= (vector-length plan) 3) (eq? (vector-ref plan 0) 'forecast-plan-v1)
       (verify-generator-closure (vector-ref plan 1) (vector-ref plan 2))))
(define (forecast-plan-dimension plan) (length (vector-ref (vector-ref (vector-ref plan 2) 4) 2)))
(define (fc-alist names values)
  (if (not (and (fc-list? values 8) (= (length values) (length names))
       (every (lambda (p) (and (pair? p) (memq (car p) names) (fc-rational? (cdr p)))) values)
       (every (lambda (name) (= (length (filter (lambda (p) (eq? (car p) name)) values)) 1)) names)))
      (error "Forecast requires each declared exact rational input exactly once"))
  (map (lambda (name) (cdr (assq name values))) names))
(define (fc-safe-jet value)
  (if (not (every fc-rational? (jet-coefficients value))) (error "Forecast arithmetic lost exactness")) value)
(define (fc-add J a b work)
  (vector-set! work 0 (+ 1 (vector-ref work 0))) (fc-safe-jet (r+ J a b)))
(define (fc-mul J a b work)
  (vector-set! work 1 (+ 1 (vector-ref work 1))) (fc-safe-jet (r* J a b)))
(define (fc-dot J row state work)
  (let loop ((row row) (state state) (out (r0 J)))
    (if (null? row) out
        (loop (cdr row) (cdr state)
          (if (= (car row) 0) out
              (fc-add J out (fc-mul J (jet-constant J (car row)) (car state) work) work))))))
(define (fc-monomial J exponents values work)
  (let loop ((es exponents) (vs values) (out (r1 J)))
    (if (null? es) out
        (loop (cdr es) (cdr vs) (fc-mul J out (r-expt J (car vs) (car es)) work)))))
(define (fc-run-admitted plan parameters initial steps h seed)
  (let* ((source (vector-ref plan 1)) (proof (vector-ref plan 2)) (linear (vector-ref proof 4))
         (variables (cdr (assq 'variables source))) (names (cdr (assq 'parameters source)))
         (input (fc-alist variables initial)) (numbers (fc-alist names parameters))
         (J (make-jets rationals 3 'forecast-epsilon)) (work (vector 0 0)))
    (if (not (and (integer? steps) (exact? steps) (<= 1 steps) (<= steps 8)
                  (fc-rational? h) (> h 0) (<= h 1/8) (or (not seed) (memq seed names))))
        (error "Forecast requires 1..8 RK4 steps, exact 0<h<=1/8, and a declared seed"))
    (let* ((pvalues (map (lambda (name value) (if (eq? name seed) (jet-seed J value) (jet-constant J value))) names numbers))
           (state-values (map (lambda (x) (jet-constant J x)) input))
           (monomials (map (lambda (e) (fc-monomial J e state-values work)) (cdr (assq 'basis source))))
           (state (map (lambda (row) (fc-dot J row monomials work)) (vector-ref linear 2)))
           (factors (map (lambda (powers) (fc-monomial J powers pvalues work)) (vector-ref proof 1)))
           (small (vector-ref linear 4)))
      (define (rhs state)
        (let ((derivative (make-list (length state) (r0 J))))
          (for-each (lambda (factor action)
            (set! derivative (map (lambda (before row)
              (fc-add J before (fc-mul J factor (fc-dot J row state work) work) work)) derivative (cdr action)))) factors small)
          derivative))
      (define (shift state derivative scale)
        (map (lambda (x dx) (fc-add J x (fc-mul J (jet-constant J scale) dx work) work)) state derivative))
      (let advance ((left steps) (state state))
        (if (= left 0)
            (let ((queries (map (lambda (row) (fc-dot J row state work)) (vector-ref linear 3))))
              (vector 'forecast-result-v1 (map (lambda (x) (map (lambda (c) c) (jet-coefficients x))) queries)
                      (vector-ref work 0) (vector-ref work 1) (length state) steps h (fc-copy (cdr (assq 'observations source)))))
            (let* ((k1 (rhs state)) (k2 (rhs (shift state k1 (/ h 2))))
                   (k3 (rhs (shift state k2 (/ h 2)))) (k4 (rhs (shift state k3 h)))
                   (sum (map (lambda (a b c d)
                     (fc-add J (fc-add J a d work)
                       (fc-mul J (jet-constant J 2) (fc-add J b c work) work) work)) k1 k2 k3 k4)))
              (advance (- left 1) (shift state sum (/ h 6)))))))))
(define (forecast-evaluate plan parameters initial steps h seed)
  (if (not (forecast-plan-valid? plan)) (error "Invalid or changed forecast source certificate"))
  (fc-run-admitted plan parameters initial steps h seed))
(define (forecast-query-coefficients result) (fc-copy (vector-ref result 1)))
(define (forecast-covariance result)
  (let ((rows (forecast-query-coefficients result)) (J (make-jets rationals 3 'forecast-epsilon)))
    (if (not (and (= (length rows) 3) (= (vector-length result) 8)
      (equal? (vector-ref result 7) '(n1 n2 (* n1 n2))))) (error "Covariance requires N1, N2 and N1*N2 observations"))
    (jet-coefficients (fc-safe-jet (r- J (make-jet J (caddr rows)) (r* J (make-jet J (car rows)) (make-jet J (cadr rows))))))))
