(load "source.esk")
(load "forecast.esk")
(define passed 0)
(define (check label ok) (if (not ok) (error "Forecast check" label)) (set! passed (+ passed 1)))
(define (refuses? thunk) (guard (e (else #t)) (thunk) #f))
(define mean-plan (forecast-plan sc-mean-source))
(define covariance-plan (forecast-plan sc-covariance-source))
(check 'mean-dimension (= (forecast-plan-dimension mean-plan) 4))
(check 'covariance-dimension (= (forecast-plan-dimension covariance-plan) 11))
(define points '(((x1 . 0) (x2 . 0) (n1 . 0) (n2 . 0))
                 ((x1 . 1) (x2 . 2) (n1 . 1) (n2 . 0))
                 ((x1 . 2) (x2 . 1) (n1 . 0) (n2 . 2))))
(for-each (lambda (w)
  (for-each (lambda (point)
    (let* ((mean (forecast-evaluate mean-plan (list (cons 'w w)) point 1 1/16 'w))
           (cov (forecast-evaluate covariance-plan (list (cons 'w w)) point 1 1/16 'w)))
      (check 'mean-covariance-commute (equal? (car (forecast-query-coefficients mean)) (car (forecast-query-coefficients cov))))
      (display "FORECAST ") (write (list w (map cdr point) (forecast-query-coefficients mean)
          (forecast-query-coefficients cov) (forecast-covariance cov))) (newline))) points)) '(0 1/4 1/2 3/4 1))
(check 'nonzero-second-derivative
  (not (= (caddr (car (forecast-query-coefficients
    (forecast-evaluate mean-plan '((w . 1/2)) (cadr points) 1 1/16 'w)))) 0)))
(define bad (fc-copy mean-plan))
(set-car! (cdr (car (cadr (assq 'jumps (vector-ref bad 1))))) 7)
(check 'changed-source (not (forecast-plan-valid? bad)))
(check 'changed-source-refuses (refuses? (lambda () (forecast-evaluate bad '((w . 1/2)) (car points) 3 1/16 'w))))
(check 'inexact-parameter (refuses? (lambda () (forecast-evaluate mean-plan '((w . 0.5)) (car points) 3 1/16 'w))))
(check 'missing-state (refuses? (lambda () (forecast-evaluate mean-plan '((w . 1/2)) '((x1 . 1)) 3 1/16 'w))))
(define mislabeled-result (forecast-evaluate covariance-plan '((w . 1/2)) (car points) 1 1/16 'w))
(vector-set! mislabeled-result 7 '(n2 n1 (* n1 n2)))
(check 'covariance-query-contract (refuses? (lambda () (forecast-covariance mislabeled-result))))
(display "SOURCE ") (write sc-covariance-source) (newline)
(display "PASS forecast ") (display passed) (newline)
