(load "cost.esk")
(define checks 0)
(define (check label ok) (if (not ok) (error "Cost check" label)) (set! checks (+ checks 1)))
(define (refuses? thunk) (guard (e (else #t)) (thunk) #f))
(for-each (lambda (k)
  (for-each (lambda (theta)
    (let* ((source (sblc-branching-source k))
           (result (guard (e (else #f)) (cost-sensitivities source theta 1/64 24))))
      (if result (begin
        (check 'operational (equal? (map car (vector-ref result 10)) (cost-weighted-prefix source theta 24)))
        (if (= theta 1/2)
          (let ((fair (sblc-resource-summary (sblc-resource-certificate (sblc-resource-analyze source 24)))))
            (check 'fair-compatibility (and (= (car fair) (car (vector-ref result 6)))
              (equal? (list-ref fair 3) (if (eq? (vector-ref result 8) 'infinite) 'infinite (car (vector-ref result 8))))
              (= (list-ref fair 4) (car (vector-ref result 9)))))))
        (display "COST ") (write (list k theta result)) (newline))))) '(1/4 1/2 3/4))) '(1 2 3 4))
(check 'critical-point (refuses? (lambda () (cost-sensitivities (sblc-branching-source 2) 1/2 1/64 24))))
(check 'critical-crossing (refuses? (lambda () (cost-sensitivities (sblc-branching-source 1) 3/4 1/8 24))))
(check 'zero-conditioning (refuses? (lambda () (cost-sensitivities (sblc-branching-source 0) 1/2 1/64 24))))
;; Same leaf count and fair law, different biased source law.
;; The explicit alternative tree is source-bound, not identified by its leaf count.
(define alt '(app (lam (choice (choice (lam (var 1)) (app (app (var 1) (var 1)) (app (var 1) (var 1))))
                             (choice (lam (var 1)) (app (app (var 1) (var 1)) (app (var 1) (var 1))))))
                 (lam (choice (choice (lam (var 1)) (app (app (var 1) (var 1)) (app (var 1) (var 1))))
                             (choice (lam (var 1)) (app (app (var 1) (var 1)) (app (var 1) (var 1))))))))
(check 'layout (equal? (vector-ref (cost-sensitivities alt 1/4 1/64 10) 6)
                       (vector-ref (cost-sensitivities (sblc-branching-source 2) 1/4 1/64 10) 6)))
;; This particular transpose has the same Bernoulli law; use a diagonal leaf pair to distinguish.
(define diag '(app (lam (choice (choice (lam (var 1)) (app (app (var 1) (var 1)) (app (var 1) (var 1))))
                              (choice (app (app (var 1) (var 1)) (app (var 1) (var 1))) (lam (var 1)))))
                  (lam (choice (choice (lam (var 1)) (app (app (var 1) (var 1)) (app (var 1) (var 1))))
                              (choice (app (app (var 1) (var 1)) (app (var 1) (var 1))) (lam (var 1)))))))
(check 'layout-changes-law (not (equal? (vector-ref (cost-sensitivities diag 1/4 1/64 10) 6)
                               (vector-ref (cost-sensitivities (sblc-branching-source 2) 1/4 1/64 10) 6))))
(check 'changed-source (refuses? (lambda () (cost-sensitivities '(app (lam (var 1)) (lam (var 1))) 1/4 1/64 24))))
(display "PASS cost ") (display checks) (newline)
