;;; A Bernoulli parameter on a fixed, structurally admitted SBLC source.
;;; Copyright (c) 2026 Richard Hoekstra. SPDX-License-Identifier: MIT
(require core.sblc.resource)
(require core.sblc)
(require core.ring)
(define (cj-rational? x) (and (number? x) (rational? x) (exact? x)))
(define (cj-integer? x) (and (cj-rational? x) (integer? x)))
(define (cj-number x) (if (not (cj-rational? x)) (error "Cost arithmetic lost exactness")) x)
(define (cj+ a b) (cj-number (+ a b)))
(define (cj* a b) (cj-number (* a b)))
(define (cj/ a b) (cj-number (/ a b)))
(define (cj-exact x)
  (if (not (every cj-rational? (jet-coefficients x))) (error "Cost jet lost exactness")) x)
(define (cj-add J a b) (cj-exact (r+ J a b)))
(define (cj-mul J a b) (cj-exact (r* J a b)))
(define (cj-div J a b) (cj-exact (r/ J a b)))
(define (cj-leaves source)
  (if (not (let ((r (sblc-resource-analyze source 0)))
    (and (eq? (sblc-resource-status r) 'certified)
         (eq? (car (vector-ref (sblc-resource-certificate r) 2)) 'branch))))
      (error "Expected the admitted binary recursive source grammar"))
  (let ((body (cadr (cadr source))))
    (list (cadr (cadr body)) (caddr (cadr body)) (cadr (caddr body)) (caddr (caddr body)))))
(define (cj-p J leaves theta)
  (let* ((one (r1 J)) (other (r- J one theta))
         (weights (list (cj-mul J theta theta) (cj-mul J theta other)
                        (cj-mul J other theta) (cj-mul J other other))))
    (fold-left (lambda (out pair)
      (if (equal? (car pair) '(lam (var 1))) (cj-add J out (cdr pair)) out))
      (r0 J) (map cons leaves weights))))
;; Exact range of the actual quadratic on the complete requested interval.
(define (cj-range coefficients lo hi)
  (let* ((a (car coefficients)) (b (cadr coefficients)) (c (caddr coefficients))
         (value (lambda (x) (cj+ a (cj+ (cj* b x) (cj* c (cj* x x))))))
         (values (list (value lo) (value hi)))
         (vertex (if (= c 0) lo (cj/ (- b) (* 2 c))))
         (values (if (and (< lo vertex) (< vertex hi)) (cons (value vertex) values) values)))
    (list (apply min values) (apply max values))))
(define (cost-sensitivities source theta radius degree)
  (if (not (and (cj-rational? theta) (cj-rational? radius) (> radius 0)
        (> (- theta radius) 0) (< (+ theta radius) 1)
        (cj-integer? degree) (<= 0 degree) (<= degree 24)))
      (error "Expected an interior exact parameter interval and degree 0..24"))
  (let* ((leaves (cj-leaves source)) (J (make-jets rationals 3 'coin-epsilon))
         (global (jet-coefficients (cj-p J leaves (jet-seed J 0))))
         (range (cj-range global (- theta radius) (+ theta radius)))
         (subcritical (> (car range) 1/2))
         (supercritical (< (cadr range) 1/2)))
    (if (not (or subcritical supercritical)) (error "Critical boundary intersects the requested parameter interval"))
    (let* ((p (cj-p J leaves (jet-seed J theta))) (one (r1 J))
           (other (r- J one p))
           (q (if subcritical one (cj-div J p other))))
      (if (= (car (jet-coefficients q)) 0) (error "No terminating executions to condition on"))
      (let* ((gap (r- J one (cj-mul J (jet-constant J 2) (if subcritical other p))))
             (conditional (cj-div J (cj-add J (jet-constant J (if subcritical 4 3))
                                      (if subcritical (r-neg J p) p)) gap))
             (restricted (cj-mul J q conditional))
             (coefficients (make-vector (+ degree 1) (r0 J))))
        ;; Least formal solution H = p*z^3 + (1-p)*z^4*H^2, by ascending degree.
        (let loop ((d 0))
          (if (<= d degree)
            (begin
              (vector-set! coefficients d
                (let sum ((i 0) (out (if (= d 3) p (r0 J))))
                  (if (> i (- d 4)) out
                    (sum (+ i 1) (cj-add J out (cj-mul J other
                      (cj-mul J (vector-ref coefficients i) (vector-ref coefficients (- d 4 i)))))))))
              (loop (+ d 1)))))
        (vector 'cost-sensitivities-v1 (sblc-program-id source) theta radius range
          (if subcritical 'almost-sure 'defective)
          (jet-coefficients q) (jet-coefficients restricted)
          (if subcritical (jet-coefficients conditional) 'infinite)
          (jet-coefficients conditional) (map jet-coefficients (vector->list coefficients)))))))
;; Operational control: existing one-step substitution/reduction; weighted choices only.
(define (cost-weighted-prefix source theta bound)
  (let ((out (make-vector (+ bound 1) 0)))
    (let walk ((term source) (mass 1) (steps 0))
      (let ((step (sblc-step term)))
        (cond ((eq? (car step) 'normal) (vector-set! out steps (cj+ (vector-ref out steps) mass)))
              ((= steps bound) #f)
              ((eq? (car step) 'beta) (walk (cadr step) mass (+ steps 1)))
              (else (walk (cadr step) (cj* mass theta) (+ steps 1))
                    (walk (caddr step) (cj* mass (- 1 theta)) (+ steps 1))))))
    (vector->list out)))
