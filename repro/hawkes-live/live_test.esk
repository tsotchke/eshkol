(load "../hawkes-forecast/source.esk")
(load "../hawkes-forecast/forecast.esk")
(load "live.esk")
(define passed 0)
(define (check label ok) (if (not ok) (error "Live forecast check" label)) (set! passed (+ passed 1)))
(define (refuses? thunk) (guard (e (else #t)) (thunk) #f))
(define plan (forecast-plan sc-covariance-source))
(define mean-plan (forecast-plan sc-mean-source))
(define initial (live-forecast plan '((w . 1/2)) 'w 1 1/16))
(define state initial)
(define integrated (zset-empty))
(define obs0 '(a 0 0 0 0))
(define obs1 '(a 1 2 1 0))
(define obs2 '(b 2 1 0 2))
(define obs3 '(b 1 0 2 1))
(define obs4 '(a 0 1 2 0))
(define updates (list
  (list (list 1 obs0) (list 1 obs1) (list 1 obs2))
  (list (list 1 obs1)) (list (list -1 obs0))
  (list (list 1 obs3) (list -1 obs3)) (list (list -1 obs1))
  (list (list 1 obs3)) (list (list -1 obs1) (list 1 obs4))
  (list (list -1 obs2)) (list (list 1 obs0)) (list (list -1 obs4))
  (list (list -1 obs3)) '()))
(define (emit-state label w state)
  (display "LIVE ") (write (list label w (zset-entries (live-forecast-input state))
                                    (zset-entries (live-forecast-output state)))) (newline))
(let ticks ((rest updates) (i 1))
  (if (pair? rest)
      (let* ((delta (zset-from-weighted (car rest))) (step (live-forecast-step state delta)))
        (set! state (car step)) (set! integrated (zset-add integrated (cdr step)))
        (check 'integrated-delta (zset=? integrated (live-forecast-output state)))
        (emit-state i 1/2 state)
        (if (or (= i 4) (= i 12))
            (check 'zero-work (and (zset-empty? (cdr step))
              (equal? (vector->list (dbsp-circuit-work (vector-ref state 6))) '(0 0 0 0)))))
        (ticks (cdr rest) (+ i 1)))))
(check 'predecessor-empty (zset-empty? (live-forecast-output initial)))
(define old-output (live-forecast-output state))
(check 'over-retraction (refuses? (lambda () (live-forecast-step state (zset-singleton obs0 -2)))))
(check 'failed-tick-atomic (zset=? old-output (live-forecast-output state)))
(define fork (car (live-forecast-step initial (zset-singleton obs2 1))))
(check 'fork (and (not (zset-empty? (live-forecast-output fork))) (zset-empty? (live-forecast-output initial))))
(define revised (live-forecast-revise state plan '((w . 3/4)) 'reconstruct))
(check 'revision-delta (zset=? (zset-add old-output (cdr revised)) (live-forecast-output (car revised))))
(check 'revision-parent (zset=? old-output (live-forecast-output state)))
(emit-state 'parameter-revision 3/4 (car revised))
(define mean-state (car (live-forecast-step (live-forecast mean-plan '((w . 1/2)) 'w 1 1/16)
  (zset-from-weighted (car updates)))))
(check 'query-upgrade-refuses (refuses? (lambda () (live-forecast-revise mean-state plan '((w . 1/2)) 'retained))))
(define upgrade (live-forecast-revise mean-state plan '((w . 1/2)) 'reconstruct))
(check 'query-upgrade-reconstructed (= (forecast-plan-dimension (vector-ref (car upgrade) 1)) 11))
(emit-state 'query-upgrade 1/2 (car upgrade))
(define observed (live-forecast-output state))
(vector-set! observed 1 '())
(check 'owned-output (zset=? old-output (live-forecast-output state)))
(define mutable-row (list 'a 1 2 1 0))
(define owned (car (live-forecast-step initial (zset-singleton mutable-row 1))))
(set-car! (cdr mutable-row) 99)
(check 'owned-input (= (zset-weight (live-forecast-input owned) obs1) 1))
(define activation-source (fc-copy sc-mean-source))
(set-car! (cadr (caddr (assq 'jumps activation-source))) '(+ x1 w))
(define point-source (fc-copy activation-source))
(set-car! (cadr (caddr (assq 'jumps point-source))) 'x1)
(define point-plan (forecast-plan point-source))
(define family-plan (forecast-plan activation-source))
(check 'point-dimension (= (forecast-plan-dimension point-plan) 3))
(check 'family-dimension (= (forecast-plan-dimension family-plan) 4))
(define forged-family (vector 'forecast-plan-v1 activation-source (vector-ref point-plan 2)))
(check 'point-certificate-cannot-authorize-family (not (forecast-plan-valid? forged-family)))
(define inactive (car (live-forecast-step (live-forecast family-plan '((w . 0)) 'w 1 1/16)
  (zset-from-weighted (car updates)))))
(check 'activation-retained-refuses (refuses? (lambda () (live-forecast-revise inactive family-plan '((w . 1/2)) 'retained))))
(define activated (car (live-forecast-revise inactive family-plan '((w . 1/2)) 'reconstruct)))
(check 'activation-reconstructed (zset=? (live-forecast-output activated)
  (live-forecast-output (car (live-forecast-step (live-forecast family-plan '((w . 1/2)) 'w 1 1/16)
    (zset-from-weighted (car updates)))))))
(for-each (lambda (entry)
  (display "ACTIVATED ") (write (list (car entry) (zset-entries (live-forecast-input (cdr entry)))
    (zset-entries (live-forecast-output (cdr entry))))) (newline))
  (list (cons 0 inactive) (cons 1/2 activated)))
(display "ACTIVATION_SOURCE ") (write activation-source) (newline)
(display "SOURCE ") (write sc-covariance-source) (newline)
(display "PASS live ") (display passed) (newline)
