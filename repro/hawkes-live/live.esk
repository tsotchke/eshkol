;;; Signed standing dataflow of certified forecasts and exact sensitivities.
;;; Copyright (c) 2026 Richard Hoekstra. SPDX-License-Identifier: MIT
(require core.dbsp.circuit)
(require core.dbsp)
(define (lf-rational value)
  (if (not (fc-rational? value)) (error "Live forecast arithmetic lost exactness")) value)
(define (lf-add a b) (lf-rational (+ a b)))
(define (lf-point row)
  (if (not (and (fc-list? row 5) (= (length row) 5)
                (or (symbol? (car row)) (and (number? (car row)) (integer? (car row)) (exact? (car row))))
                (every (lambda (x) (and (fc-rational? x) (>= x 0))) (cdr row))
                (integer? (list-ref row 3)) (integer? (list-ref row 4))))
      (error "Expected immutable (key x1 x2 n1 n2) physical observation"))
  (map cons '(x1 x2 n1 n2) (cdr row)))
(define (lf-flat rows) (fold-left append '() rows))
(define (lf-triples flat)
  (if (null? flat) '() (cons (list (car flat) (cadr flat) (caddr flat)) (lf-triples (cdddr flat)))))
(define (lf-emit key aggregate)
  (let* ((mass (car aggregate)) (J (make-jets rationals 3 'forecast-epsilon)))
    (if (not (> mass 0)) (error "Live forecast has no positive observation mass"))
    (let* ((rows (lf-triples (map (lambda (x) (lf-rational (/ x mass))) (cdr aggregate))))
           (covariance (if (= (length rows) 3)
              (jet-coefficients (fc-safe-jet (r- J (make-jet J (caddr rows))
                (r* J (make-jet J (car rows)) (make-jet J (cadr rows)))))) 'not-requested)))
      (list key mass rows covariance))))
(define (lf-identity plan parameters seed steps h)
  (zset-row-key (list (vector-ref plan 1) (vector-ref plan 2) parameters seed steps h)))
(define (lf-check state)
  (if (not (and (vector? state) (= (vector-length state) 10) (eq? (vector-ref state 0) 'live-forecast-v1)
                (string=? (vector-ref state 7)
                  (lf-identity (vector-ref state 1) (vector-ref state 2) (vector-ref state 3)
                               (vector-ref state 4) (vector-ref state 5)))))
      (error "Changed live forecast source, parameters or certificate; reconstruct explicitly")) state)
(define (live-forecast plan parameters seed steps h)
  (if (not (forecast-plan-valid? plan)) (error "Live forecast requires a certified plan"))
  (let* ((owned (fc-copy plan)) (parameters (fc-copy parameters)) (source (vector-ref owned 1))
         (names (cdr (assq 'parameters source))) (queries (cdr (assq 'observations source)))
         (width (+ 1 (* 3 (length queries)))))
    (if (not (and (equal? (cdr (assq 'variables source)) '(x1 x2 n1 n2))
                  (or (equal? queries '(n1)) (equal? queries '(n1 n2 (* n1 n2))))
                  (integer? steps) (exact? steps) (<= 1 steps) (<= steps 8)
                  (fc-rational? h) (> h 0) (<= h 1/8) (or (not seed) (memq seed names))))
        (error "Live forecast target or time/seed contract is unsupported"))
    (fc-alist names parameters)
    ;; Keep zero? a direct call: passing the builtin itself crashes the 1.3.6
    ;; in-process JIT during admission when these consumer modules are combined.
    (let* ((group (make-dbsp-group (lambda () (make-list width 0))
                    (lambda (a b) (map lf-add a b))
                    (lambda (a) (map (lambda (x) (lf-rational (- x))) a))
                    (lambda (a) (every (lambda (value) (zero? value)) a))))
           (lift (lambda (row)
             (let ((result (fc-run-admitted owned parameters (lf-point row) steps h seed)))
               (cons 1 (lf-flat (forecast-query-coefficients result))))))
           (circuit (make-dbsp-circuit '(observations)
                       (list (list 'aggregate 'forecast 'observations car lift group lf-emit)) 'forecast)))
      (vector 'live-forecast-v1 owned parameters seed steps h circuit
              (lf-identity owned parameters seed steps h) 0 'initial))))
(define (live-forecast-step state delta)
  (lf-check state)
  (let* ((owned-delta (fc-copy delta)) (circuit (vector-ref state 6)))
    (if (not (zset? owned-delta)) (error "Live forecast tick requires a Z-set"))
    ;; Point admission checks only touched rows; the predecessor is a positive bag.
    (for-each (lambda (entry)
      (lf-point (cadr entry))
      (if (< (+ (dbsp-circuit-input-weight circuit 'observations (cadr entry)) (car entry)) 0)
          (error "Retraction exceeds retained observation multiplicity"))) (zset-entries owned-delta))
    (let* ((step (dbsp-circuit-step circuit (list (list 'observations owned-delta))))
           (next (vector-copy state)))
      (vector-set! next 6 (car step)) (vector-set! next 8 (+ (vector-ref state 8) 1))
      (vector-set! next 9 (list 'signed-update (zset-size owned-delta)))
      (cons next (fc-copy (cdr step))))))
(define (live-forecast-output state) (lf-check state) (fc-copy (dbsp-circuit-output (vector-ref state 6))))
(define (live-forecast-input state) (lf-check state) (fc-copy (dbsp-circuit-input (vector-ref state 6) 'observations)))
(define (live-forecast-revise state new-plan parameters mode)
  (lf-check state)
  (if (not (eq? mode 'reconstruct)) (error "Model or query revision requires reconstruction from retained observations"))
  (let* ((before (live-forecast-output state)) (origin (live-forecast-input state))
         (fresh (live-forecast new-plan parameters (vector-ref state 3) (vector-ref state 4) (vector-ref state 5)))
         (rebuilt (car (live-forecast-step fresh origin))))
    (vector-set! rebuilt 8 (+ 1 (vector-ref state 8)))
    (vector-set! rebuilt 9 (list 'reconstructed (zset-size origin)))
    (cons rebuilt (zset-sub (live-forecast-output rebuilt) before))))
