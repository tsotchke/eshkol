;; Exact matrix solves over Q(sqrt(2)) and a fourth-order Taylor carrier.
(require stdlib)
(require core.algebraic_linalg)

(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1))
             (display "FAIL: ") (display name) (newline))))

(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define matrix (vector (vector alpha 1) (vector 1 alpha)))
(define factor (algebraic-factor field matrix))
(define first (algebraic-factor-solve factor (vector 1 0)))
(define second (algebraic-factor-solve factor (vector 0 1)))
(check "first exact solution is (sqrt(2), -1)"
  (and (algebraic-equal? (vector-ref first 0) alpha)
       (= (algebraic-rational (vector-ref first 1)) -1)))
(check "second RHS reuses the same bottom-field factor"
  (and (= (algebraic-rational (vector-ref second 0)) -1)
       (algebraic-equal? (vector-ref second 1) alpha)
       (equal? (vector->list (algebraic-factor-summary factor)) '(2 0 1))))

(define context (make-algebraic-taylor field 4))
(define x (algebraic-ad-seed context 2))
(define jet-factor (algebraic-factor context (vector (vector x 1) (vector 1 x))))
(define jet-solution (algebraic-factor-solve jet-factor (vector 1 0)))
(check "Taylor solve reuses one bottom LU and matches exact derivatives"
  (and (equal? (vector->list (algebraic-factor-summary jet-factor)) '(2 1 1))
       (= (algebraic-rational (algebraic-ad-derivative (vector-ref jet-solution 0) 0)) 2/3)
       (= (algebraic-rational (algebraic-ad-derivative (vector-ref jet-solution 0) 1)) -5/9)
       (= (algebraic-rational (algebraic-ad-derivative (vector-ref jet-solution 0) 2)) 28/27)))

(display "Bottom-field factor summary (size depth LU-count): ")
(display (algebraic-factor-summary factor))
(newline)
(display "Taylor factor summary (size depth LU-count): ")
(display (algebraic-factor-summary jet-factor))
(newline)
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
