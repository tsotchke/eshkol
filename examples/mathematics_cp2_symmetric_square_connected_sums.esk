;; CP^2 as the symmetric square of S^2, connected sums of 4-manifolds, and
;; the 3-type that separates S^2 x S^2 from CP^2 # CP^2: two simply
;; connected 4-manifolds with the same homology and the same 2-type, told
;; apart by the cup square through the second k-invariant.
;;
;; Sources: as in the sibling example on the second k-invariant, and: J.
;; Milnor, "On simply connected 4-manifolds" (1958) and J. H. C. Whitehead
;; (1949) (the homotopy type of a simply connected closed 4-manifold is
;; determined by its intersection form); W. Kuehnel, T. F. Banchoff, "The
;; 9-vertex complex projective plane", Math. Intelligencer 5 (1983) (a
;; minimal triangulation; ours has 10 vertices and is not minimal); the
;; classical identification Sym^2(CP^1) = CP^2 (a pair of points of the
;; Riemann sphere is a quadratic form up to scale).
;;
;; CP^2 is built as the quotient of the simplicial product of two
;; tetrahedron boundaries by the swap of the factors: the swap is a
;; simplicial involution that fixes only the diagonal vertices and never
;; maps a simplex to itself with a nontrivial vertex permutation, so the
;; orbit space is again a Delta-complex, and it is Sym^2(S^2) = CP^2. Its
;; Euler characteristic 3, its mod 2 Betti numbers (1, 0, 1, 0, 1), the
;; pseudomanifold condition (every tetrahedron in exactly two 4-cells) and
;; the cup square of the generator are all computed. The connected sum of
;; two 4-manifolds removes a 4-cell from each and glues the boundary
;; 3-spheres by identifying face tables; CP^2 # CP^2 and S^2 x S^2 then
;; have the same mod 2 homology (1, 0, 2, 0, 1) and both are simply
;; connected, so they have the same 2-type K(Z^2, 2). Their intersection
;; forms mod 2 differ (diag(1,1) against hyperbolic), and the mapping
;; space into the 3-type P with pi_2 = pi_3 = Z/2 and k = iota u iota,
;; computed by the state sum and by the fibration formula, is 1 for
;; S^2 x S^2 and 1/2 for CP^2 # CP^2: the second k-invariant sees Wu's
;; class, the parity of the form.
;;
;;   1. Sym^2 of the 96-pentachoron product: 10 vertices, 48 pentachora,
;;      chi = 3, a pseudomanifold, Betti (1, 0, 1, 0, 1), x u x nonzero;
;;      it is a Delta-complex and not a simplicial complex (45 edges on
;;      40 vertex pairs), which is why the sums are glued on face tables.
;;   2. CP^2 # CP^2: chi = 4, Betti (1, 0, 2, 0, 1), form diag(1, 1) on a
;;      computed basis; S^2 x S^2: hyperbolic; CP^2 # S^2 x S^2 and
;;      CP^2 # CP^2 # CP^2 as further odd forms with the expected ranks.
;;   3. Map into P: 1/2 for CP^2 (one of two classes lifts), 1 for
;;      S^2 x S^2 (all four lift), 1/2 for CP^2 # CP^2 (two of four), each
;;      by both routes; with k = 0 all three give 1.
;;
;; DEFECT NOTES (routed around): as in the sibling examples.

(require stdlib)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (any? pred (cdr xs)))))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))
(define (sum xs) (let loop ((l xs) (s 0)) (if (null? l) s (loop (cdr l) (+ s (car l))))))
(define (drop-nth l i) (let loop ((l l) (k 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ k 1) (if (= k i) acc (cons (car l) acc))))))
(define (take-list l i) (let loop ((l l) (k 0) (acc '())) (if (= k i) (reverse acc) (loop (cdr l) (+ k 1) (cons (car l) acc)))))

;; --- Delta-complexes from top cells (vertex list, sign list) ------------------------------------------------
;; A cell is identified by its vertex list and its sign list normalized so the first sign is +1 (the
;; sign encodes which of several cells on the same vertices is meant, as for the cross-polytope quotient).
(define (normalize-signs ss) (let ((s0 (car ss))) (map (lambda (s) (* s0 s)) ss)))
(define (cell-key nv vs ss) (let loop ((vs vs) (ss ss) (acc 0)) (if (null? vs) acc (loop (cdr vs) (cdr ss) (+ (* acc (* 2 nv)) (+ (* 2 (car vs)) (if (= 1 (car ss)) 0 1)))))))
;; complex: (vector nv dim cells faces keytab) with cells[k] = vector of (vector vs ss), faces[k] = vector of
;; vectors of face indices (d_0 .. d_k), keytab[k] = hash table key -> index
(define (build-complex-canon nv dim tops canon)  ;; canon: (vs ss) -> (vector vs ss), a canonical representative of a cell
  (let ((cells (make-vector (+ dim 1) 0)) (faces (make-vector (+ dim 1) 0)) (keytab (make-vector (+ dim 1) 0)))
    (let loop ((k dim) (current (map (lambda (t) (canon (car t) (normalize-signs (cadr t)))) tops)))
      (let ((tab (make-hash-table)) (lst (vector '())) (n (vector 0)))
        (for-each (lambda (c)
                    (let ((key (cell-key nv (vector-ref c 0) (vector-ref c 1))))
                      (if (not (hash-table-ref/default tab key #f))
                          (begin (hash-table-set! tab key (vector-ref n 0)) (vector-set! lst 0 (cons c (vector-ref lst 0))) (vector-set! n 0 (+ 1 (vector-ref n 0)))))))
                  current)
        (vector-set! cells k (list->vector (reverse (vector-ref lst 0))))
        (vector-set! keytab k tab)
        (if (> k 0)
            (let ((subs (let gen ((cs (reverse (vector-ref lst 0))) (acc '()))
                          (if (null? cs) (reverse acc)
                              (gen (cdr cs) (append (reverse (map (lambda (i) (canon (drop-nth (vector-ref (car cs) 0) i) (normalize-signs (drop-nth (vector-ref (car cs) 1) i)))) (range (+ k 1)))) acc))))))
              (loop (- k 1) subs)))))
    ;; face indices
    (let loop ((k 1))
      (if (<= k dim)
          (begin
            (vector-set! faces k (list->vector (map (lambda (c) (list->vector (map (lambda (i) (let ((f (canon (drop-nth (vector-ref c 0) i) (normalize-signs (drop-nth (vector-ref c 1) i))))) (hash-table-ref/default (vector-ref keytab (- k 1)) (cell-key nv (vector-ref f 0) (vector-ref f 1)) -1))) (range (+ k 1))))) (vector->list (vector-ref cells k)))))
            (loop (+ k 1)))))
    (vector-set! faces 0 (vector))
    (vector nv dim cells faces keytab canon)))
(define (build-complex nv dim tops) (build-complex-canon nv dim tops (lambda (vs ss) (vector vs ss))))
(define (x-dim X) (vector-ref X 1))
(define (x-count X k) (vector-length (vector-ref (vector-ref X 2) k)))
(define (x-cell X k i) (vector-ref (vector-ref (vector-ref X 2) k) i))
(define (x-face X k i j) (vector-ref (vector-ref (vector-ref (vector-ref X 3) k) i) j))
(define (x-lookup X k vs ss) (let ((f ((vector-ref X 5) vs (normalize-signs ss)))) (hash-table-ref/default (vector-ref (vector-ref X 4) k) (cell-key (vector-ref X 0) (vector-ref f 0) (vector-ref f 1)) -1)))
(define (x-counts X) (map (lambda (k) (x-count X k)) (range (+ (x-dim X) 1))))
(define (euler-char X) (sum (map (lambda (k) (* (if (even? k) 1 -1) (x-count X k))) (range (+ (x-dim X) 1)))))

;; --- GF(2) linear algebra on vectors of rows ---------------------------------------------------------------
(define (delta-matrix X k)                       ;; delta^k : C^k -> C^{k+1}, rows (k+1)-cells, entries mod 2
  (let* ((rows (x-count X (+ k 1))) (cols (x-count X k)) (M (make-vector rows 0)))
    (let loop ((r 0))
      (if (< r rows)
          (let ((row (make-vector cols 0)))
            (let fl ((j 0)) (if (<= j (+ k 1)) (let ((f (x-face X (+ k 1) r j))) (vector-set! row f (modulo (+ 1 (vector-ref row f)) 2)) (fl (+ j 1)))))
            (vector-set! M r row) (loop (+ r 1)))))
    M))
(define (copy-rows M) (list->vector (map (lambda (r) (let ((w (make-vector (vector-length r) 0))) (let cp ((i 0)) (if (< i (vector-length r)) (begin (vector-set! w i (vector-ref r i)) (cp (+ i 1))))) w)) (vector->list M))))
(define (rref2! R)                               ;; reduced row echelon form mod 2 in place; returns the pivot columns
  (let* ((m (vector-length R)) (n (if (= m 0) 0 (vector-length (vector-ref R 0)))))
    (let loop ((r 0) (c 0) (pivots '()))
      (if (or (= r m) (= c n)) (reverse pivots)
          (let ((piv (let find ((i r)) (cond ((= i m) #f) ((= 1 (vector-ref (vector-ref R i) c)) i) (else (find (+ i 1)))))))
            (if (not piv) (loop r (+ c 1) pivots)
                (begin
                  (let ((t (vector-ref R r))) (vector-set! R r (vector-ref R piv)) (vector-set! R piv t))
                  (let ((prow (vector-ref R r)))
                    (let rows ((i 0))
                      (if (< i m)
                          (begin (if (and (not (= i r)) (= 1 (vector-ref (vector-ref R i) c)))
                                     (let ((row (vector-ref R i))) (let add ((j 0)) (if (< j n) (begin (vector-set! row j (modulo (+ (vector-ref row j) (vector-ref prow j)) 2)) (add (+ j 1)))))))
                                 (rows (+ i 1))))))
                  (loop (+ r 1) (+ c 1) (cons c pivots)))))))))
(define (rank2 M) (if (= 0 (vector-length M)) 0 (length (rref2! (copy-rows M)))))
(define (nullspace2 M n)                         ;; basis of {v : M v = 0} in GF(2)^n
  (if (= 0 (vector-length M)) (map (lambda (j) (let ((v (make-vector n 0))) (vector-set! v j 1) v)) (range n))
      (let* ((R (copy-rows M)) (pivots (rref2! R)) (free (filter (lambda (j) (not (memv j pivots))) (range n))))
        (map (lambda (f)
               (let ((v (make-vector n 0)))
                 (vector-set! v f 1)
                 (let loop ((ps pivots) (r 0))
                   (if (not (null? ps))
                       (begin (vector-set! v (car ps) (vector-ref (vector-ref R r) f)) (loop (cdr ps) (+ r 1)))))
                 v))
             free))))
(define (in-span2? rows v)                       ;; is v in the GF(2) row span of rows?
  (with-region (let ((A (list->vector (append rows (list v)))))
    (= (rank2 (list->vector rows)) (rank2 A)))))
(define (mat-vec2 M v) (list->vector (map (lambda (row) (modulo (let loop ((j 0) (s 0)) (if (= j (vector-length row)) s (loop (+ j 1) (+ s (* (vector-ref row j) (vector-ref v j)))))) 2)) (vector->list M))))
(define (vec-add2 a b) (list->vector (map (lambda (i) (modulo (+ (vector-ref a i) (vector-ref b i)) 2)) (range (vector-length a)))))
(define (zero2? v) (all? (lambda (i) (= 0 (vector-ref v i))) (range (vector-length v))))
(define (transpose-rows M n) (list->vector (map (lambda (j) (list->vector (map (lambda (row) (vector-ref row j)) (vector->list M)))) (range n))))
;; cohomology mod 2: dims of H^k, with representatives of a basis of H^2
(define (deltas X) (map (lambda (k) (delta-matrix X k)) (range (x-dim X))))
(define (betti2 X)
  (let* ((Ds (deltas X)) (ranks (append (map rank2 Ds) (list 0))))
    (let loop ((k 0) (rs ranks) (prev 0) (acc '()))
      (if (> k (x-dim X)) (reverse acc)
          (loop (+ k 1) (cdr rs) (car rs) (cons (- (x-count X k) prev (car rs)) acc))))))
(define (coboundary-rows X k)                    ;; images delta^(k-1)(e_i) as rows: a spanning set of B^k
  (if (= k 0) '() (vector->list (transpose-rows (delta-matrix X (- k 1)) (x-count X (- k 1))))))
(define (h2-representatives X)                   ;; cocycles whose classes form a basis of H^2
  (let* ((Z (nullspace2 (delta-matrix X 2) (x-count X 2))) (B (coboundary-rows X 2)))
    (let loop ((zs Z) (chosen '()) (span B))
      (if (null? zs) (reverse chosen)
          (if (in-span2? span (car zs)) (loop (cdr zs) chosen span) (loop (cdr zs) (cons (car zs) chosen) (cons (car zs) span)))))))
(define (subsets-sums reps)                      ;; all GF(2) combinations of the representatives (one per class)
  (if (null? reps) (list #f)
      (let ((rest (subsets-sums (cdr reps))))
        (append rest (map (lambda (v) (if v (vec-add2 v (car reps)) (car reps))) rest)))))
(define (all-classes X) (let ((n (x-count X 2))) (map (lambda (v) (or v (make-vector n 0))) (subsets-sums (h2-representatives X)))))
;; cup products of 2-cochains, Alexander-Whitney on the 4-cells: (x u y)(v0..v4) = x(v0 v1 v2) y(v2 v3 v4)
(define (front-back X i)                         ;; front face v0 v1 v2 = d_4 d_3, back face v2 v3 v4 = d_0 d_0, through the face tables
  (cons (x-face X 3 (x-face X 4 i 4) 3) (x-face X 3 (x-face X 4 i 0) 0)))
(define (cup22 X x y) (list->vector (map (lambda (i) (let ((fb (front-back X i))) (modulo (* (vector-ref x (car fb)) (vector-ref y (cdr fb))) 2))) (range (x-count X 4)))))
(define (top-class X z) (if (in-span2? (coboundary-rows X 4) z) 0 1))    ;; the class of a 4-cocycle in H^4 = Z/2 (connected closed 4-manifold)

;; --- mapping spaces into the 3-types: route 1, the twisted-cochain state sum ----------------------------------------
;; #{(x, y) : delta x = 0, delta y = k(x)} summed over cocycles x = 2^(dim Z^2) many; grouped by class: each class
;; has |B^2| cocycle representatives with the same [x u x], and for each the number of y is 2^(dim ker delta^3)
;; when x u x is a coboundary, else 0.
(define (state-sum X k?)                         ;; k? = #t for k = iota u iota, #f for k = 0
  (let* ((D2 (delta-matrix X 2)) (D3 (delta-matrix X 3))
         (dimZ2 (- (x-count X 2) (rank2 D2)))
         (dimB2 (rank2 (delta-matrix X 1)))
         (kerD3 (- (x-count X 3) (rank2 D3)))
         (B4 (coboundary-rows X 4))
         (classes (all-classes X))
         (liftable (count-if (lambda (x) (or (not k?) (in-span2? B4 (cup22 X x x)))) classes))
         (pairs (* liftable (ipow 2 dimB2) (ipow 2 kerD3))))
    ;; |Map| = pairs * |C^0(A)| |C^1(B)| / (|C^1(A)| |C^0(B)| |C^2(B)|), A = B = Z/2
    (/ (* pairs (ipow 2 (x-count X 0)) (ipow 2 (x-count X 1)))
       (* (ipow 2 (x-count X 1)) (ipow 2 (x-count X 0)) (ipow 2 (x-count X 2))))))
;; --- route 2, the fibration formula -------------------------------------------------------------------------------
(define (fibration X k?)
  (let* ((h (betti2 X)) (H (lambda (i) (ipow 2 (list-ref h i))))
         (liftable (count-if (lambda (x) (or (not k?) (in-span2? (coboundary-rows X 4) (cup22 X x x)))) (all-classes X))))
    (* liftable (/ (H 0) (H 1)) (/ (* (H 3) (H 1)) (* (H 2) (H 0))))))
(define (k2-cardinality X) (let ((h (betti2 X)) (H (lambda (i) (ipow 2 (list-ref (betti2 X) i))))) (/ (* (H 2) (H 0)) (H 1))))
(define (k3-cardinality X) (let ((H (lambda (i) (ipow 2 (list-ref (betti2 X) i))))) (/ (* (H 3) (H 1)) (* (H 2) (H 0)))))
;; --- the manifolds ---------------------------------------------------------------------------------------
(define (plus-signs k) (map (lambda (i) 1) (range k)))
(define tetra-faces (map (lambda (k) (filter (lambda (v) (not (= v k))) (range 4))) (range 4)))
(define (paths-to a b)
  (if (and (= a 0) (= b 0)) (list (list (cons 0 0)))
      (let ((ext (lambda (ps) (map (lambda (p) (append p (list (cons a b)))) ps))))
        (append (if (> a 0) (ext (paths-to (- a 1) b)) '())
                (if (> b 0) (ext (paths-to a (- b 1))) '())
                (if (and (> a 0) (> b 0)) (ext (paths-to (- a 1) (- b 1))) '())))))
(define product-tops
  (let loop-s ((ss tetra-faces) (acc '()))
    (if (null? ss) acc
        (loop-s (cdr ss)
                (let loop-t ((ts tetra-faces) (acc2 acc))
                  (if (null? ts) acc2
                      (loop-t (cdr ts)
                              (append (map (lambda (path) (list (map (lambda (p) (+ (* 4 (list-ref (car ss) (car p))) (list-ref (car ts) (cdr p)))) path) (plus-signs 5)))
                                           (filter (lambda (path) (= 5 (length path))) (paths-to 2 2)))
                                      acc2))))))))
(define S2xS2 (build-complex 16 4 product-tops))
;; the swap (a, b) -> (b, a) on vertices 4 a + b; a cell's canonical form is the lexicographically smaller of
;; its vertex list and the transposed one
(define (transpose-vertex v) (+ (* 4 (remainder v 4)) (quotient v 4)))
(define (list-less? a b) (cond ((null? a) #f) ((< (car a) (car b)) #t) ((> (car a) (car b)) #f) (else (list-less? (cdr a) (cdr b)))))
(define (sym-canon vs ss) (let ((t (map transpose-vertex vs))) (if (list-less? t vs) (vector t ss) (vector vs ss))))
(define CP2 (build-complex-canon 16 4 product-tops sym-canon))
(show "S^2 x S^2 cells, Sym^2 cells" (list (x-counts S2xS2) (x-counts CP2)))
(check "the symmetric square has 10 vertices and 48 pentachora, Euler characteristic 3, and is a closed pseudomanifold; the product has chi 4"
       (and (= 10 (x-count CP2 0)) (= 48 (x-count CP2 4)) (= 3 (euler-char CP2)) (pseudomanifold? CP2) (= 4 (euler-char S2xS2)) (pseudomanifold? S2xS2)))
(check "the quotient is a Delta-complex and not a simplicial complex: 45 edges on 10 vertices, but only 40 distinct vertex pairs (an edge (a,b)-(a,c) and an edge (a,b)-(c,a) share their vertex orbits)"
       (let ((pairs (make-hash-table)))
         (let loop ((i 0)) (if (< i (x-count CP2 1)) (let* ((c (x-cell CP2 1 i)) (vs (map (lambda (v) (if (<= v (transpose-vertex v)) v (transpose-vertex v))) (vector-ref c 0))) (key (+ (* 16 (car vs)) (cadr vs))) (key2 (+ (* 16 (cadr vs)) (car vs)))) (hash-table-set! pairs (if (< key key2) key key2) #t) (loop (+ i 1)))))
         (and (= 45 (x-count CP2 1)) (= 40 (length (hash-table->alist pairs))))))
;; --- connected sums at the level of face tables ---------------------------------------------------------------
;; Drop the first 4-cell of each summand and identify the faces of their boundaries pairwise: the face of a
;; pentachoron on the vertex subset S is reached by dropping the missing vertices from the largest index down,
;; and the same drop sequence in both summands pairs the faces. Union-find then renumbers every dimension.
(define (subface X k i drops) (let loop ((k k) (i i) (ds drops)) (if (null? ds) i (loop (- k 1) (x-face X k i (car ds)) (cdr ds)))))
(define (subsets-of items k) (cond ((= k 0) (list '())) ((null? items) '()) (else (append (map (lambda (t) (cons (car items) t)) (subsets-of (cdr items) (- k 1))) (subsets-of (cdr items) k)))))
(define (drops-for S) (reverse (filter (lambda (v) (not (memv v S))) (range 5))))   ;; missing indices, largest first
(define (uf-find parent i) (let ((p (vector-ref parent i))) (if (= p i) i (uf-find parent p))))
(define (glue-sum X Y)
  (let* ((dim 4)
         (offset (lambda (k) (x-count X k)))
         (parents (list->vector (map (lambda (k) (let ((p (make-vector (+ (x-count X k) (x-count Y k)) 0))) (let init ((i 0)) (if (< i (vector-length p)) (begin (vector-set! p i i) (init (+ i 1))))) p)) (range (+ dim 1))))))
    ;; identify boundary faces of cell 0 of X with those of cell 0 of Y
    (for-each (lambda (size)
                (for-each (lambda (S)
                            (let* ((k (- size 1)) (a (subface X 4 0 (drops-for S))) (b (+ (offset k) (subface Y 4 0 (drops-for S))))
                                   (p (vector-ref parents k)) (ra (uf-find p a)) (rb (uf-find p b)))
                              (if (not (= ra rb)) (vector-set! p rb ra))))
                          (subsets-of (range 5) size)))
              (list 1 2 3 4))
    ;; renumber: every k-cell that is a root gets a new index; 4-cells 0 of X and Y are removed
    (let* ((newidx (list->vector (map (lambda (k) (make-vector (vector-length (vector-ref parents k)) -1)) (range (+ dim 1)))))
           (counts (make-vector (+ dim 1) 0)))
      (let loop-k ((k 0))
        (if (<= k dim)
            (let ((p (vector-ref parents k)) (ni (vector-ref newidx k)))
              (let loop ((i 0) (n 0))
                (if (< i (vector-length p))
                    (if (and (= i (uf-find p i)) (not (and (= k 4) (or (= i 0) (= i (offset 4))))))
                        (begin (vector-set! ni i n) (loop (+ i 1) (+ n 1)))
                        (loop (+ i 1) n))
                    (vector-set! counts k n)))
              (loop-k (+ k 1)))))
      (let ((resolve (lambda (k i) (vector-ref (vector-ref newidx k) (uf-find (vector-ref parents k) i))))
            (cells (list->vector (map (lambda (k) (make-vector (vector-ref counts k) (vector '() '()))) (range (+ dim 1)))))
            (faces (make-vector (+ dim 1) (vector))))
        (let loop-k ((k 1))
          (if (<= k dim)
              (let ((tab (make-vector (vector-ref counts k) #f)))
                (let loop ((i 0))
                  (if (< i (+ (x-count X k) (x-count Y k)))
                      (let ((ni (resolve k i)))
                        (if (>= ni 0)
                            (vector-set! tab ni (list->vector (map (lambda (j) (resolve (- k 1) (if (< i (x-count X k)) (x-face X k i j) (+ 0 (let ((f (x-face Y k (- i (x-count X k)) j))) (+ f (offset (- k 1)))))))) (range (+ k 1))))))
                        (loop (+ i 1)))))
                (vector-set! faces k tab)
                (loop-k (+ k 1)))))
        (vector (+ (x-count X 0) (x-count Y 0)) dim cells faces #f #f)))))
(define (pseudomanifold? X) (let ((count (make-vector (x-count X 3) 0)))
                              (let loop ((i 0)) (if (< i (x-count X 4)) (begin (let fl ((j 0)) (if (< j 5) (begin (vector-set! count (x-face X 4 i j) (+ 1 (vector-ref count (x-face X 4 i j)))) (fl (+ j 1))))) (loop (+ i 1)))))
                              (all? (lambda (t) (= 2 (vector-ref count t))) (range (x-count X 3)))))
(define CP2CP2 (glue-sum CP2 CP2))
(define CP2S2S2 (glue-sum CP2 S2xS2))
(define CP2x3 (glue-sum CP2CP2 CP2))
(define manifolds (list CP2 S2xS2 CP2CP2 CP2S2S2 CP2x3))
(define names (list "CP^2" "S^2xS^2" "CP^2#CP^2" "CP^2#S^2xS^2" "CP^2#CP^2#CP^2"))
(show "cells" (map x-counts manifolds))
(check "connected sums are closed pseudomanifolds with chi(X # Y) = chi(X) + chi(Y) - 2: 3, 4, 4, 5, 5"
       (and (all? pseudomanifold? manifolds) (equal? (map euler-char manifolds) (list 3 4 4 5 5))))
(define bettis (map (lambda (X) (with-region (betti2 X))) manifolds))
(show "mod 2 Betti numbers" bettis)
(check "mod 2 Betti numbers (1,0,1,0,1), (1,0,2,0,1), (1,0,2,0,1), (1,0,3,0,1), (1,0,3,0,1): CP^2#CP^2 and S^2xS^2 agree"
       (equal? bettis (list (list 1 0 1 0 1) (list 1 0 2 0 1) (list 1 0 2 0 1) (list 1 0 3 0 1) (list 1 0 3 0 1))))
(define (form-matrix X) (let ((reps (h2-representatives X))) (map (lambda (a) (map (lambda (b) (top-class X (cup22 X a b))) reps)) reps)))
(define forms (map (lambda (X) (with-region (form-matrix X))) manifolds))
(show "intersection forms mod 2 on computed bases" forms)
(define (odd-form? F) (any? (lambda (i) (= 1 (list-ref (list-ref F i) i))) (range (length F))))
(define (nondegenerate? F) (= (length F) (rank2 (list->vector (map list->vector F)))))
(check "every form is nondegenerate; CP^2 and the sums with a CP^2 summand are odd, S^2 x S^2 is even"
       (and (all? nondegenerate? forms) (equal? (map odd-form? forms) (list #t #f #t #t #t))))
(define untwisted (map (lambda (X) (with-region (state-sum X #f))) manifolds))
(define twisted (map (lambda (X) (with-region (state-sum X #t))) manifolds))
(define twisted-fib (map (lambda (X) (with-region (fibration X #t))) manifolds))
(show "Map into K(Z/2,2) x K(Z/2,3) (k = 0)" untwisted)
(show "Map into the 3-type with k = iota u iota: state sum, fibration formula" (list twisted twisted-fib))
(check "k = 0: all five give 1 (the Euler characteristic of the cochain complex cancels)" (all? (lambda (v) (= v 1)) untwisted))
(check "k = iota u iota: state sum = fibration formula; CP^2 1/2, S^2xS^2 1, CP^2#CP^2 1/2, CP^2#S^2xS^2 1/2, CP^2#CP^2#CP^2 1/2"
       (and (equal? twisted twisted-fib) (equal? twisted (list 1/2 1 1/2 1/2 1/2))))
(check "S^2 x S^2 and CP^2 # CP^2 have the same mod 2 homology and the same 2-type, and the 3-type P tells them apart (1 against 1/2)"
       (and (equal? (list-ref bettis 1) (list-ref bettis 2)) (not (= (list-ref twisted 1) (list-ref twisted 2)))))
(define (liftable-count X) (count-if (lambda (x) (in-span2? (coboundary-rows X 4) (cup22 X x x))) (all-classes X)))
(show "classes with vanishing cup square, out of |H^2|" (map (lambda (X) (with-region (list (liftable-count X) (length (all-classes X))))) manifolds))
(check "the number of classes with x u x = 0 is 2^(b_2 - 1) for an odd form (a hyperplane, the kernel of the Wu class) and 2^b_2 for the even one"
       (equal? (map (lambda (X) (with-region (liftable-count X))) manifolds) (list 1 4 2 4 4)))

(display "CP^2 as a symmetric square, connected sums, and the 3-type that separates S^2 x S^2 from CP^2 # CP^2") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
