;; Abelian sheaves on a finite site, over the rationals: the Alexandrov
;; equivalence between sheaves on the space and presheaves on its points is
;; computed (sheafification by the plus construction agrees with restriction
;; to the minimal opens followed by limits, as an isomorphism on every open),
;; sheafification is exact, and sheaf cohomology of the space is computed
;; three ways and found equal: as the derived functors of the limit over the
;; points (the cosimplicial replacement), as the Cech cohomology of the site's
;; cover by maximal opens, and as the Cech cohomology of the sheafified
;; presheaf on the site itself. Over Q, so torsion is not seen here; the
;; integral computations are in the finite-spaces example.
;;
;; Sources: M. C. McCord, Duke Math. J. 33 (1966) (the Alexandrov topology:
;; sheaves on a finite T_0 space are presheaves on its points); S. Mac Lane,
;; I. Moerdijk, "Sheaves in Geometry and Logic" III.5 (the plus construction,
;; a exact), III.8 (the sheaf condition as an equalizer); A. K. Bousfield,
;; D. M. Kan, LNM 304, XI (lim^n by the cosimplicial replacement); G. E.
;; Bredon, "Sheaf Theory" II.5, III.4 (Cech cohomology, the Leray theorem);
;; C. Weibel, "An Introduction to Homological Algebra" 2.6 (derived limits).
;;
;; An abelian presheaf on the site of opens assigns to each open a Q-vector
;; space (a dimension) and to each inclusion a rational matrix. Matching
;; families over a sieve are the kernel of the compatibility matrix; F^+(U)
;; is the matching space over the smallest covering sieve with its
;; restriction maps expressed in kernel bases by solving; the point-route
;; sections are the limit over the points of the open. Everything is exact
;; rational linear algebra (fraction-free elimination on Eshkol rationals).
;;
;;   1. On the sites of the pseudocircle and the pseudo-2-sphere, for the
;;      constant presheaf Q, a presheaf that is not separated, and a local
;;      system with monodromy -1: F^+ is separated, F^{++} is a sheaf, and
;;      F^{++}(U) = lim over the points of U of F(U_x) with the canonical
;;      comparison map an isomorphism on every open (the Alexandrov
;;      equivalence, computed).
;;   2. Exactness of a: for maps of presheaves f the kernel presheaf
;;      sheafifies to the kernel of the sheafified map and the cokernel
;;      dimensions match (a is exact), while the inclusion i preserves
;;      kernels but not cokernels (the constant presheaf maps onto the
;;      constant sheaf with a nonzero cokernel dimension at the
;;      disconnected open).
;;   3. Cohomology three ways: lim^n over the points, Cech cohomology of
;;      the cover by maximal opens with sections computed as limits over
;;      points, and Cech cohomology of the sheafified presheaf on the site.
;;      On the pseudocircle the cover is Leray and the three agree: (1, 1)
;;      for Q and (0, 0) for the monodromy -1 local system (its torsion is
;;      invisible over Q). On the pseudo-2-sphere the derived limit gives
;;      (1, 0, 1) while the only cover by maximal opens has the pseudocircle
;;      as its intersection, so both Cech routes give (1, 0, 0) and miss
;;      H^2: the Leray condition fails, as the descent example showed.
;;
;; DEFECT NOTES (routed around): as in the sibling examples; recursive
;; enumerators are top-level definitions or explicit loops (LE-23).

(require stdlib)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (any? pred (cdr xs)))))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))
(define (position-of item items) (let loop ((l items) (i 0)) (cond ((null? l) #f) ((equal? (car l) item) i) (else (loop (cdr l) (+ i 1))))))
(define (dedup xs) (let loop ((l xs) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (else (loop (cdr l) (cons (car l) acc))))))
(define (cartesian lists) (if (null? lists) (list '()) (let ((rest (cartesian (cdr lists)))) (let loop ((xs (car lists)) (acc '())) (if (null? xs) acc (loop (cdr xs) (append (map (lambda (t) (cons (car xs) t)) rest) acc)))))))
(define (list-index-of pred xs) (let loop ((l xs) (i 0)) (cond ((null? l) #f) ((pred (car l)) i) (else (loop (cdr l) (+ i 1))))))

;; --- finite categories -------------------------------------------------------------------------------------
;; A category: (vector nobj arrows comp ids) with arrows a vector of (vector src tgt name), comp a hash table
;; (g . f) -> g o f keyed by (+ (* n g) f), ids a vector object -> identity arrow index. Arrows are composed
;; as (compose C g f) = g o f, defined when tgt f = src g.
(define (c-nobj C) (vector-ref C 0))
(define (c-arrows C) (vector-ref C 1))
(define (c-narr C) (vector-length (vector-ref C 1)))
(define (a-src C a) (vector-ref (vector-ref (c-arrows C) a) 0))
(define (a-tgt C a) (vector-ref (vector-ref (c-arrows C) a) 1))
(define (a-name C a) (vector-ref (vector-ref (c-arrows C) a) 2))
(define (c-id C x) (vector-ref (vector-ref C 3) x))
(define (compose C g f) (hash-table-ref/default (vector-ref C 2) (+ (* (c-narr C) g) f) #f))
(define (composable? C g f) (= (a-tgt C f) (a-src C g)))
(define (hom C x y) (filter (lambda (a) (and (= x (a-src C a)) (= y (a-tgt C a)))) (range (c-narr C))))
;; build from generators and relations: objects 0..n-1, generators (src tgt name), and a normal-form function
;; on words (lists of generator indices, applied right to left: (g2 g1) means g2 o g1) that returns the canonical
;; word; arrows are the distinct normal forms of all composable words up to a length bound, identities the empty word
(define (make-category n gens normal-form max-len)
  (let* ((ngen (length gens))
         (gsrc (lambda (g) (car (list-ref gens g)))) (gtgt (lambda (g) (cadr (list-ref gens g))))
         (word-src (lambda (w x) (if (null? w) x (gsrc (car (reverse w))))))
         (word-tgt (lambda (w x) (if (null? w) x (gtgt (car w)))))
         ;; enumerate composable words by length, keyed by (object, normal-form word)
         (words (let loop ((len 0) (frontier (map (lambda (x) (cons x '())) (range n))) (acc '()))
                  (if (> len max-len) acc
                      (let* ((new (dedup (map (lambda (p) (cons (car p) (normal-form (cdr p)))) frontier)))
                             (fresh (filter (lambda (p) (not (member p acc))) new))
                             (next (let ext ((ps fresh) (out '()))
                                     (if (null? ps) out
                                         (ext (cdr ps)
                                              (append (map (lambda (g) (cons (car (car ps)) (cons g (cdr (car ps)))))
                                                           (filter (lambda (g) (= (gsrc g) (word-tgt (cdr (car ps)) (car (car ps))))) (range ngen)))
                                                      out))))))
                        (loop (+ len 1) next (append acc fresh))))))
         (arrows (list->vector (map (lambda (p) (vector (car p) (word-tgt (cdr p) (car p)) (cdr p))) words)))
         (narr (vector-length arrows))
         (index (let ((t (make-hash-table))) (let loop ((i 0)) (if (< i narr) (begin (hash-table-set! t (list (a-src (vector 0 arrows) i) (vector-ref (vector-ref arrows i) 2)) i) (loop (+ i 1))))) t))
         (comp (make-hash-table))
         (ids (list->vector (map (lambda (x) (hash-table-ref/default index (list x '()) #f)) (range n)))))
    (let loop-g ((g 0))
      (if (< g narr)
          (begin
            (let loop-f ((f 0))
              (if (< f narr)
                  (begin
                    (if (= (vector-ref (vector-ref arrows f) 1) (vector-ref (vector-ref arrows g) 0))
                        (let* ((w (normal-form (append (vector-ref (vector-ref arrows g) 2) (vector-ref (vector-ref arrows f) 2))))
                               (k (hash-table-ref/default index (list (vector-ref (vector-ref arrows f) 0) w) #f)))
                          (if k (hash-table-set! comp (+ (* narr g) f) k) (error "composite outside the enumerated arrows: raise max-len"))))
                    (loop-f (+ f 1)))))
            (loop-g (+ g 1)))))
    (vector n arrows comp ids)))
(define (category-laws? C)
  (and (all? (lambda (a) (and (= a (compose C a (c-id C (a-src C a)))) (= a (compose C (c-id C (a-tgt C a)) a)))) (range (c-narr C)))
       (all? (lambda (h) (all? (lambda (g) (all? (lambda (f)
               (or (not (composable? C g f)) (not (composable? C h g))
                   (= (compose C h (compose C g f)) (compose C (compose C h g) f))))
             (range (c-narr C)))) (range (c-narr C)))) (range (c-narr C)))))
;; presentations
(define (free-nf w) w)                            ;; free category: every word is its own normal form
(define (poset-nf w) (if (null? w) '() (list (car w))))   ;; thin: any composite x -> y is THE arrow; encode by target gen
(define walking-arrow (make-category 2 (list (list 0 1 'f)) free-nf 1))
(define (square-nf w) (if (equal? w (list 3 1)) (list 2 0) w))   ;; d o b -> c o a (generators indexed 0..3 = a b c d)
(define square (make-category 4 (list (list 0 1 'a) (list 0 2 'b) (list 1 3 'c) (list 2 3 'd)) square-nf 2))
(define (poset-category n covers)                ;; thin category from a cover relation; arrows = comparable pairs
  (let* ((leq (make-vector (* n n) #f)))
    (let loop ((i 0)) (if (< i n) (begin (vector-set! leq (+ (* n i) i) #t) (loop (+ i 1)))))
    (for-each (lambda (c) (vector-set! leq (+ (* n (car c)) (cdr c)) #t)) covers)
    (let outer ((k 0)) (if (< k n) (begin (let li ((i 0)) (if (< i n) (begin (let lj ((j 0)) (if (< j n) (begin (if (and (vector-ref leq (+ (* n i) k)) (vector-ref leq (+ (* n k) j))) (vector-set! leq (+ (* n i) j) #t)) (lj (+ j 1))))) (li (+ i 1))))) (outer (+ k 1)))))
    (let* ((pairs (filter (lambda (p) (vector-ref leq (+ (* n (car p)) (cadr p)))) (cartesian (list (range n) (range n)))))
           (arrows (list->vector (map (lambda (p) (vector (car p) (cadr p) (list (car p) (cadr p)))) pairs)))
           (narr (vector-length arrows)) (comp (make-hash-table))
           (idx (lambda (x y) (list-index-of (lambda (p) (and (= (car p) x) (= (cadr p) y))) pairs))))
      (let lg ((g 0)) (if (< g narr) (begin (let lf ((f 0)) (if (< f narr) (begin (if (= (vector-ref (vector-ref arrows f) 1) (vector-ref (vector-ref arrows g) 0)) (hash-table-set! comp (+ (* narr g) f) (idx (vector-ref (vector-ref arrows f) 0) (vector-ref (vector-ref arrows g) 1)))) (lf (+ f 1))))) (lg (+ g 1)))))
      (vector n arrows comp (list->vector (map (lambda (x) (idx x x)) (range n)))))))
(define S (poset-category 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define S2 (poset-category 6 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3) (cons 2 4) (cons 3 4) (cons 2 5) (cons 3 5))))
(define (z2-nf w) (if (even? (length w)) '() (list 0)))
(define BZ2 (make-category 1 (list (list 0 0 's)) z2-nf 2))
(define point (make-category 1 '() free-nf 0))
;; --- functors, set-valued functors, natural transformations ------------------------------------------------------
;; a functor C -> D: (vector obj-map arrow-map); checked on identities and all composites
(define (functor? C D F)
  (let ((F0 (vector-ref F 0)) (F1 (vector-ref F 1)))
    (and (all? (lambda (a) (and (= (vector-ref F0 (a-src C a)) (a-src D (vector-ref F1 a))) (= (vector-ref F0 (a-tgt C a)) (a-tgt D (vector-ref F1 a))))) (range (c-narr C)))
         (all? (lambda (x) (= (vector-ref F1 (c-id C x)) (c-id D (vector-ref F0 x)))) (range (c-nobj C)))
         (all? (lambda (g) (all? (lambda (f) (or (not (composable? C g f)) (= (vector-ref F1 (compose C g f)) (compose D (vector-ref F1 g) (vector-ref F1 f))))) (range (c-narr C)))) (range (c-narr C))))))
;; a Set-valued functor on C: (vector sets maps): sets a vector of lists (elements), maps a vector arrow -> vector
;; (function on element indices)
(define (sf-set X x) (vector-ref (vector-ref X 0) x))
(define (sf-map X a) (vector-ref (vector-ref X 1) a))
(define (sf-apply X a i) (vector-ref (sf-map X a) i))
(define (set-functor? C X)
  (and (all? (lambda (x) (let ((n (length (sf-set X x)))) (all? (lambda (i) (= i (sf-apply X (c-id C x) i))) (range n)))) (range (c-nobj C)))
       (all? (lambda (g) (all? (lambda (f) (or (not (composable? C g f))
                                              (all? (lambda (i) (= (sf-apply X (compose C g f) i) (sf-apply X g (sf-apply X f i)))) (range (length (sf-set X (a-src C f)))))))
                              (range (c-narr C)))) (range (c-narr C)))))
(define (natural? C X Y eta)                     ;; eta: vector object -> vector (component function on indices)
  (all? (lambda (a) (let ((x (a-src C a)) (y (a-tgt C a)))
                      (all? (lambda (i) (= (vector-ref (vector-ref eta y) (sf-apply X a i)) (sf-apply Y a (vector-ref (vector-ref eta x) i)))) (range (length (sf-set X x))))))
        (range (c-narr C))))
(define (make-set-functor C sets maps) (vector (list->vector sets) (list->vector maps)))
(define (arrow-named C name) (list-index-of (lambda (a) (equal? (a-name C a) name)) (range (c-narr C))))
;; a Set-functor from an alist name -> function vector; identities are filled in automatically
(define (set-functor-by-names C sets alist)
  (make-set-functor C sets
                    (map (lambda (a) (let ((x (a-src C a)))
                                       (if (= a (c-id C x)) (list->vector (range (length (list-ref sets x))))
                                           (let ((e (assoc (a-name C a) alist))) (if e (cdr e) (error "no map for arrow"))))))
                         (range (c-narr C)))))

;; --- opposite categories and presheaves ---------------------------------------------------------------------
(define (opposite C)
  (let* ((n (c-narr C)) (arrows (list->vector (map (lambda (a) (vector (a-tgt C a) (a-src C a) (a-name C a))) (range n)))) (comp (make-hash-table)))
    (let lg ((g 0)) (if (< g n) (begin (let lf ((f 0)) (if (< f n) (begin (if (composable? C f g) (hash-table-set! comp (+ (* n g) f) (compose C f g))) (lf (+ f 1))))) (lg (+ g 1)))))
    (vector (c-nobj C) arrows comp (vector-ref C 3))))
;; a presheaf on C = a Set-functor on (opposite C); for a: c' -> c in C the map X(a): X(c) -> X(c') is (sf-map X a)
(define (arrows-into C c) (filter (lambda (a) (= c (a-tgt C a))) (range (c-narr C))))
(define (subsets xs) (if (null? xs) (list '()) (let ((rest (subsets (cdr xs)))) (append rest (map (lambda (s) (cons (car xs) s)) rest)))))
(define (sorted-ints xs) (let loop ((l xs) (acc '())) (if (null? l) acc (loop (cdr l) (let ins ((x (car l)) (ys acc)) (cond ((null? ys) (list x)) ((<= x (car ys)) (if (= x (car ys)) ys (cons x ys))) (else (cons (car ys) (ins x (cdr ys))))))))))
(define (sieve? C c S) (all? (lambda (h) (all? (lambda (g) (or (not (composable? C h g)) (memv (compose C h g) S))) (range (c-narr C)))) S))
(define (sieves C c) (map sorted-ints (filter (lambda (S) (sieve? C c S)) (subsets (arrows-into C c)))))
(define (pullback-sieve C f S) (sorted-ints (filter (lambda (g) (and (composable? C f g) (memv (compose C f g) S))) (arrows-into C (a-src C f)))))
(define (omega C)                                ;; the presheaf of sieves
  (let ((sv (list->vector (map (lambda (c) (sieves C c)) (range (c-nobj C))))))
    (make-set-functor (opposite C)
                      (map (lambda (c) (vector-ref sv c)) (range (c-nobj C)))
                      (map (lambda (a) (list->vector (map (lambda (S) (position-of (pullback-sieve C a S) (vector-ref sv (a-src C a)))) (vector-ref sv (a-tgt C a))))) (range (c-narr C))))))
(define (maximal-sieve-index C Om c) (position-of (sorted-ints (arrows-into C c)) (sf-set Om c)))
;; --- sites of open sets of finite spaces ----------------------------------------------------------------------
(define (down-set-of P xs)                        ;; the down-closure of a list of points in the poset category P
  (dedup (let loop ((l xs) (acc '())) (if (null? l) acc (loop (cdr l) (append (filter (lambda (y) (not (null? (hom P y (car l))))) (range (c-nobj P))) acc))))))
(define (opens P)                                 ;; all nonempty down-sets, as sorted point lists
  (dedup (map (lambda (xs) (sorted-ints (down-set-of P xs))) (filter (lambda (xs) (not (null? xs))) (subsets (range (c-nobj P)))))))
(define (subset-list? A B) (all? (lambda (x) (memv x B)) A))
(define (site P)                                  ;; the poset category of opens under inclusion, plus the open list
  (let* ((os (opens P)) (n (length os))
         (pairs (filter (lambda (pr) (subset-list? (list-ref os (car pr)) (list-ref os (cadr pr)))) (cartesian (list (range n) (range n)))))
         (arrows (list->vector (map (lambda (pr) (vector (car pr) (cadr pr) (list (car pr) (cadr pr)))) pairs)))
         (narr (vector-length arrows)) (comp (make-hash-table))
         (idx (lambda (x y) (list-index-of (lambda (pr) (and (= (car pr) x) (= (cadr pr) y))) pairs))))
    (let lg ((g 0)) (if (< g narr) (begin (let lf ((f 0)) (if (< f narr) (begin (if (= (vector-ref (vector-ref arrows f) 1) (vector-ref (vector-ref arrows g) 0)) (hash-table-set! comp (+ (* narr g) f) (idx (vector-ref (vector-ref arrows f) 0) (vector-ref (vector-ref arrows g) 1)))) (lf (+ f 1))))) (lg (+ g 1)))))
    (vector n arrows comp (list->vector (map (lambda (x) (idx x x)) (range n))) os)))
(define (site-opens C) (vector-ref C 4))
(define (open-arrow C V U) (car (hom C V U)))     ;; the inclusion V -> U
(define (union-of C Vs) (sorted-ints (dedup (let loop ((l Vs) (acc '())) (if (null? l) acc (loop (cdr l) (append (list-ref (site-opens C) (car l)) acc)))))))
;; sieves on U as sets of opens V <= U closed downward; the canonical topology: R covers U iff union R = U
(define (open-sieves C U) (filter (lambda (Vs) (all? (lambda (V) (all? (lambda (W) (or (not (subset-list? (list-ref (site-opens C) W) (list-ref (site-opens C) V))) (memv W Vs))) (range (c-nobj C)))) Vs))
                                  (subsets (filter (lambda (V) (subset-list? (list-ref (site-opens C) V) (list-ref (site-opens C) U))) (range (c-nobj C))))))
(define (covering? C U Vs) (equal? (union-of C Vs) (list-ref (site-opens C) U)))
(define (covering-sieves C U) (filter (lambda (Vs) (covering? C U Vs)) (open-sieves C U)))
(define (arrow-sieve C U Vs) (sorted-ints (map (lambda (V) (open-arrow C V U)) Vs)))   ;; the same sieve as arrow indices
(define (canonical-topology C) (map (lambda (U) (map (lambda (Vs) (arrow-sieve C U Vs)) (covering-sieves C U))) (range (c-nobj C))))
(define (minimal-cover C U)                       ;; the intersection of all covering sieves
  (let loop ((l (cdr (covering-sieves C U))) (acc (car (covering-sieves C U)))) (if (null? l) acc (loop (cdr l) (filter (lambda (V) (memv V (car l))) acc)))))
(define (maximal-proper-opens C U) (filter (lambda (V) (and (not (= V U)) (subset-list? (list-ref (site-opens C) V) (list-ref (site-opens C) U))
                                                             (not (any? (lambda (W) (and (not (= W V)) (not (= W U)) (subset-list? (list-ref (site-opens C) V) (list-ref (site-opens C) W)) (subset-list? (list-ref (site-opens C) W) (list-ref (site-opens C) U)))) (range (c-nobj C))))))
                                           (range (c-nobj C))))
(define (generated-sieve C Vs) (sorted-ints (dedup (filter (lambda (W) (any? (lambda (V) (subset-list? (list-ref (site-opens C) W) (list-ref (site-opens C) V))) Vs)) (range (c-nobj C))))))
(define CS (site S)) (define CS2 (site S2))
(define (site-with-poset P) (let ((C (site P))) (vector (vector-ref C 0) (vector-ref C 1) (vector-ref C 2) (vector-ref C 3) (vector-ref C 4) P)))
(define CS* (site-with-poset S)) (define CS2* (site-with-poset S2))
;; component index tables: for each open, its points grouped by component in a fixed order
(define (component-classes C U)
  (let* ((pts (list-ref (site-opens C) U)) (parent (make-vector 64 -1)))
    (for-each (lambda (p) (vector-set! parent p p)) pts)
    (let ((root (lambda (i) (let lp ((i i)) (if (= i (vector-ref parent i)) i (lp (vector-ref parent i)))))))
      (for-each (lambda (p) (for-each (lambda (q) (if (or (not (null? (hom (vector-ref C 5) p q))) (not (null? (hom (vector-ref C 5) q p))))
                                                       (let ((a (root p)) (b (root q))) (if (not (= a b)) (vector-set! parent a b))))) pts)) pts)
      (let ((roots (dedup (map root pts)))) (map (lambda (r) (filter (lambda (p) (= r (root p))) pts)) roots)))))
(define (components C U) (length (component-classes C U)))
(define (component-of-in C V cV U)                ;; the index of the component of U containing component cV of V
  (let ((p (car (list-ref (component-classes C V) cV)))) (list-index-of (lambda (cls) (memv p cls)) (component-classes C U))))
;; --- exact rational linear algebra: matrices as vectors of row vectors -----------------------------------------
(define (q-matrix rows cols) (let ((M (make-vector rows 0))) (let loop ((i 0)) (if (< i rows) (begin (vector-set! M i (make-vector cols 0)) (loop (+ i 1))))) M))
(define (q-rows A) (vector-length A))
(define (q-cols A) (if (= 0 (vector-length A)) 0 (vector-length (vector-ref A 0))))
(define (q-ref A i j) (vector-ref (vector-ref A i) j))
(define (q-set! A i j v) (vector-set! (vector-ref A i) j v))
(define (q-copy A) (list->vector (map (lambda (r) (let ((w (make-vector (vector-length r) 0))) (let cp ((i 0)) (if (< i (vector-length r)) (begin (vector-set! w i (vector-ref r i)) (cp (+ i 1))))) w)) (vector->list A))))
(define (q-equal? A B) (and (= (q-rows A) (q-rows B)) (= (q-cols A) (q-cols B)) (all? (lambda (i) (all? (lambda (j) (= (q-ref A i j) (q-ref B i j))) (range (q-cols A)))) (range (q-rows A)))))
(define (q-identity n) (let ((I (q-matrix n n))) (let loop ((i 0)) (if (< i n) (begin (q-set! I i i 1) (loop (+ i 1))))) I))
(define (q-rref! R)                              ;; reduced row echelon form in place; returns the pivot columns
  (let* ((m (q-rows R)) (n (q-cols R)))
    (let loop ((r 0) (c 0) (pivots '()))
      (if (or (= r m) (= c n)) (reverse pivots)
          (let ((piv (let seek ((i r)) (cond ((= i m) #f) ((not (= 0 (q-ref R i c))) i) (else (seek (+ i 1)))))))
            (if (not piv) (loop r (+ c 1) pivots)
                (begin
                  (let ((t (vector-ref R r))) (vector-set! R r (vector-ref R piv)) (vector-set! R piv t))
                  (let* ((prow (vector-ref R r)) (inv (/ 1 (vector-ref prow c))))
                    (let norm ((j 0)) (if (< j n) (begin (vector-set! prow j (* inv (vector-ref prow j))) (norm (+ j 1)))))
                    (let rows ((i 0))
                      (if (< i m)
                          (begin (if (and (not (= i r)) (not (= 0 (q-ref R i c))))
                                     (let ((f (q-ref R i c)) (row (vector-ref R i)))
                                       (let sub ((j 0)) (if (< j n) (begin (vector-set! row j (- (vector-ref row j) (* f (vector-ref prow j)))) (sub (+ j 1)))))))
                                 (rows (+ i 1))))))
                  (loop (+ r 1) (+ c 1) (cons c pivots)))))))))
(define (q-rank A) (if (= 0 (q-rows A)) 0 (length (q-rref! (q-copy A)))))
(define (q-nullspace A n)                        ;; basis of {v in Q^n : A v = 0}
  (if (= 0 (q-rows A)) (map (lambda (j) (let ((v (make-vector n 0))) (vector-set! v j 1) v)) (range n))
      (let* ((R (q-copy A)) (pivots (q-rref! R)) (free (filter (lambda (j) (not (memv j pivots))) (range n))))
        (map (lambda (f) (let ((v (make-vector n 0)))
                           (vector-set! v f 1)
                           (let loop ((ps pivots) (r 0)) (if (not (null? ps)) (begin (vector-set! v (car ps) (- 0 (q-ref R r f))) (loop (cdr ps) (+ r 1)))))
                           v))
             free))))
(define (q-mat-vec A v) (list->vector (map (lambda (row) (let loop ((j 0) (s 0)) (if (= j (vector-length row)) s (loop (+ j 1) (+ s (* (vector-ref row j) (vector-ref v j))))))) (vector->list A))))
(define (q-mat-mul A B) (let ((C (q-matrix (q-rows A) (q-cols B)))) (let li ((i 0)) (if (< i (q-rows A)) (begin (let lj ((j 0)) (if (< j (q-cols B)) (begin (q-set! C i j (let lk ((k 0) (s 0)) (if (= k (q-cols A)) s (lk (+ k 1) (+ s (* (q-ref A i k) (q-ref B k j))))))) (lj (+ j 1))))) (li (+ i 1))))) C))
(define (q-from-columns cols n) (let ((M (q-matrix n (length cols)))) (let loop ((cs cols) (j 0)) (if (not (null? cs)) (begin (let f ((i 0)) (if (< i n) (begin (q-set! M i j (vector-ref (car cs) i)) (f (+ i 1))))) (loop (cdr cs) (+ j 1))))) M))
(define (q-solve-in-basis basis n v)             ;; coordinates y with sum y_j basis_j = v (basis independent), or #f
  (let* ((k (length basis)) (Aug (q-matrix n (+ k 1))))
    (let loop ((bs basis) (j 0)) (if (not (null? bs)) (begin (let f ((i 0)) (if (< i n) (begin (q-set! Aug i j (vector-ref (car bs) i)) (f (+ i 1))))) (loop (cdr bs) (+ j 1)))))
    (let f ((i 0)) (if (< i n) (begin (q-set! Aug i k (vector-ref v i)) (f (+ i 1)))))
    (let ((pivots (q-rref! Aug)))
      (if (memv k pivots) #f
          (let ((y (make-vector k 0)))
            (let loop ((ps pivots) (r 0)) (if (not (null? ps)) (begin (vector-set! y (car ps) (q-ref Aug r k)) (loop (cdr ps) (+ r 1)))))
            y)))))
(define (q-vec-concat vs) (list->vector (apply append (map vector->list vs))))
(define (q-vec-slice v from len) (let ((w (make-vector len 0))) (let loop ((i 0)) (if (< i len) (begin (vector-set! w i (vector-ref v (+ from i))) (loop (+ i 1))))) w))
(define (q-scale-vec v c) (list->vector (map (lambda (x) (* c x)) (vector->list v))))
(define (q-add-vec a b) (list->vector (map (lambda (i) (+ (vector-ref a i) (vector-ref b i))) (range (vector-length a)))))
(define (q-zero-vec n) (make-vector n 0))

;; --- abelian presheaves on a site: (vector dims maps) with maps[arrow V <= U] a dim(V) x dim(U) rational matrix ----
(define (ap-dim F U) (vector-ref (vector-ref F 0) U))
(define (ap-map F a) (vector-ref (vector-ref F 1) a))
(define (ap-restrict C F U V v) (q-mat-vec (ap-map F (open-arrow C V U)) v))
(define (make-ap C dims mapf) (vector (list->vector dims) (list->vector (map (lambda (a) (mapf (a-src C a) (a-tgt C a))) (range (c-narr C))))))
(define (ap-functor? C F)                        ;; identities and composites
  (and (all? (lambda (U) (q-equal? (ap-map F (c-id C U)) (q-identity (ap-dim F U)))) (range (c-nobj C)))
       (all? (lambda (g) (all? (lambda (f) (or (not (composable? C g f)) (q-equal? (ap-map F (compose C g f)) (q-mat-mul (ap-map F f) (ap-map F g))))) (range (c-narr C)))) (range (c-narr C)))))
;; matching space over a list of opens Vs (closed or not under intersection: compatibility on every inclusion among them)
(define (offsets-of C F Vs) (let loop ((l Vs) (o 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ o (ap-dim F (car l))) (cons o acc)))))
(define (total-dim C F Vs) (let loop ((l Vs) (o 0)) (if (null? l) o (loop (cdr l) (+ o (ap-dim F (car l)))))))
(define (compatibility-rows C F Vs)              ;; for each inclusion W <= V among Vs: rows  res_{V->W}(x_V) - x_W = 0
  (let* ((offs (offsets-of C F Vs)) (n (total-dim C F Vs)) (rows '()))
    (let li ((i 0))
      (if (< i (length Vs))
          (begin
            (let lj ((j 0))
              (if (< j (length Vs))
                  (begin
                    (if (and (not (= i j)) (subset-list? (list-ref (site-opens C) (list-ref Vs j)) (list-ref (site-opens C) (list-ref Vs i))))
                        (let ((M (ap-map F (open-arrow C (list-ref Vs j) (list-ref Vs i)))))
                          (let lr ((r 0))
                            (if (< r (ap-dim F (list-ref Vs j)))
                                (let ((row (make-vector n 0)))
                                  (let lc ((c 0)) (if (< c (ap-dim F (list-ref Vs i))) (begin (vector-set! row (+ (list-ref offs i) c) (q-ref M r c)) (lc (+ c 1)))))
                                  (vector-set! row (+ (list-ref offs j) r) (- (vector-ref row (+ (list-ref offs j) r)) 1))
                                  (set! rows (cons row rows))
                                  (lr (+ r 1)))))))
                    (lj (+ j 1)))))
            (li (+ i 1)))))
    (list->vector (reverse rows))))
(define (matching-space C F Vs) (q-nullspace (compatibility-rows C F Vs) (total-dim C F Vs)))   ;; basis over the direct sum
(define (restriction-vector C F U Vs v) (q-vec-concat (map (lambda (V) (ap-restrict C F U V v)) Vs)))
(define (sheaf-at-q? C F U Vs) (let* ((basis (matching-space C F Vs)) (n (total-dim C F Vs))
                                      (img (map (lambda (j) (restriction-vector C F U Vs (let ((e (make-vector (ap-dim F U) 0))) (vector-set! e j 1) e))) (range (ap-dim F U)))))
                                 (and (= (length basis) (ap-dim F U)) (= (ap-dim F U) (if (null? img) 0 (q-rank (q-from-columns img n)))))))
(define (sheaf-q? C F) (all? (lambda (U) (all? (lambda (Vs) (sheaf-at-q? C F U Vs)) (covering-sieves C U))) (range (c-nobj C))))
(define (separated-q? C F) (all? (lambda (U) (all? (lambda (Vs) (let* ((n (total-dim C F Vs)) (img (map (lambda (j) (restriction-vector C F U Vs (let ((e (make-vector (ap-dim F U) 0))) (vector-set! e j 1) e))) (range (ap-dim F U)))))
                                                              (= (ap-dim F U) (if (null? img) 0 (q-rank (q-from-columns img n))))))
                                                  (covering-sieves C U))) (range (c-nobj C))))
;; the plus construction: F^+(U) = matching space over R_min(U) in its kernel basis; restriction U -> V by restricting a
;; family on R_min(U) to R_min(V) (each W in R_min(V) lies in some Y in R_min(U)) and solving in the basis at V
(define (plus-q C F)
  (let* ((n (c-nobj C)) (mins (map (lambda (U) (minimal-cover C U)) (range n)))
         (bases (map (lambda (U) (matching-space C F (list-ref mins U))) (range n)))
         (restrict-fam (lambda (U V fam)
                         (q-vec-concat (map (lambda (W) (let* ((RU (list-ref mins U)) (offs (offsets-of C F RU))
                                                               (Y (car (filter (lambda (Y) (subset-list? (list-ref (site-opens C) W) (list-ref (site-opens C) Y))) RU)))
                                                               (yi (position-of Y RU)))
                                                          (ap-restrict C F Y W (q-vec-slice fam (list-ref offs yi) (ap-dim F Y)))))
                                            (list-ref mins V))))))
    (vector (list->vector (map (lambda (U) (length (list-ref bases U))) (range n)))
            (list->vector (map (lambda (a) (let* ((V (a-src C a)) (U (a-tgt C a)) (bU (list-ref bases U)) (bV (list-ref bases V)) (M (q-matrix (length bV) (length bU))))
                                             (let loop ((bs bU) (j 0))
                                               (if (not (null? bs))
                                                   (let ((y (q-solve-in-basis bV (total-dim C F (list-ref mins V)) (restrict-fam U V (car bs)))))
                                                     (if (not y) (error "restricted family not matching"))
                                                     (let f ((i 0)) (if (< i (length bV)) (begin (q-set! M i j (vector-ref y i)) (f (+ i 1)))))
                                                     (loop (cdr bs) (+ j 1)))))
                                             M))
                               (range (c-narr C)))))))
(define (sheafify-q C F) (plus-q C (plus-q C F)))
(define (ap-dims F n) (map (lambda (U) (ap-dim F U)) (range n)))
;; the point route: sections over U = matching space over the minimal opens U_x, x in U (dimension), and the canonical
;; comparison from F^{++}(U): restrict a double-plus family down to the point opens
(define (point-opens C U) (dedup (map (lambda (x) (position-of (sorted-ints (down-set-of (vector-ref C 5) (list x))) (site-opens C))) (list-ref (site-opens C) U))))
(define (point-sections-dim C F U) (length (matching-space C F (point-opens C U))))
;; the inverse of restriction to points: a presheaf given on the point opens U_x extends to the sheaf U -> lim_{x in U} F(U_x)
(define (extend-from-points C F)
  (let* ((n (c-nobj C)) (pts (map (lambda (U) (point-opens C U)) (range n)))
         (bases (map (lambda (U) (matching-space C F (list-ref pts U))) (range n)))
         (restrict-fam (lambda (U V fam)          ;; a family over the point opens of U, read off on the point opens of V
                         (let ((offs (offsets-of C F (list-ref pts U))))
                           (q-vec-concat (map (lambda (Px) (q-vec-slice fam (list-ref offs (position-of Px (list-ref pts U))) (ap-dim F Px))) (list-ref pts V)))))))
    (vector (list->vector (map (lambda (U) (length (list-ref bases U))) (range n)))
            (list->vector (map (lambda (a) (let* ((V (a-src C a)) (U (a-tgt C a)) (bU (list-ref bases U)) (bV (list-ref bases V)) (M (q-matrix (length bV) (length bU))))
                                             (let loop ((bs bU) (j 0))
                                               (if (not (null? bs))
                                                   (let ((y (q-solve-in-basis bV (total-dim C F (list-ref pts V)) (restrict-fam U V (car bs)))))
                                                     (let ff ((i 0)) (if (< i (length bV)) (begin (q-set! M i j (vector-ref y i)) (ff (+ i 1)))))
                                                     (loop (cdr bs) (+ j 1)))))
                                             M))
                               (range (c-narr C)))))))
;; a local system given on the point poset: rank one at every point, restriction U_x -> U_y (y < x) with a sign
(define (point-local-system C sign)              ;; values only on point opens (0 elsewhere); extend-from-points completes it
  (let ((is-point (lambda (U) (any? (lambda (x) (equal? (list-ref (site-opens C) U) (sorted-ints (down-set-of (vector-ref C 5) (list x))))) (list-ref (site-opens C) U)))))
    (make-ap C (map (lambda (U) (if (is-point U) 1 0)) (range (c-nobj C)))
             (lambda (V U) (if (and (is-point V) (is-point U)) (vector (vector (sign V U))) (q-matrix (if (is-point V) 1 0) (if (is-point U) 1 0)))))))
;; --- the presheaves --------------------------------------------------------------------------------------------------
(define (constant-ap C) (make-ap C (map (lambda (U) 1) (range (c-nobj C))) (lambda (V U) (q-identity 1))))
(define (nonsep-ap C top) (make-ap C (map (lambda (U) (if (= U top) 2 1)) (range (c-nobj C)))
                                   (lambda (V U) (cond ((= V U) (q-identity (if (= U top) 2 1))) ((= U top) (vector (vector 1 1))) (else (q-identity 1))))))
;; a local system on the pseudocircle site: the twist of program 6 (monodromy -1) placed on the inclusion {b} <= {a,b,d}
(define (twisted-ap C twist) (make-ap C (map (lambda (U) 1) (range (c-nobj C))) (lambda (V U) (vector (vector (twist V U))))))
(define top-S (position-of (list 0 1 2 3) (site-opens CS*)))
(define top-S2 (position-of (list 0 1 2 3 4 5) (site-opens CS2*)))
(define (S-twist V U) (if (and (equal? (list-ref (site-opens CS*) V) (list 1)) (equal? (list-ref (site-opens CS*) U) (list 0 1 3))) -1 1))
(define Q-S (constant-ap CS*)) (define Q-S2 (constant-ap CS2*)) (define N-S (nonsep-ap CS* top-S))
(define T-pts (point-local-system CS* S-twist))
(define T-S (with-region (extend-from-points CS* T-pts)))
(check "the four abelian presheaves are functors on their sites (identities and composites as rational matrices)"
       (and (ap-functor? CS* Q-S) (ap-functor? CS2* Q-S2) (ap-functor? CS* N-S) (ap-functor? CS* T-S)))
(define aQS (with-region (sheafify-q CS* Q-S)))
(define aQS2 (with-region (sheafify-q CS2* Q-S2)))
(define aNS (with-region (sheafify-q CS* N-S)))
(define aTS (with-region (sheafify-q CS* T-S)))
(define pQS (with-region (plus-q CS* Q-S)))
(define pNS (with-region (plus-q CS* N-S)))
(show "dims of a(Q) on the pseudocircle opens and pi_0; dims of a(Q) on the pseudo-2-sphere opens" (list (ap-dims aQS 6) (map (lambda (U) (components CS* U)) (range 6)) (ap-dims aQS2 9)))
(check "sheafification over Q: F^+ separated, F^{++} a sheaf, a(Q) has dimension pi_0(U) on every open of both sites, the non-separated presheaf loses its extra top dimension, and the monodromy -1 local system (extended from the points) is a sheaf with no global section: dims (1, 1, 0, 1, 1, 2), unchanged by sheafification"
       (and (separated-q? CS* pQS) (sheaf-q? CS* aQS) (sheaf-q? CS2* aQS2) (sheaf-q? CS* aNS) (sheaf-q? CS* T-S) (sheaf-q? CS* aTS)
            (equal? (ap-dims aQS 6) (map (lambda (U) (components CS* U)) (range 6))) (equal? (ap-dims aQS2 9) (map (lambda (U) (components CS2* U)) (range 9)))
            (= 1 (ap-dim aNS top-S)) (separated-q? CS* pNS) (= 0 (ap-dim T-S top-S)) (equal? (ap-dims aTS 6) (ap-dims T-S 6)) (equal? (ap-dims T-S 6) (list 1 1 0 1 1 2))))
(check "the Alexandrov equivalence, computed: for every presheaf F on both sites, F^{++} and the extension to opens of the restriction of F to the points (U -> lim_{x in U} F(U_x)) have the same dimension on every open, and the extension is a sheaf"
       (and (all? (lambda (F) (let ((aF (with-region (sheafify-q CS* F))) (eF (with-region (extend-from-points CS* F)))) (and (sheaf-q? CS* eF) (equal? (ap-dims aF 6) (ap-dims eF 6))))) (list Q-S N-S T-S))
            (let ((eQ2 (with-region (extend-from-points CS2* Q-S2)))) (and (sheaf-q? CS2* eQ2) (equal? (ap-dims aQS2 9) (ap-dims eQ2 9))))))

;; --- exactness of sheafification ----------------------------------------------------------------------------------------
;; a map of presheaves f: F -> G is a family of matrices f_U with G(res) f_U = f_V F(res); kernel presheaf and cokernel dims
(define (ap-map-natural? C F G f) (all? (lambda (a) (let ((V (a-src C a)) (U (a-tgt C a))) (q-equal? (q-mat-mul (ap-map G a) (vector-ref f U)) (q-mat-mul (vector-ref f V) (ap-map F a))))) (range (c-narr C))))
(define (kernel-ap C F G f)                      ;; kernel presheaf with restriction expressed in kernel bases
  (let* ((n (c-nobj C)) (bases (map (lambda (U) (q-nullspace (vector-ref f U) (ap-dim F U))) (range n))))
    (vector (list->vector (map (lambda (U) (length (list-ref bases U))) (range n)))
            (list->vector (map (lambda (a) (let* ((V (a-src C a)) (U (a-tgt C a)) (bU (list-ref bases U)) (bV (list-ref bases V)) (M (q-matrix (length bV) (length bU))))
                                             (let loop ((bs bU) (j 0)) (if (not (null? bs)) (let ((y (q-solve-in-basis bV (ap-dim F V) (q-mat-vec (ap-map F a) (car bs))))) (let ff ((i 0)) (if (< i (length bV)) (begin (q-set! M i j (vector-ref y i)) (ff (+ i 1))))) (loop (cdr bs) (+ j 1)))))
                                             M))
                               (range (c-narr C)))))))
(define (coker-dims C G f) (map (lambda (U) (- (ap-dim G U) (q-rank (vector-ref f U)))) (range (c-nobj C))))
;; the map f: a(F) -> a(G) induced by f (families map componentwise; expressed in bases)
(define (sheafified-map C F G f aF aG)
  (let* ((n (c-nobj C)) (mins (map (lambda (U) (minimal-cover C U)) (range n)))
         (bF (map (lambda (U) (matching-space C F (list-ref mins U))) (range n)))
         (bG (map (lambda (U) (matching-space C G (list-ref mins U))) (range n)))
         (apply-f (lambda (U fam) (let ((offs (offsets-of C F (list-ref mins U))) (offsG (offsets-of C G (list-ref mins U))))
                                    (q-vec-concat (map (lambda (Yi) (q-mat-vec (vector-ref f (list-ref (list-ref mins U) Yi)) (q-vec-slice fam (list-ref offs Yi) (ap-dim F (list-ref (list-ref mins U) Yi))))) (range (length (list-ref mins U)))))))))
    ;; one plus step suffices here for the map when F, G are separated; for the general case apply twice: we use plus-once
    ;; bases (F^+), which equal the sheafification bases whenever F^+ is already a sheaf (checked by dimensions)
    (list->vector (map (lambda (U) (let* ((M (q-matrix (length (list-ref bG U)) (length (list-ref bF U)))))
                                     (let loop ((bs (list-ref bF U)) (j 0)) (if (not (null? bs)) (let ((y (q-solve-in-basis (list-ref bG U) (total-dim C G (list-ref mins U)) (apply-f U (car bs))))) (let ff ((i 0)) (if (< i (length (list-ref bG U))) (begin (q-set! M i j (vector-ref y i)) (ff (+ i 1))))) (loop (cdr bs) (+ j 1)))))
                                     M))
                       (range n)))))
;; f: Q -> Q given by multiplication by 2 everywhere (an isomorphism over Q) and g: N -> Q the fold map at the top
(define f2 (list->vector (map (lambda (U) (vector (vector 2))) (range 6))))
(define g-fold (list->vector (map (lambda (U) (if (= U top-S) (vector (vector 1 1)) (vector (vector 1)))) (range 6))))
(define eps-unit (list->vector (map (lambda (U) (vector (vector 1))) (range 6))))   ;; Q -> aQ? dims differ at {a,b}: use the presheaf map Q -> Q^{pi_0} below
(define QS-to-aQS (list->vector (map (lambda (U) (let ((M (q-matrix (ap-dim aQS U) 1))) (let loop ((i 0)) (if (< i (ap-dim aQS U)) (begin (q-set! M i 0 1) (loop (+ i 1))))) M)) (range 6))))
(check "maps of presheaves: multiplication by 2 on Q, the fold map from the non-separated presheaf, and the unit Q -> a(Q) are natural"
       (and (ap-map-natural? CS* Q-S Q-S f2) (ap-map-natural? CS* N-S Q-S g-fold) (ap-map-natural? CS* Q-S aQS QS-to-aQS)))
(define kerN (kernel-ap CS* N-S Q-S g-fold))
(define akerN (with-region (sheafify-q CS* kerN)))
(define aN (with-region (plus-q CS* N-S)))
(define ag (with-region (sheafified-map CS* N-S Q-S g-fold aN pQS)))
(show "kernel of the fold map: dims of ker, a(ker); dims of ker(a g); coker dims of g and of a(g)" (list (ap-dims kerN 6) (ap-dims akerN 6) (map (lambda (U) (length (q-nullspace (vector-ref ag U) (ap-dim aN U)))) (range 6)) (coker-dims CS* Q-S g-fold) (map (lambda (U) (- (ap-dim pQS U) (q-rank (vector-ref ag U)))) (range 6))))
(check "a is exact: a(ker g) = ker(a g) dimensionwise on every open (the extra top dimension of the non-separated presheaf is killed by a), and the cokernel dimensions of g and of a(g) agree"
       (and (equal? (ap-dims akerN 6) (map (lambda (U) (length (q-nullspace (vector-ref ag U) (ap-dim aN U)))) (range 6)))
            (equal? (coker-dims CS* Q-S g-fold) (map (lambda (U) (- (ap-dim pQS U) (q-rank (vector-ref ag U)))) (range 6)))))
(check "i is not right exact: the unit Q -> a(Q) is a map of presheaves with cokernel of dimension 1 exactly at the disconnected open {a, b} and 0 elsewhere"
       (equal? (map (lambda (U) (- (ap-dim aQS U) (q-rank (vector-ref QS-to-aQS U)))) (range 6)) (map (lambda (U) (if (equal? (list-ref (site-opens CS*) U) (list 0 1)) 1 0)) (range 6))))

;; --- cohomology three ways ------------------------------------------------------------------------------------------------
;; (i) lim^n over the points: cosimplicial replacement with F(U_x) at the last point of each chain
(define (point-index C x) (position-of (sorted-ints (down-set-of (vector-ref C 5) (list x))) (site-opens C)))
(define (chains-of P k)                          ;; strictly decreasing chains of length k+1 in the poset category P, largest first
  (if (= k 0) (map (lambda (x) (list x)) (range (c-nobj P)))
      (let loop ((cs (chains-of P (- k 1))) (acc '()))
        (if (null? cs) (reverse acc)
            (loop (cdr cs) (append (reverse (map (lambda (y) (append (car cs) (list y))) (filter (lambda (y) (and (not (= y (car (reverse (car cs))))) (not (null? (hom P y (car (reverse (car cs)))))))) (range (c-nobj P))))) acc))))))
(define (drop-nth l i) (let loop ((l l) (k 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ k 1) (if (= k i) acc (cons (car l) acc))))))
(define (last-of l) (if (null? (cdr l)) (car l) (last-of (cdr l))))
(define (cosimplicial-differential C F k)        ;; C^k -> C^{k+1} over Q
  (let* ((P (vector-ref C 5)) (src (chains-of P k)) (tgt (chains-of P (+ k 1)))
         (dim-at (lambda (c) (ap-dim F (point-index C (last-of c)))))
         (soffs (let loop ((l src) (o 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ o (dim-at (car l))) (cons o acc)))))
         (ns (let loop ((l src) (o 0)) (if (null? l) o (loop (cdr l) (+ o (dim-at (car l)))))))
         (rows '()))
    (for-each (lambda (c)
                (let ((dc (dim-at c)))
                  (let lr ((r 0))
                    (if (< r dc)
                        (let ((row (make-vector ns 0)))
                          ;; faces 0..k drop x_i (i <= k): identity on F(U_{x_{k+1}}) with sign (-1)^i, when the face is a chain in src
                          (let loop ((i 0) (sign 1))
                            (if (<= i k)
                                (let ((j (position-of (drop-nth c i) src)))
                                  (if j (vector-set! row (+ (list-ref soffs j) r) (+ (vector-ref row (+ (list-ref soffs j) r)) sign)))
                                  (loop (+ i 1) (- 0 sign)))))
                          ;; last face drops x_{k+1}: restriction F(U_{x_k}) -> F(U_{x_{k+1}}), sign (-1)^{k+1}
                          (let* ((front (drop-nth c (+ k 1))) (j (position-of front src)) (M (ap-map F (open-arrow C (point-index C (last-of c)) (point-index C (last-of front))))) (sign (if (even? (+ k 1)) 1 -1)))
                            (let lc ((cc 0)) (if (< cc (ap-dim F (point-index C (last-of front)))) (begin (vector-set! row (+ (list-ref soffs j) cc) (+ (vector-ref row (+ (list-ref soffs j) cc)) (* sign (q-ref M r cc)))) (lc (+ cc 1))))))
                          (set! rows (cons row rows))
                          (lr (+ r 1)))))))
              tgt)
    (list->vector (reverse rows))))
(define (lim-n-dims C F nmax)
  (let* ((P (vector-ref C 5))
         (dims (map (lambda (k) (let loop ((l (chains-of P k)) (o 0)) (if (null? l) o (loop (cdr l) (+ o (ap-dim F (point-index C (last-of (car l))))))))) (range (+ nmax 2))))
         (ranks (map (lambda (k) (let ((D (cosimplicial-differential C F k))) (if (= 0 (q-rows D)) 0 (q-rank D)))) (range (+ nmax 1)))))
    (let loop ((k 0) (prev 0) (acc '())) (if (> k nmax) (reverse acc) (loop (+ k 1) (list-ref ranks k) (cons (- (list-ref dims k) prev (list-ref ranks k)) acc))))))
;; (ii) Cech cohomology of a cover {U_i} with sections over intersections computed as matching spaces over point opens
(define (intersection-open C V W) (position-of (sorted-ints (filter (lambda (p) (memv p (list-ref (site-opens C) W))) (list-ref (site-opens C) V))) (site-opens C)))
(define (subsets-k items k) (cond ((= k 0) (list '())) ((null? items) '()) (else (append (map (lambda (t) (cons (car items) t)) (subsets-k (cdr items) (- k 1))) (subsets-k (cdr items) k)))))
(define (multi-intersection C Us) (let loop ((l (cdr Us)) (acc (car Us))) (if (or (null? l) (not acc)) acc (loop (cdr l) (intersection-open C acc (car l))))))
(define (sections-basis C F U) (matching-space C F (point-opens C U)))   ;; Gamma(U, aF) as families over the point opens of U
(define (cech-differential C F cover k)
  (let* ((tuples-k (filter (lambda (t) (multi-intersection C (map (lambda (i) (list-ref cover i)) t))) (subsets-k (range (length cover)) (+ k 1))))
         (tuples-k1 (filter (lambda (t) (multi-intersection C (map (lambda (i) (list-ref cover i)) t))) (subsets-k (range (length cover)) (+ k 2))))
         (bases-k (map (lambda (t) (sections-basis C F (multi-intersection C (map (lambda (i) (list-ref cover i)) t)))) tuples-k))
         (bases-k1 (map (lambda (t) (sections-basis C F (multi-intersection C (map (lambda (i) (list-ref cover i)) t)))) tuples-k1))
         (soffs (let loop ((l bases-k) (o 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ o (length (car l))) (cons o acc)))))
         (ns (let loop ((l bases-k) (o 0)) (if (null? l) o (loop (cdr l) (+ o (length (car l)))))))
         (rows '()))
    ;; a section over U_t (family over point opens of U_t) restricts to U_{t'} for t' containing t: pick the point-open coordinates of U_{t'}
    (let lt ((ts tuples-k1) (bs1 bases-k1))
      (if (not (null? ts))
          (let* ((t1 (car ts)) (Ut1 (multi-intersection C (map (lambda (i) (list-ref cover i)) t1))) (b1 (car bs1)) (pts1 (point-opens C Ut1)))
            (let lr ((r 0))
              (if (< r (length b1))
                  (let ((row (make-vector ns 0)))
                    (let lf ((i 0) (sign 1))
                      (if (<= i (+ k 1))
                          (let* ((t (drop-nth t1 i)) (j (position-of t tuples-k)))
                            (if j
                                (let* ((Ut (multi-intersection C (map (lambda (ii) (list-ref cover ii)) t))) (bt (list-ref bases-k j)) (pts (point-opens C Ut)) (offs (offsets-of C F pts)))
                                  ;; coordinates of each basis vector of Gamma(U_t) restricted to U_{t1}, expressed in b1: the r-th coordinate
                                  (let lb ((bs bt) (jj 0))
                                    (if (not (null? bs))
                                        (let* ((restricted (q-vec-concat (map (lambda (Px) (q-vec-slice (car bs) (list-ref offs (position-of Px pts)) (ap-dim F Px))) pts1)))
                                               (y (q-solve-in-basis b1 (total-dim C F pts1) restricted)))
                                          (vector-set! row (+ (list-ref soffs j) jj) (+ (vector-ref row (+ (list-ref soffs j) jj)) (* sign (vector-ref y r))))
                                          (lb (cdr bs) (+ jj 1)))))))
                            (lf (+ i 1) (- 0 sign)))))
                    (set! rows (cons row rows))
                    (lr (+ r 1)))))
            (lt (cdr ts) (cdr bs1)))))
    (list->vector (reverse rows))))
(define (cech-dims C F cover nmax)
  (let* ((dims (map (lambda (k) (let loop ((ts (filter (lambda (t) (multi-intersection C (map (lambda (i) (list-ref cover i)) t))) (subsets-k (range (length cover)) (+ k 1)))) (o 0)) (if (null? ts) o (loop (cdr ts) (+ o (length (sections-basis C F (multi-intersection C (map (lambda (i) (list-ref cover i)) (car ts)))))))))) (range (+ nmax 2))))
         (ranks (map (lambda (k) (let ((D (cech-differential C F cover k))) (if (= 0 (q-rows D)) 0 (q-rank D)))) (range (+ nmax 1)))))
    (let loop ((k 0) (prev 0) (acc '())) (if (> k nmax) (reverse acc) (loop (+ k 1) (list-ref ranks k) (cons (- (list-ref dims k) prev (list-ref ranks k)) acc))))))
;; (iii) Cech cohomology of the sheafified presheaf on the site, sections = aF(U) directly
(define (cech-dims-sheaf C aF cover nmax)       ;; Cech cohomology of a sheaf given directly on the site (sections aF(U))
  (let* ((secdim (lambda (U) (ap-dim aF U)))
         (tuples-at (lambda (k) (filter (lambda (t) (multi-intersection C (map (lambda (i) (list-ref cover i)) t))) (subsets-k (range (length cover)) (+ k 1)))))
         (open-of (lambda (t) (multi-intersection C (map (lambda (i) (list-ref cover i)) t))))
         (dims (map (lambda (k) (let loop ((ts (tuples-at k)) (o 0)) (if (null? ts) o (loop (cdr ts) (+ o (secdim (open-of (car ts)))))))) (range (+ nmax 2))))
         (cech-diff-k (lambda (k)
                        (let* ((tk (tuples-at k)) (tk1 (tuples-at (+ k 1)))
                               (soffs (let loop ((l tk) (o 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ o (secdim (open-of (car l)))) (cons o acc)))))
                               (ns (list-ref dims k)))
                          (let lt ((ts tk1) (rows '()))
                            (if (null? ts) (list->vector (reverse rows))
                                (let* ((t1 (car ts)) (Ut1 (open-of t1)))
                                  (let lr ((r 0) (rows2 rows))
                                    (if (= r (secdim Ut1)) (lt (cdr ts) rows2)
                                        (let ((row (make-vector ns 0)))
                                          (let lf ((i 0) (sign 1))
                                            (if (<= i (+ k 1))
                                                (let* ((t (drop-nth t1 i)) (j (position-of t tk)))
                                                  (if j (let* ((Ut (open-of t)) (M (ap-map aF (open-arrow C Ut1 Ut))))
                                                          (let lc ((cc 0)) (if (< cc (secdim Ut)) (begin (vector-set! row (+ (list-ref soffs j) cc) (+ (vector-ref row (+ (list-ref soffs j) cc)) (* sign (q-ref M r cc)))) (lc (+ cc 1)))))))
                                                  (lf (+ i 1) (- 0 sign)))))
                                          (lr (+ r 1) (cons row rows2)))))))))))
         (ranks (map (lambda (k) (let ((D (cech-diff-k k))) (if (= 0 (q-rows D)) 0 (q-rank D)))) (range (+ nmax 1)))))
    (let loop ((k 0) (prev 0) (acc '())) (if (> k nmax) (reverse acc) (loop (+ k 1) (list-ref ranks k) (cons (- (list-ref dims k) prev (list-ref ranks k)) acc))))))
(define cover-S (map (lambda (U) U) (maximal-proper-opens CS* top-S)))
(define cover-S2 (map (lambda (U) U) (maximal-proper-opens CS2* top-S2)))
(define h1 (with-region (list (lim-n-dims CS* Q-S 2) (cech-dims CS* Q-S cover-S 2) (cech-dims-sheaf CS* aQS cover-S 2))))
(define h2 (with-region (list (lim-n-dims CS2* Q-S2 3) (cech-dims CS2* Q-S2 cover-S2 3) (cech-dims-sheaf CS2* aQS2 cover-S2 3))))
(define h3 (with-region (list (lim-n-dims CS* T-S 2) (cech-dims CS* T-S cover-S 2) (cech-dims-sheaf CS* aTS cover-S 2))))
(show "H^*(pseudocircle; Q) three ways (lim^n over points, Cech of the point-route sections, Cech of a(Q) on the site)" h1)
(show "H^*(pseudo-2-sphere; Q) three ways" h2)
(show "H^*(pseudocircle; twisted Q) three ways" h3)
(check "pseudocircle: the cover by U_c and U_d is Leray and the three routes agree, (1, 1, 0) for Q and (0, 0, 0) for the monodromy -1 local system over Q"
       (and (equal? h1 (list (list 1 1 0) (list 1 1 0) (list 1 1 0))) (equal? h3 (list (list 0 0 0) (list 0 0 0) (list 0 0 0)))))
(check "pseudo-2-sphere: the derived limit gives (1, 0, 1, 0), while the only cover by maximal opens has the pseudocircle as its intersection (not acyclic), so both Cech routes give (1, 0, 0, 0) and miss H^2: the Leray condition fails, as in the finite-spaces and descent examples"
       (and (equal? (car h2) (list 1 0 1 0)) (equal? (cadr h2) (list 1 0 0 0)) (equal? (caddr h2) (list 1 0 0 0))))

(display "Abelian sheaves on a finite site over Q: the Alexandrov equivalence, exactness of sheafification, and cohomology three ways") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
