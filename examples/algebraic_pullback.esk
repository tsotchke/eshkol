;;; Exact derivatives through an equation-defined algebraic solve.
(require stdlib)
(require core.ad.algebraic_pullback)
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define a (algebraic-generator field))
(define (reciprocal-solve tape xs)
  (let* ((theta (vector-ref xs 0))
         (one (algebraic-reverse-constant tape 1))
         (solution (algebraic-reverse-solve tape (vector (vector theta)) (vector one))))
    (vector-ref solution 0)))
(define value-and-pullback (algebraic-value-and-pullback field reciprocal-solve (vector a)))
(define gradient ((vector-ref value-and-pullback 1) 1))
(define hvp (algebraic-hvp field reciprocal-solve (vector a) (vector 1)))
(define field-same? (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define expected-gradient -1/2)
(define expected-hvp (algebraic-scale a 1/2))
(if (not (and (field-same? (vector-ref value-and-pullback 0) (algebraic-scale a 1/2))
              (field-same? (vector-ref gradient 0) expected-gradient)
              (field-same? (vector-ref (vector-ref hvp 0) 0) expected-hvp)))
    (error "Exact algebraic solve pullback mismatch"))
(display "value ") (write (vector-ref value-and-pullback 0)) (newline)
(display "gradient ") (write gradient) (newline)
(display "HVP ") (write hvp) (newline)
(display "Passed: 3 Failed: 0") (newline)
(display "RESULT: PASS") (newline)
