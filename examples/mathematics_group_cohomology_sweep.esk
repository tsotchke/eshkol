;; Sweep program: integral homology of a finite group's classifying space,
;; one JSON receipt per run, parametrized by environment variables so it can
;; be driven by a campaign runner on any node with an Eshkol build.
;;
;;   MATH_GROUP   one of  cyclic:N | product:N,M[,K] | dihedral:N (order 2N) |
;;                quaternion | symmetric:3 | alternating:4
;;   MATH_DEGREE  highest homology degree to compute (default 3)
;;
;; Output: exactly one line, a JSON object with the group spec, its order,
;; H_0..H_degree as (betti, torsion list) pairs, |H_3| when computed (the
;; number of Dijkgraaf-Witten twists), and a self-check verdict. Exit status
;; is nonzero if the self-checks fail. Uses the normalized bar complex and
;; Smith normal form over bignum integers, exactly as
;; mathematics_group_cohomology_order_eight.esk, which is the reference the
;; receipts are compared against.
;;
;; Cost: the degree-k boundary matrix has (|G|-1)^(k-1) rows and (|G|-1)^k
;; columns; degree 3 is practical to order 9, degree 2 to order 16, on a
;; laptop, with the dense elimination below.

(require stdlib)

(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (product xs) (if (null? xs) 1 (* (car xs) (product (cdr xs)))))

;; --- groups ------------------------------------------------------------------
(define (make-group n mul)
  (let ((table (make-vector n 0)) (inv (make-vector n 0)))
    (let loop ((a 0))
      (if (< a n)
          (let ((row (make-vector n 0)))
            (let inner ((b 0))
              (if (< b n)
                  (begin (vector-set! row b (mul a b)) (if (= 0 (mul a b)) (vector-set! inv a b)) (inner (+ b 1)))))
            (vector-set! table a row)
            (loop (+ a 1)))))
    (vector n table inv)))
(define (g-order G) (vector-ref G 0))
(define (g-mul G a b) (vector-ref (vector-ref (vector-ref G 1) a) b))
(define (g-inv G a) (vector-ref (vector-ref G 2) a))
(define (make-cyclic n) (make-group n (lambda (a b) (modulo (+ a b) n))))
(define (group-product G H)
  (let ((m (g-order H)))
    (make-group (* (g-order G) m)
                (lambda (x y) (+ (* m (g-mul G (quotient x m) (quotient y m))) (g-mul H (remainder x m) (remainder y m)))))))
(define (make-dihedral n)                        ;; r^i s^j encoded 2 i + j, order 2n
  (make-group (* 2 n)
              (lambda (x y)
                (let ((i (quotient x 2)) (j (remainder x 2)) (k (quotient y 2)) (l (remainder y 2)))
                  (+ (* 2 (modulo (+ i (if (= j 0) k (- 0 k))) n)) (modulo (+ j l) 2))))))
(define q8-unit-table
  (vector (vector (cons 0 0) (cons 1 0) (cons 2 0) (cons 3 0))
          (vector (cons 1 0) (cons 0 1) (cons 3 0) (cons 2 1))
          (vector (cons 2 0) (cons 3 1) (cons 0 1) (cons 1 0))
          (vector (cons 3 0) (cons 2 0) (cons 1 1) (cons 0 1))))
(define (make-quaternion)
  (make-group 8 (lambda (x y)
                  (let ((p (vector-ref (vector-ref q8-unit-table (quotient x 2)) (quotient y 2))))
                    (+ (* 2 (car p)) (modulo (+ (remainder x 2) (remainder y 2) (cdr p)) 2))))))
;; permutation groups on {0..k-1}: elements listed with the identity first
(define (perm-compose p q) (map (lambda (i) (list-ref p (list-ref q i))) (range (length p))))
(define (perm-sign p)
  (let loop ((i 0) (inv 0))
    (if (= i (length p)) (if (even? inv) 1 -1)
        (loop (+ i 1) (+ inv (let inner ((j (+ i 1)) (c 0)) (if (= j (length p)) c (inner (+ j 1) (if (> (list-ref p i) (list-ref p j)) (+ c 1) c)))))))))
(define (permutations xs)
  (if (null? xs) (list '())
      (let loop ((ys xs) (acc '()))
        (if (null? ys) acc
            (loop (cdr ys)
                  (append acc (map (lambda (rest) (cons (car ys) rest)) (permutations (filter (lambda (z) (not (= z (car ys)))) xs)))))))))
(define (make-perm-group perms)
  (let ((v (list->vector perms)))
    (define (index-of p) (let loop ((i 0)) (if (equal? (vector-ref v i) p) i (loop (+ i 1)))))
    (make-group (vector-length v) (lambda (a b) (index-of (perm-compose (vector-ref v a) (vector-ref v b)))))))
(define (make-symmetric k) (make-perm-group (permutations (range k))))
(define (make-alternating k) (make-perm-group (filter (lambda (p) (= 1 (perm-sign p))) (permutations (range k)))))

(define (split-string s ch)
  (let loop ((i 0) (start 0) (acc '()))
    (cond ((= i (string-length s)) (reverse (cons (substring s start i) acc)))
          ((char=? (string-ref s i) ch) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
          (else (loop (+ i 1) start acc)))))
(define (parse-group spec)
  (let* ((parts (split-string spec #\:)) (kind (car parts)) (arg (if (null? (cdr parts)) "" (cadr parts))))
    (cond ((string=? kind "cyclic") (make-cyclic (string->number arg)))
          ((string=? kind "product")
           (let ((ns (map string->number (split-string arg #\,))))
             (let loop ((G (make-cyclic (car ns))) (rest (cdr ns)))
               (if (null? rest) G (loop (group-product G (make-cyclic (car rest))) (cdr rest))))))
          ((string=? kind "dihedral") (make-dihedral (string->number arg)))
          ((string=? kind "quaternion") (make-quaternion))
          ((string=? kind "symmetric") (make-symmetric (string->number arg)))
          ((string=? kind "alternating") (make-alternating (string->number arg)))
          (else #f))))
(define (group-axioms? G)
  (let ((n (g-order G)))
    (all? (lambda (a) (and (= a (g-mul G 0 a)) (= 0 (g-mul G a (g-inv G a)))
                           (all? (lambda (b) (all? (lambda (c) (= (g-mul G (g-mul G a b) c) (g-mul G a (g-mul G b c)))) (range n))) (range n))))
          (range n))))

;; --- normalized bar complex and Smith normal form ---------------------------------
(define (nerve-face G t i)
  (let ((k (length t)))
    (cond ((= i 0) (cdr t))
          ((= i k) (reverse (cdr (reverse t))))
          (else (let loop ((ts t) (j 1) (acc '()))
                  (if (= j i) (append (reverse acc) (cons (g-mul G (car ts) (cadr ts)) (cddr ts)))
                      (loop (cdr ts) (+ j 1) (cons (car ts) acc))))))))
(define (nz-count G k) (ipow (- (g-order G) 1) k))
(define (nz-index->tuple G idx k)
  (let ((m (- (g-order G) 1))) (let loop ((i 0) (x idx) (acc '())) (if (= i k) (reverse acc) (loop (+ i 1) (quotient x m) (cons (+ 1 (remainder x m)) acc))))))
(define (nz-tuple->index G t)
  (let ((m (- (g-order G) 1))) (let loop ((ts (reverse t)) (acc 0)) (if (null? ts) acc (loop (cdr ts) (+ (* acc m) (- (car ts) 1)))))))
(define (has-identity? t) (cond ((null? t) #f) ((= 0 (car t)) #t) (else (has-identity? (cdr t)))))
(define (make-matrix rows cols) (let ((M (make-vector rows 0))) (let loop ((i 0)) (if (< i rows) (begin (vector-set! M i (make-vector cols 0)) (loop (+ i 1))))) M))
(define (mat-rows A) (vector-length A))
(define (mat-cols A) (if (= 0 (vector-length A)) 0 (vector-length (vector-ref A 0))))
(define (mref A i j) (vector-ref (vector-ref A i) j))
(define (mset! A i j v) (vector-set! (vector-ref A i) j v))
(define (normalized-boundary G k)
  (let* ((rows (nz-count G (- k 1))) (cols (nz-count G k)) (M (make-matrix rows cols)))
    (let loop ((c 0))
      (if (< c cols)
          (let ((t (nz-index->tuple G c k)))
            (let faces ((i 0) (sign 1))
              (if (<= i k)
                  (let ((f (nerve-face G t i)))
                    (if (not (has-identity? f)) (let ((r (nz-tuple->index G f))) (mset! M r c (+ (mref M r c) sign))))
                    (faces (+ i 1) (- 0 sign)))))
            (loop (+ c 1)))))
    M))
(define (swap-rows! A i j) (let ((t (vector-ref A i))) (vector-set! A i (vector-ref A j)) (vector-set! A j t)))
(define (swap-cols! A i j) (let loop ((r 0)) (if (< r (mat-rows A)) (let ((t (mref A r i))) (mset! A r i (mref A r j)) (mset! A r j t) (loop (+ r 1))))))
(define (add-row! A dst src q)
  (let ((rd (vector-ref A dst)) (rs (vector-ref A src)))
    (let loop ((j 0)) (if (< j (vector-length rd)) (begin (if (not (= 0 (vector-ref rs j))) (vector-set! rd j (+ (vector-ref rd j) (* q (vector-ref rs j))))) (loop (+ j 1)))))))
(define (add-col! A dst src q)
  (let loop ((r 0)) (if (< r (mat-rows A)) (begin (if (not (= 0 (mref A r src))) (mset! A r dst (+ (mref A r dst) (* q (mref A r src))))) (loop (+ r 1))))))
(define (find-pivot A t)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let loop-i ((i t) (best #f) (bi 0) (bj 0))
      (if (= i m) (if best (list bi bj) #f)
          (let loop-j ((j t) (best best) (bi bi) (bj bj))
            (if (= j n) (loop-i (+ i 1) best bi bj)
                (let ((a (abs (mref A i j))))
                  (cond ((= a 1) (list i j))
                        ((and (not (= a 0)) (or (not best) (< a best))) (loop-j (+ j 1) a i j))
                        (else (loop-j (+ j 1) best bi bj))))))))))
(define (snf! A)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let outer ((t 0) (diag '()))
      (if (or (= t m) (= t n)) (reverse diag)
          (let ((p (find-pivot A t)))
            (if (not p) (reverse diag)
                (begin
                  (swap-rows! A t (car p)) (swap-cols! A t (cadr p))
                  (let inner ()
                    (let ((pivot (mref A t t)) (clean #t))
                      (let loop ((i (+ t 1))) (if (< i m) (let ((a (mref A i t))) (if (not (= a 0)) (let ((q (quotient a pivot))) (add-row! A i t (- 0 q)) (if (not (= 0 (mref A i t))) (set! clean #f)))) (loop (+ i 1)))))
                      (let loop ((j (+ t 1))) (if (< j n) (let ((a (mref A t j))) (if (not (= a 0)) (let ((q (quotient a pivot))) (add-col! A j t (- 0 q)) (if (not (= 0 (mref A t j))) (set! clean #f)))) (loop (+ j 1)))))
                      (if (not clean)
                          (let ((q (find-pivot A t))) (swap-rows! A t (car q)) (swap-cols! A t (cadr q)) (inner))
                          (let ((bad (let loop-i ((i (+ t 1))) (if (= i m) #f (let loop-j ((j (+ t 1))) (if (= j n) (loop-i (+ i 1)) (if (= 0 (remainder (mref A i j) pivot)) (loop-j (+ j 1)) (list i j))))))))
                            (if bad (begin (add-row! A t (car bad) 1) (inner)) #t)))))
                  (outer (+ t 1) (cons (abs (mref A t t)) diag)))))))))
(define (torsion-of diag) (filter (lambda (x) (> x 1)) diag))
(define (homology-table G kmax)
  (let loop ((k 0) (rank-k 0) (acc '()))
    (if (> k kmax) (reverse acc)
        (let* ((s (snf! (normalized-boundary G (+ k 1)))) (rank-next (length s)) (betti (- (nz-count G k) rank-k rank-next)))
          (loop (+ k 1) rank-next (cons (list k betti (torsion-of s)) acc))))))

;; --- receipt -------------------------------------------------------------------
(define (json-int-list xs) (string-append "[" (let loop ((l xs) (acc "")) (if (null? l) acc (loop (cdr l) (string-append acc (if (string=? acc "") "" ",") (number->string (car l)))))) "]"))
(define (json-homology table)
  (string-append "[" (let loop ((rows table) (acc ""))
                       (if (null? rows) acc
                           (loop (cdr rows)
                                 (string-append acc (if (string=? acc "") "" ",")
                                                "{\"degree\":" (number->string (car (car rows)))
                                                ",\"betti\":" (number->string (cadr (car rows)))
                                                ",\"torsion\":" (json-int-list (caddr (car rows))) "}"))))
                 "]"))

(define spec (let ((v (get-environment-variable "MATH_GROUP"))) (if v v "cyclic:2")))
(define degree (let ((v (get-environment-variable "MATH_DEGREE"))) (if v (string->number v) 3)))
(define G (parse-group spec))
(if (not G) (begin (display "{\"group\":\"") (display spec) (display "\",\"error\":\"unknown group spec\"}") (newline) (exit 2)))
(define axioms-ok (group-axioms? G))
(define table (homology-table G degree))
(define h0-ok (equal? (car table) (list 0 1 '())))
(define h1-order (product (caddr (list-ref table 1))))
(define twists (if (>= degree 3) (product (caddr (list-ref table 3))) -1))
(define ok (and axioms-ok h0-ok))
(display (string-append "{\"schema\":\"eshkol.math.group_homology.v1\",\"group\":\"" spec "\",\"order\":" (number->string (g-order G))
                        ",\"degree\":" (number->string degree) ",\"homology\":" (json-homology table)
                        ",\"h1_order\":" (number->string h1-order) ",\"dw_twists\":" (number->string twists)
                        ",\"axioms\":" (if axioms-ok "true" "false") ",\"h0_is_Z\":" (if h0-ok "true" "false")
                        ",\"verdict\":\"" (if ok "PASS" "FAIL") "\"}"))
(newline)
(exit (if ok 0 1))
