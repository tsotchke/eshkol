;; Yetter's 2-group invariants on the 64-point finite model of the 3-torus:
;; the same numbers as the one-vertex triangulation, from a complex sixty
;; times larger, and the measurements that come with it.
;;
;; Sources: as in the sibling example on Yetter's invariants (Yetter 1993,
;; Porter 1998, Faria Martins-Porter 2007), and M. C. McCord, Duke Math. J.
;; 33 (1966) with J. A. Barmak, LNM 2032 (2011) for the finite model: the
;; product of three pseudocircles is a 64-point space whose order complex
;; (64 vertices, 448 edges, 768 triangles, 384 tetrahedra) is a
;; triangulation of T^3.
;;
;; The one-vertex Kuhn triangulation has 6 tetrahedra; here the same
;; invariants are recomputed on 384. Yetter's sum over all edge labellings
;; is out of reach (|N|^385 gauge-fixed labellings), so the 1-gauge
;; reduction of the sibling lens-space example is essential: the sum runs
;; over Hom(pi_1 T^3, pi_1 G) (8 or 27 homomorphisms), each needing one
;; consistency test against the Smith normal form of the twisted
;; coboundary delta^2 (384 x 768), and the fibration formula needs the
;; orders of H^0, H^1, H^2 with coefficients Z/|pi_2|, from the Smith forms
;; of delta^0 (448 x 64), delta^1 (768 x 448) and delta^2. The normalization
;; |pi_2|^(V - E) / |pi_1| = |pi_2|^-384 / |pi_1| is an exact rational with
;; a 384-bit denominator that must cancel exactly against the solution
;; counts.
;;
;;   1. The order complex is a closed 3-manifold model: Euler characteristic
;;      0, H^* = (Z, Z^3, Z^3, Z), mod 2 orders (2, 8, 8, 2), mod 3 orders
;;      (3, 27, 27, 3).
;;   2. Flat labellings: |Hom(Z^3, Z/2)| = 8 and |Hom(Z^3, Z/3)| = 27
;;      gauge-fixed labellings found by closing triangles in rounds.
;;   3. Yetter invariants for nine crossed modules equal the one-vertex
;;      values: 2, 4, 8, 8, 8, 5 for K(Z/2,2), BZ/2, Z/2 -> Z/2, Z/4 -> Z/4
;;      (trivial and sign) and Z/3 -> Z/2 with the sign action, and 27, 27,
;;      27 for Z/3 -> Z/3 and the two Z/9 -> Z/9 modules; no homomorphism
;;      is obstructed on T^3 (cubes of degree-one classes vanish mod 2,
;;      Bocksteins vanish on a torsion-free space); the fibration formula
;;      agrees in every case.
;;
;; DEFECT NOTES (routed around): as in the sibling examples. This program
;; is also a measurement: its wall time and peak memory are reported to
;; the compiler stream.

(require stdlib)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))
(define (product xs) (if (null? xs) 1 (* (car xs) (product (cdr xs)))))
(define (last-of l) (if (null? (cdr l)) (car l) (last-of (cdr l))))
(define (but-last l) (reverse (cdr (reverse l))))
(define (remove-nth l i) (let loop ((l l) (k 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ k 1) (if (= k i) acc (cons (car l) acc))))))
(define (make-matrix rows cols) (let ((M (make-vector rows 0))) (let loop ((i 0)) (if (< i rows) (begin (vector-set! M i (make-vector cols 0)) (loop (+ i 1))))) M))
(define (mat-rows A) (vector-length A))
(define (mat-cols A) (if (= 0 (vector-length A)) 0 (vector-length (vector-ref A 0))))
(define (mref A i j) (vector-ref (vector-ref A i) j))
(define (mset! A i j v) (vector-set! (vector-ref A i) j v))
(define (mat-copy A) (let ((B (make-vector (mat-rows A) 0))) (let loop ((i 0)) (if (< i (mat-rows A)) (begin (vector-set! B i (vector-copy (vector-ref A i))) (loop (+ i 1))))) B))
(define (identity-matrix m) (let ((I (make-matrix m m))) (let loop ((i 0)) (if (< i m) (begin (mset! I i i 1) (loop (+ i 1))))) I))
(define (swap-rows! A i j) (let ((t (vector-ref A i))) (vector-set! A i (vector-ref A j)) (vector-set! A j t)))
(define (swap-cols! A i j) (let loop ((r 0)) (if (< r (mat-rows A)) (let ((t (mref A r i))) (mset! A r i (mref A r j)) (mset! A r j t) (loop (+ r 1))))))
(define (add-row! A dst src q) (let ((rd (vector-ref A dst)) (rs (vector-ref A src))) (let loop ((j 0)) (if (< j (vector-length rd)) (begin (if (not (= 0 (vector-ref rs j))) (vector-set! rd j (+ (vector-ref rd j) (* q (vector-ref rs j))))) (loop (+ j 1)))))))
(define (add-col! A dst src q) (let loop ((r 0)) (if (< r (mat-rows A)) (begin (if (not (= 0 (mref A r src))) (mset! A r dst (+ (mref A r dst) (* q (mref A r src))))) (loop (+ r 1))))))
(define (negate-row! A i) (let ((r (vector-ref A i))) (let loop ((j 0)) (if (< j (vector-length r)) (begin (vector-set! r j (- 0 (vector-ref r j))) (loop (+ j 1)))))))
(define (find-pivot A t)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let loop-i ((i t) (best #f) (bi 0) (bj 0))
      (if (= i m) (if best (list bi bj) #f)
          (let loop-j ((j t) (best best) (bi bi) (bj bj))
            (if (= j n) (loop-i (+ i 1) best bi bj)
                (let ((a (abs (mref A i j))))
                  (cond ((= a 1) (list i j))
                        ((and (not (= a 0)) (or (not best) (< a best))) (loop-j (+ j 1) a i j))
                        (else (loop-j (+ j 1) best bi bj))))))))))
;; U A V = D; U and V accumulate the row and column operations. Returns the diagonal.
(define (snf! A U V)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let outer ((t 0) (diag '()))
      (if (or (= t m) (= t n)) (reverse diag)
          (let ((p (find-pivot A t)))
            (if (not p) (reverse diag)
                (begin
                  (swap-rows! A t (car p)) (swap-rows! U t (car p)) (swap-cols! A t (cadr p)) (swap-cols! V t (cadr p))
                  (let inner ()
                    (let ((pivot (mref A t t)) (clean #t))
                      (let loop ((i (+ t 1))) (if (< i m) (let ((a (mref A i t))) (if (not (= a 0)) (let ((q (quotient a pivot))) (add-row! A i t (- 0 q)) (add-row! U i t (- 0 q)) (if (not (= 0 (mref A i t))) (set! clean #f)))) (loop (+ i 1)))))
                      (let loop ((j (+ t 1))) (if (< j n) (let ((a (mref A t j))) (if (not (= a 0)) (let ((q (quotient a pivot))) (add-col! A j t (- 0 q)) (add-col! V j t (- 0 q)) (if (not (= 0 (mref A t j))) (set! clean #f)))) (loop (+ j 1)))))
                      (if (not clean)
                          (let ((q (find-pivot A t))) (swap-rows! A t (car q)) (swap-rows! U t (car q)) (swap-cols! A t (cadr q)) (swap-cols! V t (cadr q)) (inner))
                          (let ((bad (let loop-i ((i (+ t 1))) (if (= i m) #f (let loop-j ((j (+ t 1))) (if (= j n) (loop-i (+ i 1)) (if (= 0 (remainder (mref A i j) pivot)) (loop-j (+ j 1)) (list i j))))))))
                            (if bad (begin (add-row! A t (car bad) 1) (add-row! U t (car bad) 1) (inner)) #t)))))
                  (if (< (mref A t t) 0) (begin (negate-row! A t) (negate-row! U t)))
                  (outer (+ t 1) (cons (mref A t t) diag)))))))))
(define (snf-full A)                             ;; -> (list diag U V) leaving A intact
  (let* ((B (mat-copy A)) (U (identity-matrix (mat-rows A))) (V (identity-matrix (mat-cols A))) (d (snf! B U V))) (list d U V)))
(define (torsion-of d) (filter (lambda (x) (> x 1)) d))
(define (mat-vec M z) (let ((w (make-vector (mat-rows M) 0))) (let loop ((i 0)) (if (< i (mat-rows M)) (let ((r (vector-ref M i))) (vector-set! w i (let inner ((j 0) (s 0)) (if (= j (vector-length r)) s (inner (+ j 1) (+ s (* (vector-ref r j) (vector-ref z j))))))) (loop (+ i 1))))) w))
(define (mat-col M j) (let ((v (make-vector (mat-rows M) 0))) (let loop ((i 0)) (if (< i (mat-rows M)) (begin (vector-set! v i (mref M i j)) (loop (+ i 1))))) v))
;; integer kernel basis of A: the last (cols - rank) columns of V
(define (integer-kernel A)
  (let* ((s (snf-full A)) (r (length (car s))) (V (caddr s)) (n (mat-cols A)))
    (let loop ((j (- n 1)) (acc '())) (if (< j r) acc (loop (- j 1) (cons (mat-col V j) acc))))))
;; solve B y = v for integer y given B's columns are a basis (B has full column rank): y = V D^-1 U v
(define (solve-in-basis snf ncols v)
  (let* ((d (car snf)) (U (cadr snf)) (V (caddr snf)) (w (mat-vec U v)) (y0 (make-vector ncols 0)))
    (let loop ((i 0) (ds d))
      (if (< i (length d))
          (begin (if (not (= 0 (remainder (vector-ref w i) (car ds)))) (error "not in the span")) (vector-set! y0 i (quotient (vector-ref w i) (car ds))) (loop (+ i 1) (cdr ds)))))
    (let loop ((i (length d))) (if (< i (vector-length w)) (begin (if (not (= 0 (vector-ref w i))) (error "not in the span")) (loop (+ i 1)))))
    (mat-vec V y0)))
(define (matrix-from-columns cols nrows) (let ((M (make-matrix nrows (length cols)))) (let loop ((cs cols) (j 0)) (if (not (null? cs)) (begin (let fill ((i 0)) (if (< i nrows) (begin (mset! M i j (vector-ref (car cs) i)) (fill (+ i 1))))) (loop (cdr cs) (+ j 1))))) M))
(define (cohomology-from-matrices dims Ds)
  (let loop ((k 0) (ds Ds) (dims dims) (rank-prev 0) (prev #f) (acc '()))
    (if (null? ds) (reverse acc)
        (let* ((D (car ds)) (dim-k (car dims))
               (rank-k (if (or (= 0 (mat-rows D)) (= 0 (mat-cols D))) 0 (length (car (snf-full D)))))
               (betti (- dim-k rank-prev rank-k))
               (tors (if (and prev (> (mat-rows prev) 0) (> (mat-cols prev) 0)) (torsion-of (car (snf-full prev))) '())))
          (loop (+ k 1) (cdr ds) (cdr dims) rank-k D (cons (list k betti tors) acc))))))
(define (any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (any? pred (cdr xs)))))
(define (sum xs) (let loop ((l xs) (s 0)) (if (null? l) s (loop (cdr l) (+ s (car l))))))
(define (rpow b n) (if (< n 0) (/ 1 (ipow b (- 0 n))) (ipow b n)))
(define (gcd2 a b) (if (= b 0) (abs a) (gcd2 b (remainder a b))))
(define (position-of item items) (let loop ((l items) (i 0)) (cond ((null? l) #f) ((equal? (car l) item) i) (else (loop (cdr l) (+ i 1))))))

(define (make-poset n covers)                    ;; covers: list of (x . y) meaning x < y (x covered by y); closure computed
  (let ((leq (make-vector n 0)))
    (let loop ((i 0)) (if (< i n) (begin (vector-set! leq i (make-vector n #f)) (vector-set! (vector-ref leq i) i #t) (loop (+ i 1)))))
    (for-each (lambda (c) (vector-set! (vector-ref leq (car c)) (cdr c) #t)) covers)
    ;; transitive closure
    (let outer ((k 0))
      (if (< k n)
          (begin
            (let li ((i 0))
              (if (< i n)
                  (begin
                    (let lj ((j 0))
                      (if (< j n)
                          (begin (if (and (vector-ref (vector-ref leq i) k) (vector-ref (vector-ref leq k) j)) (vector-set! (vector-ref leq i) j #t))
                                 (lj (+ j 1)))))
                    (li (+ i 1)))))
            (outer (+ k 1)))))
    (vector n leq)))
(define (p-size P) (vector-ref P 0))
(define (leq? P x y) (vector-ref (vector-ref (vector-ref P 1) x) y))
(define (lt? P x y) (and (leq? P x y) (not (= x y))))
(define (down-set P x) (filter (lambda (y) (leq? P y x)) (range (p-size P))))
(define (maximal-elements P) (filter (lambda (x) (all? (lambda (y) (not (lt? P x y))) (range (p-size P)))) (range (p-size P))))
;; product poset: (x, y) encoded x * |Q| + y, componentwise order
(define (poset-product P Q)
  (let* ((n (* (p-size P) (p-size Q))) (leq (make-vector n 0)) (m (p-size Q)))
    (let loop ((i 0))
      (if (< i n)
          (let ((row (make-vector n #f)))
            (let inner ((j 0))
              (if (< j n)
                  (begin (vector-set! row j (and (leq? P (quotient i m) (quotient j m)) (leq? Q (remainder i m) (remainder j m)))) (inner (+ j 1)))))
            (vector-set! leq i row) (loop (+ i 1)))))
    (vector n leq)))

;; chains x_0 > x_1 > ... > x_k (strictly decreasing) of length k+1, restricted to the elements in `allowed`
(define (chains P k allowed)
  (let extend ((k k) (partial '()))               ;; partial holds the chain so far, smallest element first
    (if (= k -1)
        (list partial)                            ;; partial is built largest-first: each new element exceeds the previous
        (let ((cands (filter (lambda (x) (and (memv x allowed) (or (null? partial) (lt? P (car partial) x)))) (range (p-size P)))))
          (let loop ((cs cands) (acc '()))
            (if (null? cs) acc
                (loop (cdr cs) (append (extend (- k 1) (cons (car cs) partial)) acc))))))))
;; chains are stored largest-first: (x_0 x_1 ... x_k) with x_0 > x_1 > ... > x_k
(define (chain-key P c) (let loop ((l c) (acc 0)) (if (null? l) acc (loop (cdr l) (+ (* acc (p-size P)) (car l))))))
(define (index-table P cs k)                     ;; vector keyed by chain-key -> index
  (let ((t (make-vector (ipow (p-size P) (+ k 1)) -1)))
    (let loop ((l cs) (i 0)) (if (not (null? l)) (begin (vector-set! t (chain-key P (car l)) i) (loop (cdr l) (+ i 1)))))
    t))

;; --- integer matrices, Smith normal form with both transforms -----------------------
;; --- Delta-complexes: (vector V edge-ends triangles tets) --------------------------------------
;; edge-ends: vector of (i . j); triangles: vector of (e_ij e_ik e_jk); a tetrahedron is
;; (vector v0 v1 v2 v3 e01 e02 e03 e12 e13 e23 f012 f013 f023 f123), triangles identified by their
;; ordered edge triples (checked below through the Euler characteristic).
(define (build-complex V ends raw-tets)          ;; raw tet: (list v0 v1 v2 v3 e01 e02 e03 e12 e13 e23)
  (let* ((faces-of (lambda (t) (let ((e (lambda (k) (list-ref t (+ 4 k)))))
                                 (list (list (e 0) (e 1) (e 3)) (list (e 0) (e 2) (e 4)) (list (e 1) (e 2) (e 5)) (list (e 3) (e 4) (e 5))))))
         (tris (let loop ((ts raw-tets) (acc '()))
                 (if (null? ts) (reverse acc)
                     (loop (cdr ts) (let add ((fs (faces-of (car ts))) (acc acc)) (if (null? fs) acc (add (cdr fs) (if (member (car fs) acc) acc (cons (car fs) acc))))))))))
    (vector V ends (list->vector tris)
            (map (lambda (t) (list->vector (append t (map (lambda (f) (position-of f tris)) (faces-of t))))) raw-tets))))
(define (c-V X) (vector-ref X 0))
(define (c-E X) (vector-length (vector-ref X 1)))
(define (c-F X) (vector-length (vector-ref X 2)))
(define (c-T X) (length (vector-ref X 3)))
(define (c-ends X e) (vector-ref (vector-ref X 1) e))
(define (c-tri X f) (vector-ref (vector-ref X 2) f))
(define (c-tets X) (vector-ref X 3))
(define (tet-v t k) (vector-ref t k))
(define (tet-e t k) (vector-ref t (+ 4 k)))     ;; 0..5: e01 e02 e03 e12 e13 e23
(define (tet-f t k) (vector-ref t (+ 10 k)))    ;; 0..3: f012 f013 f023 f123
(define (euler-char X) (- (+ (c-V X) (c-F X)) (+ (c-E X) (c-T X))))

;; --- cochains with coefficients in Z/kappa twisted by an edge labelling ------------------------------
;; (delta u)(sigma) = mult(first edge) . u(d_0 sigma) + sum_{i >= 1} (-1)^i u(d_i sigma); mult is an integer
;; multiplier per edge (1 everywhere for trivial coefficients). Matrices are over Z; counting is done mod kappa.
(define (delta0 X mult) (let ((M (make-matrix (c-E X) (c-V X))))
                          (let loop ((e 0)) (if (< e (c-E X)) (let ((ij (c-ends X e))) (mset! M e (cdr ij) (+ (mref M e (cdr ij)) (mult e))) (mset! M e (car ij) (- (mref M e (car ij)) 1)) (loop (+ e 1)))))
                          M))
(define (delta1 X mult) (let ((M (make-matrix (c-F X) (c-E X))))
                          (let loop ((f 0)) (if (< f (c-F X)) (let ((tr (c-tri X f)))   ;; (e_ij e_ik e_jk): mult(e_ij) u(e_jk) - u(e_ik) + u(e_ij)
                                                                (mset! M f (caddr tr) (+ (mref M f (caddr tr)) (mult (car tr))))
                                                                (mset! M f (cadr tr) (- (mref M f (cadr tr)) 1))
                                                                (mset! M f (car tr) (+ (mref M f (car tr)) 1))
                                                                (loop (+ f 1)))))
                          M))
(define (delta2 X mult) (let ((M (make-matrix (c-T X) (c-F X))))
                          (let loop ((ts (c-tets X)) (r 0))
                            (if (not (null? ts))
                                (let ((t (car ts)))                       ;; mult(e01) u(f123) - u(f023) + u(f013) - u(f012)
                                  (mset! M r (tet-f t 3) (+ (mref M r (tet-f t 3)) (mult (tet-e t 0))))
                                  (mset! M r (tet-f t 2) (- (mref M r (tet-f t 2)) 1))
                                  (mset! M r (tet-f t 1) (+ (mref M r (tet-f t 1)) 1))
                                  (mset! M r (tet-f t 0) (- (mref M r (tet-f t 0)) 1))
                                  (loop (cdr ts) (+ r 1)))))
                          M))
(define (trivial-mult e) 1)
(define (empty-matrix cols) (make-matrix 0 cols))
;; number of u in (Z/kappa)^n with A u = beta (mod kappa), through U A V = D
(define (count-solutions-from-snf s A n beta kappa)   ;; # of u in (Z/kappa)^n with A u = beta (mod kappa), s = (snf-full A)
  (if (= 0 (mat-rows A)) (ipow kappa n)
      (let* ((d (car s)) (U (cadr s)) (r (length d)) (w (mat-vec U beta)))
        (let loop ((i 0) (ds d) (cnt (ipow kappa (- n r))))
          (cond ((= i (mat-rows A)) cnt)
                ((< i r) (let ((g (gcd2 (car ds) kappa))) (if (= 0 (modulo (vector-ref w i) g)) (loop (+ i 1) (cdr ds) (* cnt g)) 0)))
                (else (if (= 0 (modulo (vector-ref w i) kappa)) (loop (+ i 1) ds cnt) 0)))))))
(define (count-solutions-mod A n beta kappa) (count-solutions-from-snf (if (= 0 (mat-rows A)) #f (snf-full A)) A n beta kappa))
;; Smith forms are memoized by (degree, multiplier pattern): the same twisted coboundary is needed by the state sum,
;; the obstruction test and the cohomology orders, for every rho with the same character
(define snf-memo (vector '()))
(define (mult-pattern X mult) (list->vector (map mult (range (c-E X)))))
(define snf-count 0)
(define (cached-snf X which mult)
  (let ((key (mult-pattern X mult)))
    (let ((hit (let find ((l (vector-ref snf-memo 0))) (cond ((null? l) #f) ((and (= which (car (car l))) (vec-equal? key (cadr (car l)))) (car l)) (else (find (cdr l)))))))
      (if hit (caddr hit)
          (let* ((A (case which ((0) (delta0 X mult)) ((1) (delta1 X mult)) (else (delta2 X mult))))
                 (s (list A (snf-full A))))
            (set! snf-count (+ snf-count 1))
            (vector-set! snf-memo 0 (cons (list which key s) (vector-ref snf-memo 0)))
            s)))))
(define (vec-equal? a b) (let loop ((i 0)) (cond ((= i (vector-length a)) #t) ((= (vector-ref a i) (vector-ref b i)) (loop (+ i 1))) (else #f))))
(define (count-solutions-cached X which mult beta kappa)
  (let* ((As (cached-snf X which mult)) (A (car As)) (n (mat-cols A)))
    (count-solutions-from-snf (cadr As) A n beta kappa)))
(define (zero-vec n) (make-vector n 0))
;; orders of H^0..H^3(X; Z/kappa twisted): #ker delta^i / #im delta^(i-1)
(define (cohomology-orders X mult kappa)
  (let* ((dims (list (c-V X) (c-E X) (c-F X) (c-T X)))
         (kers (append (map (lambda (which rows) (count-solutions-cached X which mult (zero-vec rows) kappa)) (list 0 1 2) (list (c-E X) (c-F X) (c-T X)))
                       (list (ipow kappa (c-T X))))))
    (let loop ((i 0) (ks kers) (ds dims) (im-prev 1) (acc '()))
      (if (null? ks) (reverse acc)
          (loop (+ i 1) (cdr ks) (cdr ds) (/ (ipow kappa (car ds)) (car ks)) (cons (/ (car ks) im-prev) acc))))))
;; |H^2| |H^0| / |H^1| = |H^3| kappa^chi, and chi = 0 here: |H^3| = kappa^T / #im delta^2 needs only the Smith form of delta^2
(define (top-cohomology-order X mult kappa)
  (let ((ker2 (count-solutions-cached X 2 mult (zero-vec (c-T X)) kappa)))
    (/ (ipow kappa (c-T X)) (/ (ipow kappa (c-F X)) ker2))))
(define (integral-cohomology X)                  ;; from the memoized Smith forms of the untwisted coboundaries
  (let* ((ss (map (lambda (w) (cadr (cached-snf X w trivial-mult))) (list 0 1 2)))
         (ranks (map (lambda (s) (length (car s))) ss))
         (dims (list (c-V X) (c-E X) (c-F X) (c-T X))))
    (let loop ((k 0) (rs (append ranks (list 0))) (dims dims) (rank-prev 0) (prev #f) (acc '()))
      (if (null? rs) (reverse acc)
          (loop (+ k 1) (cdr rs) (cdr dims) (car rs) (if (< k 3) (list-ref ss k) #f)
                (cons (list k (- (car dims) rank-prev (car rs)) (if prev (torsion-of (car prev)) '())) acc))))))
;; --- crossed modules (M = Z/a -> N = Z/b, m -> c m, action) --------------------------------------------
(define (make-xmod a b c act) (list a b c act))
(define (xm-a X) (list-ref X 0)) (define (xm-b X) (list-ref X 1)) (define (xm-c X) (list-ref X 2))
(define (act X n m) ((list-ref X 3) n m))
(define (d-map X m) (modulo (* (xm-c X) m) (xm-b X)))
(define (n-add X x y) (modulo (+ x y) (xm-b X)))
(define (n-sub X x y) (modulo (- x y) (xm-b X)))
(define (m-add X x y) (modulo (+ x y) (xm-a X)))
(define (m-sub X x y) (modulo (- x y) (xm-a X)))
(define (trivial-action n m) m)
(define (crossed-module? X)
  (and (= 0 (d-map X (xm-a X)))
       (all? (lambda (n) (all? (lambda (m) (= (d-map X (act X n m)) (d-map X m))) (range (xm-a X)))) (range (xm-b X)))
       (all? (lambda (n) (all? (lambda (m) (all? (lambda (m2) (= (act X n (m-add X m m2)) (m-add X (act X n m) (act X n m2)))) (range (xm-a X)))) (range (xm-a X)))) (range (xm-b X)))
       (all? (lambda (m) (all? (lambda (m2) (= (act X (d-map X m) m2) m2)) (range (xm-a X)))) (range (xm-a X)))))
(define (image-set X) (let ((t (make-vector (xm-b X) #f))) (let loop ((m 0)) (if (< m (xm-a X)) (begin (vector-set! t (d-map X m) #t) (loop (+ m 1))))) t))
(define (xm-p X) (/ (xm-b X) (count-if (lambda (v) v) (vector->list (image-set X)))))   ;; |pi_1| = |N| / |im d|
(define (xm-kappa X) (count-if (lambda (m) (= 0 (d-map X m))) (range (xm-a X))))          ;; |pi_2| = |ker d|
(define (xm-omega X) (/ (xm-a X) (xm-kappa X)))                                          ;; ker d = omega Z/kappa inside Z/a
(define (d-preimage X v) (let loop ((m 0)) (cond ((= m (xm-a X)) #f) ((= v (d-map X m)) m) (else (loop (+ m 1))))))
;; pi_1 = Z/p by reduction mod p (p divides b, im d = p Z/b); the set section s(x) = x; the k-invariant by the
;; Baez-Lauda recipe: k(x, y, z) = s(x) . f(y, z) - f(x + y, z) + f(x, y + z) - f(x, y) in ker d, read in Z/kappa
(define (k-cocycle X x y z)
  (let* ((p (xm-p X))
         (f (lambda (u v) (d-preimage X (n-sub X (n-add X u v) (modulo (+ u v) p))))))
    (/ (m-sub X (m-add X (act X x (f y z)) (f x (modulo (+ y z) p))) (m-add X (f (modulo (+ x y) p) z) (f x y))) (xm-omega X))))
(define (pi1-mult X n) (/ (act X n (xm-omega X)) (xm-omega X)))     ;; the action of n in pi_1 on pi_2 = Z/kappa, as a multiplier

(define K22 (make-xmod 2 1 0 trivial-action))          ;; Z/2 -> 1
(define BZ2 (make-xmod 1 2 0 trivial-action))          ;; 1 -> Z/2
(define SPLIT (make-xmod 2 2 0 trivial-action))        ;; Z/2 -> Z/2 by zero
(define TWIST0 (make-xmod 4 4 2 trivial-action))       ;; Z/4 -> Z/4 by 2, trivial action: k = 0
(define (sign-action-4 n m) (if (even? n) m (modulo (- 0 m) 4)))
(define TWIST (make-xmod 4 4 2 sign-action-4))         ;; Z/4 -> Z/4 by 2, odd elements act by -1: k = x^3
(define (sign-action-3 n m) (if (even? n) m (modulo (- 0 m) 3)))
(define SGN3 (make-xmod 3 2 0 sign-action-3))          ;; Z/3 -> Z/2 by zero, the sign action: twisted coefficients
(define modules (list K22 BZ2 SPLIT TWIST0 TWIST SGN3))
(define module-names (list "K(Z/2,2)" "BZ/2" "Z/2->Z/2" "Z/4->Z/4 trivial" "Z/4->Z/4 sign" "Z/3->Z/2 sign"))
;; --- route 1: Yetter's state sum ---------------------------------------------------------------------
;; edge labellings in N with the spanning-tree edges fixed to 0 and every closed triangle's
;; n_ik - n_ij - n_jk in the image of d
(define (uf-find parent i) (let ((p (vector-ref parent i))) (if (= p i) i (uf-find parent p))))
(define (tree-edges X)
  (let ((parent (make-vector (c-V X) 0)) (fixed (make-vector (c-E X) #f)))
    (let init ((i 0)) (if (< i (c-V X)) (begin (vector-set! parent i i) (init (+ i 1)))))
    (let loop ((e 0))
      (if (< e (c-E X))
          (let ((a (uf-find parent (car (c-ends X e)))) (b (uf-find parent (cdr (c-ends X e)))))
            (if (not (= a b)) (begin (vector-set! parent a b) (vector-set! fixed e #t)))
            (loop (+ e 1)))))
    fixed))
(define (triangles-closed-at X)                  ;; vector: edge -> triangles whose largest edge index is that edge
  (let ((v (make-vector (c-E X) '())))
    (let loop ((f 0)) (if (< f (c-F X)) (let* ((tr (c-tri X f)) (m (let mx ((l tr) (m 0)) (if (null? l) m (mx (cdr l) (if (> (car l) m) (car l) m)))))) (vector-set! v m (cons f (vector-ref v m))) (loop (+ f 1)))))
    v))
(define (triangle-defect X M n f)                ;; n_ik - n_ij - n_jk for triangle f = (e_ij e_ik e_jk)
  (let ((tr (c-tri X f))) (n-sub M (n-sub M (vector-ref n (cadr tr)) (vector-ref n (car tr))) (vector-ref n (caddr tr)))))
;; triangle labels: m_f = c_f + omega u_f with d c_f the defect; the tetrahedron equations become
;; u_ijl + mult(n_ij) u_jkl - u_ijk - u_ikl = -(R_t / omega) mod kappa, R_t the same combination of the c's
(define (triangle-labellings-count X M n)
  (let* ((kappa (xm-kappa M)) (omega (xm-omega M))
         (c (list->vector (map (lambda (f) (d-preimage M (triangle-defect X M n f))) (range (c-F X)))))
         (mult (lambda (e) (pi1-mult M (vector-ref n e))))
         (beta (list->vector (map (lambda (t)
                                    (let ((R (m-sub M (m-add M (vector-ref c (tet-f t 1)) (act M (vector-ref n (tet-e t 0)) (vector-ref c (tet-f t 3))))
                                                    (m-add M (vector-ref c (tet-f t 0)) (vector-ref c (tet-f t 2))))))
                                      (if (= 0 (modulo R omega)) (modulo (- 0 (quotient R omega)) kappa) 'inconsistent)))
                                  (c-tets X)))))
    (if (any? (lambda (b) (not (number? b))) (vector->list beta)) 0
        (count-solutions-cached X 2 mult beta kappa))))
(define (yetter X M)
  (/ (* (rpow (xm-a M) (- (c-V X) (c-E X))) (sum (map (lambda (n) (with-region (triangle-labellings-count X M n))) (edge-labellings X M)))) (xm-b M)))

;; --- route 2: the fibration formula ------------------------------------------------------------------
(define (pi1-module M) (make-xmod 1 (xm-p M) 0 trivial-action))          ;; 1 -> pi_1: flat pi_1-labellings
(define (obstructed? X M rho)                     ;; rho^* k nonzero in H^3(X; pi_2 twisted by rho)?
  (let* ((kappa (xm-kappa M))
         (mult (lambda (e) (pi1-mult M (vector-ref rho e))))
         (kv (list->vector (map (lambda (t) (modulo (k-cocycle M (vector-ref rho (tet-e t 0)) (vector-ref rho (tet-e t 3)) (vector-ref rho (tet-e t 5))) kappa)) (c-tets X)))))
    (= 0 (count-solutions-cached X 2 mult kv kappa))))
(define (fibration-sum X M)
  (let ((kappa (xm-kappa M)) (p (xm-p M)))
    (sum (map (lambda (rho)
                (with-region
                  (if (obstructed? X M rho) 0
                      (/ (top-cohomology-order X (lambda (e) (pi1-mult M (vector-ref rho e))) kappa) p))))
              (edge-labellings X (pi1-module M))))))

;; --- the 64-point model as a Delta-complex --------------------------------------------------------------
(define S (make-poset 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define T3P (poset-product (poset-product S S) S))
(define all-points (range 64))
(define edges-c (chains T3P 1 all-points))          ;; (higher lower)
(define tris-c (chains T3P 2 all-points))
(define tets-c (chains T3P 3 all-points))
(define edge-tab (index-table T3P edges-c 1))
(define tri-tab (index-table T3P tris-c 2))
(define (edge-of hi lo) (vector-ref edge-tab (chain-key T3P (list hi lo))))
(define (tri-of hi mid lo) (vector-ref tri-tab (chain-key T3P (list hi mid lo))))
;; a chain (x0 x1 x2 x3) largest first: vertices v0 = x3 < v1 = x2 < v2 = x1 < v3 = x0
(define T3
  (vector 64
          (list->vector (map (lambda (e) (cons (cadr e) (car e))) edges-c))
          (list->vector (map (lambda (t) (let ((v0 (caddr t)) (v1 (cadr t)) (v2 (car t))) (list (edge-of v1 v0) (edge-of v2 v0) (edge-of v2 v1)))) tris-c))
          (map (lambda (c) (let ((v0 (cadddr c)) (v1 (caddr c)) (v2 (cadr c)) (v3 (car c)))
                             (vector v0 v1 v2 v3 (edge-of v1 v0) (edge-of v2 v0) (edge-of v3 v0) (edge-of v2 v1) (edge-of v3 v1) (edge-of v3 v2)
                                     (tri-of v2 v1 v0) (tri-of v3 v1 v0) (tri-of v3 v2 v0) (tri-of v3 v2 v1))))
               tets-c)))
(show "(V, E, F, T)" (list (c-V T3) (c-E T3) (c-F T3) (c-T T3)))
(check "the order complex of the 64-point model has (64, 448, 768, 384) cells and Euler characteristic 0"
       (and (equal? (list (c-V T3) (c-E T3) (c-F T3) (c-T T3)) (list 64 448 768 384)) (= 0 (euler-char T3))))
(check "every tetrahedron's faces are the triangles on its vertex triples (the triangle table is consistent)"
       (all? (lambda (t) (and (equal? (c-tri T3 (tet-f t 0)) (list (tet-e t 0) (tet-e t 1) (tet-e t 3)))
                              (equal? (c-tri T3 (tet-f t 1)) (list (tet-e t 0) (tet-e t 2) (tet-e t 4)))
                              (equal? (c-tri T3 (tet-f t 2)) (list (tet-e t 1) (tet-e t 2) (tet-e t 5)))
                              (equal? (c-tri T3 (tet-f t 3)) (list (tet-e t 3) (tet-e t 4) (tet-e t 5)))))
             (c-tets T3)))
(define HZ (with-region (integral-cohomology T3)))
(show "H^*(T^3 model; Z)" HZ)
(check "integral cohomology (Z, Z^3, Z^3, Z)" (equal? HZ (list (list 0 1 '()) (list 1 3 '()) (list 2 3 '()) (list 3 1 '()))))
(define H2 (with-region (cohomology-orders T3 trivial-mult 2)))
(define H3 (with-region (cohomology-orders T3 trivial-mult 3)))
(show "orders of H^*(T^3 model; Z/2) and (Z/3)" (list H2 H3))
(check "mod 2 orders (2, 8, 8, 2) and mod 3 orders (3, 27, 27, 3)" (and (equal? H2 (list 2 8 8 2)) (equal? H3 (list 3 27 27 3))))

;; --- edge labellings by closing triangles in rounds --------------------------------------------------------
(define (list-max xs) (let loop ((l (cdr xs)) (m (car xs))) (if (null? l) m (loop (cdr l) (if (> (car l) m) (car l) m)))))
(define (closing-order X fixed)                    ;; non-tree edges in the order in which some triangle closes them
  (let ((placed (make-vector (c-E X) #f)))
    (let init ((e 0)) (if (< e (c-E X)) (begin (vector-set! placed e (vector-ref fixed e)) (init (+ e 1)))))
    (let rounds ((order '()))
      (let ((new (let loop ((f 0) (acc '()))
                   (if (= f (c-F X)) acc
                       (let ((unplaced (filter (lambda (e) (not (vector-ref placed e))) (c-tri X f))))
                         (loop (+ f 1) (if (and (= 1 (length unplaced)) (not (memv (car unplaced) acc))) (cons (car unplaced) acc) acc)))))))
        (if (null? new)
            (append (reverse order) (filter (lambda (e) (not (vector-ref placed e))) (range (c-E X))))
            (begin (for-each (lambda (e) (vector-set! placed e #t)) new)
                   (rounds (append (reverse new) order))))))))
(define (edge-labellings X M)
  (let* ((fixed (tree-edges X)) (order (list->vector (closing-order X fixed))) (k (vector-length order))
         (pos (make-vector (c-E X) -1)) (by-pos (make-vector (if (= k 0) 1 k) '()))
         (im (image-set M)) (n (make-vector (c-E X) 0)) (results (vector '())))
    (let loop ((i 0)) (if (< i k) (begin (vector-set! pos (vector-ref order i) i) (loop (+ i 1)))))
    (let loop ((f 0))
      (if (< f (c-F X))
          (let ((p (list-max (map (lambda (e) (vector-ref pos e)) (c-tri X f)))))
            (if (>= p 0) (vector-set! by-pos p (cons f (vector-ref by-pos p))))
            (loop (+ f 1)))))
    (let dfs ((i 0))
      (if (= i k)
          (vector-set! results 0 (cons (let ((w (make-vector (c-E X) 0))) (let cp ((j 0)) (if (< j (c-E X)) (begin (vector-set! w j (vector-ref n j)) (cp (+ j 1))))) w) (vector-ref results 0)))
          (let ((e (vector-ref order i)))
            (let try ((g 0))
              (if (< g (xm-b M))
                  (begin
                    (vector-set! n e g)
                    (if (all? (lambda (f) (vector-ref im (triangle-defect X M n f))) (vector-ref by-pos i)) (dfs (+ i 1)))
                    (try (+ g 1))))))))
    (vector-ref results 0)))
(define (yetter-reduced X M)
  (/ (* (rpow (xm-kappa M) (- (c-V X) (c-E X)))
        (sum (map (lambda (rho) (with-region (triangle-labellings-count X M rho))) (edge-labellings X (pi1-module M)))))
     (xm-p M)))
(define rhos-2 (with-region (edge-labellings T3 (make-xmod 1 2 0 trivial-action))))
(define rhos-3 (with-region (edge-labellings T3 (make-xmod 1 3 0 trivial-action))))
(check "gauge-fixed flat labellings: 8 in Z/2 and 27 in Z/3 (a spanning tree of 63 edges, 385 edges closed in rounds)"
       (and (= 8 (length rhos-2)) (= 27 (length rhos-3)) (= 63 (count-if (lambda (b) b) (vector->list (tree-edges T3))))))

;; --- the modules and the invariants ----------------------------------------------------------------------
(define SPLIT3 (make-xmod 3 3 0 trivial-action))
(define TW9-0 (make-xmod 9 9 3 trivial-action))
(define (four-power n) (let loop ((k (modulo n 3)) (acc 1)) (if (= k 0) acc (loop (- k 1) (modulo (* 4 acc) 9)))))
(define TW9 (make-xmod 9 9 3 (lambda (n m) (modulo (* (four-power n) m) 9))))
(define modules (list K22 BZ2 SPLIT TWIST0 TWIST SGN3 SPLIT3 TW9-0 TW9))
(check "nine crossed modules" (all? crossed-module? modules))
(define Z-reduced (map (lambda (M) (with-region (yetter-reduced T3 M))) modules))
(show "Yetter on the 64-point model: K(Z/2,2), BZ/2, Z/2->Z/2, Z/4->Z/4 trivial, Z/4->Z/4 sign, Z/3->Z/2 sign, Z/3->Z/3, Z/9->Z/9 trivial, Z/9->Z/9 4^n" Z-reduced)
(check "the invariants equal the one-vertex values 2, 4, 8, 8, 8, 5, 27, 27, 27, exactly, through a 2^-384 (or 3^-384) normalization"
       (and (equal? Z-reduced (list 2 4 8 8 8 5 27 27 27)) (all? exact? Z-reduced)))
(define Z-fib (map (lambda (M) (with-region (fibration-sum T3 M))) modules))
(show "fibration formula" Z-fib)
(check "the fibration formula agrees with the state sum for all nine modules on the 64-point model" (equal? Z-reduced Z-fib))
(check "no homomorphism Z^3 -> pi_1 is obstructed for the sign-action Z/4 module (8 of 8) or the 4^n Z/9 module (27 of 27)"
       (and (= 0 (count-if (lambda (rho) (obstructed? T3 TWIST rho)) rhos-2)) (= 0 (count-if (lambda (rho) (obstructed? T3 TW9 rho)) rhos-3))))
(define tops (map (lambda (rho) (with-region (top-cohomology-order T3 (lambda (e) (pi1-mult SGN3 (vector-ref rho e))) 3))) rhos-2))
(show "|H^3(T^3 model; Z/3 twisted)| per rho" tops)
(define nontrivial-rho (car (filter (lambda (r) (any? (lambda (v) (not (= 0 v))) (vector->list r))) rhos-2)))
(define twisted-full (with-region (cohomology-orders T3 (lambda (e) (pi1-mult SGN3 (vector-ref nontrivial-rho e))) 3)))
(show "orders of H^*(T^3 model; Z/3 twisted by one nontrivial character), all degrees" twisted-full)
(check "twisted Z/3 coefficients: |H^3| is 3 for the trivial character and 1 for the seven others; one nontrivial character has all four orders 1, and the untwisted orders satisfy |H^0||H^2| = |H^1||H^3| (chi = 0)"
       (and (= 1 (count-if (lambda (h) (= h 3)) tops)) (= 7 (count-if (lambda (h) (= h 1)) tops))
            (equal? twisted-full (list 1 1 1 1))
            (= (* (list-ref H3 0) (list-ref H3 2)) (* (list-ref H3 1) (list-ref H3 3)))))
(show "Smith normal forms computed" snf-count)
(check "twelve Smith normal forms serve the whole program: three untwisted coboundaries, delta^2 for the seven nontrivial characters, and delta^0, delta^1 for one of them (the first version needed 129)"
       (= 12 snf-count))

(display "Yetter's 2-group invariants on the 64-point finite model of T^3") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
