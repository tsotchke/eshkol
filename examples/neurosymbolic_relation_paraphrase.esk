;; Learning what a new word means from three queries (v1.5.0 neuro-symbolic
;; bridge, ADR-0049).
;;
;; The knowledge base stores `parent` and `likes` facts. Queries arrive using
;; the word `father`, which no fact mentions. Every KB symbol gets a learnable
;; embedding; `neural-query` answers a query by attention whose logits are
;; soft-unification proof scores against the facts. Training on three queries
;; about one family moves `father` next to `parent` in embedding space, and
;; the same queries about a second family, never seen in training, are then
;; answered from its `parent` facts. Soft unification binds the query
;; variable with the engine's own `unify`, so the answer is a substitution.
;;
;; Run: eshkol-run -r examples/neurosymbolic_relation_paraphrase.esk

(require core.ml.neurosymbolic)

(define (r3 x) (/ (round (* 1000.0 x)) 1000.0))

(define kb (make-kb))
(for-each (lambda (f) (kb-assert! kb (make-fact (car f) (cadr f) (caddr f))))
          '((parent ann bob) (parent bob cid) (parent dee eve) (parent eve fay)
            (parent gus hal) (likes bob tea) (likes eve jazz) (likes hal chess)))

(define tbl (make-embedding-table 6))
(embedding-attach-kb! tbl kb '((parent . 2) (likes . 2)))
(embedding-index tbl 'father)
(display "symbols with embeddings: ") (display (embedding-count tbl)) (newline)

(define rbf (make-rbf-similarity 1.0))
(define (nll theta q a) (- (log (neural-query-probability theta tbl q a rbf 1.0))))
(define (train-loss theta)
  (+ (nll theta '(father ann ?w) 'bob) (nll theta '(father bob ?w) 'cid) (nll theta '(father gus ?w) 'hal)
     (nll theta '(likes bob ?w) 'tea) (nll theta '(likes hal ?w) 'chess)))

(define theta (embedding-params tbl))
(define (sim a b) (rbf-similarity (param-embedding theta tbl a) (param-embedding theta tbl b) 1.0))
(display "before: loss ") (display (r3 (train-loss theta)))
(display "  sim(father, parent) ") (display (r3 (sim 'father 'parent)))
(display "  sim(father, likes) ") (display (r3 (sim 'father 'likes))) (newline)

(let train ((step 0))
  (if (< step 100)
      (let ((g (gradient train-loss theta)))
        (let upd ((i 0))
          (if (< i (vector-length theta))
              (begin (vector-set! theta i (- (vector-ref theta i) (* 0.05 (vector-ref g i)))) (upd (+ i 1)))))
        (train (+ step 1)))))

(display "after:  loss ") (display (r3 (train-loss theta)))
(display "  sim(father, parent) ") (display (r3 (sim 'father 'parent)))
(display "  sim(father, likes) ") (display (r3 (sim 'father 'likes))) (newline)

;; held-out family
(for-each
 (lambda (q)
   (display q) (display " -> ") (display (neural-query-answer theta tbl q rbf 1.0))
   (display "  p = ") (display (r3 (neural-query-probability theta tbl q (neural-query-answer theta tbl q rbf 1.0) rbf 1.0)))
   (newline))
 '((father dee ?w) (father eve ?w) (likes eve ?w)))

;; the best soft proof, with the engine's substitution
(define proof (soft-prove theta tbl '(father eve ?who) rbf))
(display "best proof of (father eve ?who): ") (display (cadr proof))
(display " binds ?who = ") (display (walk '?who (caddr proof)))
(display ", score ") (display (r3 (car proof))) (newline)
(embedding-load! tbl theta)
