;; Homotopy colimits as nerves of Grothendieck constructions: suspensions,
;; pushouts, and homotopy quotients of a finite space by group actions.
;;
;; Sources: R. W. Thomason, "Homotopy colimits in the category of small
;; categories", Math. Proc. Cambridge Phil. Soc. 85 (1979) (the nerve of the
;; Grothendieck construction is the homotopy colimit of the nerves);
;; A. K. Bousfield, D. M. Kan, LNM 304 (1972), XII; J. Lurie, "Higher Topos
;; Theory" (2009), 3.2 and 4.2 (Grothendieck construction, colimits of
;; infinity-categories); for the Borel construction, K. Brown, "Cohomology of
;; Groups", VII.7.
;;
;; A diagram of posets F over a small category C has a Grothendieck
;; construction: objects (c, x) with x in F(c), morphisms (c, x) -> (c', x')
;; given by an arrow u: c -> c' with F(u)(x) <= x'. Thomason's theorem says
;; the nerve of this category is the homotopy colimit of the diagram of order
;; complexes. Everything below computes that nerve (normalized, without
;; identity arrows), its integral cohomology by Smith normal form, and
;; compares with what homotopy theory predicts and with the STRICT colimit.
;; Posets are thin categories, a diagram of posets is a core.category
;; category diagram (a strict functor into finite categories), and the
;; Grothendieck construction, the nerve and its cohomology come from
;; core.category (docs/reference/stdlib/category.md); a group acting on a
;; poset is a diagram over the one-object category of the group, whose
;; Grothendieck construction is the action category.
;;
;;   1. Diagrams over the span poset L > M < R with F(L) = F(R) = point:
;;      F(M) = two points gives a circle (Z, Z); F(M) = the pseudocircle gives a
;;      2-sphere (Z, 0, Z). The Grothendieck construction of a poset-indexed
;;      diagram of posets is a poset (the "lexicographic" order), computed and
;;      checked to be one.
;;   2. Diagrams over the group Z/2 (one object): the Grothendieck
;;      construction is the action category, whose nerve is the Borel
;;      construction X_{hZ/2}. For the pseudocircle: the trivial action gives
;;      S^1 x BZ/2 with (Z, Z, Z/2, Z/2); the antipodal (free) action gives the
;;      quotient circle, (Z, Z, 0, 0); the reflection fixing c and d gives
;;      BZ/2 v BZ/2, (Z, 0, (Z/2)^2, 0). The trivial action on a point gives
;;      BZ/2 itself, (Z, 0, Z/2, 0), the same answer the classifying-space
;;      example computed from the bar complex.
;;   3. The strict quotient poset of the antipodal action is contractible
;;      (two points, one relation): the strict colimit forgets the circle
;;      that the homotopy colimit keeps. That is the computation behind the
;;      slogan that colimits in a higher topos are homotopy colimits.
;;
;; NOTE: every construction below is a core.category value; nothing is re-encoded.

(require stdlib)
(require core.category.functor)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))

;; --- posets as thin categories ------------------------------------------------------------------
(define (make-poset n covers) (let ((X (make-finite-space n covers))) (poset-category n (lambda (x y) (finite-space-leq? X x y)))))
(define (poset? P)                                ;; thin, and antisymmetric: the only isomorphisms are identities
  (and (category-laws? P) (category-thin? P)
       (all? (lambda (a) (or (category-identity? P a) (not (category-isomorphism? P a)))) (category-arrow-list P))))
(define (H-poset P kmax) (with-region (category-nerve-cohomology P kmax)))
;; a monotone map as a functor between thin categories, from its action on points
(define (monotone-functor P Q f)
  (functor-from-procedures P Q f (lambda (a) (category-thin-arrow Q (f (arrow-source P a)) (f (arrow-target P a))))))

;; --- Part 1: poset-indexed diagrams of posets ------------------------------------------------
;; A diagram over an index poset I: for each i a poset F(i), and for i <= j a monotone map F(i) -> F(j).
;; Grothendieck construction: pairs (i, x), (i, x) <= (j, y) iff i <= j and F(i <= j)(x) <= y.
(define (poset-diagram I F Fmap)                  ;; F: i -> poset, Fmap: (i j x) -> point of F(j)
  (let ((cats (list->vector (map F (iota (category-object-count I))))))
    (make-category-diagram I cats
                           (map (lambda (a) (let ((i (arrow-source I a)) (j (arrow-target I a)))
                                              (monotone-functor (vector-ref cats i) (vector-ref cats j) (lambda (x) (Fmap i j x)))))
                                (category-arrow-list I)))))
(define point (make-poset 1 '()))
(define two-points (make-poset 2 '()))
(define S (make-poset 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
;; the span: M = 0 below L = 1 and R = 2
(define span (make-poset 3 (list (cons 0 1) (cons 0 2))))
(define (span-diagram X) (lambda (i) (if (= i 0) X point)))
(define (span-map i j x) (if (= i j) x 0))         ;; everything in F(M) goes to the point
(define circle-diagram (poset-diagram span (span-diagram two-points) span-map))
(define sphere-diagram (poset-diagram span (span-diagram S) span-map))
(define circle-hocolim (grothendieck-construction circle-diagram))
(define sphere-hocolim (grothendieck-construction sphere-diagram))
(check "the Grothendieck constructions over the span are posets (4 and 6 points)"
       (and (null? (category-diagram-violations circle-diagram)) (null? (category-diagram-violations sphere-diagram))
            (poset? circle-hocolim) (= 4 (category-object-count circle-hocolim)) (poset? sphere-hocolim) (= 6 (category-object-count sphere-hocolim))))
(define H-circle (H-poset circle-hocolim 2))
(define H-sphere (H-poset sphere-hocolim 3))
(show "H^*(hocolim of pt <- S^0 -> pt)" H-circle)
(show "H^*(hocolim of pt <- pseudocircle -> pt)" H-sphere)
(check "Thomason: the homotopy pushout of a point, two points, a point is a circle, (Z, Z)"
       (equal? H-circle (list (list 0 1 '()) (list 1 1 '()) (list 2 0 '()))))
(check "Thomason: the homotopy pushout suspending the pseudocircle is a 2-sphere, (Z, 0, Z)"
       (equal? H-sphere (list (list 0 1 '()) (list 1 0 '()) (list 2 1 '()) (list 3 0 '()))))
(check "the strict pushout of the same diagram is a point: the strict colimit collapses the circle"
       (let ((strict (make-poset 1 '()))) (equal? (H-poset strict 1) (list (list 0 1 '()) (list 1 0 '())))))
(check "a diagram of points over the pseudocircle has the pseudocircle as its homotopy colimit (the indexing poset itself)"
       (let ((G (grothendieck-construction (poset-diagram S (lambda (i) point) (lambda (i j x) 0)))))
         (equal? (H-poset G 2) (list (list 0 1 '()) (list 1 1 '()) (list 2 0 '())))))

;; --- Part 2: group actions and the Borel construction ------------------------------------------
;; A finite group acting on a poset X by automorphisms is a diagram BG -> Posets; its Grothendieck construction is
;; the action category: objects x, morphisms (g, f): x -> y whenever g x <= y. The normalized nerve has the
;; n-simplices (x0 (g1 . x1) ... (gn . xn)) with g_i x_{i-1} <= x_i and not (g_i = e and x_i = x_{i-1}).
(define Z2 (cyclic-group-category 2))
(define (trivial-action g x) x)
(define (antipodal g x) (if (= g 0) x (case x ((0) 1) ((1) 0) ((2) 3) (else 2))))     ;; a <-> b, c <-> d
(define (reflection g x) (if (= g 0) x (case x ((0) 1) ((1) 0) (else x))))             ;; a <-> b, c and d fixed
(define (action-diagram G X act)                  ;; the arrow g of BG acts by the functor x |-> g x
  (make-category-diagram G (list X) (map (lambda (g) (monotone-functor X X (lambda (x) (act g x)))) (category-arrow-list G))))
;; automorphisms of the poset (each g a functor with an inverse), and a group action (strict functoriality)
(define (action-valid? G X act)
  (let ((D (action-diagram G X act)))
    (and (null? (category-diagram-violations D))
         (all? (lambda (g) (all? (lambda (x) (all? (lambda (y) (eq? (pair? (category-hom X x y)) (pair? (category-hom X (act g x) (act g y)))))
                                                  (category-object-list X)))
                                 (category-object-list X)))
               (category-arrow-list G)))))
(define (borel-category G X act) (grothendieck-construction (action-diagram G X act)))
(define (borel-cohomology G X act kmax) (with-region (category-nerve-cohomology (borel-category G X act) kmax)))
(check "the three Z/2 actions on the pseudocircle are actions by poset automorphisms"
       (and (action-valid? Z2 S trivial-action) (action-valid? Z2 S antipodal) (action-valid? Z2 S reflection)))
(show "nondegenerate simplices of the Borel nerve for the antipodal action, degrees 0..4"
      (let ((B (borel-category Z2 S antipodal))) (map (lambda (k) (length (category-nerve B k))) (list 0 1 2 3 4))))
(define H-BZ2 (borel-cohomology Z2 point trivial-action 4))
(show "H^*(BZ/2; Z) from the action category of a point" H-BZ2)
(check "the trivial action on a point gives BZ/2: (Z, 0, Z/2, 0, Z/2)"
       (equal? H-BZ2 (list (list 0 1 '()) (list 1 0 '()) (list 2 0 (list 2)) (list 3 0 '()) (list 4 0 (list 2)))))
(define H-trivial (borel-cohomology Z2 S trivial-action 3))
(define H-free (borel-cohomology Z2 S antipodal 3))
(define H-refl (borel-cohomology Z2 S reflection 3))
(show "H^*(S^1_{hZ/2}) for the trivial action" H-trivial)
(show "H^*(S^1_{hZ/2}) for the antipodal (free) action" H-free)
(show "H^*(S^1_{hZ/2}) for the reflection" H-refl)
(check "trivial action: S^1 x BZ/2, (Z, Z, Z/2, Z/2)"
       (equal? H-trivial (list (list 0 1 '()) (list 1 1 '()) (list 2 0 (list 2)) (list 3 0 (list 2)))))
(check "free action: the homotopy quotient is the quotient circle, (Z, Z, 0, 0)"
       (equal? H-free (list (list 0 1 '()) (list 1 1 '()) (list 2 0 '()) (list 3 0 '()))))
(check "reflection with two fixed points: BZ/2 v BZ/2, (Z, 0, (Z/2)^2, 0)"
       (equal? H-refl (list (list 0 1 '()) (list 1 0 '()) (list 2 0 (list 2 2)) (list 3 0 '()))))
;; the strict quotient of the antipodal action: identify a ~ b and c ~ d
(define strict-quotient (make-poset 2 (list (cons 0 1))))
(check "the strict quotient poset of the free action is contractible, (Z, 0): the strict colimit forgets the circle the homotopy quotient keeps"
       (and (equal? (H-poset strict-quotient 1) (list (list 0 1 '()) (list 1 0 '())))
            (= 1 (cadr (cadr H-free)))))
(check "negative control -- swapping the roles of the two actions fails: the free action's answer is not the trivial action's"
       (not (equal? H-free H-trivial)))

(display "Homotopy colimits as nerves of Grothendieck constructions") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
