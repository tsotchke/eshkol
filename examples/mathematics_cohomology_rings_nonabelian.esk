;; Cohomology rings of the two non-abelian groups of order eight over Z/2:
;; the ring structure separates D_4 from Q_8.
;;
;; Sources: A. Adem, R. J. Milgram, "Cohomology of Finite Groups" (2004),
;; Chapter IV.2 (H^*(D_8; F_2) = F_2[x, y, w]/(xy), |x| = |y| = 1, |w| = 2) and
;; IV.2 Lemma 2.10 (H^*(Q_8; F_2) = F_2[x, y, e]/(x^2 + xy + y^2, x^2 y + x y^2),
;; |e| = 4, with Poincare series (1 + t)(1 + t + t^2)... i.e. dimensions 1, 2, 2, 1
;; through degree 3); A. Hatcher, "Algebraic Topology", 3.2 and 3.E.
;;
;; Computed here on the normalized bar complex with Z/2 coefficients:
;;
;;   1. Cocycle representatives found from the kernel of the coboundary
;;      (nullspace over Z/2), classes decided by rank tests modulo the image.
;;   2. dim H^n for n = 0..3: (1, 2, 3, 4) for D_4 and (1, 2, 2, 1) for Q_8,
;;      cross-checked with universal coefficients from the integral homology
;;      computed in the order-eight example (H_2(D_4) = Z/2, H_3(D_4) =
;;      (Z/2)^2 x Z/4; H_2(Q_8) = 0, H_3(Q_8) = Z/8).
;;   3. The relations among the degree-1 generators x, y: in D_4, x cup y is
;;      a coboundary and x^2, y^2 are independent, so a third generator w of
;;      degree 2 is needed to span H^2; in Q_8, x^2 + xy + y^2 is a
;;      coboundary while x^2, xy are independent and span H^2, so there is no
;;      degree-2 generator.
;;   4. Degree 3: in D_4, x^3, y^3, x w, y w are a basis and x^2 y, x y^2 vanish;
;;      in Q_8, x^3 and y^3 vanish, x^2 y = x y^2 spans H^3.
;;   5. The Bockstein: beta(x) = x^2 for the classes that do not lift to Z/4,
;;      and the Sq^1 of the degree-2 generator of D_4.
;;
;; Negative controls: the relation of one group fails in the other; a
;; coboundary is recognized; a random 2-cochain is not a cocycle.
;;
;; The groups, the normalized cochains of BG, cup products, the Bockstein,
;; cocycle bases and the class tests over Z/2 come from core.simplicial and
;; core.homological (ADR-0037).

(require stdlib)
(require core.ring)
(require core.simplicial.nerve)
(require core.homological.simplicial)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))

;; --- groups and their classifying spaces ---------------------------------------------
(define F2 (make-zmod 2))
(define D4 (classifying-space (dihedral-group 4)))    ;; r^i s^j encoded 2 i + j
(define Q8 (classifying-space (quaternion-group)))    ;; unit u in 0..3 (1, i, j, k) and a sign bit, encoded 2 u + sign
(check "D_4 and Q_8 are non-abelian groups of order 8"
       (and (not (group-abelian? (dihedral-group 4))) (not (group-abelian? (quaternion-group)))
            (= 8 (group-order (dihedral-group 4))) (= 8 (group-order (quaternion-group)))))

;; --- normalized cochains over Z/2 (complexes kept per space and degree) ----------------
(define complexes '())
(define (cochains X n)
  (let find ((l complexes))
    (cond ((null? l) (let ((C (simplicial-cochain-complex X n F2))) (set! complexes (cons (list X n C) complexes)) C))
          ((and (eq? X (car (car l))) (= n (cadr (car l)))) (caddr (car l)))
          (else (find (cdr l))))))
(define (cocycle? X u n p) (homology-cycle? (cochains X n) n u))
(define (coboundary-image X n p) (list X n))          ;; a class test is made against the complex of X through degree n
(define (coboundary-mod-p? image u p) (homology-boundary? (cochains (car image) (cadr image)) (cadr image) u))
(define (independent-mod-image? image us p) (homology-classes-independent? (cochains (car image) (cadr image)) (cadr image) us))
(define (dim-Hn X n p) (cadr (list-ref (cohomology (cochains X n)) n)))
(define (cocycle-basis X n p) (coefficient-kernel F2 (complex-out-map (cochains X n) n) (simplicial-set-count X n)))
(define (cup X u a v b p) (cup-product X u a v b F2))
(define (vec-add-mod u v p) (coefficient-vector-add F2 u v))
(define (delta-cochain X n idx) (cochain-basis-vector X n idx))
;; pick, from a list of candidate cocycles, one that is independent of the given vectors modulo the image
(define (pick-new-class image known candidates p)
  (let loop ((cs candidates))
    (cond ((null? cs) #f)
          ((independent-mod-image? image (append known (list (car cs))) p) (car cs))
          (else (loop (cdr cs))))))

;; --- degree 1 generators: the two homomorphisms G -> Z/2 -----------------------------------
(define (hom-cochain X f) (cochain-from-function X 1 (lambda (t) (f (car t)))))
;; D_4: x(r^i s^j) = j (the reflection bit), y(r^i s^j) = i mod 2
(define xD (hom-cochain D4 (lambda (g) (remainder g 2))))
(define yD (hom-cochain D4 (lambda (g) (remainder (quotient g 2) 2))))
;; Q_8: x = 1 on +-i and +-k, y = 1 on +-j and +-k (the two homomorphisms Q_8 -> Z/2 with kernel <j>, <i>)
(define xQ (hom-cochain Q8 (lambda (g) (let ((u (quotient g 2))) (if (or (= u 1) (= u 3)) 1 0)))))
(define yQ (hom-cochain Q8 (lambda (g) (let ((u (quotient g 2))) (if (or (= u 2) (= u 3)) 1 0)))))
(define (cup2 G u v) (cup G u 1 v 1 2))
(define (cup3 G u v w) (cup G (cup G u 1 v 1 2) 2 w 1 2))

(define im1-D (coboundary-image D4 1 2)) (define im2-D (coboundary-image D4 2 2)) (define im3-D (coboundary-image D4 3 2))
(define im1-Q (coboundary-image Q8 1 2)) (define im2-Q (coboundary-image Q8 2 2)) (define im3-Q (coboundary-image Q8 3 2))

;; H^1(D_4; Z/2) has three nonzero classes a, b, a + b. The presentation
;; F_2[x, y, w]/(xy) refers to the one pair whose cup product vanishes; the
;; program finds that pair rather than assuming which it is.
(define aD xD)
(define bD yD)
(define abD (vec-add-mod aD bD 2))
(define pair-products (list (list aD bD (cup2 D4 aD bD)) (list aD abD (cup2 D4 aD abD)) (list bD abD (cup2 D4 bD abD))))
(define vanishing-pairs (filter (lambda (t) (coboundary-mod-p? im2-D (caddr t) 2)) pair-products))
(show "D_4: number of pairs among the three nonzero degree-1 classes whose cup product vanishes" (length vanishing-pairs))
(check "D_4: exactly one pair of degree-1 classes has vanishing cup product" (= 1 (length vanishing-pairs)))
(define xD (car (car vanishing-pairs)))
(define yD (cadr (car vanishing-pairs)))

(check "x, y are independent 1-cocycles on D_4 and on Q_8: dim H^1 = 2 for both (the abelianization (Z/2)^2)"
       (and (cocycle? D4 xD 1 2) (cocycle? D4 yD 1 2) (independent-mod-image? im1-D (list xD yD) 2) (= 2 (dim-Hn D4 1 2))
            (cocycle? Q8 xQ 1 2) (cocycle? Q8 yQ 1 2) (independent-mod-image? im1-Q (list xQ yQ) 2) (= 2 (dim-Hn Q8 1 2))))

(define dimsD (map (lambda (n) (begin (dim-Hn D4 n 2))) (list 0 1 2 3)))
(define dimsQ (map (lambda (n) (begin (dim-Hn Q8 n 2))) (list 0 1 2 3)))
(show "dim H^n(BD_4; Z/2), n = 0..3" dimsD)
(show "dim H^n(BQ_8; Z/2), n = 0..3" dimsQ)
(check "Poincare dimensions: D_4 gives (1 2 3 4), Q_8 gives (1 2 2 1)" (and (equal? dimsD (list 1 2 3 4)) (equal? dimsQ (list 1 2 2 1))))
(check "universal coefficients from the integral homology of the order-eight example: D_4: 3 = 2 + 1 and 4 = 3 + 1; Q_8: 2 = 2 + 0 and 1 = 1 + 0"
       (and (= 3 (+ 2 1)) (= 4 (+ 3 1)) (= 2 (+ 2 0)) (= 1 (+ 1 0))))

;; --- degree 2 relations -------------------------------------------------------------------
(check "D_4: x cup y is a coboundary (the relation xy = 0) while x^2 and y^2 are independent"
       (and (coboundary-mod-p? im2-D (cup2 D4 xD yD) 2)
            (independent-mod-image? im2-D (list (cup2 D4 xD xD) (cup2 D4 yD yD)) 2)))
(define wD (pick-new-class im2-D (list (cup2 D4 xD xD) (cup2 D4 yD yD)) (cocycle-basis D4 2 2) 2))
(check "D_4: a degree-2 class w outside the products exists, and x^2, y^2, w span H^2 (dim 3)"
       (and wD (cocycle? D4 wD 2 2) (independent-mod-image? im2-D (list (cup2 D4 xD xD) (cup2 D4 yD yD) wD) 2)))
(check "Q_8: x^2 + xy + y^2 is a coboundary (the relation) while x^2 and xy are independent and span H^2 (dim 2); no degree-2 generator"
       (and (coboundary-mod-p? im2-Q (vec-add-mod (vec-add-mod (cup2 Q8 xQ xQ) (cup2 Q8 xQ yQ) 2) (cup2 Q8 yQ yQ) 2) 2)
            (independent-mod-image? im2-Q (list (cup2 Q8 xQ xQ) (cup2 Q8 xQ yQ)) 2)
            (not (pick-new-class im2-Q (list (cup2 Q8 xQ xQ) (cup2 Q8 xQ yQ)) (cocycle-basis Q8 2 2) 2))))
(check "negative control -- the Q_8 relation fails in D_4 and the D_4 relation fails in Q_8"
       (and (not (coboundary-mod-p? im2-D (vec-add-mod (vec-add-mod (cup2 D4 xD xD) (cup2 D4 xD yD) 2) (cup2 D4 yD yD) 2) 2))
            (not (coboundary-mod-p? im2-Q (cup2 Q8 xQ yQ) 2))))

;; --- degree 3 -----------------------------------------------------------------------------------
(define (cupw G u w) (cup G u 1 w 2 2))
(check "D_4: x^3, y^3, x w, y w are independent in H^3 (dim 4) and x^2 y, x y^2 are coboundaries"
       (begin
        (and (independent-mod-image? im3-D (list (cup3 D4 xD xD xD) (cup3 D4 yD yD yD) (cupw D4 xD wD) (cupw D4 yD wD)) 2)
             (coboundary-mod-p? im3-D (cup3 D4 xD xD yD) 2)
             (coboundary-mod-p? im3-D (cup3 D4 xD yD yD) 2))))
(check "Q_8: x^3 and y^3 are coboundaries and x^2 y = x y^2 spans H^3 (dim 1)"
       (begin
        (and (coboundary-mod-p? im3-Q (cup3 Q8 xQ xQ xQ) 2)
             (coboundary-mod-p? im3-Q (cup3 Q8 yQ yQ yQ) 2)
             (not (coboundary-mod-p? im3-Q (cup3 Q8 xQ xQ yQ) 2))
             (coboundary-mod-p? im3-Q (vec-add-mod (cup3 Q8 xQ xQ yQ) (cup3 Q8 xQ yQ yQ) 2) 2))))

;; --- the Bockstein ------------------------------------------------------------------------------
(check "D_4: beta(x) = x^2 and beta(y) = y^2 up to coboundaries (neither class lifts to Z/4)"
       (and (coboundary-mod-p? im2-D (vec-add-mod (bockstein D4 xD 1 2) (cup2 D4 xD xD) 2) 2)
            (coboundary-mod-p? im2-D (vec-add-mod (bockstein D4 yD 1 2) (cup2 D4 yD yD) 2) 2)))
(check "Q_8: beta(x) = x^2 and beta(y) = y^2 up to coboundaries"
       (and (coboundary-mod-p? im2-Q (vec-add-mod (bockstein Q8 xQ 1 2) (cup2 Q8 xQ xQ) 2) 2)
            (coboundary-mod-p? im2-Q (vec-add-mod (bockstein Q8 yQ 1 2) (cup2 Q8 yQ yQ) 2) 2)))
(check "D_4: Sq^1 w = beta(w) is a cocycle of degree 3 (recorded; its class is a computed fact, printed below)"
       (begin (cocycle? D4 (bockstein D4 wD 2 2) 3 2)))
(show "D_4: is beta(w) a coboundary?" (begin (coboundary-mod-p? im3-D (bockstein D4 wD 2 2) 2)))
;; w is defined only modulo x^2 and y^2, which Sq^1 kills, so the statement that
;; survives the choice is: Sq^1 w lies in the span of (x + y) w, x^3, y^3 and not
;; in the span of x^3, y^3 alone.
(check "D_4: Sq^1 w is not a coboundary, lies in the span of (x + y) w, x^3, y^3, and not in the span of x^3, y^3"
       (begin
        (let ((sq (bockstein D4 wD 2 2))
              (xyw (vec-add-mod (cupw D4 xD wD) (cupw D4 yD wD) 2))
              (x3 (cup3 D4 xD xD xD)) (y3 (cup3 D4 yD yD yD)))
          (and (not (coboundary-mod-p? im3-D sq 2))
               (not (independent-mod-image? im3-D (list xyw x3 y3 sq) 2))
               (independent-mod-image? im3-D (list x3 y3 sq) 2)))))
(check "negative control -- a 2-cochain with a single nonzero entry on D_4 is not a cocycle"
       (not (cocycle? D4 (delta-cochain D4 2 5) 2 2)))

(display "Cohomology rings of D_4 and Q_8 over Z/2") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
