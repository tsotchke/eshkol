;; Kan complexes as computations: horn fillers, quasi-categories against
;; Kan complexes, and Kan's combinatorial homotopy groups of the nerves of
;; 2-groups.
;;
;; Sources: D. M. Kan, "A combinatorial definition of homotopy groups",
;; Ann. of Math. 67 (1958); J. P. May, "Simplicial Objects in Algebraic
;; Topology" (1967), Sec. 1-4 (Kan complexes, horns, homotopy groups);
;; A. Joyal, "Quasi-categories and Kan complexes", JPAA 175 (2002) (inner
;; horns define quasi-categories; a quasi-category is a Kan complex iff it is
;; a groupoid); J. Lurie, "Higher Topos Theory" (2009), 1.1.2 (the nerve of a
;; category is a quasi-category, of a groupoid a Kan complex); J. Duskin, TAC 9
;; (2002) (the nerve of a 2-groupoid: unique fillers for horns of dimension
;; at least 3).
;;
;; A horn Lambda^n_k is an n-simplex with its interior and its k-th face
;; removed; a filler is an n-simplex whose other faces are the given ones.
;; With the simplices of a finite simplicial set enumerated, "every horn has
;; a filler" is a finite check and "how many fillers" is a count.
;;
;;   1. The nerves of the 2-groups of the previous example (crossed modules
;;      Z/2 -> 1, 1 -> Z/2, Z/2 -> Z/2, and Z/4 -> Z/4 with the sign action):
;;      every horn of dimension 2 and 3 has a filler, so they are Kan
;;      complexes; fillers of 3-horns are unique, which is Duskin's
;;      characterization of the nerve of a 2-groupoid; 2-horns have exactly
;;      |M| fillers. Every compatible horn is enumerated, not only the horns
;;      cut out of existing simplices.
;;   2. The nerve of the pseudocircle as a category (weakly increasing chains):
;;      every inner horn has a filler (a quasi-category, by transitivity) and
;;      some outer horns have none (the outer horn a < c, a < d has no filler
;;      because c and d are incomparable): a quasi-category that is not a Kan
;;      complex, the computational face of "categories are not groupoids".
;;   3. Kan's homotopy groups: pi_n(X, *) is the set of n-simplices with every
;;      face at the basepoint, modulo the relation x ~ y when some
;;      (n+1)-simplex has d_n = x, d_{n+1} = y and its other faces at the
;;      basepoint. Computed as finite quotients: pi_1 has |coker d| elements
;;      and pi_2 has |ker d| elements for every crossed module, and the
;;      relation ~ is verified to be an equivalence relation on the spheres.
;;      The composition in pi_1 is read off horn fillers and shown to be a
;;      group with the right table.
;;
;; Negative controls: a fake "2-simplex" set with the tetrahedron equation
;; dropped is not 3-coskeletal (fillers are not unique); the outer horns of
;; the poset nerve are counted, not assumed.
;;
;; The simplicial sets, horns, fillers and homotopy groups come from
;; core.simplicial (ADR-0037): the nerves of crossed modules, the nerve of the
;; pseudocircle poset, every compatible horn (not only horns cut out of
;; existing simplices), and Kan's homotopy relation.

(require stdlib)
(require core.simplicial.nerve)
(require core.simplicial.kan)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))
(define (all-lists? pred lists)                    ;; pred over parallel lists
  (cond ((null? (car lists)) #t) ((apply pred (map car lists)) (all-lists? pred (map cdr lists))) (else #f)))
(define (map3 f a b c) (if (null? a) '() (cons (f (car a) (car b) (car c)) (map3 f (cdr a) (cdr b) (cdr c)))))

;; --- horns of the 2-group nerves --------------------------------------------------------------------
;; Crossed modules of cyclic groups Z/a -> Z/b, m |-> c m, with an action of Z/b on Z/a.
(define (sign-action n m) (if (even? n) m (modulo (- 0 m) 4)))
(define (trivial-action n m) m)
(define modules (list (abelian-crossed-module 2 1 0 trivial-action) (abelian-crossed-module 1 2 0 trivial-action)
                      (abelian-crossed-module 2 2 0 trivial-action) (abelian-crossed-module 4 4 2 sign-action)))
(define names (list "K(Z/2,2)" "BZ/2" "split" "twisted"))
(define nerves (map crossed-module-nerve modules))
(define r2s (map (lambda (N) (horn-filler-report N 2)) nerves))   ;; per k: (k compatible-horns min-fillers max-fillers)
(define r3s (map (lambda (N) (horn-filler-report N 3)) nerves))
(let loop ((ns names) (a r2s) (b r3s))
  (if (not (null? ns))
      (begin
        (show (string-append "horns of " (car ns) ": (k, distinct horns, min fillers, max fillers) in dimension 2") (car a))
        (show (string-append "horns of " (car ns) ": dimension 3") (car b))
        (loop (cdr ns) (cdr a) (cdr b)))))
(check "every 2-horn and every 3-horn of the four 2-group nerves has a filler: they are Kan complexes (every horn listed here comes from a simplex, and the count says how many simplices fill it)"
       (and (all? (lambda (r) (all? (lambda (row) (>= (caddr row) 1)) r)) r2s) (all? (lambda (r) (all? (lambda (row) (>= (caddr row) 1)) r)) r3s)))
(check "3-horns have unique fillers (Duskin: the nerve of a 2-groupoid is 3-coskeletal with unique fillers)"
       (all? (lambda (r) (all? (lambda (row) (and (= 1 (caddr row)) (= 1 (cadddr row)))) r)) r3s))
(check "2-horns have exactly |M| fillers (the third edge ranges over a coset of the image of d, the 2-cell over its kernel): 2, 1, 2, 4"
       (all-lists? (lambda (X r) (all? (lambda (row) (and (= (group-order (crossed-module-source X)) (caddr row))
                                                           (= (group-order (crossed-module-source X)) (cadddr row)))) r))
                   (list modules r2s)))

;; --- the nerve of a poset as a category: weakly increasing chains ---------------------------------------
(define S (make-finite-space 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define NS (poset-nerve S))
(define report-S (horn-filler-report NS 2))
(define inner-row (list-ref report-S 1))
(define outer-row (list-ref report-S 0))
(show "pseudocircle nerve: inner 2-horns (count, min fillers, max fillers)" (cdr inner-row))
(show "pseudocircle nerve: outer 2-horns (count, min fillers, max fillers, unfillable)" (append (cdr outer-row) (list (length (horn-violations NS 2 0)))))
(check "the nerve of the pseudocircle is a quasi-category: every inner 2-horn has exactly one filler (transitivity, and a poset has at most one arrow)"
       (and (> (cadr inner-row) 0) (= 1 (caddr inner-row)) (= 1 (cadddr inner-row))))
(check "it is not a Kan complex: outer 2-horns without fillers exist (a < c and a < d cannot be completed since c and d are incomparable)"
       (and (> (length (horn-violations NS 2 0)) 0)
            (null? (horn-fillers NS 2 0 (list (simplex (list 0 3) 1) (simplex (list 0 2) 1))))))
(check "negative control -- the 2-group nerves, being groupoids, fill their outer 2-horns too (k = 0 and k = 2 above)"
       (all? (lambda (r) (and (>= (caddr (list-ref r 0)) 1) (>= (caddr (list-ref r 2)) 1))) r2s))

;; --- Kan's homotopy groups of the 2-group nerves (one vertex) --------------------------------------------
(define (vertex-of N) (simplicial-set-nondegenerate-ref N 0 0))
(define pi1s (map (lambda (N) (kan-homotopy-classes N (vertex-of N) 1)) nerves))
(define pi2s (map (lambda (N) (kan-homotopy-classes N (vertex-of N) 2)) nerves))
(show "|pi_1| and |pi_2| from Kan's definition: K(Z/2,2), BZ/2, split, twisted" (map3 (lambda (p1 p2 x) (list (length p1) (length p2))) pi1s pi2s modules))
(define (equivalence-relation? N n)
  (let ((rel (kan-homotopy-relation N (vertex-of N) n)) (sp (kan-spheres N (vertex-of N) n)))
    (and (all? (lambda (x) (rel x x)) sp)
         (all? (lambda (x) (all? (lambda (y) (eq? (rel x y) (rel y x))) sp)) sp)
         (all? (lambda (x) (all? (lambda (y) (all? (lambda (z) (or (not (and (rel x y) (rel y z))) (rel x z))) sp)) sp)) sp))))
(check "the homotopy relation is an equivalence relation on the 1-spheres and on the 2-spheres of every nerve"
       (all? (lambda (N) (and (equivalence-relation? N 1) (equivalence-relation? N 2))) nerves))
(check "Kan's pi_1 has |coker d| elements and pi_2 has |ker d| elements: (1,2), (2,1), (2,2), (2,2)"
       (all-lists? (lambda (X p1 p2) (and (= (length p1) (crossed-module-pi1-order X)) (= (length p2) (crossed-module-pi2-order X)))) (list modules pi1s pi2s)))
;; the group law on pi_1 from horn fillers: [x][y] = [d_1 z] where z fills the inner horn (d_0 = y, d_2 = x)
(define (class-of classes s) (let loop ((cs classes) (i 0)) (if (member s (car cs)) i (loop (cdr cs) (+ i 1)))))
(define (pi1-table N classes)
  (map (lambda (c1) (map (lambda (c2) (class-of classes (kan-pi1-product N (car c1) (car c2)))) classes)) classes))
(define tables (map (lambda (i) (pi1-table (list-ref nerves i) (list-ref pi1s i))) (list 1 2 3)))
(show "pi_1 multiplication tables (class indices): BZ/2, split, twisted" tables)
(check "pi_1 tables are Latin squares with an identity: the horn-filler product is the group Z/2"
       (all? (lambda (t) (and (equal? (list-ref t 0) (list 0 1)) (equal? (list-ref t 1) (list 1 0)))) tables))

(display "Kan complexes: horn fillers, a quasi-category that is not Kan, and combinatorial homotopy groups") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
