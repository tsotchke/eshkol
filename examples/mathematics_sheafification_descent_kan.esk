;; Sheafification as a reflector and descent as a Kan extension, computed on
;; the sites of open sets of finite spaces: the canonical topology is
;; verified to satisfy the Grothendieck axioms, the sheaf condition is the
;; isomorphism F(U) -> lim over a covering sieve, the plus construction is
;; computed by its finite-site formula, sheafification is the plus
;; construction twice with its universal property verified by counting and
;; its triangle identities checked, and the matching-family limit is shown
;; to be the right Kan extension of the restricted presheaf along the
;; inclusion of the sieve, computed pointwise over a comma category as in
;; the finite-categories example.
;;
;; Sources: S. Mac Lane, I. Moerdijk, "Sheaves in Geometry and Logic" (1992),
;; III.4 (sheaves on a site, matching families), III.5 (the plus
;; construction, Theorem III.5.1: a is left adjoint to the inclusion, F^+ is
;; separated, F^{++} is a sheaf), III.7 (the sheaf condition as an
;; equalizer); P. T. Johnstone, "Sketches of an Elephant" C2.2 (sheaves
;; and Kan extensions); J. Lurie, "Higher Topos Theory" 6.2.2 (sheaves as
;; local objects), 6.5.3 (descent); M. C. McCord (1966) and J. A. Barmak
;; (LNM 2032) for the finite spaces and their Alexandrov opens.
;;
;; For a finite T_0 space the site is the poset of nonempty open sets
;; (down-sets) with a sieve on U covering when its union is U. On a finite
;; site the covering sieves of U are closed under intersection, so the plus
;; construction is F^+(U) = Match(R_min(U), F) for the smallest covering
;; sieve, and everything below is finite enumeration on exact data. Sites,
;; sieves, presheaves, matching families and the plus construction come from
;; core.sheaf; Kan extensions, the Cech equalizer, natural transformations
;; and the reflector a -| i from core.category
;; (docs/reference/stdlib/category.md).
;;
;;   1. The sites of the pseudocircle (6 opens) and the pseudo-2-sphere
;;      (9 opens): the canonical topology passes the three Grothendieck
;;      axioms, and the smallest covering sieve of every open is its cover
;;      by the maximal proper opens below it.
;;   2. Sheaf condition and descent: for the constant presheaf with value a
;;      2-element set, the matching families of the cover of the whole
;;      pseudocircle by {a, b, c} and {a, b, d} number 2 (the space is
;;      connected) while the cover of the open {a, b} by {a} and {b} has 4
;;      (two components), so the constant presheaf is separated but not a
;;      sheaf; the equalizer form of the sheaf condition (Cech form on the
;;      generating cover) gives the same counts.
;;   3. Descent as a Kan extension: for each covering sieve the right Kan
;;      extension of the restricted presheaf along the inclusion of the
;;      sieve, computed pointwise over the comma category, has at U exactly
;;      the matching families (counts equal on every open of both sites and
;;      for three presheaves); the limit over the category of the sieve
;;      gives the same families.
;;   4. Sheafification: F^+ is separated for every presheaf tested, F^{++}
;;      is a sheaf, the constant presheaf sheafifies to the locally constant
;;      sheaf with |A|^{pi_0(U)} sections, a sheaf is its own sheafification,
;;      a non-separated presheaf needs both steps, and the universal
;;      property Hom(F, G) = Hom(aF, G) for sheaves G holds by counting
;;      natural transformations on both sides, with the unit, the counit
;;      (gluing twice) and both triangle identities checked.

(require stdlib)
(require core.category.kan)
(require core.category.descent)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (range n) (iota n))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (any? pred (cdr xs)))))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))
(define (dedup xs) (let loop ((l xs) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (else (loop (cdr l) (cons (car l) acc))))))
(define (tuples k xs) (if (= k 0) (list '()) (let ((rest (tuples (- k 1) xs))) (apply append (map (lambda (x) (map (lambda (t) (cons x t)) rest)) xs)))))

;; --- sites of open sets of finite spaces ----------------------------------------------------------------------
;; the nonempty opens as down-closures of the nonempty subsets of points, in the order of their first appearance;
;; the site is the poset category of opens under inclusion with the union covering predicate
(define (space-site X)
  (let* ((n (finite-space-size X))
         (down (lambda (xs) (filter (lambda (p) (any? (lambda (x) (finite-space-leq? X p x)) xs)) (range n))))
         (os (dedup (map down (filter pair? (sheaf-subsets (range n))))))
         (ov (list->vector os))
         (C (poset-category (length os) (lambda (i j) (all? (lambda (p) (memv p (vector-ref ov j))) (vector-ref ov i))) os)))
    (make-site C (lambda (c S) (sheaf-set-equal? (dedup (apply append (map (lambda (f) (vector-ref ov (arrow-source C f))) S))) (vector-ref ov c))))))
(define XS (make-finite-space 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define XS2 (make-finite-space 6 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3) (cons 2 4) (cons 3 4) (cons 2 5) (cons 3 5))))
(define JS (space-site XS)) (define JS2 (space-site XS2))
(define CS (site-category JS)) (define CS2 (site-category JS2))
(define (site-opens C) (map (lambda (U) (category-object-label C U)) (range (category-object-count C))))
(define (open-of C U) (category-object-label C U))
(define (subset-list? A B) (all? (lambda (x) (memv x B)) A))
(define (open-arrow C V U) (category-thin-arrow C V U))     ;; the inclusion V -> U
(show "opens of the pseudocircle and the pseudo-2-sphere sites" (list (site-opens CS) (length (site-opens CS2))))
(check "the sites have 6 and 9 opens, satisfy the category laws, and the canonical topology (a sieve covers iff its union is the open) passes the three Grothendieck axioms on both"
       (and (= 6 (category-object-count CS)) (= 9 (category-object-count CS2)) (category-laws? CS) (category-laws? CS2)
            (with-region (grothendieck-topology? JS)) (with-region (grothendieck-topology? JS2))))
(define (maximal-proper-opens C U)
  (filter (lambda (V) (and (not (= V U)) (subset-list? (open-of C V) (open-of C U))
                           (not (any? (lambda (W) (and (not (= W V)) (not (= W U)) (subset-list? (open-of C V) (open-of C W)) (subset-list? (open-of C W) (open-of C U))))
                                      (range (category-object-count C))))))
          (range (category-object-count C))))
(define (generated-sieve C U Vs) (sieve-generated C U (map (lambda (V) (open-arrow C V U)) Vs)))
(define (minimal-cover J U) (site-minimal-covering-sieve J U))
(define (expected-minimal-cover J U)
  (let* ((C (site-category J)) (mp (maximal-proper-opens C U)) (g (generated-sieve C U mp)))
    (if (and (not (null? mp)) (site-covering? J U g)) g (sieve-maximal C U))))
(define (point-open? X C U) (any? (lambda (x) (equal? (open-of C U) (finite-space-down-set X x))) (open-of C U)))
(check "on both sites the smallest covering sieve of an open is generated by its maximal proper opens when they cover it and is the maximal sieve otherwise; the latter opens are exactly the minimal opens U_x of the points (4 and 6 of them)"
       (and (all? (lambda (U) (equal? (minimal-cover JS U) (expected-minimal-cover JS U))) (range 6))
            (all? (lambda (U) (equal? (minimal-cover JS2 U) (expected-minimal-cover JS2 U))) (range 9))
            (= 4 (count-if (lambda (U) (sheaf-set-equal? (minimal-cover JS U) (sieve-maximal CS U))) (range 6)))
            (= 6 (count-if (lambda (U) (sheaf-set-equal? (minimal-cover JS2 U) (sieve-maximal CS2 U))) (range 9)))
            (all? (lambda (U) (eq? (point-open? XS CS U) (sheaf-set-equal? (minimal-cover JS U) (sieve-maximal CS U)))) (range 6))))

;; --- presheaves on a site, matching families, the sheaf condition -----------------------------------------------------
;; X(U) -> Match(S, X) bijective, for one sieve
(define (sheaf-at? F U S)
  (let ((fams (matching-families F U S)) (imgs (map (lambda (x) (restriction-family F S x)) (presheaf-elements F U))))
    (and (= (length fams) (length imgs)) (= (length imgs) (length (dedup imgs))) (all? (lambda (f) (member f fams)) imgs))))
(define A2 (list 'p 'q))
(define const-S (constant-set-presheaf CS A2))
(define const-S2 (constant-set-presheaf CS2 A2))
(define top-S (category-object-of-label CS (list 0 1 2 3)))
(define ab-S (category-object-of-label CS (list 0 1)))
(define cover-top (generated-sieve CS top-S (maximal-proper-opens CS top-S)))
(define cover-ab (generated-sieve CS ab-S (maximal-proper-opens CS ab-S)))
(define (cech-count F U) (length (cech-equalizer F U (map (lambda (V) (open-arrow CS V U)) (maximal-proper-opens CS U)))))
(show "pseudocircle: matching families of the constant 2-set on the top cover and on the cover of {a,b} by {a} and {b}; Cech families on the generating covers"
      (list (length (matching-families const-S top-S cover-top)) (length (matching-families const-S ab-S cover-ab)) (cech-count const-S top-S) (cech-count const-S ab-S)))
(check "the constant presheaf is separated but not a sheaf: 2 matching families on the connected top cover (sheaf condition holds there) and 4 on the disconnected {a} u {b} (it fails), and the Cech equalizer on the generating covers gives the same counts"
       (and (presheaf-separated? JS const-S) (not (presheaf-sheaf? JS const-S)) (sheaf-at? const-S top-S cover-top) (not (sheaf-at? const-S ab-S cover-ab))
            (= 2 (length (matching-families const-S top-S cover-top))) (= 4 (length (matching-families const-S ab-S cover-ab)))
            (= 2 (cech-count const-S top-S)) (= 4 (cech-count const-S ab-S))
            (equal? (presheaf-sheaf-violations JS const-S) (presheaf-sheaf-violations-by-limit JS const-S))))

;; --- the locally constant sheaf A^{pi_0} ---------------------------------------------------------------------------------
;; sections are tuples over the components of U (finite-space-components order); a component of V lies in one
;; component of U, whose coordinate it takes
(define (components U) (finite-space-components XS U))
(define (component-of-in cV U) (let loop ((cs (components U)) (k 0)) (if (memv (car cV) (car cs)) k (loop (cdr cs) (+ k 1)))))
(define locally-constant-S
  (make-set-presheaf CS (map (lambda (U) (tuples (length (components (open-of CS U))) A2)) (range 6))
                     (lambda (a sec) (map (lambda (cV) (list-ref sec (component-of-in cV (open-of CS (arrow-target CS a)))))
                                          (components (open-of CS (arrow-source CS a)))))))
(define (pi0 X C n) (map (lambda (U) (length (finite-space-components X (open-of C U)))) (range n)))
;; --- the plus construction and sheafification on a finite site ------------------------------------------------------
(define (sizes F n) (map (lambda (U) (presheaf-element-count F U)) (range n)))
(define plusS (with-region (presheaf-plus JS const-S)))
(define aS (with-region (sheafify JS const-S)))
(show "pseudocircle: sizes of const, const^+, const^{++} on the 6 opens; pi_0 of each open" (list (sizes const-S 6) (sizes plusS 6) (sizes aS 6) (pi0 XS CS 6)))
(check "F^+ is a presheaf, separated; F^{++} is a sheaf; for the constant presheaf one step suffices (it is separated) and the sheafification has |A|^{pi_0(U)} sections on every open"
       (and (presheaf-functorial? plusS) (presheaf-separated? JS plusS) (presheaf-sheaf? JS aS) (equal? (sizes plusS 6) (sizes aS 6))
            (equal? (sizes aS 6) (map (lambda (k) (ipow 2 k)) (pi0 XS CS 6)))))
(check "the locally constant sheaf A^{pi_0} is a sheaf on the pseudocircle site and sheafification of a sheaf keeps its section counts (the unit is an isomorphism)"
       (and (presheaf-functorial? locally-constant-S) (presheaf-sheaf? JS locally-constant-S)
            (equal? (sizes (with-region (sheafify JS locally-constant-S)) 6) (sizes locally-constant-S 6))))
;; a non-separated presheaf: 2 elements on the top open that both restrict to the same element below
(define nonsep-S (make-set-presheaf CS (map (lambda (U) (if (= U top-S) (list 'u 'v) (list 'w))) (range 6))
                                    (lambda (a x) 'w)))
(define plus-nonsep (with-region (presheaf-plus JS nonsep-S)))
(define a-nonsep (with-region (sheafify JS nonsep-S)))
(show "non-separated presheaf: sizes of F, F^+, F^{++}" (list (sizes nonsep-S 6) (sizes plus-nonsep 6) (sizes a-nonsep 6)))
(check "a non-separated presheaf: F is not separated, F^+ is separated with the two top sections identified, F^{++} is a sheaf"
       (and (presheaf-functorial? nonsep-S) (not (presheaf-separated? JS nonsep-S)) (presheaf-separated? JS plus-nonsep) (presheaf-sheaf? JS a-nonsep)
            (= 1 (presheaf-element-count plus-nonsep top-S))))

;; --- descent as a right Kan extension --------------------------------------------------------------------------------
;; Ran along the inclusion j of the full subcategory on the opens of the minimal covering sieve, of X restricted
;; along j^op, at U; and the limit over the category of the sieve (core.category.descent)
(define (ran-along-sieve J X U)
  (let* ((C (site-category J)) (objs (map (lambda (f) (arrow-source C f)) (minimal-cover J U))))
    (set-functor-element-count (presheaf-ran-along-inclusion X objs) U)))
(define (descent-agrees? J X U)
  (and (= (with-region (ran-along-sieve J X U)) (length (matching-families X U (minimal-cover J U))))
       (null? (sieve-descent-violations X U (minimal-cover J U)))))
(check "descent as a Kan extension: on every open of both sites and for the constant, the locally constant and the non-separated presheaf, |Ran along the minimal covering sieve| at U equals the number of matching families"
       (and (all? (lambda (X) (all? (lambda (U) (descent-agrees? JS X U)) (range 6))) (list const-S locally-constant-S nonsep-S))
            (all? (lambda (U) (descent-agrees? JS2 const-S2 U)) (range 9))))
(define aS2 (with-region (sheafify JS2 const-S2)))
(show "pseudo-2-sphere: sizes of the sheafified constant 2-set on the 9 opens and pi_0" (list (sizes aS2 9) (pi0 XS2 CS2 9)))
(check "on the pseudo-2-sphere the constant presheaf sheafifies to |A|^{pi_0(U)} on all 9 opens and the result is a sheaf"
       (and (presheaf-sheaf? JS2 aS2) (equal? (sizes aS2 9) (map (lambda (k) (ipow 2 k)) (pi0 XS2 CS2 9)))))

;; --- the universal property and the triangle identities of a -| i -----------------------------------------------------
;; natural transformations are counted by core.category's propagating search over the elements of F; the brute-force
;; product of all component functions and the end formula Nat(F, G) = int_U G(U)^F(U) are the independent counts
(define (hom-count F G) (set-natural-transformation-count (presheaf->set-functor F) (presheaf->set-functor G)))
(define (brute-force-count F G)
  (let* ((X (presheaf->set-functor F)) (Y (presheaf->set-functor G)) (C (set-functor-category X)))
    (count-if (lambda (comps) (set-natural? X Y (list->vector (map list->vector comps))))
              (let loop ((cs (reverse (range (category-object-count C)))) (acc (list '())))
                (if (null? cs) acc
                    (loop (cdr cs) (apply append (map (lambda (f) (map (lambda (r) (cons f r)) acc))
                                                      (tuples (set-functor-element-count X (car cs)) (range (set-functor-element-count Y (car cs))))))))))))
(define uc1 (with-region (list (hom-count const-S locally-constant-S) (hom-count aS locally-constant-S))))
(check "the pruned count agrees with the brute-force enumeration on the small case Hom(const, A^pi_0)"
       (and (= (car uc1) (brute-force-count const-S locally-constant-S))
            (= (car uc1) (length (set-natural-transformations-end (presheaf->set-functor const-S) (presheaf->set-functor locally-constant-S))))))
(define uc2 (with-region (list (hom-count nonsep-S locally-constant-S) (hom-count a-nonsep locally-constant-S))))
(show "universal property counts (Hom(F, G), Hom(aF, G)) for G locally constant: constant F, non-separated F" (list uc1 uc2))
(check "a -| i: Hom(F, G) = Hom(aF, G) for the sheaf G = A^{pi_0}, for the constant presheaf and for the non-separated one"
       (and (= (car uc1) (cadr uc1)) (= (car uc2) (cadr uc2))
            (null? (with-region (sheafification-adjunction-violations JS const-S locally-constant-S)))
            (null? (with-region (sheafification-adjunction-violations JS nonsep-S locally-constant-S)))))

(display "Sheafification as a reflector and descent as a Kan extension on the sites of finite spaces") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
