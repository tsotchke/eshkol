;; Classifying spaces of finite groups, their integral homology, the
;; 3-cocycles that classify Dijkgraaf-Witten theories, and exact state sums
;; on triangulated 3-manifolds.
;;
;; Sources: R. Dijkgraaf, E. Witten, "Topological gauge theories and group
;; cohomology", Comm. Math. Phys. 129 (1990); A. Hatcher, "Algebraic
;; Topology" (2002), Sections 2.1 (Delta-complexes, simplicial homology),
;; 3A (universal coefficients), Example 1B.7 and Section 3.E (classifying
;; spaces as nerves); K. Brown, "Cohomology of Groups" (1982), Chapter I.5
;; (the bar resolution as the nerve of the one-object category).
;;
;; The chain from higher structure to physics, every link exact:
;;
;;   1. The nerve of a finite group G, as a one-object category, is a
;;      simplicial set whose n-simplices are the n-tuples of G (the bar
;;      construction).  Its geometric realization is the classifying space
;;      BG, a K(G,1).  Face maps: d_0 drops g_1, d_n drops g_n, d_i
;;      multiplies g_i g_{i+1}.
;;   2. The integral chain complex of that simplicial set has boundary
;;      matrices over Z; Smith normal form (written here over bignum
;;      integers, with the row transform tracked) gives H_n(BG; Z) with its
;;      torsion coefficients.  Checked against the known values for Z/2,
;;      Z/3, Z/2 x Z/2 and S_3.
;;   3. By universal coefficients, H^3(BG; Q/Z) = Hom(H_3(BG; Z), Q/Z), and
;;      H^3(BG; Q/Z) is the set of Dijkgraaf-Witten twists.  Explicit
;;      3-cocycles with values in Q/Z are verified as cocycles and tested
;;      for being coboundaries by an integer linear system (an argument
;;      with the Bockstein sequence shows that a coboundary in Q/Z is a
;;      coboundary with values in (1/(|G| d))Z/Z, d the denominator of the
;;      cocycle), and the number of classes found matches |H_3(BG; Z)|.
;;   4. The Dijkgraaf-Witten state sum on a branched (vertex-ordered)
;;      Delta-complex of a closed oriented 3-manifold,
;;          Z(M) = |G|^{-V} sum over flat colorings of prod_tets omega(...)^{+-1},
;;      is evaluated on S^3 (boundary of the 4-simplex), RP^3 (boundary of
;;      the 4-dimensional cross-polytope modulo the antipodal map, an
;;      order-preserving free action) and T^3 (the six-tetrahedra Kuhn
;;      triangulation of the cube with faces identified, one vertex), for
;;      G = Z/2, Z/3, Z/2 x Z/2 and each cocycle class.  Phases live in
;;      Q/Z and the sum is reduced exactly in Q(zeta_N) for N in {2,3,4}.
;;   5. Every invariant is computed by two independent routes: the state
;;      sum on the triangulation, and the algebraic formulas
;;          Z(S^3) = 1/|G|,   Z_0(M) = |Hom(pi_1 M, G)| / |G|,
;;          Z(L(2,1)) = |G|^{-1} sum_{a^2 = e} omega(a,a,a),
;;          Z(T^3) = |G|^{-1} sum_{[a,b]=[b,c]=[a,c]=e} prod_{pi in S_3} omega(a_pi1,a_pi2,a_pi3)^{sgn pi}.
;;   6. The classifying map of the nontrivial flat Z/2-connection on RP^3
;;      is realized as a simplicial map into the nerve; the image of the
;;      fundamental cycle is shown to be a 3-cycle that is NOT a boundary
;;      while twice it IS: the fundamental class of RP^3 generates
;;      H_3(BZ/2; Z) = Z/2, which is exactly why the twisted invariant of
;;      RP^3 vanishes.
;;
;; Negative controls: a non-cocycle fails the cocycle condition; the
;; trivial cocycle is a coboundary; a Smith normal form with a known wrong
;; answer is rejected; a chain that is a boundary is recognized; the wrong
;; orientation signs break Z(S^3) = 1/|G|.
;;
;; DEFECT NOTES (routed around, not fixed): `#(...)` literals promote to
;; f64 tensors (all vectors built with `vector`/`make-vector`); integer
;; powers by repeated multiplication; `make-vector` with a vector fill
;; shares the fill, so matrix rows are allocated one by one.

(require stdlib)

(define pass-count 0)
(define fail-count 0)

(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1))
             (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1))
             (display "FAIL: ") (display label) (newline))))

(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))

;; ---------------------------------------------------------------------------
;; Small exact helpers.
;; ---------------------------------------------------------------------------

(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (gcd2 a b) (if (= b 0) (abs a) (gcd2 b (remainder a b))))
(define (lcm2 a b) (quotient (abs (* a b)) (gcd2 a b)))
(define (mod1 x)
  (let ((n (numerator x)) (d (denominator x)))
    (/ (modulo n d) d)))

(define (list-sum xs) (if (null? xs) 0 (+ (car xs) (list-sum (cdr xs)))))
(define (list-max xs) (let loop ((l (cdr xs)) (m (car xs))) (if (null? l) m (loop (cdr l) (if (> (car l) m) (car l) m)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))

;; ---------------------------------------------------------------------------
;; Finite groups: (vector order mul-table inverse-table); identity is 0.
;; ---------------------------------------------------------------------------

(define (make-group n mul)
  (let ((table (make-vector n 0)) (inv (make-vector n 0)))
    (let loop ((a 0))
      (if (< a n)
          (let ((row (make-vector n 0)))
            (let inner ((b 0))
              (if (< b n)
                  (begin (vector-set! row b (mul a b))
                         (if (= 0 (mul a b)) (vector-set! inv a b))
                         (inner (+ b 1)))))
            (vector-set! table a row)
            (loop (+ a 1)))))
    (vector n table inv)))

(define (g-order G) (vector-ref G 0))
(define (g-mul G a b) (vector-ref (vector-ref (vector-ref G 1) a) b))
(define (g-inv G a) (vector-ref (vector-ref G 2) a))

(define (make-cyclic n) (make-group n (lambda (a b) (modulo (+ a b) n))))

;; Direct product; element (a, b) of G x H is a*|H| + b.
(define (group-product G H)
  (let ((m (g-order H)))
    (make-group (* (g-order G) m)
                (lambda (x y)
                  (+ (* m (g-mul G (quotient x m) (quotient y m)))
                     (g-mul H (remainder x m) (remainder y m)))))))
(define (prod-first x m) (quotient x m))
(define (prod-second x m) (remainder x m))

;; S_3 as permutations of (0 1 2), identity first.
(define s3-perms
  (list (list 0 1 2) (list 1 2 0) (list 2 0 1) (list 0 2 1) (list 2 1 0) (list 1 0 2)))
(define (perm-index p)
  (let loop ((ps s3-perms) (i 0))
    (if (equal? (car ps) p) i (loop (cdr ps) (+ i 1)))))
(define (perm-compose p q)                     ;; (p o q)(i) = p(q(i))
  (map (lambda (i) (list-ref p (list-ref q i))) (list 0 1 2)))
(define (make-s3)
  (make-group 6 (lambda (a b) (perm-index (perm-compose (list-ref s3-perms a) (list-ref s3-perms b))))))

(define (group-checks G label)
  (let ((n (g-order G)))
    (check (string-append label ": associativity, identity and inverses hold on every triple")
           (let loop-a ((a 0) (ok #t))
             (cond ((not ok) #f)
                   ((= a n) #t)
                   (else
                    (loop-a (+ a 1)
                            (and (= a (g-mul G 0 a)) (= a (g-mul G a 0))
                                 (= 0 (g-mul G a (g-inv G a)))
                                 (let loop-b ((b 0) (ok2 #t))
                                   (cond ((not ok2) #f)
                                         ((= b n) #t)
                                         (else (loop-b (+ b 1)
                                                       (let loop-c ((c 0) (ok3 #t))
                                                         (cond ((not ok3) #f)
                                                               ((= c n) #t)
                                                               (else (loop-c (+ c 1)
                                                                             (= (g-mul G (g-mul G a b) c)
                                                                                (g-mul G a (g-mul G b c)))))))))))))))))))

;; ---------------------------------------------------------------------------
;; Integer matrices as vectors of row vectors; Smith normal form.
;; ---------------------------------------------------------------------------

(define (make-matrix rows cols fill)
  (let ((M (make-vector rows 0)))
    (let loop ((i 0))
      (if (< i rows)
          (begin (vector-set! M i (make-vector cols fill)) (loop (+ i 1)))))
    M))
(define (mat-rows A) (vector-length A))
(define (mat-cols A) (if (= 0 (vector-length A)) 0 (vector-length (vector-ref A 0))))
(define (mref A i j) (vector-ref (vector-ref A i) j))
(define (mset! A i j v) (vector-set! (vector-ref A i) j v))
(define (mat-copy A)
  (let ((B (make-vector (mat-rows A) 0)))
    (let loop ((i 0))
      (if (< i (mat-rows A))
          (begin (vector-set! B i (vector-copy (vector-ref A i))) (loop (+ i 1)))))
    B))
(define (identity-matrix m)
  (let ((I (make-matrix m m 0)))
    (let loop ((i 0)) (if (< i m) (begin (mset! I i i 1) (loop (+ i 1)))))
    I))
(define (swap-rows! A i j)
  (let ((t (vector-ref A i))) (vector-set! A i (vector-ref A j)) (vector-set! A j t)))
(define (swap-cols! A i j)
  (let loop ((r 0))
    (if (< r (mat-rows A))
        (let ((t (mref A r i))) (mset! A r i (mref A r j)) (mset! A r j t) (loop (+ r 1))))))
(define (add-row! A dst src q)                 ;; row_dst += q * row_src
  (let ((rd (vector-ref A dst)) (rs (vector-ref A src)))
    (let loop ((j 0))
      (if (< j (vector-length rd))
          (begin (vector-set! rd j (+ (vector-ref rd j) (* q (vector-ref rs j)))) (loop (+ j 1)))))))
(define (add-col! A dst src q)                 ;; col_dst += q * col_src
  (let loop ((r 0))
    (if (< r (mat-rows A))
        (begin (mset! A r dst (+ (mref A r dst) (* q (mref A r src)))) (loop (+ r 1))))))
(define (negate-row! A i)
  (let ((r (vector-ref A i)))
    (let loop ((j 0))
      (if (< j (vector-length r)) (begin (vector-set! r j (- 0 (vector-ref r j))) (loop (+ j 1)))))))

;; The position of a nonzero entry of minimal absolute value in the block
;; i >= t, j >= t, or #f.
(define (find-min-pivot A t)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let loop-i ((i t) (best #f) (bi 0) (bj 0))
      (if (= i m)
          (if best (list bi bj) #f)
          (let loop-j ((j t) (best best) (bi bi) (bj bj))
            (if (= j n)
                (loop-i (+ i 1) best bi bj)
                (let ((a (abs (mref A i j))))
                  (if (and (not (= a 0)) (or (not best) (< a best)))
                      (loop-j (+ j 1) a i j)
                      (loop-j (+ j 1) best bi bj)))))))))

;; Smith normal form.  Mutates A into a diagonal matrix whose diagonal
;; entries divide successively, and mutates U (initially the identity) into
;; the accumulated row transform, so that U * A_original * V = D for some
;; unimodular V.  Returns the list of positive diagonal entries.
(define (snf! A U)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let outer ((t 0) (diag '()))
      (if (or (= t m) (= t n))
          (reverse diag)
          (let ((p (find-min-pivot A t)))
            (if (not p)
                (reverse diag)
                (begin
                  (swap-rows! A t (car p)) (swap-rows! U t (car p))
                  (swap-cols! A t (cadr p))
                  (let inner ()
                    (let ((pivot (mref A t t)) (clean #t))
                      ;; clear the column below the pivot
                      (let loop ((i (+ t 1)))
                        (if (< i m)
                            (let ((a (mref A i t)))
                              (if (not (= a 0))
                                  (let ((q (quotient a pivot)))
                                    (add-row! A i t (- 0 q)) (add-row! U i t (- 0 q))
                                    (if (not (= 0 (mref A i t))) (set! clean #f))))
                              (loop (+ i 1)))))
                      ;; clear the row right of the pivot
                      (let loop ((j (+ t 1)))
                        (if (< j n)
                            (let ((a (mref A t j)))
                              (if (not (= a 0))
                                  (let ((q (quotient a pivot)))
                                    (add-col! A j t (- 0 q))
                                    (if (not (= 0 (mref A t j))) (set! clean #f))))
                              (loop (+ j 1)))))
                      (if (not clean)
                          ;; a smaller remainder appeared in the pivot row or column: move it to the pivot
                          (let ((q (find-min-pivot A t)))
                            (swap-rows! A t (car q)) (swap-rows! U t (car q))
                            (swap-cols! A t (cadr q))
                            (inner))
                          ;; divisibility: every remaining entry must be a multiple of the pivot
                          (let ((bad (let loop-i ((i (+ t 1)))
                                       (if (= i m)
                                           #f
                                           (let loop-j ((j (+ t 1)))
                                             (if (= j n)
                                                 (loop-i (+ i 1))
                                                 (if (= 0 (remainder (mref A i j) pivot))
                                                     (loop-j (+ j 1))
                                                     (list i j))))))))
                            (if bad
                                (begin (add-row! A t (car bad) 1) (add-row! U t (car bad) 1) (inner))
                                #t)))))
                  (if (< (mref A t t) 0) (begin (negate-row! A t) (negate-row! U t)))
                  (outer (+ t 1) (cons (mref A t t) diag)))))))))

(define (snf-of A)                              ;; -> (list diag U) without touching A
  (let ((B (mat-copy A)) (U (identity-matrix (mat-rows A))))
    (let ((d (snf! B U))) (list d U))))

(define (mat-vec U z)
  (let ((m (mat-rows U)) (w (make-vector (mat-rows U) 0)))
    (let loop ((i 0))
      (if (< i m)
          (let ((r (vector-ref U i)))
            (vector-set! w i (let inner ((j 0) (s 0)) (if (= j (vector-length r)) s (inner (+ j 1) (+ s (* (vector-ref r j) (vector-ref z j)))))))
            (loop (+ i 1)))))
    w))

;; Is the integer vector z in the integer column span of A?  With U A V = D:
;; A y = z  iff  D (V^-1 y) = U z, i.e. (U z)_i divisible by d_i for i < rank
;; and zero beyond.
(define (in-span-with? snf z)
  (let* ((d (car snf)) (U (cadr snf)) (w (mat-vec U z)) (r (length d)))
    (let loop ((i 0) (ds d))
      (cond ((= i (vector-length w)) #t)
            ((< i r) (if (= 0 (remainder (vector-ref w i) (car ds))) (loop (+ i 1) (cdr ds)) #f))
            (else (if (= 0 (vector-ref w i)) (loop (+ i 1) ds) #f))))))

(define (torsion-of diag) (filter (lambda (x) (> x 1)) diag))

;; --- Smith normal form self-checks ---------------------------------------

(define (mat-from-lists rows)
  (list->vector (map (lambda (r) (list->vector r)) rows)))

(check "Smith normal form of [[2,4],[6,8]] has invariant factors (2 4)"
       (equal? (car (snf-of (mat-from-lists (list (list 2 4) (list 6 8))))) (list 2 4)))
(check "Smith normal form of diag(2,3) has invariant factors (1 6)"
       (equal? (car (snf-of (mat-from-lists (list (list 2 0) (list 0 3))))) (list 1 6)))
(check "Smith normal form of [[1,2,3],[2,4,6]] has rank 1 with factor 1"
       (equal? (car (snf-of (mat-from-lists (list (list 1 2 3) (list 2 4 6))))) (list 1)))
(check "negative control -- the invariant factors of [[2,4],[6,8]] are not (1 8)"
       (not (equal? (car (snf-of (mat-from-lists (list (list 2 4) (list 6 8))))) (list 1 8))))
(define span-test (snf-of (mat-from-lists (list (list 2 0) (list 0 4)))))
(check "integer span test: (2 4) is in the span of diag(2,4), (1 4) and (2 2) are not"
       (and (in-span-with? span-test (vector 2 4))
            (not (in-span-with? span-test (vector 1 4)))
            (not (in-span-with? span-test (vector 2 2)))))

;; ---------------------------------------------------------------------------
;; The nerve of G: n-simplices are n-tuples, index = sum g_i |G|^(i-1).
;; ---------------------------------------------------------------------------

(define (tuple->index G t)
  (let ((n (g-order G)))
    (let loop ((ts (reverse t)) (acc 0))
      (if (null? ts) acc (loop (cdr ts) (+ (* acc n) (car ts)))))))
(define (index->tuple G idx k)
  (let ((n (g-order G)))
    (let loop ((i 0) (x idx) (acc '()))
      (if (= i k) (reverse acc) (loop (+ i 1) (quotient x n) (cons (remainder x n) acc))))))

;; d_i of the tuple (g_1 ... g_k)
(define (nerve-face G t i)
  (let ((k (length t)))
    (cond ((= i 0) (cdr t))
          ((= i k) (reverse (cdr (reverse t))))
          (else (let loop ((ts t) (j 1) (acc '()))
                  (if (= j i)
                      (append (reverse acc) (cons (g-mul G (car ts) (cadr ts)) (cddr ts)))
                      (loop (cdr ts) (+ j 1) (cons (car ts) acc))))))))

;; The boundary matrix d_k : C_k -> C_{k-1}, rows indexed by (k-1)-simplices.
(define (boundary-matrix G k)
  (let* ((n (g-order G)) (rows (ipow n (- k 1))) (cols (ipow n k)) (M (make-matrix rows cols 0)))
    (let loop ((c 0))
      (if (< c cols)
          (let ((t (index->tuple G c k)))
            (let faces ((i 0) (sign 1))
              (if (<= i k)
                  (let ((r (tuple->index G (nerve-face G t i))))
                    (mset! M r c (+ (mref M r c) sign))
                    (faces (+ i 1) (- 0 sign)))))
            (loop (+ c 1)))))
    M))

(define (matrix-product A B)
  (let* ((m (mat-rows A)) (k (mat-cols A)) (n (mat-cols B)) (C (make-matrix m n 0)))
    (let loop-i ((i 0))
      (if (< i m)
          (begin
            (let loop-j ((j 0))
              (if (< j n)
                  (begin
                    (mset! C i j (let inner ((l 0) (s 0)) (if (= l k) s (inner (+ l 1) (+ s (* (mref A i l) (mref B l j)))))))
                    (loop-j (+ j 1)))))
            (loop-i (+ i 1)))))
    C))
(define (zero-matrix? A)
  (let loop-i ((i 0))
    (if (= i (mat-rows A))
        #t
        (if (let loop-j ((j 0)) (cond ((= j (mat-cols A)) #t) ((= 0 (mref A i j)) (loop-j (+ j 1))) (else #f)))
            (loop-i (+ i 1))
            #f))))

;; Homology H_k(BG; Z) for k = 0..kmax from the boundary matrices d_1..d_{kmax+1}.
;; Returns a list of (k betti torsion-list).
(define (homology-table G kmax)
  (let ((n (g-order G)))
    (let loop ((k 0) (rank-k 0) (acc '()))
      (if (> k kmax)
          (reverse acc)
          (let* ((D (boundary-matrix G (+ k 1)))
                 (s (snf-of D))
                 (rank-next (length (car s)))
                 (betti (- (ipow n k) rank-k rank-next))
                 (tors (torsion-of (car s))))
            (loop (+ k 1) rank-next (cons (list k betti tors) acc)))))))

(define (homology-row table k) (list-ref table k))

;; ---------------------------------------------------------------------------
;; Part 1: classifying spaces.
;; ---------------------------------------------------------------------------

(define Z2 (make-cyclic 2))
(define Z3 (make-cyclic 3))
(define Z2Z2 (group-product Z2 Z2))
(define S3 (make-s3))

(group-checks Z2 "Z/2")
(group-checks Z3 "Z/3")
(group-checks Z2Z2 "Z/2 x Z/2")
(group-checks S3 "S_3")
(check "S_3 is not abelian" (not (= (g-mul S3 1 3) (g-mul S3 3 1))))

(check "the nerve is a simplicial set: d d = 0 on C_4 -> C_2 for Z/2 and Z/3"
       (and (zero-matrix? (matrix-product (boundary-matrix Z2 3) (boundary-matrix Z2 4)))
            (zero-matrix? (matrix-product (boundary-matrix Z3 3) (boundary-matrix Z3 4)))))

(define H-Z2 (homology-table Z2 4))
(define H-Z3 (homology-table Z3 4))
(define H-Z2Z2 (homology-table Z2Z2 3))
(define H-S3 (homology-table S3 2))

(show "H_k(BZ/2; Z), k = 0..4  (betti, torsion)" H-Z2)
(show "H_k(BZ/3; Z), k = 0..4" H-Z3)
(show "H_k(B(Z/2 x Z/2); Z), k = 0..3" H-Z2Z2)
(show "H_k(BS_3; Z), k = 0..2" H-S3)

(check "H_*(BZ/2; Z) = Z, Z/2, 0, Z/2, 0 in degrees 0..4"
       (equal? H-Z2 (list (list 0 1 '()) (list 1 0 (list 2)) (list 2 0 '()) (list 3 0 (list 2)) (list 4 0 '()))))
(check "H_*(BZ/3; Z) = Z, Z/3, 0, Z/3, 0 in degrees 0..4"
       (equal? H-Z3 (list (list 0 1 '()) (list 1 0 (list 3)) (list 2 0 '()) (list 3 0 (list 3)) (list 4 0 '()))))
(check "H_*(B(Z/2 x Z/2); Z) = Z, (Z/2)^2, Z/2, (Z/2)^3 in degrees 0..3 (Kunneth)"
       (equal? H-Z2Z2 (list (list 0 1 '()) (list 1 0 (list 2 2)) (list 2 0 (list 2)) (list 3 0 (list 2 2 2)))))
(check "H_*(BS_3; Z) = Z, Z/2, 0 in degrees 0..2"
       (equal? H-S3 (list (list 0 1 '()) (list 1 0 (list 2)) (list 2 0 '()))))
(check "H_1(BG; Z) is the abelianization: |H_1| = |G| for the abelian groups and 2 for S_3"
       (and (= 2 (list-sum (map (lambda (x) x) (caddr (homology-row H-Z2 1)))))
            (= 3 (car (caddr (homology-row H-Z3 1))))
            (= 4 (* (car (caddr (homology-row H-Z2Z2 1))) (cadr (caddr (homology-row H-Z2Z2 1)))))
            (= 2 (car (caddr (homology-row H-S3 1))))))

(define (torsion-order tors) (if (null? tors) 1 (* (car tors) (torsion-order (cdr tors)))))
(define dw-count-Z2 (torsion-order (caddr (homology-row H-Z2 3))))
(define dw-count-Z3 (torsion-order (caddr (homology-row H-Z3 3))))
(define dw-count-Z2Z2 (torsion-order (caddr (homology-row H-Z2Z2 3))))
(show "|H^3(BG; Q/Z)| = |H_3(BG; Z)| for Z/2, Z/3, Z/2 x Z/2" (list dw-count-Z2 dw-count-Z3 dw-count-Z2Z2))

;; ---------------------------------------------------------------------------
;; Part 2: 3-cocycles with values in Q/Z.
;; ---------------------------------------------------------------------------

(define (carry n b c) (quotient (+ b c) n))            ;; 0 or 1 for b, c < n
(define (cyclic-cocycle n p)
  (lambda (a b c) (mod1 (/ (* p a (carry n b c)) n))))
;; For G = Z/2 x Z/2 (element x = 2 x1 + x2): type I on a factor, type II mixed.
(define (z2z2-cocycle p1 p2 p12)
  (lambda (a b c)
    (let ((a1 (prod-first a 2)) (a2 (prod-second a 2))
          (b1 (prod-first b 2)) (b2 (prod-second b 2))
          (c1 (prod-first c 2)) (c2 (prod-second c 2)))
      (mod1 (+ (/ (* p1 a1 (carry 2 b1 c1)) 2)
               (/ (* p2 a2 (carry 2 b2 c2)) 2)
               (/ (* p12 a1 (carry 2 b2 c2)) 2))))))
(define (trivial-cocycle a b c) 0)
(define (cocycle-sum w1 w2) (lambda (a b c) (mod1 (+ (w1 a b c) (w2 a b c)))))

(define (coboundary-value G w a b c d)
  (mod1 (+ (w b c d) (- 0 (w (g-mul G a b) c d)) (w a (g-mul G b c) d) (- 0 (w a b (g-mul G c d))) (w a b c))))
(define (cocycle? G w)
  (let ((n (g-order G)))
    (all? (lambda (a)
            (all? (lambda (b)
                    (all? (lambda (c)
                            (all? (lambda (d) (= 0 (coboundary-value G w a b c d))) (range n)))
                          (range n)))
                  (range n)))
          (range n))))

(check "mod1 reduces exactly: -1/3 -> 2/3, 5/2 -> 1/2, 3 -> 0"
       (and (= 2/3 (mod1 -1/3)) (= 1/2 (mod1 5/2)) (= 0 (mod1 3))))

(define w2 (cyclic-cocycle 2 1))
(define w3a (cyclic-cocycle 3 1))
(define w3b (cyclic-cocycle 3 2))
(define wI1 (z2z2-cocycle 1 0 0))
(define wI2 (z2z2-cocycle 0 1 0))
(define wII (z2z2-cocycle 0 0 1))

(check "the standard cocycles satisfy the 3-cocycle condition on every quadruple"
       (and (cocycle? Z2 w2) (cocycle? Z3 w3a) (cocycle? Z3 w3b)
            (cocycle? Z2Z2 wI1) (cocycle? Z2Z2 wI2) (cocycle? Z2Z2 wII)))
(check "negative control -- (a,b,c) -> ab/n is not a cocycle on Z/2 or Z/3"
       (and (not (cocycle? Z2 (lambda (a b c) (mod1 (/ (* a b) 2)))))
            (not (cocycle? Z3 (lambda (a b c) (mod1 (/ (* a b) 3)))))))

;; The coboundary matrix delta: C^2(G; Z) -> C^3(G; Z), rows indexed by
;; triples, columns by pairs, and the coboundary test against
;; [delta | N I] with N = |G| * (denominator of the cocycle).
(define (coboundary-matrix G)
  (let* ((n (g-order G)) (rows (ipow n 3)) (cols (ipow n 2)) (M (make-matrix rows cols 0)))
    (let loop ((r 0))
      (if (< r rows)
          (let* ((t (index->tuple G r 3)) (a (car t)) (b (cadr t)) (c (caddr t)))
            (let ((bump (lambda (pair sign)
                          (let ((cidx (tuple->index G pair)))
                            (mset! M r cidx (+ (mref M r cidx) sign))))))
              (bump (list b c) 1)
              (bump (list (g-mul G a b) c) -1)
              (bump (list a (g-mul G b c)) 1)
              (bump (list a b) -1))
            (loop (+ r 1)))))
    M))
(define (augmented-coboundary G N)
  (let* ((D (coboundary-matrix G)) (rows (mat-rows D)) (cols (mat-cols D)) (M (make-matrix rows (+ cols rows) 0)))
    (let loop ((i 0))
      (if (< i rows)
          (begin
            (let inner ((j 0)) (if (< j cols) (begin (mset! M i j (mref D i j)) (inner (+ j 1)))))
            (mset! M i (+ cols i) N)
            (loop (+ i 1)))))
    M))
(define (cocycle-denominator G w)
  (let ((n (g-order G)))
    (let loop ((idx 0) (d 1))
      (if (= idx (ipow n 3))
          d
          (let ((t (index->tuple G idx 3)))
            (loop (+ idx 1) (lcm2 d (denominator (w (car t) (cadr t) (caddr t))))))))))
(define (cocycle-vector G w N)
  (let* ((n (g-order G)) (v (make-vector (ipow n 3) 0)))
    (let loop ((idx 0))
      (if (< idx (ipow n 3))
          (let ((t (index->tuple G idx 3)))
            (vector-set! v idx (* N (w (car t) (cadr t) (caddr t))))
            (loop (+ idx 1)))))
    v))
;; A coboundary tester for G at level N: returns a predicate on cocycles.
(define (coboundary-tester G N)
  (let ((s (snf-of (augmented-coboundary G N))))
    (lambda (w)
      (let ((v (cocycle-vector G w N)))
        (and (all? (lambda (i) (exact? (vector-ref v i))) (range (vector-length v)))
             (all? (lambda (i) (= 1 (denominator (vector-ref v i)))) (range (vector-length v)))
             (in-span-with? s v))))))

(define cob-Z2 (coboundary-tester Z2 (* 2 (cocycle-denominator Z2 w2))))
(define cob-Z3 (coboundary-tester Z3 (* 3 (cocycle-denominator Z3 w3a))))
(define cob-Z2Z2 (coboundary-tester Z2Z2 (* 4 (cocycle-denominator Z2Z2 wII))))

(check "the trivial cocycle is a coboundary for Z/2, Z/3, Z/2 x Z/2"
       (and (cob-Z2 trivial-cocycle) (cob-Z3 trivial-cocycle) (cob-Z2Z2 trivial-cocycle)))
(check "Z/2: the twisted cocycle is not a coboundary; the classes found number |H_3(BZ/2)| = 2"
       (and (not (cob-Z2 w2)) (= 2 dw-count-Z2)))
(check "Z/3: p = 1, 2 are not coboundaries and p = 1 + 2 is; the classes found number |H_3(BZ/3)| = 3"
       (and (not (cob-Z3 w3a)) (not (cob-Z3 w3b)) (cob-Z3 (cocycle-sum w3a w3b)) (= 3 dw-count-Z3)))
(define z2z2-combos
  (list wI1 wI2 wII (cocycle-sum wI1 wI2) (cocycle-sum wI1 wII) (cocycle-sum wI2 wII)
        (cocycle-sum wI1 (cocycle-sum wI2 wII))))
(check "Z/2 x Z/2: the seven nonzero combinations of the two type-I and the type-II cocycles are not coboundaries, their doubles are; the classes number |H_3| = 8"
       (and (all? (lambda (w) (not (cob-Z2Z2 w))) z2z2-combos)
            (all? (lambda (w) (cob-Z2Z2 (cocycle-sum w w))) z2z2-combos)
            (= 8 dw-count-Z2Z2)))

;; ---------------------------------------------------------------------------
;; Part 3: branched Delta-complexes of closed oriented 3-manifolds.
;; A manifold is (vector V E tets); a tet is (list eps e01 e02 e03 e12 e13 e23).
;; ---------------------------------------------------------------------------

;; S^3 as the boundary of the 4-simplex on vertices 0..4.
(define (pair-index i j n)                      ;; i < j among n vertices
  (let loop ((a 0) (acc 0))
    (if (= a i)
        (+ acc (- j i 1))
        (loop (+ a 1) (+ acc (- n a 1))))))
(define (manifold-S3)
  (let ((tets
         (let loop ((k 0) (acc '()))
           (if (= k 5)
               (reverse acc)
               (let* ((vs (filter (lambda (v) (not (= v k))) (list 0 1 2 3 4)))
                      (v0 (list-ref vs 0)) (v1 (list-ref vs 1)) (v2 (list-ref vs 2)) (v3 (list-ref vs 3))
                      (eps (if (even? k) 1 -1)))
                 (loop (+ k 1)
                       (cons (list eps (pair-index v0 v1 5) (pair-index v0 v2 5) (pair-index v0 v3 5)
                                   (pair-index v1 v2 5) (pair-index v1 v3 5) (pair-index v2 v3 5))
                             acc)))))))
    (vector 5 10 tets)))

;; RP^3 as the boundary of the 4-dimensional cross-polytope (vertices +-e_i)
;; modulo the antipodal map.  Vertices are the labels 1..4 in their natural
;; order (preserved by the antipode, so the quotient is a Delta-complex).
;; A tetrahedron is a sign vector with s_1 = +1 (one per antipodal pair);
;; its orientation is the product of the signs; an edge is (i < j, s_i s_j).
(define (rp3-edge i j sign) (+ (* 2 (pair-index i j 4)) (if (= sign 1) 0 1)))
(define (manifold-RP3)
  (let ((tets
         (let loop ((code 0) (acc '()))
           (if (= code 8)
               (reverse acc)
               (let* ((s1 1)
                      (s2 (if (= 0 (remainder code 2)) 1 -1))
                      (s3 (if (= 0 (remainder (quotient code 2) 2)) 1 -1))
                      (s4 (if (= 0 (quotient code 4)) 1 -1))
                      (eps (* s1 s2 s3 s4)))
                 (loop (+ code 1)
                       (cons (list eps
                                   (rp3-edge 0 1 (* s1 s2)) (rp3-edge 0 2 (* s1 s3)) (rp3-edge 0 3 (* s1 s4))
                                   (rp3-edge 1 2 (* s2 s3)) (rp3-edge 1 3 (* s2 s4)) (rp3-edge 2 3 (* s3 s4)))
                             acc)))))))
    (vector 4 12 tets)))

;; T^3: the Kuhn triangulation of the cube, one tetrahedron per permutation
;; pi, vertices 0, e_pi1, e_pi1 + e_pi2, (1,1,1), orientation sgn(pi); opposite
;; faces identified, so there is one vertex and an edge per nonzero
;; difference vector d, indexed d1 + 2 d2 + 4 d3 - 1.
(define (t3-edge d) (- (+ (car d) (* 2 (cadr d)) (* 4 (caddr d))) 1))
(define (unit-vec i) (map (lambda (k) (if (= k i) 1 0)) (list 0 1 2)))
(define (vec-add u v) (map + u v))
(define (perm-sign p)
  (let ((inv (count-if (lambda (pair) (> (car pair) (cadr pair)))
                       (list (list (car p) (cadr p)) (list (car p) (caddr p)) (list (cadr p) (caddr p))))))
    (if (even? inv) 1 -1)))
(define (manifold-T3)
  (let ((tets
         (map (lambda (p)
                (let ((e1 (unit-vec (car p))) (e2 (unit-vec (cadr p))) (e3 (unit-vec (caddr p))))
                  (list (perm-sign p)
                        (t3-edge e1) (t3-edge (vec-add e1 e2)) (t3-edge (vec-add e1 (vec-add e2 e3)))
                        (t3-edge e2) (t3-edge (vec-add e2 e3)) (t3-edge e3))))
              s3-perms)))
    (vector 1 7 tets)))

(define (m-vertices M) (vector-ref M 0))
(define (m-edges M) (vector-ref M 1))
(define (m-tets M) (vector-ref M 2))
(define (tet-eps t) (list-ref t 0))
(define (tet-e t k) (list-ref t (+ k 1)))       ;; k = 0..5 for e01 e02 e03 e12 e13 e23

(check "Euler characteristic V - E + F + ... : each Delta-complex has 4 T faces counted twice, and V - E + 2T - T = 0"
       (let ((ok (lambda (M) (= 0 (+ (- (m-vertices M) (m-edges M)) (* 2 (length (m-tets M))) (- 0 (length (m-tets M))))))))
         (and (ok (manifold-S3)) (ok (manifold-RP3)) (ok (manifold-T3)))))
(check "every tetrahedron's six edges are distinct edge ids in S^3 and RP^3"
       (let ((distinct (lambda (M)
                         (all? (lambda (t)
                                 (let ((es (cdr t)))
                                   (= 6 (length (let dedup ((l es) (acc '()))
                                                  (cond ((null? l) acc)
                                                        ((memv (car l) acc) (dedup (cdr l) acc))
                                                        (else (dedup (cdr l) (cons (car l) acc)))))))))
                               (m-tets M)))))
         (and (distinct (manifold-S3)) (distinct (manifold-RP3)))))

;; Flatness constraints of a tetrahedron: (a b c) meaning g_a g_b = g_c, for
;; the faces [012], [023], [123], [013].
(define (tet-faces t)
  (list (list (tet-e t 0) (tet-e t 3) (tet-e t 1))
        (list (tet-e t 1) (tet-e t 5) (tet-e t 2))
        (list (tet-e t 3) (tet-e t 5) (tet-e t 4))
        (list (tet-e t 0) (tet-e t 4) (tet-e t 2))))

;; Group the constraints by the largest edge id they mention, so the depth-
;; first enumeration can prune as soon as a face is fully colored.
(define (faces-by-edge M)
  (let ((v (make-vector (m-edges M) '())))
    (for-each (lambda (t)
                (for-each (lambda (f)
                            (let ((e (list-max f)))
                              (vector-set! v e (cons f (vector-ref v e)))))
                          (tet-faces t)))
              (m-tets M))
    v))

(define (coloring-phase M G w col)
  (let loop ((ts (m-tets M)) (acc 0))
    (if (null? ts)
        (mod1 acc)
        (let* ((t (car ts))
               (val (w (vector-ref col (tet-e t 0)) (vector-ref col (tet-e t 3)) (vector-ref col (tet-e t 5)))))
          (loop (cdr ts) (+ acc (* (tet-eps t) val)))))))

;; All flat colorings, reported as the list of their phases (in Q/Z).
(define (flat-phases M G w)
  (let ((E (m-edges M)) (n (g-order G)) (col (make-vector (m-edges M) 0)) (fbe (faces-by-edge M)))
    (let dfs ((e 0))
      (if (= e E)
          (list (coloring-phase M G w col))
          (let loop ((g 0) (acc '()))
            (if (= g n)
                acc
                (begin
                  (vector-set! col e g)
                  (if (all? (lambda (f) (= (g-mul G (vector-ref col (car f)) (vector-ref col (cadr f)))
                                           (vector-ref col (caddr f))))
                            (vector-ref fbe e))
                      (loop (+ g 1) (append (dfs (+ e 1)) acc))
                      (loop (+ g 1) acc)))))))))

;; Exact reduction of sum_k exp(2 pi i r_k) for phases r in {0, 1/2, 1/4, 3/4,
;; 1/3, 2/3}: a triple (real, imag, zeta3-coefficient) of rationals.
(define (reduce-phases phases)
  (let loop ((ps phases) (re 0) (im 0) (ze 0))
    (if (null? ps)
        (list re im ze)
        (let ((r (car ps)))
          (cond ((= r 0) (loop (cdr ps) (+ re 1) im ze))
                ((= r 1/2) (loop (cdr ps) (- re 1) im ze))
                ((= r 1/4) (loop (cdr ps) re (+ im 1) ze))
                ((= r 3/4) (loop (cdr ps) re (- im 1) ze))
                ((= r 1/3) (loop (cdr ps) re im (+ ze 1)))
                ((= r 2/3) (loop (cdr ps) (- re 1) im (- ze 1)))
                (else (loop (cdr ps) re im (+ ze 1000000))))))))   ;; unsupported phase: poisons the check

(define (scale-triple t c) (list (* c (car t)) (* c (cadr t)) (* c (caddr t))))

;; The state sum Z(M) as an exact triple (real, imag, zeta) / |G|^V.
(define (state-sum M G w)
  (let ((phases (flat-phases M G w)))
    (scale-triple (reduce-phases phases) (/ 1 (ipow (g-order G) (m-vertices M))))))
(define (flat-count M G) (length (flat-phases M G trivial-cocycle)))
(define (real-value t) (if (and (= 0 (cadr t)) (= 0 (caddr t))) (car t) 'not-real))

;; --- Route 2: the algebraic formulas ------------------------------------------

(define (elements G) (range (g-order G)))
(define (lens2-formula G w)                     ;; Z(L(2,1)) = |G|^-1 sum_{a^2 = e} omega(a,a,a)
  (scale-triple (reduce-phases (map (lambda (a) (w a a a)) (filter (lambda (a) (= 0 (g-mul G a a))) (elements G))))
                (/ 1 (g-order G))))
(define (torus-phase G w a b c)
  (mod1 (let loop ((ps s3-perms) (acc 0))
          (if (null? ps)
              acc
              (let* ((p (car ps)) (x (list a b c))
                     (v (w (list-ref x (car p)) (list-ref x (cadr p)) (list-ref x (caddr p)))))
                (loop (cdr ps) (+ acc (* (perm-sign p) v))))))))
(define (torus-formula G w)
  (let ((commuting (lambda (x y) (= (g-mul G x y) (g-mul G y x)))))
    (scale-triple
     (reduce-phases
      (let loop-a ((a 0) (acc '()))
        (if (= a (g-order G))
            acc
            (loop-a (+ a 1)
                    (let loop-b ((b 0) (acc acc))
                      (if (= b (g-order G))
                          acc
                          (loop-b (+ b 1)
                                  (let loop-c ((c 0) (acc acc))
                                    (if (= c (g-order G))
                                        acc
                                        (loop-c (+ c 1)
                                                (if (and (commuting a b) (commuting b c) (commuting a c))
                                                    (cons (torus-phase G w a b c) acc)
                                                    acc)))))))))))
     (/ 1 (g-order G)))))

(define S3m (manifold-S3))
(define RP3m (manifold-RP3))
(define T3m (manifold-T3))

;; |Hom(pi_1, G)| for the three manifolds: pi_1 = 1, Z/2, Z^3.
(define (hom-count-S3 G) 1)
(define (hom-count-RP3 G) (count-if (lambda (a) (= 0 (g-mul G a a))) (elements G)))
(define (hom-count-T3 G)
  (let ((commuting (lambda (x y) (= (g-mul G x y) (g-mul G y x)))))
    (count-if (lambda (abc) (and (commuting (car abc) (cadr abc)) (commuting (cadr abc) (caddr abc)) (commuting (car abc) (caddr abc))))
              (let loop ((idx 0) (acc '()))
                (if (= idx (ipow (g-order G) 3)) acc (loop (+ idx 1) (cons (index->tuple G idx 3) acc)))))))

;; Untwisted: flat colorings = |Hom(pi_1, G)| |G|^(V-1), so Z_0 = |Hom(pi_1, G)| / |G|.
(define (untwisted-ok? M G hom)
  (and (= (flat-count M G) (* hom (ipow (g-order G) (- (m-vertices M) 1))))
       (= (real-value (state-sum M G trivial-cocycle)) (/ hom (g-order G)))))

(show "flat colorings on S^3, RP^3, T^3 for Z/2"
      (list (flat-count S3m Z2) (flat-count RP3m Z2) (flat-count T3m Z2)))
(check "untwisted Z(M) = |Hom(pi_1 M, G)| / |G| on S^3, RP^3, T^3 for Z/2, Z/3, Z/2 x Z/2"
       (all? (lambda (G)
               (and (untwisted-ok? S3m G (hom-count-S3 G))
                    (untwisted-ok? RP3m G (hom-count-RP3 G))
                    (untwisted-ok? T3m G (hom-count-T3 G))))
             (list Z2 Z3 Z2Z2)))

(define (s3-value G w) (real-value (state-sum S3m G w)))
(show "Z(S^3) for Z/2 twisted, Z/3 twisted, Z/2 x Z/2 type II" (list (s3-value Z2 w2) (s3-value Z3 w3a) (s3-value Z2Z2 wII)))
(check "Z(S^3) = 1/|G| for every group and cocycle: the branching and orientations are consistent"
       (and (= 1/2 (s3-value Z2 w2)) (= 1/3 (s3-value Z3 w3a)) (= 1/3 (s3-value Z3 w3b))
            (= 1/4 (s3-value Z2Z2 wII)) (= 1/4 (s3-value Z2Z2 wI1)) (= 1/4 (s3-value Z2Z2 (cocycle-sum wI1 wII)))))

(define (rp3-value G w) (real-value (state-sum RP3m G w)))
(show "Z(RP^3): Z/2 untwisted, Z/2 twisted, Z/3 twisted, Z/2 x Z/2 type II, type I"
      (list (rp3-value Z2 trivial-cocycle) (rp3-value Z2 w2) (rp3-value Z3 w3a) (rp3-value Z2Z2 wII) (rp3-value Z2Z2 wI1)))
(check "Z(RP^3) for the twisted Z/2 theory vanishes: the two flat connections contribute +1 and -1"
       (= 0 (rp3-value Z2 w2)))
(check "Z(RP^3) agrees with the lens-space formula |G|^-1 sum_{a^2=e} omega(a,a,a) for every group and cocycle"
       (and (equal? (state-sum RP3m Z2 w2) (lens2-formula Z2 w2))
            (equal? (state-sum RP3m Z2 trivial-cocycle) (lens2-formula Z2 trivial-cocycle))
            (equal? (state-sum RP3m Z3 w3a) (lens2-formula Z3 w3a))
            (all? (lambda (w) (equal? (state-sum RP3m Z2Z2 w) (lens2-formula Z2Z2 w))) z2z2-combos)))
(check "Z(RP^3) for Z/2 x Z/2 with the type-II cocycle is 1/2: the diagonal connection is the one that picks up the sign"
       (= 1/2 (rp3-value Z2Z2 wII)))

(define (t3-value G w) (real-value (state-sum T3m G w)))
(show "Z(T^3): Z/2 twisted, Z/3 twisted, Z/2 x Z/2 type II, type I + type II"
      (list (t3-value Z2 w2) (t3-value Z3 w3a) (t3-value Z2Z2 wII) (t3-value Z2Z2 (cocycle-sum wI1 wII))))
(check "Z(T^3) agrees with the commuting-triple formula for every group and cocycle"
       (and (equal? (state-sum T3m Z2 w2) (torus-formula Z2 w2))
            (equal? (state-sum T3m Z3 w3a) (torus-formula Z3 w3a))
            (equal? (state-sum T3m Z3 w3b) (torus-formula Z3 w3b))
            (all? (lambda (w) (equal? (state-sum T3m Z2Z2 w) (torus-formula Z2Z2 w))) z2z2-combos)))
(check "Z(T^3) = |G|^2 for the cyclic groups with any twist: the twisted quantum double of a cyclic group keeps |G|^2 simple objects"
       (and (= 4 (t3-value Z2 w2)) (= 9 (t3-value Z3 w3a)) (= 9 (t3-value Z3 w3b))))
(check "Z(T^3) is a positive integer for every Z/2 x Z/2 twist (it counts simple objects of the twisted double)"
       (all? (lambda (w) (let ((v (t3-value Z2Z2 w))) (and (exact? v) (= 1 (denominator v)) (> v 0)))) z2z2-combos))

;; Negative control: flipping the orientation of one tetrahedron of S^3
;; breaks the gauge invariance of the state sum.
(define S3-broken
  (vector 5 10 (cons (cons (- 0 (tet-eps (car (m-tets S3m)))) (cdr (car (m-tets S3m)))) (cdr (m-tets S3m)))))
(show "Z(S^3) for Z/3 twisted with one orientation flipped" (state-sum S3-broken Z3 w3a))
(check "negative control -- one wrong orientation sign in S^3 breaks Z(S^3) = 1/|G|"
       (not (equal? (real-value (state-sum S3-broken Z3 w3a)) 1/3)))

;; ---------------------------------------------------------------------------
;; Part 4: the classifying map RP^3 -> BZ/2 on the fundamental cycle.
;; ---------------------------------------------------------------------------

;; The flat Z/2 colorings of RP^3 with their phases; one with phase 1/2 is
;; in the nontrivial class.
(define (flat-colorings M G)
  (let ((E (m-edges M)) (n (g-order G)) (col (make-vector (m-edges M) 0)) (fbe (faces-by-edge M)))
    (let dfs ((e 0))
      (if (= e E)
          (list (vector-copy col))
          (let loop ((g 0) (acc '()))
            (if (= g n)
                acc
                (begin
                  (vector-set! col e g)
                  (if (all? (lambda (f) (= (g-mul G (vector-ref col (car f)) (vector-ref col (cadr f)))
                                           (vector-ref col (caddr f))))
                            (vector-ref fbe e))
                      (loop (+ g 1) (append (dfs (+ e 1)) acc))
                      (loop (+ g 1) acc)))))))))

(define rp3-colorings (flat-colorings RP3m Z2))
(define nontrivial-coloring
  (let loop ((cs rp3-colorings))
    (cond ((null? cs) #f)
          ((= 1/2 (coloring-phase RP3m Z2 w2 (car cs))) (car cs))
          (else (loop (cdr cs))))))
(check "RP^3 has 16 flat Z/2 colorings, 8 in each class"
       (and (= 16 (length rp3-colorings)) (= 8 (count-if (lambda (c) (= 1/2 (coloring-phase RP3m Z2 w2 c))) rp3-colorings))))

;; Push the fundamental cycle sum eps * tet forward to the nerve: each tet
;; goes to the 3-simplex (g01, g12, g23).
(define (classifying-chain M G col)
  (let ((z (make-vector (ipow (g-order G) 3) 0)))
    (for-each (lambda (t)
                (let ((idx (tuple->index G (list (vector-ref col (tet-e t 0)) (vector-ref col (tet-e t 3)) (vector-ref col (tet-e t 5))))))
                  (vector-set! z idx (+ (vector-ref z idx) (tet-eps t)))))
              (m-tets M))
    z))
(define (vec-scale v c) (vector-map (lambda (x) (* c x)) v))
(define (zero-vector? v) (all? (lambda (i) (= 0 (vector-ref v i))) (range (vector-length v))))

(define z-RP3 (classifying-chain RP3m Z2 nontrivial-coloring))
(define d3-Z2 (boundary-matrix Z2 3))
(define snf-d4-Z2 (snf-of (boundary-matrix Z2 4)))
(show "image of the fundamental cycle of RP^3 in C_3(BZ/2), coordinates indexed by (g1,g2,g3)" z-RP3)
(check "the image of the fundamental cycle is a 3-cycle of the nerve" (zero-vector? (mat-vec d3-Z2 z-RP3)))
(check "it is not a boundary: the classifying map sends [RP^3] to a nonzero class in H_3(BZ/2; Z)"
       (not (in-span-with? snf-d4-Z2 z-RP3)))
(check "twice it is a boundary: the class has order exactly 2, so [RP^3] generates H_3(BZ/2; Z) = Z/2"
       (in-span-with? snf-d4-Z2 (vec-scale z-RP3 2)))
(check "the pairing of the twisted cocycle with that class is 1/2, which is the sign that makes Z(RP^3) vanish"
       (= 1/2 (let loop ((i 0) (acc 0))
                (if (= i (vector-length z-RP3))
                    (mod1 acc)
                    (let ((t (index->tuple Z2 i 3)))
                      (loop (+ i 1) (+ acc (* (vector-ref z-RP3 i) (w2 (car t) (cadr t) (caddr t))))))))))
(check "negative control -- the trivial coloring's chain is a boundary (its class is zero)"
       (in-span-with? snf-d4-Z2 (classifying-chain RP3m Z2 (make-vector 12 0))))

;; ---------------------------------------------------------------------------

(display "Classifying spaces, group cohomology and Dijkgraaf-Witten state sums") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
