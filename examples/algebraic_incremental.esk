;; Exact maintained least-squares objective under row and parameter edits.
(require stdlib)
(require core.ad.algebraic_incremental)
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define parameters (vector (algebraic-element field 1/2) (algebraic-element field -1/3)))
(define rows (zset-from-weighted (list (list 1 (vector 1 2)) (list 1 (vector 2 -1)))))
(define plan (make-algebraic-incremental-plan field 2 2
  '(pow (- (+ (* (param 0) (row 0)) (param 1)) (row 1)) 2)))
(define state (algebraic-incremental-new plan parameters rows))
(define row-delta (zset-from-weighted (list (list -1 (vector 1 2)) (list 1 (vector 3 1)))))
(define parameter-delta (vector 1/10 -1/20))
(define result (algebraic-incremental-step state row-delta parameter-delta))
(define next-state (vector-ref result 0))
(define next-parameters (vector (algebraic-add (vector-ref parameters 0) (algebraic-element field 1/10))
                                (algebraic-add (vector-ref parameters 1) (algebraic-element field -1/20))))
(define next-rows (zset-add rows row-delta))
(define loss (algebraic-element field 0))
(define g0 (algebraic-element field 0))
(define g1 (algebraic-element field 0))
(for-each (lambda (entry)
  (let* ((weight (car entry)) (row (cadr entry))
         (residual (algebraic-sub
           (algebraic-add (algebraic-mul (vector-ref next-parameters 0) (algebraic-element field (vector-ref row 0)))
                          (vector-ref next-parameters 1))
           (algebraic-element field (vector-ref row 1)))))
    (set! loss (algebraic-add loss (algebraic-scale (algebraic-mul residual residual) weight)))
    (set! g0 (algebraic-add g0 (algebraic-scale (algebraic-mul residual (algebraic-element field (vector-ref row 0))) (* 2 weight))))
    (set! g1 (algebraic-add g1 (algebraic-scale residual (* 2 weight))))))
  (zset-entries next-rows))
(define output (algebraic-incremental-output next-state))
(if (not (and (algebraic-equal? (vector-ref output 0) loss)
              (algebraic-equal? (vector-ref (vector-ref output 1) 0) g0)
              (algebraic-equal? (vector-ref (vector-ref output 1) 1) g1)))
    (error "Incremental result differs from full exact row scan"))
(if (not (= (vector-ref (vector-ref result 2) 5) 0)) (error "Parameter tick replayed rows"))
(display "Exact loss: ") (display (algebraic-coefficients (vector-ref output 0))) (newline)
(display "Gradient: ") (display (vector (algebraic-coefficients g0) (algebraic-coefficients g1))) (newline)
(display "RESULT: PASS") (newline)
