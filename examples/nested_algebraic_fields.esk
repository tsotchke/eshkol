;; Combine two certified fields, then differentiate with independent scopes.
(require stdlib)
(require core.ad.algebraic)
(define quadratic (make-algebraic-field '(-2 0 1) 3 1))
(define cubic (make-algebraic-field '(-2 0 0 1) 7 0))
(define composition (make-algebraic-compositum quadratic cubic))
(define field (vector-ref composition 0))
(define alpha ((vector-ref composition 1) (algebraic-generator quadratic)))
(define beta ((vector-ref composition 2) (algebraic-generator cubic)))
(define (power value n)
  (let loop ((k n) (out (algebraic-element field 1)))
    (if (= k 0) out (loop (- k 1) (algebraic-mul out value)))))
(define mixed (call-with-algebraic-derivative field
  (lambda (a lift-a)
    (call-with-algebraic-derivative (algebraic-ad-context a)
      (lambda (b lift-b) (algebraic-ad-inverse (algebraic-ad-add (lift-b a) b))) beta 2)) alpha 2))
(define expected (algebraic-scale (power (algebraic-inverse (algebraic-add alpha beta)) 5) 24))
(define failures 0)
(define passes 0)
(define (check name ok)
  (if ok (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(check "certified compositum degree" (= (algebraic-field-degree field) 6))
(check "left selected generator" (= (algebraic-rational (power alpha 2)) 2))
(check "right selected generator" (= (algebraic-rational (power beta 3)) 2))
(check "primitive generator" (algebraic-equal? (algebraic-generator field) (algebraic-add alpha beta)))
(check "D_a^2 D_b^2 1/(a+b) = 24/(a+b)^5 exactly" (algebraic-equal? mixed expected))
(define moving (call-with-algebraic-derivative field
  (lambda (a lift-a)
    (let* ((outer (algebraic-ad-context a))
           (root (algebraic-ad-add a (algebraic-ad-constant outer 1)))
           (point (algebraic-ad-mul (algebraic-ad-mul root root) root)))
      (call-with-algebraic-derivative outer
        (lambda (b lift-b)
          (let ((inner (algebraic-ad-context b)))
            (algebraic-ad-root inner
              (list (algebraic-ad-sub (algebraic-ad-constant inner 0) b) 0 0 1) root))) point 2))) alpha 2))
(check "moving implicit branch retains the outer derivative"
  (algebraic-equal? moving (algebraic-scale
    (power (algebraic-inverse (algebraic-add alpha (algebraic-element field 1))) 7) -20/3)))
(check "no finite differences" (= (ad-finite-difference-evals) 0))
(display "Primitive polynomial: ") (display (algebraic-field-polynomial field)) (newline)
(display "Exact mixed derivative coefficients: ") (display (algebraic-coefficients mixed)) (newline)
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
