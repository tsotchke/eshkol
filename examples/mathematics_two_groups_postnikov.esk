;; Strict 2-groups as crossed modules, their nerves, and the Postnikov
;; k-invariant detected by cohomology: two 2-types with the same homotopy
;; groups told apart.
;;
;; Sources: J. H. C. Whitehead, "Combinatorial homotopy II", Bull. AMS 55
;; (1949) (crossed modules); R. Brown, P. J. Higgins, R. Sivera, "Nonabelian
;; Algebraic Topology" (2011), 2.5 (the classifying space of a crossed module
;; is a 2-type with pi_1 = coker, pi_2 = ker); J. Duskin, "Simplicial matrices
;; and the nerves of weak n-categories I", TAC 9 (2002) (the nerve of a
;; 2-group is 3-coskeletal: simplices are edge labels in N and triangle
;; labels in M satisfying the 2-cell equation on triangles and the
;; associativity equation on tetrahedra); J. Baez, A. Lauda, "Higher
;; dimensional algebra V: 2-groups", TAC 12 (2004), Sec. 8 (the
;; classification of 2-groups by pi_1, pi_2 and k in H^3(pi_1; pi_2), with
;; Z/4 -> Z/4 realizing the nontrivial class for pi_1 = pi_2 = Z/2); J. P.
;; May, "Simplicial Objects in Algebraic Topology" (1967), Sec. 23 (K(pi, n)
;; as cocycle complexes).
;;
;; A crossed module here is a homomorphism d: M -> N of finite abelian
;; groups with an action of N on M by automorphisms (checked, together with
;; the Peiffer identity). Its nerve is the simplicial set whose
;; n-simplices are N-labels g_{ij} on the edges of the standard n-simplex and
;; M-labels m_{ijk} on its triangles with
;;     d(m_{ijk}) = g_{ik} - g_{ij} - g_{jk}      on every triangle,
;;     m_{ijl} + g_{ij} . m_{jkl} = m_{ijk} + m_{ikl}   on every tetrahedron,
;; and faces given by deleting a vertex. The program enumerates the
;; simplices, checks the simplicial identities d_i d_j = d_{j-1} d_i, and
;; computes cohomology with Z/2 and integral coefficients.
;;
;;   1. M = Z/2, N = 1: the nerve is K(Z/2, 2) built from 2-cocycles; its mod-2
;;      cohomology through degree 3 has dimensions (1, 0, 1, 1): the
;;      fundamental class iota and Sq^1 iota, and H_2(K(Z/2,2); Z) = Z/2.
;;   2. M = 1, N = Z/2: the nerve is BZ/2, (1, 1, 1, 1).
;;   3. M = Z/2 -> N = Z/2 by zero: pi_1 = pi_2 = Z/2 with trivial
;;      k-invariant, the product BZ/2 x K(Z/2, 2): dimensions (1, 1, 2, 3), the
;;      Kunneth product of the two above.
;;   4. M = Z/4 -> N = Z/4 by multiplication by 2, with the TRIVIAL action:
;;      pi_1 = pi_2 = Z/2 but the k-invariant, computed from the crossed module
;;      by the Baez-Lauda recipe, is zero, and the nerve has the product's
;;      cohomology. With the SIGN action (odd elements of N act on M by -1) the
;;      k-invariant is the cocycle abc, the generator of H^3(BZ/2; Z/2), the
;;      Serre spectral sequence transgresses iota to it, dim H^2 drops from 2
;;      to 1, and integral H_2 drops from Z/2 to 0 as the sequence
;;      H_3(BZ/2) -> pi_2 -> H_2(X) -> H_2(BZ/2) predicts. The same homotopy
;;      groups, different spaces, and the difference is computed three ways.
;;
;; Negative controls: dropping the tetrahedron equation gives a set of
;; "3-simplices" on which the simplicial identities fail; the two nerves
;; with pi_1 = pi_2 = Z/2 have the same H^1 and the same number of
;; 1-simplices per vertex label, so degree 1 cannot tell them apart.
;;
;; Crossed modules, their nerves, the k-invariant and the (co)homology of the
;; nerves come from core.simplicial and core.homological (ADR-0037); the
;; cochain complexes are the normalized ones, which compute the same
;; cohomology as the complexes on all simplices (normalization theorem).

(require stdlib)
(require core.ring)
(require core.simplicial.nerve)
(require core.homological.simplicial)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define F2 (make-zmod 2))

;; --- the five crossed modules ------------------------------------------------------------------------
(define (trivial-action n m) m)
(define (sign-action n m) (if (even? n) m (modulo (- 0 m) 4)))
(define K22 (abelian-crossed-module 2 1 0 trivial-action))       ;; Z/2 -> 1: K(Z/2, 2)
(define BZ2 (abelian-crossed-module 1 2 0 trivial-action))       ;; 1 -> Z/2: BZ/2
(define SPLIT (abelian-crossed-module 2 2 0 trivial-action))     ;; Z/2 -> Z/2 by zero: pi_1 = pi_2 = Z/2, k = 0
(define TWIST0 (abelian-crossed-module 4 4 2 trivial-action))    ;; Z/4 -> Z/4 by 2, trivial action: k = 0 as well
(define TWIST (abelian-crossed-module 4 4 2 sign-action))        ;; Z/4 -> Z/4 by 2, odd elements act by -1: k nonzero
(check "all five are crossed modules (homomorphism, equivariance, automorphisms, Peiffer identity)"
       (all? (lambda (X) (null? (crossed-module-violations X))) (list K22 BZ2 SPLIT TWIST0 TWIST)))
(check "homotopy groups: pi_1 = coker d, pi_2 = ker d: (1,2), (2,1), (2,2), (2,2), (2,2)"
       (equal? (map (lambda (X) (list (crossed-module-pi1-order X) (crossed-module-pi2-order X))) (list K22 BZ2 SPLIT TWIST0 TWIST))
               (list (list 1 2) (list 2 1) (list 2 2) (list 2 2) (list 2 2))))
;; the k-invariant (Baez-Lauda): a 3-cocycle on pi_1 = Z/2 with values in pi_2, on the eight triples
(define triples (list (list 0 0 0) (list 0 0 1) (list 0 1 0) (list 0 1 1) (list 1 0 0) (list 1 0 1) (list 1 1 0) (list 1 1 1)))
(define (k-values X) (let ((k (cadr (crossed-module-k-invariant X)))) (map (lambda (t) (apply k t)) triples)))
(show "k-invariant values on the eight triples (a,b,c): split, twist with trivial action, twist with the sign action" (list (k-values SPLIT) (k-values TWIST0) (k-values TWIST)))
(check "the k-invariant computed from the crossed module vanishes for the split and trivial-action modules and is the cocycle abc (nonzero at (1,1,1)) for the sign action"
       (and (all? (lambda (v) (= 0 v)) (k-values SPLIT)) (all? (lambda (v) (= 0 v)) (k-values TWIST0))
            (equal? (k-values TWIST) (list 0 0 0 0 0 0 0 2))))
(check "abc is not a coboundary on Z/2 with Z/2 coefficients: it is the generator x^3 of H^3(BZ/2; Z/2)"
       ;; on the normalized bar complex of Z/2 the only nondegenerate 3-simplex is (1 1 1), where abc = 1
       (let ((C (group-cochain-complex (cyclic-group 2) 3 F2)))
         (and (homology-cycle? C 3 (vector 1)) (not (homology-boundary? C 3 (vector 1))))))

(define (all-counts X nmax) (map (lambda (n) (length (crossed-module-simplices X n))) (range (+ nmax 1))))
(show "simplex counts, degrees 0..4: K(Z/2,2)" (all-counts K22 4))
(show "simplex counts, degrees 0..4: BZ/2" (all-counts BZ2 4))
(show "simplex counts, degrees 0..4: split 2-type" (all-counts SPLIT 4))
(show "simplex counts, degrees 0..3: Z/4 -> Z/4, trivial action" (all-counts TWIST0 3))
(show "simplex counts, degrees 0..3: Z/4 -> Z/4, sign action" (all-counts TWIST 3))
(check "K(Z/2,2): the n-simplices are the Z/2-valued 2-cocycles on the n-simplex: 1, 1, 2, 8, 64"
       (equal? (all-counts K22 4) (list 1 1 2 8 64)))
(check "BZ/2: the n-simplices are the 1-cocycles, 2^n: 1, 2, 4, 8, 16" (equal? (all-counts BZ2 4) (list 1 2 4 8 16)))
(check "the split 2-type has the product counts (1, 2, 8, 64, 1024)" (equal? (all-counts SPLIT 4) (list 1 2 8 64 1024)))

(define nerve-K22 (crossed-module-nerve K22)) (define nerve-BZ2 (crossed-module-nerve BZ2)) (define nerve-SPLIT (crossed-module-nerve SPLIT))
(define nerve-TWIST0 (crossed-module-nerve TWIST0)) (define nerve-TWIST (crossed-module-nerve TWIST))
(define C2-K22 (simplicial-cochain-complex nerve-K22 3 F2)) (define C2-BZ2 (simplicial-cochain-complex nerve-BZ2 3 F2))
(define C2-SPLIT (simplicial-cochain-complex nerve-SPLIT 3 F2))
(define C2-TWIST0 (simplicial-cochain-complex nerve-TWIST0 2 F2)) (define C2-TWIST (simplicial-cochain-complex nerve-TWIST 2 F2))
(check "the simplicial identities hold: delta delta = 0 on every nerve through the computed degrees"
       (all? (lambda (C) (null? (complex-d-squared-violations C))) (list C2-K22 C2-SPLIT C2-TWIST0 C2-TWIST)))

(define (dims C) (map cadr (cohomology C)))
(define dims-K22 (dims C2-K22))
(define dims-BZ2 (dims C2-BZ2))
(define dims-SPLIT (dims C2-SPLIT))
(define dims-TWIST0 (dims C2-TWIST0))
(define dims-TWIST (dims C2-TWIST))
(show "dim H^n(-; Z/2), n = 0..3: K(Z/2,2)" dims-K22)
(show "dim H^n(-; Z/2), n = 0..3: BZ/2" dims-BZ2)
(show "dim H^n(-; Z/2), n = 0..3: split 2-type" dims-SPLIT)
(show "dim H^n(-; Z/2), n = 0..2: Z/4 -> Z/4, trivial action" dims-TWIST0)
(show "dim H^n(-; Z/2), n = 0..2: Z/4 -> Z/4, sign action" dims-TWIST)
(check "K(Z/2,2): (1, 0, 1, 1), the classes 1, iota, Sq^1 iota" (equal? dims-K22 (list 1 0 1 1)))
(check "BZ/2: (1, 1, 1, 1)" (equal? dims-BZ2 (list 1 1 1 1)))
(check "the split 2-type is the product: (1, 1, 2, 3) = Kunneth of (1,1,1,1) and (1,0,1,1)" (equal? dims-SPLIT (list 1 1 2 3)))
(check "Z/4 -> Z/4 with the trivial action has the product's dim H^2 = 2: its k-invariant is zero although the extension Z/2 -> Z/4 -> Z/2 is not split"
       (equal? dims-TWIST0 (list 1 1 2)))
(check "Z/4 -> Z/4 with the sign action has dim H^2 = 1: the transgression of iota to the nonzero k-invariant kills a class"
       (equal? dims-TWIST (list 1 1 1)))
(check "three 2-types with pi_1 = pi_2 = Z/2: two are the product and one is not, and H^2(-; Z/2) tells them apart"
       (and (equal? (list (car dims-SPLIT) (cadr dims-SPLIT) (caddr dims-SPLIT)) dims-TWIST0)
            (not (= (caddr dims-SPLIT) (caddr dims-TWIST)))
            (= (cadr dims-SPLIT) (cadr dims-TWIST))))

(define HZ-SPLIT (simplicial-homology nerve-SPLIT 2))
(define HZ-TWIST0 (simplicial-homology nerve-TWIST0 2))
(define HZ-TWIST (simplicial-homology nerve-TWIST 2))
(define HZ-K22 (simplicial-homology nerve-K22 2))
(show "H_n(-; Z), n = 0..2: K(Z/2,2)" HZ-K22)
(show "H_n(-; Z), n = 0..2: split, trivial-action twist, sign-action twist" (list HZ-SPLIT HZ-TWIST0 HZ-TWIST))
(check "H_2(K(Z/2,2); Z) = Z/2 and H_1 = 0" (equal? HZ-K22 (list (list 0 1 '()) (list 1 0 '()) (list 2 0 (list 2)))))
(check "integral H_2: Z/2 for the two products and 0 for the sign-action twist, as the sequence H_3(BZ/2) -> pi_2 -> H_2(X) -> H_2(BZ/2) = 0 predicts when the first map (the k-invariant) is an isomorphism; H_1 = Z/2 for all three"
       (and (equal? HZ-SPLIT (list (list 0 1 '()) (list 1 0 (list 2)) (list 2 0 (list 2))))
            (equal? HZ-TWIST0 HZ-SPLIT)
            (equal? HZ-TWIST (list (list 0 1 '()) (list 1 0 (list 2)) (list 2 0 '())))))

(define (expt2 b) (if (= b 0) 1 (* 2 (expt2 (- b 1)))))
;; negative control: without the tetrahedron equation the "3-simplices" do not form a simplicial set.
;; For the split 2-type (d = 0) a labelling satisfies the four triangle equations exactly when the
;; edge labels are a 1-cocycle; every triangle label is then free.
(define (loose-3-simplex-count)
  (let ((edges (list (list 0 1) (list 0 2) (list 0 3) (list 1 2) (list 1 3) (list 2 3)))
        (tris (list (list 0 1 2) (list 0 1 3) (list 0 2 3) (list 1 2 3))))
    (let loop ((code 0) (count 0))
      (if (= code 64) (* count 16)
          (let ((g (lambda (i j) (let find ((es edges) (b 0)) (if (equal? (car es) (list i j)) (remainder (quotient code (expt2 b)) 2) (find (cdr es) (+ b 1)))))))
            (loop (+ code 1)
                  (if (all? (lambda (t) (= 0 (modulo (- (g (car t) (caddr t)) (g (car t) (cadr t)) (g (cadr t) (caddr t))) 2))) tris)
                      (+ count 1) count)))))))
(check "negative control -- dropping the tetrahedron equation admits more 3-simplices for the split 2-type (128 against 64)"
       (and (= 128 (loose-3-simplex-count)) (= 64 (length (crossed-module-simplices SPLIT 3)))))
(check "negative control -- degree 1 cannot separate the 2-types: dim H^1 = 1 for all of them"
       (and (= 1 (cadr dims-SPLIT)) (= 1 (cadr dims-TWIST0)) (= 1 (cadr dims-TWIST))))

(display "Strict 2-groups: nerves of crossed modules and the k-invariant seen in H^2") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
