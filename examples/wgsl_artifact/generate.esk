;; One independent dimensionless strain e.  a=2 Pa and b=3 are held fixed.
;; Reference e0=0, normalization t=(e-e0)/1, envelope |t|<=0.2.
;; Ascending Taylor coefficients: W(t)=sum c[k]*t^k, k=0..10.
(define a 2.0)
(define b 3.0)
(define e0 0.0)
(define radius 0.2)
(define order 10)
(define (potential e) (* (/ a b) (- (exp (* b e)) 1.0 (* b e))))
(define coefficients (taylor potential e0 order))
(define (derive cs)
  (let loop ((k 0) (rest (cdr cs)) (out '()))
    (if (null? rest) (reverse out)
        (loop (+ k 1) (cdr rest) (cons (* (+ k 1) (car rest)) out)))))
(define first-coefficients (derive coefficients))
(define second-coefficients (derive first-coefficients))
(define (horner cs t)
  (let loop ((rev (reverse cs)) (acc 0.0))
    (if (null? rev) acc (loop (cdr rev) (+ (* acc t) (car rev))))))
(define (has-char str ch)
  (let loop ((i 0))
    (cond ((= i (string-length str)) #f)
          ((char=? (string-ref str i) ch) #t)
          (else (loop (+ i 1))))))
(define (wgsl-num x)
  (let ((s (number->string (exact->inexact x))))
    (if (or (has-char s #\.) (has-char s #\e)) s (string-append s ".0"))))
(define (coefficient-list cs)
  (if (null? cs) ""
      (if (null? (cdr cs)) (wgsl-num (car cs))
          (string-append (wgsl-num (car cs)) "," (coefficient-list (cdr cs))))))
(define (horner-expr cs)
  (if (null? (cdr cs)) (wgsl-num (car cs))
      (string-append (wgsl-num (car cs)) " + t * (" (horner-expr (cdr cs)) ")")))
(define (eval-fn name cs)
  (string-append "fn " name "(t: f32) -> f32 { return " (horner-expr cs) "; }\n"))
(define (max-error f g)
  (let loop ((i 0) (worst 0.0))
    (if (> i 40) worst
        (let* ((x (- (* (/ i 40.0) 0.4) radius))
               (err (abs (- (f x) (g x)))))
          (loop (+ i 1) (if (> err worst) err worst))))))
(define err-value (max-error potential (lambda (x) (horner coefficients x))))
(define err-first (max-error (lambda (x) (derivative potential x))
                              (lambda (x) (horner first-coefficients x))))
(define err-second (max-error (lambda (x) (derivative-n potential x 2))
                               (lambda (x) (horner second-coefficients x))))
(display "// artifact-schema: 1\n")
(display "// coefficients-ascending: ") (display (coefficient-list coefficients)) (newline)
(display "// first-ascending: ") (display (coefficient-list first-coefficients)) (newline)
(display "// second-ascending: ") (display (coefficient-list second-coefficients)) (newline)
(display "// ad-grid-max-errors: ") (display (coefficient-list (list err-value err-first err-second))) (newline)
(display "// wgsl-begin\n")
(display "struct Params { count: u32, generation: u32, pad0: u32, pad1: u32 };\n")
(display "struct Sample { strain: f32 };\n")
(display "struct Result { value: f32, first: f32, second: f32, in_envelope: u32, status: u32, generation: u32, pad0: u32, pad1: u32 };\n")
(display "@group(0) @binding(0) var<storage, read> params: Params;\n")
(display "@group(0) @binding(1) var<storage, read> samples: array<Sample>;\n")
(display "@group(0) @binding(2) var<storage, read_write> results: array<Result>;\n")
(display (eval-fn "law_value" coefficients))
(display (eval-fn "law_first" first-coefficients))
(display (eval-fn "law_second" second-coefficients))
(display "@compute @workgroup_size(64) fn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n")
(display "  let i = gid.x; if (i >= 4096u || i >= params.count || i >= arrayLength(&samples) || i >= arrayLength(&results)) { return; }\n")
(display "  let t = samples[i].strain; let inside = abs(t) <= 0.2;\n")
(display "  if (!inside) { results[i] = Result(0.0, 0.0, 0.0, 0u, 1u, params.generation, 0u, 0u); return; }\n")
(display "  let v = law_value(t); let d = law_first(t); let s = law_second(t);\n")
(display "  let finite = abs(v) < 1e30 && abs(d) < 1e30 && abs(s) < 1e30;\n")
(display "  results[i] = Result(select(0.0, v, finite), select(0.0, d, finite), select(0.0, s, finite), 1u, select(2u, 0u, finite), params.generation, 0u, 0u);\n")
(display "}\n")
(display "// wgsl-end\n")
(display (if (and (< err-value 1e-9) (< err-first 1e-8) (< err-second 1e-6))
             "AD_MODEL_PASS" "AD_MODEL_FAIL")) (newline)
