;; Aoki's p-standard cycles on Fermat surfaces of composite degree, as a
;; sweep: for the Fermat surface X_m^2 the character supports of the lines,
;; of Aoki's p = 2 curves (m even) and of the p = 3 curves (3 | m) are
;; computed from the Jacobian determinant of the period formula, and the
;; number of Hodge characters left uncovered is written to a JSON receipt.
;; Aoki proves that for prime-power m these cycles generate the Neron-Severi
;; group over Q; for composite m his Theorem 1-3 also needs semi-standard
;; elements, for which no explicit subvariety is known "except for a few
;; cases". The receipt measures that residual exactly, degree by degree.
;;
;;   MATH_FERMAT_DEGREE   m >= 4 (default 8); the sweep is informative for
;;                        m even or divisible by 3
;;
;; Sources: as in the sibling example on the sextic (Villaflor 2022, Aoki
;; 1987, Shioda 1979, Griffiths 1969). Towers: lines x_0 - eps x_1 = 0,
;; x_2 - eps x_3 = 0 need eps = zeta_{2m} (eps^m = -1 for every m);
;; the p = 2 curve x_0^d + x_1^d + i x_2^d = 0, x_3^2 = c x_0 x_1 needs c with
;; c^d = 2 (d = m/2); the p = 3 curve x_0^d + x_1^d + x_2^d = 0, x_3^3 =
;; eps^3 c x_0 x_1 x_2 needs c with c^d = 3 (d = m/3). Each support is
;; computed in its own tower Q(zeta_{2m})[c]/(c^d - p). F = f_1 g_1 + f_2 g_2
;; is verified as a polynomial identity before any support is read off.
;;
;; DEFECT NOTES (routed around): as in the sibling examples.

(require stdlib)

(define (ipow b n) (if (= n 0) 1 (* b (ipow b (- n 1)))))
(define (range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (count-if pred xs) (let loop ((l xs) (c 0)) (cond ((null? l) c) ((pred (car l)) (loop (cdr l) (+ c 1))) (else (loop (cdr l) c)))))
(define (product xs) (if (null? xs) 1 (* (car xs) (product (cdr xs)))))
(define (last-of l) (if (null? (cdr l)) (car l) (last-of (cdr l))))
(define (but-last l) (reverse (cdr (reverse l))))
(define (remove-nth l i) (let loop ((l l) (k 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ k 1) (if (= k i) acc (cons (car l) acc))))))
(define (make-matrix rows cols) (let ((M (make-vector rows 0))) (let loop ((i 0)) (if (< i rows) (begin (vector-set! M i (make-vector cols 0)) (loop (+ i 1))))) M))
(define (mat-rows A) (vector-length A))
(define (mat-cols A) (if (= 0 (vector-length A)) 0 (vector-length (vector-ref A 0))))
(define (mref A i j) (vector-ref (vector-ref A i) j))
(define (mset! A i j v) (vector-set! (vector-ref A i) j v))
(define (mat-copy A) (let ((B (make-vector (mat-rows A) 0))) (let loop ((i 0)) (if (< i (mat-rows A)) (begin (vector-set! B i (vector-copy (vector-ref A i))) (loop (+ i 1))))) B))
(define (identity-matrix m) (let ((I (make-matrix m m))) (let loop ((i 0)) (if (< i m) (begin (mset! I i i 1) (loop (+ i 1))))) I))
(define (swap-rows! A i j) (let ((t (vector-ref A i))) (vector-set! A i (vector-ref A j)) (vector-set! A j t)))
(define (swap-cols! A i j) (let loop ((r 0)) (if (< r (mat-rows A)) (let ((t (mref A r i))) (mset! A r i (mref A r j)) (mset! A r j t) (loop (+ r 1))))))
(define (add-row! A dst src q) (let ((rd (vector-ref A dst)) (rs (vector-ref A src))) (let loop ((j 0)) (if (< j (vector-length rd)) (begin (if (not (= 0 (vector-ref rs j))) (vector-set! rd j (+ (vector-ref rd j) (* q (vector-ref rs j))))) (loop (+ j 1)))))))
(define (add-col! A dst src q) (let loop ((r 0)) (if (< r (mat-rows A)) (begin (if (not (= 0 (mref A r src))) (mset! A r dst (+ (mref A r dst) (* q (mref A r src))))) (loop (+ r 1))))))
(define (negate-row! A i) (let ((r (vector-ref A i))) (let loop ((j 0)) (if (< j (vector-length r)) (begin (vector-set! r j (- 0 (vector-ref r j))) (loop (+ j 1)))))))
(define (find-pivot A t)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let loop-i ((i t) (best #f) (bi 0) (bj 0))
      (if (= i m) (if best (list bi bj) #f)
          (let loop-j ((j t) (best best) (bi bi) (bj bj))
            (if (= j n) (loop-i (+ i 1) best bi bj)
                (let ((a (abs (mref A i j))))
                  (cond ((= a 1) (list i j))
                        ((and (not (= a 0)) (or (not best) (< a best))) (loop-j (+ j 1) a i j))
                        (else (loop-j (+ j 1) best bi bj))))))))))
;; U A V = D; U and V accumulate the row and column operations. Returns the diagonal.
(define (snf! A U V)
  (let ((m (mat-rows A)) (n (mat-cols A)))
    (let outer ((t 0) (diag '()))
      (if (or (= t m) (= t n)) (reverse diag)
          (let ((p (find-pivot A t)))
            (if (not p) (reverse diag)
                (begin
                  (swap-rows! A t (car p)) (swap-rows! U t (car p)) (swap-cols! A t (cadr p)) (swap-cols! V t (cadr p))
                  (let inner ()
                    (let ((pivot (mref A t t)) (clean #t))
                      (let loop ((i (+ t 1))) (if (< i m) (let ((a (mref A i t))) (if (not (= a 0)) (let ((q (quotient a pivot))) (add-row! A i t (- 0 q)) (add-row! U i t (- 0 q)) (if (not (= 0 (mref A i t))) (set! clean #f)))) (loop (+ i 1)))))
                      (let loop ((j (+ t 1))) (if (< j n) (let ((a (mref A t j))) (if (not (= a 0)) (let ((q (quotient a pivot))) (add-col! A j t (- 0 q)) (add-col! V j t (- 0 q)) (if (not (= 0 (mref A t j))) (set! clean #f)))) (loop (+ j 1)))))
                      (if (not clean)
                          (let ((q (find-pivot A t))) (swap-rows! A t (car q)) (swap-rows! U t (car q)) (swap-cols! A t (cadr q)) (swap-cols! V t (cadr q)) (inner))
                          (let ((bad (let loop-i ((i (+ t 1))) (if (= i m) #f (let loop-j ((j (+ t 1))) (if (= j n) (loop-i (+ i 1)) (if (= 0 (remainder (mref A i j) pivot)) (loop-j (+ j 1)) (list i j))))))))
                            (if bad (begin (add-row! A t (car bad) 1) (add-row! U t (car bad) 1) (inner)) #t)))))
                  (if (< (mref A t t) 0) (begin (negate-row! A t) (negate-row! U t)))
                  (outer (+ t 1) (cons (mref A t t) diag)))))))))
(define (snf-full A)                             ;; -> (list diag U V) leaving A intact
  (let* ((B (mat-copy A)) (U (identity-matrix (mat-rows A))) (V (identity-matrix (mat-cols A))) (d (snf! B U V))) (list d U V)))
(define (torsion-of d) (filter (lambda (x) (> x 1)) d))
(define (mat-vec M z) (let ((w (make-vector (mat-rows M) 0))) (let loop ((i 0)) (if (< i (mat-rows M)) (let ((r (vector-ref M i))) (vector-set! w i (let inner ((j 0) (s 0)) (if (= j (vector-length r)) s (inner (+ j 1) (+ s (* (vector-ref r j) (vector-ref z j))))))) (loop (+ i 1))))) w))
(define (mat-col M j) (let ((v (make-vector (mat-rows M) 0))) (let loop ((i 0)) (if (< i (mat-rows M)) (begin (vector-set! v i (mref M i j)) (loop (+ i 1))))) v))
;; integer kernel basis of A: the last (cols - rank) columns of V
(define (integer-kernel A)
  (let* ((s (snf-full A)) (r (length (car s))) (V (caddr s)) (n (mat-cols A)))
    (let loop ((j (- n 1)) (acc '())) (if (< j r) acc (loop (- j 1) (cons (mat-col V j) acc))))))
;; solve B y = v for integer y given B's columns are a basis (B has full column rank): y = V D^-1 U v
(define (solve-in-basis snf ncols v)
  (let* ((d (car snf)) (U (cadr snf)) (V (caddr snf)) (w (mat-vec U v)) (y0 (make-vector ncols 0)))
    (let loop ((i 0) (ds d))
      (if (< i (length d))
          (begin (if (not (= 0 (remainder (vector-ref w i) (car ds)))) (error "not in the span")) (vector-set! y0 i (quotient (vector-ref w i) (car ds))) (loop (+ i 1) (cdr ds)))))
    (let loop ((i (length d))) (if (< i (vector-length w)) (begin (if (not (= 0 (vector-ref w i))) (error "not in the span")) (loop (+ i 1)))))
    (mat-vec V y0)))
(define (matrix-from-columns cols nrows) (let ((M (make-matrix nrows (length cols)))) (let loop ((cs cols) (j 0)) (if (not (null? cs)) (begin (let fill ((i 0)) (if (< i nrows) (begin (mset! M i j (vector-ref (car cs) i)) (fill (+ i 1))))) (loop (cdr cs) (+ j 1))))) M))
(define (cohomology-from-matrices dims Ds)
  (let loop ((k 0) (ds Ds) (dims dims) (rank-prev 0) (prev #f) (acc '()))
    (if (null? ds) (reverse acc)
        (let* ((D (car ds)) (dim-k (car dims))
               (rank-k (if (or (= 0 (mat-rows D)) (= 0 (mat-cols D))) 0 (length (car (snf-full D)))))
               (betti (- dim-k rank-prev rank-k))
               (tors (if (and prev (> (mat-rows prev) 0) (> (mat-cols prev) 0)) (torsion-of (car (snf-full prev))) '())))
          (loop (+ k 1) (cdr ds) (cdr dims) rank-k D (cons (list k betti tors) acc))))))
(define (any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (any? pred (cdr xs)))))
(define (sum xs) (let loop ((l xs) (s 0)) (if (null? l) s (loop (cdr l) (+ s (car l))))))
(define (all2? pred xs ys) (cond ((null? xs) #t) ((pred (car xs) (car ys)) (all2? pred (cdr xs) (cdr ys))) (else #f)))
(define (map3 f xs ys zs) (if (null? xs) '() (cons (f (car xs) (car ys) (car zs)) (map3 f (cdr xs) (cdr ys) (cdr zs)))))
(define (rpow b n) (if (< n 0) (/ 1 (ipow b (- 0 n))) (ipow b n)))
(define (gcd2 a b) (if (= b 0) (abs a) (gcd2 b (remainder a b))))
(define (cartesian lists) (if (null? lists) (list '()) (let ((rest (cartesian (cdr lists)))) (let loop ((xs (car lists)) (acc '())) (if (null? xs) acc (loop (cdr xs) (append (map (lambda (t) (cons (car xs) t)) rest) acc)))))))
(define (dedup xs) (let loop ((l xs) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (else (loop (cdr l) (cons (car l) acc))))))
(define (position-of item items) (let loop ((l items) (i 0)) (cond ((null? l) #f) ((equal? (car l) item) i) (else (loop (cdr l) (+ i 1))))))

;; --- Q(zeta_n) on exact rationals, n composite ----------------------------------------------------------
;; integer polynomials as vectors of coefficients (low degree first)
(define (poly-trim v) (let loop ((n (vector-length v))) (if (and (> n 1) (= 0 (vector-ref v (- n 1)))) (loop (- n 1)) (let ((w (make-vector n 0))) (let cp ((i 0)) (if (< i n) (begin (vector-set! w i (vector-ref v i)) (cp (+ i 1))))) w))))
(define (poly-mul a b)
  (let ((v (make-vector (+ (vector-length a) (vector-length b) -1) 0)))
    (let li ((i 0)) (if (< i (vector-length a)) (begin (let lj ((j 0)) (if (< j (vector-length b)) (begin (vector-set! v (+ i j) (+ (vector-ref v (+ i j)) (* (vector-ref a i) (vector-ref b j)))) (lj (+ j 1))))) (li (+ i 1)))))
    v))
(define (poly-divmod a b)                        ;; a = q b + r, b monic; returns (q . r) with r of length < deg b + 1
  (let* ((a (poly-trim a)) (b (poly-trim b)) (da (- (vector-length a) 1)) (db (- (vector-length b) 1)))
    (if (< da db) (cons (vector 0) a)
        (let ((r (let ((w (make-vector (+ da 1) 0))) (let cp ((i 0)) (if (<= i da) (begin (vector-set! w i (vector-ref a i)) (cp (+ i 1))))) w))
              (q (make-vector (+ (- da db) 1) 0)))
          (let loop ((k (- da db)))
            (if (>= k 0)
                (let ((c (vector-ref r (+ k db))))
                  (vector-set! q k c)
                  (if (not (= 0 c)) (let sub ((j 0)) (if (<= j db) (begin (vector-set! r (+ k j) (- (vector-ref r (+ k j)) (* c (vector-ref b j)))) (sub (+ j 1))))))
                  (loop (- k 1)))))
          (cons q (let ((w (make-vector (if (= db 0) 1 db) 0))) (let cp ((i 0)) (if (< i (vector-length w)) (begin (vector-set! w i (vector-ref r i)) (cp (+ i 1))))) w))))))
(define (divisors n) (filter (lambda (d) (= 0 (modulo n d))) (cdr (range (+ n 1)))))
(define (cyclotomic-poly n)                      ;; Phi_n = (x^n - 1) / prod_{d | n, d < n} Phi_d
  (if (= n 1) (vector -1 1)
      (let ((num (let ((v (make-vector (+ n 1) 0))) (vector-set! v 0 -1) (vector-set! v n 1) v)))
        (let loop ((ds (filter (lambda (d) (< d n)) (divisors n))) (acc num))
          (if (null? ds) (poly-trim acc)
              (loop (cdr ds) (car (poly-divmod acc (cyclotomic-poly (car ds))))))))))
;; a field is (vector n phi Phi); elements are vectors of phi rationals on 1, x, ..., x^(phi-1), x = zeta_n
(define (make-field n) (let ((Phi (cyclotomic-poly n))) (vector n (- (vector-length Phi) 1) Phi)))
(define (f-n F) (vector-ref F 0)) (define (f-deg F) (vector-ref F 1)) (define (f-Phi F) (vector-ref F 2))
(define (f-zero F) (make-vector (f-deg F) 0))
(define (f-one F) (let ((v (f-zero F))) (vector-set! v 0 1) v))
(define (f-reduce F v)                           ;; reduce a coefficient vector of any length mod Phi
  (let ((r (cdr (poly-divmod v (f-Phi F)))) (w (f-zero F)))
    (let cp ((i 0)) (if (and (< i (vector-length r)) (< i (f-deg F))) (begin (vector-set! w i (vector-ref r i)) (cp (+ i 1)))))
    w))
(define (f-zeta-power F k) (let ((k (modulo k (f-n F)))) (let ((v (make-vector (+ k 1) 0))) (vector-set! v k 1) (f-reduce F v))))
(define (f-add a b) (let ((v (make-vector (vector-length a) 0))) (let loop ((i 0)) (if (< i (vector-length a)) (begin (vector-set! v i (+ (vector-ref a i) (vector-ref b i))) (loop (+ i 1))))) v))
(define (f-sub a b) (let ((v (make-vector (vector-length a) 0))) (let loop ((i 0)) (if (< i (vector-length a)) (begin (vector-set! v i (- (vector-ref a i) (vector-ref b i))) (loop (+ i 1))))) v))
(define (f-scale a c) (let ((v (make-vector (vector-length a) 0))) (let loop ((i 0)) (if (< i (vector-length a)) (begin (vector-set! v i (* c (vector-ref a i))) (loop (+ i 1))))) v))
(define (f-mul F a b) (f-reduce F (poly-mul a b)))
(define (f-zero? a) (all? (lambda (i) (= 0 (vector-ref a i))) (range (vector-length a))))
(define (f-equal? a b) (f-zero? (f-sub a b)))
(define (f-rational a) (and (all? (lambda (i) (= 0 (vector-ref a i))) (cdr (range (vector-length a)))) (vector-ref a 0)))
(define (f-inv F a)                              ;; solve sum_j x_j (a x^j) = 1
  (let* ((n (f-deg F)) (cols (map (lambda (j) (f-mul F a (f-zeta-power F j))) (range n))) (M (make-vector n 0)))
    (let loop ((i 0)) (if (< i n) (begin (vector-set! M i (let ((row (make-vector (+ n 1) 0))) (let fill ((j 0) (cs cols)) (if (< j n) (begin (vector-set! row j (vector-ref (car cs) i)) (fill (+ j 1) (cdr cs))))) (vector-set! row n (if (= i 0) 1 0)) row)) (loop (+ i 1)))))
    (let elim ((c 0))
      (if (< c n)
          (let ((piv (let find ((r c)) (cond ((= r n) (error "not invertible")) ((not (= 0 (vector-ref (vector-ref M r) c))) r) (else (find (+ r 1)))))))
            (let ((t (vector-ref M c))) (vector-set! M c (vector-ref M piv)) (vector-set! M piv t))
            (let* ((prow (vector-ref M c)) (inv (/ 1 (vector-ref prow c))))
              (let norm ((j 0)) (if (<= j n) (begin (vector-set! prow j (* inv (vector-ref prow j))) (norm (+ j 1)))))
              (let rows ((r 0))
                (if (< r n)
                    (begin (if (and (not (= r c)) (not (= 0 (vector-ref (vector-ref M r) c))))
                               (let ((f (vector-ref (vector-ref M r) c)) (row (vector-ref M r)))
                                 (let sub ((j 0)) (if (<= j n) (begin (vector-set! row j (- (vector-ref row j) (* f (vector-ref prow j)))) (sub (+ j 1)))))))
                           (rows (+ r 1))))))
            (elim (+ c 1)))))
    (let ((x (f-zero F))) (let loop ((i 0)) (if (< i n) (begin (vector-set! x i (vector-ref (vector-ref M i) n)) (loop (+ i 1))))) x)))
(define (f-product F xs) (let loop ((l xs) (acc (f-one F))) (if (null? l) acc (loop (cdr l) (f-mul F acc (car l))))))
;; --- Q(zeta_n) on exact rationals, n composite ----------------------------------------------------------
;; integer polynomials as vectors of coefficients (low degree first)
(define (poly-trim v) (let loop ((n (vector-length v))) (if (and (> n 1) (= 0 (vector-ref v (- n 1)))) (loop (- n 1)) (let ((w (make-vector n 0))) (let cp ((i 0)) (if (< i n) (begin (vector-set! w i (vector-ref v i)) (cp (+ i 1))))) w))))
(define (poly-mul a b)
  (let ((v (make-vector (+ (vector-length a) (vector-length b) -1) 0)))
    (let li ((i 0)) (if (< i (vector-length a)) (begin (let lj ((j 0)) (if (< j (vector-length b)) (begin (vector-set! v (+ i j) (+ (vector-ref v (+ i j)) (* (vector-ref a i) (vector-ref b j)))) (lj (+ j 1))))) (li (+ i 1)))))
    v))
(define (poly-divmod a b)                        ;; a = q b + r, b monic; returns (q . r) with r of length < deg b + 1
  (let* ((a (poly-trim a)) (b (poly-trim b)) (da (- (vector-length a) 1)) (db (- (vector-length b) 1)))
    (if (< da db) (cons (vector 0) a)
        (let ((r (let ((w (make-vector (+ da 1) 0))) (let cp ((i 0)) (if (<= i da) (begin (vector-set! w i (vector-ref a i)) (cp (+ i 1))))) w))
              (q (make-vector (+ (- da db) 1) 0)))
          (let loop ((k (- da db)))
            (if (>= k 0)
                (let ((c (vector-ref r (+ k db))))
                  (vector-set! q k c)
                  (if (not (= 0 c)) (let sub ((j 0)) (if (<= j db) (begin (vector-set! r (+ k j) (- (vector-ref r (+ k j)) (* c (vector-ref b j)))) (sub (+ j 1))))))
                  (loop (- k 1)))))
          (cons q (let ((w (make-vector (if (= db 0) 1 db) 0))) (let cp ((i 0)) (if (< i (vector-length w)) (begin (vector-set! w i (vector-ref r i)) (cp (+ i 1))))) w))))))
(define (divisors n) (filter (lambda (d) (= 0 (modulo n d))) (cdr (range (+ n 1)))))
(define (cyclotomic-poly n)                      ;; Phi_n = (x^n - 1) / prod_{d | n, d < n} Phi_d
  (if (= n 1) (vector -1 1)
      (let ((num (let ((v (make-vector (+ n 1) 0))) (vector-set! v 0 -1) (vector-set! v n 1) v)))
        (let loop ((ds (filter (lambda (d) (< d n)) (divisors n))) (acc num))
          (if (null? ds) (poly-trim acc)
              (loop (cdr ds) (car (poly-divmod acc (cyclotomic-poly (car ds))))))))))
;; a field is (vector n phi Phi); elements are vectors of phi rationals on 1, x, ..., x^(phi-1), x = zeta_n
(define (make-field n) (let ((Phi (cyclotomic-poly n))) (vector n (- (vector-length Phi) 1) Phi)))
(define (f-n F) (vector-ref F 0)) (define (f-deg F) (vector-ref F 1)) (define (f-Phi F) (vector-ref F 2))
(define (f-zero F) (make-vector (f-deg F) 0))
(define (f-one F) (let ((v (f-zero F))) (vector-set! v 0 1) v))
(define (f-reduce F v)                           ;; reduce a coefficient vector of any length mod Phi
  (let ((r (cdr (poly-divmod v (f-Phi F)))) (w (f-zero F)))
    (let cp ((i 0)) (if (and (< i (vector-length r)) (< i (f-deg F))) (begin (vector-set! w i (vector-ref r i)) (cp (+ i 1)))))
    w))
(define (f-zeta-power F k) (let ((k (modulo k (f-n F)))) (let ((v (make-vector (+ k 1) 0))) (vector-set! v k 1) (f-reduce F v))))
(define (f-add a b) (let ((v (make-vector (vector-length a) 0))) (let loop ((i 0)) (if (< i (vector-length a)) (begin (vector-set! v i (+ (vector-ref a i) (vector-ref b i))) (loop (+ i 1))))) v))
(define (f-sub a b) (let ((v (make-vector (vector-length a) 0))) (let loop ((i 0)) (if (< i (vector-length a)) (begin (vector-set! v i (- (vector-ref a i) (vector-ref b i))) (loop (+ i 1))))) v))
(define (f-scale a c) (let ((v (make-vector (vector-length a) 0))) (let loop ((i 0)) (if (< i (vector-length a)) (begin (vector-set! v i (* c (vector-ref a i))) (loop (+ i 1))))) v))
(define (f-mul F a b) (f-reduce F (poly-mul a b)))
(define (f-zero? a) (all? (lambda (i) (= 0 (vector-ref a i))) (range (vector-length a))))
(define (f-equal? a b) (f-zero? (f-sub a b)))
(define (f-rational a) (and (all? (lambda (i) (= 0 (vector-ref a i))) (cdr (range (vector-length a)))) (vector-ref a 0)))
(define (f-inv F a)                              ;; solve sum_j x_j (a x^j) = 1
  (let* ((n (f-deg F)) (cols (map (lambda (j) (f-mul F a (f-zeta-power F j))) (range n))) (M (make-vector n 0)))
    (let loop ((i 0)) (if (< i n) (begin (vector-set! M i (let ((row (make-vector (+ n 1) 0))) (let fill ((j 0) (cs cols)) (if (< j n) (begin (vector-set! row j (vector-ref (car cs) i)) (fill (+ j 1) (cdr cs))))) (vector-set! row n (if (= i 0) 1 0)) row)) (loop (+ i 1)))))
    (let elim ((c 0))
      (if (< c n)
          (let ((piv (let find ((r c)) (cond ((= r n) (error "not invertible")) ((not (= 0 (vector-ref (vector-ref M r) c))) r) (else (find (+ r 1)))))))
            (let ((t (vector-ref M c))) (vector-set! M c (vector-ref M piv)) (vector-set! M piv t))
            (let* ((prow (vector-ref M c)) (inv (/ 1 (vector-ref prow c))))
              (let norm ((j 0)) (if (<= j n) (begin (vector-set! prow j (* inv (vector-ref prow j))) (norm (+ j 1)))))
              (let rows ((r 0))
                (if (< r n)
                    (begin (if (and (not (= r c)) (not (= 0 (vector-ref (vector-ref M r) c))))
                               (let ((f (vector-ref (vector-ref M r) c)) (row (vector-ref M r)))
                                 (let sub ((j 0)) (if (<= j n) (begin (vector-set! row j (- (vector-ref row j) (* f (vector-ref prow j)))) (sub (+ j 1)))))))
                           (rows (+ r 1))))))
            (elim (+ c 1)))))
    (let ((x (f-zero F))) (let loop ((i 0)) (if (< i n) (begin (vector-set! x i (vector-ref (vector-ref M i) n)) (loop (+ i 1))))) x)))
(define (f-product F xs) (let loop ((l xs) (acc (f-one F))) (if (null? l) acc (loop (cdr l) (f-mul F acc (car l))))))
;; --- parameters -----------------------------------------------------------------------------------------------------
(define m (let ((v (get-environment-variable "MATH_FERMAT_DEGREE"))) (if v (string->number v) 8)))
(define K (make-field (* 2 m)))                   ;; Q(zeta_2m): eps = zeta_2m, i = zeta_2m^{m/2} when m is even
(define (t0) (current-time-ns))
(define t-start (t0))
;; --- a generic tower Q(zeta_2m)[c]/(c^k - base): elements are vectors of k field elements ----------------------------
(define tower-k 1) (define tower-base 1)
(define (set-tower! k base) (set! tower-k k) (set! tower-base base))
(define (t-zero) (let ((v (make-vector tower-k 0))) (let loop ((i 0)) (if (< i tower-k) (begin (vector-set! v i (f-zero K)) (loop (+ i 1))))) v))
(define (t-from-field a) (let ((v (t-zero))) (vector-set! v 0 a) v))
(define (t-one) (t-from-field (f-one K)))
(define (t-c) (let ((v (t-zero))) (if (> tower-k 1) (vector-set! v 1 (f-one K)) (vector-set! v 0 (f-scale (f-one K) tower-base))) v))
(define (t-add a b) (let ((v (t-zero))) (let loop ((i 0)) (if (< i tower-k) (begin (vector-set! v i (f-add (vector-ref a i) (vector-ref b i))) (loop (+ i 1))))) v))
(define (t-scale a q) (let ((v (t-zero))) (let loop ((i 0)) (if (< i tower-k) (begin (vector-set! v i (f-scale (vector-ref a i) q)) (loop (+ i 1))))) v))
(define (t-neg a) (t-scale a -1))
(define (t-mul a b)
  (let ((v (t-zero)))
    (let li ((i 0))
      (if (< i tower-k)
          (begin
            (if (not (f-zero? (vector-ref a i)))
                (let lj ((j 0))
                  (if (< j tower-k)
                      (begin
                        (if (not (f-zero? (vector-ref b j)))
                            (let* ((prod (f-mul K (vector-ref a i) (vector-ref b j))) (e (+ i j)))
                              (if (>= e tower-k)
                                  (vector-set! v (- e tower-k) (f-add (vector-ref v (- e tower-k)) (f-scale prod tower-base)))
                                  (vector-set! v e (f-add (vector-ref v e) prod)))))
                        (lj (+ j 1))))))
            (li (+ i 1)))))
    v))
(define (t-zero? a) (all? (lambda (i) (f-zero? (vector-ref a i))) (range tower-k)))
(define (t-power a n) (let loop ((k 0) (acc (t-one))) (if (= k n) acc (loop (+ k 1) (t-mul acc a)))))
(define (t-eps) (t-from-field (f-zeta-power K 1)))     ;; built under the current tower
(define (t-i) (t-from-field (f-zeta-power K (quotient m 2))))     ;; i = eps^{m/2}, only meaningful for even m
;; --- sparse polynomials over the current tower ---------------------------------------------------------------------------
(define BASE (* 4 m))   ;; monomial radix: exponents reach 2(m-2) in products; a fixed 32 collided from m = 34 on
(define (mono-key e) (+ (* BASE (+ (* BASE (+ (* BASE (list-ref e 0)) (list-ref e 1))) (list-ref e 2))) (list-ref e 3)))
(define (key-mono k) (list (quotient k (* BASE BASE BASE)) (modulo (quotient k (* BASE BASE)) BASE) (modulo (quotient k BASE) BASE) (modulo k BASE)))
(define (p-zero) (make-hash-table))
(define (p-add! P k coeff) (let ((old (hash-table-ref/default P k #f))) (let ((new (if old (t-add old coeff) coeff))) (hash-table-set! P k new))))
(define (p-terms P) (filter (lambda (pr) (not (t-zero? (cdr pr)))) (hash-table->alist P)))
(define (p-mono e coeff) (let ((P (p-zero))) (hash-table-set! P (mono-key e) coeff) P))
(define (p-sum . Ps) (let ((R (p-zero))) (for-each (lambda (P) (for-each (lambda (pr) (p-add! R (car pr) (cdr pr))) (p-terms P))) Ps) R))
(define (p-scale P s) (let ((R (p-zero))) (for-each (lambda (pr) (p-add! R (car pr) (t-mul s (cdr pr)))) (p-terms P)) R))
(define (p-mul A B)
  (let ((R (p-zero)))
    (for-each (lambda (pa) (for-each (lambda (pb) (p-add! R (mono-key (map + (key-mono (car pa)) (key-mono (car pb)))) (t-mul (cdr pa) (cdr pb)))) (p-terms B))) (p-terms A))
    R))
(define (p-deriv P v)
  (let ((R (p-zero)))
    (for-each (lambda (pr) (let ((e (key-mono (car pr)))) (if (> (list-ref e v) 0) (p-add! R (mono-key (map (lambda (i x) (if (= i v) (- x 1) x)) (range 4) e)) (t-scale (cdr pr) (list-ref e v)))))) (p-terms P))
    R))
(define (p-neg P) (p-scale P (t-neg (t-one))))
(define (p-equal? A B) (null? (p-terms (p-sum A (p-neg B)))))
(define (x-power v n) (p-mono (map (lambda (i) (if (= i v) n 0)) (range 4)) (t-one)))
(define (minor M i j) (map (lambda (row) (let loop ((l row) (k 0) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (+ k 1) (if (= k j) acc (cons (car l) acc)))))) (let loop ((rows M) (k 0) (acc '())) (if (null? rows) (reverse acc) (loop (cdr rows) (+ k 1) (if (= k i) acc (cons (car rows) acc)))))))
(define (p-det M)
  (if (= 1 (length M)) (car (car M))
      (let loop ((j 0) (acc (p-zero)) (sign 1))
        (if (= j (length M)) acc
            (loop (+ j 1) (p-sum acc (p-scale (p-mul (list-ref (car M) j) (p-det (minor M 0 j))) (t-scale (t-one) sign))) (- 0 sign))))))
(define (jac-matrix H) (map (lambda (h) (map (lambda (v) (p-deriv h v)) (range 4))) H))
(define (p-reduce P) (let ((R (p-zero))) (for-each (lambda (pr) (if (all? (lambda (x) (<= x (- m 2))) (key-mono (car pr))) (p-add! R (car pr) (cdr pr)))) (p-terms P)) R))
(define (support P) (map (lambda (pr) (map (lambda (x) (+ x 1)) (key-mono (car pr)))) (p-terms (p-reduce P))))
(define (F) (p-sum (x-power 0 m) (x-power 1 m) (x-power 2 m) (x-power 3 m)))
(define (cycle-support f1 g1 f2 g2)
  (if (not (p-equal? (F) (p-sum (p-mul f1 g1) (p-mul f2 g2)))) (error "F is not f1 g1 + f2 g2"))
  (support (p-det (jac-matrix (list f1 g1 f2 g2)))))
(define (geom-sum A B k) (let loop ((j 0) (acc (p-zero))) (if (= j k) acc (loop (+ j 1) (p-sum acc (p-mul (p-power A (- k 1 j)) (p-power B j)))))))
(define (p-power P n) (let loop ((k 0) (acc (p-mono (list 0 0 0 0) (t-one)))) (if (= k n) acc (loop (+ k 1) (p-mul acc P)))))
;; --- characters --------------------------------------------------------------------------------------------------------
(define units (filter (lambda (t) (= 1 (gcd2 t m))) (cdr (range m))))
(define (gcd2 a b) (if (= b 0) (abs a) (gcd2 b (remainder a b))))
(define (hodge-char? a) (all? (lambda (t) (= (* 2 m) (sum (map (lambda (x) (modulo (* t x) m)) a)))) units))
(define all-hodge   ;; a_3 is determined by a_0 + a_1 + a_2 (m^3 candidates, not m^4: m = 30 blew the 1 GB heap the other way)
  (let loop0 ((a0 1) (acc '()))
    (if (= a0 m) (reverse acc)
        (loop0 (+ a0 1)
          (let loop1 ((a1 1) (acc1 acc))
            (if (= a1 m) acc1
                (loop1 (+ a1 1)
                  (let loop2 ((a2 1) (acc2 acc1))
                    (if (= a2 m) acc2
                        (loop2 (+ a2 1)
                          (let ((a3 (modulo (- m (modulo (+ a0 a1 a2) m)) m)))
                            (if (and (> a3 0) (with-region (hodge-char? (list a0 a1 a2 a3)))) (cons (list a0 a1 a2 a3) acc2) acc2))))))))))))
(define (galois-closed? S) (all? (lambda (a) (all? (lambda (t) (member (map (lambda (x) (modulo (* t x) m)) a) S)) units)) S))
(define (permutations lst) (if (null? lst) (list '()) (apply append (map (lambda (x) (map (lambda (p) (cons x p)) (permutations (filter (lambda (y) (not (= y x))) lst)))) lst))))
(define perms4 (permutations (list 0 1 2 3)))
(define (permute-support S) (dedup (apply append (map (lambda (perm) (map (lambda (a) (map (lambda (i) (list-ref a i)) perm)) S)) perms4))))
;; --- the cycles ----------------------------------------------------------------------------------------------------------
;; lines: tower trivial (k = 1, base 1)
(set-tower! 1 1)
(define supp-L (with-region (let* ((f1 (p-sum (x-power 0 1) (p-scale (x-power 1 1) (t-neg (t-eps)))))     ;; x_0 - eps x_1, eps^m = -1 for every m
                                   (g1 (geom-sum (x-power 0 1) (p-scale (x-power 1 1) (t-eps)) m))
                                   (f2 (p-sum (x-power 2 1) (p-scale (x-power 3 1) (t-neg (t-eps)))))
                                   (g2 (geom-sum (x-power 2 1) (p-scale (x-power 3 1) (t-eps)) m)))
                              (cycle-support f1 g1 f2 g2))))
(define supp-lines (permute-support supp-L))
;; Aoki's curves at every level m' | m, pulled back along X_m -> X_{m'}, x -> x^e (e = m/m'): the p-standard
;; elements at level m are the inflations of the primitive ones at lower levels (Shioda-Katsura), so each level
;; contributes its own curve. p = 2 curve at level m' (m' even): x_0^{d e} + x_1^{d e} + i x_2^{d e} = 0,
;; x_3^{2e} = c x_0^e x_1^e with d = m'/2, c^d = 2, i = eps^{m/2}; p = 3 curve at level m' (3 | m'):
;; x_0^{d e} + x_1^{d e} + x_2^{d e} = 0, x_3^{3e} = eps'^3 c x_0^e x_1^e x_2^e with d = m'/3, c^d = 3, eps' = eps^e.
(define (divisors-of n) (filter (lambda (k) (= 0 (modulo n k))) (cdr (range (+ n 1)))))
(define levels (filter (lambda (k) (>= k 4)) (divisors-of m)))
(define (C-support level)
  (let* ((e (quotient m level)) (d (quotient level 2)))
    (set-tower! d 2)
    (let* ((x0x1 (p-mul (x-power 0 e) (x-power 1 e)))
           (f1 (p-sum (x-power 0 (* d e)) (x-power 1 (* d e)) (p-scale (x-power 2 (* d e)) (t-i))))
           (g1 (p-sum (x-power 0 (* d e)) (x-power 1 (* d e)) (p-scale (x-power 2 (* d e)) (t-neg (t-i)))))
           (f2 (p-sum (x-power 3 (* 2 e)) (p-scale x0x1 (t-neg (t-c)))))
           (g2 (geom-sum (x-power 3 (* 2 e)) (p-scale x0x1 (t-c)) d)))
      (cycle-support f1 g1 f2 g2))))
(define (Y-support level)
  (let* ((e (quotient m level)) (d (quotient level 3)))
    (set-tower! d 3)
    (let* ((x0x1x2 (p-mul (p-mul (x-power 0 e) (x-power 1 e)) (x-power 2 e)))
           (kconst (t-mul (t-power (t-eps) (* 3 e)) (t-c)))
           (y0 (x-power 0 (* d e))) (y1 (x-power 1 (* d e))) (y2 (x-power 2 (* d e)))
           (f1 (p-sum y0 y1 y2))
           (g1 (p-sum (p-mul y0 y0) (p-mul y1 y1) (p-mul y2 y2) (p-neg (p-mul y0 y1)) (p-neg (p-mul y1 y2)) (p-neg (p-mul y0 y2))))
           (f2 (p-sum (x-power 3 (* 3 e)) (p-scale x0x1x2 (t-neg kconst))))
           (g2 (geom-sum (x-power 3 (* 3 e)) (p-scale x0x1x2 kconst) d)))
      (cycle-support f1 g1 f2 g2))))
(define C-levels (filter even? levels))
(define Y-levels (filter (lambda (k) (= 0 (modulo k 3))) levels))
(define supp-C-by-level (map (lambda (k) (with-region (C-support k))) C-levels))
(define supp-Y-by-level (map (lambda (k) (with-region (Y-support k))) Y-levels))
(define supp-C (if (null? supp-C-by-level) #f (dedup (apply append supp-C-by-level))))
(define supp-Y (if (null? supp-Y-by-level) #f (dedup (apply append supp-Y-by-level))))
(set-tower! 1 1)
(define cover-C (if supp-C (permute-support supp-C) '()))
(define cover-Y (if supp-Y (permute-support supp-Y) '()))
(define supp-all (dedup (append supp-lines cover-C cover-Y)))
(define missing (filter (lambda (a) (not (member a supp-all))) all-hodge))
(define standard-count (count-if (lambda (a) (any? (lambda (pr) (= 0 (modulo (+ (list-ref a (car pr)) (list-ref a (cadr pr))) m))) (list (list 0 1) (list 0 2) (list 0 3) (list 1 2) (list 1 3) (list 2 3)))) all-hodge))
(define ok (and (all? hodge-char? supp-all) (galois-closed? supp-all) (= (length supp-lines) standard-count)
                (or (not supp-C) (galois-closed? supp-C)) (or (not supp-Y) (galois-closed? supp-Y))))
;; --- the residual, organised: orbits under (Z/m)^* x S_4, and Aoki's Theorem 1-2 witnesses ---------------------------
;; A witness for an orbit representative alpha is an identity of multisets  alpha * delta ~ sigma_1 * ... * sigma_k * delta'
;; with sigma_i p-standard at level m (p | m), delta and delta' decomposable (pairs (a, -a)), k <= MATH_WITNESS_K (4). Aoki's Theorem 1-4 (inductive structure) then produces the cycle for alpha from Aoki's cycles for the
;; sigma_i; an orbit with no such witness is a candidate for a semi-standard element (Aoki's Theorem 1-3).
(define (sort-asc xs) (let loop ((l xs) (acc '())) (if (null? l) acc (loop (cdr l) (insert-asc (car l) acc)))))
(define (insert-asc x l) (cond ((null? l) (list x)) ((<= x (car l)) (cons x l)) (else (cons (car l) (insert-asc x (cdr l))))))
(define (list<? a b) (cond ((null? a) #f) ((< (car a) (car b)) #t) ((> (car a) (car b)) #f) (else (list<? (cdr a) (cdr b)))))
(define (canon a) (let loop ((us units) (best #f)) (if (null? us) best (let ((t (sort-asc (map (lambda (x) (modulo (* (car us) x) m)) a)))) (loop (cdr us) (if (or (not best) (list<? t best)) t best))))))
(define (lookup-orbit rep orbits) (let loop ((l orbits)) (cond ((null? l) #f) ((equal? (car (car l)) rep) (car l)) (else (loop (cdr l))))))
(define missing-orbits   ;; list of (rep . size), in order of first appearance
  (let loop ((l missing) (acc '()))
    (if (null? l) (reverse acc)
        (let* ((rep (canon (car l))) (hit (lookup-orbit rep acc)))
          (if hit (begin (set-cdr! hit (+ 1 (cdr hit))) (loop (cdr l) acc)) (loop (cdr l) (cons (cons rep 1) acc)))))))
(define (prime? p) (and (> p 1) (all? (lambda (r) (not (= 0 (modulo p r)))) (filter (lambda (r) (>= r 2)) (range p)))))
(define primes-of-m (filter (lambda (p) (and (>= p 2) (prime? p) (= 0 (modulo m p)))) (range (+ m 1))))
(define (p-standard p)
  (let ((d (quotient m p)))
    (dedup (map sort-asc (filter (lambda (s) (not (member 0 s)))
      (map (lambda (i) (if (= p 2) (list i (modulo (+ i d) m) (modulo (- m (* 2 i)) m) d)
                                   (append (map (lambda (k) (modulo (+ i (* k d)) m)) (range p)) (list (modulo (- m (* p i)) m)))))
           (filter (lambda (i) (> (quotient d (gcd2 i d)) 2)) (cdr (range m)))))))))
(define standards (apply append (map p-standard primes-of-m)))
(define (remove-one x l) (cond ((null? l) '()) ((equal? (car l) x) (cdr l)) (else (cons (car l) (remove-one x (cdr l))))))
(define (ms-diff A B) (let loop ((b B) (a A)) (cond ((null? b) a) ((member (car b) a) (loop (cdr b) (remove-one (car b) a))) (else #f))))
(define (decomposable? ms) (let loop ((l ms)) (if (null? l) #t (let ((b (modulo (- m (car l)) m))) (if (member b (cdr l)) (loop (remove-one b (cdr l))) #f)))))
;; delta is forced by sigma: every entry sigma has that alpha lacks must come from a pair (x, -x), and a pair
;; contributing nothing could be cancelled against delta'. So for each choice of sigma_1..sigma_k (k <= WITNESS_K,
;; default 4, all p-standard elements at level m) there is one candidate delta, and the test is that the leftover
;; alpha * delta - sigma is decomposable.
(define witness-K (let ((v (get-environment-variable "MATH_WITNESS_K"))) (if v (string->number v) 4)))
(define (combos-with-replacement l k)   ;; multisets of size k from l, as lists
  (cond ((= k 0) (list '()))
        ((null? l) '())
        (else (append (map (lambda (c) (cons (car l) c)) (combos-with-replacement l (- k 1)))
                      (combos-with-replacement (cdr l) k)))))
(define (forced-pairs need)   ;; need: list; returns the x's whose pairs (x, -x) cover it
  (let loop ((l need) (acc '()))
    (if (null? l) (reverse acc)
        (let ((y (modulo (- m (car l)) m)))
          (loop (if (member y (cdr l)) (remove-one y (cdr l)) (cdr l)) (cons (car l) acc))))))
(define (witness-with rep sig)
  (let* ((sigl (apply append sig))
         (need (ms-diff sigl rep))
         (need2 (if need need (let loop ((l sigl) (r rep) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) r) (loop (cdr l) (remove-one (car l) r) acc)) (else (loop (cdr l) r (cons (car l) acc)))))))
         (pairs (forced-pairs need2))
         (left (append rep (apply append (map (lambda (x) (list x (modulo (- m x) m))) pairs))))
         (rest (ms-diff left sigl)))
    (if (and rest (decomposable? rest)) (list sig pairs rest) #f)))
(define (witness rep)
  (let loop-k ((k 1))
    (if (> k witness-K) #f
        (let loop-c ((cs (combos-with-replacement standards k)))
          (cond ((null? cs) (loop-k (+ k 1)))
                ((witness-with rep (car cs)) => (lambda (w) w))
                (else (loop-c (cdr cs))))))))
(define orbit-reports (map (lambda (o) (list (car o) (cdr o) (with-region (witness (car o))))) missing-orbits))   ;; the search allocates freely; one region per orbit
(define inductive-count (sum (map (lambda (r) (if (caddr r) (cadr r) 0)) orbit-reports)))
(define no-witness-count (- (length missing) inductive-count))
(define (json-list xs) (string-append "[" (let loop ((l xs) (acc "")) (if (null? l) acc (loop (cdr l) (string-append acc (if (string=? acc "") "" ",") (car l))))) "]"))
(define (json-ints a) (json-list (map number->string a)))
(define (json-char a) (json-ints a))
(define (json-orbit r) (string-append "{\"rep\":" (json-ints (car r)) ",\"size\":" (number->string (cadr r)) ",\"witness\":" (if (caddr r) (string-append "{\"standards\":" (json-list (map json-ints (car (caddr r)))) ",\"delta_pairs\":" (json-ints (cadr (caddr r))) ",\"delta_prime\":" (json-ints (caddr (caddr r))) "}") "null") "}"))
(display (string-append "{\"schema\":\"eshkol.math.fermat_surface_aoki.v1\",\"degree\":" (number->string m)
                        ",\"hodge_characters\":" (number->string (length all-hodge)) ",\"standard\":" (number->string standard-count)
                        ",\"lines_cover\":" (number->string (length supp-lines))
                        ",\"C_support\":" (if supp-C (number->string (length supp-C)) "null") ",\"C_cover\":" (if supp-C (number->string (length cover-C)) "null")
                        ",\"Y_support\":" (if supp-Y (number->string (length supp-Y)) "null") ",\"Y_cover\":" (if supp-Y (number->string (length cover-Y)) "null")
                        ",\"C_levels\":" (json-list (map number->string C-levels)) ",\"Y_levels\":" (json-list (map number->string Y-levels)) ",\"covered\":" (number->string (length supp-all)) ",\"missing\":" (number->string (length missing))
                        ",\"missing_characters\":" (json-list (map json-char missing)) ",\"missing_orbits\":" (json-list (map json-orbit orbit-reports)) ",\"witness_k_max\":" (number->string witness-K) ",\"inductive\":" (number->string inductive-count) ",\"no_witness\":" (number->string no-witness-count)
                        ",\"elapsed_ms\":" (number->string (quotient (- (current-time-ns) t-start) 1000000)) ",\"verdict\":\"" (if ok "PASS" "FAIL") "\"}"))
(newline)
(if ok (begin (display "RESULT: ALL PASS") (newline) (exit 0)) (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
