;; Exact pullback and HVP over Q(sqrt(2)), checked against closed-form formulas.
(require stdlib)
(require core.ad.algebraic_reverse)
(define passes 0)
(define failures 0)
(define (check name ok)
  (if ok
      (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define same (algebraic-domain-ref (algebraic-domain field) 'equal?))
(define (objective tape xs)
  (let ((x (vector-ref xs 0)) (y (vector-ref xs 1)))
    (algebraic-reverse-add tape
      (algebraic-reverse-pow tape x 3)
      (algebraic-reverse-mul tape y (algebraic-reverse-pow tape x 2)))))
(define point (vector alpha 3))
(define direction (vector 2 -1))
(define record (algebraic-value-and-pullback field objective point))
(define value (vector-ref record 0))
(define gradient ((vector-ref record 1) 1))
(define hvp (algebraic-hvp field objective point direction))
;; Independent calculus: f=x^3+y*x^2; grad=(3x^2+2yx,x^2),
;; H*(2,-1)=(10x+4y,4x), and grad dot (2,-1)=2*grad_x-grad_y.
(define expected-value (algebraic-add (algebraic-scale alpha 2) (algebraic-element field 6)))
(define expected-gradient-x (algebraic-add (algebraic-element field 6) (algebraic-scale alpha 6)))
(define expected-gradient-y (algebraic-element field 2))
(define expected-hvp-x (algebraic-add (algebraic-element field 12) (algebraic-scale alpha 10)))
(define expected-hvp-y (algebraic-scale alpha 4))
(define expected-directional (algebraic-add (algebraic-element field 10) (algebraic-scale alpha 12)))
(check "exact value matches independent polynomial" (same value expected-value))
(check "whole pullback x matches analytic gradient" (same (vector-ref gradient 0) expected-gradient-x))
(check "whole pullback y matches analytic gradient" (same (vector-ref gradient 1) expected-gradient-y))
(check "HVP x matches analytic Hessian action" (same (vector-ref (vector-ref hvp 0) 0) expected-hvp-x))
(check "HVP y matches analytic Hessian action" (same (vector-ref (vector-ref hvp 0) 1) expected-hvp-y))
(check "HVP reports the same exact gradient" (and (same (vector-ref (vector-ref hvp 1) 0) expected-gradient-x)
                                                   (same (vector-ref (vector-ref hvp 1) 1) expected-gradient-y)))
(check "HVP value and directional output match analytic reference"
  (and (same (vector-ref hvp 2) expected-value) (same (vector-ref hvp 3) expected-directional)))
(check "no finite-difference evaluations" (= (ad-finite-difference-evals) 0))
(display "Value coefficients: ") (display (algebraic-coefficients value)) (newline)
(display "Gradient coefficients: ") (display (vector (algebraic-coefficients (vector-ref gradient 0))
                                                       (algebraic-coefficients (vector-ref gradient 1)))) (newline)
(display "HVP coefficients: ") (display (vector (algebraic-coefficients (vector-ref (vector-ref hvp 0) 0))
                                                 (algebraic-coefficients (vector-ref (vector-ref hvp 0) 1)))) (newline)
(display "Passed: ") (display passes) (display " Failed: ") (display failures) (newline)
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
