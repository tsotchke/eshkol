;; Learning kinship rules from facts (v1.5.0 neuro-symbolic bridge, ADR-0049).
;;
;; The knowledge base holds parent, spouse and sibling facts for one family.
;; Two rule templates are trained by exact gradient descent through soft
;; forward chaining:
;;
;;   grandparent(x, y) <- P(x, z), Q(z, y)              P, Q learned
;;   ancestor(x, y)    <- P(x, y)                       P learned
;;   ancestor(x, y)    <- Q(x, z), R(z, y)              Q, R learned, recursive
;;
;; The learned clauses are read back as symbolic rules, run on a family the
;; training never saw, and their conclusions are asserted into that family's
;; knowledge base, where the exact engine answers queries from them.
;;
;; Run: eshkol-run -r examples/neurosymbolic_kinship.esk

(require core.ml.diff_logic)

(define (r3 x) (/ (round (* 1000.0 x)) 1000.0))

(define (descend! theta loss steps lr)
  (let train ((k 0))
    (if (< k steps)
        (let ((g (gradient loss theta)))
          (let upd ((i 0))
            (if (< i (vector-length theta))
                (begin (vector-set! theta i (- (vector-ref theta i) (* lr (vector-ref g i)))) (upd (+ i 1)))))
          (train (+ k 1))))))

(define (family-kb facts)
  (let ((kb (make-kb)))
    (for-each (lambda (f) (kb-assert! kb (make-fact (car f) (cadr f) (caddr f)))) facts)
    kb))

(define (base-of kb dom)
  (list (cons 'parent (dl-relation-from-kb dom kb 'parent))
        (cons 'spouse (dl-relation-from-kb dom kb 'spouse))
        (cons 'sibling (dl-relation-from-kb dom kb 'sibling))))

;; ── the training family ──
(define kb1 (family-kb '((parent ann bob) (parent bob cid) (parent bob eli) (parent cid dan)
                         (spouse ann fox) (spouse fox ann) (sibling cid eli) (sibling eli cid))))
(define dom1 (dl-domain-from-kb kb1 '(parent spouse sibling)))
(define base1 (base-of kb1 dom1))
(define parent1 (dl-valuation-ref base1 'parent))

(define (closure dom r)
  (let loop ((acc r) (k 0))
    (if (< k (dl-domain-size dom)) (loop (dl-disjoin acc (dl-compose dom acc r)) (+ k 1)) acc)))

;; ── grandparent ──
(define gp-prog (make-dl-program '(parent spouse sibling) '((grandparent chain))))
(define gp-target (dl-compose dom1 parent1 parent1))
(define (gp-loss theta)
  (dl-cross-entropy (dl-valuation-ref (dl-forward-chain theta gp-prog dom1 base1 1) 'grandparent) gp-target))
(define theta-gp (dl-program-init-params gp-prog))
(display "grandparent loss before: ") (display (r3 (gp-loss theta-gp))) (newline)
(descend! theta-gp gp-loss 120 0.5)
(display "grandparent loss after:  ") (display (r3 (gp-loss theta-gp))) (newline)
(for-each (lambda (r) (display "learned: ") (display (car r)) (display "  confidence ") (display (r3 (cdr r))) (newline))
          (dl-extract-rules theta-gp gp-prog))

;; ── ancestor, recursive ──
(define anc-prog (make-dl-program '(parent spouse ancestor) '((ancestor copy) (ancestor chain))))
(define base1a (list (cons 'parent parent1) (cons 'spouse (dl-valuation-ref base1 'spouse))))
(define anc-target (closure dom1 parent1))
(define (anc-loss theta)
  (dl-cross-entropy (dl-valuation-ref (dl-forward-chain theta anc-prog dom1 base1a 3) 'ancestor) anc-target))
(define theta-anc (dl-program-init-params anc-prog))
(display "ancestor loss before: ") (display (r3 (anc-loss theta-anc))) (newline)
(descend! theta-anc anc-loss 150 0.5)
(display "ancestor loss after:  ") (display (r3 (anc-loss theta-anc))) (newline)
(for-each (lambda (r) (display "learned: ") (display (car r)) (display "  confidence ") (display (r3 (cdr r))) (newline))
          (dl-extract-rules theta-anc anc-prog))

;; ── a family the training never saw ──
(define kb2 (family-kb '((parent gil hal) (parent hal ivy) (parent hal jon) (parent jon kim)
                         (parent kim lee) (spouse gil mae) (spouse mae gil) (sibling ivy jon) (sibling jon ivy))))
(define dom2 (dl-domain-from-kb kb2 '(parent spouse sibling)))
(define base2 (base-of kb2 dom2))
(define gp2 (dl-valuation-ref (dl-forward-chain theta-gp gp-prog dom2 base2 1) 'grandparent))
(define anc2 (dl-valuation-ref (dl-forward-chain theta-anc anc-prog dom2
                                                 (list (cons 'parent (dl-valuation-ref base2 'parent))
                                                       (cons 'spouse (dl-valuation-ref base2 'spouse)))
                                                 5)
                               'ancestor))
(display "derived grandparent facts: ") (display (dl-true-atoms dom2 gp2 'grandparent 0.5)) (newline)
(display "derived ancestor facts:    ") (display (length (dl-true-atoms dom2 anc2 'ancestor 0.5))) (newline)

;; ── back into the symbolic engine ──
(display "asserted: ") (display (+ (dl-assert-derived! kb2 dom2 gp2 'grandparent 0.5)
                                  (dl-assert-derived! kb2 dom2 anc2 'ancestor 0.5)))
(newline)
(display "ancestors of lee: ")
(display (map (lambda (s) (walk '?a s)) (kb-query kb2 '(ancestor ?a lee))))
(newline)
(display "grandchildren of hal: ")
(display (map (lambda (s) (walk '?g s)) (kb-query kb2 '(grandparent hal ?g))))
(newline)
