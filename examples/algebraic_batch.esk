;; Exact packed multiplication over Q[cuberoot(2)].
(require stdlib)
(require core.algebraic_batch)
(define (main)
  (let* ((field (make-algebraic-field '(-2 0 0 1) 7 0))
         (alpha (algebraic-generator field))
         (plan (make-algebraic-multiplication-plan field))
         (result (algebraic-batch-mul plan (vector alpha) (vector alpha)))
         (product (vector-ref (vector-ref result 0) 0))
         (reference (algebraic-mul alpha alpha)))
    (if (not (algebraic-equal? product reference))
        (error "Packed alpha squared differs from scalar exact product"))
    (display "Packed exact product: alpha squared = 2\nRESULT: PASS\n")))
(main)
