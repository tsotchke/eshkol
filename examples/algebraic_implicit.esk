;; Coupled implicit differentiation of x^2+y^2=4+t, x-y=0 around (sqrt(2),sqrt(2)).
(require stdlib)
(require core.ad.algebraic_implicit)

(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define context (make-algebraic-taylor field 4))
(define parameter (algebraic-ad-seed context 4))
(define equations (vector
  (list (list 1 (vector 2 0)) (list 1 (vector 0 2))
        (list (algebraic-ad-sub (algebraic-ad-constant context 0) parameter) (vector 0 0)))
  (list (list 1 (vector 1 0)) (list -1 (vector 0 1)))))
(define roots (algebraic-ad-system-root context equations (vector alpha alpha)))
(define residual (algebraic-ad-system-residual context equations roots))
(define expected (vector 1 1/8 -1/128 1/1024 -5/32768))
(define actual (algebraic-ad-coefficients (vector-ref roots 0)))
(define failures 0)
(define (check name ok)
  (if (not ok) (begin (set! failures (+ failures 1)) (display "FAIL: ") (display name) (newline))))
(check "coupled components agree" (algebraic-ad-equal? (vector-ref roots 0) (vector-ref roots 1)))
(check "complete residual vanishes" (and (algebraic-ad-equal? (vector-ref residual 0) (algebraic-ad-constant context 0))
                                          (algebraic-ad-equal? (vector-ref residual 1) (algebraic-ad-constant context 0))))
(check "exact Taylor coefficients match binomial reference"
  (let loop ((i 0)) (or (= i (vector-length expected))
    (and (algebraic-equal? (vector-ref actual i) (algebraic-scale alpha (vector-ref expected i))) (loop (+ i 1))))))
(display "Taylor coefficients for both coupled roots:") (newline)
(for-each
  (lambda (root)
    (display (map (lambda (x) (vector->list (algebraic-coefficients x)))
                  (vector->list (algebraic-ad-coefficients root))))
    (newline))
  (vector->list roots))
(if (> failures 0) (begin (display "RESULT: FAIL") (newline) (exit 1)))
(display "RESULT: PASS") (newline)
