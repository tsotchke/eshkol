(require stdlib)
(require core.ad.algebraic_sparse)
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define alpha (algebraic-generator field))
(define point (vector alpha (algebraic-element field 2)))
(define (objective xs)
  (let* ((ctx (algebraic-ad-context (vector-ref xs 0)))
         (mul (algebraic-domain-ref (algebraic-domain ctx) 'mul))
         (x (vector-ref xs 0)) (y (vector-ref xs 1)))
    (mul x (mul y y))))
(define h (algebraic-sparse-hessian field objective point '((0 1) (1 1))))
(display "H(0,1) = " ) (write (algebraic-sparse-hessian-ref h 0 1)) (newline)
(display "H(1,1) = " ) (write (algebraic-sparse-hessian-ref h 1 1)) (newline)
(display "probes/colors = " ) (write (vector->list (algebraic-sparse-hessian-summary h))) (newline)
