;; One bounded polynomial, its analytic gradient, and its exact finite change.
(require stdlib)
(require core.ad.derived_operator)
(define op (make-derived-operator '(x y) '(+ (* x x) (* x y))))
(define (f x y) (+ (* x x) (* x y)))
(define (check name ok)
  (if (not ok) (error "derived operator example failed" name)))
(for-each (lambda (point)
  (for-each (lambda (step)
    (let* ((x (car point)) (y (cadr point)) (dx (car step)) (dy (cadr step))
           (p (vector x y)) (d (vector dx dy))
           ;; Independent hand-derived gradient: (2x+y, x).
           (analytic (+ (* (+ (* 2 x) y) dx) (* x dy)))
           (change (- (f (+ x dx) (+ y dy)) (f x y)))
           (jvp (derived-operator-jvp op p d))
           (delta (derived-operator-delta op p d))
           (vjp (derived-operator-vjp op p 3/7)))
      (check "independent analytic gradient" (= jvp analytic))
      (check "exact full finite-change identity" (= delta change))
      (check "JVP/VJP pairing" (= (* 3/7 jvp) (+ (* (vector-ref vjp 0) dx) (* (vector-ref vjp 1) dy))))
      (check "derivative differs from finite delta" (or (and (= dx 0) (= dy 0)) (not (= jvp delta))))))
    '((1 -2) (0 0) (2/3 3/5)))
  '((2 3) (-1 7/3) (5/4 -9/7))))
(define point (vector 2 3))
(define direction (vector 1 -2))
(check "fixed derivative and finite delta differ"
       (not (= (derived-operator-jvp op point direction)
               (derived-operator-delta op point direction))))
(display "Derived polynomial checks passed; derivative and finite delta are distinct.\n")
