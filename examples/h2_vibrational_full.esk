;; H2 vibrational frequency: Eshkol geometry AD plus Moonlab response.
;; Requires -DESHKOL_QUANTUM_ENABLED=ON and Moonlab v1.2.0.
;;
;; k = sum_i g_i'' <P_i> - E_thetaR^T (E_thetatheta)^-1 E_thetaR + (1/R)''

(require agent.quantum)

(define pi 3.141592653589793)
(define exps (list 3.42525091 0.62391373 0.16885540))
(define coefs (list 0.15432897 0.53532814 0.44463454))
(define (nprim a) (expt (/ (* 2.0 a) pi) 0.75))
(define dn (map (lambda (a d) (* d (nprim a))) exps coefs))

(define (my-erf x)
  (let* ((t (/ 1.0 (+ 1.0 (* 0.3275911 x))))
         (p (* t (+ 0.254829592
                    (* t (+ -0.284496736
                             (* t (+ 1.421413741
                                      (* t (+ -1.453152027
                                               (* t 1.061405429)))))))))))
    (- 1.0 (* p (exp (- (* x x)))))))

(define (boys0 u)
  (if (< u 1.0e-12)
      1.0
      (let ((su (sqrt u)))
        (* (/ (sqrt pi) 2.0) (/ (my-erf su) su)))))

(define (zc c R) (if (= c 0) 0.0 R))
(define (d2c ci cj R) (if (= ci cj) 0.0 (* R R)))

(define (p-overlap a b ci cj R)
  (let* ((p (+ a b)) (mu (/ (* a b) p)))
    (* (expt (/ pi p) 1.5) (exp (* (- mu) (d2c ci cj R))))))

(define (p-kinetic a b ci cj R)
  (let* ((p (+ a b)) (mu (/ (* a b) p)) (d2 (d2c ci cj R)))
    (* (expt (/ pi p) 1.5) (exp (* (- mu) d2))
       mu (- 3.0 (* 2.0 mu d2)))))

(define (p-nuclear a b ci cj cc R)
  (let* ((p (+ a b))
         (mu (/ (* a b) p))
         (pz (/ (+ (* a (zc ci R)) (* b (zc cj R))) p))
         (dd (- pz (zc cc R))))
    (* (- (/ (* 2.0 pi) p))
       (exp (* (- mu) (d2c ci cj R)))
       (boys0 (* p dd dd)))))

(define (p-eri a b c d ca cb cc cd R)
  (let* ((p (+ a b))
         (q (+ c d))
         (muab (/ (* a b) p))
         (mucd (/ (* c d) q))
         (pz (/ (+ (* a (zc ca R)) (* b (zc cb R))) p))
         (qz (/ (+ (* c (zc cc R)) (* d (zc cd R))) q))
         (e (- pz qz)))
    (* (/ (* 2.0 (expt pi 2.5)) (* p q (sqrt (+ p q))))
       (exp (* (- muab) (d2c ca cb R)))
       (exp (* (- mucd) (d2c cc cd R)))
       (boys0 (* (/ (* p q) (+ p q)) e e)))))

(define (sum-range n f)
  (let loop ((i 0) (acc 0.0))
    (if (>= i n) acc (loop (+ i 1) (+ acc (f i))))))

(define (ao-1e fn ci cj R)
  (sum-range
   9
   (lambda (idx)
     (let ((i (modulo idx 3)) (j (quotient idx 3)))
       (* (list-ref dn i) (list-ref dn j)
          (fn (list-ref exps i) (list-ref exps j) ci cj R))))))

(define (ao-nuclear ci cj R)
  (+ (ao-1e (lambda (a b ci cj R) (p-nuclear a b ci cj 0 R)) ci cj R)
     (ao-1e (lambda (a b ci cj R) (p-nuclear a b ci cj 1 R)) ci cj R)))

(define (ao-eri ca cb cc cd R)
  (sum-range
   81
   (lambda (idx)
     (let ((i (modulo idx 3))
           (j (modulo (quotient idx 3) 3))
           (k (modulo (quotient idx 9) 3))
           (l (quotient idx 27)))
       (* (list-ref dn i) (list-ref dn j)
          (list-ref dn k) (list-ref dn l)
          (p-eri (list-ref exps i) (list-ref exps j)
                 (list-ref exps k) (list-ref exps l)
                 ca cb cc cd R))))))

(define (mo-eri v1 v2 v3 v4 R)
  (sum-range
   16
   (lambda (idx)
     (let ((a (modulo idx 2))
           (b (modulo (quotient idx 2) 2))
           (c (modulo (quotient idx 4) 2))
           (d (quotient idx 8)))
       (* (list-ref v1 a) (list-ref v2 b)
          (list-ref v3 c) (list-ref v4 d)
          (ao-eri a b c d R))))))

;; H11, H22, H12, and open-shell energy -> five H2 Pauli coefficients.
(define (Hterms R)
  (let* ((s (ao-1e p-overlap 0 1 R))
         (hAA (+ (ao-1e p-kinetic 0 0 R) (ao-nuclear 0 0 R)))
         (hAB (+ (ao-1e p-kinetic 0 1 R) (ao-nuclear 0 1 R)))
         (hgg (/ (+ hAA hAB) (+ 1.0 s)))
         (huu (/ (- hAA hAB) (- 1.0 s)))
         (cg (/ 1.0 (sqrt (* 2.0 (+ 1.0 s)))))
         (cu (/ 1.0 (sqrt (* 2.0 (- 1.0 s)))))
         (gv (list cg cg))
         (uv (list cu (- cu))))
    (list (+ (* 2.0 hgg) (mo-eri gv gv gv gv R))
          (+ (* 2.0 huu) (mo-eri uv uv uv uv R))
          (mo-eri gv uv gv uv R)
          (+ hgg huu (mo-eri gv gv uv uv R)))))

(define (g0f R)
  (let ((h (Hterms R)))
    (* 0.5 (+ (list-ref h 3) (* 0.5 (+ (list-ref h 0) (list-ref h 1)))))))
(define (g1f R)
  (let ((h (Hterms R))) (* 0.25 (- (list-ref h 1) (list-ref h 0)))))
(define (g2f R)
  (let ((h (Hterms R))) (* 0.25 (- (list-ref h 0) (list-ref h 1)))))
(define (g3f R)
  (let ((h (Hterms R)))
    (* 0.5 (- (list-ref h 3) (* 0.5 (+ (list-ref h 0) (list-ref h 1)))))))
(define (g4f R) (list-ref (Hterms R) 2))

(define (energy R)
  (let ((h (Hterms R)))
    (let ((m (/ (+ (list-ref h 0) (list-ref h 1)) 2.0))
          (dd (/ (- (list-ref h 0) (list-ref h 1)) 2.0)))
      (+ (- m (sqrt (+ (* dd dd)
                       (* (list-ref h 2) (list-ref h 2)))))
         (/ 1.0 R)))))

(define (vsub u v)
  (vector (- (vector-ref u 0) (vector-ref v 0))
          (- (vector-ref u 1) (vector-ref v 1))
          (- (vector-ref u 2) (vector-ref v 2))
          (- (vector-ref u 3) (vector-ref v 3))))
(define (vscale s v)
  (vector (* s (vector-ref v 0)) (* s (vector-ref v 1))
          (* s (vector-ref v 2)) (* s (vector-ref v 3))))
(define (vdot u v)
  (+ (* (vector-ref u 0) (vector-ref v 0))
     (* (vector-ref u 1) (vector-ref v 1))
     (* (vector-ref u 2) (vector-ref v 2))
     (* (vector-ref u 3) (vector-ref v 3))))
(define (copy4 v)
  (vector (vector-ref v 0) (vector-ref v 1)
          (vector-ref v 2) (vector-ref v 3)))
(define (perturb theta index epsilon)
  (let ((out (copy4 theta)))
    (vector-set! out index (+ (vector-ref theta index) epsilon))
    out))

;; Gaussian elimination for the four-parameter response equation.
(define (solve4 A b)
  (let ((x (make-vector 4 0.0)))
    (let columns ((column 0))
      (if (< column 4)
          (let ((diagonal (vector-ref (vector-ref A column) column)))
            (let rows ((row (+ column 1)))
              (if (< row 4)
                  (let ((factor (/ (vector-ref (vector-ref A row) column)
                                   diagonal)))
                    (let entries ((entry column))
                      (if (< entry 4)
                          (begin
                            (vector-set!
                             (vector-ref A row)
                             entry
                             (- (vector-ref (vector-ref A row) entry)
                                (* factor
                                   (vector-ref (vector-ref A column) entry))))
                            (entries (+ entry 1)))
                          #f))
                    (vector-set! b row
                                 (- (vector-ref b row)
                                    (* factor (vector-ref b column))))
                    (rows (+ row 1)))
                  #f))
            (columns (+ column 1)))
          #f))
    (let back ((i 3))
      (if (>= i 0)
          (let ((sum (vector-ref b i)))
            (let entries ((j (+ i 1)))
              (if (< j 4)
                  (begin
                    (set! sum
                          (- sum (* (vector-ref (vector-ref A i) j)
                                    (vector-ref x j))))
                    (entries (+ j 1)))
                  #f))
            (vector-set! x i (/ sum (vector-ref (vector-ref A i) i)))
            (back (- i 1)))
          #f))
    x))

(define R*
  (let loop ((R 1.40) (i 0))
    (if (>= i 8)
        R
        (loop (- R (/ (derivative-n energy R 1)
                      (derivative-n energy R 2)))
              (+ i 1)))))

(define pauli-operators (vector "II" "IZ" "ZI" "ZZ" "XX"))
(define (coefficients-at derivative-order)
  (vector (derivative-n g0f R* derivative-order)
          (derivative-n g1f R* derivative-order)
          (derivative-n g2f R* derivative-order)
          (derivative-n g3f R* derivative-order)
          (derivative-n g4f R* derivative-order)))

(define H
  (make-pauli-hamiltonian
   (vector (g0f R*) (g1f R*) (g2f R*) (g3f R*) (g4f R*))
   pauli-operators
   (/ 1.0 R*)
   2))
(define Hp (make-pauli-hamiltonian (coefficients-at 1) pauli-operators 0.0 2))
(define Hpp (make-pauli-hamiltonian (coefficients-at 2) pauli-operators 0.0 2))

(define theta*
  (let loop ((theta (vector 0.1 0.2 0.3 0.4)) (i 0))
    (if (>= i 400)
        theta
        (loop (vsub theta (vscale 0.2 (vqe-gradient H theta))) (+ i 1)))))

(define frozen-electronic (vqe-energy Hpp theta*))
(define EtR (vqe-gradient Hp theta*))
(define epsilon 1.0e-4)
(define Ett
  (vector (make-vector 4 0.0) (make-vector 4 0.0)
          (make-vector 4 0.0) (make-vector 4 0.0)))

(let columns ((b 0))
  (if (< b 4)
      (let ((gp (vqe-gradient H (perturb theta* b epsilon)))
            (gm (vqe-gradient H (perturb theta* b (- epsilon)))))
        (let rows ((a 0))
          (if (< a 4)
              (begin
                (vector-set! (vector-ref Ett a) b
                             (/ (- (vector-ref gp a) (vector-ref gm a))
                                (* 2.0 epsilon)))
                (rows (+ a 1)))
              #f))
        (columns (+ b 1)))
      #f))

;; The one-layer HEA has a gauge-redundant angle: its Hessian row and mixed
;; response component are both exactly zero. A tiny Tikhonov shift selects the
;; zero response in that null direction while leaving the physical subspace
;; unchanged to displayed precision.
(define response-regularization 1.0e-10)
(let regularize ((i 0))
  (if (< i 4)
      (begin
        (vector-set! (vector-ref Ett i) i
                     (+ (vector-ref (vector-ref Ett i) i)
                        response-regularization))
        (regularize (+ i 1)))
      #f))

(define response (- (vdot EtR (solve4 Ett (copy4 EtR)))))
(define nuclear-second (/ 2.0 (* R* R* R*)))
(define k (+ frozen-electronic nuclear-second response))
(define mu (/ 1836.15267343 2.0))
(define omega (* (sqrt (/ k mu)) 219474.6313702))

(hamiltonian-destroy! H)
(hamiltonian-destroy! Hp)
(hamiltonian-destroy! Hpp)

(display "=== H2 vibration: Eshkol AD plus Moonlab quantum response ===") (newline)
(display "equilibrium R*        = ") (display R*) (display " bohr") (newline)
(display "frozen term           = ") (display (+ frozen-electronic nuclear-second))
(display " Ha/bohr^2") (newline)
(display "quantum response      = ") (display response) (display " Ha/bohr^2") (newline)
(display "force constant k      = ") (display k) (display " Ha/bohr^2") (newline)
(display "vibrational frequency = ") (display omega) (display " cm^-1") (newline)
