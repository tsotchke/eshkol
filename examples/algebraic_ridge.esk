;; Exact ridge coefficient, regularization sensitivity and reverse pullback.
(require stdlib)
(require core.ad.algebraic_ridge)
(define field (make-algebraic-field '(-2 0 1) 3 1))
(define data (zset-singleton (vector 1 2) 1))
(define domain (algebraic-domain field))
(define same (algebraic-domain-ref domain 'equal?))
(define zero (algebraic-element field 0))
(define one (algebraic-element field 1))
(define state (algebraic-ridge-new field 1 one data))
(define initial (algebraic-ridge-output state))
(if (not (and (same (vector-ref (vector-ref initial 0) 0) one)
              (same (vector-ref (vector-ref initial 1) 0) (algebraic-element field -1/2))
              (same (vector-ref initial 2) (algebraic-element field 2))))
    (error "Initial exact ridge fit or sensitivity differs from closed form"))
(display "Exact ridge coefficient, sensitivity, objective and pullback: PASS") (newline)
(display "RESULT: PASS") (newline)