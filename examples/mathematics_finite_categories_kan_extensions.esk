;; Finite categories as computations: categories from generators and
;; relations, functors and natural transformations checked rather than
;; assumed, limits and colimits over finite diagrams built as objects, Kan
;; extensions along functors of finite categories with the adjunctions
;; verified by their triangle identities, the Grothendieck construction of
;; a presheaf of sets with its fibration, and sheaf cohomology on a finite
;; space recovered as the right derived functors of the limit functor on a
;; presheaf category. Everything is computed on small categories where the
;; answers are known, so every construction is checked against the theory.
;;
;; Sources: S. Mac Lane, "Categories for the Working Mathematician", 2nd
;; ed. (1998), III (limits), IV (adjoints), X (Kan extensions: the pointwise
;; formula Lan_F G(d) = colim_{(c, F c -> d)} G c and Ran_F G(d) =
;; lim_{(c, d -> F c)} G c, X.3); E. Riehl, "Category Theory in Context"
;; (2016), 6.2 (Kan extensions computed as (co)limits over comma categories)
;; and 4.5 (adjunctions from Kan extensions); A. Grothendieck, SGA 1, VI
;; (the Grothendieck construction); C. Weibel, "An Introduction to
;; Homological Algebra" (1994), 2.6 (lim^n as the right derived functors of
;; lim over a poset, computed by the cosimplicial replacement); M. C. McCord
;; (1966) and J. A. Barmak, LNM 2032 (2011) for the finite spaces.
;;
;; The categories, functors, comma categories, limits, colimits, Kan
;; extensions and their units and counits come from core.category
;; (docs/reference/stdlib/category.md), on the finite-category
;; representation of core.sheaf.site. Presentations enumerate words and
;; quotient by a normal form; functors are arrow maps checked on composites
;; and identities; Set-valued functors carry a finite set per object and a
;; function per arrow, so limits are compatible families, colimits are
;; quotients of coproducts by the zigzag relation, and a Kan extension is a
;; limit or colimit over a comma category, itself a finite category.
;;
;;   1. The walking arrow, the parallel pair, the span and cospan, the
;;      commutative square, the posets of the pseudocircle, its cone and the
;;      pseudo-2-sphere, and Z/2 and Z/3 as one-object categories are built
;;      from presentations; arrow counts, compositions and identities checked.
;;   2. Products, equalizers, pullbacks, coequalizers and pushouts of finite
;;      sets computed as limits and colimits over the corresponding shapes
;;      agree with the direct constructions (cardinalities and the universal
;;      property tested against every cone from a probe object).
;;   3. Left and right Kan extensions along the collapse of Z/2 to the point
;;      (orbits and fixed points: regular set 1 and 0, trivial 2-element set
;;      2 and 2), along the inclusion of the pseudocircle into its cone (at
;;      the top Lan is the colimit of G, Ran the terminal set) and along the
;;      walking arrow into the commutative square (Lan pushes G forward
;;      along b and along the identified composite, Ran fills the rest with
;;      terminal sets), all computed pointwise over comma categories built
;;      as finite categories; the unit of Lan -| F^* is constructed and
;;      checked natural, the counit is constructed, and both triangle
;;      identities hold on every component.
;;   4. The Grothendieck construction of a presheaf of sets on the
;;      pseudocircle is a finite category with the expected object count,
;;      and the discrete fibration condition (unique lifts) holds on every
;;      arrow.
;;   5. The cosimplicial replacement of the constant presheaf Z on the
;;      pseudocircle and on the pseudo-2-sphere (the nerve of the poset)
;;      recovers lim^0, lim^1, lim^2 = (Z, Z), (Z, 0, Z), i.e. the sheaf
;;      cohomology of the earlier examples, now as derived functors of lim
;;      on the presheaf category; core.sheaf's derived limits agree.

(require stdlib)
(require core.category.kan)
(require core.sheaf.cohomology)

(define pass-count 0)
(define fail-count 0)
(define (check label ok)
  (if ok
      (begin (set! pass-count (+ pass-count 1)) (display "PASS: ") (display label) (newline))
      (begin (set! fail-count (+ fail-count 1)) (display "FAIL: ") (display label) (newline))))
(define (show label v) (display "  ") (display label) (display " = ") (display v) (newline))
(define (range n) (iota n))
(define (all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (all? pred (cdr xs))) (else #f)))
(define (dedup xs) (let loop ((l xs) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (else (loop (cdr l) (cons (car l) acc))))))

;; --- 1. finite categories --------------------------------------------------------------------------------------
(define walking-arrow (walking-arrow-category))
(define parallel-pair (parallel-pair-category))
(define span-shape (span-category))
(define cospan-shape (cospan-category))
(define square (commutative-square-category))
;; posets as categories: pseudocircle S (a, b < c, d), its cone (adds a top 4), the pseudo-2-sphere
(define (poset-from-covers n covers) (let ((X (make-finite-space n covers))) (poset-category n (lambda (x y) (finite-space-leq? X x y)))))
(define S (poset-from-covers 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3))))
(define ConeS (poset-from-covers 5 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3) (cons 2 4) (cons 3 4))))
(define S2 (poset-from-covers 6 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3) (cons 2 4) (cons 3 4) (cons 2 5) (cons 3 5))))
;; the groups Z/2 and Z/3 as one-object categories and the terminal category
(define BZ2 (cyclic-group-category 2))
(define point (terminal-category))
(define BZ3 (cyclic-group-category 3))
(define cats (list walking-arrow parallel-pair span-shape cospan-shape square S ConeS S2 BZ2 point))
(show "arrow counts: walking arrow, parallel pair, span, cospan, square, S, cone(S), S^2, BZ/2, point" (map category-arrow-count cats))
(check "arrow counts 3, 4, 5, 5, 9, 8, 13, 18, 2, 1 and the category laws hold in every one"
       (and (equal? (map category-arrow-count cats) (list 3 4 5 5 9 8 13 18 2 1)) (all? category-laws? cats)))
(check "the square has exactly one arrow 0 -> 3 (c a = d b identified) and Z/3 as a one-object category has 3 arrows with x o x o x = id"
       (and (= 1 (length (category-hom square 0 3))) (= 3 (category-arrow-count BZ3)) (category-laws? BZ3)
            (= (category-identity BZ3 0) (category-compose BZ3 1 (category-compose BZ3 1 1)))))

;; --- 2. limits and colimits of Set-valued functors over finite shapes --------------------------------------------
(define A (list 'a1 'a2 'a3)) (define B (list 'b1 'b2))
(define X-prod (make-set-functor (discrete-category 2) (list A B) (lambda (a x) x)))
(check "the product A x B as a limit over the discrete two-object category has 6 elements" (= 6 (set-limit-size X-prod)))
;; equalizer of f, g: A -> B with f = (0 1 0), g = (0 1 1): agree on a1, a2
(define X-eq (make-set-functor-from-names parallel-pair (list A B) (list (cons (list 0) (vector 0 1 0)) (cons (list 1) (vector 0 1 1)))))
(check "the equalizer of f = (b1 b2 b1) and g = (b1 b2 b2) is {a1, a2}: the limit over the parallel pair has 2 elements and the coequalizer identifies b1 ~ b2 to 1 element"
       (and (set-functor-functorial? X-eq) (= 2 (set-limit-size X-eq)) (= 1 (set-colimit-size (set-colimit X-eq)))))
;; pullback of l: A -> P and r: B -> P over P = {p1, p2}: l = (0 0 1), r = (1 0)
(define P (list 'p1 'p2))
(define X-pb (make-set-functor-from-names cospan-shape (list P A B) (list (cons (list 0) (vector 0 0 1)) (cons (list 1) (vector 1 0)))))
(check "the pullback of l = (p1 p1 p2) and r = (p2 p1) has 3 elements (a1 b2, a2 b2, a3 b1)" (and (set-functor-functorial? X-pb) (= 3 (set-limit-size X-pb))))
;; pushout of l: P -> A and r: P -> B: l = (0 0), r = (0 1): glue a1 ~ b1 ~ b2
(define X-po (make-set-functor-from-names span-shape (list P A B) (list (cons (list 0) (vector 0 0)) (cons (list 1) (vector 0 1)))))
(check "the pushout of l = (a1 a1) and r = (b1 b2) has 3 elements (a1 ~ b1 ~ b2, a2, a3)" (and (set-functor-functorial? X-po) (= 3 (set-colimit-size (set-colimit X-po)))))
;; universal property of the pullback tested against every cone from a probe set of size 2
(check "universal property: the cones from a 2-element probe to the pullback diagram are exactly the maps into the limit, 3^2 = 9 of them"
       (= (set-cone-count X-pb 2) (let ((L (set-limit-size X-pb))) (* L L))))

;; --- 3. pointwise Kan extensions over comma categories --------------------------------------------------------------
;; 3a. along the collapse BZ/2 -> point: Lan = orbits, Ran = fixed points
(define collapse (terminal-functor BZ2))
(define incl (functor-from-procedures S ConeS (lambda (x) x) (lambda (a) (category-thin-arrow ConeS (arrow-source S a) (arrow-target S a)))))
(check "the collapse BZ/2 -> point is a functor and the inclusion of the pseudocircle into its cone is a functor"
       (and (functor-laws? collapse) (functor-laws? incl)))
(define regular-z2 (make-set-functor-from-names BZ2 (list (list 'e 's)) (list (cons 1 (vector 1 0)))))
(define trivial-z2 (make-set-functor-from-names BZ2 (list (list 'p 'q)) (list (cons 1 (vector 0 1)))))
(check "regular and trivial Z/2-sets are functors" (and (set-functor-functorial? regular-z2) (set-functor-functorial? trivial-z2)))
(define (size-at X c) (set-functor-element-count X c))
(define orbit-fixed (map (lambda (X) (list (size-at (set-lan collapse X) 0) (size-at (set-ran collapse X) 0))) (list regular-z2 trivial-z2)))
(show "Lan and Ran along BZ/2 -> point: (orbits, fixed points) of the regular and the trivial 2-element Z/2-sets" orbit-fixed)
(check "left Kan extension = orbits, right Kan extension = fixed points: regular (1, 0), trivial (2, 2)"
       (equal? orbit-fixed (list (list 1 0) (list 2 2))))
;; 3b. along the inclusion of S into its cone: a functor on S (covariant on the poset a, b < c, d), sets at a, b of
;; size 2, at c, d of size 3, maps injections
(define G-S (make-set-functor-from-indices
             S (list (list 'a0 'a1) (list 'b0 'b1) (list 'c0 'c1 'c2) (list 'd0 'd1 'd2))
             (map (lambda (a) (let ((x (arrow-source S a)) (y (arrow-target S a)))
                                (cond ((= x y) (list->vector (range (if (< x 2) 2 3))))
                                      ((and (= x 0) (= y 2)) (vector 0 1)) ((and (= x 1) (= y 2)) (vector 1 2))
                                      ((and (= x 0) (= y 3)) (vector 0 2)) (else (vector 1 2)))))
                  (range (category-arrow-count S)))))
(check "G on the pseudocircle is a functor" (set-functor-functorial? G-S))
(define LanG (set-lan incl G-S))
(define RanG (set-ran incl G-S))
(show "Lan and Ran along S -> cone(S): sizes at a, b, c, d, top" (list (set-functor-sizes LanG) (set-functor-sizes RanG)))
(check "along a full inclusion both Kan extensions restrict to G (sizes 2, 2, 3, 3 at the old objects); at the top, which every object maps to, Lan is the colimit of G (2 classes: a0~c0~d0 and everything else) and Ran is the terminal set (the comma category (top down F) is empty), while lim G itself has no compatible family"
       (and (equal? (set-functor-sizes LanG) (list 2 2 3 3 2)) (equal? (set-functor-sizes RanG) (list 2 2 3 3 1))
            (= (size-at LanG 4) (set-colimit-size (set-colimit G-S))) (= 0 (set-limit-size G-S))))
(check "the Kan extensions are functors on the cone and the restriction of Lan along the inclusion is naturally isomorphic to G through the unit"
       (and (set-functor-functorial? LanG) (set-functor-functorial? RanG)
            (let ((eta (set-lan-unit incl G-S)))
              (and (set-natural? G-S (set-functor-restrict LanG incl) eta)
                   (all? (lambda (c) (= (length (dedup (vector->list (vector-ref eta c)))) (size-at G-S c))) (range 4))))))
;; the triangle identities for Lan -| F^*, eps_{Lan G} o Lan(eta_G) = id and F^*(eps) o eta_{F^*} = id, tested on
;; the collapse and on the inclusion (with Y = Lan G on the target)
(check "triangle identity eps_{Lan G} o Lan(eta_G) = id holds for Lan along the collapse (regular and trivial Z/2-sets) and along the inclusion S -> cone(S)"
       (and (null? (set-lan-adjunction-violations collapse regular-z2 (set-lan collapse regular-z2)))
            (null? (set-lan-adjunction-violations collapse trivial-z2 (set-lan collapse trivial-z2)))
            (null? (set-lan-adjunction-violations incl G-S LanG))))
;; 3c. along the walking arrow into the square (0 -> 1 as a: 0 -> 1): Ran at 3 is a limit over (3 down F) = empty
(define arrow-into-square
  (functor-from-procedures walking-arrow square (lambda (x) x)
                           (lambda (a) (if (= a (category-identity walking-arrow (arrow-source walking-arrow a)))
                                           (category-identity square (arrow-source walking-arrow a))
                                           (category-arrow-named square (list 0))))))
(check "the walking arrow embeds in the square along a" (functor-laws? arrow-into-square))
(define G-arrow (make-set-functor-from-names walking-arrow (list (list 'x0 'x1 'x2) (list 'y0 'y1)) (list (cons (list 0) (vector 0 1 1)))))
(define RanA (set-ran arrow-into-square G-arrow))
(define LanA (set-lan arrow-into-square G-arrow))
(show "Ran and Lan of a functor on the walking arrow, along a: 0 -> 1 into the square: sizes at 0, 1, 2, 3" (list (set-functor-sizes RanA) (set-functor-sizes LanA)))
(check "Ran: objects with no arrow into the image get the terminal set (2 and 3: sizes 3, 2, 1, 1); Lan: object 2 receives G(0) along b (3 elements) and object 3 the pushout of G(0) along f and c a = d b (2 elements): sizes 3, 2, 3, 2"
       (and (equal? (set-functor-sizes RanA) (list 3 2 1 1)) (equal? (set-functor-sizes LanA) (list 3 2 3 2))))

;; --- 4. the Grothendieck construction of a presheaf of sets ----------------------------------------------------------
;; for a Set-functor X on C the category of elements has objects (c, x in X c) and arrows (c, x) -> (c', X a x); the
;; projection to C is a discrete opfibration: unique lifts of arrows
(define El (elements-category G-S))
(check "the category of elements of G on the pseudocircle has 10 objects and 18 arrows (10 identities and 8 lifts), and the projection is a discrete opfibration (each arrow out of an object's image has exactly one lift)"
       (and (= 10 (category-object-count El)) (= 18 (category-arrow-count El)) (category-laws? El)
            (discrete-opfibration? (elements-projection G-S El))))

;; --- 5. derived functors of lim on a presheaf category: lim^n of the constant presheaf recovers sheaf cohomology ----------
;; the cosimplicial replacement over the poset category P is the cochain complex of the nerve of P with constant
;; coefficients; core.sheaf computes the same derived limits from the finite space
(define (lim-n P nmax) (map cadr (category-nerve-cohomology P nmax)))
(define limS (lim-n S 2))
(define limS2 (lim-n S2 3))
(define (derived-limits n covers nmax)
  (map cadr (poset-module-cohomology (constant-poset-module (make-finite-space n covers)) nmax)))
(show "lim^n of the constant presheaf over the pseudocircle and the pseudo-2-sphere (as F_p-dimensions)" (list limS limS2))
(check "derived limits recover sheaf cohomology: (1, 1, 0) for the pseudocircle and (1, 0, 1, 0) for the pseudo-2-sphere, the values of the finite-spaces example"
       (and (equal? limS (list 1 1 0)) (equal? limS2 (list 1 0 1 0))
            (all? (lambda (h) (null? (caddr h))) (append (category-nerve-cohomology S 2) (category-nerve-cohomology S2 3)))
            (equal? limS (derived-limits 4 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3)) 2))
            (equal? limS2 (derived-limits 6 (list (cons 0 2) (cons 1 2) (cons 0 3) (cons 1 3) (cons 2 4) (cons 3 4) (cons 2 5) (cons 3 5)) 3))))
(check "lim^0 agrees with the limit of the constant functor computed categorically: one compatible family on each connected poset"
       (and (= 1 (set-limit-size (constant-set-functor S (list 'z)))) (= 1 (set-limit-size (constant-set-functor S2 (list 'z))))))

(display "Finite categories as computations: presentations, limits, Kan extensions with their adjunctions, the Grothendieck construction, derived limits") (newline)
(display "Passed: ") (display pass-count) (newline)
(display "Failed: ") (display fail-count) (newline)
(if (= fail-count 0)
    (begin (display "RESULT: ALL PASS") (newline) (exit 0))
    (begin (display "RESULT: FAILURES DETECTED") (newline) (exit 1)))
