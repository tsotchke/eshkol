;; platform/window.esk — windows, pixel surfaces and events (ADR-0053).
;;
;; (require platform.window)
;;
;; A window owns an XRGB pixel surface (0xRRGGBB integers). Draw with
;; window-fill-rect! / window-set-pixel!, then window-present! copies the
;; surface to the display. Events are vectors read with the accessors below;
;; window-poll-event returns #f when none is queued.
;;
;; Backends: offscreen (always), X11 (Linux/BSD), Cocoa (macOS). Select with
;; ESHKOL_PLATFORM_DISPLAY=offscreen|x11|cocoa|auto or
;; (platform-select-backend! 'display "offscreen"). Opening a window requires
;; the 'display capability when a capability policy is installed.
;; Cocoa windows must be used from the main thread.

(require stdlib)
(require core.capabilities)

(provide window-create window-destroy! window? window-backend
         window-width window-height window-size window-position
         window-set-size! window-set-position! window-set-title!
         window-should-close? window-request-close!
         window-fill-rect! window-set-pixel! window-pixel window-clear!
         window-present! window-presented-pixel window-present-count
         window-dropped-events
         window-poll-event window-wait-event window-push-event!
         event? event-type event-timestamp event-window
         key-event? key-code key-scancode key-modifiers key-unicode key-pressed?
         mouse-event? mouse-x mouse-y mouse-dx mouse-dy mouse-button mouse-buttons
         scroll-x scroll-y
         window-event? event-width event-height event-x event-y
         user-event-code user-event-data1 user-event-data2
         rgb rgb-red rgb-green rgb-blue
         key-code-of modifier-shift modifier-ctrl modifier-alt modifier-meta
         button-left button-middle button-right
         platform-backend platform-select-backend! platform-error?)

(extern i64 -win-open ptr i32 i32 i32 :real eshkol_plat_window_open)
(extern i32 -win-close i64 :real eshkol_plat_window_close)
(extern i64 -win-query i64 i32 :real eshkol_plat_window_query)
(extern i32 -win-set i64 i32 i32 i32 :real eshkol_plat_window_set)
(extern i32 -win-set-title i64 ptr :real eshkol_plat_window_set_title)
(extern i32 -win-fill-rect i64 i32 i32 i32 i32 i64 :real eshkol_plat_window_fill_rect)
(extern i64 -win-get-pixel i64 i32 i32 :real eshkol_plat_window_get_pixel)
(extern i32 -win-present i64 :real eshkol_plat_window_present)
(extern i64 -win-read-presented i64 i32 i32 :real eshkol_plat_window_read_presented)
(extern i32 -win-next-event i64 i32 :real eshkol_plat_window_next_event)
(extern i64 -win-event-field i64 i32 :real eshkol_plat_window_event_field)
(extern i32 -win-push-event i64 i32 i64 i64 i64 :real eshkol_plat_window_push_event)
(extern i32 -plat-backend i32 :real eshkol_plat_backend)
(extern ptr -plat-backend-name i32 :real eshkol_plat_backend_name)
(extern i32 -plat-select-backend i32 ptr :real eshkol_plat_select_backend)

;; ── status handling ──────────────────────────────────────────────────

(define -plat-status-names
  (vector "ok" "invalid argument" "out of memory" "backend unavailable" "device error"
          "invalid state" "handle busy" "not found" "queue full" "malformed data"))

(define (-plat-int x) (inexact->exact x))

(define (platform-error? v)
  (and (vector? v) (= (vector-length v) 3) (eq? (vector-ref v 0) 'platform-error)))

(define (-plat-check r who)
  ;; Integer results from the C bridge; negative values are status codes.
  (let ((n (-plat-int r)))
    (if (< n 0)
        (error (string-append (symbol->string who) ": "
                              (if (<= n -10) "error"
                                  (vector-ref -plat-status-names (- 0 n)))))
        n)))

(define (-plat-subsystem s)
  (cond ((eq? s 'display) 0) ((eq? s 'audio) 1) ((eq? s 'midi) 2)
        (else (error "platform: subsystem must be 'display, 'audio or 'midi" s))))

(define (platform-backend subsystem)
  "Name of the backend selected for 'display, 'audio or 'midi."
  (ptr->string (-plat-backend-name (-plat-backend (-plat-subsystem subsystem)))))

(define (platform-select-backend! subsystem name)
  "Select a backend by name (\"auto\" re-resolves)."
  (-plat-check (-plat-select-backend (-plat-subsystem subsystem) name)
               'platform-select-backend!)
  (platform-backend subsystem))

;; ── windows ──────────────────────────────────────────────────────────

(define (window? w)
  (and (vector? w) (= (vector-length w) 2) (eq? (vector-ref w 0) 'platform-window)))

(define (-wh w)
  (if (window? w) (vector-ref w 1) (error "platform.window: not a window" w)))

(define (-window-flags flags)
  (let loop ((fs flags) (acc 0))
    (if (null? fs) acc
        (loop (cdr fs)
              (+ acc (cond ((eq? (car fs) 'resizable) 1) ((eq? (car fs) 'borderless) 2)
                           ((eq? (car fs) 'fullscreen) 4) ((eq? (car fs) 'hidden) 8)
                           ((eq? (car fs) 'always-on-top) 16)
                           (else (error "window-create: unknown flag" (car fs)))))))))

(define (window-create title width height . flags)
  "Open a window; flags: 'resizable 'borderless 'fullscreen 'hidden 'always-on-top."
  (capability-require! 'display)
  (vector 'platform-window
          (-plat-check (-win-open title width height (-window-flags flags)) 'window-create)))

(define (window-destroy! w)
  (-plat-check (-win-close (-wh w)) 'window-destroy!)
  #t)

(define (-query w what who) (-plat-check (-win-query (-wh w) what) who))
(define (window-width w) (-query w 0 'window-width))
(define (window-height w) (-query w 1 'window-height))
(define (window-size w) (cons (window-width w) (window-height w)))
(define (window-position w) (cons (-query w 2 'window-position) (-query w 3 'window-position)))
(define (window-should-close? w) (= (-query w 4 'window-should-close?) 1))
(define (window-backend w)
  (ptr->string (-plat-backend-name (-query w 5 'window-backend))))
(define (window-present-count w) (-query w 6 'window-present-count))
(define (window-dropped-events w) (-query w 8 'window-dropped-events))

(define (window-set-size! w width height)
  (-plat-check (-win-set (-wh w) 0 width height) 'window-set-size!) #t)
(define (window-set-position! w x y)
  (-plat-check (-win-set (-wh w) 1 x y) 'window-set-position!) #t)
(define (window-request-close! w)
  (-plat-check (-win-set (-wh w) 2 0 0) 'window-request-close!) #t)
(define (window-set-title! w title)
  (-plat-check (-win-set-title (-wh w) title) 'window-set-title!) #t)

;; ── pixels ───────────────────────────────────────────────────────────

(define (rgb r g b) (+ (* 65536 r) (* 256 g) b))
(define (rgb-red c) (quotient c 65536))
(define (rgb-green c) (remainder (quotient c 256) 256))
(define (rgb-blue c) (remainder c 256))

(define (window-fill-rect! w x y width height color)
  (-plat-check (-win-fill-rect (-wh w) x y width height color) 'window-fill-rect!) #t)
(define (window-set-pixel! w x y color)
  (window-fill-rect! w x y 1 1 color))
(define (window-clear! w color)
  (window-fill-rect! w 0 0 (window-width w) (window-height w) color))
(define (window-pixel w x y)
  (-plat-check (-win-get-pixel (-wh w) x y) 'window-pixel))
(define (window-present! w)
  (-plat-check (-win-present (-wh w)) 'window-present!) #t)
(define (window-presented-pixel w x y)
  "Pixel the display backend last received (verifies the present path)."
  (-plat-check (-win-read-presented (-wh w) x y) 'window-presented-pixel))

;; ── events ───────────────────────────────────────────────────────────

(define -event-type-names
  (vector 'key-down 'key-up 'key-repeat 'text-input
          'mouse-move 'mouse-down 'mouse-up 'mouse-scroll 'mouse-enter 'mouse-leave
          'touch-begin 'touch-move 'touch-end 'touch-cancel
          'window-resize 'window-move 'window-close 'window-focus 'window-blur
          'window-show 'window-hide 'window-expose
          'quit 'timer))

(define (-type-symbol n)
  (cond ((and (>= n 0) (< n (vector-length -event-type-names))) (vector-ref -event-type-names n))
        ((= n 31) 'user)
        (else 'unknown)))

(define (-type-number s)
  (if (eq? s 'user) 31
      (let loop ((i 0))
        (cond ((= i (vector-length -event-type-names))
               (error "window-push-event!: unknown event type" s))
              ((eq? (vector-ref -event-type-names i) s) i)
              (else (loop (+ i 1)))))))

;; Event vector: #(platform-event type timestamp window keycode scancode
;;   modifiers unicode x y dx dy button buttons scroll-x scroll-y width height
;;   code data1 data2)
(define (-read-event h n)
  (let ((v (make-vector 21 0)))
    (vector-set! v 0 'platform-event)
    (vector-set! v 1 (-type-symbol n))
    (let loop ((f 1))
      (if (<= f 19)
          (begin (vector-set! v (+ f 1) (-plat-int (-win-event-field h f)))
                 (loop (+ f 1)))
          v))))

(define (-next-event w timeout who)
  (let* ((h (-wh w)) (n (-plat-int (-win-next-event h timeout))))
    (cond ((= n -1) #f)
          ((< n -1) (-plat-check (+ n 1) who))
          (else (-read-event h n)))))

(define (window-poll-event w)
  "Next queued event, or #f."
  (-next-event w 0 'window-poll-event))

(define (window-wait-event w . timeout-ms)
  "Wait for an event (optionally at most timeout-ms); #f on timeout."
  (-next-event w (if (null? timeout-ms) -1 (car timeout-ms)) 'window-wait-event))

(define (window-push-event! w type . args)
  "Queue an event: key (keycode modifiers unicode), mouse (x y button),
   window-resize (width height), window-move (x y), user (code data1 data2)."
  (let ((a (if (pair? args) (car args) 0))
        (b (if (and (pair? args) (pair? (cdr args))) (cadr args) 0))
        (c (if (and (pair? args) (pair? (cdr args)) (pair? (cddr args))) (caddr args) 0)))
    (-plat-check (-win-push-event (-wh w) (-type-number type) a b c) 'window-push-event!)
    #t))

(define (event? e) (and (vector? e) (= (vector-length e) 21) (eq? (vector-ref e 0) 'platform-event)))
(define (event-type e) (vector-ref e 1))
(define (event-timestamp e) (vector-ref e 2))
(define (event-window e) (vector-ref e 3))
(define (key-code e) (vector-ref e 4))
(define (key-scancode e) (vector-ref e 5))
(define (key-modifiers e) (vector-ref e 6))
(define (key-unicode e) (vector-ref e 7))
(define (mouse-x e) (vector-ref e 8))
(define (mouse-y e) (vector-ref e 9))
(define (event-x e) (vector-ref e 8))
(define (event-y e) (vector-ref e 9))
(define (mouse-dx e) (vector-ref e 10))
(define (mouse-dy e) (vector-ref e 11))
(define (mouse-button e) (vector-ref e 12))
(define (mouse-buttons e) (vector-ref e 13))
(define (scroll-x e) (vector-ref e 14))
(define (scroll-y e) (vector-ref e 15))
(define (event-width e) (vector-ref e 16))
(define (event-height e) (vector-ref e 17))
(define (user-event-code e) (vector-ref e 18))
(define (user-event-data1 e) (vector-ref e 19))
(define (user-event-data2 e) (vector-ref e 20))

(define (key-event? e)
  (and (event? e) (memq (event-type e) '(key-down key-up key-repeat text-input)) #t))
(define (key-pressed? e)
  (and (event? e) (memq (event-type e) '(key-down key-repeat)) #t))
(define (mouse-event? e)
  (and (event? e)
       (memq (event-type e) '(mouse-move mouse-down mouse-up mouse-scroll mouse-enter mouse-leave))
       #t))
(define (window-event? e)
  (and (event? e)
       (memq (event-type e) '(window-resize window-move window-close window-focus window-blur
                              window-show window-hide window-expose))
       #t))

;; Key codes: printable keys are their unshifted character; others below.
(define (key-code-of name)
  (cond ((char? name) (char->integer (char-downcase name)))
        ((eq? name 'backspace) 8) ((eq? name 'tab) 9) ((eq? name 'return) 13)
        ((eq? name 'escape) 27) ((eq? name 'space) 32) ((eq? name 'delete) 127)
        ((eq? name 'left) 4097) ((eq? name 'right) 4098) ((eq? name 'up) 4099)
        ((eq? name 'down) 4100) ((eq? name 'home) 4101) ((eq? name 'end) 4102)
        ((eq? name 'page-up) 4103) ((eq? name 'page-down) 4104) ((eq? name 'insert) 4105)
        ((eq? name 'shift) 4609) ((eq? name 'ctrl) 4610) ((eq? name 'alt) 4611)
        ((eq? name 'meta) 4612) ((eq? name 'caps-lock) 4613)
        (else (error "key-code-of: unknown key" name))))

(define modifier-shift 1)
(define modifier-ctrl 2)
(define modifier-alt 4)
(define modifier-meta 8)
(define button-left 1)
(define button-middle 2)
(define button-right 3)
