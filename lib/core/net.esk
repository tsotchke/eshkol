;; Numeric IPv4/IPv6 TCP and UDP. Bounded operations; no implicit DNS.
(require stdlib)
(require core.capabilities)
(provide tcp-listen tcp-connect tcp-accept tcp-read tcp-write tcp-close
         udp-bind udp-sendto udp-recvfrom udp-close
         net-local-address net-peer-address net-local-port net-peer-port
         net-nonblocking! network-error? network-error-code network-error-operation)
(extern ptr -net-alloc i64 :real malloc)
(extern void -net-free ptr :real free)
(extern i64 -net-open ptr i32 i32 i32 :real eshkol_net_open)
(extern i64 -net-accept i64 i32 :real eshkol_net_accept)
(extern i32 -net-read i64 ptr i32 i32 :real eshkol_net_read)
(extern i32 -net-write i64 ptr i32 i32 :real eshkol_net_write)
(extern i32 -net-sendto i64 ptr i32 ptr i32 i32 :real eshkol_net_sendto)
(extern i32 -net-recvfrom i64 ptr i32 ptr i32 i32 :real eshkol_net_recvfrom)
(extern i32 -net-address i64 i32 ptr i32 :real eshkol_net_address)
(extern i32 -net-port i64 i32 :real eshkol_net_port)
(extern i32 -net-nonblocking i64 i32 :real eshkol_net_nonblocking)
(extern i32 -net-close i64 :real eshkol_net_close)

(define (network-error? v)
  (and (vector? v) (= (vector-length v) 3) (eq? (vector-ref v 0) 'network-error)))
(define (network-error-code v) (vector-ref v 1))
(define (network-error-operation v) (vector-ref v 2))
;; Keep ports, counts and error codes exact across generic FFI numeric boxing.
(define (-net-result n op)
  (if (< n 0) (vector 'network-error (inexact->exact n) op) (inexact->exact n)))
(define (-net-int? n minimum maximum)
  (and (integer? n) (exact? n) (>= n minimum) (<= n maximum)))
(define (-net-timeout? n) (-net-int? n 0 2147483647))
(define (-net-handle? n) (-net-int? n 1 9007199254740991))
(define (-net-host? host)
  (and (string? host) (> (string-length host) 0) (<= (string-length host) 45)
       (let loop ((i 0))
         (if (= i (string-length host)) #t
             (and (not (= (char->integer (string-ref host i)) 0)) (loop (+ i 1)))))))
(define (-net-create host port kind timeout op)
  (capability-require! 'network host port)
  (if (and (-net-host? host) (-net-int? port 0 65535) (-net-timeout? timeout))
      (-net-result (-net-open host port kind timeout) op)
      (-net-result -4 op)))
(define (tcp-listen host port)
  "Listen on a numeric address; port zero chooses an ephemeral port."
  (-net-create host port 1 0 'tcp-listen))
(define (tcp-connect host port timeout-ms)
  "Connect within timeout-ms; return a handle or a network error."
  (-net-create host port 2 timeout-ms 'tcp-connect))
(define (udp-bind host port)
  "Bind a datagram socket on a numeric address."
  (-net-create host port 3 0 'udp-bind))
(define (tcp-accept h timeout-ms)
  (capability-require! 'network)
  (if (and (-net-handle? h) (-net-timeout? timeout-ms))
      (-net-result (-net-accept h timeout-ms) 'tcp-accept)
      (-net-result -4 'tcp-accept)))
(define (tcp-read h capacity timeout-ms)
  "Read up to capacity bytes; empty string means EOF, error -2 means timeout."
  (capability-require! 'network)
  (if (and (-net-handle? h) (-net-int? capacity 1 1048576) (-net-timeout? timeout-ms))
      (let ((buf (-net-alloc capacity)))
        (if (= (ptr->usize buf) 0) (-net-result -1 'tcp-read)
            (let* ((n (-net-read h buf capacity timeout-ms))
                   (result (if (< n 0) (-net-result n 'tcp-read) (ptr->string-n buf (inexact->exact n)))))
              (-net-free buf) result)))
      (-net-result -4 'tcp-read)))
(define (tcp-write h data timeout-ms)
  "Write bytes; may return a partial byte count. Caller sends the remainder."
  (capability-require! 'network)
  (if (and (-net-handle? h) (string? data) (<= (string-byte-length data) 1048576)
           (-net-timeout? timeout-ms))
      (-net-result (-net-write h data (string-byte-length data) timeout-ms) 'tcp-write)
      (-net-result -4 'tcp-write)))
(define (udp-sendto h host port data timeout-ms)
  (capability-require! 'network host port)
  (if (and (-net-handle? h) (-net-host? host) (-net-int? port 0 65535)
           (string? data) (<= (string-byte-length data) 65507) (-net-timeout? timeout-ms))
      (-net-result (-net-sendto h host port data (string-byte-length data) timeout-ms) 'udp-sendto)
      (-net-result -4 'udp-sendto)))
(define (udp-recvfrom h capacity timeout-ms)
  "Return #(payload numeric-peer-endpoint), or a network error. Truncation refuses."
  (capability-require! 'network)
  (if (and (-net-handle? h) (-net-int? capacity 1 65535) (-net-timeout? timeout-ms))
      (let ((buf (-net-alloc capacity)) (peer (-net-alloc 64)))
        (if (or (= (ptr->usize buf) 0) (= (ptr->usize peer) 0))
            (begin (-net-free buf) (-net-free peer) (-net-result -1 'udp-recvfrom))
            (let* ((n (-net-recvfrom h buf capacity peer 64 timeout-ms))
                   (result (if (< n 0) (-net-result n 'udp-recvfrom)
                               (vector (ptr->string-n buf (inexact->exact n)) (ptr->string peer)))))
              (-net-free buf) (-net-free peer) result)))
      (-net-result -4 'udp-recvfrom)))
(define (-net-get-address h peer op)
  (if (-net-handle? h)
      (let ((buf (-net-alloc 64)))
        (if (= (ptr->usize buf) 0) (-net-result -1 op)
            (let* ((n (-net-address h peer buf 64))
                   (result (if (< n 0) (-net-result n op) (ptr->string-n buf (inexact->exact n)))))
              (-net-free buf) result)))
      (-net-result -4 op)))
(define (net-local-address h) (-net-get-address h 0 'net-local-address))
(define (net-peer-address h) (-net-get-address h 1 'net-peer-address))
(define (net-local-port h)
  (if (-net-handle? h) (-net-result (-net-port h 0) 'net-local-port) (-net-result -4 'net-local-port)))
(define (net-peer-port h)
  (if (-net-handle? h) (-net-result (-net-port h 1) 'net-peer-port) (-net-result -4 'net-peer-port)))
(define (net-nonblocking! h enabled)
  (if (and (-net-handle? h) (boolean? enabled))
      (-net-result (-net-nonblocking h (if enabled 1 0)) 'net-nonblocking!)
      (-net-result -4 'net-nonblocking!)))
(define (tcp-close h)
  (if (-net-handle? h) (-net-result (-net-close h) 'tcp-close) (-net-result -4 'tcp-close)))
(define (udp-close h)
  (if (-net-handle? h) (-net-result (-net-close h) 'udp-close) (-net-result -4 'udp-close)))
