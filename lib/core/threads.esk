;; threads.esk — thread coordination primitives
;;
;; (require core.threads)
;;
;; This module provides five families of primitives, all built on one
;; facility: the recursive mutex and condition variable below.  Counting
;; semaphores and reusable barriers are ordinary Eshkol state guarded by
;; that pair; the only primitive they add to lib/core/threads.c is the
;; bounded wait condvar-wait-timeout!.
;;
;; 1. MUTEX (recursive POSIX pthread_mutex_t)
;;    Used to serialise access to shared state — the canonical use is
;;    around a (vector-set! ...) on a shared cell from inside
;;    parallel-map workers.  RECURSIVE means re-entering (with-mutex m
;;    ...) on the same mutex from the same thread doesn't deadlock —
;;    matches SRFI 18 semantics.
;;
;; 2. CONDVAR (POSIX pthread_cond_t)
;;    Used to coordinate workers waiting on a state change — pair with
;;    a mutex via condvar-wait!.
;;
;; 3. SEMAPHORE (counting; make-semaphore / semaphore-acquire! /
;;    semaphore-try-acquire! / semaphore-release!)
;;    Bounds how many threads may hold a resource at once.  Acquire
;;    blocks while no permit is free; try-acquire returns #f instead,
;;    or waits at most a given number of milliseconds.
;;
;; 4. BARRIER (reusable, generation-counted; make-barrier / barrier-wait!)
;;    N parties meet at barrier-wait!; none returns until all N have
;;    arrived.  Each completed meeting advances the barrier's generation,
;;    so the same barrier serves any number of phases, and a waiter
;;    returns only when its own generation has completed — a spurious
;;    wakeup or a later phase's arrivals can never release it early.
;;
;; 5. THREAD (make-thread / thread-join)
;;    Spawns the thunk on a thread-pool worker concurrently with the
;;    spawner; thread-join blocks until the worker completes.  Backed
;;    by `(future thunk)` which (since #223 + #224 architectural fix)
;;    eagerly submits to the pool with thread-safe closure capture.
;;    Also useful: `(parallel-map fn list)` for concurrent map and
;;    `(parallel-execute t1 t2 ...)` for a fixed set of thunks where
;;    you want the joined results as a list.

(provide
  make-mutex mutex-lock! mutex-trylock! mutex-unlock! mutex-destroy! with-mutex
  make-condvar condvar-wait! condvar-wait-timeout! condvar-signal!
  condvar-broadcast! condvar-destroy!
  make-semaphore semaphore? semaphore-acquire! semaphore-try-acquire!
  semaphore-release! semaphore-value semaphore-destroy!
  make-barrier barrier? barrier-wait! barrier-parties barrier-generation
  barrier-destroy!
  make-thread thread-join thread? thread-result-ready?)

;; ── FFI declarations ─────────────────────────────────────────────────
(extern ptr mutex-create-raw                         :real eshkol_mutex_create)
(extern i32 mutex-lock-raw       ptr                 :real eshkol_mutex_lock)
(extern i32 mutex-trylock-raw    ptr                 :real eshkol_mutex_trylock)
(extern i32 mutex-unlock-raw     ptr                 :real eshkol_mutex_unlock)
(extern i32 mutex-destroy-raw    ptr                 :real eshkol_mutex_destroy)

(extern ptr condvar-create-raw                       :real eshkol_condvar_create)
(extern i32 condvar-wait-raw     ptr ptr             :real eshkol_condvar_wait)
(extern i32 condvar-timedwait-raw ptr ptr i64        :real eshkol_condvar_timedwait)
(extern i32 condvar-timeout-code-raw                 :real eshkol_condvar_timeout_code)
(extern i32 condvar-signal-raw   ptr                 :real eshkol_condvar_signal)
(extern i32 condvar-broadcast-raw ptr                :real eshkol_condvar_broadcast)
(extern i32 condvar-destroy-raw  ptr                 :real eshkol_condvar_destroy)

;; ── Mutex ────────────────────────────────────────────────────────────

(define (make-mutex)
  "Create a recursive POSIX mutex.  Returns an opaque pointer.  Caller
   is responsible for the matching (mutex-destroy! m) — or just rely on
   process exit if the mutex's lifetime spans the whole program."
  (mutex-create-raw))

(define (mutex-lock! m)
  "Block until the mutex is acquired.  Returns 0 on success or an
   errno value on failure."
  (mutex-lock-raw m))

(define (mutex-trylock! m)
  "Non-blocking lock attempt.  Returns 0 if acquired, EBUSY (16 on
   macOS / Linux) if already held by another thread, or another errno."
  (mutex-trylock-raw m))

(define (mutex-unlock! m)
  "Release the mutex.  Returns 0 on success."
  (mutex-unlock-raw m))

(define (mutex-destroy! m)
  "Destroy and free the mutex.  Caller MUST NOT use m after this."
  (mutex-destroy-raw m))

(define (with-mutex m thunk)
  "Acquire m, invoke (thunk), release m before returning.  The mutex
   is released even if thunk raises."
  (mutex-lock! m)
  (let ((ok #t)
        (result #f)
        (error #f))
    (guard (e (#t
               (begin
                 (set! ok #f)
                 (set! error e)
                 #f)))
      (set! result (thunk)))
    (mutex-unlock! m)
    (if ok
        result
        (raise error))))

;; ── Condition variable ──────────────────────────────────────────────

(define (make-condvar)
  "Create a POSIX condition variable.  Returns an opaque pointer."
  (condvar-create-raw))

(define (condvar-wait! c m)
  "Atomically release mutex m, block until c is signalled, reacquire m
   before returning.  m MUST be held by this thread on entry."
  (condvar-wait-raw c m))

(define (condvar-wait-timeout! c m timeout-ms)
  "Like condvar-wait!, but give up after timeout-ms milliseconds of
   monotonic time.  Returns #t when woken and #f when the timeout
   elapsed; either way m is held again on return.  A wakeup may be
   spurious, so callers re-check their condition in a loop.  m MUST be
   held exactly once by this thread on entry."
  (let ((rc (condvar-timedwait-raw c m timeout-ms)))
    (cond
      ((= rc 0) #t)
      ((= rc (condvar-timeout-code-raw)) #f)
      (else (error "condvar-wait-timeout!: wait failed" rc)))))

(define (condvar-signal! c)
  "Wake one thread waiting on c."
  (condvar-signal-raw c))

(define (condvar-broadcast! c)
  "Wake all threads waiting on c."
  (condvar-broadcast-raw c))

(define (condvar-destroy! c)
  "Destroy and free the condition variable."
  (condvar-destroy-raw c))

;; ── Shared helpers for semaphore and barrier ───────────────────────

(define (-sync-wait! c m who)
  ;; Block on c (releasing m) until woken.  Any non-zero status is a
  ;; failed wait, reported under the caller's name.
  (let ((rc (condvar-wait! c m)))
    (if (= rc 0) #t (error (string-append who ": condition wait failed") rc))))

(define (-sync-check-count who n minimum)
  (if (and (integer? n) (exact? n) (>= n minimum))
      n
      (error (string-append who ": expected an exact integer >= "
                            (number->string minimum))
             n)))

;; ── Counting semaphore ───────────────────────────────────────────────
;;
;; Layout: vector of length 4.
;;   0: tag 'eshkol-semaphore
;;   1: free permits (exact integer >= 0), read and written only with
;;      the mutex held
;;   2: mutex
;;   3: condvar, signalled once per released permit
;;
;; Every waiter re-checks the permit count after each wakeup, so spurious
;; wakeups and wakeups that lose the race to another acquirer simply wait
;; again; a permit is consumed only by the thread that observed it free
;; under the mutex.

(define (make-semaphore permits)
  "Create a counting semaphore holding `permits` free permits (an exact
   integer >= 0)."
  (-sync-check-count "make-semaphore" permits 0)
  (vector 'eshkol-semaphore permits (make-mutex) (make-condvar)))

(define (semaphore? s)
  "Predicate: is s a semaphore returned by make-semaphore?"
  (and (vector? s)
       (= (vector-length s) 4)
       (eq? (vector-ref s 0) 'eshkol-semaphore)))

(define (-semaphore-check s who)
  (if (semaphore? s) s (error (string-append who ": not a semaphore") s)))

(define (-semaphore-take! s)
  ;; Caller holds the mutex.  Consume one permit if any is free.
  (let ((n (vector-ref s 1)))
    (if (> n 0)
        (begin (vector-set! s 1 (- n 1)) #t)
        #f)))

(define (semaphore-acquire! s)
  "Take one permit, blocking until one is free.  Returns #t."
  (-semaphore-check s "semaphore-acquire!")
  (let ((m (vector-ref s 2))
        (c (vector-ref s 3)))
    (with-mutex m
      (lambda ()
        (let loop ()
          (if (-semaphore-take! s)
              #t
              (begin (-sync-wait! c m "semaphore-acquire!")
                     (loop))))))))

(define (semaphore-try-acquire! s . timeout)
  "Take one permit if one is free and return #t; otherwise return #f.
   With a timeout argument (milliseconds), wait up to that long for a
   permit before returning #f.  The bound is measured on the monotonic
   clock and is not extended by spurious wakeups."
  (-semaphore-check s "semaphore-try-acquire!")
  (let ((m (vector-ref s 2))
        (c (vector-ref s 3))
        (deadline (cond
                    ((null? timeout) #f)
                    ((real? (car timeout))
                     (+ (monotonic-time-ms) (car timeout)))
                    (else
                     (error "semaphore-try-acquire!: timeout must be a number of milliseconds"
                            (car timeout))))))
    (with-mutex m
      (lambda ()
        (let loop ()
          (cond
            ((-semaphore-take! s) #t)
            ((not deadline) #f)
            (else
             (let ((remaining (- deadline (monotonic-time-ms))))
               (if (<= remaining 0)
                   #f
                   (begin (condvar-wait-timeout! c m (exact (ceiling remaining)))
                          (loop)))))))))))

(define (semaphore-release! s . count)
  "Return permits to the semaphore (one, or `count` when given) and wake
   one waiter per permit.  Returns the number of free permits after the
   release."
  (-semaphore-check s "semaphore-release!")
  (let ((k (if (null? count)
               1
               (-sync-check-count "semaphore-release!" (car count) 1)))
        (m (vector-ref s 2))
        (c (vector-ref s 3)))
    (with-mutex m
      (lambda ()
        (let ((n (+ (vector-ref s 1) k)))
          (vector-set! s 1 n)
          (let wake ((i 0))
            (if (< i k)
                (begin (condvar-signal! c) (wake (+ i 1)))))
          n)))))

(define (semaphore-value s)
  "Number of free permits at the moment of the call."
  (-semaphore-check s "semaphore-value")
  (with-mutex (vector-ref s 2) (lambda () (vector-ref s 1))))

(define (semaphore-destroy! s)
  "Release the semaphore's mutex and condvar.  No thread may be waiting
   on s, and s MUST NOT be used afterwards."
  (-semaphore-check s "semaphore-destroy!")
  (condvar-destroy! (vector-ref s 3))
  (mutex-destroy! (vector-ref s 2)))

;; ── Reusable barrier ─────────────────────────────────────────────────
;;
;; Layout: vector of length 6.
;;   0: tag 'eshkol-barrier
;;   1: parties (exact integer >= 1)
;;   2: arrived in the current generation
;;   3: generation (completed meetings so far)
;;   4: mutex
;;   5: condvar, broadcast when a generation completes
;;
;; A waiter records the generation it arrived in and waits until the
;; generation number moves past it.  The last arrival resets the arrival
;; count before broadcasting, so parties that immediately re-enter for
;; the next phase count toward the new generation and cannot release
;; anyone still leaving the previous one.

(define (make-barrier parties)
  "Create a reusable barrier for `parties` threads (an exact integer
   >= 1)."
  (-sync-check-count "make-barrier" parties 1)
  (vector 'eshkol-barrier parties 0 0 (make-mutex) (make-condvar)))

(define (barrier? b)
  "Predicate: is b a barrier returned by make-barrier?"
  (and (vector? b)
       (= (vector-length b) 6)
       (eq? (vector-ref b 0) 'eshkol-barrier)))

(define (-barrier-check b who)
  (if (barrier? b) b (error (string-append who ": not a barrier") b)))

(define (barrier-wait! b)
  "Block until all parties have called barrier-wait! for the current
   generation.  Returns #t in exactly one party per generation (the one
   whose arrival completed it) and #f in the others."
  (-barrier-check b "barrier-wait!")
  (let ((m (vector-ref b 4))
        (c (vector-ref b 5)))
    (with-mutex m
      (lambda ()
        (let ((gen (vector-ref b 3))
              (arrived (+ (vector-ref b 2) 1)))
          (if (= arrived (vector-ref b 1))
              (begin
                (vector-set! b 2 0)
                (vector-set! b 3 (+ gen 1))
                (condvar-broadcast! c)
                #t)
              (begin
                (vector-set! b 2 arrived)
                (let loop ()
                  (if (= (vector-ref b 3) gen)
                      (begin (-sync-wait! c m "barrier-wait!")
                             (loop))
                      #f)))))))))

(define (barrier-parties b)
  "Number of parties the barrier waits for."
  (-barrier-check b "barrier-parties")
  (vector-ref b 1))

(define (barrier-generation b)
  "Number of generations the barrier has completed."
  (-barrier-check b "barrier-generation")
  (with-mutex (vector-ref b 4) (lambda () (vector-ref b 3))))

(define (barrier-destroy! b)
  "Release the barrier's mutex and condvar.  No thread may be waiting
   on b, and b MUST NOT be used afterwards."
  (-barrier-check b "barrier-destroy!")
  (condvar-destroy! (vector-ref b 5))
  (mutex-destroy! (vector-ref b 4)))

;; ── Thread (eager: runs on a pool worker concurrently) ──────────────
;;
;; Backed by `(future thunk)` which (since #223 + the #224 architectural
;; fix to closure-on-worker capture) eagerly submits the closure to the
;; global thread pool.  thread-join is `force`, which either returns the
;; cached result (if the worker already finished) or blocks until the
;; worker writes set_result_ptr.
;;
;; Layout: vector of length 2 — a thin envelope around the future so
;; thread? can distinguish it from a bare future.
;;   slot 0: tag symbol 'eshkol-thread
;;   slot 1: the future returned by (future thunk)

(define (make-thread thunk)
  "Spawn thunk on a thread-pool worker; returns a thread handle.  The
   thunk runs CONCURRENTLY with the spawner — get its result via
   (thread-join h), which blocks until the worker completes."
  ;; Pass the thunk itself (a callable) to (future …); future's eager
  ;; path submits it to the pool and returns immediately.  Do NOT call
  ;; the thunk here — `(future (thunk))` would evaluate the thunk
  ;; synchronously and pass its result to future.
  (vector 'eshkol-thread (future thunk)))

(define (thread? h)
  "Predicate: is h a thread handle returned by make-thread?"
  (and (vector? h)
       (= (vector-length h) 2)
       (eq? (vector-ref h 0) 'eshkol-thread)))

(define (thread-result-ready? h)
  "Non-blocking check: has the worker finished?"
  (if (thread? h) (future-ready? (vector-ref h 1)) #f))

(define (thread-join h)
  "Block until the thread's thunk completes; return its result.
   Memoised by force: a second join returns the cached result.
   Calling on a non-thread returns the value as-is (per R7RS force)."
  (cond
    ((not (thread? h)) h)
    (else (force (vector-ref h 1)))))
