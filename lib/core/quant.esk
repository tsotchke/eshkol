;;;   core.quant.malliavin  Black-Scholes closed-form & native-AD Greeks,
;;;                         pathwise tangent-AD & Malliavin likelihood-ratio
;;;                         Monte Carlo sensitivity estimators

(require core.quant.sde)
(require core.quant.malliavin)
