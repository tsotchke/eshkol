;;; Bounded exact Woodbury corrections over the existing checked LU owner.
(require core.algebraic_linalg)
(provide algebraic-update-factor algebraic-update algebraic-update-symmetric
         algebraic-update-solve algebraic-update-solve-transpose
         algebraic-update-pullback algebraic-update-info)

;; Opaque: tag, domain, matrix, solve, transpose-solve, depth, SPD, receipt.
(define (au-check f)
  (if (not (and (vector? f) (= (vector-length f) 8) (eq? (vector-ref f 0) 'algebraic-update-v1)))
      (error "Expected an exact update factor")))
(define (au-vector d xs n)
  (if (not (and (vector? xs) (= (vector-length xs) n))) (error "Update vector dimension mismatch"))
  (list->vector (map (algebraic-domain-ref d 'copy) (vector->list xs))))
(define (au-columns d xs n)
  (if (not (and (list? xs) (<= (length xs) 8))) (error "Update rank must be in zero through eight"))
  (map (lambda (x) (au-vector d x n)) xs))
(define (au-dot d a b)
  (let ((add (algebraic-domain-ref d 'add)) (mul (algebraic-domain-ref d 'mul)))
    (let loop ((i 0) (sum (algebraic-domain-ref d 'zero)))
      (if (= i (vector-length a)) sum
          (loop (+ i 1) (add sum (mul (vector-ref a i) (vector-ref b i))))))))
(define (au-primal d x)
  (let ((p (algebraic-domain-ref d 'parent)))
    (if p (au-primal p (vector-ref ((algebraic-domain-ref d 'coefficients) x) 0)) x)))
(define (algebraic-update-factor owner matrix . positive)
  (if (not (and (<= (length positive) 1) (or (null? positive) (boolean? (car positive)))))
      (error "Expected an optional positive-definite admission flag"))
  (let* ((factor (algebraic-factor owner matrix)) (d (vector-ref factor 1))
         (spd (and (not (null? positive)) (car positive))))
    (if (and spd (not (algebraic-factor-positive-definite? factor))) (error "Updated matrix is not positive definite"))
    (vector 'algebraic-update-v1 d (vector-ref factor 2)
      (lambda (b) (algebraic-factor-solve factor b))
      (lambda (b) (algebraic-factor-solve-transpose factor b)) 0 spd (vector 'initial 0 1 0 0))))
(define (algebraic-update-info factor) (au-check factor) (vector-copy (vector-ref factor 7)))
(define (au-solve factor rhs transposed)
  (au-check factor)
  (let* ((d (vector-ref factor 1)) (a (vector-ref factor 2)) (n (vector-length a))
         (b (au-vector d rhs n)) (x ((vector-ref factor (if transposed 4 3)) b))
         (equal? (algebraic-domain-ref d 'equal?)) (add (algebraic-domain-ref d 'add))
         (mul (algebraic-domain-ref d 'mul)))
    (let rows ((i 0)) (if (< i n)
      (begin
        (if (not (equal? (vector-ref b i)
          (let cols ((j 0) (sum (algebraic-domain-ref d 'zero)))
            (if (= j n) sum (cols (+ j 1) (add sum (mul
              (if transposed (vector-ref (vector-ref a j) i) (vector-ref (vector-ref a i) j))
              (vector-ref x j)))))))) (error "Exact updated solve failed its full residual"))
        (rows (+ i 1))))) (au-vector d x n)))
(define (algebraic-update-solve factor rhs) (au-solve factor rhs #f))
(define (algebraic-update-solve-transpose factor rhs) (au-solve factor rhs #t))
(define (au-matrix d a u v)
  (let* ((n (vector-length a)) (add (algebraic-domain-ref d 'add))
         (mul (algebraic-domain-ref d 'mul)) (out (make-vector n #f)))
    (let rows ((i 0)) (if (< i n)
      (let ((row (make-vector n #f)))
        (let cols ((j 0)) (if (< j n)
          (begin (vector-set! row j
            (let terms ((us u) (vs v) (value (vector-ref (vector-ref a i) j)))
              (if (null? us) value (terms (cdr us) (cdr vs)
                (add value (mul (vector-ref (car us) i) (vector-ref (car vs) j)))))))
            (cols (+ j 1)))))
        (vector-set! out i row) (rows (+ i 1))))) out))
(define (au-policy options)
  (let ((p (if (null? options) 'auto (car options))))
    (if (not (and (<= (length options) 1) (memq p '(auto correction refactor)))) (error "Unknown exact update policy")) p))
(define (au-receipt route rank work depth)
  (vector route rank (vector-ref work 0) (vector-ref work 1) depth))
(define (au-refactor old matrix rank route work)
  (vector-set! work 0 (+ 1 (vector-ref work 0)))
  (let ((next (algebraic-update-factor (algebraic-domain-ref (vector-ref old 1) 'owner) matrix (vector-ref old 6))))
    (vector-set! next 7 (au-receipt route rank work 0)) next))
(define (au-correct old u v matrix work)
  (let* ((d (vector-ref old 1)) (rank (length u)) (n (vector-length matrix))
         (w (map (lambda (c) (algebraic-update-solve old c)) u))
         (z (map (lambda (c) (algebraic-update-solve-transpose old c)) v))
         (small (make-vector rank #f)) (add (algebraic-domain-ref d 'add))
         (sub (algebraic-domain-ref d 'sub)) (mul (algebraic-domain-ref d 'mul)))
    (let rows ((i 0)) (if (< i rank)
      (let ((row (make-vector rank #f)))
        (let cols ((j 0)) (if (< j rank)
          (begin (vector-set! row j (add (if (= i j) (algebraic-domain-ref d 'one) (algebraic-domain-ref d 'zero))
                                        (au-dot d (list-ref v i) (list-ref w j)))) (cols (+ j 1)))))
        (vector-set! small i row) (rows (+ i 1)))))
    (vector-set! work 1 (+ 1 (vector-ref work 1)))
    (let* ((correction (algebraic-factor (algebraic-domain-ref d 'owner) small))
           (depth (+ 1 (vector-ref old 5))))
      (define (solve b transposed)
        (let* ((x (if transposed (algebraic-update-solve-transpose old b) (algebraic-update-solve old b)))
               (rhs (list->vector (map (lambda (c) (au-dot d c x)) (if transposed u v))))
               (q (if transposed (algebraic-factor-solve-transpose correction rhs) (algebraic-factor-solve correction rhs)))
               (basis (if transposed z w)) (out (make-vector n #f)))
          (let cells ((i 0)) (if (< i n)
            (begin (vector-set! out i (let columns ((j 0) (value (vector-ref x i)))
              (if (= j rank) value (columns (+ j 1) (sub value (mul (vector-ref (list-ref basis j) i) (vector-ref q j)))))))
              (cells (+ i 1))))) out))
      (vector 'algebraic-update-v1 d matrix (lambda (b) (solve b #f)) (lambda (b) (solve b #t))
              depth #f (au-receipt 'correction rank work depth)))))
(define (algebraic-update old left right . options)
  (au-check old)
  (if (vector-ref old 6) (error "Positive-definite factors require symmetric updates"))
  (let* ((d (vector-ref old 1)) (n (vector-length (vector-ref old 2)))
         (u (au-columns d left n)) (v (au-columns d right n)) (policy (au-policy options)) (work (vector 0 0)))
    (if (not (= (length u) (length v))) (error "Low-rank factor counts differ"))
    (if (null? u) old
      (let ((matrix (au-matrix d (vector-ref old 2) u v)))
        (if (and (eq? policy 'correction) (>= (vector-ref old 5) 8)) (error "Exact correction chain exhausted its budget"))
        (cond ((or (eq? policy 'refactor) (>= (vector-ref old 5) 8)) (au-refactor old matrix (length u) 'refactor work))
              ((eq? policy 'correction) (au-correct old u v matrix work))
              (else (guard (e (else (au-refactor old matrix (length u) 'fallback work))) (au-correct old u v matrix work))))))))
(define (algebraic-update-symmetric old columns weights . options)
  (au-check old)
  (if (not (vector-ref old 6)) (error "Symmetric updates require a positive-definite base"))
  (let* ((d (vector-ref old 1)) (n (vector-length (vector-ref old 2)))
         (u (au-columns d columns n)) (rank (length u))
         (weights (au-vector d weights rank)) (mul (algebraic-domain-ref d 'mul))
         (add (algebraic-domain-ref d 'add)) (policy (au-policy options)) (work (vector 0 0))
         (v (let loop ((cs u) (i 0) (out '())) (if (null? cs) (reverse out)
           (loop (cdr cs) (+ i 1) (cons (list->vector (map (lambda (x) (mul (vector-ref weights i) x)) (vector->list (car cs)))) out)))))
         (matrix (au-matrix d (vector-ref old 2) u v)))
    (define (correct)
      (let loop ((cs u) (vs v) (i 0) (factor old))
        (if (null? cs)
            (let ((out (vector-copy factor))) (vector-set! out 7 (au-receipt 'symmetric rank work (vector-ref factor 5))) out)
            (let* ((x (algebraic-update-solve factor (car cs)))
                   (tau (add (algebraic-domain-ref d 'one) (mul (vector-ref weights i) (au-dot d (car cs) x)))))
              (if (<= (algebraic-sign (au-primal d tau)) 0) (error "Symmetric update intermediate loses positivity"))
              (let* ((next-matrix (au-matrix d (vector-ref factor 2) (list (car cs)) (list (car vs))))
                     (next (au-correct factor (list (car cs)) (list (car vs)) next-matrix work)))
                (vector-set! next 6 #t) (loop (cdr cs) (cdr vs) (+ i 1) next))))))
    (if (and (eq? policy 'correction) (> (+ (vector-ref old 5) rank) 8)) (error "Exact correction chain exhausted its budget"))
    (cond ((= rank 0) old)
          ((or (eq? policy 'refactor) (> (+ (vector-ref old 5) rank) 8)) (au-refactor old matrix rank 'refactor work))
          ((eq? policy 'correction) (correct))
          (else (guard (e (else (au-refactor old matrix rank 'fallback work))) (correct))))))
(define (algebraic-update-pullback factor rhs)
  (let* ((x (algebraic-update-solve factor rhs)) (d (vector-ref factor 1)) (n (vector-length x))
         (mul (algebraic-domain-ref d 'mul)) (sub (algebraic-domain-ref d 'sub)))
    (vector (au-vector d x n)
      (lambda (seed)
        (let ((lambda-value (algebraic-update-solve-transpose factor seed)) (matrix (make-vector n #f)))
          (let rows ((i 0)) (if (< i n) (let ((row (make-vector n #f)))
            (let cols ((j 0)) (if (< j n)
              (begin (vector-set! row j (sub (algebraic-domain-ref d 'zero) (mul (vector-ref lambda-value i) (vector-ref x j)))) (cols (+ j 1)))))
            (vector-set! matrix i row) (rows (+ i 1))))) (vector matrix lambda-value))))))
