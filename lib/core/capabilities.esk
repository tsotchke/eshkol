;;; core/capabilities.esk
;;;
;;; Process-local capability policy for hosted/agent surfaces.
;;;
;;; Default policy is #f, meaning no checks and existing v1.2 programs keep
;;; running unchanged. Installing an allow-list makes the policy active and
;;; every capability not present in the list is denied by default.
;;;
;;; The capability vocabulary is file-read, file-write, env-read, env-write,
;;; subprocess, shell, network, ffi, keychain, display, audio and midi. Installing a policy mirrors
;;; the allow-list into the runtime policy store (lib/core/capability_policy.cpp),
;;; which every engine reads, so the policy holds for the code-generated paths,
;;; the bytecode VM and the runtime entry points beneath them alike — not only
;;; for the Scheme wrappers that call capability-require! themselves.
;;;
;;; The file and environment surfaces report a denial and return a benign value.
;;; The process, shell, socket and foreign-code sinks raise instead, because
;;; every value they could return is also a legitimate one; those refusals are
;;; catchable and name the capability. See docs/reference/language/capabilities.md.

(provide capability-install-policy!
         capability-clear-policy!
         capability-policy
         capability-policy-active?
         capability-allowed?
         capability-require!)

;; Two entry points, and only two. A policy is installed by one call carrying
;; the whole set, so there is no moment at which a policy is active with its set
;; still being assembled — and so no call a program could make, in or out of
;; this module, that widens a settled policy. The runtime's staged installer is
;; deliberately not named here.
(extern i32 capability-runtime-clear-raw :real eshkol_capability_runtime_clear)
(extern i32 capability-runtime-install-raw ptr :real eshkol_capability_runtime_install)

(define *capability-policy-active* #f)
(define *capability-allow-list* '())

(define (capability-policy)
  (if (eq? *capability-policy-active* #t) *capability-allow-list* #f))

(define (capability-policy-active?)
  (eq? *capability-policy-active* #t))

(define (capability-symbol-list? allow-list)
  (if (null? allow-list)
      #t
      (if (symbol? (car allow-list))
          (capability-symbol-list? (cdr allow-list))
          #f)))

(define (capability-names-string allow-list)
  "ALLOW-LIST as one space-separated string, which is how the whole set reaches
the runtime in a single call."
  (if (null? allow-list)
      ""
      (if (null? (cdr allow-list))
          (symbol->string (car allow-list))
          (string-append (symbol->string (car allow-list))
                         " "
                         (capability-names-string (cdr allow-list))))))

(define (capability-sync-runtime! allow-list)
  "Hand the whole set to the runtime at once. The runtime intersects it with any
active policy and swaps under one lock, so a policy is never observable with a
partly-assembled set."
  (capability-runtime-install-raw (capability-names-string allow-list))
  #t)

(define (capability-intersect allow-list current)
  "The names in ALLOW-LIST that CURRENT also holds, in ALLOW-LIST's order."
  (if (null? allow-list)
      '()
      (if (memq (car allow-list) current)
          (cons (car allow-list) (capability-intersect (cdr allow-list) current))
          (capability-intersect (cdr allow-list) current))))

(define (capability-install-policy! allow-list)
  "Install an allow-list of capability symbols. An active policy denies every
capability it does not name. Installing one while another is active narrows it:
the result is the names both hold, so a policy can only ever take away."
  (if (and (list? allow-list) (capability-symbol-list? allow-list))
      (let ((effective (if (eq? *capability-policy-active* #t)
                           (capability-intersect allow-list *capability-allow-list*)
                           allow-list)))
        (set! *capability-policy-active* #t)
        (set! *capability-allow-list* effective)
        (capability-sync-runtime! effective))
      (error "capability-install-policy!: expected a list of symbols" allow-list)))

(define (capability-clear-policy!)
  "Clear the policy. Refused while one is active: a policy is not something the
code it governs can remove. With no policy installed this is a no-op."
  (if (eq? *capability-policy-active* #t)
      (error "capability denied: the active policy cannot be cleared" 'policy)
      (begin
        (set! *capability-allow-list* '())
        (capability-runtime-clear-raw)
        #t)))

(define (capability-allowed? capability . _context)
  "Return #t when CAPABILITY is allowed under the current policy."
  (if (not (eq? *capability-policy-active* #t))
      #t
      (if (memq capability *capability-allow-list*) #t #f)))

(define (capability-require! capability . context)
  "Raise if CAPABILITY is denied; return #t otherwise."
  (if (capability-allowed? capability)
      #t
      (error "capability denied" capability)))
