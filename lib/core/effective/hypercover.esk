;;; core.effective.hypercover -- hypercovers of finite spaces by cones, and
;;; descent for mapping spaces into 2-types and 3-types computed on both
;;; sides of a cover (stage S6.3 of the S6 definition of done).
;;;
;;; Usage: (require core.effective.hypercover)   or   (require core.effective)
;;;
;;; Sources: J. Lurie, "Higher Topos Theory" (2009), 6.5.3 (Cech descent,
;;; Cech nerves) and 6.5.4 (hypercovers, hypercompleteness); D. Dugger,
;;; S. Hollander, D. Isaksen, "Hypercovers and simplicial presheaves", Math.
;;; Proc. Camb. Phil. Soc. 136 (2004) and D. Dugger, D. Isaksen,
;;; "Topological hypercovers and A^1-realizations", Math. Z. 246 (2004)
;;; (hocolim of a hypercover is weakly equivalent to the space); M. Artin,
;;; B. Mazur, "Etale homotopy" (1969), 8 (hypercoverings built level by level
;;; through coskeleta); M. C. McCord, Duke Math. J. 33 (1966) and J. A.
;;; Barmak, LNM 2032 (2011) (finite spaces; U_x is contractible);
;;; J. Faria Martins, T. Porter, TAC 18 (2007) (homotopy cardinality of
;;; Map(K, B G) for a crossed module G).
;;;
;;; A hypercover of a finite T_0 space X by cones is built level by level.
;;; Level 0: for each open U of the cover, the minimal opens U_y of its
;;; maximal points y. Level n: for every boundary beta = (sigma_0 ... sigma_n)
;;; of (n-1)-simplices with d_i sigma_j = d_(j-1) sigma_i (i < j) that is not
;;; the boundary of a degenerate simplex, and every maximal point y of
;;; V_beta = U(sigma_0) n ... n U(sigma_n), one nondegenerate simplex
;;; (beta, y) with open U_y. A degenerate simplex s_j c has open U(c), which
;;; is all of V_beta for its own boundary, so H_n -> (cosk_(n-1) H)_n is
;;; surjective over every point: a hypercover, refining the cover where an
;;; intersection is not a cone and agreeing with the Cech nerve where it is.
;;; Every piece U_y is contractible, so the simplicial set of pieces H is
;;; weakly equivalent to X (Dugger-Isaksen), and Map(H, P) = Map(X, P) for
;;; every n-type P: descent along the hypercover. H through level n + 1 is
;;; enough for an n-type.
;;;
;;; Values. For p prime and the 2-types BZ/p, K(Z/p, 2) and their product,
;;; |Map(K, P)| from H^*(K; F_p): p^(d1 - d0), p^(d2 - d1 + d0) and their
;;; product (homotopy cardinality; d_i = dim H^i). For the 3-type
;;; P_k = K(B, 3) x_k K(A, 2) with A = B = Z/2 and k-invariant
;;; k = iota u iota (the cup square, Sq^2 iota), the fibration formula
;;;   |Map(K, P_k)| = sum over [x] in H^2(K; A) with [x u x] = 0 in H^4(K; B)
;;;                   of |H^0(A)| / |H^1(A)| * |H^3(B)| |H^1(B)| / (|H^2(B)| |H^0(B)|)
;;; needs K through dimension 4 only (whether x u x is a coboundary is decided
;;; in C^4, and |H^3| = |ker d^3| / |im d^2|).

(require stdlib)
(require core.ring)
(require core.sheaf.site)
(require core.simplicial.sset)
(require core.simplicial.group)
(require core.simplicial.kan)
(require core.homological.complex)
(require core.homological.simplicial)
(require core.effective.chain)
(require core.effective.perturbation)
(require core.effective.simplicial)
(require core.effective.homotopy)
(require core.integer_linalg)

(provide finite-space-hypercover finite-space-cech-nerve hypercover-space hypercover-piece-point hypercover-open-of hypercover-boundaries
         hypercover-violations hypercover-level-counts
         mod-p-cohomology-dimensions two-type-cardinalities mapping-space-cardinality
         cup-square-three-type-cardinality uct-cohomology-order postnikov-cardinalities)

;; ---------------------------------------------------------------------------
;; Private helpers (prefix hc-)
;; ---------------------------------------------------------------------------
(define (hc-range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (hc-all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (hc-all? pred (cdr xs))) (else #f)))
(define (hc-any? pred xs) (cond ((null? xs) #f) ((pred (car xs)) #t) (else (hc-any? pred (cdr xs)))))
(define (hc-intersect A B) (filter (lambda (x) (memv x B)) A))
(define (hc-maximal X V) (filter (lambda (x) (hc-all? (lambda (y) (not (finite-space-lt? X x y))) V)) V))
(define (hc-expt p e) (if (< e 0) (/ 1 (expt p (- e))) (expt p e)))

;; ---------------------------------------------------------------------------
;; The hypercover
;; ---------------------------------------------------------------------------
;; piece values: (piece n (y . U) beta) with U the open of the piece (U_y for
;; the point y of a hypercover by cones; a component for a Cech nerve) and
;; beta the list of faces (simplices of level n-1); level 0:
;; (piece 0 (y . U) (i)) with i the index of the open of the cover
;; Pieces are numbered: a nondegenerate n-simplex is the value #(piece n id)
;; and a table of the construction holds, for each id, the pair
;; (point . open) and the boundary (the list of faces, simplices of level
;; n-1); level-0 pieces have the boundary (i), i the index of the open of the
;; cover they come from.
(define hc-tables (make-hash-table))           ;; simplicial set name+identity -> table
(define (hc-table-of H) (hash-table-ref/default hc-tables (simplicial-set-name H) #f))
(define (hc-piece-data H x) (hash-table-ref/default (hc-table-of H) (vector-ref x 2) #f))
(define (hypercover-piece-point H x) (car (car (hc-piece-data H x))))
(define (hypercover-open-of H s) (cdr (car (hc-piece-data H (simplex-base s)))))
;; compatible boundaries (sigma_0 ... sigma_n) of an n-simplex (n >= 1):
;; d_i sigma_j = d_(j-1) sigma_i for i < j; candidates for sigma_j are read
;; from an index of the (n-1)-simplices by their 0-face
(define (hypercover-boundaries H n)
  (let* ((S (simplicial-set-simplices H (- n 1))) (by-d0 (make-hash-table)))
    (if (>= n 2)
        (for-each (lambda (s) (let ((k (simplicial-set-face H 0 s))) (hash-table-set! by-d0 k (cons s (hash-table-ref/default by-d0 k '()))))) (reverse S)))
    (let extend ((partial '()) (j 0))       ;; partial = (sigma_0 ... sigma_(j-1)) as a vector-free list
      (if (> j n) (list partial)
          (let ((cands (if (or (< n 2) (= j 0)) S
                           (hash-table-ref/default by-d0 (simplicial-set-face H (- j 1) (car partial)) '()))))
            (apply append
                   (map (lambda (s)
                          (if (or (< n 2)
                                  (hc-all? (lambda (i) (equal? (simplicial-set-face H i s) (simplicial-set-face H (- j 1) (list-ref partial i))))
                                           (if (> j 0) (cdr (hc-range j)) (quote ()))))
                              (extend (append partial (list s)) (+ j 1))
                              '()))
                        cands)))))))
(define (hc-degenerate-boundaries H n)
  (let ((t (make-hash-table)))
    (for-each (lambda (c) (for-each (lambda (j) (let ((s (simplicial-set-degeneracy H j c)))
                                                   (hash-table-set! t (map (lambda (i) (simplicial-set-face H i s)) (hc-range (+ n 1))) #t)))
                                    (hc-range n)))
              (simplicial-set-simplices H (- n 1)))
    t))
;; refine: the pieces over an open V (maximal points for the hypercover by
;; cones, connected components for the Cech nerve), as (point . open) pairs
(define (hc-cones X V) (map (lambda (y) (cons y (finite-space-down-set X y))) (hc-maximal X V)))
(define (hc-components X V) (map (lambda (c) (cons c c)) (finite-space-components X V)))
(define hc-counter 0)
(define (hc-build X cover nmax refine kind)
  (set! hc-counter (+ hc-counter 1))
  (let* ((name (string-append kind " " (number->string hc-counter))) (table (make-hash-table)) (next 0)
         (new-piece! (lambda (n yo beta) (let ((id next)) (set! next (+ next 1)) (hash-table-set! table id (cons yo beta)) (vector 'piece n id)))))
    (hash-table-set! hc-tables name table)
    (letrec ((H (make-simplicial-set
                 name
                 (lambda (n)
                   (if (= n 0)
                       (apply append (map (lambda (U i) (map (lambda (yo) (new-piece! 0 yo (list i))) (refine X U))) cover (hc-range (length cover))))
                       (let ((degenerate (hc-degenerate-boundaries H n)))
                         (apply append
                                (map (lambda (beta)
                                       (if (hash-table-ref/default degenerate beta #f) '()
                                           (let ((V (fold-left hc-intersect (hypercover-open-of H (car beta)) (map (lambda (s) (hypercover-open-of H s)) (cdr beta)))))
                                             (map (lambda (yo) (new-piece! n yo beta)) (refine X V)))))
                                     (hypercover-boundaries H n))))))
                 (lambda (n i x) (list-ref (cdr (hash-table-ref/default table (vector-ref x 2) #f)) i))
                 nmax)))
      H)))
(define (finite-space-hypercover X cover nmax) (hc-build X cover nmax hc-cones "hypercover"))
;; the Cech nerve as a simplicial set: n-simplices are the tuples of opens of
;; the cover with a connected component of their intersection (built by the
;; same recursion, without refining a component)
(define (finite-space-cech-nerve X cover nmax) (hc-build X cover nmax hc-components "Cech nerve"))
;; the effective space of a truncated hypercover (or nerve): its chains are of
;; finite type through nmax and are reduced by a collapse matching
(define (hypercover-space H nmax)
  (let ((C (simplicial-effective-chains H #t)))
    (make-effective-space (simplicial-set-name H) H C (finite-complex-reduction C nmax (simplicial-set-name H)) #f)))
(define (hypercover-level-counts H nmax) (map (lambda (n) (simplicial-set-count H n)) (hc-range (+ nmax 1))))
;; the hypercover conditions through level nmax: every piece is a cone
;; contained in the opens of its faces, the level-0 pieces cover X, and over
;; every compatible boundary every point of V_beta lies in the open of a
;; simplex (degenerate or not) with that boundary
(define (hypercover-violations X H nmax)
  (let ((out '()) (points (hc-range (finite-space-size X))))
    (if (not (hc-all? (lambda (x) (hc-any? (lambda (v) (memv x (hypercover-open-of H (simplex v 0)))) (vector->list (simplicial-set-nondegenerate H 0)))) points))
        (set! out (cons "the level-0 pieces do not cover X" out)))
    (for-each
     (lambda (n)
       (let ((all (simplicial-set-simplices H n)))
         (for-each (lambda (v)
                     (let ((s (simplex v n)))
                       (if (not (= 1 (length (hc-maximal X (hypercover-open-of H s))))) (set! out (cons (list "a piece is not a cone" n v) out)))
                       (for-each (lambda (i) (if (not (hc-all? (lambda (x) (memv x (hypercover-open-of H (simplicial-set-face H i s)))) (hypercover-open-of H s)))
                                                 (set! out (cons (list "a piece is not inside its face" n i) out))))
                                 (hc-range (+ n 1)))))
                   (vector->list (simplicial-set-nondegenerate H n)))
         (for-each (lambda (beta)
                     (let* ((V (fold-left hc-intersect (hypercover-open-of H (car beta)) (map (lambda (s) (hypercover-open-of H s)) (cdr beta))))
                            (over (filter (lambda (s) (equal? beta (map (lambda (i) (simplicial-set-face H i s)) (hc-range (+ n 1))))) all))
                            (covered (apply append (map (lambda (s) (hypercover-open-of H s)) over))))
                       (if (not (hc-all? (lambda (x) (memv x covered)) V)) (set! out (cons (list "H_n -> M_n is not surjective" n beta) out)))))
                   (hypercover-boundaries H n))))
     (cdr (hc-range (+ nmax 1))))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; Homotopy cardinalities of mapping spaces
;; ---------------------------------------------------------------------------
(define (mod-p-cohomology-dimensions K nmax p)
  (map cadr (simplicial-cohomology K nmax (make-zmod p))))
;; (BZ/p  K(Z/p,2)  BZ/p x K(Z/p,2)) from H^0, H^1, H^2 (K through dimension 3)
(define (two-type-cardinalities K p)
  (let* ((d (mod-p-cohomology-dimensions K 2 p)) (d0 (car d)) (d1 (cadr d)) (d2 (caddr d))
         (b (hc-expt p (- d1 d0))) (k (hc-expt p (+ d2 (- d0 d1)))))
    (list b k (* b k))))
;; the state sum: |N|^-V |M|^(V-E) #{simplicial maps K -> nerve of M -> N}
;; (Faria Martins-Porter), K of finite type through dimension 3
(define (mapping-space-cardinality K xmod nerve)
  (let ((V (simplicial-set-count K 0)) (E (simplicial-set-count K 1))
        (m (group-order (crossed-module-source xmod))) (nn (group-order (crossed-module-target xmod))))
    (* (hc-expt nn (- 0 V)) (hc-expt m (- V E)) (simplicial-maps-count K nerve))))

;; --- the 3-type with k-invariant the cup square ------------------------------------
;; over F_2: the cocycles x of a basis of H^2(K), and the test whether a
;; 4-cochain is a coboundary
(define (cup-square-three-type-cardinality K)
  (let* ((F2 (make-zmod 2))
         (C (simplicial-cochain-complex K 4 F2))
         (dims (map (lambda (n) (simplicial-set-count K n)) (hc-range 5)))
         (rank (lambda (n) (let ((D (complex-map C n))) (if D (coefficient-rank F2 D) 0))))
         (r0 (rank 0)) (r1 (rank 1)) (r2 (rank 2)) (r3 (rank 3))
         (h0 (- (list-ref dims 0) r0)) (h1 (- (list-ref dims 1) r1 r0)) (h2 (- (list-ref dims 2) r2 r1)) (h3 (- (list-ref dims 3) r3 r2))
         (gens (map cdr (homology-generators C 2)))
         (D3 (complex-map C 3))
         (classes (hc-subset-sums gens (list-ref dims 2)))
         (good (filter (lambda (x) (let ((sq (cup-product K x 2 x 2 F2)))
                                     (or (coefficient-zero-vector? F2 sq)
                                         (and D3 (coefficient-in-span? F2 D3 (list-ref dims 3) sq)))))
                       classes))
         (fibre (* (hc-expt 2 (- h0 h1)) (hc-expt 2 (+ h3 h1 (- 0 h2) (- 0 h0))))))
    (list (length good) (length classes) (* (length good) fibre) (list h0 h1 h2 h3))))
;; all F_2 combinations of the vectors (the classes of H^2 through their
;; representative cocycles)
(define (hc-subset-sums vs n)
  (let loop ((vs vs) (acc (list (make-vector n 0))))
    (if (null? vs) acc
        (loop (cdr vs) (append acc (map (lambda (u) (let ((w (make-vector n 0)))
                                                      (let fill ((i 0)) (if (< i n) (begin (vector-set! w i (modulo (+ (vector-ref u i) (vector-ref (car vs) i)) 2)) (fill (+ i 1)))))
                                                      w))
                                        acc))))))

;; ---------------------------------------------------------------------------
;; Mapping spaces into 2-types and 3-types through effective homology
;; ---------------------------------------------------------------------------
;; |H^n(K; Z/m)| from integral homology rows (k betti torsion), by universal
;; coefficients: Hom(H_n, Z/m) (+) Ext(H_(n-1), Z/m)
(define (uct-cohomology-order H n m)
  (let ((hom (let ((row (list-ref H n))) (* (expt m (cadr row)) (fold-left * 1 (map (lambda (d) (gcd d m)) (caddr row))))))
        (ext (if (= n 0) 1 (fold-left * 1 (map (lambda (d) (gcd d m)) (caddr (list-ref H (- n 1))))))))
    (* hom ext)))
(define (hc-dot u v) (let loop ((i 0) (s 0)) (if (= i (vector-length u)) s (loop (+ i 1) (+ s (* (vector-ref u i) (vector-ref v i)))))))
;; For an effective space S whose integral homology through degree 3 has no
;; 2-torsion (so every class of H^2(S; Z/2) has an integral lift and
;; H^4(S; Z/4) is detected on integral 4-cycles): the homotopy cardinalities
;;   (2-types  |Map(S, BZ/2)|  |Map(S, K(Z/2,2))|  product)
;;   (A=Z/2 B=Z/4  k = 0  k = Pontryagin square)
;;   (A=B=Z/2      k = 0  k = iota u iota)
;; for the 3-types K(B,3) x_k K(A,2), by the fibration formula. A class x
;; with integral cocycle lift x~ has P(x) = x~ u x~ mod 4 (x~ u_1 d x~ = 0);
;; it vanishes when x~ u x~ evaluates to 0 mod 4 on every 4-cycle g(z), z a
;; cycle of the small complex, the cup product taken by the Alexander-Whitney
;; formula on the simplices of S and x~ = phi o f on 2-simplices.
(define (postnikov-cardinalities S)
  (let* ((E (effective-space-small S)) (r (effective-space-reduction S)) (X (effective-space-simplicial-set S))
         (H (effective-complex-homology E 3))
         (two? (lambda (k) (hc-any? (lambda (d) (even? d)) (caddr (list-ref H k))))))
    (if (hc-any? two? (list 1 2 3))
        (error "postnikov-cardinalities: integral homology with 2-torsion in degrees 1-3 (planned for v1.4.1: classes without integral lifts)" H))
    (let* ((o (lambda (n m) (uct-cohomology-order H n m)))
           (hf (homology-functional E 2)) (inv (car hf))
           (UL (if (cadr hf) (integer-matrix-mul (cadr hf) (caddr hf)) #f))
           (lifts (filter (lambda (v) v) (map (lambda (i) (if (= 0 (list-ref inv i)) (vector-ref UL i) #f)) (hc-range (length inv)))))
           (n2 (effective-complex-rank E 2))
           (xt (lambda (eps) (let ((w (make-vector n2 0)))
                               (for-each (lambda (e v) (if (= e 1) (let fill ((i 0)) (if (< i n2) (begin (vector-set! w i (+ (vector-ref w i) (vector-ref v i))) (fill (+ i 1))))))) eps lifts)
                               w)))
           (cycles (integer-kernel (effective-complex-matrix E 4) (effective-complex-rank E 4)))
           (big-cycles (map (lambda (z) (reduction-g r 4 (effective-complex-combination E 4 z))) cycles))
           (value2 (lambda (w s) (if (simplex-degenerate? s) 0 (hc-dot w (effective-complex-vector E 2 (reduction-f-cell r 2 (simplex-base s)))))))
           (square-on (lambda (w c) (fold-left + 0 (map (lambda (p) (let ((s (simplex (car p) 4)))
                                                                       (* (cdr p) (value2 w (simplicial-set-front-face X s 2)) (value2 w (simplicial-set-back-face X s 2)))))
                                                         c))))
           (epss (let loop ((k (length lifts)) (acc (list '()))) (if (= k 0) acc (loop (- k 1) (append (map (lambda (e) (cons 0 e)) acc) (map (lambda (e) (cons 1 e)) acc))))))
           (squares (map (lambda (eps) (let ((w (xt eps))) (map (lambda (c) (square-on w c)) big-cycles))) epss))
           (count (lambda (m) (length (filter (lambda (vals) (hc-all? (lambda (v) (= 0 (modulo v m))) vals)) squares))))
           (b (/ (o 1 2) (o 0 2))) (k2 (/ (* (o 2 2) (o 0 2)) (o 1 2)))
           (fibre4 (* (/ (o 0 2) (o 1 2)) (/ (* (o 3 4) (o 1 4)) (* (o 2 4) (o 0 4)))))
           (fibre2 (* (/ (o 0 2) (o 1 2)) (/ (* (o 3 2) (o 1 2)) (* (o 2 2) (o 0 2))))))
      (list (list b k2 (* b k2))
            (list (* (o 2 2) fibre4) (* (count 4) fibre4))
            (list (* (o 2 2) fibre2) (* (count 2) fibre2))))))
