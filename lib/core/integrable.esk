;;; core.integrable -- Umbrella for exact classical, algebraic-geometric
;;;   (Hitchin spectral curves), and quantum integrable systems (ADR-0063).

(require core.integrable.lax)
(require core.integrable.hitchin)
(require core.integrable.quantum)

(provide
  ;; Lax pairs, Toda, Euler-Arnold, exact CYBE, Hirota KdV tau-function
  toda-lax-pair lax-verify-invariants-exact euler-top-verify-invariants
  yang-classical-r-matrix cybe-verify-exact
  hirota-kdv-1soliton-residual
  ;; Exact-field Hitchin spectral curves & Gaudin Poisson involution
  hitchin-spectral-poly-2x2 hitchin-spectral-curve-genus-2x2
  sl2-gaudin-hamiltonians sl2-gaudin-verify-involution
  ;; Exact Q[i] QYBE, Transfer Matrix [T(u),T(v)]=0, Heisenberg XXX Bethe Ansatz
  yang-quantum-R-matrix xxz-quantum-R-matrix
  qybe-verify-exact
  spin-chain-transfer-matrix transfer-matrix-commute-verify
  xxx-hamiltonian-L3 xxx-verify-eigenstate)
