;;; core.sheaf.cellular -- Computable Cellular Sheaves & Exact/Differentiable
;;; Hodge-Sheaf Laplacians (M5-a).
;;;
;;; Grounded in Hansen & Ghrist, "Toward a Spectral Theory of Cellular Sheaves"
;;; (2019), turning cellular sheaves on finite simplicial/cell complexes into
;;; first-class exact rational linear algebra (coboundary d0, d1, exact sheaf
;;; Laplacians L0 = d0^T d0, L1 = d0 d0^T + d1^T d1, exact harmonic sections
;;; ker(L_k) = H^k(X; F), exact Betti numbers, exact Dirichlet energy x^T L0 x)
;;; plus differentiable sheaf diffusion compatible with Eshkol native AD.

(require stdlib)
(require core.exact_linalg)

(provide
  ;; Cell complex constructors (vertices 0..nv-1, oriented edges (u v), triangles (u v w))
  make-cell-complex cell-complex?
  cell-vertex-count cell-edges cell-triangles
  ;; Cellular sheaf over exact Q vector-space stalks
  make-cellular-sheaf cellular-sheaf?
  cellular-sheaf-complex cellular-sheaf-vertex-dims cellular-sheaf-edge-dims
  cellular-sheaf-triangle-dims
  ;; Convenience constructors: constant sheaf & twisted (Mobius / flat bundle) sheaf
  make-constant-cellular-sheaf
  ;; Exact coboundary operators d0: C^0 -> C^1 and d1: C^1 -> C^2
  cellular-sheaf-coboundary-0 cellular-sheaf-coboundary-1
  cellular-sheaf-cochain-valid?
  ;; Exact Hodge-Sheaf Laplacians L0 = d0^T d0 and L1 = d0 d0^T + d1^T d1
  cellular-sheaf-laplacian-0 cellular-sheaf-laplacian-1
  ;; Exact cohomology, harmonic sections & Dirichlet energy
  cellular-sheaf-global-sections cellular-sheaf-betti-0 cellular-sheaf-betti-1
  cellular-sheaf-dirichlet-energy
  ;; Differentiable sheaf diffusion & AD-compatible Dirichlet energy
  cellular-sheaf-diffuse-step)

;; ---------------------------------------------------------------------------
;; Exact rational matrix/vector helpers (strictly via vector / make-vector)
;; ---------------------------------------------------------------------------

(define (cs-zero-mat r c)
  (let ((M (make-vector r #f)))
    (let loop ((i 0))
      (if (< i r) (begin (vector-set! M i (make-vector c 0)) (loop (+ i 1)))))
    M))

(define (cs-mat-set! M i j v) (vector-set! (vector-ref M i) j v))

(define (cs-mat+ A B)
  (let* ((r (vector-length A)) (c (vector-length (vector-ref A 0))) (C (cs-zero-mat r c)))
    (let li ((i 0))
      (if (< i r)
          (begin
            (let lj ((j 0))
              (if (< j c)
                  (begin (cs-mat-set! C i j (+ (exact-matrix-ref A i j) (exact-matrix-ref B i j)))
                         (lj (+ j 1)))))
            (li (+ i 1)))))
    C))

(define (cs-mat-scale s A)
  (let* ((r (vector-length A)) (c (vector-length (vector-ref A 0))) (C (cs-zero-mat r c)))
    (let li ((i 0))
      (if (< i r)
          (begin
            (let lj ((j 0))
              (if (< j c)
                  (begin (cs-mat-set! C i j (* s (exact-matrix-ref A i j)))
                         (lj (+ j 1)))))
            (li (+ i 1)))))
    C))

(define (cs-identity n)
  (let ((I (cs-zero-mat n n)))
    (let loop ((i 0)) (if (< i n) (begin (cs-mat-set! I i i 1) (loop (+ i 1)))))
    I))

(define (cs-blit-add! dst r0 c0 src sign)
  (let ((r (vector-length src)) (c (vector-length (vector-ref src 0))))
    (let li ((i 0))
      (if (< i r)
          (begin
            (let lj ((j 0))
              (if (< j c)
                  (begin
                    (cs-mat-set! dst (+ r0 i) (+ c0 j)
                                 (+ (exact-matrix-ref dst (+ r0 i) (+ c0 j))
                                    (* sign (exact-matrix-ref src i j))))
                    (lj (+ j 1)))))
            (li (+ i 1)))))))

(define (cel-offsets dims-vec)
  (let* ((n (vector-length dims-vec))
         (offs (make-vector (+ n 1) 0)))
    (let loop ((i 0) (acc 0))
      (if (< i n)
          (begin (vector-set! offs i acc)
                 (loop (+ i 1) (+ acc (vector-ref dims-vec i))))
          (begin (vector-set! offs n acc) offs)))))

;; ---------------------------------------------------------------------------
;; Cell complex & cellular sheaf structures
;;   edges:     vector of (u . v) oriented from u to v
;;   triangles: vector of (e0 e1 e2 s0 s1 s2) oriented boundary edge indices + signs
;;   edge-res:  vector of (M_u . M_v) restriction maps F(u)->F(e), F(v)->F(e)
;;   tri-res:   vector of (R0 R1 R2) restriction maps F(e_k)->F(t)
;; ---------------------------------------------------------------------------

(define (make-cell-complex nv edges triangles)
  (vector 'cell-complex-v1 nv
          (if (vector? edges) edges (list->vector edges))
          (if (vector? triangles) triangles (list->vector triangles))))

(define (cell-complex? K)
  (and (vector? K) (= (vector-length K) 4) (eq? (vector-ref K 0) 'cell-complex-v1)))

(define (cell-vertex-count K) (vector-ref K 1))
(define (cell-edges K) (vector-ref K 2))
(define (cell-triangles K) (vector-ref K 3))

(define (make-cellular-sheaf K v-dims e-dims t-dims edge-res tri-res)
  (vector 'cellular-sheaf-v1 K
          (if (vector? v-dims) v-dims (list->vector v-dims))
          (if (vector? e-dims) e-dims (list->vector e-dims))
          (if (vector? t-dims) t-dims (list->vector t-dims))
          (if (vector? edge-res) edge-res (list->vector edge-res))
          (if (vector? tri-res) tri-res (list->vector tri-res))))

(define (cellular-sheaf? F)
  (and (vector? F) (= (vector-length F) 7) (eq? (vector-ref F 0) 'cellular-sheaf-v1)))

(define (cellular-sheaf-complex F) (vector-ref F 1))
(define (cellular-sheaf-vertex-dims F) (vector-ref F 2))
(define (cellular-sheaf-edge-dims F) (vector-ref F 3))
(define (cellular-sheaf-triangle-dims F) (vector-ref F 4))

;; Build constant sheaf with stalk Q^d on every cell and identity restriction maps
(define (make-constant-cellular-sheaf K d)
  (let* ((nv (cell-vertex-count K))
         (ne (vector-length (cell-edges K)))
         (nt (vector-length (cell-triangles K)))
         (Id (cs-identity d))
         (vd (make-vector nv d))
         (ed (make-vector ne d))
         (td (make-vector nt d))
         (er (make-vector ne (cons Id Id)))
         (tr (make-vector nt (list Id Id Id))))
    (make-cellular-sheaf K vd ed td er tr)))

;; ---------------------------------------------------------------------------
;; Exact coboundary matrices d0: C^0 -> C^1 and d1: C^1 -> C^2
;;   (d0 x)_e = F_{v <- e}(x_v) - F_{u <- e}(x_u) for oriented edge e = (u . v)
;;   (d1 y)_t = s0 R0(y_{e0}) + s1 R1(y_{e1}) + s2 R2(y_{e2})
;; ---------------------------------------------------------------------------

(define (cellular-sheaf-coboundary-0 F)
  (let* ((K (cellular-sheaf-complex F))
         (edges (cell-edges K))
         (ne (vector-length edges))
         (v-off (cel-offsets (cellular-sheaf-vertex-dims F)))
         (e-off (cel-offsets (cellular-sheaf-edge-dims F)))
         (total-v (vector-ref v-off (cell-vertex-count K)))
         (total-e (vector-ref e-off ne))
         (er (vector-ref F 5))
         (D0 (cs-zero-mat total-e total-v)))
    (let loop ((ei 0))
      (if (< ei ne)
          (let* ((edge (vector-ref edges ei))
                 (u (car edge))
                 (v (cdr edge))
                 (res (vector-ref er ei))
                 (Mu (car res))
                 (Mv (cdr res))
                 (r0 (vector-ref e-off ei)))
            (cs-blit-add! D0 r0 (vector-ref v-off u) Mu -1)
            (cs-blit-add! D0 r0 (vector-ref v-off v) Mv 1)
            (loop (+ ei 1)))))
    D0))

(define (cellular-sheaf-coboundary-1 F)
  (let* ((K (cellular-sheaf-complex F))
         (tris (cell-triangles K))
         (nt (vector-length tris))
         (ne (vector-length (cell-edges K)))
         (e-off (cel-offsets (cellular-sheaf-edge-dims F)))
         (t-off (cel-offsets (cellular-sheaf-triangle-dims F)))
         (total-e (vector-ref e-off ne))
         (total-t (vector-ref t-off nt))
         (tr (vector-ref F 6)))
    (if (= nt 0)
        #f
        (let ((D1 (cs-zero-mat total-t total-e)))
          (let loop ((ti 0))
            (if (< ti nt)
                (let* ((tri (vector-ref tris ti))
                       (e0 (list-ref tri 0)) (e1 (list-ref tri 1)) (e2 (list-ref tri 2))
                       (s0 (list-ref tri 3)) (s1 (list-ref tri 4)) (s2 (list-ref tri 5))
                       (rmaps (vector-ref tr ti))
                       (r0 (vector-ref t-off ti)))
                  (cs-blit-add! D1 r0 (vector-ref e-off e0) (list-ref rmaps 0) s0)
                  (cs-blit-add! D1 r0 (vector-ref e-off e1) (list-ref rmaps 1) s1)
                  (cs-blit-add! D1 r0 (vector-ref e-off e2) (list-ref rmaps 2) s2)
                  (loop (+ ti 1)))))
          D1))))

(define (cs-mat-zero? M)
  (let ((r (vector-length M)) (c (vector-length (vector-ref M 0))))
    (let li ((i 0))
      (cond ((= i r) #t)
            ((let lj ((j 0))
               (cond ((= j c) #t)
                     ((= (exact-matrix-ref M i j) 0) (lj (+ j 1)))
                     (else #f)))
             (li (+ i 1)))
            (else #f)))))

;; Functoriality check: d1 o d0 == 0 identically over exact Q
(define (cellular-sheaf-cochain-valid? F)
  (let ((D1 (cellular-sheaf-coboundary-1 F)))
    (if (eq? D1 #f) #t
        (cs-mat-zero? (exact-matrix-mul D1 (cellular-sheaf-coboundary-0 F))))))

;; ---------------------------------------------------------------------------
;; Exact Hodge-Sheaf Laplacians:
;;   L0 = d0^T d0
;;   L1 = d0 d0^T + d1^T d1   (when triangles present; else d0 d0^T)
;; ---------------------------------------------------------------------------

(define (cellular-sheaf-laplacian-0 F)
  (let ((D0 (cellular-sheaf-coboundary-0 F)))
    (exact-matrix-mul (exact-matrix-transpose D0) D0)))

(define (cellular-sheaf-laplacian-1 F)
  (let* ((D0 (cellular-sheaf-coboundary-0 F))
         (L1-down (exact-matrix-mul D0 (exact-matrix-transpose D0)))
         (D1 (cellular-sheaf-coboundary-1 F)))
    (if (eq? D1 #f)
        L1-down
        (cs-mat+ L1-down (exact-matrix-mul (exact-matrix-transpose D1) D1)))))

;; Exact harmonic 0-cochains = global sections H^0(X; F) = ker(L0) = ker(d0)
(define (cellular-sheaf-global-sections F)
  (exact-nullspace (cellular-sheaf-laplacian-0 F)))

;; Exact sheaf Betti numbers:
;;   b_0 = dim H^0(X; F) = dim ker(L0)
;;   b_1 = dim H^1(X; F) = dim ker(L1)
(define (cellular-sheaf-betti-0 F)
  (let* ((L0 (cellular-sheaf-laplacian-0 F))
         (n (vector-length L0)))
    (- n (exact-rank L0))))

(define (cellular-sheaf-betti-1 F)
  (let* ((L1 (cellular-sheaf-laplacian-1 F))
         (n (vector-length L1)))
    (- n (exact-rank L1))))

;; Exact quadratic Dirichlet energy E(x) = x^T L0 x = ||d0 x||^2
(define (cellular-sheaf-dirichlet-energy L0 x)
  (let ((n (vector-length L0)))
    (let li ((i 0) (acc 0))
      (if (= i n) acc
          (let ((xi (vector-ref x i)))
            (li (+ i 1)
                (+ acc
                   (let lj ((j 0) (s 0))
                     (if (= j n) (* xi s)
                         (lj (+ j 1) (+ s (* (exact-matrix-ref L0 i j) (vector-ref x j)))))))))))))

;; One explicit sheaf-diffusion step: x_{t+1} = x_t - alpha * (L0 * x_t)
;; Works identically for exact rational alpha/x or differentiable AD values!
(define (cellular-sheaf-diffuse-step L0 alpha x)
  (let* ((n (vector-length L0))
         (out (make-vector n 0)))
    (let li ((i 0))
      (if (< i n)
          (let ((lx (let lj ((j 0) (s 0))
                      (if (= j n) s
                          (lj (+ j 1) (+ s (* (exact-matrix-ref L0 i j) (vector-ref x j))))))))
            (vector-set! out i (- (vector-ref x i) (* alpha lx)))
            (li (+ i 1)))))
    out))
