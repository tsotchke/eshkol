;;; Copyright (C) tsotchke. SPDX-License-Identifier: MIT
;;; Pure compiler pass over an already resolved scalar binary DAG.
;;; Input:  (vector 1 input-count output-index nodes)
;;; Node:   (vector kind input-index operands); kind 0=input, 1=constant,
;;;         2=binary primitive. Literal values and binding/source identities
;;;         remain in the caller's graph and are never evaluated here.
;;; Output: (vector 1 capacity height operand-edges kernels consumers)
;;; Consumers are increasing, duplicate-free node-index vectors. Repeated
;;; operands count twice as edges but enqueue their consumer only once.
(provide incremental-plan)

(define (ip-index? value limit)
  (and (integer? value) (exact? value) (>= value 0) (< value limit)))

(define (incremental-plan graph)
  (if (not (and (vector? graph) (= (vector-length graph) 4)
                (eqv? (vector-ref graph 0) 1)))
      (error "incremental plan: unsupported graph schema"))
  (let ((width (vector-ref graph 1)) (output (vector-ref graph 2))
        (nodes (vector-ref graph 3)))
    (if (not (and (ip-index? width 65) (> width 0) (vector? nodes)))
        (error "incremental plan: invalid inputs"))
    (let ((count (vector-length nodes)))
      (if (not (and (>= count width) (<= count 1024) (ip-index? output count)))
          (error "incremental plan: invalid graph size or output"))
      (let ((consumers (make-vector count '())) (sizes (make-vector count 0)) (edges 0) (kernels 0))
        (let walk ((i 0))
          (if (< i count)
              (let ((node (vector-ref nodes i)))
                (if (not (and (vector? node) (= (vector-length node) 3)))
                    (error "incremental plan: invalid node"))
                (let ((kind (vector-ref node 0)) (input (vector-ref node 1))
                      (parents (vector-ref node 2)))
                  (if (not (and (ip-index? kind 3) (vector? parents)
                                (= (vector-length parents) (if (= kind 2) 2 0))))
                      (error "incremental plan: invalid node kind or arity"))
                  (if (< i width)
                      (if (not (and (= kind 0) (eqv? input i)))
                          (error "incremental plan: invalid input prefix"))
                      (if (= kind 0) (error "incremental plan: misplaced input")))
                  (if (= kind 2)
                      (let ((a (vector-ref parents 0)) (b (vector-ref parents 1)))
                        (if (not (and (ip-index? a i) (ip-index? b i)))
                            (error "incremental plan: non-topological operand"))
                        (set! edges (+ edges 2))
                        (set! kernels (+ kernels 1))
                        (vector-set! consumers a (cons i (vector-ref consumers a)))
                        (vector-set! sizes a (+ (vector-ref sizes a) 1))
                        (if (not (= a b))
                            (begin
                              (vector-set! consumers b (cons i (vector-ref consumers b)))
                              (vector-set! sizes b (+ (vector-ref sizes b) 1)))))))
                (walk (+ i 1)))))
        (let finish ((i 0))
          (if (< i count)
              (let ((row (make-vector (vector-ref sizes i) 0)))
                (let copy ((rest (vector-ref consumers i)) (slot (- (vector-ref sizes i) 1)))
                  (if (pair? rest)
                      (begin (vector-set! row slot (car rest)) (copy (cdr rest) (- slot 1)))))
                (vector-set! consumers i row)
                (finish (+ i 1)))))
        (let shape ((capacity 1) (height 0))
          (if (< capacity count)
              (shape (* capacity 2) (+ height 1))
              (vector 1 capacity height edges kernels consumers)))))))
