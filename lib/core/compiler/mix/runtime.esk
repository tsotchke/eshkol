;;; Strict, bounded reference execution of the mix-v1 first-order data language.
(require core.list.compound)
(provide mix-limits mix-run mix-result-status mix-result-value mix-result-work
         mix-result-allocations mix-inputs mix-options mix-specialize-with
         mix-apply-with mx-boolean mx-truth mx-copy mx-free mx-union mx-proper?
         mx-name? mx-nth mx-runtime mx-result mx-optioned)

;; Limits cover expression visits, object evaluation depth, accounted pair
;; allocations, and validation/output tree occurrences. They are not RSS limits.
(define (mix-limits work depth allocations nodes)
  (vector 'mix-limits-v1 work depth allocations nodes))
(define (mix-result-status r) (vector-ref r 1))
(define (mix-result-value r) (vector-ref r 2))
(define (mix-result-work r) (vector-ref r 3))
(define (mix-result-allocations r) (vector-ref r 4))
(define (mix-inputs r) (vector-ref r 5))
(define (mx-boolean x) (if x 'true 'false))
(define (mx-truth x) (not (or (null? x) (eq? x 'false))))
(define (mx-int? x) (and (integer? x) (exact? x)))
(define (mx-name? x) (or (symbol? x) (and (pair? x) (equal? (car x) 'residual))))
(define (mx-nth xs n) (if (or (null? xs) (= n 0)) (if (pair? xs) (car xs) '()) (mx-nth (cdr xs) (- n 1))))
(define (mx-proper? x)
  (if (null? x) #t (if (pair? x) (mx-proper? (cdr x)) #f)))
(define (mx-copy x)
  ;; Existing structural hash tables select a bucket; EQ, not EQUAL, selects
  ;; the original cell within it. Preserve aliases without merging equal cells.
  (let ((table (make-hash-table)))
    (define (copy value)
      (if (not (pair? value)) value
          (let* ((bucket (if (hash-table-contains? table value) (hash-table-ref table value) '()))
                 (known (let find ((rest bucket))
                          (if (null? rest) #f (if (eq? value (caar rest)) (car rest) (find (cdr rest)))))))
            (if known (cdr known)
                (let* ((a (copy (car value))) (b (copy (cdr value))) (fresh (cons a b))
                       (now (if (hash-table-contains? table value) (hash-table-ref table value) '())))
                  (hash-table-set! table value (cons (cons value fresh) now)) fresh)))))
    (copy x)))
(define (mx-member x xs)
  (if (null? xs) #f (if (equal? x (car xs)) #t (mx-member x (cdr xs)))))
(define (mx-union a b)
  (if (null? a) b (mx-union (cdr a) (if (mx-member (car a) b) b (cons (car a) b)))))
(define (mx-reverse xs)
  (let loop ((rest xs) (out '())) (if (null? rest) out (loop (cdr rest) (cons (car rest) out)))))
(define (mx-free e bound)
  (cond ((mx-int? e) '())
        ((not (pair? e)) '())
        ((eq? (car e) 'quote) '())
        ((eq? (car e) 'var) (if (mx-member (cadr e) bound) '() (list (cadr e))))
        ((eq? (car e) 'let)
         (let loop ((bs (cadr e)) (scope bound) (out '()))
           (if (null? bs) (mx-union out (mx-free (caddr e) scope))
               (loop (cdr bs) (cons (caar bs) scope)
                     (mx-union out (mx-free (cadar bs) scope))))))
        (else (let loop ((es (if (eq? (car e) 'if) (cdr e) (cddr e))) (out '()))
                (if (null? es) out (loop (cdr es) (mx-union out (mx-free (car es) bound))))))))

;; Context: status, visits remaining, visits, depth bound, allocation bound,
;; accounted allocations, data occurrence bound, validation occurrences.
(define (mx-fail s why) (if (eq? (vector-ref s 0) 'running) (vector-set! s 0 why)) '())
(define (mx-active? s) (eq? (vector-ref s 0) 'running))
(define (mx-allocate s n)
  (vector-set! s 5 (+ (vector-ref s 5) n))
  (if (> (vector-ref s 5) (vector-ref s 4)) (mx-fail s 'allocation-bound) #t))
(define (mx-cons s a b) (mx-allocate s 1) (if (mx-active? s) (cons a b) '()))
(define (mx-data s x depth)
  ;; An explicit worklist separates list length from evaluation nesting. Cycles
  ;; consume the finite occurrence budget and refuse without recursive descent.
  (let walk ((pending (list (cons x (cons 0 0)))))
    (if (not (mx-active? s)) #f
        (if (null? pending) #t
            (begin
              (vector-set! s 7 (+ (vector-ref s 7) 1))
              (if (> (vector-ref s 7) (vector-ref s 6)) (begin (mx-fail s 'data-bound) #f)
                  (let* ((entry (car pending)) (item (car entry)) (nesting (cadr entry)) (spine (cddr entry)) (rest (cdr pending)))
                    (if (> nesting 256) (begin (mx-fail s 'data-depth-bound) #f)
                    (if (> spine 2048) (begin (mx-fail s 'data-spine-bound) #f)
                    (if (pair? item) (walk (cons (cons (car item) (cons (+ nesting 1) 0))
                                               (cons (cons (cdr item) (cons nesting (+ spine 1))) rest)))
                        (if (or (null? item) (symbol? item) (mx-int? item)) (walk rest)
                            (begin (mx-fail s 'invalid-data) #f))))))))))))
(define (mx-length xs) (if (null? xs) 0 (+ 1 (mx-length (cdr xs)))))
(define (mx-lookup s key env)
  (cond ((null? env) (mx-fail s 'unbound-variable))
        ((equal? key (caar env)) (cdar env))
        (else (mx-lookup s key (cdr env)))))
(define (mx-find name fs)
  (if (null? fs) #f (if (equal? name (caar fs)) (car fs) (mx-find name (cdr fs)))))
(define (mx-env? env)
  (if (null? env) #t
      (and (pair? env) (pair? (car env)) (symbol? (caar env)) (mx-env? (cdr env)))))
(define (mx-arity op)
  (cond ((eq? op 'list) -1)
        ((mx-member op '(cons append eq equal + - * = < <= mod shr inline-ok apply-prim)) 2)
        ((mx-member op '(car cdr first second third fourth reverse null pairp atomp symbolp integerp booleanp not truthy)) 1)
        (else -2)))
(define (mx-symbols? xs)
  (if (null? xs) #t (and (symbol? (car xs)) (not (mx-member (car xs) (cdr xs))) (mx-symbols? (cdr xs)))))
(define (mx-exprs? es fs)
  (if (null? es) #t (and (mx-expr? (car es) fs) (mx-exprs? (cdr es) fs))))
(define (mx-expr? e fs)
  (if (mx-int? e) #t
      (and (pair? e) (mx-proper? e)
           (let ((tag (car e)) (n (mx-length e)))
             (and (<= n 66) (cond ((eq? tag 'quote) (= n 2))
                   ((eq? tag 'var) (and (= n 2) (symbol? (cadr e))))
                   ((eq? tag 'if) (and (= n 4) (mx-exprs? (cdr e) fs)))
                   ((eq? tag 'let)
                    (and (= n 3) (mx-proper? (cadr e)) (<= (mx-length (cadr e)) 64)
                         (let loop ((bs (cadr e)))
                           (if (null? bs) (mx-expr? (caddr e) fs)
                               (and (mx-proper? (car bs)) (= (mx-length (car bs)) 2)
                                    (symbol? (caar bs)) (mx-expr? (cadar bs) fs) (loop (cdr bs)))))))
                   ((eq? tag 'prim)
                    (and (>= n 2) (symbol? (cadr e))
                         (let ((arity (mx-arity (cadr e))))
                           (and (>= arity -1) (or (= arity -1) (= arity (- n 2))) (mx-exprs? (cddr e) fs)))))
                   ((eq? tag 'call)
                    (and (>= n 2) (let ((entry (mx-find (cadr e) fs)))
                                    (and entry (= (- n 2) (mx-length (cadr entry))) (mx-exprs? (cddr e) fs)))))
                   (else #f)))))))
(define (mx-program? p)
  (and (mx-proper? p) (= (mx-length p) 3) (eq? (car p) 'program) (mx-proper? (cadr p)) (<= (mx-length (cadr p)) 256)
       (let loop ((fs (cadr p)) (seen '()))
         (if (null? fs)
             (and (mx-expr? (caddr p) (cadr p))
                  (let bodies ((rest (cadr p)))
                    (if (null? rest) #t
                        (and (mx-expr? (caddar rest) (cadr p))
                             (null? (mx-free (caddar rest) (cadar rest))) (bodies (cdr rest))))))
             (let ((fd (car fs)))
               (and (mx-proper? fd) (= (mx-length fd) 3) (mx-name? (car fd))
                    (not (mx-member (car fd) seen)) (mx-proper? (cadr fd)) (<= (mx-length (cadr fd)) 64) (mx-symbols? (cadr fd))
                    (loop (cdr fs) (cons (car fd) seen))))))))
(define (mx-static? sd) (and (pair? sd) (eq? (car sd) 's)))
(define (mx-any-static? xs)
  (if (null? xs) #f (if (mx-static? (car xs)) #t (mx-any-static? (cdr xs)))))
(define (mx-inline? name args)
  (cond ((mx-member name '(mix pe pe-prim pe-if pe-let pe-call pe-list all-static-p sd-values sd-residuals user-env->sd))
         (mx-static? (mx-nth args 0)))
        ((mx-member name '(env-lookup find-fun)) (mx-static? (mx-nth args 1)))
        ((eq? name 'params->env) (and (mx-static? (mx-nth args 0)) (mx-static? (mx-nth args 1))))
        (else (mx-any-static? args))))
(define (mx-car s x) (if (null? x) '() (if (pair? x) (car x) (mx-fail s 'primitive-type))))
(define (mx-cdr s x) (if (null? x) '() (if (pair? x) (cdr x) (mx-fail s 'primitive-type))))
(define (mx-rev-alloc s xs out)
  (if (or (not (mx-active? s)) (null? xs)) out (mx-rev-alloc s (cdr xs) (mx-cons s (car xs) out))))
(define (mx-append s a b)
  (mx-rev-alloc s (mx-rev-alloc s a '()) b))
(define (mx-prim s op args) (mx-primitive s op args 0))
(define (mx-primitive s op args dispatch-depth)
  (let ((a (mx-nth args 0)) (b (mx-nth args 1)) (n (mx-arity op)))
    (cond ((not (mx-active? s)) '())
          ((> dispatch-depth (vector-ref s 3)) (mx-fail s 'depth-bound))
          ((or (= n -2) (not (mx-proper? args)) (and (>= n 0) (not (= n (mx-length args))))) (mx-fail s 'primitive-arity))
          ((eq? op 'list) args)
          ((eq? op 'cons) (mx-cons s a b))
          ((mx-member op '(car first)) (mx-car s a))
          ((eq? op 'cdr) (mx-cdr s a))
          ((eq? op 'second) (mx-car s (mx-cdr s a)))
          ((eq? op 'third) (mx-car s (mx-cdr s (mx-cdr s a))))
          ((eq? op 'fourth) (mx-car s (mx-cdr s (mx-cdr s (mx-cdr s a)))))
          ((eq? op 'append) (if (mx-proper? a) (mx-append s a b) (mx-fail s 'primitive-type)))
          ((eq? op 'reverse) (if (mx-proper? a) (mx-rev-alloc s a '()) (mx-fail s 'primitive-type)))
          ((eq? op 'null) (mx-boolean (null? a)))
          ((eq? op 'pairp) (mx-boolean (pair? a)))
          ((eq? op 'atomp) (mx-boolean (not (pair? a))))
          ((eq? op 'symbolp) (mx-boolean (or (null? a) (symbol? a))))
          ((eq? op 'integerp) (mx-boolean (mx-int? a)))
          ((eq? op 'booleanp) (mx-boolean (or (eq? a 'true) (eq? a 'false))))
          ((eq? op 'not) (mx-boolean (not (mx-truth a))))
          ((eq? op 'truthy) (mx-boolean (mx-truth a)))
          ;; Numeric EQ is implementation-dependent in the source host. Refuse.
          ((eq? op 'eq) (if (and (mx-int? a) (mx-int? b)) (mx-fail s 'unsupported-identity) (mx-boolean (eq? a b))))
          ((eq? op 'equal) (mx-boolean (equal? a b)))
          ((eq? op 'inline-ok) (if (mx-proper? b) (mx-boolean (mx-inline? a b)) (mx-fail s 'primitive-type)))
          ((eq? op 'apply-prim) (if (and (symbol? a) (mx-proper? b)) (mx-primitive s a b (+ dispatch-depth 1)) (mx-fail s 'primitive-type)))
          ((not (and (mx-int? a) (mx-int? b))) (mx-fail s 'primitive-type))
          ((eq? op '+) (+ a b)) ((eq? op '-) (- a b)) ((eq? op '*) (* a b))
          ((eq? op '=) (mx-boolean (= a b))) ((eq? op '<) (mx-boolean (< a b))) ((eq? op '<=) (mx-boolean (<= a b)))
          ((eq? op 'mod) (if (= b 0) 0 (modulo a b)))
          ((eq? op 'shr) (let* ((k (modulo b 64)) (d (expt 2 k)) (r (modulo a d))) (quotient (- a r) d)))
          (else (mx-fail s 'unsupported-primitive)))))
(define (mx-args s es env fs depth)
  (if (or (not (mx-active? s)) (null? es)) '()
      (let* ((a (mx-eval s (car es) env fs depth)) (rest (mx-args s (cdr es) env fs depth))) (mx-cons s a rest))))
(define (mx-bind s ps vs)
  (if (or (not (mx-active? s)) (null? ps)) '()
      (mx-cons s (mx-cons s (car ps) (car vs)) (mx-bind s (cdr ps) (cdr vs)))))
(define (mx-lets s bs env body fs depth)
  (if (not (mx-active? s)) '()
      (if (null? bs) (mx-eval s body env fs depth)
          (let* ((value (mx-eval s (cadar bs) env fs depth)) (next (mx-cons s (mx-cons s (caar bs) value) env)))
            (mx-lets s (cdr bs) next body fs depth)))))
(define (mx-eval s e env fs depth)
  (cond ((not (mx-active? s)) '())
        ((> depth (vector-ref s 3)) (mx-fail s 'depth-bound))
        ((<= (vector-ref s 1) 0) (mx-fail s 'work-bound))
        (else
         (vector-set! s 1 (- (vector-ref s 1) 1)) (vector-set! s 2 (+ (vector-ref s 2) 1))
         (if (mx-int? e) e
             (case (car e)
               ((quote) (cadr e))
               ((var) (mx-lookup s (cadr e) env))
               ((if) (let ((test (mx-eval s (cadr e) env fs (+ depth 1))))
                       (mx-eval s (if (mx-truth test) (caddr e) (cadddr e)) env fs (+ depth 1))))
               ((let) (mx-lets s (cadr e) env (caddr e) fs (+ depth 1)))
               ((prim) (mx-prim s (cadr e) (mx-args s (cddr e) env fs (+ depth 1))))
               ((call) (let* ((fd (mx-find (cadr e) fs)) (args (mx-args s (cddr e) env fs (+ depth 1))))
                         (mx-eval s (caddr fd) (mx-bind s (cadr fd) args) fs (+ depth 1))))
               (else (mx-fail s 'invalid-program)))))))
(define (mx-result status value work allocations inputs origin)
  (vector 'mix-result-v1 status value work allocations inputs origin))
(define (mx-valid-limits? l)
  (and (vector? l) (= (vector-length l) 5) (eq? (vector-ref l 0) 'mix-limits-v1)
       (let loop ((i 1)) (if (= i 5) #t (and (mx-int? (vector-ref l i)) (>= (vector-ref l i) 0) (loop (+ i 1)))))
       (<= (vector-ref l 2) 4096)))
(define (mx-runtime p env limits inputs origin)
  (if (not (mx-valid-limits? limits)) (mx-result 'invalid-limits '() 0 0 '() origin)
      (let ((s (vector 'running (vector-ref limits 1) 0 (vector-ref limits 2) (vector-ref limits 3) 0 (vector-ref limits 4) 0)))
        (if (and (mx-data s p 0) (mx-data s env 0))
            (if (not (and (mx-program? p) (mx-env? env)))
                (mx-result 'invalid-program '() 0 0 inputs origin)
                (let* ((snapshot (mx-copy (cons p env))) (owned-program (car snapshot)) (owned-env (cdr snapshot))
                       (value (mx-eval s (caddr owned-program) owned-env (cadr owned-program) 0)))
                  (if (mx-active? s)
                      (begin (vector-set! s 7 0)
                             (if (mx-data s value 0) (vector-set! s 0 'normal))))
                  (if (eq? (vector-ref s 0) 'normal)
                      (mx-result 'normal value (vector-ref s 2) (vector-ref s 5) inputs origin)
                      (mx-result (vector-ref s 0) '() (vector-ref s 2) (vector-ref s 5) inputs origin))))
            (mx-result (vector-ref s 0) '() 0 0 inputs origin)))))
(define (mix-run p env limits) (mx-runtime p env limits '() 'reference))
(define (mix-options generalization polyvariance) (vector 'mix-options-v1 generalization polyvariance))
(define (mx-optioned env options)
  (cons (cons 'polyvariance-limit (vector-ref options 2))
        (cons (cons 'memo-enabled 'true) (cons (cons 'generalization-bound (vector-ref options 1)) env))))
(define (mx-dynamic-inputs p statics)
  (let loop ((names (mx-free (caddr p) '())) (out '()))
    (if (null? names) (mx-reverse out)
        (loop (cdr names) (if (mx-find (car names) statics) out (cons (car names) out))))))
(define (mx-options? o)
  (and (vector? o) (= (vector-length o) 3) (eq? (vector-ref o 0) 'mix-options-v1)
       (mx-int? (vector-ref o 1)) (> (vector-ref o 1) 0) (mx-int? (vector-ref o 2)) (> (vector-ref o 2) 0)))
(define (mix-specialize-with specializer p statics options limits)
  (let ((pre (mix-run p statics (mix-limits 0 512 0 300000)))
        (producer (mix-run specializer '() (mix-limits 0 512 0 300000))))
    ;; A zero-work run validates source/data before any free-variable traversal.
    (if (and (eq? (mix-result-status pre) 'work-bound) (eq? (mix-result-status producer) 'work-bound) (mx-options? options))
        (mx-runtime specializer (list (cons 'program p) (cons 'static-env (mx-optioned statics options)))
                    limits (mx-dynamic-inputs p statics) (mx-copy (list 'specialize specializer p statics (list (vector-ref options 1) (vector-ref options 2)))))
        (mx-result 'invalid-specialization '() 0 0 '() 'specialize))))
(define (mix-apply-with compiler target statics options limits)
  (let ((pre (mix-run target statics (mix-limits 0 512 0 300000)))
        (producer (mix-run compiler '() (mix-limits 0 512 0 300000))))
    (if (and (eq? (mix-result-status pre) 'work-bound) (eq? (mix-result-status producer) 'work-bound) (mx-options? options))
        (mx-runtime compiler (list (cons 'static-env (mx-optioned statics options))) limits
                    (mx-dynamic-inputs target statics) (mx-copy (list 'compiler-application compiler target statics (list (vector-ref options 1) (vector-ref options 2)))))
        (mx-result 'invalid-specialization '() 0 0 '() 'compiler-application))))
