;;; Deterministic scalar residual -> ordinary Scheme source. No runtime JIT.
(require core.compiler.mix.runtime)
(require core.list.compound)
(provide mix-emit-eshkol)
(define (me-fail s) (vector-set! s 0 #f) '())
(define (me-name s)
  (let ((n (vector-ref s 1)))
    (vector-set! s 1 (+ n 1)) (string->symbol (string-append "mix-local-" (number->string n)))))
(define (me-find name xs)
  (if (null? xs) #f (if (equal? name (caar xs)) (car xs) (me-find name (cdr xs)))))
(define (me-map-names s names)
  (if (null? names) '() (cons (cons (car names) (me-name s)) (me-map-names s (cdr names)))))
(define (me-values xs) (if (null? xs) '() (cons (cdar xs) (me-values (cdr xs)))))
(define (me-append a b) (if (null? a) b (cons (car a) (me-append (cdr a) b))))
(define (me-expression-calls expressions)
  (if (null? expressions) '()
      (mx-union (me-calls (car expressions)) (me-expression-calls (cdr expressions)))))
(define (me-binding-calls bindings)
  (if (null? bindings) '()
      (mx-union (me-calls (cadar bindings)) (me-binding-calls (cdr bindings)))))
(define (me-calls e)
  ;; Traverse expression positions in the admitted grammar. Binding names,
  ;; function names and quoted values are data even when spelled CALL/QUOTE.
  (if (not (pair? e)) '()
      (case (car e)
        ((quote var) '())
        ((prim) (me-expression-calls (cddr e)))
        ((call) (mx-union (list (cadr e)) (me-expression-calls (cddr e))))
        ((if) (me-expression-calls (cdr e)))
        ((let) (mx-union (me-binding-calls (cadr e)) (me-calls (caddr e))))
        (else '()))))
(define (me-reachable s todo seen fs)
  (if (or (not (vector-ref s 0)) (null? todo)) seen
      (if (me-find (car todo) seen) (me-reachable s (cdr todo) seen fs)
          (let ((fd (me-find (car todo) fs)))
            (if (not fd) (me-fail s)
                (me-reachable s (mx-union (cdr todo) (me-calls (caddr fd))) (cons fd seen) fs))))))
(define (me-has? name names)
  (if (null? names) #f (if (equal? name (car names)) #t (me-has? name (cdr names)))))
(define (me-check-calls s names fs active)
  (if (null? names) #t (and (me-visit s (car names) fs active) (me-check-calls s (cdr names) fs active))))
(define (me-visit s name fs active)
  (if (me-has? name active) #f
      (if (me-has? name (vector-ref s 2)) #t
          (let ((fd (me-find name fs)))
            (if (and fd (me-check-calls s (me-calls (caddr fd)) fs (cons name active)))
                (begin (vector-set! s 2 (cons name (vector-ref s 2))) #t) #f)))))
(define (me-args s es scope fnames)
  (if (null? es) '() (cons (me-expr s (car es) scope fnames #f) (me-args s (cdr es) scope fnames))))
(define (me-lets s bs body scope fnames truth)
  (if (null? bs) (me-expr s body scope fnames truth)
      (let* ((name (me-name s)) (value (me-expr s (cadar bs) scope fnames #f))
             (rest (me-lets s (cdr bs) body (cons (cons (caar bs) name) scope) fnames truth)))
        (list 'let (list (list name value)) rest))))
(define (me-primitive s op args scope fnames truth)
  (if (not (or (eq? op '+) (eq? op '-) (eq? op '*) (eq? op '=) (eq? op '<) (eq? op '<=) (eq? op 'mod) (eq? op 'shr)))
      (me-fail s)
  (let* ((es (me-args s args scope fnames)) (a (me-name s)) (b (me-name s))
         (operands (list (list a (car es)) (list b (cadr es)))))
    (cond ((or (eq? op '+) (eq? op '-) (eq? op '*)) (cons op es))
          ((or (eq? op '=) (eq? op '<) (eq? op '<=))
           (if truth (list 'if (cons op es) (list 'quote 'true) (list 'quote 'false)) (me-fail s)))
          ((eq? op 'mod) (list 'let* operands (list 'if (list '= b 0) 0 (list 'modulo a b))))
          ((eq? op 'shr)
           (let ((d (me-name s)))
             (list 'let* (me-append operands (list (list d (list 'expt 2 (list 'modulo b 64)))))
                   (list 'quotient (list '- a (list 'modulo a d)) d))))
          (else (me-fail s))))))
(define (me-expr s e scope fnames truth)
  (cond ((not (vector-ref s 0)) '())
        ((integer? e) e)
        ((eq? (car e) 'quote)
         (let ((v (cadr e)))
           (if (and (integer? v) (exact? v)) v
               (if (and truth (or (eq? v 'true) (eq? v 'false) (null? v))) (list 'quote v) (me-fail s)))))
        ((eq? (car e) 'var) (let ((cell (me-find (cadr e) scope))) (if cell (cdr cell) (me-fail s))))
        ((eq? (car e) 'let) (me-lets s (cadr e) (caddr e) scope fnames truth))
        ((eq? (car e) 'if)
         (let ((test (me-name s)))
           (list 'let (list (list test (me-expr s (cadr e) scope fnames #t)))
                 (list 'if (list 'and (list 'not (list 'null? test)) (list 'not (list 'eq? test (list 'quote 'false))))
                       (me-expr s (caddr e) scope fnames truth) (me-expr s (cadddr e) scope fnames truth)))))
        ((eq? (car e) 'prim) (me-primitive s (cadr e) (cddr e) scope fnames truth))
        ((eq? (car e) 'call)
         (let ((cell (me-find (cadr e) fnames)))
           (if cell (cons (cdr cell) (me-args s (cddr e) scope fnames)) (me-fail s))))
        (else (me-fail s))))
(define (me-defs s fs fnames)
  (if (null? fs) '()
      (let* ((fd (car fs)) (scope (me-map-names s (cadr fd)))
             (body (me-expr s (caddr fd) scope fnames #f)))
        (cons (list (cdr (me-find (car fd) fnames)) (list 'lambda (me-values scope) body)) (me-defs s (cdr fs) fnames)))))
(define (me-checks scope)
  (if (null? scope) '()
      (cons (list 'if (list 'not (list 'and (list 'integer? (cdar scope)) (list 'exact? (cdar scope))))
                  (list 'error "mix residual requires exact integer input" (list 'quote (caar scope))))
            (me-checks (cdr scope)))))
(define (me-inputs? inputs)
  (and (mx-proper? inputs)
       (let check ((rest inputs) (seen '()) (count 0))
         (if (null? rest) #t
             (and (< count 64) (symbol? (car rest)) (not (me-has? (car rest) seen))
                  (check (cdr rest) (cons (car rest) seen) (+ count 1)))))))
(define (me-public-name? name)
  ;; Keep the export outside syntax names and this wrapper's runtime imports.
  ;; Otherwise a public MODULO/NOT binding can capture a generated operation.
  (and (symbol? name)
       (not (me-has? name '(and or not if cond case else do define lambda let letrec
                           begin quote quasiquote unquote unquote-splicing when unless
                           delay delay-force define-values define-syntax define-library
                           let-values letrec-values case-lambda syntax-rules require provide
                           import export include include-ci include-library-declarations
                           cond-expand error modulo quotient expt)))
       (let ((text (symbol->string name)))
         (and (> (string-length text) 0)
              (let loop ((i 0))
                (if (= i (string-length text)) #t
                    (let ((c (string-ref text i)))
                      (and (or (and (char>=? c #\a) (char<=? c #\z))
                               (and (> i 0) (or (and (char>=? c #\0) (char<=? c #\9)) (char=? c #\-) (char=? c #\_))))
                           (loop (+ i 1))))))))))
(define (mix-emit-eshkol result name)
  (let ((s (vector #t 0 '())))
    (if (not (and (vector? result) (= (vector-length result) 7) (eq? (vector-ref result 0) 'mix-result-v1)
                  (eq? (mix-result-status result) 'normal) (me-public-name? name)))
        (vector 'mix-emission-v1 'invalid-result '() '())
        (let* ((p (mix-result-value result)) (inputs (mix-inputs result))
               (metadata (mix-run p (list (cons 'contract inputs)) (mix-limits 0 512 0 300000))))
          ;; Validate the entire wire datum before walking caller-controlled ABI
          ;; metadata. A stored NORMAL tag does not bypass syntax/data admission.
          (if (not (and (eq? (mix-result-status metadata) 'work-bound) (me-inputs? inputs)))
              (vector 'mix-emission-v1 'invalid-residual '() '())
        (let* (
               (env (let bind ((rest inputs)) (if (null? rest) '() (cons (cons (car rest) 0) (bind (cdr rest))))))
               (pre (mix-run p env (mix-limits 0 512 0 300000))))
          (if (not (eq? (mix-result-status pre) 'work-bound))
              (vector 'mix-emission-v1 'invalid-residual '() inputs)
              (let* ((fs (me-reachable s (me-calls (caddr p)) '() (cadr p)))
                     (acyclic (me-check-calls s (me-calls (caddr p)) fs '()))
                     (fnames (let names ((rest fs))
                               (if (null? rest) '() (cons (cons (caar rest) (me-name s)) (names (cdr rest))))))
                     (scope (me-map-names s inputs)) (defs (me-defs s fs fnames))
                     (body (me-expr s (caddr p) scope fnames #f))
                     (form (list 'define (cons name (me-values scope))
                                 (cons 'begin (me-append (me-checks scope) (list (list 'letrec defs body)))))))
                (if (and acyclic (vector-ref s 0))
                    (vector 'mix-emission-v1 'normal (list (list 'provide name) form) inputs)
                    (vector 'mix-emission-v1 'unsupported-residual '() inputs))))))))))
