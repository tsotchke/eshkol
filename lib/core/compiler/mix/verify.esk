;;; Independent value-equivalence admission for the integer polynomial fragment.
(require core.compiler.mix.runtime)
(require core.symbolic)
(require core.list.transform)
(require core.list.query)
(require core.list.compound)
(provide mix-verification-limits mix-verify-specialization
         mix-verification-status mix-verification-reason)

(define (mix-verification-limits work depth terms nodes)
  (vector 'mix-verification-limits-v1 work depth terms nodes))
(define (mix-verification-status r) (vector-ref r 1))
(define (mix-verification-reason r) (vector-ref r 2))
(define (mv-result status reason) (vector 'mix-verification-v1 status reason))
(define (mv-integer? x) (and (integer? x) (exact? x)))
(define (mv-limits? l)
  (and (vector? l) (= (vector-length l) 5)
       (eq? (vector-ref l 0) 'mix-verification-limits-v1)
       (let loop ((i 1) (caps '(1000000 128 512 300000)))
         (if (= i 5) #t
             (and (mv-integer? (vector-ref l i)) (>= (vector-ref l i) 0)
                  (<= (vector-ref l i) (car caps)) (loop (+ i 1) (cdr caps)))))))
(define (mv-find name xs)
  (if (null? xs) #f (if (equal? name (caar xs)) (car xs) (mv-find name (cdr xs)))))
(define (mv-has? name xs)
  (if (null? xs) #f (if (equal? name (car xs)) #t (mv-has? name (cdr xs)))))
(define (mv-inputs? xs)
  (and (mx-proper? xs)
       (let loop ((rest xs) (seen '()) (n 0))
         (if (null? rest) #t
             (and (< n 64) (symbol? (car rest)) (not (mv-has? (car rest) seen))
                  (loop (cdr rest) (cons (car rest) seen) (+ n 1)))))))
(define (mv-statics? xs)
  (if (null? xs) #t (and (mv-integer? (cdar xs)) (mv-statics? (cdr xs)))))
(define (mv-inputs p statics)
  (let loop ((names (mx-free (caddr p) '())) (out '()))
    (if (null? names) (reverse out)
        (loop (cdr names) (if (mv-find (car names) statics) out (cons (car names) out))))))
;; State: first refusal reason, remaining shared work, nesting, term-product cap.
(define (mv-active? s) (eq? (vector-ref s 0) 'running))
(define (mv-fail s reason)
  (if (mv-active? s) (vector-set! s 0 reason)) (poly-const 0))
(define (mv-charge s n)
  (if (not (mv-active? s)) #f
      (if (> n (vector-ref s 1)) (begin (mv-fail s 'work-bound) #f)
          (begin (vector-set! s 1 (- (vector-ref s 1) n)) #t))))
(define (mv-admit s p)
  ;; These are owned Q-polynomials from core.symbolic's documented three-list
  ;; representation. Reject inexact/oversized results before any comparison.
  (if (and (<= (length (caddr p)) (vector-ref s 3))
           (<= (poly-degree p) 1000000)
           (let loop ((ts (caddr p)))
             (if (null? ts) #t
                 (and (mv-integer? (cdar ts))
                      (<= (string-length (number->string (cdar ts))) 1024)
                      (loop (cdr ts))))))
      p (mv-fail s 'coefficient-or-degree-bound)))
(define (mv-operation s op a b)
  (let* ((na (length (caddr a))) (nb (length (caddr b)))
         (cost (if (eq? op '*) (* na nb) (+ na nb))))
    ;; Check the unreduced Cartesian product BEFORE allocating its terms.
    (if (> cost (vector-ref s 3)) (mv-fail s 'term-bound)
        (if (mv-charge s (+ cost 1))
            (mv-admit s (cond ((eq? op '+) (poly+ a b))
                              ((eq? op '-) (poly- a b)) (else (poly* a b))))
            (poly-const 0)))))
(define (mv-arguments s es env fs active depth)
  (if (or (not (mv-active? s)) (null? es)) '()
      (let ((v (mv-expression s (car es) env fs active depth)))
        (cons v (mv-arguments s (cdr es) env fs active depth)))))
(define (mv-bind ps vs)
  (if (null? ps) '() (cons (cons (car ps) (car vs)) (mv-bind (cdr ps) (cdr vs)))))
(define (mv-lets s bs body env fs active depth)
  (if (not (mv-active? s)) (poly-const 0)
      (if (null? bs) (mv-expression s body env fs active depth)
          (let ((v (mv-expression s (cadar bs) env fs active depth)))
            (mv-lets s (cdr bs) body (cons (cons (caar bs) v) env) fs active depth)))))
(define (mv-expression s e env fs active depth)
  (cond ((not (mv-active? s)) (poly-const 0))
        ((> depth (vector-ref s 2)) (mv-fail s 'depth-bound))
        ((not (mv-charge s 1)) (poly-const 0))
        ((mv-integer? e) (mv-admit s (poly-const e)))
        ((eq? (car e) 'quote)
         (if (mv-integer? (cadr e)) (mv-admit s (poly-const (cadr e)))
             (mv-fail s 'unsupported-value)))
        ((eq? (car e) 'var)
         (let ((cell (mv-find (cadr e) env)))
           (if cell (cdr cell) (mv-fail s 'unbound-input))))
        ((eq? (car e) 'let) (mv-lets s (cadr e) (caddr e) env fs active (+ depth 1)))
        ((eq? (car e) 'prim)
         (if (mv-has? (cadr e) '(+ - *))
             (let* ((a (mv-expression s (caddr e) env fs active (+ depth 1)))
                    (b (mv-expression s (cadddr e) env fs active (+ depth 1))))
               (if (mv-active? s) (mv-operation s (cadr e) a b) (poly-const 0)))
             (mv-fail s 'unsupported-primitive)))
        ((eq? (car e) 'call)
         (if (mv-has? (cadr e) active) (mv-fail s 'recursive-call)
             (let* ((fd (mv-find (cadr e) fs))
                    (args (mv-arguments s (cddr e) env fs active (+ depth 1))))
               (if (mv-active? s)
                   ;; Functions are closed over their parameters, not caller LETs.
                   (mv-expression s (caddr fd) (mv-bind (cadr fd) args) fs
                                  (cons (cadr e) active) (+ depth 1))
                   (poly-const 0)))))
        (else (mv-fail s 'unsupported-expression))))
(define (mv-environment s statics inputs)
  ;; First static binding wins, as in the strict Mix evaluator.
  (append (let loop ((xs statics))
            (if (null? xs) '() (cons (cons (caar xs) (mv-admit s (poly-const (cdar xs)))) (loop (cdr xs)))))
          (let loop ((xs inputs))
            (if (null? xs) '() (cons (cons (car xs) (poly-var (car xs))) (loop (cdr xs)))))))
(define (mix-verify-specialization source statics result limits)
  (cond ((not (mv-limits? limits)) (mv-result 'unknown 'invalid-limits))
        ((not (and (vector? result) (= (vector-length result) 7)
                   (eq? (vector-ref result 0) 'mix-result-v1)
                   (eq? (mix-result-status result) 'normal)))
         (mv-result 'unknown 'invalid-result))
        (else
         (let* ((p (mix-result-value result)) (inputs (mix-inputs result))
                (admission (mix-limits 0 0 0 (vector-ref limits 4)))
                (left-check (mix-run source statics admission))
                (right-check (mix-run p (list (cons 'contract inputs)) admission)))
           ;; Zero-work admission validates data and syntax without executing
           ;; either program. Producer origin is deliberately not trusted.
           (cond ((not (eq? (mix-result-status left-check) 'work-bound))
                  (mv-result 'unknown (mix-result-status left-check)))
                 ((not (eq? (mix-result-status right-check) 'work-bound))
                  (mv-result 'unknown (mix-result-status right-check)))
                 ((not (mv-statics? statics)) (mv-result 'unknown 'unsupported-static))
                 ((not (and (mv-inputs? inputs) (equal? inputs (mv-inputs source statics))))
                  (mv-result 'unknown 'input-contract))
                 (else
                  (let* ((s (vector 'running (vector-ref limits 1) (vector-ref limits 2) (vector-ref limits 3)))
                         (a (mv-expression s (caddr source) (mv-environment s statics inputs) (cadr source) '() 0))
                         (b (mv-expression s (caddr p) (mv-environment s '() inputs) (cadr p) '() 0)))
                    (if (not (mv-active? s)) (mv-result 'unknown (vector-ref s 0))
                        (if (poly=? a b) (mv-result 'equivalent 'polynomial-identity)
                            (mv-result 'different 'polynomial-difference))))))))))
