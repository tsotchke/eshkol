  gpil-hodge-polygon-elliptic
  gpil-polygon-from-slopes
  gpil-mazur-inequality-check
  gpil-mazur-strictly-above?
  ;; Pillar 3: Grothendieck Duality & The Six Operations
  gpil-make-sheaf
