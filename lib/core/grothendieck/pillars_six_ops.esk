;;; core.grothendieck.pillars_six_ops -- Grothendieck's Deep Foundational Pillars:
;;;   1. Standard Conjectures on Algebraic Cycles (1968): Lefschetz B(X),
;;;      Hodge Index I(X), Kunneth C(X), exact Sylvester signature & epistemic status.
;;;   2. Crystalline Cohomology & Dieudonne Theory (characteristic p):
;;;      Exact Divided Power (PD) algebra Gamma(x), exact 2x2 Dieudonne modules
;;;      (M, F, V) with FV = VF = pI, Newton & Hodge polygons, and Mazur's inequality.
;;;   3. Grothendieck Duality & The Six Operations (f*, f_*, f^!, f_!, tensor, Hom):
;;;      Exact constructible-sheaf 6-functor calculus on open-closed stratification
;;;      U --j--> X <--i-- Z, Projection Formula, Proper Base Change, Adjunctions,
;;;      Excision Distinguished Triangle, and non-proper j_! != j_* separation.
;;;   4. Yoga of Weights (Deligne Mixed Hodge / Frobenius Weights):
;;;      Weight-graded cohomology profiles, purity vs. open/singular weight shifts,
;;;      Kunneth tensor, Tate twist, and Grothendieck-ring weight additivity.
;;;   5. Grothendieck Universes (U_0 in U_1 in U_2):
;;;      Strict cumulative hierarchy, SGA 4 closure axioms, category smallness,
;;;      and fail-closed Russell/Girard self-membership & cycle rejection.
;;;
;;; All internal and exported identifiers are prefixed with `gpil-`.

(require stdlib)

(provide
  ;; Exact linear algebra & quadratic-form helpers
  gpil-mat-zero
  gpil-mat-id
  gpil-mat-scale
  gpil-mat-add
  gpil-mat-sub
  gpil-mat-mul
  gpil-mat-equal?
  gpil-mat-symmetric?
  gpil-mat-rank
  gpil-mat-nullspace
  gpil-mat-kronecker
  gpil-vec-dot
  gpil-bilinear-form
  gpil-quadratic-form
  gpil-symmetric-signature
