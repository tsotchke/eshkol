;;;     4. Modern Descendant: Scholze Perfectoid Rings & Tilting Equivalence (K |-> K^flat)
;;;
;;;   All internal and exported identifiers carry the `gesq-` namespace tag.

(require stdlib)

(provide
  ;; 1. Symmetric Group S_d & Dessins d'Enfants
  gesq-perm-id gesq-perm-valid? gesq-perm-equal?
  gesq-perm-compose gesq-perm-inv gesq-perm-order
  gesq-perm-cycles gesq-perm-cycle-type gesq-perm-cycle-count
  gesq-perm-transitive? gesq-perm-subgroup-elements gesq-perm-subgroup-order
  gesq-perm-conjugate
  gesq-make-dessin gesq-dessin?
  gesq-dessin-degree gesq-dessin-s0 gesq-dessin-s1 gesq-dessin-sinf
  gesq-dessin-passport gesq-dessin-genus gesq-dessin-monodromy-order
  gesq-dessin-counts gesq-dessin-mirror gesq-dessin-isomorphic?
  gesq-poly-eval gesq-poly-deriv gesq-belyi-verify-poly
  gesq-witness-star-d3 gesq-witness-chebyshev-d3 gesq-witness-shabat-d4
  gesq-witness-torus-d3 gesq-witness-chiral-tree-d6
  gesq-witness-galois-orbit-sep-z6 gesq-witness-galois-orbit-sep-s5

  ;; 2. Anabelian Geometry & Grothendieck-Teichmuller Group GT-hat
  gesq-anabelian-classify
  gesq-gt-make-associator gesq-gt-kohno-p5-matrices
  gesq-gt-verify-relations

  ;; 3. Tame Topology (1D o-Minimal Cell Decomposition & Wild Negative Controls)
  gesq-ext-lt? gesq-ext-eq? gesq-ext-le?
  gesq-cell-point gesq-cell-open gesq-cell-closed-interval
  gesq-tame-canonicalize gesq-tame-union gesq-tame-intersection
  gesq-tame-complement gesq-tame-diff
  gesq-tame-euler gesq-tame-verify-additivity gesq-tame-cell-complex-euler
  gesq-wild-cantor-approx gesq-wild-cantor-family
  gesq-wild-topologist-sine-family gesq-wild-peano-curve
  gesq-tame-check-ominimal

  ;; 4. Scholze Perfectoid Spaces & Tilting Equivalence
  gesq-perf-ring-make gesq-perf-zero gesq-perf-one gesq-perf-generator
  gesq-perf-equal? gesq-perf-add gesq-perf-mul gesq-perf-pow
  gesq-perf-frobenius gesq-perf-embed-next gesq-perf-pth-root
