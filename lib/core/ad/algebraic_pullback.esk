;;; Equation-defined adjoints: one retained LU and one transposed solve per seed.
(require core.ad.algebraic_reverse)
(require core.ad.algebraic_implicit)
(provide algebraic-solve-with-pullback algebraic-factor-with-pullback algebraic-system-with-pullback
         algebraic-reverse-solve algebraic-reverse-system)

(define (ap-copy-vector domain xs)
  (if (not (vector? xs)) (error "Expected an exact coefficient vector"))
  (list->vector (map (algebraic-domain-ref domain 'copy) (vector->list xs))))
(define (algebraic-solve-with-pullback owner matrix rhs)
  (algebraic-factor-with-pullback (algebraic-factor owner matrix) rhs))
(define (algebraic-factor-with-pullback factor rhs)
  (algebraic-factor-summary factor)
  (let* ((domain (vector-ref factor 1))
         (solution (algebraic-factor-solve factor rhs)) (n (vector-length solution))
         (mul (algebraic-domain-ref domain 'mul)) (sub (algebraic-domain-ref domain 'sub))
         (zero (algebraic-domain-ref domain 'zero)))
    (vector (ap-copy-vector domain solution)
      (lambda (seed)
        (let ((lambda-value (algebraic-factor-solve-transpose factor seed)) (matrix-bar (make-vector n #f)))
          (let rows ((i 0)) (if (< i n)
            (let ((row (make-vector n #f)))
              (let cols ((j 0)) (if (< j n)
                (begin (vector-set! row j (sub zero (mul (vector-ref lambda-value i) (vector-ref solution j))))
                       (cols (+ j 1)))))
              (vector-set! matrix-bar i row) (rows (+ i 1)))))
          (vector matrix-bar lambda-value)))
      (algebraic-factor-summary factor))))
(define (algebraic-system-with-pullback owner equations roots)
  (let* ((domain (algebraic-domain owner)) (roots (ap-copy-vector domain roots))
         (linearization (algebraic-system-linearization owner equations roots))
         (residual (vector-ref linearization 0)) (monomials (vector-ref linearization 2))
         (zero? (algebraic-domain-ref domain 'zero?)) (mul (algebraic-domain-ref domain 'mul))
         (sub (algebraic-domain-ref domain 'sub)) (zero (algebraic-domain-ref domain 'zero)))
    (for-each (lambda (x) (if (not (zero? x)) (error "Supplied implicit root does not satisfy every equation"))) (vector->list residual))
    (let ((factor (algebraic-factor owner (vector-ref linearization 1))))
      (vector (ap-copy-vector domain roots)
        (lambda (seed)
          (let ((lambda-value (algebraic-factor-solve-transpose factor seed))
                (out (make-vector (vector-length roots) #f)))
            (let rows ((i 0)) (if (< i (vector-length roots))
              (begin (vector-set! out i (map (lambda (m) (sub zero (mul (vector-ref lambda-value i) m)))
                (vector-ref monomials i))) (rows (+ i 1))))) out))
        (algebraic-factor-summary factor)))))
(define (ap-owner tape)
  (if (not (and (vector? tape) (= (vector-length tape) 4)
                (vector? (vector-ref tape 2)) (= (vector-length (vector-ref tape 2)) 6)))
      (error "Expected an exact reverse tape"))
  (algebraic-domain-ref (vector-ref (vector-ref tape 2) 5) 'owner))
(define (ap-flatten-matrix matrix)
  (let loop ((i 0) (out '()))
    (if (= i (vector-length matrix)) out
      (loop (+ i 1) (append out (vector->list (vector-ref matrix i)))))))
(define (algebraic-reverse-solve tape matrix rhs)
  (if (not (and (vector? matrix) (vector? rhs))) (error "Expected a node matrix and RHS vector"))
  (let* ((values (list->vector (map (lambda (row)
            (if (not (vector? row)) (error "Expected node matrix rows"))
            (list->vector (map (lambda (n) (algebraic-reverse-value tape n)) (vector->list row)))) (vector->list matrix))))
         (b (list->vector (map (lambda (n) (algebraic-reverse-value tape n)) (vector->list rhs))))
         (record (algebraic-solve-with-pullback (ap-owner tape) values b))
         (inputs (append (ap-flatten-matrix matrix) (vector->list rhs))))
    (list->vector (record-multi-op! tape inputs (vector->list (vector-ref record 0))
      (lambda (seeds)
        (let ((bars ((vector-ref record 1) (list->vector seeds))))
          (append (ap-flatten-matrix (vector-ref bars 0)) (vector->list (vector-ref bars 1)))))))))
(define (ap-system-inputs equations)
  (let rows ((i 0) (out '()))
    (if (= i (vector-length equations)) out
      (let terms ((rest (vector-ref equations i)) (acc out))
        (if (null? rest) (rows (+ i 1) acc)
          (terms (cdr rest) (append acc (list (caar rest)))))))))
(define (algebraic-reverse-system tape equations roots)
  (if (not (vector? equations)) (error "Expected polynomial node equations"))
  (let* ((values (list->vector (map (lambda (terms)
        (map (lambda (term)
          (if (not (and (list? term) (= (length term) 2))) (error "Expected coefficient-node polynomial term"))
          (list (algebraic-reverse-value tape (car term)) (cadr term))) terms)) (vector->list equations))))
         (inputs (ap-system-inputs equations))
         (record (algebraic-system-with-pullback (ap-owner tape) values roots)))
    (list->vector (record-multi-op! tape inputs (vector->list (vector-ref record 0))
      (lambda (seeds)
        (let ((bars ((vector-ref record 1) (list->vector seeds))))
          (let rows ((i 0) (out '())) (if (= i (vector-length bars)) out
            (rows (+ i 1) (append out (vector-ref bars i)))))))))))
