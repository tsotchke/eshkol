;;; Exact characteristic polynomials and certified simple symmetric branches.
(require core.algebraic_linalg)
(provide algebraic-characteristic algebraic-eigenvalue-with-pullback algebraic-eigenvalue-lift)

(define (as-matrix d matrix)
  (if (not (and (vector? matrix) (> (vector-length matrix) 0) (<= (vector-length matrix) 8)))
      (error "Exact spectral matrices have size one through eight"))
  (let ((n (vector-length matrix)) (copy (algebraic-domain-ref d 'copy)))
    (list->vector (map (lambda (row)
      (if (not (and (vector? row) (= (vector-length row) n))) (error "Spectral matrix must be square"))
      (list->vector (map copy (vector->list row)))) (vector->list matrix)))))
(define (as-identity d n)
  (list->vector (map (lambda (i) (list->vector (map (lambda (j)
    (algebraic-domain-ref d (if (= i j) 'one 'zero))) (iota n)))) (iota n))))
(define (as-symmetric d a)
  (let ((equal? (algebraic-domain-ref d 'equal?)) (n (vector-length a)))
    (let rows ((i 0)) (if (< i n) (begin
      (let cols ((j 0)) (if (< j i) (begin
        (if (not (equal? (vector-ref (vector-ref a i) j) (vector-ref (vector-ref a j) i)))
            (error "Selected real eigenvalue requires a symmetric matrix")) (cols (+ j 1)))))
      (rows (+ i 1)))))))
;; Faddeev-LeVerrier: B0=I, ck=-trace(A B[k-1])/k, Bk=A B[k-1]+ck I.
;; Retained B0..B[n-1] also give adj(tI-A), avoiding a second determinant path.
(define (as-characteristic d a)
  (let* ((n (vector-length a)) (owner (algebraic-domain-ref d 'owner))
         (coefficients (make-vector (+ n 1) (algebraic-domain-ref d 'zero)))
         (bases (make-vector n #f)) (add (algebraic-domain-ref d 'add))
         (mul (algebraic-domain-ref d 'mul)) (sub (algebraic-domain-ref d 'sub))
         (zero? (algebraic-domain-ref d 'zero?)))
    (vector-set! coefficients n (algebraic-domain-ref d 'one))
    (let steps ((k 1) (b (as-identity d n)))
      (vector-set! bases (- k 1) b)
      (let* ((product (algebraic-matrix-mul owner a b))
             (trace (let loop ((i 0) (sum (algebraic-domain-ref d 'zero)))
               (if (= i n) sum (loop (+ i 1) (add sum (vector-ref (vector-ref product i) i))))))
             (c (mul (/ -1 k) trace)))
        (vector-set! coefficients (- n k) c)
        (let diagonal ((i 0)) (if (< i n)
          (begin (vector-set! (vector-ref product i) i (add (vector-ref (vector-ref product i) i) c))
                 (diagonal (+ i 1)))))
        (if (= k n)
            (for-each (lambda (row) (for-each (lambda (x)
              (if (not (zero? x)) (error "Characteristic polynomial failed Cayley-Hamilton residual"))) (vector->list row))) (vector->list product))
            (steps (+ k 1) product))))
    (vector coefficients bases)))
(define (algebraic-characteristic owner matrix)
  (let* ((d (algebraic-domain owner)) (a (as-matrix d matrix)) (result (as-characteristic d a)))
    (list->vector (map (algebraic-domain-ref d 'copy) (vector->list (vector-ref result 0))))))
(define (as-evaluate d coefficients value derivative)
  (let ((add (algebraic-domain-ref d 'add)) (mul (algebraic-domain-ref d 'mul)))
    (let loop ((i (- (vector-length coefficients) 1)) (out (algebraic-domain-ref d 'zero)))
      (if (< i (if derivative 1 0)) out
          (loop (- i 1) (add (mul out value) (if derivative (mul i (vector-ref coefficients i)) (vector-ref coefficients i))))))))
(define (algebraic-eigenvalue-with-pullback owner matrix eigenvalue)
  (let* ((d (algebraic-domain owner)) (a (as-matrix d matrix))
         (copy (algebraic-domain-ref d 'copy)) (value (copy eigenvalue)) (n (vector-length a))
         (admitted (as-symmetric d a)) (record (as-characteristic d a))
         (coefficients (vector-ref record 0)) (bases (vector-ref record 1))
         (zero? (algebraic-domain-ref d 'zero?)) (unit? (algebraic-domain-ref d 'unit?))
         (add (algebraic-domain-ref d 'add)) (mul (algebraic-domain-ref d 'mul))
         (equal? (algebraic-domain-ref d 'equal?))
         (derivative (as-evaluate d coefficients value #t)))
    (if (not (zero? (as-evaluate d coefficients value #f))) (error "Selected value is not an exact eigenvalue"))
    (if (not (unit? derivative)) (error "Selected eigenvalue is not simple"))
    (let* ((scale ((algebraic-domain-ref d 'inverse) derivative))
           (projector (list->vector (map (lambda (i) (list->vector (map (lambda (j)
             (mul scale (let horner ((k 0) (out (algebraic-domain-ref d 'zero)))
               (if (= k n) out (horner (+ k 1)
                 (add (mul out value) (vector-ref (vector-ref (vector-ref bases k) i) j))))))) (iota n)))) (iota n))))
           (ap (algebraic-matrix-mul owner a projector)) (pp (algebraic-matrix-mul owner projector projector)))
      (let rows ((i 0)) (if (< i n) (begin
        (let cols ((j 0)) (if (< j n) (begin
          (if (not (and (equal? (vector-ref (vector-ref ap i) j) (mul value (vector-ref (vector-ref projector i) j)))
                        (equal? (vector-ref (vector-ref pp i) j) (vector-ref (vector-ref projector i) j))))
              (error "Exact eigenprojector failed its full residual")) (cols (+ j 1))))) (rows (+ i 1)))))
      (if (not (equal? (let trace ((i 0) (sum (algebraic-domain-ref d 'zero)))
        (if (= i n) sum (trace (+ i 1) (add sum (vector-ref (vector-ref projector i) i))))) 1))
          (error "Exact simple eigenprojector must have unit trace"))
      (vector (copy value) (as-matrix d projector)
        (lambda (seed)
          (let ((seed (copy seed)))
            (list->vector (map (lambda (i) (list->vector (map (lambda (j)
              (mul seed (vector-ref (vector-ref projector j) i))) (iota n)))) (iota n)))))
        (vector n (algebraic-domain-ref d 'depth))))))
(define (algebraic-eigenvalue-lift context matrix root)
  (let* ((d (algebraic-domain context)) (a (as-matrix d matrix)))
    (if (not (algebraic-domain-ref d 'parent)) (error "Eigenvalue lifting requires an AD context"))
    (as-symmetric d a)
    (let* ((coefficients (vector-ref (as-characteristic d a) 0))
           (value (algebraic-ad-root context (vector->list coefficients) root)))
      (vector-ref (algebraic-eigenvalue-with-pullback context a value) 0))))
