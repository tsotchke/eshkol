;;; Certified continuation of selected simple real polynomial roots.
(require core.polynomial_exact)
(require core.ad.rigorous_interval)
(provide make-root-branch root-branch-step root-branch-enclosure root-branch-time
         root-branch-sensitivity verify-root-branch-step)

;; F(x,t)=sum_i family[i](t)*x^i. Every family[i] is the existing exact-poly
;; coefficient vector. No callback or floating root finder supplies premises.
(define (rb-exact x)
  (if (not (and (rational? x) (exact? x))) (error "root branch requires exact rational data")) x)
(define (rb-interval x)
  (if (not (and (pair? x) (rational? (car x)) (rational? (cdr x))
                (exact? (car x)) (exact? (cdr x)) (<= (car x) (cdr x))))
      (error "expected an ordered closed rational interval"))
  (cons (car x) (cdr x)))
(define (rb-checked x) (rb-exact (car x)) (rb-exact (cdr x)) x)
(define (rb+ a b) (rb-checked (ia+ a b)))
(define (rb- a b) (rb-checked (ia- a b)))
(define (rb* a b) (rb-checked (ia* a b)))
(define (rb/ a b) (rb-checked (ia/ a b)))
(define (rb-point x) (cons x x))
(define (rb-mag x) (max (abs (car x)) (abs (cdr x))))
(define (rb-nonzero? x) (or (> (car x) 0) (< (cdr x) 0)))
(define (rb-subset? small large) (and (<= (car large) (car small)) (<= (cdr small) (cdr large))))
(define (rb-family data)
  (if (not (and (vector? data) (>= (vector-length data) 2) (<= (vector-length data) 9)))
      (error "root family must have x degree 1..8"))
  (let ((out (make-vector (vector-length data) #f)))
    (let loop ((i 0)) (if (< i (vector-length data))
      (let ((p (exact-poly (vector-ref data i))))
        (if (> (vector-length p) 9) (error "root family parameter degree exceeds eight"))
        (vector-set! out i p) (loop (+ i 1))))) out))
(define (rb-poly-at family time)
  (let ((out (make-vector (vector-length family) 0)))
    (let loop ((i 0)) (if (< i (vector-length family))
      (begin (vector-set! out i (exact-poly-eval (vector-ref family i) time))
             (loop (+ i 1))))) (exact-poly out)))
(define (rb-poly-range p interval)
  (let loop ((i (- (vector-length p) 1)) (out (rb-point 0)))
    (if (< i 0) out (loop (- i 1) (rb+ (rb* out interval) (rb-point (vector-ref p i)))))))
(define (rb-range family x t derivative-x?)
  (let loop ((i (- (vector-length family) 1)) (out (rb-point 0)))
    (if (< i (if derivative-x? 1 0)) out
      (loop (- i 1) (rb+ (rb* out x)
        (rb* (rb-point (if derivative-x? i 1)) (rb-poly-range (vector-ref family i) t)))))))
(define (rb-time-derivative family)
  (let ((out (make-vector (vector-length family) #f)))
    (let row ((i 0)) (if (< i (vector-length family))
      (let* ((p (vector-ref family i)) (d (make-vector (max 1 (- (vector-length p) 1)) 0)))
        (let col ((j 1)) (if (< j (vector-length p))
          (begin (vector-set! d (- j 1) (rb-exact (* j (vector-ref p j)))) (col (+ j 1)))))
        (vector-set! out i (exact-poly d)) (row (+ i 1))))) out))
(define (rb-budget options)
  (if (> (length options) 1) (error "root branch accepts one bisection budget"))
  (let ((n (if (null? options) 12 (car options))))
    (if (not (and (integer? n) (exact? n) (>= n 0) (<= n 64)))
        (error "root bisection budget must be 0..64")) n))
(define (rb-refine family time enclosure budget)
  (let* ((p (rb-poly-at family time)) (lo (car enclosure)) (hi (cdr enclosure))
         (fl (exact-poly-eval p lo)) (fh (exact-poly-eval p hi)))
    (cond ((= fl 0) (rb-point lo)) ((= fh 0) (rb-point hi))
      (else
        (if (not (= (exact-poly-real-root-count p lo hi) 1)) (error "root bracket must select exactly one root"))
        (let loop ((a lo) (b hi) (fa fl) (fuel budget))
          (if (= fuel 0) (cons a b)
            (let* ((m (rb-exact (/ (+ a b) 2))) (fm (exact-poly-eval p m)))
              (cond ((= fm 0) (rb-point m))
                    ((< (* fa fm) 0) (loop a m fa (- fuel 1)))
                    (else (loop m b fm (- fuel 1)))))))))))
(define (rb-check state)
  (if (not (and (vector? state) (= (vector-length state) 4)
                (eq? (vector-ref state 0) 'root-branch-v1))) (error "expected a root branch snapshot")))
(define (rb-admit family time enclosure)
  (let ((dx (rb-range family enclosure (rb-point time) #t)))
    (if (not (rb-nonzero? dx)) (error "root bracket does not certify a simple branch"))
    (rb-refine family time enclosure 0)))
(define (make-root-branch coefficients time enclosure . options)
  (let* ((family (rb-family coefficients)) (t (rb-exact time)) (box (rb-interval enclosure))
         (budget (rb-budget options)))
    (rb-admit family t box)
    (vector 'root-branch-v1 family t (rb-refine family t box budget))))
(define (root-branch-enclosure state)
  (rb-check state) (rb-interval (vector-ref state 3)))
(define (root-branch-time state) (rb-check state) (vector-ref state 2))
(define (root-branch-sensitivity state)
  (rb-check state)
  (let* ((family (vector-ref state 1)) (t (rb-point (vector-ref state 2))) (box (vector-ref state 3))
         (dx (rb-range family box t #t)) (dt (rb-range (rb-time-derivative family) box t #f)))
    (if (not (rb-nonzero? dx)) (error "root sensitivity unresolved at singularity"))
    (rb/ (rb- (rb-point 0) dt) dx)))

;; A common contraction tube proves a unique root for EVERY t in [t0,t1].
;; The retained old enclosure lies inside the tube, tying that unique branch
;; to the previously selected root. Polynomial smoothness and the uniformly
;; nonzero x derivative imply continuity; endpoint isolation alone would not.
(define (rb-proof family old-time new-time old-enclosure tube)
  (if (not (< (car tube) (cdr tube))) (error "continuation tube must have positive width"))
  (if (not (rb-subset? old-enclosure tube)) (error "tube does not contain the selected old root enclosure"))
  (let* ((times (cons (min old-time new-time) (max old-time new-time)))
         (center (rb-exact (/ (+ (car tube) (cdr tube)) 2)))
         (radius (rb-exact (/ (- (cdr tube) (car tube)) 2)))
         (middle (rb-point (rb-exact (/ (+ old-time new-time) 2))))
         (slope (rb-range family (rb-point center) middle #t)))
    (if (= (car slope) 0) (error "continuation preconditioner has zero derivative"))
    (let* ((inverse (rb-exact (/ 1 (car slope))))
           (jacobian (rb-range family tube times #t))
           (defect (rb- (rb-point 1) (rb* (rb-point inverse) jacobian)))
           (q (rb-mag defect))
           (residual (rb-range family (rb-point center) times #f))
           (forcing (rb-mag (rb* (rb-point inverse) residual)))
           (margin (rb-exact (- radius (+ forcing (* q radius))))))
      (if (or (>= q 1) (< margin 0)) (error "continuation step has no certified whole-interval contraction"))
      (vector 'root-step-v1 times (rb-interval tube) inverse jacobian residual q forcing margin))))
(define (root-branch-step state target-time trial-tube . options)
  (rb-check state)
  (let* ((family (vector-ref state 1)) (old-time (rb-exact (vector-ref state 2)))
         (old-box (rb-interval (vector-ref state 3))) (next-time (rb-exact target-time))
         (tube (rb-interval trial-tube)) (budget (rb-budget options)))
    (rb-admit family old-time old-box)
    (let* ((proof (rb-proof family old-time next-time old-box tube))
           (endpoint (rb-refine family next-time tube budget)))
      (vector (vector 'root-branch-v1 family next-time endpoint) proof))))
(define (verify-root-branch-step old next certificate)
  (guard (e (else #f))
    (rb-check old) (rb-check next)
    (and (equal? (vector-ref old 1) (vector-ref next 1))
      (let* ((family (vector-ref old 1)) (tube (rb-interval (vector-ref certificate 2)))
             (old-time (rb-exact (vector-ref old 2))) (new-time (rb-exact (vector-ref next 2)))
             (old-box (rb-interval (vector-ref old 3))) (next-box (rb-interval (vector-ref next 3))))
        (rb-admit family old-time old-box) (rb-admit family new-time next-box)
        (and (rb-subset? next-box tube)
             (equal? certificate (rb-proof family old-time new-time old-box tube)))))))
