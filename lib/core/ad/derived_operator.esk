;;; One pure scalar polynomial definition, derived numeric and temporal rules.
(require core.symbolic)
(provide make-derived-operator derived-operator-value derived-operator-jvp
         derived-operator-vjp derived-operator-delta derived-operator-info)

(define (do-exact x)
  (if (not (and (rational? x) (exact? x))) (error "operator coefficients must be exact rationals")) x)
(define (do-internal prefix i) (string->symbol (string-append prefix (number->string i))))
(define (do-make p degree terms)
  (if (or (> degree 8) (> terms 4096)) (error "derived operator exceeds polynomial expansion budget"))
  (vector p degree terms))
(define (do-combine op a b)
  (let ((degree (if (eq? op '*) (+ (vector-ref a 1) (vector-ref b 1))
                    (max (vector-ref a 1) (vector-ref b 1))))
        (terms (if (eq? op '*) (* (vector-ref a 2) (vector-ref b 2))
                   (+ (vector-ref a 2) (vector-ref b 2)))))
    ;; Check before expanding, including the shifted finite-change polynomial.
    (do-make #f degree terms)
    (do-make ((cond ((eq? op '+) poly+) ((eq? op '-) poly-) (else poly*))
                 (vector-ref a 0) (vector-ref b 0)) degree terms)))
(define (do-compile expression environment fuel depth)
  (vector-set! fuel 0 (+ (vector-ref fuel 0) 1))
  (if (or (> (vector-ref fuel 0) 256) (> depth 32)) (error "derived operator syntax budget exceeded"))
  (cond
    ((number? expression) (do-make (poly-const (do-exact expression)) 0 1))
    ((symbol? expression)
     (let ((binding (assq expression environment)))
       (if binding (cdr binding) (error "unbound derived operator variable" expression))))
    ((and (list? expression) (pair? expression))
     (let ((op (car expression)) (args (cdr expression)))
       (define (compile x) (do-compile x environment fuel (+ depth 1)))
       (cond
         ((and (memq op '(+ - *)) (= (length args) 2))
          (do-combine op (compile (car args)) (compile (cadr args))))
         ((and (eq? op '-) (= (length args) 1))
          (do-combine '- (do-make (poly-const 0) 0 1) (compile (car args))))
         ((and (eq? op '/) (= (length args) 2) (number? (cadr args)))
          (let ((denominator (do-exact (cadr args))) (a (compile (car args))))
            (if (= denominator 0) (error "derived operator constant divisor is zero"))
            (do-make (poly-scale (vector-ref a 0) (do-exact (/ 1 denominator)))
                     (vector-ref a 1) (vector-ref a 2))))
         ((and (memq op '(pow expt)) (= (length args) 2)
               (integer? (cadr args)) (exact? (cadr args))
               (>= (cadr args) 0) (<= (cadr args) 8))
          (let* ((a (compile (car args))) (n (cadr args))
                 (degree (* n (vector-ref a 1))) (terms (expt (vector-ref a 2) n)))
            (do-make #f degree terms)
            (do-make (poly-expt (vector-ref a 0) n) degree terms)))
         (else (error "unsupported or effectful derived operator expression")))))
    (else (error "malformed derived operator expression"))))
(define (do-values x n)
  (if (not (and (vector? x) (= (vector-length x) n))) (error "derived operator input width mismatch"))
  (let ((out (make-vector n 0)))
    (let loop ((i 0)) (if (< i n)
      ;; Generic arithmetic validates the numeric domain while preserving native
      ;; AD carriers, which ordinary number? does not classify as scalar numbers.
      (begin (vector-set! out i (+ (vector-ref x i) 0)) (loop (+ i 1))))) out))
(define (do-all-exact? x)
  (let loop ((i 0)) (or (= i (vector-length x))
    (and (rational? (vector-ref x i)) (exact? (vector-ref x i)) (loop (+ i 1))))))
(define (do-eval polynomial bindings exact-input?)
  (let ((value (poly-eval polynomial bindings)))
    (if exact-input? (do-exact value)) value))

;; Returns a closure, retaining no mutable caller syntax or point containers.
;; Public observations expose only fresh numeric results and immutable metadata.
(define (make-derived-operator variables expression)
  (if (not (and (list? variables) (> (length variables) 0) (<= (length variables) 8)))
      (error "derived operator needs 1..8 distinct variable names"))
  (let* ((n (length variables)) (names (map (lambda (x) x) variables))
         (xs (map (lambda (i) (do-internal "derived-x-" i)) (iota n)))
         (ds (map (lambda (i) (do-internal "derived-d-" i)) (iota n)))
         (base-env '()) (shift-env '()))
    (let loop ((rest names) (x xs) (d ds) (seen '()))
      (if (not (null? rest))
        (begin
          (if (or (not (symbol? (car rest))) (memq (car rest) seen))
              (error "derived operator variables must be distinct symbols"))
          (set! base-env (cons (cons (car rest) (do-make (poly-var (car x)) 1 1)) base-env))
          (set! shift-env (cons (cons (car rest)
            (do-make (poly+ (poly-var (car x)) (poly-var (car d))) 1 2)) shift-env))
          (loop (cdr rest) (cdr x) (cdr d) (cons (car rest) seen)))))
    (let* ((compiled (do-compile expression base-env (vector 0) 0))
           (forward (vector-ref compiled 0))
           (shifted (do-compile expression shift-env (vector 0) 0))
           (change (poly- (vector-ref shifted 0) forward))
           (partials (map (lambda (x) (poly-deriv forward x)) xs)))
      (lambda (action point extra)
        (if (eq? action 'info) (vector n (poly-degree forward) (vector-ref compiled 2) (vector-ref shifted 2))
          (let* ((values (do-values point n))
                 (bindings (let loop ((names xs) (i 0) (out '()))
                   (if (null? names) out (loop (cdr names) (+ i 1)
                     (cons (cons (car names) (vector-ref values i)) out)))))
                 (exact-input? (do-all-exact? values)))
            (cond
              ((eq? action 'value) (do-eval forward bindings exact-input?))
              ((eq? action 'vjp)
               (+ extra 0)
               (list->vector (map (lambda (p)
                 (let ((value (* extra (do-eval p bindings exact-input?))))
                   (if (and exact-input? (rational? extra) (exact? extra)) (do-exact value)) value)) partials)))
              ((eq? action 'jvp)
               (let ((direction (do-values extra n)))
                 (let loop ((ps partials) (i 0) (out 0))
                   (if (null? ps) out
                     (let ((next (+ out (* (do-eval (car ps) bindings exact-input?) (vector-ref direction i)))))
                       (if (and exact-input? (do-all-exact? direction)) (do-exact next))
                       (loop (cdr ps) (+ i 1) next))))))
              ((eq? action 'delta)
               (let* ((delta (do-values extra n))
                      (all-bindings (let loop ((names ds) (i 0) (out bindings))
                        (if (null? names) out (loop (cdr names) (+ i 1)
                          (cons (cons (car names) (vector-ref delta i)) out))))))
                 (do-eval change all-bindings (and exact-input? (do-all-exact? delta)))))
              (else (error "unknown derived operator action")))))))))
(define (derived-operator-value op point) (op 'value point #f))
(define (derived-operator-jvp op point direction) (op 'jvp point direction))
(define (derived-operator-vjp op point seed) (op 'vjp point seed))
(define (derived-operator-delta op point delta) (op 'delta point delta))
(define (derived-operator-info op) (op 'info #f #f))
