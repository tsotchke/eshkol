;;; Pure distance-two coloring shared by numeric and exact Hessian recovery.
(provide hessian-color-graph)
(define (sp-member? x xs)
  (and (pair? xs) (or (= x (car xs)) (sp-member? x (cdr xs)))))
(define (sp-insert x xs)
  (cond ((null? xs) (list x)) ((= x (car xs)) xs)
        ((< x (car xs)) (cons x xs)) (else (cons (car xs) (sp-insert x (cdr xs))))))
(define (sp-degree-order adj m)
  ;; insertion sort of 0..m-1 by descending degree
  (define (deg i) (length (vector-ref adj i)))
  (define (ins x lst)
    (cond ((null? lst) (list x))
          ((>= (deg x) (deg (car lst))) (cons x lst))
          (else (cons (car lst) (ins x (cdr lst))))))
  (let loop ((i 0) (acc '()))
    (if (< i m) (loop (+ i 1) (ins i acc)) acc)))    ; acc is already descending-degree

;; collect forbidden colors (of colored vertices at distance ≤ 2 from v)
(define (sp-forbidden adj color v)
  (let ((nbrs (vector-ref adj v)))
    (let loop-n ((ns nbrs) (acc '()))
      (if (pair? ns)
          (let* ((u (car ns))
                 (cu (vector-ref color u))
                 (acc1 (if (>= cu 0) (sp-insert cu acc) acc)))
            ;; neighbours-of-neighbour
            (let loop-w ((ws (vector-ref adj u)) (acc2 acc1))
              (if (pair? ws)
                  (let* ((w (car ws))
                         (cw (vector-ref color w))
                         (acc3 (if (and (not (= w v)) (>= cw 0))
                                   (sp-insert cw acc2) acc2)))
                    (loop-w (cdr ws) acc3))
                  (loop-n (cdr ns) acc2))))
          acc))))

(define (sp-smallest-free forbidden)
  (let loop ((c 0)) (if (sp-member? c forbidden) (loop (+ c 1)) c)))

(define (sp-color-graph adj m)
  (let ((color (make-vector m -1))
        (order (sp-degree-order adj m)))
    (let loop ((os order) (kmax -1))
      (if (pair? os)
          (let* ((v (car os))
                 (c (sp-smallest-free (sp-forbidden adj color v))))
            (vector-set! color v c)
            (loop (cdr os) (if (> c kmax) c kmax)))
          (cons color (+ kmax 1))))))

(define (hessian-color-graph adjacency)
  (if (not (vector? adjacency)) (error "Expected a Hessian adjacency vector"))
  (let ((n (vector-length adjacency)))
    (let rows ((i 0)) (if (< i n)
      (let ((neighbors (vector-ref adjacency i)))
        (if (not (list? neighbors)) (error "Expected proper adjacency lists"))
        (let check ((rest neighbors) (previous -1)) (if (pair? rest)
          (let ((j (car rest)))
            (if (not (and (integer? j) (exact? j) (>= j 0) (< j n) (not (= i j)) (> j previous)))
                (error "Adjacency lists must be sorted distinct valid neighbors"))
            (check (cdr rest) j))))
        (rows (+ i 1)))))
    (let rows ((i 0)) (if (< i n)
      (begin (for-each (lambda (j)
        (if (not (sp-member? i (vector-ref adjacency j))) (error "Hessian adjacency must be symmetric")))
        (vector-ref adjacency i)) (rows (+ i 1)))))
    (sp-color-graph adjacency n)))
