;;; Maintained tensor values plus a seeded structural reverse sweep per tick.
(require core.dbsp.tensor_circuit)
(require core.ad.tape)
(provide make-tensor-circuit-pullback tensor-circuit-pullback-step
         tensor-circuit-pullback-output tensor-circuit-pullback-work)

(define (tcr-size shape) (fold-left * 1 shape))
(define (tcr-coordinates shape f)
  (let visit ((rest shape) (prefix '()))
    (if (null? rest) (f (reverse prefix))
      (let loop ((i 0)) (if (< i (car rest)) (begin (visit (cdr rest) (cons i prefix)) (loop (+ i 1))))))))
(define (tcr-position a axes)
  (let loop ((xs axes) (i 0)) (cond ((null? xs) (error "Unknown reverse tensor axis")) ((eq? a (car xs)) i) (else (loop (cdr xs) (+ i 1))))))
(define (tcr-select coords axes selected) (map (lambda (a) (list-ref coords (tcr-position a axes))) selected))
(define (tcr-index coords shape)
  (let loop ((xs coords) (sizes shape) (out 0))
    (if (null? xs) out (loop (cdr xs) (cdr sizes) (+ (* out (car sizes)) (car xs))))))
(define (tcr-finite x) (if (not (and (real? x) (finite? x))) (error "Nonfinite tensor pullback arithmetic")) x)
(define (tcr-vector shape reader)
  (let ((out (make-vector (tcr-size shape) 0.0)))
    (tcr-coordinates shape (lambda (coords) (vector-set! out (tcr-index coords shape) (tcr-finite (reader coords))))) out))
(define (tcr-tensor values shape)
  (let ((out (make-tensor (if (null? shape) '(1) shape) 0.0)))
    (let loop ((i 0)) (if (< i (vector-length values))
      (begin (tensor-set! out i (tcr-finite (vector-ref values i))) (loop (+ i 1))))) out))
(define (tcr-at node coords) (vector-ref (vector-ref node 2) (tcr-index coords (vector-ref node 1))))
;; Descriptor #(axes shape flat-values). Pullbacks use sums/products over the
;; existing named axes; no elementwise Jacobian is constructed.
(define (tcr-rule op children axes shape graph seed work)
  (let* ((left (vector-ref graph (car children))) (la (vector-ref left 0)) (ls (vector-ref left 1))
         (gl (make-vector (tcr-size ls) 0.0)))
    (define (accumulate! output i value)
      (vector-set! output i (tcr-finite (+ (vector-ref output i) value))))
    (cond
      ((or (eq? op '+) (eq? op '-))
       (list (vector-copy seed) (list->vector (map (lambda (x) (if (eq? op '-) (- x) x)) (vector->list seed)))))
      ((or (eq? op 'sum) (eq? op 'transpose))
       (tcr-coordinates ls (lambda (coords)
         (vector-set! gl (tcr-index coords ls) (vector-ref seed (tcr-index (tcr-select coords la axes) shape)))))
       (list gl))
      ((eq? op 'contract)
       (let* ((right (vector-ref graph (cadr children))) (ra (vector-ref right 0)) (rs (vector-ref right 1))
              (gr (make-vector (tcr-size rs) 0.0))
              (all (append la (filter (lambda (a) (not (memq a la))) ra)))
              (sizes (map (lambda (a) (if (memq a la) (list-ref ls (tcr-position a la)) (list-ref rs (tcr-position a ra)))) all)))
         (tcr-coordinates sizes (lambda (coords)
           (let* ((lc (tcr-select coords all la)) (rc (tcr-select coords all ra))
                  (g (vector-ref seed (tcr-index (tcr-select coords all axes) shape))))
             (accumulate! gl (tcr-index lc ls) (* g (tcr-at right rc)))
             (accumulate! gr (tcr-index rc rs) (* g (tcr-at left lc)))
             (vector-set! work 2 (+ 2 (vector-ref work 2))))))
         (list gl gr)))
      (else (error "Unsupported tensor reverse operation" op)))))
(define (tcr-reverse circuit seed)
  (let ((tape (make-tape)) (nodes (make-vector 4096 #f)) (graph (make-vector 4096 #f))
        (targets '()) (work (vector 0 0 0 0)))
    (let* ((info (tensor-circuit-visit circuit
      (lambda (id op children params axes shape names reader)
        (if (eq? op 'rows) (vector-set! nodes id (tape-const tape 0.0))
          (let* ((value (tcr-vector shape reader)) (descriptor (vector axes shape value)))
            (vector-set! graph id descriptor)
            (vector-set! work 1 (+ (vector-ref work 1) (vector-length value)))
            (vector-set! nodes id
              (if (or (eq? op 'input) (eq? op 'project))
                  (tape-input tape value)
                  (record-op! tape (map (lambda (i) (vector-ref nodes i)) children) value
                    (lambda (g) (tcr-rule op children axes shape graph g work)))))
            (if (eq? op 'input) (for-each (lambda (name)
              (set! targets (cons (list name (vector-ref nodes id) shape) targets))) names)))))))
           (root (vector-ref info 1)) (output (vector-ref graph root))
           (shape (vector-ref output 1)))
      (if (not (equal? (tensor-snapshot-shape seed) (if (null? shape) '(1) shape))) (error "Tensor cotangent seed shape mismatch"))
      (let* ((weights (tcr-vector shape (lambda (coords) (tensor-snapshot-ref seed (if (null? coords) '(0) coords)))))
             (loss (record-op! tape (list (vector-ref nodes root)) 0.0
               (lambda (g) (list (list->vector (map (lambda (w) (tcr-finite (* g w))) (vector->list weights)))))))
             (ordered (reverse targets))
             (gradients (tape-gradient tape loss (map cadr ordered))))
        (vector-set! work 0 (tape-op-count tape))
        (let ((owned (map (lambda (target gradient)
          (vector-set! work 3 (+ (vector-ref work 3) (vector-length gradient)))
          (list (car target) (tensor-snapshot (tcr-tensor gradient (caddr target))))) ordered gradients)))
          (vector owned work))))))
(define (tcr-check state)
  (if (not (and (vector? state) (= (vector-length state) 5) (eq? (vector-ref state 0) 'tensor-circuit-pullback-v1)))
      (error "Expected maintained tensor pullback")))
(define (make-tensor-circuit-pullback inputs expression seed)
  (let* ((circuit (make-tensor-circuit inputs expression)) (owned (tensor-snapshot seed))
         (reverse (tcr-reverse circuit owned)))
    (vector 'tensor-circuit-pullback-v1 circuit owned (vector-ref reverse 0) (vector-ref reverse 1))))
;; A tick installs all primal edits first, then the additive seed edit, then
;; records a fresh structural reverse sweep. This includes all finite cross terms.
(define (tensor-circuit-pullback-step state changes seed-change)
  (tcr-check state)
  (let* ((forward (tensor-circuit-step (vector-ref state 1) changes))
         (seed (if seed-change (tensor-snapshot-apply (vector-ref state 2) seed-change) (vector-ref state 2)))
         (reverse (tcr-reverse (vector-ref forward 0) seed)) (gradients (vector-ref reverse 0))
         (deltas (map (lambda (pair)
           (let* ((old (cadr (assq (car pair) (vector-ref state 3)))) (new (cadr pair))
                  (shape (tensor-snapshot-shape new)) (entries '()))
             (tcr-coordinates shape (lambda (coords)
               (let ((d (tcr-finite (- (tensor-snapshot-ref new coords) (tensor-snapshot-ref old coords)))))
                 (if (not (= d 0)) (set! entries (cons (list coords d) entries))))))
             (list (car pair) (tensor-delta shape entries)))) gradients))
         (next (vector 'tensor-circuit-pullback-v1 (vector-ref forward 0) seed gradients (vector-ref reverse 1))))
    (vector next (vector-ref forward 1) deltas (vector (vector-ref forward 2) (vector-copy (vector-ref reverse 1))))))
(define (tensor-circuit-pullback-output state)
  (tcr-check state)
  (vector (tensor-circuit-output (vector-ref state 1))
    (map (lambda (pair) (list (car pair) (tensor-snapshot->tensor (cadr pair)))) (vector-ref state 3))))
(define (tensor-circuit-pullback-work state) (tcr-check state) (vector-copy (vector-ref state 4)))
