;;; Exact sparse Hessians with explicit structure and counted scalar/HVP probes.
(require core.algebraic_domain)
(require core.ad.sparsity)
(provide algebraic-sparse-hessian algebraic-sparse-hessian-ref
         algebraic-sparse-hessian-dense algebraic-sparse-hessian-summary)

(define (ash-index? i n) (and (integer? i) (exact? i) (>= i 0) (< i n)))
(define (ash-insert pair pairs)
  (cond ((null? pairs) (list pair))
        ((equal? pair (car pairs)) pairs)
        ((or (< (car pair) (caar pairs))
             (and (= (car pair) (caar pairs)) (< (cadr pair) (cadar pairs)))) (cons pair pairs))
        (else (cons (car pairs) (ash-insert pair (cdr pairs))))))
(define (ash-neighbor x xs)
  (cond ((null? xs) (list x)) ((= x (car xs)) xs)
        ((< x (car xs)) (cons x xs)) (else (cons (car xs) (ash-neighbor x (cdr xs))))))
(define (ash-pattern n pattern)
  (if (not (list? pattern)) (error "Expected a Hessian index-pair list"))
  (let loop ((rest pattern) (pairs '()))
    (if (null? rest) pairs
      (let ((pair (car rest)))
        (if (not (and (list? pair) (= (length pair) 2) (ash-index? (car pair) n) (ash-index? (cadr pair) n)))
            (error "Invalid exact Hessian structural entry"))
        (loop (cdr rest) (ash-insert (list (min (car pair) (cadr pair)) (max (car pair) (cadr pair))) pairs))))))
(define (ash-copy-vector domain values n)
  (if (not (and (vector? values) (= (vector-length values) n))) (error "Exact Hessian vector dimension mismatch"))
  (let ((copy (algebraic-domain-ref domain 'copy)))
    (list->vector (map copy (vector->list values)))))
(define (ash-direction colors color n)
  (let ((direction (make-vector n 0)))
    (let loop ((i 0)) (if (< i n)
      (begin (if (= (vector-ref colors i) color) (vector-set! direction i 1)) (loop (+ i 1))))) direction))
(define (algebraic-sparse-hessian owner function point pattern . options)
  (let* ((domain (algebraic-domain owner))
         (n (if (vector? point) (vector-length point) (error "Expected an exact Hessian point vector")))
         (callback (if (null? options) #f (car options))))
    (if (not (and (<= n 128) (<= (length options) 1)
                  (if callback (procedure? callback) (procedure? function))))
        (error "Invalid exact sparse Hessian callback or size"))
    (let* ((point (ash-copy-vector domain point n)) (pairs (ash-pattern n pattern))
           (adjacency (make-vector n '())) (calls 0))
      (for-each (lambda (pair)
        (let ((i (car pair)) (j (cadr pair)))
          (if (not (= i j))
            (begin (vector-set! adjacency i (ash-neighbor j (vector-ref adjacency i)))
                   (vector-set! adjacency j (ash-neighbor i (vector-ref adjacency j))))))) pairs)
      (let* ((colored (hessian-color-graph adjacency)) (colors (car colored)) (count (cdr colored))
             (columns (make-vector count #f)) (hyper (if callback #f (make-algebraic-hyperdual owner)))
             (entries (make-vector (length pairs) #f)))
        (define (probe row color)
          (if callback
            (begin
              (if (not (vector-ref columns color))
                (let ((result (callback (ash-copy-vector domain point n) (ash-direction colors color n))))
                  (set! calls (+ calls 1))
                  (vector-set! columns color (ash-copy-vector domain result n))))
              (vector-ref (vector-ref columns color) row))
            (let ((seeds (make-vector n #f)))
              (let variables ((i 0)) (if (< i n)
                (begin (vector-set! seeds i (algebraic-ad-value hyper
                  (list (vector-ref point i) (if (= (vector-ref colors i) color) 1 0) (if (= i row) 1 0) 0)))
                  (variables (+ i 1)))))
              (let ((result (function seeds)))
                (set! calls (+ calls 1))
                (if (not (eq? (algebraic-ad-context result) hyper)) (error "Foreign exact Hessian probe result"))
                (vector-ref (algebraic-ad-coefficients result) 3)))))
        (let recover ((rest pairs) (index 0)) (if (pair? rest)
          (let* ((pair (car rest)) (i (car pair)) (j (cadr pair)) (value (probe i (vector-ref colors j))))
            (vector-set! entries index (vector i j ((algebraic-domain-ref domain 'copy) value)))
            (recover (cdr rest) (+ index 1)))))
        (vector 'algebraic-sparse-hessian-v1 domain n entries count calls (if callback 'hvp 'scalar))))))
(define (ash-result result)
  (if (not (and (vector? result) (= (vector-length result) 7)
                (eq? (vector-ref result 0) 'algebraic-sparse-hessian-v1)))
      (error "Expected an exact sparse Hessian")) result)
(define (algebraic-sparse-hessian-summary result)
  (ash-result result)
  (vector (vector-ref result 2) (vector-ref result 4) (vector-ref result 5)
          (vector-length (vector-ref result 3)) (vector-ref result 6)))
(define (algebraic-sparse-hessian-ref result i j)
  (ash-result result)
  (let* ((n (vector-ref result 2)) (domain (vector-ref result 1)) (entries (vector-ref result 3))
         (lo (min i j)) (hi (max i j)))
    (if (not (and (ash-index? i n) (ash-index? j n))) (error "Exact Hessian index outside shape"))
    (let search ((k 0))
      (if (= k (vector-length entries)) (algebraic-domain-ref domain 'zero)
        (let ((entry (vector-ref entries k)))
          (if (and (= lo (vector-ref entry 0)) (= hi (vector-ref entry 1)))
            ((algebraic-domain-ref domain 'copy) (vector-ref entry 2)) (search (+ k 1))))))))
(define (algebraic-sparse-hessian-dense result)
  (ash-result result)
  (let* ((n (vector-ref result 2)) (out (make-vector n #f)))
    (let rows ((i 0)) (if (< i n)
      (let ((row (make-vector n #f)))
        (let columns ((j 0)) (if (< j n)
          (begin (vector-set! row j (algebraic-sparse-hessian-ref result i j)) (columns (+ j 1)))))
        (vector-set! out i row) (rows (+ i 1))))) out))
