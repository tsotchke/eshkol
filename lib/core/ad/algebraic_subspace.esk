;;; Exact isolated symmetric invariant subspaces, including internal degeneracy.
(require core.algebraic_linalg)
(provide make-algebraic-subspace algebraic-subspace-projector algebraic-subspace-jvp
         algebraic-subspace-vjp algebraic-subspace-info verify-algebraic-subspace-jvp)

(define (asp-tab n function) (list->vector (map function (iota n))))
(define (asp-at a i j) (vector-ref (vector-ref a i) j))
(define (asp-matrix domain a n)
  (if (not (and (vector? a) (= (vector-length a) n))) (error "Subspace matrix shape mismatch"))
  (let ((copy (algebraic-domain-ref domain 'copy)))
    (asp-tab n (lambda (i)
      (let ((row (vector-ref a i)))
        (if (not (and (vector? row) (= (vector-length row) n))) (error "Subspace matrices must be square"))
        (asp-tab n (lambda (j) (copy (vector-ref row j)))))))))
(define (asp-combine domain operation a b)
  (let ((n (vector-length a)) (op (algebraic-domain-ref domain operation)))
    (asp-tab n (lambda (i) (asp-tab n (lambda (j) (op (asp-at a i j) (asp-at b i j))))))))
(define (asp-equal? domain a b)
  (let ((same? (algebraic-domain-ref domain 'equal?)) (n (vector-length a)))
    (let rows ((i 0)) (or (= i n)
      (and (let columns ((j 0)) (or (= j n)
        (and (same? (asp-at a i j) (asp-at b i j)) (columns (+ j 1))))) (rows (+ i 1)))))))
(define (asp-symmetric? domain a)
  (let ((same? (algebraic-domain-ref domain 'equal?)) (n (vector-length a)))
    (let rows ((i 0)) (or (= i n)
      (and (let columns ((j 0)) (or (= j i)
        (and (same? (asp-at a i j) (asp-at a j i)) (columns (+ j 1))))) (rows (+ i 1)))))))
(define (asp-off owner domain p q x)
  (asp-combine domain 'add
    (algebraic-matrix-mul owner (algebraic-matrix-mul owner p x) q)
    (algebraic-matrix-mul owner (algebraic-matrix-mul owner q x) p)))
(define (asp-commutator owner domain a b)
  (asp-combine domain 'sub (algebraic-matrix-mul owner a b) (algebraic-matrix-mul owner b a)))
(define (asp-flat x)
  (list->vector (fold-left append '() (map vector->list (vector->list x)))))
(define (asp-unflat x n)
  (asp-tab n (lambda (i) (asp-tab n (lambda (j) (vector-ref x (+ (* i n) j)))))))
(define (asp-symmetrize domain x)
  (let ((n (vector-length x)) (add (algebraic-domain-ref domain 'add))
        (mul (algebraic-domain-ref domain 'mul)))
    (asp-tab n (lambda (i) (asp-tab n (lambda (j) (mul 1/2 (add (asp-at x i j) (asp-at x j i)))))))))
;; L(X)=[A,[P,X]]+PXP+QXQ. Its diagonal blocks are identity; its off-diagonal
;; blocks are Sylvester maps. An admitted inverse certifies disjoint selected
;; and complementary spectra without requiring distinct eigenvalues inside P.
(define (asp-operator domain a p q ap)
  (let* ((n (vector-length a)) (size (* n n))
         (add (algebraic-domain-ref domain 'add)) (sub (algebraic-domain-ref domain 'sub))
         (mul (algebraic-domain-ref domain 'mul)) (zero (algebraic-domain-ref domain 'zero)))
    (asp-tab size (lambda (row)
      (let ((i (quotient row n)) (j (modulo row n)))
        (asp-tab size (lambda (column)
          (let ((k (quotient column n)) (l (modulo column n)))
            (add
              (sub (if (= l j) (asp-at ap i k) zero)
                   (mul (asp-at a i k) (asp-at p l j)))
              (add
                (sub (if (= i k) (asp-at ap l j) zero)
                     (mul (asp-at p i k) (asp-at a l j)))
                (add (mul (asp-at p i k) (asp-at p l j))
                     (mul (asp-at q i k) (asp-at q l j)))))))))))))
(define (asp-admit owner matrix projector)
  (let* ((domain (algebraic-domain owner))
         (n (if (vector? matrix) (vector-length matrix) 0)))
    (if (not (and (>= n 2) (<= n 4))) (error "Subspaces require matrices of size two through four"))
    (let* ((a (asp-matrix domain matrix n)) (p (asp-matrix domain projector n))
           (sub (algebraic-domain-ref domain 'sub)) (add (algebraic-domain-ref domain 'add))
           (same? (algebraic-domain-ref domain 'equal?)) (zero (algebraic-domain-ref domain 'zero))
           (identity (asp-tab n (lambda (i) (asp-tab n (lambda (j)
             (algebraic-domain-ref domain (if (= i j) 'one 'zero)))))))
           (q (asp-combine domain 'sub identity p))
           (ap (algebraic-matrix-mul owner a p))
           (rank-value (let trace ((i 0) (out zero))
             (if (= i n) out (trace (+ i 1) (add out (asp-at p i i))))))
           (rank (let search ((k 1))
             (cond ((= k n) #f) ((same? rank-value k) k) (else (search (+ k 1)))))))
      (if (not (and rank (asp-symmetric? domain a) (asp-symmetric? domain p)
                    (asp-equal? domain (algebraic-matrix-mul owner p p) p)
                    (asp-equal? domain ap (algebraic-matrix-mul owner p a))))
          (error "Expected a nontrivial symmetric invariant orthogonal projector"))
      (vector domain a p q (algebraic-factor owner (asp-operator domain a p q ap)) rank))))
(define (asp-tangent? owner domain a p direction derivative)
  (and (asp-symmetric? domain direction) (asp-symmetric? domain derivative)
    (asp-equal? domain (asp-combine domain 'add
      (algebraic-matrix-mul owner p derivative) (algebraic-matrix-mul owner derivative p)) derivative)
    (asp-equal? domain (asp-commutator owner domain a derivative)
      (asp-commutator owner domain p direction))))
(define (make-algebraic-subspace owner matrix projector)
  (let* ((admitted (asp-admit owner matrix projector))
         (domain (vector-ref admitted 0)) (a (vector-ref admitted 1))
         (p (vector-ref admitted 2)) (q (vector-ref admitted 3))
         (factor (vector-ref admitted 4)) (rank (vector-ref admitted 5)) (n (vector-length a)))
    (lambda (action value)
      (cond
        ((eq? action 'projector) (asp-matrix domain p n))
        ((eq? action 'info) (vector n rank (* n n) (algebraic-domain-ref domain 'depth)))
        ((eq? action 'jvp)
         (let ((direction (asp-matrix domain value n)))
           (if (not (asp-symmetric? domain direction)) (error "Subspace direction must preserve symmetry"))
           (let ((derivative (asp-unflat (algebraic-factor-solve factor
                   (asp-flat (asp-off owner domain p q direction))) n)))
             (if (not (asp-tangent? owner domain a p direction derivative))
                 (error "Subspace derivative failed exact tangent residuals")) derivative)))
        ((eq? action 'vjp)
         (let* ((seed (asp-symmetrize domain (asp-matrix domain value n)))
                (adjoint (asp-unflat (algebraic-factor-solve-transpose factor (asp-flat seed)) n)))
           (asp-off owner domain p q adjoint)))
        (else (error "Unknown algebraic subspace action"))))))
(define (algebraic-subspace-projector subspace) (subspace 'projector #f))
(define (algebraic-subspace-info subspace) (subspace 'info #f))
(define (algebraic-subspace-jvp subspace direction) (subspace 'jvp direction))
(define (algebraic-subspace-vjp subspace seed) (subspace 'vjp seed))
;; Re-admit the caller's original problem (including exact separation), then
;; verify the defining linearized equations rather than comparing two solves.
(define (verify-algebraic-subspace-jvp owner matrix projector direction derivative)
  (guard (e (else #f))
    (let* ((admitted (asp-admit owner matrix projector))
           (domain (vector-ref admitted 0)) (a (vector-ref admitted 1))
           (p (vector-ref admitted 2)) (n (vector-length a)))
      (asp-tangent? owner domain a p (asp-matrix domain direction n) (asp-matrix domain derivative n)))))
