;;; Exact selected-real Farkas rays. Bounded search never certifies by failure.
(require core.algebraic_linalg)
(provide algebraic-farkas-search algebraic-farkas-verify)
(define (af-tab n f) (list->vector (map f (iota n))))
(define (af-vector d value n)
  (if (not (and (vector? value) (= (vector-length value) n))) (error "Farkas vector shape mismatch"))
  (list->vector (map (algebraic-domain-ref d 'copy) (vector->list value))))
(define (af-rows d value n)
  (if (not (and (vector? value) (<= (vector-length value) 8))) (error "Farkas admits at most eight rows of each kind"))
  (list->vector (map (lambda (row) (af-vector d row n)) (vector->list value))))
(define (af-source owner n a b c limits)
  (if (not (and (integer? n) (exact? n) (> n 0) (<= n 8))) (error "Farkas dimension must be 1..8"))
  (let* ((d (algebraic-domain owner)) (a (af-rows d a n)) (c (af-rows d c n)))
    (if (algebraic-domain-ref d 'parent) (error "Farkas ordering requires a selected-real field, not a Taylor ring"))
    (vector d n a (af-vector d b (vector-length a)) c (af-vector d limits (vector-length c)))))
(define (af-sum d n f)
  (let ((add (algebraic-domain-ref d 'add)))
    (let loop ((i 0) (s (algebraic-domain-ref d 'zero))) (if (= i n) s (loop (+ i 1) (add s (f i)))))))
(define (af-equal-source? a b)
  (let ((same? (algebraic-domain-ref (vector-ref a 0) 'equal?)))
    (and (= (vector-ref a 1) (vector-ref b 1))
      (let check ((slot 2)) (or (= slot 6)
        (and (let* ((x (vector-ref a slot)) (y (vector-ref b slot)))
          (and (= (vector-length x) (vector-length y))
            (let rows ((i 0)) (or (= i (vector-length x))
              (and (if (even? slot)
                (let ((u (vector-ref x i)) (v (vector-ref y i)))
                  (and (= (vector-length u) (vector-length v))
                    (let cols ((j 0)) (or (= j (vector-length u))
                      (and (same? (vector-ref u j) (vector-ref v j)) (cols (+ j 1)))))))
                (same? (vector-ref x i) (vector-ref y i))) (rows (+ i 1)))))))
          (check (+ slot 1))))))))
(define (af-valid? source u v)
  (let* ((d (vector-ref source 0)) (n (vector-ref source 1)) (a (vector-ref source 2)) (b (vector-ref source 3))
         (c (vector-ref source 4)) (limits (vector-ref source 5))
         (u (af-vector d u (vector-length a))) (v (af-vector d v (vector-length c)))
         (add (algebraic-domain-ref d 'add)) (mul (algebraic-domain-ref d 'mul)) (zero? (algebraic-domain-ref d 'zero?)))
    (and (let signs ((i 0)) (or (= i (vector-length v))
           (and (>= (algebraic-sign (vector-ref v i)) 0) (signs (+ i 1)))))
         (let columns ((j 0)) (or (= j n)
           (and (zero? (add (af-sum d (vector-length a) (lambda (i) (mul (vector-ref (vector-ref a i) j) (vector-ref u i))))
                           (af-sum d (vector-length c) (lambda (i) (mul (vector-ref (vector-ref c i) j) (vector-ref v i))))))
                (columns (+ j 1)))))
         (< (algebraic-sign (add (af-sum d (vector-length a) (lambda (i) (mul (vector-ref b i) (vector-ref u i))))
                                 (af-sum d (vector-length c) (lambda (i) (mul (vector-ref limits i) (vector-ref v i)))))) 0))))
(define (algebraic-farkas-verify owner n a b c limits result)
  (guard (e (else #f))
    (let ((source (af-source owner n a b c limits)))
      (and (vector? result) (= (vector-length result) 7) (eq? (vector-ref result 0) 'algebraic-farkas-v1)
           (eq? (vector-ref result 1) 'infeasible) (af-equal-source? source (vector-ref result 2))
           (af-valid? source (vector-ref result 3) (vector-ref result 4))))))
;; Solve an overdetermined full-column-rank support using exact elimination.
;; Singular/dependent supports are skipped, not treated as infeasibility.
(define (af-support-solve d columns support rows)
  (let* ((k (length support)) (zero (algebraic-domain-ref d 'zero))
         (sub (algebraic-domain-ref d 'sub)) (mul (algebraic-domain-ref d 'mul))
         (inv (algebraic-domain-ref d 'inverse)) (zero? (algebraic-domain-ref d 'zero?))
         (matrix (af-tab rows (lambda (i) (list->vector (append
           (map (lambda (j) (vector-ref (vector-ref columns j) i)) support)
           (list (if (= i (- rows 1)) -1 zero))))))))
    (let eliminate ((col 0))
      (if (= col k)
        (if (let residual ((i k)) (or (= i rows) (and (zero? (vector-ref (vector-ref matrix i) k)) (residual (+ i 1)))))
            (af-tab k (lambda (i) (vector-ref (vector-ref matrix i) k))) #f)
        (let ((pivot (let find ((i col)) (cond ((= i rows) #f)
          ((not (zero? (vector-ref (vector-ref matrix i) col))) i) (else (find (+ i 1)))))))
          (if (eq? pivot #f) #f
              (begin
                (let ((row (vector-ref matrix col))) (vector-set! matrix col (vector-ref matrix pivot)) (vector-set! matrix pivot row))
                (let* ((row (vector-ref matrix col)) (scale (inv (vector-ref row col))))
                  (let normalize ((j col)) (if (<= j k) (begin (vector-set! row j (mul (vector-ref row j) scale)) (normalize (+ j 1)))))
                  (let others ((i 0)) (if (< i rows)
                    (begin (if (not (= i col))
                      (let* ((other (vector-ref matrix i)) (factor (vector-ref other col)))
                        (let subtract ((j col)) (if (<= j k)
                          (begin (vector-set! other j (sub (vector-ref other j) (mul factor (vector-ref row j)))) (subtract (+ j 1)))))))
                      (others (+ i 1))))))
                (eliminate (+ col 1)))))))))
(define (algebraic-farkas-search owner n a b c limits . options)
  (let* ((source (af-source owner n a b c limits)) (d (vector-ref source 0))
         (a (vector-ref source 2)) (b (vector-ref source 3)) (c (vector-ref source 4)) (limits (vector-ref source 5))
         (k (vector-length a)) (m (vector-length c)) (count (+ (* 2 k) m))
         (budget (if (null? options) 4096 (car options))) (attempts 0) (found #f)
         (zero (algebraic-domain-ref d 'zero)) (sub (algebraic-domain-ref d 'sub)))
    (if (not (and (<= (length options) 1) (integer? budget) (exact? budget) (> budget 0) (<= budget 65536)))
        (error "Farkas support budget must be 1..65536"))
    (let ((columns (af-tab count (lambda (j)
      (let* ((eq? (< j (* 2 k))) (negative? (and eq? (>= j k)))
             (i (if eq? (modulo j k) (- j (* 2 k))))
             (row (vector-ref (if eq? a c) i)) (target (vector-ref (if eq? b limits) i)))
        (af-tab (+ n 1) (lambda (r) (let ((x (if (= r n) target (vector-ref row r))))
          (if negative? (sub zero x) x)))))))))
      (define (attempt support)
        (if (and (not found) (< attempts budget))
          (begin (set! attempts (+ attempts 1))
            (let ((z (guard (e (else #f)) (af-support-solve d columns support (+ n 1)))))
              (if (and z (let signs ((i 0)) (or (= i (vector-length z))
                          (and (>= (algebraic-sign (vector-ref z i)) 0) (signs (+ i 1))))))
                (let ((u (make-vector k zero)) (v (make-vector m zero)) (add (algebraic-domain-ref d 'add)))
                  (let install ((rest support) (i 0)) (if (pair? rest)
                    (let ((j (car rest)) (value (vector-ref z i)))
                      (if (< j (* 2 k))
                        (let ((p (modulo j k))) (vector-set! u p (add (vector-ref u p) (if (< j k) value (sub zero value)))))
                        (vector-set! v (- j (* 2 k)) value))
                      (install (cdr rest) (+ i 1)))))
                  (if (af-valid? source u v) (set! found (vector u v)))))))))
      (define (choose start left selected)
        (if (and (not found) (< attempts budget))
          (if (= left 0) (attempt (reverse selected))
              (let loop ((j start)) (if (and (<= j (- count left)) (not found) (< attempts budget))
                (begin (choose (+ j 1) (- left 1) (cons j selected)) (loop (+ j 1))))))))
      (let sizes ((size 1)) (if (and (<= size (min count (+ n 1))) (not found) (< attempts budget))
        (begin (choose 0 size '()) (sizes (+ size 1)))))
      (vector 'algebraic-farkas-v1 (if found 'infeasible 'unknown) source
        (if found (vector-ref found 0) #f) (if found (vector-ref found 1) #f) attempts
        (cond (found 'certificate-found) ((= attempts budget) 'budget-exhausted) (else 'enumeration-complete))))))
