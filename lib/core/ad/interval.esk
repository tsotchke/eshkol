;; ─────────────────────────────────────────────────────────────────────────
;;  core.ad.interval — outward-rounding interval arithmetic  (Phase P8 support)
;; ─────────────────────────────────────────────────────────────────────────
;;
;;  A small, self-contained interval-arithmetic library used by
;;  core.ad.taylor_models to build rigorous (sound) enclosures for validated
;;  automatic differentiation (docs/design/AD_TAYLOR_TOWER.md §11).
;;
;;  An interval is represented as a pair  (lo . hi)  with lo <= hi, denoting the
;;  closed set { x : lo <= x <= hi }.  A plain real value v is the degenerate
;;  interval (v . v).
;;
;;  ── ROUNDING MODEL (v1.5.0, ADR-0050): directed rounding by default ────
;;
;;  Every arithmetic and elementary operation in this module is evaluated by
;;  core.ad.rigorous_interval: each endpoint is computed in round-to-nearest
;;  binary64 and then stepped one ulp outward with `fl-next-down` (lower) or
;;  `fl-next-up` (upper), the portable form of directed rounding (C99
;;  `nextafter`; IEEE 754-2019 sec. 5.3.1 nextDown/nextUp). Exact endpoints
;;  (integers, bignums, rationals) are combined with exact arithmetic and
;;  never rounded; a mixed operation converts each exact endpoint outward
;;  first. exp/log/sin/cos/atan/sqrt are not libm calls with an error
;;  budget: they are range-reduced Taylor polynomials with exact rational
;;  coefficients plus a proven Lagrange / alternating-series / integral
;;  remainder (sqrt is bracketed by certified squaring). See the derivations
;;  in lib/core/ad/rigorous_interval.esk.
;;
;;  This is the default path with no flag. The optional trailing `rigorous?`
;;  argument the operations accepted since v1.3.5 is still accepted, so
;;  existing call sites compile unchanged, and has no further effect: both
;;  values select the same directed-rounding operation. The relative-epsilon
;;  constants `iv-eps`, `iv-rel-pad`, `iv-abs-pad` stay exported as named
;;  binary64 constants; no operation widens by them any longer.
;;
;;  Soundness statement: for operand intervals that contain real values
;;  x, y, every result interval contains the exact real result of the
;;  operation on x, y. The proof obligations are the single-op rounding bound
;;  of IEEE 754 round-to-nearest (|fl(r) - r| <= ulp(fl(r))/2 < one nextafter
;;  step) and the remainder theorems cited per function. References: R. E.
;;  Moore, R. B. Kearfott, M. J. Cloud, Introduction to Interval Analysis
;;  (SIAM 2009); W. Tucker, Validated Numerics (Princeton 2011).
;;
;;  ── Domain-guard policy ───────────────────────────────────────────────────
;;  interval-div signals an `error` when the denominator interval contains 0
;;  (rather than returning an unbounded interval), and interval-log signals an
;;  `error` when the argument interval reaches <= 0. These are the honest
;;  failures for a validated library: an unbounded/NaN enclosure would silently
;;  poison every downstream bound.
;; ─────────────────────────────────────────────────────────────────────────

;; core.ad.rigorous_interval is a LEAF module (it does not require this
;; file), so this require does not create a cycle.
(require core.ad.rigorous_interval)

(provide interval-of interval-lo interval-hi interval?
         interval-contains? interval-width interval-mid
         interval-union interval-widen
         interval-add interval-sub interval-neg
         interval-mul interval-div
         interval-exp interval-log interval-sin interval-cos
         interval-pow
         iv-eps iv-rel-pad iv-abs-pad
         ;; v1.5.0 (ADR-0050)
         interval-sqrt interval-atan interval-sqr interval-abs
         interval-intersect interval-subset? interval-point interval-pi)

;; ── Named binary64 constants (no operation widens by them) ────────────────
(define iv-eps      2.220446049250313e-16)   ; 2^-52, machine epsilon
(define iv-rel-pad  (* 8.0  iv-eps))
(define iv-abs-pad  1e-300)

;; ── Construction / accessors ───────────────────────────────────────────────
(define (interval-of lo hi)
  (if (<= lo hi) (cons lo hi) (cons hi lo)))   ; tolerate swapped args
(define (interval-point x) (cons x x))
(define (interval-lo iv) (car iv))
(define (interval-hi iv) (cdr iv))
(define (interval? x) (and (pair? x) (number? (car x)) (number? (cdr x))))
(define (interval-width iv) (- (cdr iv) (car iv)))   ; round-to-nearest measure
(define (interval-mid iv) (* 1/2 (+ (car iv) (cdr iv))))
(define (interval-contains? iv x)
  (and (>= x (car iv)) (<= x (cdr iv))))
(define (interval-union a b) (ia-hull a b))
(define (interval-intersect a b) (ia-intersect a b))
(define (interval-subset? a b)
  (and (>= (car a) (car b)) (<= (cdr a) (cdr b))))

;; Outward absolute margin: [lo - eps, hi + eps] with each endpoint rounded
;; outward (exact when lo, hi and eps are exact).
(define (interval-widen iv eps)
  (cons (car (ia- (cons (car iv) (car iv)) (cons eps eps)))
        (cdr (ia+ (cons (cdr iv) (cdr iv)) (cons eps eps)))))

;; ── Arithmetic (directed rounding; trailing rigorous? accepted) ───────────
(define (interval-add a b . opt) (ia+ a b))
(define (interval-sub a b . opt) (ia- a b))
(define (interval-neg a) (ia-neg a))           ; exact, no rounding needed
(define (interval-mul a b . opt) (ia* a b))
;; interval-div: SIGNALS AN ERROR if the denominator contains 0 (documented policy)
(define (interval-div a b . opt) (ia/ a b))

;; ── Elementary functions (proven remainders, see rigorous_interval) ──────
(define (interval-exp a . opt) (ia-exp a))
;; interval-log: SIGNALS AN ERROR when the argument reaches <= 0
(define (interval-log a . opt) (ia-log a))
(define (interval-sin a . opt) (ia-sin a))
(define (interval-cos a . opt) (ia-cos a))
(define (interval-sqrt a . opt) (ia-sqrt a))
(define (interval-atan a . opt) (ia-atan a))
(define (interval-sqr a) (ia-sqr a))
(define (interval-abs a) (ia-abs-interval a))
(define (interval-pi) (ia-pi))

;; integer power iv^n (n a nonnegative integer); even powers of a
;; sign-straddling interval start at 0 (binary powering through ia-sqr).
(define (interval-pow a n) (ia-ipow a n))
