;;; Polynomial row/parameter plans: maintained moments and live exact gradients.
(require core.dbsp)
(require core.algebraic_domain)
(provide make-algebraic-incremental-plan algebraic-incremental-new
         algebraic-incremental-step algebraic-incremental-output algebraic-incremental-info)

(define (aic-size? n) (and (integer? n) (exact? n) (>= n 0) (<= n 8)))
(define (aic-pow mul one value n)
  (let loop ((k n) (out one)) (if (= k 0) out (loop (- k 1) (mul out value)))))
(define (aic-add-term domain term terms)
  (let ((zero? (algebraic-domain-ref domain 'zero?)) (add (algebraic-domain-ref domain 'add)))
    (if (zero? (vector-ref term 0)) terms
      (let insert ((rest terms) (count 0))
        (cond ((null? rest)
               (if (>= count 128) (error "Incremental polynomial exceeds 128 terms")) (list term))
              ((and (equal? (vector-ref term 1) (vector-ref (car rest) 1))
                    (equal? (vector-ref term 2) (vector-ref (car rest) 2)))
               (let ((coefficient (add (vector-ref term 0) (vector-ref (car rest) 0))))
                 (if (zero? coefficient) (cdr rest)
                   (cons (vector coefficient (vector-ref term 1) (vector-ref term 2)) (cdr rest)))))
              (else (cons (car rest) (insert (cdr rest) (+ count 1)))))))))
(define (aic-add domain left right)
  (let loop ((rest right) (out left))
    (if (null? rest) out (loop (cdr rest) (aic-add-term domain (car rest) out)))))
(define (aic-times domain left right)
  (let ((mul (algebraic-domain-ref domain 'mul)))
    (let left-loop ((a left) (out '()))
      (if (null? a) out
        (left-loop (cdr a)
          (let right-loop ((b right) (out out))
            (if (null? b) out
              (let ((rp (make-vector (vector-length (vector-ref (car a) 1)) 0))
                    (pp (make-vector (vector-length (vector-ref (car a) 2)) 0)) (degree 0))
                (let dimensions ((group 1)) (if (<= group 2)
                  (let ((target (if (= group 1) rp pp)))
                    (let powers ((i 0)) (if (< i (vector-length target))
                      (let ((power (+ (vector-ref (vector-ref (car a) group) i) (vector-ref (vector-ref (car b) group) i))))
                        (set! degree (+ degree power)) (vector-set! target i power) (powers (+ i 1)))))
                    (dimensions (+ group 1)))))
                (if (> degree 8) (error "Incremental polynomial total degree exceeds 8"))
                (right-loop (cdr b) (aic-add-term domain
                  (vector (mul (vector-ref (car a) 0) (vector-ref (car b) 0)) rp pp) out))))))))))
(define (aic-compile domain row-width parameter-width expression)
  (let ((nodes 0) (copy (algebraic-domain-ref domain 'copy)))
    (define (constant value) (list (vector (copy value) (make-vector row-width 0) (make-vector parameter-width 0))))
    (define (compile expression depth)
      (set! nodes (+ nodes 1))
      (if (or (> nodes 256) (> depth 32)) (error "Incremental expression exceeds its syntax budget"))
      (if (not (pair? expression)) (constant expression)
        (begin
          (if (not (list? expression)) (error "Expected a proper polynomial expression"))
          (let ((op (car expression)) (args (cdr expression)))
            (cond
              ((or (eq? op 'row) (eq? op 'param))
               (let ((width (if (eq? op 'row) row-width parameter-width)))
                 (if (not (and (= (length args) 1) (integer? (car args)) (exact? (car args))
                               (>= (car args) 0) (< (car args) width))) (error "Polynomial variable index outside shape"))
                 (let ((term (car (constant 1))))
                   (vector-set! (vector-ref term (if (eq? op 'row) 1 2)) (car args) 1) (list term))))
              ((eq? op '+)
               (let loop ((rest args) (out '()))
                 (if (null? rest) out (loop (cdr rest) (aic-add domain out (compile (car rest) (+ depth 1)))))))
              ((eq? op '*)
               (let loop ((rest args) (out (constant 1)))
                 (if (null? rest) out (loop (cdr rest) (aic-times domain out (compile (car rest) (+ depth 1)))))))
              ((eq? op '-)
               (if (not (or (= (length args) 1) (= (length args) 2))) (error "Polynomial subtraction needs one or two arguments"))
               (let ((negative (aic-times domain (constant -1) (compile (if (= (length args) 1) (car args) (cadr args)) (+ depth 1)))))
                 (if (= (length args) 1) negative (aic-add domain (compile (car args) (+ depth 1)) negative))))
              ((eq? op 'pow)
               (if (not (and (= (length args) 2) (integer? (cadr args)) (exact? (cadr args))
                             (>= (cadr args) 0) (<= (cadr args) 8))) (error "Invalid polynomial power"))
               (let ((base (compile (car args) (+ depth 1))))
                 (let power ((k (cadr args)) (out (constant 1)))
                   (if (= k 0) out (power (- k 1) (aic-times domain out base))))))
              (else (error "Unsupported incremental polynomial operator")))))))
    (aic-add domain '() (compile expression 0))))
(define (make-algebraic-incremental-plan owner row-width parameter-width expression)
  (if (not (and (aic-size? row-width) (aic-size? parameter-width)))
      (error "Incremental row and parameter widths must be exact integers from 0 through 8"))
  ;; The gradient uses one explicit spare Taylor level, never a numeric tape.
  (make-algebraic-taylor owner 1)
  (let* ((domain (algebraic-domain owner)) (terms (aic-compile domain row-width parameter-width expression))
         (monomials '()) (compiled '()))
    (for-each (lambda (term)
      (let* ((powers (vector-ref term 1))
             (index (let search ((rest monomials) (i 0))
               (cond ((null? rest) (set! monomials (append monomials (list (vector-copy powers)))) i)
                     ((equal? powers (car rest)) i) (else (search (cdr rest) (+ i 1)))))))
        (set! compiled (cons (vector (vector-ref term 0) index (vector-copy (vector-ref term 2))) compiled)))) terms)
    (vector 'algebraic-incremental-plan-v1 domain row-width parameter-width
            (list->vector (reverse compiled)) (list->vector monomials))))
(define (aic-plan plan)
  (if (not (and (vector? plan) (= (vector-length plan) 6)
                (eq? (vector-ref plan 0) 'algebraic-incremental-plan-v1))) (error "Expected an incremental polynomial plan")) plan)
(define (aic-vector domain values width)
  (if (not (and (vector? values) (= (vector-length values) width))) (error "Incremental value width mismatch"))
  (let ((copy (algebraic-domain-ref domain 'copy))) (list->vector (map copy (vector->list values)))))
(define (aic-evaluate plan moments parameters target-owner)
  (let* ((source (vector-ref plan 1)) (domain (algebraic-domain target-owner)) (terms (vector-ref plan 4))
         (mul (algebraic-domain-ref domain 'mul)) (add (algebraic-domain-ref domain 'add))
         (copy (algebraic-domain-ref domain 'copy)) (source-mul (algebraic-domain-ref source 'mul)))
    (let terms-loop ((i 0) (sum (algebraic-domain-ref domain 'zero)))
      (if (= i (vector-length terms)) sum
        (let* ((term (vector-ref terms i)) (powers (vector-ref term 2))
               (value (let variables ((j 0) (out (copy (source-mul (vector-ref term 0) (vector-ref moments (vector-ref term 1))))))
                 (if (= j (vector-length parameters)) out
                   (variables (+ j 1) (mul out (aic-pow mul (algebraic-domain-ref domain 'one)
                     (vector-ref parameters j) (vector-ref powers j))))))))
          (terms-loop (+ i 1) (add sum value)))))))
(define (aic-output plan moments parameters)
  (let* ((domain (vector-ref plan 1)) (owner (algebraic-domain-ref domain 'owner))
         (p (vector-ref plan 3)) (gradient (make-vector p #f)))
    (let variables ((i 0)) (if (< i p)
      (let ((context (make-algebraic-taylor owner 1)) (seeds (make-vector p #f)))
        (let seed ((j 0)) (if (< j p)
          (begin (vector-set! seeds j (if (= i j) (algebraic-ad-seed context (vector-ref parameters j))
            (algebraic-ad-constant context (vector-ref parameters j)))) (seed (+ j 1)))))
        (vector-set! gradient i (algebraic-ad-derivative (aic-evaluate plan moments seeds context) 1))
        (variables (+ i 1)))))
    (vector (aic-evaluate plan moments parameters owner) gradient)))
(define (aic-state state)
  (if (not (and (vector? state) (= (vector-length state) 5)
                (eq? (vector-ref state 0) 'algebraic-incremental-state-v1))) (error "Expected an incremental polynomial snapshot")) state)
(define (aic-output-copy domain output)
  (vector ((algebraic-domain-ref domain 'copy) (vector-ref output 0))
          (aic-vector domain (vector-ref output 1) (vector-length (vector-ref output 1)))))
(define (algebraic-incremental-output state)
  (aic-state state) (aic-output-copy (vector-ref (vector-ref state 1) 1) (vector-ref state 4)))
(define (algebraic-incremental-info state)
  (aic-state state)
  (let ((plan (vector-ref state 1)))
    (vector (vector-ref plan 2) (vector-ref plan 3) (vector-length (vector-ref plan 4)) (vector-length (vector-ref plan 5)))))
(define (algebraic-incremental-new plan parameters . initial)
  (aic-plan plan)
  (if (> (length initial) 1) (error "Expected at most one initial Z-set"))
  (let* ((domain (vector-ref plan 1)) (parameters (aic-vector domain parameters (vector-ref plan 3)))
         (moments (make-vector (vector-length (vector-ref plan 5)) #f)))
    (let loop ((i 0)) (if (< i (vector-length moments))
      (begin (vector-set! moments i (algebraic-domain-ref domain 'zero)) (loop (+ i 1)))))
    (let ((state (vector 'algebraic-incremental-state-v1 plan parameters moments (aic-output plan moments parameters))))
      (if (null? initial) state
        (vector-ref (algebraic-incremental-step state (car initial) (make-vector (vector-ref plan 3) 0)) 0)))))
(define (algebraic-incremental-step state row-delta parameter-delta)
  (aic-state state)
  (let* ((plan (vector-ref state 1)) (domain (vector-ref plan 1)) (owner (algebraic-domain-ref domain 'owner))
         (p (vector-ref plan 3)) (delta (aic-vector domain parameter-delta p))
         (parameters (aic-vector domain (vector-ref state 2) p))
         (powers (vector-ref plan 5)) (m (vector-length powers)) (moments (aic-vector domain (vector-ref state 3) m))
         (add (algebraic-domain-ref domain 'add)) (sub (algebraic-domain-ref domain 'sub))
         (mul (algebraic-domain-ref domain 'mul)))
    (if (not (zset? row-delta)) (error "Incremental rows require a DBSP Z-set"))
    (let* ((raw (zset-entries row-delta))
           (rows (begin
             (if (not (list? raw)) (error "Expected proper signed row entries"))
             (zset-from-weighted (map (lambda (entry)
               (if (not (and (list? entry) (= (length entry) 2) (integer? (car entry)) (exact? (car entry))))
                   (error "Row weights must be exact integers"))
               (list (car entry) (aic-vector domain (cadr entry) (vector-ref plan 2)))) raw)))))
      (let variables ((i 0)) (if (< i p)
        (begin (vector-set! parameters i (add (vector-ref parameters i) (vector-ref delta i))) (variables (+ i 1)))))
      (for-each (lambda (entry)
        (let ((weight (car entry)) (row (cadr entry)))
          (let monomials ((i 0)) (if (< i m)
            (let ((value (let cells ((j 0) (product (algebraic-domain-ref domain 'one)))
              (if (= j (vector-ref plan 2)) product
                (cells (+ j 1) (mul product (aic-pow mul (algebraic-domain-ref domain 'one)
                  (vector-ref row j) (vector-ref (vector-ref powers i) j))))))))
              (vector-set! moments i (add (vector-ref moments i) (mul weight value))) (monomials (+ i 1)))))))
        (zset-entries rows))
      (let* ((output (aic-output plan moments parameters)) (old (vector-ref state 4)) (gradient-delta (make-vector p #f)))
        (let variables ((i 0)) (if (< i p)
          (begin (vector-set! gradient-delta i (sub (vector-ref (vector-ref output 1) i) (vector-ref (vector-ref old 1) i)))
                 (variables (+ i 1)))))
        (vector (vector 'algebraic-incremental-state-v1 plan parameters moments output)
                (vector (sub (vector-ref output 0) (vector-ref old 0)) gradient-delta)
                (vector 'polynomial-moments-v1 (zset-size rows) (* (zset-size rows) m)
                        (vector-length (vector-ref plan 4)) (+ p 1) 0))))))
