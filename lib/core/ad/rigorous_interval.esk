;; ─────────────────────────────────────────────────────────────────────────
;;  core.ad.rigorous_interval — PROVEN outward-rounded interval arithmetic
;; ─────────────────────────────────────────────────────────────────────────
;;
;;  The RIGOROUS layer beneath core.ad.interval (which stays exactly as it
;;  was: an honest, documented epsilon-widening approximation). Every
;;  primitive here is a proof, not a heuristic: given operand intervals that
;;  soundly contain their true real values, the result interval provably
;;  contains the true real result. Never sampled, never merely "usually
;;  wide enough".
;;
;;  ── ROUNDING MECHANISM: nextafter, not fesetround ───────────────────────
;;  Directed rounding needs each endpoint computed with the FPU rounding
;;  mode steered toward -inf (lower bound) or +inf (upper bound). Eshkol
;;  exposes this as two new runtime primitives, `fl-next-up` / `fl-next-down`
;;  (lib/backend/llvm_codegen.cpp `codegenNextafter`, lib/backend/vm_native.c
;;  native ids 2228/2229), both thin wrappers over the C99 libm function
;;  `nextafter`. We deliberately do NOT use `fesetround`: its FPU
;;  control-word state is a piece of ambient, per-thread machine state that
;;  does not portably survive a JIT-compiled call boundary, a native-vs-VM
;;  substrate switch, or the compiler's other backends (wasm has no FPU
;;  rounding-mode control at all); `nextafter` is a pure function with
;;  identical, portable behaviour on every libm this compiler ships against.
;;
;;  The soundness argument for the single-op case: an IEEE-754
;;  round-to-nearest arithmetic op (or a <=1-ulp-correctly-rounded libm call)
;;  errs from the true real result by at most 0.5 ulp of the *computed*
;;  result. `nextafter(r, direction)` steps r by exactly the local ulp in
;;  that direction (the true definition of "next representable float",
;;  correct across power-of-two boundaries and subnormals — this is exactly
;;  why we use it instead of a hand-rolled "add/subtract epsilon*ulp"
;;  formula, which gets subnormal and power-of-two-boundary steps wrong).
;;  Since the true value differs from r by at most 0.5 ulp and nextafter
;;  moves a full 1 ulp, `fl-next-down(r) <= true <= fl-next-up(r)` always
;;  holds for a single elementary operation. Every interval primitive below
;;  is built from EXACTLY ONE such nudge per endpoint (never a chain of
;;  unnudged floating ops feeding an endpoint), which is what makes the
;;  argument valid at every call site — see each function's comment.
;;
;;  ── EXACTNESS POLICY ─────────────────────────────────────────────────────
;;  ia+ / ia- / ia* / ia/ inspect their operand endpoints: when EVERY
;;  endpoint involved in a given result endpoint's formula is an exact
;;  number (int / bignum / ratnum), the result endpoint is computed with
;;  ordinary exact generic arithmetic (+ - * /) and is therefore exact with
;;  ZERO rounding error — R7RS exactness contagion already guarantees this,
;;  no separate widening step is needed or performed. The moment any
;;  relevant endpoint is inexact, every operand is coerced to a double
;;  (`exact->inexact`, a no-op on an already-inexact value) and the outward
;;  nudge is applied — "mixed exact/inexact takes the conservative
;;  (rounded) side", per the task brief.
;;
;;  Known defect ROUTED AROUND, not fixed: `(expt 1/3 50)` silently returns
;;  the exact integer 0 (repeated-exact-multiplication bug in the `expt`
;;  primitive). Every exact-rational power in this file is instead computed
;;  by `ia-ipow-exact`, a local repeated-multiplication loop built from
;;  plain `*` — the same technique lib/core/ad/interval.esk and
;;  lib/core/ad/taylor_models.esk already use for `iv-int-pow`/`tm-ipow`,
;;  which does not exhibit the defect. Orders below are additionally chosen
;;  small enough (never letting an intermediate factorial or power exceed
;;  ~1e15) that the *documented* int64-numerator/denominator overflow
;;  degrade-to-double path (see docs/reference/stdlib/exact_linalg.md sec 5)
;;  is never even approached — and every derived remainder MAGNITUDE gets
;;  one final `fl-next-up` safety nudge regardless (belt-and-suspenders: the
;;  bound stays sound even if some rational intermediate silently degraded).
;;
;;  ── PER-FUNCTION REMAINDER DERIVATIONS ───────────────────────────────────
;;  sqrt   CERTIFIED BRACKETING, not a Taylor remainder. sqrt's derivative
;;         tower blows up approaching the domain boundary at 0 (the (n+1)-th
;;         derivative of sqrt is proportional to x^(-(2n+1)/2)), so bounding
;;         it needs a lower bound on sqrt(lo) itself — circular. Instead we
;;         start from libm's estimate and walk it outward one ulp at a time
;;         (fl-next-down / fl-next-up) until it is VERIFIED by squaring with
;;         outward-rounded ia* that the candidate's square is on the correct
;;         side of the target: g is a certified lower bound of sqrt(x) once
;;         (ia-up g*g) <= x (which, since squaring is monotone on x>=0,
;;         proves g <= sqrt(x) outright — no derivative bound needed at
;;         all). This is the standard rigorous-numerics technique for
;;         algebraic functions and is tighter than a Taylor remainder would
;;         have been here.
;;  exp    Range reduction by repeated halving (x = r*2^k, exact division —
;;         dividing a float by a power of two is exact, no rounding) until
;;         |r| <= R0 = 1/4, then a Maclaurin polynomial (EXACT rational
;;         coefficients 1/i!) plus a Lagrange remainder bounded by the
;;         elementary, non-circular inequality exp(t) <= 1/(1-t) for
;;         0 <= t < 1 (proof: 1/(1-t) = sum t^n term-by-term for t in
;;         [0,1), exp(t) = sum t^n/n!, and 1/n! <= 1 for every n, so
;;         exp(t) <= 1/(1-t) termwise). At t=R0=1/4 this gives the exact
;;         rational a priori bound M = 4/3 for |exp^(n+1)(xi)| = exp(xi)
;;         over the WHOLE reduced box (exp is increasing, so its sup on
;;         [-R0,R0] is exp(R0) <= 4/3). exp(x) = exp(r)^(2^k) undoes the
;;         reduction via repeated (rigorous) ia*.
;;  log    Domain-guarded (lo > 0, else error, matching core.ad.interval's
;;         policy). Range reduction by an exact power-of-two DIVISION/
;;         multiplication to land the mantissa m = x/2^k in [2/3, 4/3], so
;;         u = m-1 has |u| <= 1/3; log(x) = k*ln2 + log(1+u). log(1+u) uses
;;         its Mercator series (exact rational coefficients (-1)^(i+1)/i)
;;         with the classical integral-remainder bound
;;         |R_n| <= |u|^(n+1) / ((n+1)(1-|u|)) for |u| < 1 (from the
;;         alternating-tail integral form of the Taylor remainder), which at
;;         |u| <= 1/3 is the exact rational bound (3/2)*(1/3)^(n+1)/(n+1).
;;         ln2 itself is derived from the SAME machinery with zero
;;         additional assumptions: ln2 = log(4/3) - log(2/3), both of which
;;         have |u| = 1/3 exactly, computed once as a module-load-time
;;         constant.
;;  sin/cos  All derivatives of sin and cos are, always, ±sin or ±cos, hence
;;         bounded by 1 in magnitude EVERYWHERE — no per-domain derivative
;;         bound is even needed, only a rigorous *center*, since a libm
;;         sin(c)/cos(c) evaluated at an arbitrary center c would itself
;;         carry unaudited libm rounding error as a "coefficient" (a real
;;         soundness gap). We sidestep it entirely by reducing the argument
;;         to within one quadrant of a rigorous pi/2 (ia-pi, see below;
;;         interval SUBTRACTION of an exact-integer multiple of ia-pi/2, so
;;         the reduction itself is exactly as sound as ia- is) and then
;;         Taylor-expanding sin/cos around EXACTLY 0, where the Maclaurin
;;         coefficients are the literal integers 0/1/-1 — no libm call, no
;;         approximation, at all. The Lagrange remainder is then the
;;         universal bound |R_n| <= |s|^(n+1)/(n+1)! with M=1, computed from
;;         the reduced interval's OWN endpoint magnitude (sound regardless
;;         of how well the reduction happened to land, since the Lagrange
;;         bound is an exact identity for every real s, not an asymptotic
;;         approximation — a poorly reduced input just yields a looser, but
;;         still fully sound, enclosure).
;;  atan   Half-angle reduction atan(x) = 2*atan(x/(1+sqrt(1+x^2))), an
;;         algebraic identity valid for every real x (no sign/domain
;;         casework), applied recursively via our OWN rigorous ia-sqrt until
;;         the argument's magnitude is <= 1/2. `ia-atan-core` then uses the
;;         Gregory-Leibniz series (coefficients (-1)^i/(2i+1), no
;;         factorials, so no overflow-order tension at all) with the
;;         ALTERNATING-SERIES REMAINDER THEOREM: for an alternating series
;;         with strictly-decreasing term magnitudes (true for |u| <= 1), the
;;         truncation error is bounded by the magnitude of the first omitted
;;         term. `ia-pi` is Machin's formula pi = 16*atan(1/5) - 4*atan(1/239)
;;         evaluated directly through `ia-atan-core` (both arguments are
;;         already << 1/2, so no reduction — and no circularity: `ia-pi`
;;         never calls the general, sqrt-reducing `ia-atan`, only the
;;         self-contained `ia-atan-core`; `ia-atan` needs `ia-sqrt`, never
;;         `ia-pi`).
;;
;;  ── KNOWN LOOSENESS (documented, not a soundness bug) ────────────────────
;;  Naive interval arithmetic has the well-known "dependency problem": an
;;  expression that uses the same interval more than once (e.g. `(ia* a a)`
;;  inside `ia-atan`'s reduction step) is evaluated as if the two occurrences
;;  were independent, so the result can be a real (sound) superset of the
;;  true range rather than the tightest possible one — e.g. naive [-1,1]*
;;  [-1,1] returns [-1,1] where the true range of x^2 on [-1,1] is [0,1].
;;  This never compromises soundness (the true range is always a subset of
;;  what is returned); it can make results looser than an expression-aware
;;  (e.g. Taylor-model) evaluator would give.
;; ─────────────────────────────────────────────────────────────────────────

;; Deliberately requires NOTHING from core.ad.interval: interval.esk itself
;; requires THIS module (to route its rigorous? flag), so this module must
;; stay a leaf to avoid a require cycle. It builds its own (lo . hi) pairs
;; with plain `cons` -- always already lo<=hi by construction here (every
;; endpoint pair below comes from an explicit min/max choice or a
;; symmetric +-magnitude remainder), so no shared `make-interval` helper
;; is needed.

(provide ia+ ia- ia* ia/ ia-neg ia-ipow ia-scale
         ia-sqrt ia-exp ia-log ia-sin ia-cos ia-atan
         ia-pi)

;; ── Local numeric helpers (core-module discipline: no stdlib map/for-each,
;;    private to this module) ────────────────────────────────────────────
(define (ia-abs x) (if (< x 0) (- x) x))
(define (ia-min2 a b) (if (<= a b) a b))
(define (ia-max2 a b) (if (>= a b) a b))
(define (ia-pt x) (cons x x))                    ; degenerate point interval

;; Defensive input validation, called at the top of every PUBLIC entry
;; point below. An interval here is, by hard contract, a dotted pair
;; (cons lo hi) with NUMBER endpoints -- `interval-lo`/`interval-hi` in
;; core.ad.interval use exactly the same representation. `(list lo hi)`
;; is a natural, silent mistake: it type-checks as a pair (`pair?` is
;; true of both a dotted pair and a proper list), but `(cdr (list lo
;; hi))` is the ONE-ELEMENT LIST `(hi)`, not the number `hi`. Every
;; arithmetic op below used to accept that silently and then coerce a
;; list through `exact->inexact`/comparisons that are only meaningful on
;; numbers, producing a garbage-but-plausible-looking result (observed:
;; `nextafter` given a non-number reads as if from 0.0, so a malformed
;; upper endpoint silently became the tiniest positive denormal instead
;; of erroring) -- exactly the failure mode a "certified enclosure"
;; library must not have. Loudly refusing here converts that into an
;; immediate, unambiguous error at the call site instead.
(define (ia-check who iv)
  (if (and (pair? iv) (number? (car iv)) (number? (cdr iv)))
      #t
      (error (string-append who
        ": expected an interval built with (cons lo hi) -- got something else. "
        "A common mistake is (list lo hi) instead of (cons lo hi): that makes "
        "the upper endpoint a one-element LIST, not a number, and every "
        "downstream computation on it is meaningless."))))

;; base-2^e helpers used by exp/log's range reduction. `ia-ipow-exact` never
;; calls `expt` (see the defect note above). The named-let counter is
;; deliberately NOT named `e` (matching the outer parameter) -- a
;; same-named loop/parameter pair here triggered a real VM-only bug
;; ("calling non-function", verified: reproduces with the shadowed name,
;; disappears when the loop variable is renamed; native/JIT was unaffected
;; either way). Filed as a defect to route around, not fix, here.
(define (ia-ipow-exact base e)                   ; base^e, base exact, e>=0 int
  (let loop ((n e) (acc 1))
    (if (<= n 0) acc (loop (- n 1) (* acc base)))))
(define (ia-ipow-double base e)                  ; base^e, base double, e>=0 int
  (let loop ((n e) (acc 1.0))
    (if (<= n 0) acc (loop (- n 1) (* acc base)))))
(define (ia-fact n)                              ; n! exact, small n only
  (let loop ((i n) (acc 1))
    (if (<= i 1) acc (loop (- i 1) (* acc i)))))

(define (ia-mag iv)                              ; sup|x| for x in iv, as a double
  (ia-max2 (ia-abs (exact->inexact (car iv))) (ia-abs (exact->inexact (cdr iv)))))

;; ── Basic outward-rounded interval arithmetic ─────────────────────────────
(define (ia-all-exact4? al ah bl bh)
  (and (exact? al) (exact? ah) (exact? bl) (exact? bh)))

(define (ia+ a b)
  (ia-check "ia+" a) (ia-check "ia+" b)
  (let ((al (car a)) (ah (cdr a)) (bl (car b)) (bh (cdr b)))
    (if (ia-all-exact4? al ah bl bh)
        (cons (+ al bl) (+ ah bh))
        (let ((ald (exact->inexact al)) (ahd (exact->inexact ah))
              (bld (exact->inexact bl)) (bhd (exact->inexact bh)))
          (cons (fl-next-down (+ ald bld)) (fl-next-up (+ ahd bhd)))))))

(define (ia- a b)
  (ia-check "ia-" a) (ia-check "ia-" b)
  (let ((al (car a)) (ah (cdr a)) (bl (car b)) (bh (cdr b)))
    (if (ia-all-exact4? al ah bl bh)
        (cons (- al bh) (- ah bl))
        (let ((ald (exact->inexact al)) (ahd (exact->inexact ah))
              (bld (exact->inexact bl)) (bhd (exact->inexact bh)))
          (cons (fl-next-down (- ald bhd)) (fl-next-up (- ahd bld)))))))

;; Negation is exact in floating point (sign flip only, no rounding) — no
;; nudge needed, exact or not.
(define (ia-neg a) (ia-check "ia-neg" a) (cons (- (cdr a)) (- (car a))))

(define (ia* a b)
  (ia-check "ia*" a) (ia-check "ia*" b)
  (let ((al (car a)) (ah (cdr a)) (bl (car b)) (bh (cdr b)))
    (if (ia-all-exact4? al ah bl bh)
        (let ((p1 (* al bl)) (p2 (* al bh)) (p3 (* ah bl)) (p4 (* ah bh)))
          (cons (ia-min2 (ia-min2 p1 p2) (ia-min2 p3 p4))
                          (ia-max2 (ia-max2 p1 p2) (ia-max2 p3 p4))))
        (let* ((ald (exact->inexact al)) (ahd (exact->inexact ah))
               (bld (exact->inexact bl)) (bhd (exact->inexact bh))
               (p1 (* ald bld)) (p2 (* ald bhd)) (p3 (* ahd bld)) (p4 (* ahd bhd))
               (lo (ia-min2 (ia-min2 p1 p2) (ia-min2 p3 p4)))
               (hi (ia-max2 (ia-max2 p1 p2) (ia-max2 p3 p4))))
          ;; Each of p1..p4 individually carries <=0.5ulp round-to-nearest
          ;; error; nudging the SELECTED extremal candidate by one ulp in
          ;; its own direction is sound regardless of which one it was.
          (cons (fl-next-down lo) (fl-next-up hi))))))

;; ia/: SIGNALS AN ERROR if the denominator interval contains 0 (same
;; documented policy as core.ad.interval's interval-div).
(define (ia/ a b)
  (ia-check "ia/" a) (ia-check "ia/" b)
  (let ((bl (car b)) (bh (cdr b)))
    (if (and (<= bl 0) (>= bh 0))
        (error "ia/: denominator interval contains zero")
        (let ((al (car a)) (ah (cdr a)))
          (if (ia-all-exact4? al ah bl bh)
              (let ((q1 (/ al bl)) (q2 (/ al bh)) (q3 (/ ah bl)) (q4 (/ ah bh)))
                (cons (ia-min2 (ia-min2 q1 q2) (ia-min2 q3 q4))
                                (ia-max2 (ia-max2 q1 q2) (ia-max2 q3 q4))))
              (let* ((ald (exact->inexact al)) (ahd (exact->inexact ah))
                     (bld (exact->inexact bl)) (bhd (exact->inexact bh))
                     (q1 (/ ald bld)) (q2 (/ ald bhd)) (q3 (/ ahd bld)) (q4 (/ ahd bhd))
                     (lo (ia-min2 (ia-min2 q1 q2) (ia-min2 q3 q4)))
                     (hi (ia-max2 (ia-max2 q1 q2) (ia-max2 q3 q4))))
                (cons (fl-next-down lo) (fl-next-up hi))))))))

;; Multiply an interval by an exact integer/rational SCALAR k (both signs).
(define (ia-scale a k) (ia* a (ia-pt k)))

;; Horner evaluation of a polynomial (given as coefficients DESCENDING —
;; highest degree first) over an interval, using ia+/ia* above. Shared by
;; every Taylor-with-remainder function below. Deliberately placed AFTER
;; ia+/ia*/ia-/ia/: a function here that calls one of those defined LATER
;; in this same file is a genuine VM-only defect (a plain forward
;; reference, fine in every ordinary Scheme and fine in this compiler's
;; own native/JIT engine, but the VM's single-pass top-level compiler does
;; not resolve it -- "calling non-function" at the call site; verified by
;; isolating exactly this). Routed around by definition order, not fixed;
;; the domain-interval parameter is named `tv`, not the bare `t`, for the
;; same reason given on ia-ipow-exact above.
(define (ia-horner-desc coeffs-desc tv)
  (let loop ((cs (cdr coeffs-desc)) (acc (cons (car coeffs-desc) (car coeffs-desc))))
    (if (pair? cs)
        (loop (cdr cs) (ia+ (cons (car cs) (car cs)) (ia* acc tv)))
        acc)))

;; ── sqrt: certified bracketing (see header derivation note) ──────────────
(define ia-sqrt-max-iters 2000)

;; x=0 is a special case both certifiers must short-circuit, not search:
;; the ONLY g with g^2 on the correct side of 0 is g=0 itself (any
;; nonzero g's square is strictly positive), so the search step
;; `(fl-next-down 0.0)` produces a NEGATIVE denormal, whose OWN square
;; underflows back to exactly 0.0, and the walk oscillates between 0.0
;; and the smallest denormal forever -- it never converges, and used to
;; run out the iteration budget and error. sqrt(0)=0 exactly is also the
;; tightest possible answer, so this is a strict improvement, not just a
;; guard.
(define (ia-sqrt-lower-certify x)
  (if (<= x 0.0)
      0.0
      (let loop ((g (sqrt x)) (n 0))
        (cond ((> n ia-sqrt-max-iters) (error "ia-sqrt: failed to certify a lower bound"))
              ((<= (fl-next-up (* g g)) x) g)
              (else (loop (fl-next-down g) (+ n 1)))))))

(define (ia-sqrt-upper-certify x)
  (if (<= x 0.0)
      0.0
      (let loop ((g (sqrt x)) (n 0))
        (cond ((> n ia-sqrt-max-iters) (error "ia-sqrt: failed to certify an upper bound"))
              ((>= (fl-next-down (* g g)) x) g)
              (else (loop (fl-next-up g) (+ n 1)))))))

(define (ia-sqrt a)
  (ia-check "ia-sqrt" a)
  (let ((lo (car a)) (hi (cdr a)))
    (if (< lo 0)
        (error "ia-sqrt: domain requires interval lo >= 0")
        (cons (ia-sqrt-lower-certify (exact->inexact lo))
                        (ia-sqrt-upper-certify (exact->inexact hi))))))

;; ── exp: halving reduction + exact-rational Maclaurin + Lagrange remainder
(define ia-exp-r0 1/4)
(define ia-exp-r0-d 0.25)
(define ia-exp-order 10)          ; 11! = 39,916,800 -- nowhere near overflow

(define (ia-exp-coeffs-desc n)    ; (1/n! ... 1/1! 1) i.e. c_n .. c_0, c_i=1/i!
  (let loop ((i 0) (acc '()))
    (if (> i n) acc (loop (+ i 1) (cons (/ 1 (ia-fact i)) acc)))))

(define (ia-exp-reduced r)        ; r an interval with sup|r| <= ia-exp-r0
  (let* ((n ia-exp-order)
         (poly (ia-horner-desc (ia-exp-coeffs-desc n) r))
         (m (/ 4 3))                                    ; exact bound exp(t)<=1/(1-1/4)
         (bmag-exact (* m (/ (ia-ipow-exact ia-exp-r0 (+ n 1)) (ia-fact (+ n 1)))))
         (bmag (fl-next-up (exact->inexact bmag-exact))))
    (ia+ poly (cons (- bmag) bmag))))

(define (ia-exp-choose-k mag)     ; smallest k>=0 with mag/2^k <= R0 (heuristic only)
  (let loop ((k 0) (m mag))
    (if (or (<= m ia-exp-r0-d) (> k 1100)) k (loop (+ k 1) (/ m 2.0)))))

(define (ia-ipow a e)              ; interval a raised to nonneg integer e, via ia*
  (let loop ((n e) (acc (ia-pt 1)))
    (if (<= n 0) acc (loop (- n 1) (ia* acc a)))))

(define (ia-exp a)
  (ia-check "ia-exp" a)
  (let* ((mag (ia-mag a))
         (k (ia-exp-choose-k mag))
         (pow2k (ia-ipow-exact 2 k))
         (r (ia/ a (ia-pt pow2k))))
    (ia-ipow (ia-exp-reduced r) pow2k)))

;; ── log: power-of-two reduction to [2/3,4/3] + Mercator series + integral
;;    remainder bound; ln2 derived from the same machinery ────────────────
;; Order 16 gave a remainder ~2.3e-10 at the |u|=1/3 boundary -- nowhere
;; near tight enough for a 1e-12-width certified enclosure (log's
;; coefficients are 1/i, no factorial, so raising the order costs nothing
;; but Horner steps; 3^27 stays safely under int64 max, unlike a larger
;; jump). At order 26: (3/2)*(1/3)^27/27 ~= 7e-14, comfortably under 1e-12.
(define ia-log-order 26)

(define (ia-log-coeffs-desc n)    ; (c_n ... c_1 0), c_i = (-1)^(i+1)/i (log(1+u))
  (let loop ((i 1) (acc (list 0)))
    (if (> i n) acc
        (loop (+ i 1) (cons (if (odd? i) (/ 1 i) (/ -1 i)) acc)))))

;; Rigorous for any interval u with sup|u| <= 1/3 (errors otherwise — this
;; is the domain the integral remainder bound below actually proves).
(define (ia-log1p u)
  (let ((umag (ia-mag u)))
    (if (> umag (/ 1.0 3.0))
        (error "ia-log1p: |u| exceeds the certified reduction radius 1/3")
        (let* ((n ia-log-order)
               (poly (ia-horner-desc (ia-log-coeffs-desc n) u))
               (bmag-exact (* (/ 3 2) (/ (ia-ipow-exact 1/3 (+ n 1)) (+ n 1))))
               (bmag (fl-next-up (exact->inexact bmag-exact))))
          (ia+ poly (cons (- bmag) bmag))))))

;; ln2 = log(4/3) - log(2/3), both |u|=1/3 exactly: no extra machinery.
;; A memoized THUNK, not a plain top-level value: the VM compiles/executes
;; top-level module initializers in a pass that does not reliably resolve
;; a forward call from one top-level definition's OWN initializer
;; expression into another top-level function in this same file (the
;; native/JIT engine tolerates it; the VM does not -- verified against
;; this exact pattern, "calling non-function" at load time). Every
;; constant below derived by calling other functions in this file is
;; therefore a zero-argument function computed on first call and cached,
;; never a bare top-level `(define name (expr ...))`.
(define ia-ln2-cache #f)
(define (ia-ln2)
  (if ia-ln2-cache
      ia-ln2-cache
      (begin
        (set! ia-ln2-cache (ia- (ia-log1p (cons 1/3 1/3)) (ia-log1p (cons -1/3 -1/3))))
        ia-ln2-cache)))

(define (ia-pow2-exact k)         ; exact 2^k for any integer k (either sign)
  (if (>= k 0) (ia-ipow-exact 2 k) (/ 1 (ia-ipow-exact 2 (- k)))))

;; `ia-log-choose-k` below needs 2^k for a possibly-negative k
;; (`ia-ipow-double` only accepts e>=0), so this wraps the sign.
(define (ia-pow2-double k)
  (if (>= k 0) (ia-ipow-double 2.0 k) (/ 1.0 (ia-ipow-double 2.0 (- k)))))

;; heuristic only (parameter selection, not itself required to be sound —
;; see the module header): k such that midd/2^k in [2/3, 4/3].
(define (ia-log-choose-k midd)
  (let loop ((k (inexact->exact (round (/ (log midd) (log 2.0))))) (iters 0))
    (if (> iters 200)
        k
        (let ((r (/ midd (ia-pow2-double k))))
          (cond ((> r (/ 4.0 3.0)) (loop (+ k 1) (+ iters 1)))
                ((< r (/ 2.0 3.0)) (loop (- k 1) (+ iters 1)))
                (else k))))))

(define (ia-log a)
  (ia-check "ia-log" a)
  (let ((lo (car a)) (hi (cdr a)))
    (if (<= lo 0)
        (error "ia-log: argument interval reaches <= 0 (outside domain)")
        (let* ((midd (* 0.5 (+ (exact->inexact lo) (exact->inexact hi))))
               (k (ia-log-choose-k midd))
               (pow2k (ia-pow2-exact k))
               (m (ia/ a (ia-pt pow2k)))
               (u (ia- m (ia-pt 1))))
          (ia+ (ia-scale (ia-ln2) k) (ia-log1p u))))))

;; ── sin/cos: pi/2-quadrant reduction + zero-centered Maclaurin ───────────
(define ia-trig-order 16)         ; 17! = 3.556e14 -- safe

(define (ia-sin0-coeffs-desc n)
  (let loop ((i 0) (acc '()))
    (if (> i n) acc
        (loop (+ i 1)
              (cons (cond ((even? i) 0)
                          ((= (modulo i 4) 1) (/ 1 (ia-fact i)))
                          (else (/ -1 (ia-fact i))))
                    acc)))))
(define (ia-cos0-coeffs-desc n)
  (let loop ((i 0) (acc '()))
    (if (> i n) acc
        (loop (+ i 1)
              (cons (cond ((odd? i) 0)
                          ((= (modulo i 4) 0) (/ 1 (ia-fact i)))
                          (else (/ -1 (ia-fact i))))
                    acc)))))

(define (ia-trig-remainder-mag s)
  (let* ((smag (ia-mag s))
         (n ia-trig-order)
         (raw (/ (ia-ipow-double smag (+ n 1)) (exact->inexact (ia-fact (+ n 1))))))
    (fl-next-up raw)))

(define (ia-sin0 s)
  (let ((poly (ia-horner-desc (ia-sin0-coeffs-desc ia-trig-order) s))
        (b (ia-trig-remainder-mag s)))
    (ia+ poly (cons (- b) b))))
(define (ia-cos0 s)
  (let ((poly (ia-horner-desc (ia-cos0-coeffs-desc ia-trig-order) s))
        (b (ia-trig-remainder-mag s)))
    (ia+ poly (cons (- b) b))))

;; ── atan-core + Machin's formula give a rigorous pi BEFORE sin/cos need it
;; Order 21 gave a remainder ~5e-9 at the |u|=1/2 reduction boundary --
;; nowhere near tight enough. Gregory-Leibniz has no factorials (just
;; 1/i), so raising the order is free; at maxdeg 45, the next omitted
;; term is 0.5^47/47 ~= 1.5e-16, comfortably under 1e-12 even right at
;; the boundary.
(define ia-atan-core-maxdeg 45)

(define (ia-atan-coeffs-desc maxdeg)  ; (c_maxdeg ... c_1 0), c_i=(-1)^((i-1)/2)/i odd i
  (let loop ((i 0) (acc '()))
    (if (> i maxdeg) acc
        (loop (+ i 1)
              (cons (cond ((even? i) 0)
                          ((= (modulo i 4) 1) (/ 1 i))
                          (else (/ -1 i)))
                    acc)))))

;; Rigorous for any interval u with sup|u| <= 1 (alternating-series bound
;; needs strictly-decreasing term magnitudes, which holds up to |u|=1).
(define (ia-atan-core u)
  (let ((umag (ia-mag u)))
    (if (> umag 1.0)
        (error "ia-atan-core: |u| exceeds the certified radius 1")
        (let* ((maxdeg ia-atan-core-maxdeg)
               (poly (ia-horner-desc (ia-atan-coeffs-desc maxdeg) u))
               (nextdeg (+ maxdeg 2))
               (bmag (fl-next-up (/ (ia-ipow-double umag nextdeg) (exact->inexact nextdeg)))))
          (ia+ poly (cons (- bmag) bmag))))))

;; Machin's formula: pi = 16*atan(1/5) - 4*atan(1/239). Both arguments are
;; already << 1/2, so this calls ONLY ia-atan-core, never the general,
;; sqrt-reducing ia-atan below -- no circularity. Memoized thunk, not a
;; bare top-level value -- see ia-ln2's comment above (same VM constraint).
(define ia-pi-cache #f)
(define (ia-pi)
  (if ia-pi-cache
      ia-pi-cache
      (begin
        (set! ia-pi-cache
          (ia- (ia-scale (ia-atan-core (cons 1/5 1/5)) 16)
               (ia-scale (ia-atan-core (cons 1/239 1/239)) 4)))
        ia-pi-cache)))

(define ia-halfpi-cache #f)
(define (ia-halfpi)
  (if ia-halfpi-cache
      ia-halfpi-cache
      (begin (set! ia-halfpi-cache (ia/ (ia-pi) (ia-pt 2))) ia-halfpi-cache)))

;; ── general atan: half-angle sqrt-reduction (see header derivation) ──────
(define ia-atan-reduce-target 0.5)
(define ia-atan-max-depth 200)

(define (ia-atan-loop a depth)
  (let ((mag (ia-mag a)))
    (cond
      ((<= mag ia-atan-reduce-target) (ia-atan-core a))
      ((> depth ia-atan-max-depth) (error "ia-atan: reduction failed to converge"))
      (else
       (let* ((s (ia-sqrt (ia+ (ia* a a) (ia-pt 1))))
              (reduced (ia/ a (ia+ (ia-pt 1) s))))
         (ia-scale (ia-atan-loop reduced (+ depth 1)) 2))))))

;; A zero-straddling interval must be SPLIT at 0 before reduction, not
;; reduced whole: `(ia* a a)` on a mixed-sign interval hits the
;; dependency problem in its most destructive form -- for a=[-1,1] it
;; returns [-1,1] again (the TRUE range of x^2 is [0,1]), so
;; x/(1+sqrt(1+x^2)) does not actually shrink toward 0 at all and the
;; reduction loop either fails to converge or, worse, its accumulated
;; outward-rounding drift across up to `ia-atan-max-depth` failed
;; iterations can push (1+x^2)'s own lower endpoint fractionally below 0,
;; which `ia-sqrt` then (correctly) refuses -- both were real, reproduced
;; failures of the un-split version. Once split, each one-signed half has
;; lo>=0 (or hi<=0) throughout: `(ia* a a)` on a one-signed interval is
;; exact/tight (no dependency problem when both endpoints share a sign),
;; the reduction genuinely shrinks, and every subsequent reduced interval
;; provably stays on the same side of 0 (a/(1+sqrt(1+a^2)) is monotone
;; increasing and odd, positive denominator always), so a single split up
;; front is enough -- the loop never needs to re-check.
(define (ia-atan a)
  (ia-check "ia-atan" a)
  (let ((lo (car a)) (hi (cdr a)))
    (if (and (< lo 0) (> hi 0))
        (let ((neg (ia-atan-loop (cons lo 0) 0))
              (pos (ia-atan-loop (cons 0 hi) 0)))
          (cons (ia-min2 (car neg) (car pos)) (ia-max2 (cdr neg) (cdr pos))))
        (ia-atan-loop a 0))))

;; ── general sin/cos: reduce to one pi/2 quadrant, then zero-centered
;;    Maclaurin + quadrant sign/swap ────────────────────────────────────
(define (ia-trig-quadrant a)
  ;; Returns (values s qm4) conceptually; Eshkol core modules avoid
  ;; multiple-values plumbing here, so we return a pair (s . qm4).
  (let* ((midd (* 0.5 (+ (exact->inexact (car a)) (exact->inexact (cdr a)))))
         (halfpi-d 1.5707963267948966)
         (q (inexact->exact (round (/ midd halfpi-d))))
         (qhalfpi (ia-scale (ia-halfpi) q))
         (s (ia- a qhalfpi))
         (qm4 (modulo q 4)))
    (cons s qm4)))

(define (ia-sin a)
  (ia-check "ia-sin" a)
  (let* ((sq (ia-trig-quadrant a)) (s (car sq)) (qm4 (cdr sq)))
    (cond ((= qm4 0) (ia-sin0 s))
          ((= qm4 1) (ia-cos0 s))
          ((= qm4 2) (ia-neg (ia-sin0 s)))
          (else (ia-neg (ia-cos0 s))))))

(define (ia-cos a)
  (ia-check "ia-cos" a)
  (let* ((sq (ia-trig-quadrant a)) (s (car sq)) (qm4 (cdr sq)))
    (cond ((= qm4 0) (ia-cos0 s))
          ((= qm4 1) (ia-neg (ia-sin0 s)))
          ((= qm4 2) (ia-neg (ia-cos0 s)))
          (else (ia-sin0 s)))))
