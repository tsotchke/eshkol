;;; Persistent scalar DAG pullbacks. Local rules use the existing exact tape.
(require core.ad.algebraic_reverse)
(provide make-incremental-pullback incremental-pullback-step
         incremental-pullback-output incremental-pullback-work incremental-pullback-info)

(define (ipr-check-index i n)
  (if (not (and (integer? i) (exact? i) (>= i 0) (< i n)))
      (error "Incremental pullback index outside declared width")) i)
(define (ipr-copy-vector copy values)
  (list->vector (map copy (vector->list values))))
(define (ipr-evaluate owner description values)
  (let* ((kind (vector-ref description 0)) (parents (vector-ref description 1))
         (point (list->vector (map (lambda (i) (vector-ref values i)) parents)))
         (record (algebraic-value-and-pullback owner
           (lambda (tape inputs)
             (let ((a (vector-ref inputs 0)))
               (cond
                 ((eq? kind '+) (algebraic-reverse-add tape a (vector-ref inputs 1)))
                 ((eq? kind '-) (algebraic-reverse-sub tape a (vector-ref inputs 1)))
                 ((eq? kind '*) (algebraic-reverse-mul tape a (vector-ref inputs 1)))
                 (else (algebraic-reverse-inverse tape a))))) point)))
    (vector (vector-ref record 0) ((vector-ref record 1) 1))))
(define (ipr-compile domain inputs declarations outputs)
  (if (not (and (list? inputs) (> (length inputs) 0) (<= (length inputs) 64)
                (list? declarations) (<= (length declarations) 1024)
                (list? outputs) (> (length outputs) 0) (<= (length outputs) 64)))
      (error "Incremental pullback needs 1..64 inputs/outputs and at most 1024 operations"))
  (let ((names '()) (nodes '()) (count 0) (copy (algebraic-domain-ref domain 'copy)))
    (define (publish name node)
      (if (or (not (symbol? name)) (assq name names)) (error "DAG node names must be distinct symbols"))
      (set! names (cons (cons name count) names))
      (set! count (+ count 1)) (set! nodes (cons node nodes)))
    (define (resolve name)
      (let ((binding (assq name names)))
        (if binding (cdr binding) (error "DAG reference is not a preceding node" name))))
    (for-each (lambda (name) (publish name (vector 'input '() #f))) inputs)
    (for-each (lambda (declaration)
      (if (not (and (list? declaration) (>= (length declaration) 3))) (error "Malformed DAG declaration"))
      (let ((kind (car declaration)) (name (cadr declaration)) (args (cddr declaration)))
        (cond
          ((and (eq? kind 'constant) (= (length args) 1))
           (publish name (vector kind '() (copy (car args)))))
          ((or (and (memq kind '(+ - *)) (= (length args) 2))
               (and (eq? kind 'inverse) (= (length args) 1)))
           (publish name (vector kind (map resolve args) #f)))
          (else (error "Unsupported incremental pullback operation"))))) declarations)
    (let* ((nodes (list->vector (reverse nodes)))
           (children (make-vector count '()))
           (targets (list->vector (map resolve outputs))))
      (let loop ((i 0)) (if (< i count)
        (begin (for-each (lambda (p) (vector-set! children p (cons i (vector-ref children p))))
                 (vector-ref (vector-ref nodes i) 1)) (loop (+ i 1)))))
      (vector domain nodes children targets (length inputs)))))
(define (ipr-deltas domain changes width)
  (if (not (and (list? changes) (<= (length changes) 4096)))
      (error "Expected at most 4096 sparse change entries"))
  (let ((out '()) (copy (algebraic-domain-ref domain 'copy))
        (add (algebraic-domain-ref domain 'add)))
    (for-each (lambda (entry)
      (if (not (and (list? entry) (= (length entry) 2))) (error "Expected (index delta) change"))
      (let* ((i (ipr-check-index (car entry) width)) (value (copy (cadr entry))) (old (assv i out)))
        (if old (set! out (map (lambda (pair)
          (if (= (car pair) i) (cons i (add (cdr pair) value)) pair)) out))
          (set! out (cons (cons i value) out))))) changes) out))
(define (ipr-reverse! plan values partials adjoints contributions dirty)
  (let* ((domain (vector-ref plan 0)) (nodes (vector-ref plan 1))
         (add (algebraic-domain-ref domain 'add)) (sub (algebraic-domain-ref domain 'sub))
         (mul (algebraic-domain-ref domain 'mul)) (zero? (algebraic-domain-ref domain 'zero?))
         (operations 0) (changed-edges 0))
    (let reverse ((i (- (vector-length nodes) 1))) (if (>= i 0)
      (begin
        (if (and (vector-ref dirty i) (pair? (vector-ref (vector-ref nodes i) 1)))
          (let* ((parents (vector-ref (vector-ref nodes i) 1))
                 (old (vector-ref contributions i)) (local (vector-ref partials i))
                 (next (make-vector (length parents) #f)) (g (vector-ref adjoints i)))
            (set! operations (+ operations 1))
            (let edges ((rest parents) (k 0)) (if (pair? rest)
              (let* ((parent (car rest)) (value (mul g (vector-ref local k)))
                     (delta (sub value (vector-ref old k))))
                (vector-set! next k value)
                (if (not (zero? delta))
                  (begin (vector-set! adjoints parent (add (vector-ref adjoints parent) delta))
                         (vector-set! dirty parent #t) (set! changed-edges (+ changed-edges 1))))
                (edges (cdr rest) (+ k 1)))))
            (vector-set! contributions i next)))
        (reverse (- i 1)))))
    (vector operations changed-edges)))
;; Private arrays never escape. Successors share immutable coefficient values;
;; observers copy them using the same declared owner as the existing recorder.
(define (ipr-state plan values partials adjoints contributions seeds work)
  (let* ((domain (vector-ref plan 0)) (copy (algebraic-domain-ref domain 'copy))
         (targets (vector-ref plan 3)) (width (vector-ref plan 4)) (n (vector-length values)))
    (lambda (action changes seed-changes)
      (cond
        ((eq? action 'output)
         (vector (list->vector (map (lambda (i) (copy (vector-ref values i))) (vector->list targets)))
           (list->vector (map (lambda (i) (copy (vector-ref adjoints i))) (iota width)))))
        ((eq? action 'work) (vector-copy work))
        ((eq? action 'info) (vector width n (vector-length targets)))
        ((eq? action 'step)
         (let* ((add (algebraic-domain-ref domain 'add)) (sub (algebraic-domain-ref domain 'sub))
                (same? (algebraic-domain-ref domain 'equal?)) (zero? (algebraic-domain-ref domain 'zero?))
                (input-deltas (ipr-deltas domain changes width))
                (seed-deltas (ipr-deltas domain seed-changes (vector-length targets)))
                (new-values (vector-copy values)) (new-partials (vector-copy partials))
                (new-adjoints (vector-copy adjoints)) (new-contributions (vector-copy contributions))
                (new-seeds (vector-copy seeds)) (forward-dirty (make-vector n #f))
                (reverse-dirty (make-vector n #f)) (forward-operations 0)
                (children (vector-ref plan 2)) (nodes (vector-ref plan 1)))
           (for-each (lambda (entry)
             (let ((i (car entry)) (delta (cdr entry)))
               (if (not (zero? delta))
                 (begin (vector-set! new-values i (add (vector-ref values i) delta))
                   (for-each (lambda (child) (vector-set! forward-dirty child #t)) (vector-ref children i)))))) input-deltas)
           (let forward ((i width)) (if (< i n)
             (begin
               (if (vector-ref forward-dirty i)
                 (let* ((record (ipr-evaluate (algebraic-domain-ref domain 'owner) (vector-ref nodes i) new-values))
                        (value (vector-ref record 0)))
                   (set! forward-operations (+ forward-operations 1))
                   (vector-set! new-values i value) (vector-set! new-partials i (vector-ref record 1))
                   (vector-set! reverse-dirty i #t)
                   (if (not (same? value (vector-ref values i)))
                     (for-each (lambda (child) (vector-set! forward-dirty child #t)) (vector-ref children i)))))
               (forward (+ i 1)))))
           (for-each (lambda (entry)
             (let* ((i (car entry)) (delta (cdr entry)) (target (vector-ref targets i)))
               (if (not (zero? delta))
                 (begin (vector-set! new-seeds i (add (vector-ref seeds i) delta))
                   (vector-set! new-adjoints target (add (vector-ref new-adjoints target) delta))
                   (vector-set! reverse-dirty target #t))))) seed-deltas)
           (let* ((reverse-work (ipr-reverse! plan new-values new-partials new-adjoints new-contributions reverse-dirty))
                  (receipt (vector forward-operations (vector-ref reverse-work 0) (vector-ref reverse-work 1)
                    (+ (* 6 n) (vector-length seeds)) (* 2 n)))
                  (next (ipr-state plan new-values new-partials new-adjoints new-contributions new-seeds receipt))
                  (value-change (list->vector (map (lambda (i)
                    (sub (vector-ref new-values i) (vector-ref values i))) (vector->list targets))))
                  (gradient-change (list->vector (map (lambda (i)
                    (sub (vector-ref new-adjoints i) (vector-ref adjoints i))) (iota width)))))
             (vector next value-change gradient-change (vector-copy receipt)))))
        (else (error "Unknown incremental pullback action"))))))
(define (make-incremental-pullback owner inputs declarations outputs point seeds)
  (let* ((domain (algebraic-domain owner)) (plan (ipr-compile domain inputs declarations outputs))
         (nodes (vector-ref plan 1)) (n (vector-length nodes)) (width (vector-ref plan 4))
         (targets (vector-ref plan 3)) (copy (algebraic-domain-ref domain 'copy))
         (add (algebraic-domain-ref domain 'add)) (zero (algebraic-domain-ref domain 'zero)))
    (if (not (and (vector? point) (= (vector-length point) width)
                  (vector? seeds) (= (vector-length seeds) (vector-length targets))))
        (error "Initial point or seed width mismatch"))
    (let ((values (make-vector n #f)) (partials (make-vector n #f))
          (adjoints (make-vector n zero)) (contributions (make-vector n #f))
          (seeds (ipr-copy-vector copy seeds)) (operations 0))
      (let loop ((i 0)) (if (< i n)
        (let ((description (vector-ref nodes i)))
          (cond
            ((< i width) (vector-set! values i (copy (vector-ref point i))))
            ((eq? (vector-ref description 0) 'constant) (vector-set! values i (copy (vector-ref description 2))))
            (else (let ((record (ipr-evaluate owner description values)))
              (vector-set! values i (vector-ref record 0)) (vector-set! partials i (vector-ref record 1))
              (set! operations (+ operations 1)))))
          (vector-set! contributions i (make-vector (length (vector-ref description 1)) zero))
          (loop (+ i 1)))))
      (let seed ((i 0)) (if (< i (vector-length targets))
        (let ((target (vector-ref targets i)))
          (vector-set! adjoints target (add (vector-ref adjoints target) (vector-ref seeds i)))
          (seed (+ i 1)))))
      (let ((rw (ipr-reverse! plan values partials adjoints contributions (make-vector n #t))))
        (ipr-state plan values partials adjoints contributions seeds
          (vector operations (vector-ref rw 0) (vector-ref rw 1) 0 (* 2 n)))))))
(define (incremental-pullback-step state changes seed-changes) (state 'step changes seed-changes))
(define (incremental-pullback-output state) (state 'output #f #f))
(define (incremental-pullback-work state) (state 'work #f #f))
(define (incremental-pullback-info state) (state 'info #f #f))
