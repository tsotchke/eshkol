;;; Exact finite AD carriers over an explicitly selected core.algebraic_field.
(require core.algebraic_field)
(provide make-algebraic-taylor make-algebraic-hyperdual algebraic-ad-value
         algebraic-ad-constant algebraic-ad-seed algebraic-ad-coefficients
         algebraic-ad-add algebraic-ad-sub algebraic-ad-mul algebraic-ad-inverse
         algebraic-ad-equal? algebraic-ad-derivative algebraic-ad-root
         algebraic-ad-context call-with-algebraic-derivative)

;; Contexts/values are immutable by contract. Context identity distinguishes
;; perturbations; fields retain their existing explicit identity/transport rule.
(define (aa-context context)
  (if (not (and (vector? context) (= (vector-length context) 5)
                (eq? (vector-ref context 0) 'algebraic-ad-context-v1)))
      (error "Expected an algebraic AD context")) context)
(define (aa-dimension context) (vector-ref (aa-context context) 4))
(define (aa-context? value)
  (and (vector? value) (= (vector-length value) 5)
       (eq? (vector-ref value 0) 'algebraic-ad-context-v1)))
(define (aa-value? value)
  (and (vector? value) (= (vector-length value) 3)
       (eq? (vector-ref value 0) 'algebraic-ad-value-v1)))
(define (aa-depth domain)
  (if (aa-context? domain) (+ 1 (aa-depth (vector-ref (aa-context domain) 1)))
      (begin (algebraic-field-degree domain) 0)))
(define (aa-domain-check domain)
  (if (>= (aa-depth domain) 3) (error "Algebraic AD supports at most three perturbation levels")))
(define (make-algebraic-taylor domain order)
  (aa-domain-check domain)
  (if (not (and (integer? order) (exact? order) (>= order 0) (<= order 16)))
      (error "Algebraic Taylor order must be an exact integer from 0 through 16"))
  (vector 'algebraic-ad-context-v1 domain 'taylor order (+ order 1)))
(define (make-algebraic-hyperdual domain)
  (aa-domain-check domain)
  (vector 'algebraic-ad-context-v1 domain 'hyperdual 2 4))
(define (aa-coefficient context value)
  (let ((domain (vector-ref (aa-context context) 1)))
    (if (aa-context? domain)
        ;; Only the declared enclosing chain is a coefficient domain. Peers
        ;; and siblings eventually reach the field boundary and refuse.
        (if (and (aa-value? value) (eq? (aa-owner value) domain))
            (algebraic-ad-value domain (aa-cells value))
            (algebraic-ad-constant domain value))
        (if (and (rational? value) (exact? value)) (algebraic-element domain value)
            (let ((owned (algebraic-element domain (algebraic-coefficients value))))
              (algebraic-equal? value owned) owned)))))
(define (aa-cadd context a b)
  (if (aa-context? (vector-ref context 1)) (algebraic-ad-add a b) (algebraic-add a b)))
(define (aa-csub context a b)
  (if (aa-context? (vector-ref context 1)) (algebraic-ad-sub a b) (algebraic-sub a b)))
(define (aa-cmul context a b)
  (if (aa-context? (vector-ref context 1)) (algebraic-ad-mul a b) (algebraic-mul a b)))
(define (aa-cinverse context a)
  (if (aa-context? (vector-ref context 1)) (algebraic-ad-inverse a) (algebraic-inverse a)))
(define (aa-cequal? context a b)
  (if (aa-context? (vector-ref context 1)) (algebraic-ad-equal? a b) (algebraic-equal? a b)))
(define (aa-czero? context a)
  (if (aa-context? (vector-ref context 1)) (aa-value-zero? a) (algebraic-zero? a)))
(define (aa-cscale context a factor)
  (if (aa-context? (vector-ref context 1))
      (algebraic-ad-mul a (algebraic-ad-constant (vector-ref context 1) factor))
      (algebraic-scale a factor)))
(define (aa-zero-vector context)
  (list->vector (map (lambda (unused) (aa-coefficient context 0))
                    (vector->list (make-vector (aa-dimension context) 0)))))
(define (aa-wrap context coefficients) (vector 'algebraic-ad-value-v1 context coefficients))
(define (aa-check value)
  (if (not (and (vector? value) (= (vector-length value) 3)
                (eq? (vector-ref value 0) 'algebraic-ad-value-v1)
                (vector? (vector-ref value 2))
                (= (vector-length (vector-ref value 2)) (aa-dimension (vector-ref value 1)))))
      (error "Expected an algebraic AD value")) value)
(define (aa-owner value) (vector-ref (aa-check value) 1))
(define (algebraic-ad-context value) (aa-owner value))
(define (aa-cells value) (vector-ref (aa-check value) 2))
(define (aa-value-zero? value)
  (let ((context (aa-owner value)) (cells (aa-cells value)))
    (let loop ((i 0)) (or (= i (vector-length cells))
      (and (aa-czero? context (vector-ref cells i)) (loop (+ i 1)))))))
(define (aa-same a b)
  (let ((context (aa-owner a)))
    (if (not (eq? context (aa-owner b))) (error "Unrelated algebraic AD perturbations")) context))
(define (algebraic-ad-value context coefficients)
  (let ((values (cond ((vector? coefficients) (vector->list coefficients))
                      ((list? coefficients) coefficients)
                      (else (error "Expected an AD coefficient list or vector")))))
    (if (not (= (length values) (aa-dimension context))) (error "AD coefficient count mismatch"))
    (aa-wrap context (list->vector (map (lambda (x) (aa-coefficient context x)) values)))))
(define (algebraic-ad-constant context value)
  (let ((out (aa-zero-vector context)))
    (vector-set! out 0 (aa-coefficient context value)) (aa-wrap context out)))
(define (algebraic-ad-seed context point)
  (let ((out (aa-zero-vector context)))
    (vector-set! out 0 (aa-coefficient context point))
    (if (> (vector-length out) 1) (vector-set! out 1 (aa-coefficient context 1)))
    (if (eq? (vector-ref context 2) 'hyperdual) (vector-set! out 2 (aa-coefficient context 1)))
    (aa-wrap context out)))
(define (algebraic-ad-coefficients value)
  (let ((context (aa-owner value)))
    (list->vector (map (lambda (x) (aa-coefficient context x)) (vector->list (aa-cells value))))))
(define (aa-combine a b operation)
  (let* ((context (aa-same a b)) (left (aa-cells a)) (right (aa-cells b))
         (out (aa-zero-vector context)))
    (let cells ((i 0))
      (if (< i (vector-length out))
          (begin (vector-set! out i (operation context (vector-ref left i) (vector-ref right i)))
                 (cells (+ i 1))))) (aa-wrap context out)))
(define (algebraic-ad-add a b) (aa-combine a b aa-cadd))
(define (algebraic-ad-sub a b) (aa-combine a b aa-csub))
;; Taylor basis t^i, or hyperdual basis (1,e1,e2,e1*e2), e1^2=e2^2=0.
(define (aa-product-index context i j)
  (if (eq? (vector-ref context 2) 'taylor)
      (if (< (+ i j) (aa-dimension context)) (+ i j) #f)
      (cond ((= i 0) j) ((= j 0) i) ((= (+ i j) 3) 3) (else #f))))
(define (algebraic-ad-mul a b)
  (let* ((context (aa-same a b)) (left (aa-cells a)) (right (aa-cells b))
         (n (aa-dimension context)) (out (aa-zero-vector context)))
    (let rows ((i 0))
      (if (< i n)
          (begin
            (let columns ((j 0))
              (if (< j n)
                  (let ((k (aa-product-index context i j)))
                    (if (and k (not (aa-czero? context (vector-ref left i)))
                               (not (aa-czero? context (vector-ref right j))))
                        (vector-set! out k (aa-cadd context (vector-ref out k)
                          (aa-cmul context (vector-ref left i) (vector-ref right j)))))
                    (columns (+ j 1)))))
            (rows (+ i 1))))) (aa-wrap context out)))
(define (algebraic-ad-equal? a b)
  (let ((context (aa-same a b)) (left (aa-cells a)) (right (aa-cells b)))
    (let cells ((i 0)) (or (= i (vector-length left))
      (and (aa-cequal? context (vector-ref left i) (vector-ref right i)) (cells (+ i 1)))))))
(define (aa-nilpotence context)
  (if (eq? (vector-ref context 2) 'taylor) (aa-dimension context) 3))
(define (algebraic-ad-inverse value)
  (let* ((context (aa-owner value)) (one (algebraic-ad-constant context 1))
         (zero (algebraic-ad-constant context 0)) (primal (vector-ref (aa-cells value) 0))
         (scale (algebraic-ad-constant context (aa-cinverse context primal)))
         (tail (algebraic-ad-sub value (algebraic-ad-constant context primal)))
         (ratio (algebraic-ad-sub zero (algebraic-ad-mul tail scale))))
    ;; The finite geometric series terminates at the declared nilpotence bound.
    (let series ((k 1) (term one) (sum one))
      (if (= k (aa-nilpotence context))
          (let ((out (algebraic-ad-mul scale sum)))
            (if (not (algebraic-ad-equal? (algebraic-ad-mul value out) one))
                (error "AD inverse failed its exact residual")) out)
          (let ((next (algebraic-ad-mul term ratio)))
            (series (+ k 1) next (algebraic-ad-add sum next)))))))
(define (algebraic-ad-derivative value order)
  (let ((context (aa-owner value)))
    (if (not (and (eq? (vector-ref context 2) 'taylor) (integer? order) (exact? order)
                  (>= order 0) (< order (aa-dimension context))))
        (error "Derivative order is outside this Taylor carrier"))
    (let factorial ((i 1) (factor 1))
      (if (> i order) (aa-cscale context (vector-ref (aa-cells value) order) factor)
          (factorial (+ i 1) (* factor i))))))
(define (aa-lift context value)
  (if (aa-value? value)
      (begin (aa-check value)
        (if (eq? context (aa-owner value)) value (algebraic-ad-constant context value)))
      (algebraic-ad-constant context value)))
;; Horner evaluates p and its y derivative from the same ascending coefficients.
(define (aa-polynomial coefficients y)
  (let ((zero (algebraic-ad-constant (aa-owner y) 0)))
    (let horner ((rest (reverse coefficients)) (value zero) (derivative zero))
      (if (null? rest) (cons value derivative)
          (horner (cdr rest) (algebraic-ad-add (algebraic-ad-mul value y) (car rest))
            (algebraic-ad-add (algebraic-ad-mul derivative y) value))))))
(define (algebraic-ad-root context coefficients root)
  (aa-context context)
  (if (not (and (list? coefficients) (>= (length coefficients) 2) (<= (length coefficients) 33)))
      (error "Root lift requires a polynomial of degree 1 through 32"))
  (let* ((owned (map (lambda (x) (aa-lift context x)) coefficients))
         (initial (algebraic-ad-constant context root)) (zero (algebraic-ad-constant context 0))
         (base (aa-polynomial owned initial)))
    (if (not (aa-czero? context (vector-ref (aa-cells (car base)) 0)))
        (error "Supplied root does not satisfy the primal polynomial"))
    ;; Nonzero is insufficient over an enclosing nilpotent ring: require a
    ;; certified unit even when the supplied root's full residual is zero.
    (aa-cinverse context (vector-ref (aa-cells (cdr base)) 0))
    ;; Nilpotent Newton starts on the supplied branch. Return only after the
    ;; entire retained polynomial residual vanishes, never only its primal.
    (let newton ((y initial) (remaining (aa-nilpotence context)))
      (let* ((evaluation (aa-polynomial owned y)) (residual (car evaluation)))
        (cond ((algebraic-ad-equal? residual zero) y)
              ((= remaining 0) (error "Root lift did not reach an exact zero residual"))
              (else (newton (algebraic-ad-sub y
                (algebraic-ad-mul residual (algebraic-ad-inverse (cdr evaluation)))) (- remaining 1))))))))

;; A fresh lexical scope, with no implicit global perturbation state. Captured
;; enclosing values enter through LIFT; constants still undergo domain checks.
(define (call-with-algebraic-derivative domain function point order)
  (if (not (procedure? function)) (error "Expected an algebraic differentiand"))
  (let* ((context (make-algebraic-taylor domain order)) (seed (algebraic-ad-seed context point))
         (result (function seed (lambda (value) (algebraic-ad-constant context value)))))
    (algebraic-ad-derivative
      (if (and (aa-value? result) (eq? (aa-owner result) context)) result
          (algebraic-ad-constant context result)) order)))
