;;; Live exact ridge fits: one signed moment state and one checked normal LU.
(require core.ad.algebraic_incremental)
(require core.ad.algebraic_pullback)
(provide algebraic-ridge-new algebraic-ridge-step algebraic-ridge-output
         algebraic-ridge-info algebraic-ridge-pullback)

(define (arg-state state)
  (if (not (and (vector? state) (= (vector-length state) 7) (eq? (vector-ref state 0) 'algebraic-ridge-v1)))
      (error "Expected a live exact ridge snapshot")) state)
(define (arg-vector domain values)
  (list->vector (map (algebraic-domain-ref domain 'copy) (vector->list values))))
(define (arg-primal domain value)
  (let ((parent (algebraic-domain-ref domain 'parent)))
    (if parent (arg-primal parent (vector-ref ((algebraic-domain-ref domain 'coefficients) value) 0)) value)))
(define (arg-lambda domain value)
  (let ((value ((algebraic-domain-ref domain 'copy) value)))
    (if (< (algebraic-sign (arg-primal domain value)) 0) (error "Ridge regularization must have a nonnegative primal")) value))
(define (arg-powers dimension i j)
  (let ((powers (make-vector (+ dimension 1) 0)))
    (if (>= i 0) (vector-set! powers i (+ 1 (vector-ref powers i))))
    (if (>= j 0) (vector-set! powers j (+ 1 (vector-ref powers j)))) powers))
(define (arg-fit domain dimension moments regularization)
  (let ((matrix (make-vector dimension #f)) (rhs (make-vector dimension #f))
        (add (algebraic-domain-ref domain 'add)) (sub (algebraic-domain-ref domain 'sub))
        (mul (algebraic-domain-ref domain 'mul)) (zero (algebraic-domain-ref domain 'zero)))
    (let rows ((i 0)) (if (< i dimension)
      (let ((row (make-vector dimension #f)))
        (let cols ((j 0)) (if (< j dimension)
          (let ((value (algebraic-incremental-moment-ref moments (arg-powers dimension i j))))
            (vector-set! row j (if (= i j) (add value regularization) value)) (cols (+ j 1)))))
        (vector-set! matrix i row)
        (vector-set! rhs i (algebraic-incremental-moment-ref moments (arg-powers dimension i dimension)))
        (rows (+ i 1)))))
    (let* ((factor (algebraic-factor (algebraic-domain-ref domain 'owner) matrix))
           (admitted (if (algebraic-factor-positive-definite? factor) #t
             (error "Ridge normal matrix is not positive definite")))
           (record (algebraic-factor-with-pullback factor rhs)) (beta (vector-ref record 0))
           (negative (list->vector (map (lambda (x) (sub zero x)) (vector->list beta))))
           (derivative (algebraic-factor-solve factor negative))
           (constant (algebraic-incremental-moment-ref moments (arg-powers dimension dimension dimension)))
           (objective (let dot ((i 0) (out constant))
             (if (= i dimension) out (dot (+ i 1) (sub out (mul (vector-ref rhs i) (vector-ref beta i))))))))
      (vector (vector beta derivative objective) (vector-ref record 1)))))
(define (algebraic-ridge-new owner dimension regularization . initial)
  (if (not (and (integer? dimension) (exact? dimension) (>= dimension 1) (<= dimension 7) (<= (length initial) 1)))
      (error "Live ridge dimension must be in 1 through 7 with at most one initial Z-set"))
  (let* ((domain (algebraic-domain owner)) (regularization (arg-lambda domain regularization)) (terms '()))
    (let rows ((i 0)) (if (< i dimension)
      (begin (let cols ((j i)) (if (< j dimension)
        (begin (set! terms (cons (list '* (list 'row i) (list 'row j)) terms)) (cols (+ j 1)))))
        (set! terms (cons (list '* (list 'row i) (list 'row dimension)) terms)) (rows (+ i 1)))))
    (set! terms (cons (list 'pow (list 'row dimension) 2) (cons 1 terms)))
    (let* ((plan (make-algebraic-incremental-plan owner (+ dimension 1) 0 (cons '+ terms)))
           (moments (if (null? initial) (algebraic-incremental-new plan (vector))
             (algebraic-incremental-new plan (vector) (car initial))))
           (fit (arg-fit domain dimension moments regularization)))
      (vector 'algebraic-ridge-v1 domain dimension moments regularization (vector-ref fit 0) (vector-ref fit 1)))))
(define (algebraic-ridge-output state)
  (arg-state state)
  (let ((domain (vector-ref state 1)) (output (vector-ref state 5)))
    (vector (arg-vector domain (vector-ref output 0)) (arg-vector domain (vector-ref output 1))
            ((algebraic-domain-ref domain 'copy) (vector-ref output 2)))))
(define (algebraic-ridge-info state)
  (arg-state state)
  (vector (vector-ref state 2) (vector-ref (algebraic-incremental-info (vector-ref state 3)) 3)
          ((algebraic-domain-ref (vector-ref state 1) 'copy) (vector-ref state 4)) 1))
(define (algebraic-ridge-step state row-delta regularization-delta)
  (arg-state state)
  (let* ((domain (vector-ref state 1)) (dimension (vector-ref state 2))
         (regularization (arg-lambda domain ((algebraic-domain-ref domain 'add) (vector-ref state 4) regularization-delta)))
         (step (algebraic-incremental-step (vector-ref state 3) row-delta (vector)))
         (moments (vector-ref step 0)) (fit (arg-fit domain dimension moments regularization))
         (next (vector 'algebraic-ridge-v1 domain dimension moments regularization (vector-ref fit 0) (vector-ref fit 1)))
         (before (vector-ref (vector-ref state 5) 0)) (after (vector-ref (vector-ref fit 0) 0))
         (sub (algebraic-domain-ref domain 'sub)) (delta (make-vector dimension #f)))
    (let loop ((i 0)) (if (< i dimension)
      (begin (vector-set! delta i (sub (vector-ref after i) (vector-ref before i))) (loop (+ i 1)))))
    (vector next delta (vector 'ridge-moments-v1 (vector-ref (vector-ref step 2) 1)
      (vector-ref (vector-ref step 2) 2) dimension 1))))
(define (algebraic-ridge-pullback state seed)
  (arg-state state)
  (let* ((domain (vector-ref state 1)) (bars ((vector-ref state 6) seed))
         (matrix-bar (vector-ref bars 0)) (add (algebraic-domain-ref domain 'add))
         (lambda-bar (let trace ((i 0) (out (algebraic-domain-ref domain 'zero)))
           (if (= i (vector-ref state 2)) out
             (trace (+ i 1) (add out (vector-ref (vector-ref matrix-bar i) i)))))))
    (vector matrix-bar (vector-ref bars 1) lambda-bar)))
