;;; Bounded polynomial systems: a supplied branch, a derived Jacobian and a
;;; single primal factorization. No user Jacobian or extra perturbation level.
(require core.algebraic_linalg)
(provide algebraic-ad-system-root algebraic-ad-system-residual algebraic-system-linearization)

(define (ais-pow domain value exponent)
  (let ((mul (algebraic-domain-ref domain 'mul)))
    (let loop ((k exponent) (out (algebraic-domain-ref domain 'one)))
      (if (= k 0) out (loop (- k 1) (mul out value))))))
(define (ais-equations domain equations n)
  (if (not (and (vector? equations) (= (vector-length equations) n)))
      (error "Expected one polynomial equation per unknown"))
  (let ((copy (algebraic-domain-ref domain 'copy)) (owned (make-vector n #f)))
    (let rows ((i 0)) (if (< i n)
      (let ((terms (vector-ref equations i)))
        (if (not (and (list? terms) (<= (length terms) 64)))
            (error "Each equation admits at most 64 polynomial terms"))
        (vector-set! owned i
          (map (lambda (term)
            (if (not (and (list? term) (= (length term) 2)))
                (error "Expected (coefficient exponent-vector) polynomial term"))
            (let ((powers (cadr term)))
              (if (not (and (vector? powers) (= (vector-length powers) n)))
                  (error "Polynomial exponent dimension mismatch"))
              (let loop ((j 0) (degree 0))
                (if (= j n)
                    (if (> degree 16) (error "Polynomial system degree exceeds 16"))
                    (let ((power (vector-ref powers j)))
                      (if (not (and (integer? power) (exact? power) (>= power 0) (<= power 16)))
                          (error "Expected bounded nonnegative exact exponent"))
                      (loop (+ j 1) (+ degree power)))))
              (list (copy (car term)) (vector-copy powers)))) terms))
        (rows (+ i 1))))) owned))
(define (ais-evaluate domain equations values derivative)
  (let* ((n (vector-length values)) (out (make-vector n #f))
         (mul (algebraic-domain-ref domain 'mul)) (add (algebraic-domain-ref domain 'add)))
    (let equations-loop ((i 0)) (if (< i n)
      (begin (vector-set! out i
        (let terms ((rest (vector-ref equations i)) (sum (algebraic-domain-ref domain 'zero)))
          (if (null? rest) sum
            (let* ((term (car rest)) (powers (cadr term))
                   (factor (if (< derivative 0) 1 (vector-ref powers derivative))))
              (terms (cdr rest) (if (= factor 0) sum
                (add sum (let variables ((j 0) (product (mul (car term) factor)))
                  (if (= j n) product
                    (variables (+ j 1) (mul product (ais-pow domain (vector-ref values j)
                      (- (vector-ref powers j) (if (= j derivative) 1 0))))))))))))))
        (equations-loop (+ i 1))))) out))
(define (ais-values domain values)
  (if (not (and (vector? values) (> (vector-length values) 0) (<= (vector-length values) 8)))
      (error "Polynomial systems admit 1 through 8 unknowns"))
  (let ((copy (algebraic-domain-ref domain 'copy)))
    (list->vector (map copy (vector->list values)))))
(define (algebraic-ad-system-residual context equations values)
  (let* ((domain (algebraic-domain context)) (values (ais-values domain values)))
    (if (not (algebraic-domain-ref domain 'parent)) (error "Expected an AD context for system lifting"))
    (ais-evaluate domain (ais-equations domain equations (vector-length values)) values -1)))
(define (ais-zero? domain values)
  (let ((zero? (algebraic-domain-ref domain 'zero?)))
    (let loop ((i 0)) (or (= i (vector-length values))
      (and (zero? (vector-ref values i)) (loop (+ i 1)))))))
(define (algebraic-ad-system-root context equations roots . options)
  (let* ((domain (algebraic-domain context)) (parent (algebraic-domain-ref domain 'parent)))
    (if (not parent) (error "Expected an AD context for system lifting"))
    (let* ((roots (ais-values parent roots)) (n (vector-length roots))
           (equations (ais-equations domain equations n))
           (dimension (algebraic-domain-ref domain 'dimension))
           (budget (if (null? options)
             (if (eq? (algebraic-domain-ref domain 'kind) 'taylor) dimension 3) (car options)))
           (initial (list->vector (map (lambda (root) (algebraic-ad-constant context root)) (vector->list roots))))
           (observe (algebraic-domain-ref domain 'coefficients))
           (base-residual (ais-evaluate domain equations initial -1))
           (jacobian (make-vector n #f)))
      (if (not (and (<= (length options) 1) (integer? budget) (exact? budget) (>= budget 0) (<= budget 32)))
          (error "Invalid exact implicit-system iteration budget"))
      (let rows ((i 0)) (if (< i n)
        (begin (if (not ((algebraic-domain-ref parent 'zero?) (vector-ref (observe (vector-ref base-residual i)) 0)))
          (error "Supplied branch fails an enclosing primal equation"))
          (vector-set! jacobian i (make-vector n #f)) (rows (+ i 1)))))
      ;; Formal polynomial differentiation derives every Jacobian entry.
      (let columns ((j 0)) (if (< j n)
        (let ((column (ais-evaluate domain equations initial j)))
          (let rows ((i 0)) (if (< i n)
            (begin (vector-set! (vector-ref jacobian i) j (vector-ref (observe (vector-ref column i)) 0))
                   (rows (+ i 1))))) (columns (+ j 1)))))
      ;; Factor even an already-zero residual: a singular branch is not simple.
      (let ((factor (algebraic-factor (algebraic-domain-ref parent 'owner) jacobian))
            (sub (algebraic-domain-ref domain 'sub)))
        (let iterate ((values initial) (remaining budget))
          (let ((residual (ais-evaluate domain equations values -1)))
            (cond ((ais-zero? domain residual) values)
                  ((= remaining 0) (error "Implicit system did not reach an exact vector residual"))
                  (else
                    (let ((corrections (make-vector dimension #f)) (next (make-vector n #f)))
                      (let coefficients ((k 0)) (if (< k dimension)
                        (let ((rhs (make-vector n #f)))
                          (let rows ((i 0)) (if (< i n)
                            (begin (vector-set! rhs i (vector-ref (observe (vector-ref residual i)) k)) (rows (+ i 1)))))
                          (vector-set! corrections k (algebraic-factor-solve factor rhs)) (coefficients (+ k 1)))))
                      (let rows ((i 0)) (if (< i n)
                        (let ((cells (make-vector dimension #f)))
                          (let coefficients ((k 0)) (if (< k dimension)
                            (begin (vector-set! cells k (vector-ref (vector-ref corrections k) i)) (coefficients (+ k 1)))))
                          (vector-set! next i (sub (vector-ref values i) (algebraic-ad-value context cells)))
                          (rows (+ i 1)))))
                      (iterate next (- remaining 1)))))))))))

;;; Shared formal linearization, including coefficient sensitivities.
(define (algebraic-system-linearization owner equations values)
  (let* ((domain (algebraic-domain owner)) (values (ais-values domain values)) (n (vector-length values))
         (equations (ais-equations domain equations n)) (jacobian (make-vector n #f))
         (monomials (make-vector n #f)) (mul (algebraic-domain-ref domain 'mul)))
    (let rows ((i 0)) (if (< i n)
      (begin (vector-set! jacobian i (make-vector n #f))
        (vector-set! monomials i (map (lambda (term)
          (let variables ((j 0) (out (algebraic-domain-ref domain 'one)))
            (if (= j n) out (variables (+ j 1) (mul out (ais-pow domain
              (vector-ref values j) (vector-ref (cadr term) j))))))) (vector-ref equations i)))
        (rows (+ i 1)))))
    (let columns ((j 0)) (if (< j n)
      (let ((column (ais-evaluate domain equations values j)))
        (let rows ((i 0)) (if (< i n)
          (begin (vector-set! (vector-ref jacobian i) j (vector-ref column i)) (rows (+ i 1)))))
        (columns (+ j 1)))))
    (vector (ais-evaluate domain equations values -1) jacobian monomials)))
