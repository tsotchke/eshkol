;;; Small strictly convex QPs, exact KKT certificates and stable-set pullbacks.
(require core.algebraic_linalg)
(provide algebraic-qp-solve algebraic-qp-solution algebraic-qp-info
         algebraic-qp-verify algebraic-qp-pullback)

(define (aq-vector d xs n)
  (if (not (and (vector? xs) (= (vector-length xs) n))) (error "QP vector dimension mismatch"))
  (list->vector (map (algebraic-domain-ref d 'copy) (vector->list xs))))
(define (aq-rows d rows n)
  (if (not (and (vector? rows) (<= (vector-length rows) 8))) (error "QP admits at most eight constraint rows"))
  (list->vector (map (lambda (row) (aq-vector d row n)) (vector->list rows))))
(define (aq-problem owner h g a b c limits)
  (let* ((d (algebraic-domain owner)) (n (if (vector? g) (vector-length g) 0)))
    (if (not (and (> n 0) (<= n 8))) (error "QP admits one through eight variables"))
    (let* ((h (aq-rows d h n)) (g (aq-vector d g n))
           (a (aq-rows d a n)) (b (aq-vector d b (vector-length a)))
           (c (aq-rows d c n)) (limits (aq-vector d limits (vector-length c))))
      (if (not (= (vector-length h) n)) (error "QP Hessian must be square"))
      (if (not (algebraic-factor-positive-definite? (algebraic-factor owner h)))
          (error "QP requires a symmetric positive-definite Hessian"))
      (vector d h g a b c limits))))
(define (aq-dot d x y)
  (let ((add (algebraic-domain-ref d 'add)) (mul (algebraic-domain-ref d 'mul)))
    (let loop ((i 0) (out (algebraic-domain-ref d 'zero)))
      (if (= i (vector-length x)) out
          (loop (+ i 1) (add out (mul (vector-ref x i) (vector-ref y i))))))))
(define (aq-primal d x)
  (let ((p (algebraic-domain-ref d 'parent)))
    (if p (aq-primal p (vector-ref ((algebraic-domain-ref d 'coefficients) x) 0)) x)))
(define (aq-sign d x) (algebraic-sign (aq-primal d x)))
(define (aq-objective problem x)
  (let* ((d (vector-ref problem 0)) (h (vector-ref problem 1)) (g (vector-ref problem 2))
         (add (algebraic-domain-ref d 'add)) (mul (algebraic-domain-ref d 'mul)))
    (let loop ((i 0) (out (aq-dot d g x)))
      (if (= i (vector-length x)) out (loop (+ i 1)
        (add out (mul 1/2 (mul (vector-ref x i) (aq-dot d (vector-ref h i) x)))))))))
(define (aq-check result)
  (if (not (and (vector? result) (= (vector-length result) 10) (eq? (vector-ref result 0) 'algebraic-qp-v1)))
      (error "Expected an exact QP result")))
(define (aq-valid? problem result)
  (aq-check result)
  (let* ((d (vector-ref problem 0)) (h (vector-ref problem 1)) (g (vector-ref problem 2))
         (a (vector-ref problem 3)) (b (vector-ref problem 4)) (c (vector-ref problem 5)) (limits (vector-ref problem 6))
         (n (vector-length g)) (x (aq-vector d (vector-ref result 2) n))
         (lambda-value (aq-vector d (vector-ref result 3) (vector-length a)))
         (mu (aq-vector d (vector-ref result 4) (vector-length c)))
         (add (algebraic-domain-ref d 'add)) (sub (algebraic-domain-ref d 'sub))
         (mul (algebraic-domain-ref d 'mul)) (zero? (algebraic-domain-ref d 'zero?))
         (equal? (algebraic-domain-ref d 'equal?)))
    (and
      (let equalities ((i 0)) (or (= i (vector-length a))
        (and (equal? (aq-dot d (vector-ref a i) x) (vector-ref b i)) (equalities (+ i 1)))))
      (let inequalities ((i 0)) (or (= i (vector-length c))
        (let ((slack (sub (aq-dot d (vector-ref c i) x) (vector-ref limits i))))
          (and (<= (aq-sign d slack) 0) (>= (aq-sign d (vector-ref mu i)) 0)
               (zero? (mul slack (vector-ref mu i))) (inequalities (+ i 1))))))
      (let stationarity ((j 0)) (or (= j n)
        (and (zero? (let eqs ((i 0) (out (add (aq-dot d (vector-ref h j) x) (vector-ref g j))))
          (if (= i (vector-length a))
              (let ineqs ((k 0) (sum out)) (if (= k (vector-length c)) sum
                (ineqs (+ k 1) (add sum (mul (vector-ref (vector-ref c k) j) (vector-ref mu k))))))
              (eqs (+ i 1) (add out (mul (vector-ref (vector-ref a i) j) (vector-ref lambda-value i)))))))
             (stationarity (+ j 1)))))
      (equal? (vector-ref result 5) (aq-objective problem x)))))
(define (algebraic-qp-verify owner h g a b c limits result)
  (guard (e (else #f)) (aq-valid? (aq-problem owner h g a b c limits) result)))
(define (aq-active mask m)
  (let loop ((bits mask) (i 0) (out '()))
    (if (= i m) (reverse out)
        (loop (quotient bits 2) (+ i 1) (if (odd? bits) (cons i out) out)))))
(define (aq-candidate problem active attempts)
  (let* ((d (vector-ref problem 0)) (h (vector-ref problem 1)) (g (vector-ref problem 2))
         (a (vector-ref problem 3)) (b (vector-ref problem 4)) (c (vector-ref problem 5)) (limits (vector-ref problem 6))
         (n (vector-length g)) (k (vector-length a)) (m (vector-length c))
         (constraints (append (vector->list a) (map (lambda (i) (vector-ref c i)) active)))
         (targets (append (vector->list b) (map (lambda (i) (vector-ref limits i)) active)))
         (size (+ n (length constraints))) (matrix (make-vector size #f)) (rhs (make-vector size #f))
         (sub (algebraic-domain-ref d 'sub)) (zero (algebraic-domain-ref d 'zero)))
    (let rows ((i 0)) (if (< i size)
      (let ((row (make-vector size #f)))
        (let cols ((j 0)) (if (< j size)
          (begin (vector-set! row j (cond
            ((and (< i n) (< j n)) (vector-ref (vector-ref h i) j))
            ((< i n) (vector-ref (list-ref constraints (- j n)) i))
            ((< j n) (vector-ref (list-ref constraints (- i n)) j)) (else zero)))
            (cols (+ j 1)))))
        (vector-set! matrix i row)
        (vector-set! rhs i (if (< i n) (sub zero (vector-ref g i)) (list-ref targets (- i n))))
        (rows (+ i 1)))))
    (let* ((factor (algebraic-factor (algebraic-domain-ref d 'owner) matrix))
           (z (algebraic-factor-solve factor rhs)) (x (make-vector n #f))
           (lambda-value (make-vector k #f)) (mu (make-vector m zero)))
      (let loop ((i 0)) (if (< i n) (begin (vector-set! x i (vector-ref z i)) (loop (+ i 1)))))
      (let loop ((i 0)) (if (< i k) (begin (vector-set! lambda-value i (vector-ref z (+ n i))) (loop (+ i 1)))))
      (let loop ((rest active) (i 0)) (if (not (null? rest))
        (begin (vector-set! mu (car rest) (vector-ref z (+ n k i))) (loop (cdr rest) (+ i 1)))))
      (let ((stable (let loop ((i 0)) (or (= i m)
        (and (if (memv i active) (> (aq-sign d (vector-ref mu i)) 0)
          (< (aq-sign d (sub (aq-dot d (vector-ref c i) x) (vector-ref limits i))) 0)) (loop (+ i 1)))))))
        (vector 'algebraic-qp-v1 problem x lambda-value mu (aq-objective problem x) active factor attempts stable)))))
(define (algebraic-qp-solve owner h g a b c limits . options)
  (let* ((problem (aq-problem owner h g a b c limits)) (m (vector-length (vector-ref problem 5)))
         (count (expt 2 m)) (budget (if (null? options) count (car options))))
    (if (not (and (<= (length options) 1) (integer? budget) (exact? budget) (> budget 0) (<= budget 256)))
        (error "QP active-set budget must be in one through 256"))
    (let search ((mask 0) (remaining budget))
      (if (or (= mask count) (= remaining 0))
          (error "QP search found no admitted optimum; infeasibility is not certified")
          (let ((candidate (guard (e (else #f)) (aq-candidate problem (aq-active mask m) (+ mask 1)))))
            (if (and candidate (aq-valid? problem candidate)) candidate (search (+ mask 1) (- remaining 1))))))))
(define (algebraic-qp-solution result)
  (aq-check result)
  (let ((d (vector-ref (vector-ref result 1) 0)))
    (vector (aq-vector d (vector-ref result 2) (vector-length (vector-ref result 2)))
            (aq-vector d (vector-ref result 3) (vector-length (vector-ref result 3)))
            (aq-vector d (vector-ref result 4) (vector-length (vector-ref result 4)))
            ((algebraic-domain-ref d 'copy) (vector-ref result 5)))))
(define (algebraic-qp-info result)
  (aq-check result) (vector (vector-ref result 8) (map (lambda (i) i) (vector-ref result 6))
                           (vector-ref result 9) (+ 1 (vector-ref result 8))))
(define (algebraic-qp-pullback result seed)
  (aq-check result)
  (if (not (vector-ref result 9)) (error "QP pullback requires strict active-set admission"))
  (let* ((problem (vector-ref result 1)) (d (vector-ref problem 0))
         (x (vector-ref result 2)) (lambda-value (vector-ref result 3)) (mu (vector-ref result 4))
         (active (vector-ref result 6)) (n (vector-length x)) (k (vector-length lambda-value))
         (m (vector-length mu)) (seed (aq-vector d seed n))
         (zero (algebraic-domain-ref d 'zero)) (sub (algebraic-domain-ref d 'sub))
         (mul (algebraic-domain-ref d 'mul)) (add (algebraic-domain-ref d 'add))
         (z (algebraic-factor-solve-transpose (vector-ref result 7)
              (list->vector (append (vector->list seed) (make-list (+ k (length active)) zero)))))
         (p (make-vector n #f)) (q (make-vector k #f)) (r (make-vector m zero))
         (hbar (make-vector n #f)) (gbar (make-vector n #f)))
    (let loop ((i 0)) (if (< i n) (begin (vector-set! p i (vector-ref z i))
      (vector-set! gbar i (sub zero (vector-ref z i))) (loop (+ i 1)))))
    (let loop ((i 0)) (if (< i k) (begin (vector-set! q i (vector-ref z (+ n i))) (loop (+ i 1)))))
    (let loop ((rest active) (i 0)) (if (not (null? rest))
      (begin (vector-set! r (car rest) (vector-ref z (+ n k i))) (loop (cdr rest) (+ i 1)))))
    (let rows ((i 0)) (if (< i n) (let ((row (make-vector n #f)))
      (let cols ((j 0)) (if (< j n) (begin (vector-set! row j (sub zero (mul (vector-ref p i) (vector-ref x j)))) (cols (+ j 1)))))
      (vector-set! hbar i row) (rows (+ i 1)))))
    (define (constraint-bars multipliers adjoints)
      (list->vector (map (lambda (i)
        (list->vector (map (lambda (j) (sub zero (add (mul (vector-ref multipliers i) (vector-ref p j))
                                                    (mul (vector-ref adjoints i) (vector-ref x j)))))
                          (iota n)))) (iota (vector-length multipliers)))))
    (vector hbar gbar (constraint-bars lambda-value q) q (constraint-bars mu r) r)))
