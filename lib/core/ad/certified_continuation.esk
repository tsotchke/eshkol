;;; Bounded adaptive tracking of a selected nonsingular real polynomial branch.
(require core.certified_nonlinear)
(require core.exact_linalg)
(provide make-certified-continuation certified-continuation-advance
         certified-continuation-enclosure verify-certified-continuation)

(define (cc-q x) (if (not (and (rational? x) (exact? x))) (error "Continuation requires exact rational arithmetic")) x)
(define (cc-tab n f) (list->vector (map f (iota n))))
(define (cc-mid x) (cc-q (/ (+ (car x) (cdr x)) 2)))
(define (cc-radius x) (cc-q (/ (- (cdr x) (car x)) 2)))
(define (cc-boxes c r) (cc-tab (vector-length c) (lambda (i)
  (cons (cc-q (- (vector-ref c i) (vector-ref r i))) (cc-q (+ (vector-ref c i) (vector-ref r i)))))))
(define (cc-check state)
  (if (not (and (vector? state) (= (vector-length state) 5) (eq? (vector-ref state 0) 'certified-continuation-v1)))
      (error "Expected certified continuation state")))
(define (make-certified-continuation system time center radii inverse)
  (cc-q time)
  (let ((info (system 'info #f #f)))
    (if (not (and (eq? (vector-ref info 0) 'certified-polynomial-system-v1) (= (vector-ref info 2) 1)))
        (error "Continuation requires exactly one scalar parameter"))
    (let ((certificate (certify-polynomial-root system center radii (vector time) inverse)))
      (if (not (eq? (vector-ref certificate 1) 'proved)) (error "Starting root box is unresolved"))
      (vector 'certified-continuation-v1 system time certificate (vector-copy radii)))))
(define (cc-propose system time candidate)
  (let correct ((center candidate) (iteration 0))
    (if (= iteration 4) center
      (let* ((n (vector-length center)) (values (system 'point center (vector time)))
             (bounds (system 'box (cc-tab n (lambda (i) (cons (vector-ref center i) (vector-ref center i)))) (vector time)))
             (jacobian (cc-tab n (lambda (i) (cc-tab n (lambda (j) (cc-mid (vector-ref (vector-ref (vector-ref bounds i) 1) j)))))))
             (change (exact-solve jacobian values))
             (next (cc-tab n (lambda (i) (cc-q (/ (round (cc-q (* 4096 (cc-q (- (vector-ref center i) (vector-ref change i)))))) 4096))))))
        (correct next (+ iteration 1))))))
;; Exact uniform contraction over X times [t0,t1]; a point Jacobian cannot replace it.
(define (cc-try state time)
  (guard (e (else #f))
    (let* ((system (vector-ref state 1)) (old-time (vector-ref state 2))
           (certificate (vector-ref state 3)) (old-box (vector-ref certificate 2))
           (sensitivity (vector-ref certificate 3)) (n (vector-length old-box))
           (dt (cc-q (- time old-time)))
           (candidate (cc-tab n (lambda (i) (cc-q (+ (cc-mid (vector-ref old-box i))
             (* (/ dt 2) (cc-mid (vector-ref (vector-ref sensitivity i) 0))))))))
           (center (cc-propose system (cc-q (/ (+ old-time time) 2)) candidate))
           (radii (cc-tab n (lambda (i) (cc-q (+ (* 2 (vector-ref (vector-ref state 4) i))
             (* (abs dt) (max (abs (car (vector-ref (vector-ref sensitivity i) 0)))
                              (abs (cdr (vector-ref (vector-ref sensitivity i) 0))))))))))
           (tube (cc-boxes center radii)) (times (vector (cons (min old-time time) (max old-time time))))
           (bounds (system 'family-box tube times))
           (residual-boxes (system 'family-box (cc-tab n (lambda (i) (cons (vector-ref center i) (vector-ref center i)))) times))
           (jacobian (cc-tab n (lambda (i) (cc-tab n (lambda (j) (cc-mid (vector-ref (vector-ref (vector-ref bounds i) 1) j)))))))
           (jr (cc-tab n (lambda (i) (cc-tab n (lambda (j) (cc-radius (vector-ref (vector-ref (vector-ref bounds i) 1) j)))))))
           (inverse (exact-inverse jacobian))
           (residual (cc-tab n (lambda (i) (cc-q (- (cc-mid (vector-ref (vector-ref residual-boxes i) 0)))))))
           (rr (cc-tab n (lambda (i) (cc-radius (vector-ref (vector-ref residual-boxes i) 0)))))
           (linear (certify-linear-solve jacobian residual (make-vector n 0) inverse radii jr rr))
           (receipt (vector-ref linear 3)) (majorant (vector-ref receipt 9)) (forcing (vector-ref receipt 10)))
      (if (and (eq? (vector-ref linear 1) 'proved)
          (let check ((i 0)) (or (= i n)
            (and (<= (car (vector-ref tube i)) (car (vector-ref old-box i)))
                 (>= (cdr (vector-ref tube i)) (cdr (vector-ref old-box i)))
                 (<= (let sum ((j 0) (out (vector-ref forcing i)))
                   (if (= j n) out (sum (+ j 1) (cc-q (+ out (* (vector-ref (vector-ref majorant i) j) (vector-ref radii j)))))))
                     (vector-ref radii i)) (check (+ i 1))))))
          (let* ((endpoint-center (cc-propose system time center))
                 (endpoint (certify-polynomial-root system endpoint-center (vector-ref state 4) (vector time) inverse)))
            (and (eq? (vector-ref endpoint 1) 'proved)
              (let check ((i 0)) (or (= i n)
                (and (<= (car (vector-ref tube i)) (car (vector-ref (vector-ref endpoint 2) i)))
                     (>= (cdr (vector-ref tube i)) (cdr (vector-ref (vector-ref endpoint 2) i))) (check (+ i 1)))))
              (vector (vector 'certified-continuation-v1 system time endpoint (vector-copy (vector-ref state 4)))
                (vector 'whole-polynomial-step-v1 old-time time center radii inverse linear))))
          #f))))
;; Result #(tag complete|partial successor accepted-step-receipts attempts).
;; Rejected steps halve; each accepted step resets the requested maximum size.
(define (cc-admitted? state)
  (guard (e (else #f))
    (let* ((certificate (vector-ref state 3)) (receipt (vector-ref certificate 4)))
      (and (eq? (vector-ref certificate 1) 'proved)
        (verify-polynomial-root-certificate certificate (vector-ref state 1)
          (vector-ref receipt 1) (vector-ref receipt 2) (vector (vector-ref state 2)) (vector-ref receipt 4))))))
(define (certified-continuation-advance state target max-step budget)
  (cc-check state) (cc-q target) (cc-q max-step)
  (if (not (cc-admitted? state)) (error "Continuation starting certificate is invalid"))
  (if (not (and (> max-step 0) (integer? budget) (exact? budget) (>= budget 0) (<= budget 256)))
      (error "Expected positive maximum step and attempt budget 0..256"))
  (let track ((current state) (step max-step) (attempts 0) (proofs '()))
    (let ((time (vector-ref current 2)))
      (cond ((= time target) (vector 'certified-continuation-result-v1 'complete current (reverse proofs) attempts))
            ((= attempts budget) (vector 'certified-continuation-result-v1 'partial current (reverse proofs) attempts))
            (else
             (let* ((size (min step (abs (- target time))))
                    (next-time (guard (e (else #f)) (cc-q (+ time (if (> target time) size (- size))))))
                    (trial (and next-time (cc-try current next-time))))
               (if trial (track (vector-ref trial 0) max-step (+ attempts 1) (cons (vector-ref trial 1) proofs))
                   (let ((half (guard (e (else #f)) (cc-q (/ size 2)))))
                     (if (and half (> half 0)) (track current half (+ attempts 1) proofs)
                         (vector 'certified-continuation-result-v1 'partial current (reverse proofs) (+ attempts 1)))))))))))
(define (certified-continuation-enclosure state)
  (cc-check state)
  (let ((boxes (vector-ref (vector-ref state 3) 2)))
    (vector (vector-ref state 2) (cc-tab (vector-length boxes) (lambda (i)
      (cons (car (vector-ref boxes i)) (cdr (vector-ref boxes i))))))))
(define (verify-certified-continuation result start target max-step budget)
  (guard (e (else #f)) (equal? result (certified-continuation-advance start target max-step budget))))
