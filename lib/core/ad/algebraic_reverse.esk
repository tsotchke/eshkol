;;; Exact coefficient adapter for the existing custom-op reverse recorder.
(require core.ad.tape)
(require core.algebraic_domain)
(provide algebraic-value-and-pullback algebraic-reverse-value algebraic-reverse-constant
         algebraic-reverse-add algebraic-reverse-sub algebraic-reverse-mul
         algebraic-reverse-inverse algebraic-reverse-pow algebraic-hvp)

(define (ar-domain tape)
  (if (not (and (vector? tape) (= (vector-length tape) 4)
                (vector? (vector-ref tape 2)) (= (vector-length (vector-ref tape 2)) 6)))
      (error "Expected an exact algebraic tape"))
  (vector-ref (vector-ref tape 2) 5))
(define (ar-value tape node)
  (if (not (and (vector? node) (= (vector-length node) 3) (eq? (vector-ref node 2) tape)))
      (error "Exact reverse node belongs to another tape"))
  ((algebraic-domain-ref (ar-domain tape) 'copy) (node-value node)))
(define (algebraic-reverse-value tape node) (ar-value tape node))
(define (algebraic-reverse-constant tape value)
  (ar-domain tape) (tape-const tape value))
(define (algebraic-reverse-add tape a b)
  (let* ((d (ar-domain tape)) (a-value (ar-value tape a)) (b-value (ar-value tape b)))
    (record-op! tape (list a b) ((algebraic-domain-ref d 'add) a-value b-value)
      (lambda (g) (list g g)))))
(define (algebraic-reverse-sub tape a b)
  (let* ((d (ar-domain tape)) (sub (algebraic-domain-ref d 'sub))
         (zero (algebraic-domain-ref d 'zero)) (a-value (ar-value tape a)) (b-value (ar-value tape b)))
    (record-op! tape (list a b) (sub a-value b-value) (lambda (g) (list g (sub zero g))))))
(define (algebraic-reverse-mul tape a b)
  (let* ((d (ar-domain tape)) (mul (algebraic-domain-ref d 'mul))
         (a-value (ar-value tape a)) (b-value (ar-value tape b)))
    (record-op! tape (list a b) (mul a-value b-value)
      (lambda (g) (list (mul g b-value) (mul g a-value))))))
(define (algebraic-reverse-inverse tape a)
  (let* ((d (ar-domain tape)) (mul (algebraic-domain-ref d 'mul))
         (sub (algebraic-domain-ref d 'sub)) (zero (algebraic-domain-ref d 'zero))
         (out ((algebraic-domain-ref d 'inverse) (ar-value tape a)))
         (partial (sub zero (mul out out))))
    (record-op! tape (list a) out (lambda (g) (list (mul g partial))))))
(define (ar-power d x n)
  (let ((mul (algebraic-domain-ref d 'mul)))
    (let loop ((i n) (out (algebraic-domain-ref d 'one)))
      (if (= i 0) out (loop (- i 1) (mul out x))))))
(define (algebraic-reverse-pow tape a n)
  (if (not (and (integer? n) (exact? n) (>= n 0) (<= n 32)))
      (error "Exact reverse exponent must be in 0 through 32"))
  (let* ((d (ar-domain tape)) (x (ar-value tape a)) (mul (algebraic-domain-ref d 'mul))
         (partial (if (= n 0) (algebraic-domain-ref d 'zero) (mul n (ar-power d x (- n 1))))))
    (record-op! tape (list a) (ar-power d x n) (lambda (g) (list (mul g partial))))))
(define (algebraic-value-and-pullback owner function point)
  (if (not (and (vector? point) (<= (vector-length point) 1024)))
      (error "Exact reverse point must be a vector of at most 1024 coefficients"))
  (let* ((d (algebraic-domain owner)) (copy (algebraic-domain-ref d 'copy))
         (ops (vector copy (lambda () (algebraic-domain-ref d 'zero))
                     (lambda () (algebraic-domain-ref d 'one))
                     (algebraic-domain-ref d 'add) (algebraic-domain-ref d 'zero?) d))
         (tape (make-tape ops)) (inputs (make-vector (vector-length point) #f)))
    (let loop ((i 0)) (if (< i (vector-length point))
      (begin (vector-set! inputs i (tape-input tape (vector-ref point i))) (loop (+ i 1)))))
    (let* ((targets (vector->list inputs)) (out (function tape inputs))
           (value (ar-value tape out)) (busy #f)
           (summary (vector (vector-length point) (tape-node-count tape) (tape-op-count tape) 1)))
      (tape-seal! tape)
      (vector value
        (lambda (seed)
          (if busy (error "Exact pullback is sequential and cannot reenter"))
          (set! busy #t)
          (guard (e (else (set! busy #f) (raise e)))
            (let ((result (list->vector (tape-pullback tape out targets seed))))
              (set! busy #f) result)))
        summary))))
(define (algebraic-hvp owner function point direction)
  (if (not (and (vector? point) (vector? direction)
                (= (vector-length point) (vector-length direction))))
      (error "Exact HVP point and direction dimensions differ"))
  (let* ((context (make-algebraic-taylor owner 1)) (n (vector-length point)) (seeded (make-vector n #f)))
    (let loop ((i 0)) (if (< i n)
      (begin (vector-set! seeded i (algebraic-ad-value context
        (vector (vector-ref point i) (vector-ref direction i)))) (loop (+ i 1)))))
    (let* ((record (algebraic-value-and-pullback context function seeded))
           (adjoints ((vector-ref record 1) 1)) (gradient (make-vector n #f)) (hvp (make-vector n #f))
           (value (vector-ref record 0)))
      (let loop ((i 0)) (if (< i n)
        (begin (vector-set! gradient i (algebraic-ad-derivative (vector-ref adjoints i) 0))
               (vector-set! hvp i (algebraic-ad-derivative (vector-ref adjoints i) 1)) (loop (+ i 1)))))
      (vector hvp gradient (algebraic-ad-derivative value 0) (algebraic-ad-derivative value 1)))))
