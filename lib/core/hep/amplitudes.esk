;;; core.hep.amplitudes -- 4D Spinor-Helicity, Parke-Taylor, BCFW & ABHY Associahedron
;;;
;;; Usage: (require core.hep.amplitudes)
;;;
;;; Implements exact Q[i] (and f64) 4D spinor-helicity scattering amplitudes:
;;;   - Exact Q[i] field arithmetic (qi+, qi-, qi*, qi/, qi=)
;;;   - Holomorphic angle bracket <i j> = det(lambda_i, lambda_j) and
;;;     anti-holomorphic square bracket [i j] = det(tilde-lambda_i, tilde-lambda_j)
;;;   - Exact Schouten identity verifier <12><34> + <13><42> + <14><23> = 0
;;;   - Exact null 4-momentum matrix p_{a ad} = lambda_a tilde-lambda_ad and
;;;     momentum conservation verifier sum_i lambda_i tilde-lambda_i = 0
;;;   - Exact rational momentum-conserving n-point kinematic generator
;;;   - Mandelstam invariants s_{ij} = <i j>[j i]
;;;   - Parke-Taylor n-point MHV gluon amplitude A_n(1^-, 2^-, 3^+, ..., n^+)
;;;   - Exact BCFW on-shell recursion (4-point and 5-point MHV via [1, n> shift)
;;;     cross-checked to exact rational equality against Parke-Taylor
;;;   - Planar ABHY associahedron kinematic variables X_{i,j}, causal diamond
;;;     planar mesh relation verifier X_{i,j} + X_{i+1,j+1} - X_{i,j+1} - X_{i+1,j} = c_{i,j},
;;;     and bi-adjoint scalar tree amplitudes m_4, m_5 from associahedron vertices

(require stdlib)

(provide qi qi-re qi-im qi+ qi- qi-neg qi* qi/ qi-conj qi-zero? qi= qi-close?
         make-spinor make-particle particle-lambda particle-lambda-tilde
         angle-bracket square-bracket
         verify-schouten momentum-matrix verify-momentum-conservation
         mandelstam-s make-momentum-conserving-kinematics
         amplitude-3pt-mhv amplitude-3pt-anti-mhv
         parke-taylor-mhv bcfw-mhv-4pt bcfw-mhv-5pt bcfw-mhv
         abhy-planar-x abhy-mesh-c abhy-verify-mesh-relations
         abhy-biadjoint-m4 abhy-biadjoint-m5)

;; ============================================================================
;; Exact Q[i] / f64 Field Arithmetic via (re . im) Pairs
;; ============================================================================

(define (qi re im) (cons re im))
(define (qi-re z) (car z))
(define (qi-im z) (cdr z))

(define (qi+ a b) (cons (+ (car a) (car b)) (+ (cdr a) (cdr b))))
(define (qi- a b) (cons (- (car a) (car b)) (- (cdr a) (cdr b))))
(define (qi-neg a) (cons (- (car a)) (- (cdr a))))
(define (qi-conj a) (cons (car a) (- (cdr a))))

(define (qi* a b)
  (cons (- (* (car a) (car b)) (* (cdr a) (cdr b)))
        (+ (* (car a) (cdr b)) (* (cdr a) (car b)))))

(define (qi/ a b)
  (let ((den (+ (* (car b) (car b)) (* (cdr b) (cdr b)))))
    (if (zero? den)
        (error "core.hep.amplitudes: division by zero in Q[i]" a b))
    (cons (/ (+ (* (car a) (car b)) (* (cdr a) (cdr b))) den)
          (/ (- (* (cdr a) (car b)) (* (car a) (cdr b))) den))))

(define (qi-zero? a) (and (zero? (car a)) (zero? (cdr a))))
(define (qi= a b) (and (= (car a) (car b)) (= (cdr a) (cdr b))))
(define (qi-close? a b tol)
  (and (<= (abs (- (car a) (car b))) tol)
       (<= (abs (- (cdr a) (cdr b))) tol)))

(define (qi-pow a n)
  (let loop ((k n) (acc (qi 1 0)))
    (if (<= k 0) acc (loop (- k 1) (qi* acc a)))))

;; ============================================================================
;; 4D Spinors & Massless Particle Kinematics
;; ============================================================================
;; A spinor is (vector s0 s1) with Q[i] (or f64-paired) entries.
;; A massless particle is (vector 'particle lambda lambda-tilde).

(define (make-spinor s0 s1)
  (vector (if (pair? s0) s0 (qi s0 0))
          (if (pair? s1) s1 (qi s1 0))))

(define (spinor-add u v)
  (vector (qi+ (vector-ref u 0) (vector-ref v 0))
          (qi+ (vector-ref u 1) (vector-ref v 1))))

(define (spinor-scale c u)
  (vector (qi* c (vector-ref u 0))
          (qi* c (vector-ref u 1))))

(define (make-particle lam lamt)
  (vector 'particle lam lamt))

(define (particle-lambda p) (vector-ref p 1))
(define (particle-lambda-tilde p) (vector-ref p 2))

;; Holomorphic angle bracket <i j> = det(lambda_i, lambda_j)
(define (angle-bracket p1 p2)
  (let ((u (if (eq? (vector-ref p1 0) 'particle) (particle-lambda p1) p1))
        (v (if (eq? (vector-ref p2 0) 'particle) (particle-lambda p2) p2)))
    (qi- (qi* (vector-ref u 0) (vector-ref v 1))
         (qi* (vector-ref u 1) (vector-ref v 0)))))

;; Anti-holomorphic square bracket [i j] = det(tilde-lambda_i, tilde-lambda_j)
(define (square-bracket p1 p2)
  (let ((u (if (eq? (vector-ref p1 0) 'particle) (particle-lambda-tilde p1) p1))
        (v (if (eq? (vector-ref p2 0) 'particle) (particle-lambda-tilde p2) p2)))
    (qi- (qi* (vector-ref u 0) (vector-ref v 1))
         (qi* (vector-ref u 1) (vector-ref v 0)))))

;; Exact Schouten identity: <1 2><3 4> + <1 3><4 2> + <1 4><2 3> = 0
(define (verify-schouten s1 s2 s3 s4)
  (let ((t1 (qi* (angle-bracket s1 s2) (angle-bracket s3 s4)))
        (t2 (qi* (angle-bracket s1 s3) (angle-bracket s4 s2)))
        (t3 (qi* (angle-bracket s1 s4) (angle-bracket s2 s3))))
    (qi-zero? (qi+ (qi+ t1 t2) t3))))

;; Rank-1 null 4-momentum bispinor p_{alpha, dot-alpha} = lambda_alpha * tilde-lambda_{dot-alpha}
(define (momentum-matrix p)
  (let ((l (particle-lambda p))
        (lt (particle-lambda-tilde p)))
    (vector (vector (qi* (vector-ref l 0) (vector-ref lt 0))
                    (qi* (vector-ref l 0) (vector-ref lt 1)))
            (vector (qi* (vector-ref l 1) (vector-ref lt 0))
                    (qi* (vector-ref l 1) (vector-ref lt 1))))))

;; Verify exact 4-momentum conservation: sum_i lambda_{i,a} tilde-lambda_{i,ad} = 0
(define (verify-momentum-conservation particles)
  (let ((n (vector-length particles)))
    (let loop ((i 0)
               (p00 (qi 0 0)) (p01 (qi 0 0))
               (p10 (qi 0 0)) (p11 (qi 0 0)))
      (if (< i n)
          (let ((pm (momentum-matrix (vector-ref particles i))))
            (loop (+ i 1)
                  (qi+ p00 (vector-ref (vector-ref pm 0) 0))
                  (qi+ p01 (vector-ref (vector-ref pm 0) 1))
                  (qi+ p10 (vector-ref (vector-ref pm 1) 0))
                  (qi+ p11 (vector-ref (vector-ref pm 1) 1))))
          (and (qi-zero? p00) (qi-zero? p01) (qi-zero? p10) (qi-zero? p11))))))

;; Mandelstam invariant s_{ij} = <i j> [j i]
(define (mandelstam-s pi pj)
  (qi* (angle-bracket pi pj) (square-bracket pj pi)))

;; Construct exact momentum-conserving n-point massless kinematics (n >= 4)
;; given vector of n holomorphic spinors `lambdas` (with <n-2, n-1> != 0) and
;; vector of (n-2) anti-holomorphic spinors `tilde-init`.
;; Solves sum_{i=0}^{n-1} lambda_i tilde-lambda_i = 0 exactly over Q[i]:
;;   tilde_{n-2} = -(1 / <n-1, n-2>) sum_{i=0}^{n-3} <n-1, i> tilde_i
;;   tilde_{n-1} = -(1 / <n-2, n-1>) sum_{i=0}^{n-3} <n-2, i> tilde_i
(define (make-momentum-conserving-kinematics lambdas tilde-init)
  (let* ((n (vector-length lambdas))
         (m (- n 2))
         (ln1 (vector-ref lambdas (- n 2)))
         (ln  (vector-ref lambdas (- n 1)))
         (ang-n-n1 (angle-bracket ln ln1))
         (ang-n1-n (angle-bracket ln1 ln)))
    (if (qi-zero? ang-n1-n)
        (error "make-momentum-conserving-kinematics: last two spinors are collinear"))
    (let* ((sum-n (let loop ((i 0) (acc (make-spinor 0 0)))
                    (if (< i m)
                        (loop (+ i 1)
                              (spinor-add acc (spinor-scale (angle-bracket ln (vector-ref lambdas i))
                                                            (vector-ref tilde-init i))))
                        acc)))
           (sum-n1 (let loop ((i 0) (acc (make-spinor 0 0)))
                     (if (< i m)
                         (loop (+ i 1)
                               (spinor-add acc (spinor-scale (angle-bracket ln1 (vector-ref lambdas i))
                                                             (vector-ref tilde-init i))))
                         acc)))
           (t-n1 (spinor-scale (qi-neg (qi/ (qi 1 0) ang-n-n1)) sum-n))
           (t-n  (spinor-scale (qi-neg (qi/ (qi 1 0) ang-n1-n)) sum-n1))
           (out (make-vector n #f)))
      (let loop ((i 0))
        (if (< i m)
            (begin (vector-set! out i (make-particle (vector-ref lambdas i) (vector-ref tilde-init i)))
                   (loop (+ i 1)))))
      (vector-set! out (- n 2) (make-particle ln1 t-n1))
      (vector-set! out (- n 1) (make-particle ln t-n))
      out)))

;; ============================================================================
;; Parke-Taylor MHV Amplitude & Exact BCFW On-Shell Recursion
;; ============================================================================

;; 3-point MHV amplitude A_3(a^-, b^-, c^+) = <a b>^3 / (<b c> <c a>)
(define (amplitude-3pt-mhv pa pb pc)
  (qi/ (qi-pow (angle-bracket pa pb) 3)
       (qi* (angle-bracket pb pc) (angle-bracket pc pa))))

;; 3-point anti-MHV amplitude A_3(a^-, b^+, c^+) = -[b c]^3 / ([a b] [c a])
;; (sign matches convention [i j] = det(lt_i, lt_j) and s_{ij} = <i j>[j i])
(define (amplitude-3pt-anti-mhv pa pb pc)
  (qi-neg (qi/ (qi-pow (square-bracket pb pc) 3)
               (qi* (square-bracket pa pb) (square-bracket pc pa)))))

;; Parke-Taylor n-point MHV gluon amplitude:
;;   A_n(..., a^-, ..., b^-, ...) = <a b>^4 / (<0 1><1 2>...<n-1, 0>)
;; Default negative-helicity indices are a = 0, b = 1.
(define (parke-taylor-mhv particles . opt-neg)
  (let* ((n (vector-length particles))
         (a (if (pair? opt-neg) (car opt-neg) 0))
         (b (if (and (pair? opt-neg) (pair? (cdr opt-neg))) (cadr opt-neg) 1))
         (num (qi-pow (angle-bracket (vector-ref particles a) (vector-ref particles b)) 4))
         (den (let loop ((i 0) (acc (qi 1 0)))
                (if (< i n)
                    (loop (+ i 1)
                          (qi* acc (angle-bracket (vector-ref particles i)
                                                  (vector-ref particles (modulo (+ i 1) n)))))
                    acc))))
    (qi/ num den)))

;; Recursive BCFW [0, n-1> shift for n-point MHV gluon amplitude A_n(0^-, 1^-, 2^+, ..., (n-1)^+):
;;   hat{tilde-lambda}_0(z) = tilde-lambda_0 - z * tilde-lambda_{n-1}
;;   hat{lambda}_{n-1}(z)   = lambda_{n-1}   + z * lambda_0
;; Unique contributing channel:
;;   L = (hat{0}^-, 1^-, ..., (n-3)^+, hat{P}^+)   [(n-1)-point MHV]
;;   R = (-hat{P}^-, (n-2)^+, hat{n-1}^+)           [3-point anti-MHV]
;; Pole from <n-2, hat{n-1}(z)> = 0 => z* = <n-2, n-1> / <0, n-2>.
;; On the pole:
;;   hat{P} = p_{n-2} + hat{p}_{n-1} = lambda_{n-2} * (lt_{n-2} + (<0, n-1>/<0, n-2>) lt_{n-1})
;;   so lambda_{hat P} = lambda_{n-2}, lt_{hat P} = lt_{n-2} + (<0, n-1>/<0, n-2>) lt_{n-1}.
;;   -hat{P} carries lambda_{-hat P} = lambda_{hat P}, lt_{-hat P} = -lt_{hat P}.
(define (bcfw-mhv particles)
  (let ((n (vector-length particles)))
    (cond
      ((< n 3) (error "bcfw-mhv: requires at least 3 particles" n))
      ((= n 3)
       (amplitude-3pt-mhv (vector-ref particles 0)
                          (vector-ref particles 1)
                          (vector-ref particles 2)))
      (else
       (let* ((p0   (vector-ref particles 0))
              (pn2  (vector-ref particles (- n 2)))
              (pn1  (vector-ref particles (- n 1)))
              (ang-0-n2 (angle-bracket p0 pn2))
              (ang-0-n1 (angle-bracket p0 pn1))
              (ang-n2-n1 (angle-bracket pn2 pn1))
              (z-star (qi/ ang-n2-n1 ang-0-n2))
              ;; Shifted particle 0: (lambda_0, lt_0 - z* lt_{n-1})
              (p0-hat (make-particle
                        (particle-lambda p0)
                        (spinor-add (particle-lambda-tilde p0)
                                    (spinor-scale (qi-neg z-star) (particle-lambda-tilde pn1)))))
              ;; Shifted particle n-1: (lambda_{n-1} + z* lambda_0, lt_{n-1})
              (pn1-hat (make-particle
                         (spinor-add (particle-lambda pn1)
                                     (spinor-scale z-star (particle-lambda p0)))
                         (particle-lambda-tilde pn1)))
              ;; Internal on-shell leg hat{P} and -hat{P}
              (ratio (qi/ ang-0-n1 ang-0-n2))
              (p-hat-lt (spinor-add (particle-lambda-tilde pn2)
                                    (spinor-scale ratio (particle-lambda-tilde pn1))))
              (p-hat (make-particle (particle-lambda pn2) p-hat-lt))
              (neg-p-hat (make-particle (particle-lambda pn2)
                                        (spinor-scale (qi -1 0) p-hat-lt)))
              ;; Assemble left (n-1)-point sub-process
              (left-vec (make-vector (- n 1) #f)))
         (vector-set! left-vec 0 p0-hat)
         (let loop ((i 1))
           (if (< i (- n 2))
               (begin (vector-set! left-vec i (vector-ref particles i))
                      (loop (+ i 1)))))
         (vector-set! left-vec (- n 2) p-hat)
         (let* ((amp-L (bcfw-mhv left-vec))
                (amp-R (amplitude-3pt-anti-mhv neg-p-hat pn2 pn1-hat))
                (prop  (mandelstam-s pn2 pn1)))
           (qi/ (qi* amp-L amp-R) prop)))))))

(define (bcfw-mhv-4pt particles)
  (if (not (= (vector-length particles) 4))
      (error "bcfw-mhv-4pt: expected 4 particles"))
  (bcfw-mhv particles))

(define (bcfw-mhv-5pt particles)
  (if (not (= (vector-length particles) 5))
      (error "bcfw-mhv-5pt: expected 5 particles"))
  (bcfw-mhv particles))

;; ============================================================================
;; Planar ABHY Associahedron Kinematic Variables & Mesh Relations
;; ============================================================================
;; Uses 1-based planar indices 1 <= i <= j <= n+1 (cyclic mod n):
;;   X_{i, j} = (p_i + p_{i+1} + ... + p_{j-1})^2 = sum_{i <= a < b < j} s_{ab}
;; with boundary X_{i, i} = X_{i, i+1} = 0 and X_{1, n+1} = 0 (momentum conservation).
;; Non-adjacent Mandelstam constants c_{i, j} = -s_{i, j} (1-based particle indices).
;; Causal diamond / planar mesh identity:
;;   X_{i, j} + X_{i+1, j+1} - X_{i, j+1} - X_{i+1, j} = c_{i, j} = -s_{i, j}
;; for all 1 <= i < j <= n with j - i >= 2.

(define (abhy-planar-x particles i j)
  (let ((n (vector-length particles)))
    (cond ((or (< i 1) (> j (+ n 1)) (>= i j)) (qi 0 0))
          ((= (- j i) 1) (qi 0 0))
          (else
           (let la ((a i) (acc (qi 0 0)))
             (if (< a (- j 1))
                 (la (+ a 1)
                     (let lb ((b (+ a 1)) (s acc))
                       (if (< b j)
                           (let ((pa (vector-ref particles (modulo (- a 1) n)))
                                 (pb (vector-ref particles (modulo (- b 1) n))))
                             (lb (+ b 1) (qi+ s (mandelstam-s pa pb))))
                           s)))
                 acc))))))

;; c_{i, j} = -s_{i, j} (1-based particle indices)
(define (abhy-mesh-c particles i j)
  (let ((n (vector-length particles)))
    (qi-neg (mandelstam-s (vector-ref particles (modulo (- i 1) n))
                          (vector-ref particles (modulo (- j 1) n))))))

;; Verify ALL planar ABHY causal-diamond mesh relations for 1 <= i, i+2 <= j <= n:
;;   X_{i,j} + X_{i+1,j+1} - X_{i,j+1} - X_{i+1,j} = c_{i,j}
(define (abhy-verify-mesh-relations particles)
  (let ((n (vector-length particles)))
    (let li ((i 1))
      (if (> i (- n 2))
          #t
          (if (let lj ((j (+ i 2)))
                (if (> j n)
                    #t
                    (let* ((x-ij   (abhy-planar-x particles i j))
                           (x-i1j1 (abhy-planar-x particles (+ i 1) (+ j 1)))
                           (x-ij1  (abhy-planar-x particles i (+ j 1)))
                           (x-i1j  (abhy-planar-x particles (+ i 1) j))
                           (lhs (qi- (qi+ x-ij x-i1j1) (qi+ x-ij1 x-i1j)))
                           (rhs (abhy-mesh-c particles i j)))
                      (if (qi= lhs rhs)
                          (lj (+ j 1))
                          #f))))
              (li (+ i 1))
              #f)))))

;; Canonical bi-adjoint scalar tree amplitudes from ABHY associahedron vertices:
;; 4-point (1D segment K_3, 2 vertices): m_4 = 1/X_{1,3} + 1/X_{2,4}
(define (abhy-biadjoint-m4 particles)
  (let ((x13 (abhy-planar-x particles 1 3))
        (x24 (abhy-planar-x particles 2 4)))
    (qi+ (qi/ (qi 1 0) x13) (qi/ (qi 1 0) x24))))

;; 5-point (2D pentagon K_4, 5 triangulations of a pentagon):
;;   m_5 = 1/(X13 X14) + 1/(X13 X35) + 1/(X24 X14) + 1/(X24 X25) + 1/(X25 X35)
(define (abhy-biadjoint-m5 particles)
  (let ((x13 (abhy-planar-x particles 1 3))
        (x14 (abhy-planar-x particles 1 4))
        (x24 (abhy-planar-x particles 2 4))
        (x25 (abhy-planar-x particles 2 5))
        (x35 (abhy-planar-x particles 3 5))
        (one (qi 1 0)))
    (qi+ (qi+ (qi/ one (qi* x13 x14))
              (qi/ one (qi* x13 x35)))
         (qi+ (qi/ one (qi* x24 x14))
              (qi+ (qi/ one (qi* x24 x25))
                   (qi/ one (qi* x25 x35)))))))
