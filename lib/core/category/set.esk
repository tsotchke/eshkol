;;; core.category.set -- Set-valued functors on finite categories: natural
;;; transformations, limits and colimits, ends and coends, the Yoneda lemma,
;;; categories of elements, and left and right Kan extensions computed by
;;; the pointwise (comma-category) formula and by the (co)end formula, with
;;; the adjunctions Lan -| F^* -| Ran and their triangle identities.
;;;
;;; Usage: (require core.category.set)   or   (require core.category)
;;;
;;; Sources: S. Mac Lane, "Categories for the Working Mathematician", 2nd ed.
;;; (1998), III.3-III.4 (limits and colimits in Set), IX.4-IX.6 (ends and
;;; coends; natural transformations as an end, IX.5), X.3-X.4 (Kan
;;; extensions: Lan_F G(d) = colim_{(F | d)} G P, Ran_F G(d) = lim_{(d | F)}
;;; G Q, Theorem X.3.1; the coend formula Lan_F G = int^c D(Fc, -) x Gc,
;;; X.4); E. Riehl, "Category Theory in Context" (2016), 2.2 (the Yoneda
;;; lemma), 2.4 (categories of elements), 3.3-3.4, 6.1-6.2; G. M. Kelly,
;;; "Basic Concepts of Enriched Category Theory" (1982, TAC Reprints 10,
;;; 2005), 2.1-2.2 and 4.1-4.2 (ends, coends, Kan extensions as weighted
;;; (co)limits); nLab: "presheaf", "limit", "colimit", "end", "coend",
;;; "Yoneda lemma", "category of elements", "Kan extension", "pointwise Kan
;;; extension".
;;;
;;; Representation (public):
;;;   set-functor   #(set-functor C sets maps): sets a vector, object c ->
;;;                 list of the elements of X(c) (compared with equal?);
;;;                 maps a vector, arrow a : x -> y -> vector of indices,
;;;                 entry i the index in X(y) of X(a)(the i-th element of
;;;                 X(x)). X is covariant: X(g o f) = X(g) X(f).
;;;   presheaves    a core.sheaf set-presheaf F on C is the set-functor on
;;;                 C^op with the same sets and maps (presheaf->set-functor,
;;;                 set-functor->presheaf); no data is copied.
;;;   transformation  a vector, object c -> vector of indices X(c) -> Y(c)
;;;                 (the convention of core.sheaf's presheaf-natural?).
;;;   limit         a list of families, each a vector c -> index in X(c).
;;;   colimit       #(set-colimit sizes offsets classes representatives):
;;;                 the class of element i of X(c) is (set-colimit-class co c i).
;;;   bifunctor     a set-functor H on P = (category-product (category-opposite C) C);
;;;                 H(c', c) is contravariant in c' and covariant in c.
;;;
;;; Natural transformations X => Y are the limit of Y o pi over the category
;;; of elements of X (Mac Lane IX.5, Riehl 3.4.?): they are found by one
;;; propagating search over the elements of X, never by enumerating products
;;; of function spaces.

(require stdlib)
(require core.sheaf.site)
(require core.sheaf.presheaf)
(require core.category.finite)
(require core.category.functor)

(provide make-set-functor make-set-functor-from-indices make-set-functor-from-names set-functor? set-functor-category
         set-functor-elements set-functor-element-count set-functor-element-index set-functor-sizes
         set-functor-apply set-functor-apply-index
         set-functor-functoriality-violations set-functor-functorial?
         presheaf->set-functor set-functor->presheaf set-functor-restrict
         constant-set-functor corepresentable-set-functor hom-set-functor set-functor-product
         set-natural? set-natural-transformations set-natural-transformation-count
         set-identity-transformation set-transformation-compose set-transformation-identity?
         set-transformation-bijective? set-natural-isomorphism?
         set-limit set-limit-size set-limit-element-values set-cone-count
         set-colimit set-colimit-size set-colimit-class set-colimit-representatives
         set-end set-coend set-coend-class set-natural-transformations-end
         yoneda-element yoneda-transformation yoneda-violations presheaf-yoneda-violations
         elements-category elements-projection presheaf-elements-category presheaf-elements-projection
         discrete-opfibration? discrete-fibration?
         set-lan set-ran set-lan-coend set-ran-end set-lan-comparison set-ran-comparison
         set-lan-unit set-lan-counit set-lan-map set-ran-unit set-ran-counit set-ran-map set-restrict-map
         set-lan-adjunction-violations set-ran-adjunction-violations)

(define (cs-range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (cs-all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (cs-all? pred (cdr xs))) (else #f)))
(define (cs-vec x) (if (vector? x) x (list->vector x)))
(define (cs-position item items)
  (let loop ((l items) (i 0)) (cond ((null? l) #f) ((equal? (car l) item) i) (else (loop (cdr l) (+ i 1))))))
(define (cs-objects C) (cs-range (category-object-count C)))
(define (cs-arrows C) (cs-range (category-arrow-count C)))
(define (cs-label-table K)
  (let ((t (make-hash-table)))
    (for-each (lambda (o) (hash-table-set! t (category-object-label K o) o)) (cs-objects K))
    t))

;; ---------------------------------------------------------------------------
;; Set-valued functors
;; ---------------------------------------------------------------------------
(define (make-set-functor-from-indices C sets maps)
  (vector 'set-functor C (cs-vec sets) (list->vector (map cs-vec (if (vector? maps) (vector->list maps) maps)))))
;; sets: list/vector over objects of element lists; act: (a x) -> X(a)(x);
;; identities are filled in
(define (make-set-functor C sets act)
  (let ((sv (cs-vec sets)))
    (make-set-functor-from-indices
     C sv
     (map (lambda (a)
            (let ((x (arrow-source C a)) (y (arrow-target C a)))
              (list->vector
               (map (lambda (e)
                      (if (= a (category-identity C x)) (cs-position e (vector-ref sv x))
                          (let ((i (cs-position (act a e) (vector-ref sv y))))
                            (if (not i) (error "make-set-functor: the image leaves the target set" (list a e)))
                            i)))
                    (vector-ref sv x)))))
          (cs-arrows C)))))
;; maps given by arrow name: alist name -> index vector; identities filled
;; in, every other arrow must be named in the alist (a functor on a
;; presented category is determined by these images; functoriality is the
;; caller's to check with set-functor-functoriality-violations)
(define (make-set-functor-from-names C sets alist)
  (let ((sv (cs-vec sets)))
    (make-set-functor-from-indices
     C sv
     (map (lambda (a)
            (if (= a (category-identity C (arrow-source C a)))
                (list->vector (cs-range (length (vector-ref sv (arrow-source C a)))))
                (let ((e (assoc (arrow-name C a) alist)))
                  (if (not e) (error "make-set-functor-from-names: no map for arrow" (arrow-name C a)))
                  (cdr e))))
          (cs-arrows C)))))
(define (set-functor? X) (and (vector? X) (= 4 (vector-length X)) (eq? (vector-ref X 0) 'set-functor)))
(define (set-functor-category X) (vector-ref X 1))
(define (set-functor-elements X c) (vector-ref (vector-ref X 2) c))
(define (set-functor-element-count X c) (length (vector-ref (vector-ref X 2) c)))
(define (set-functor-sizes X) (map (lambda (c) (set-functor-element-count X c)) (cs-objects (set-functor-category X))))
(define (set-functor-element-index X c e) (cs-position e (set-functor-elements X c)))
(define (set-functor-apply-index X a i) (vector-ref (vector-ref (vector-ref X 3) a) i))
(define (set-functor-apply X a e)
  (let* ((C (set-functor-category X)) (i (set-functor-element-index X (arrow-source C a) e)))
    (if (not i) (error "set-functor-apply: not an element of X(source a)" e))
    (list-ref (set-functor-elements X (arrow-target C a)) (set-functor-apply-index X a i))))
(define (set-functor-functoriality-violations X)
  (let ((C (set-functor-category X)) (out '()))
    (for-each (lambda (c) (if (not (cs-all? (lambda (i) (= i (set-functor-apply-index X (category-identity C c) i))) (cs-range (set-functor-element-count X c))))
                              (set! out (cons (list 'identity c) out))))
              (cs-objects C))
    (for-each (lambda (g)
                (for-each (lambda (f)
                            (if (and (category-composable? C g f)
                                     (not (cs-all? (lambda (i) (= (set-functor-apply-index X (category-compose C g f) i)
                                                                  (set-functor-apply-index X g (set-functor-apply-index X f i))))
                                                   (cs-range (set-functor-element-count X (arrow-source C f))))))
                                (set! out (cons (list 'composite g f) out))))
                          (cs-arrows C)))
              (cs-arrows C))
    (reverse out)))
(define (set-functor-functorial? X) (null? (set-functor-functoriality-violations X)))
;; a presheaf on C is a set-functor on C^op (same sets and maps)
(define (presheaf->set-functor F)
  (vector 'set-functor (category-opposite (presheaf-category F)) (vector-ref F 2) (vector-ref F 3)))
;; X a set-functor on C^op, returned as a presheaf on C
(define (set-functor->presheaf X C) (make-set-presheaf-from-indices C (vector-ref X 2) (vector-ref X 3)))
;; X o F for F : B -> C
(define (set-functor-restrict X F)
  (let ((B (functor-source F)))
    (vector 'set-functor B
            (list->vector (map (lambda (b) (set-functor-elements X (functor-object F b))) (cs-objects B)))
            (list->vector (map (lambda (a) (vector-ref (vector-ref X 3) (functor-arrow F a))) (cs-arrows B))))))
(define (constant-set-functor C elems) (make-set-functor C (map (lambda (c) elems) (cs-objects C)) (lambda (a x) x)))
;; C(c, -): elements arrow indices, acting by postcomposition
(define (corepresentable-set-functor C c)
  (make-set-functor C (map (lambda (d) (category-hom C c d)) (cs-objects C)) (lambda (a u) (category-compose C a u))))
;; C(-, -) on P = C^op x C: H(c', c) = C(c', c), (f, g) acts by u |-> g o u o f
(define (hom-set-functor C P)
  (let ((n (category-object-count C)))
    (make-set-functor P (map (lambda (o) (category-hom C (quotient o n) (remainder o n))) (cs-objects P))
                      (lambda (k u) (let ((fg (arrow-name P k))) (category-compose C (cadr fg) (category-compose C u (car fg))))))))
(define (set-functor-product X Y)
  (let ((C (set-functor-category X)))
    (make-set-functor C (map (lambda (c) (apply append (map (lambda (x) (map (lambda (y) (list x y)) (set-functor-elements Y c))) (set-functor-elements X c))))
                             (cs-objects C))
                      (lambda (a p) (list (set-functor-apply X a (car p)) (set-functor-apply Y a (cadr p)))))))

;; ---------------------------------------------------------------------------
;; A propagating search: variables with finite domains and functional
;; constraints v[y] = map[v[x]] along edges (x y map). Used for limits and
;; for natural transformations (a limit over the category of elements).
;; ---------------------------------------------------------------------------
(define (cs-propagate! a out x)
  (let loop ((work (list x)) (ok #t))
    (if (or (not ok) (null? work)) ok
        (let ((v (car work)))
          (let edges ((es (vector-ref out v)) (work (cdr work)) (ok #t))
            (if (or (not ok) (null? es)) (loop work ok)
                (let* ((e (car es)) (y (car e)) (val (vector-ref (cdr e) (vector-ref a v))))
                  (cond ((not (vector-ref a y)) (vector-set! a y val) (edges (cdr es) (cons y work) #t))
                        ((= val (vector-ref a y)) (edges (cdr es) work #t))
                        (else (edges (cdr es) work #f))))))))))
;; Solutions as fresh vectors (count-only when collect? is #f): returns a list
;; or a count. out: vector var -> list of (y . map).
(define (cs-solve sizes out collect?)
  (let ((n (vector-length sizes)) (acc '()) (count 0))
    (let search ((p 0) (a (make-vector n #f)))
      (cond ((= p n) (if collect? (set! acc (cons a acc)) (set! count (+ count 1))))
            ((vector-ref a p) (search (+ p 1) a))
            (else
             (let try ((v 0))
               (if (< v (vector-ref sizes p))
                   (let ((b (vector-copy a)))
                     (vector-set! b p v)
                     (if (cs-propagate! b out p) (search (+ p 1) b))
                     (try (+ v 1))))))))
    (if collect? (reverse acc) count)))
;; constraint graph of X over its category: one variable per object
(define (cs-diagram-graph X)
  (let* ((C (set-functor-category X)) (out (make-vector (category-object-count C) '())))
    (for-each (lambda (a) (if (not (= a (category-identity C (arrow-source C a))))
                              (vector-set! out (arrow-source C a) (cons (cons (arrow-target C a) (vector-ref (vector-ref X 3) a)) (vector-ref out (arrow-source C a))))))
              (cs-arrows C))
    out))

;; ---------------------------------------------------------------------------
;; Limits and colimits in Set
;; ---------------------------------------------------------------------------
;; lim X = the compatible families: vectors c -> index with X(a)(v_x) = v_y
(define (set-limit X) (cs-solve (list->vector (set-functor-sizes X)) (cs-diagram-graph X) #t))
(define (set-limit-size X) (cs-solve (list->vector (set-functor-sizes X)) (cs-diagram-graph X) #f))
(define (set-limit-element-values X fam)
  (map (lambda (c) (list-ref (set-functor-elements X c) (vector-ref fam c))) (cs-objects (set-functor-category X))))
;; cones from a k-element set: k-tuples of families, counted on the k-fold
;; disjoint union of the diagram (the universal property says |lim X|^k)
(define (set-cone-count X k)
  (let* ((C (set-functor-category X)) (n (category-object-count C)) (sizes (make-vector (* n k) 0)) (out (make-vector (* n k) '())))
    (for-each (lambda (t)
                (for-each (lambda (c) (vector-set! sizes (+ (* t n) c) (set-functor-element-count X c))) (cs-objects C))
                (for-each (lambda (a) (if (not (= a (category-identity C (arrow-source C a))))
                                          (let ((x (+ (* t n) (arrow-source C a))))
                                            (vector-set! out x (cons (cons (+ (* t n) (arrow-target C a)) (vector-ref (vector-ref X 3) a)) (vector-ref out x))))))
                          (cs-arrows C)))
              (cs-range k))
    (cs-solve sizes out #f)))
;; union-find over the disjoint union of sets of the given sizes; pairs is a
;; list of ((x . i) . (y . j)) to identify
(define (cs-quotient sizes pairs)
  (let* ((n (vector-length sizes))
         (offsets (let ((o (make-vector (+ n 1) 0))) (let loop ((x 0)) (if (< x n) (begin (vector-set! o (+ x 1) (+ (vector-ref o x) (vector-ref sizes x))) (loop (+ x 1))))) o))
         (total (vector-ref offsets n)) (parent (make-vector total 0)))
    (let init ((i 0)) (if (< i total) (begin (vector-set! parent i i) (init (+ i 1)))))
    (let ((root (lambda (i) (let loop ((i i)) (let ((p (vector-ref parent i))) (if (= p i) i (begin (vector-set! parent i (vector-ref parent p)) (loop p))))))))
      (for-each (lambda (pr)
                  (let ((p (root (+ (vector-ref offsets (car (car pr))) (cdr (car pr)))))
                        (q (root (+ (vector-ref offsets (car (cdr pr))) (cdr (cdr pr))))))
                    (if (not (= p q)) (vector-set! parent (max p q) (min p q)))))
                pairs)
      (let ((class-of-root (make-vector total #f)) (table (make-vector total 0)) (reps '()) (k 0))
        (let loop ((x 0))
          (if (< x n)
              (begin
                (let inner ((i 0))
                  (if (< i (vector-ref sizes x))
                      (let ((r (root (+ (vector-ref offsets x) i))))
                        (if (not (vector-ref class-of-root r))
                            (begin (vector-set! class-of-root r k) (set! reps (cons (cons x i) reps)) (set! k (+ k 1))))
                        (vector-set! table (+ (vector-ref offsets x) i) (vector-ref class-of-root r))
                        (inner (+ i 1)))))
                (loop (+ x 1)))))
        (vector 'set-colimit sizes offsets table (reverse reps))))))
;; colim X = the disjoint union of the X(c) modulo (x, i) ~ (y, X(a) i)
(define (set-colimit X)
  (let ((C (set-functor-category X)))
    (cs-quotient (list->vector (set-functor-sizes X))
                 (apply append
                        (map (lambda (a)
                               (map (lambda (i) (cons (cons (arrow-source C a) i) (cons (arrow-target C a) (set-functor-apply-index X a i))))
                                    (cs-range (set-functor-element-count X (arrow-source C a)))))
                             (cs-arrows C))))))
(define (set-colimit-size co) (length (vector-ref co 4)))
(define (set-colimit-class co c i) (vector-ref (vector-ref co 3) (+ (vector-ref (vector-ref co 2) c) i)))
;; one (c . i) per class, in class order
(define (set-colimit-representatives co) (vector-ref co 4))

;; ---------------------------------------------------------------------------
;; Ends and coends of bifunctors H : C^op x C -> Set
;; ---------------------------------------------------------------------------
(define (cs-diag C c) (+ (* c (category-object-count C)) c))
(define (cs-parr C f g) (+ (* f (category-arrow-count C)) g))
;; families (x_c in H(c, c)) with H(c, f)(x_c) = H(f, c')(x_c') in H(c, c')
;; for every f : c -> c'
(define (set-end C H)
  (let* ((n (category-object-count C)) (sizes (list->vector (map (lambda (c) (set-functor-element-count H (cs-diag C c))) (cs-objects C))))
         (nonid (filter (lambda (f) (not (= f (category-identity C (arrow-source C f))))) (cs-arrows C)))
         (acc '()))
    (let search ((p 0) (a (make-vector n #f)))
      (if (= p n) (set! acc (cons (vector-copy a) acc))
          (let try ((v 0))
            (if (< v (vector-ref sizes p))
                (begin
                  (vector-set! a p v)
                  (if (cs-all? (lambda (f)
                                 (let ((c (arrow-source C f)) (c2 (arrow-target C f)))
                                   (or (> c p) (> c2 p)
                                       (= (set-functor-apply-index H (cs-parr C (category-identity C c) f) (vector-ref a c))
                                          (set-functor-apply-index H (cs-parr C f (category-identity C c2)) (vector-ref a c2))))))
                               nonid)
                      (search (+ p 1) a))
                  (vector-set! a p #f)
                  (try (+ v 1)))))))
    (reverse acc)))
;; the disjoint union of the H(c, c) modulo H(f, c)(y) ~ H(c', f)(y) for
;; f : c -> c' and y in H(c', c); a set-colimit record over the objects of C
(define (set-coend C H)
  (cs-quotient (list->vector (map (lambda (c) (set-functor-element-count H (cs-diag C c))) (cs-objects C)))
               (apply append
                      (map (lambda (f)
                             (let ((c (arrow-source C f)) (c2 (arrow-target C f)))
                               (map (lambda (y) (cons (cons c (set-functor-apply-index H (cs-parr C f (category-identity C c)) y))
                                                      (cons c2 (set-functor-apply-index H (cs-parr C (category-identity C c2) f) y))))
                                    (cs-range (set-functor-element-count H (+ (* c2 (category-object-count C)) c))))))
                           (cs-arrows C)))))
(define (set-coend-class co c i) (set-colimit-class co c i))
;; Nat(X, Y) = int_c Y(c)^X(c): the bifunctor of functions X(c') -> Y(c) as
;; index vectors, and its end, returned as transformations (Mac Lane IX.5)
(define (cs-functions m k)
  (if (= m 0) (list '())
      (let ((rest (cs-functions (- m 1) k))) (apply append (map (lambda (v) (map (lambda (r) (cons v r)) rest)) (cs-range k))))))
(define (set-natural-transformations-end X Y)
  (let* ((C (set-functor-category X)) (n (category-object-count C)) (P (category-product (category-opposite C) C))
         (H (make-set-functor P
                              (map (lambda (o) (cs-functions (set-functor-element-count X (quotient o n)) (set-functor-element-count Y (remainder o n)))) (cs-objects P))
                              (lambda (k phi)
                                (let ((f (car (arrow-name P k))) (g (cadr (arrow-name P k))))
                                  (map (lambda (i) (set-functor-apply-index Y g (list-ref phi (set-functor-apply-index X f i))))
                                       (cs-range (set-functor-element-count X (arrow-source C f)))))))))
    (map (lambda (fam) (list->vector (map (lambda (c) (list->vector (list-ref (set-functor-elements H (cs-diag C c)) (vector-ref fam c)))) (cs-objects C))))
         (set-end C H))))

;; ---------------------------------------------------------------------------
;; Natural transformations
;; ---------------------------------------------------------------------------
(define (set-natural? X Y eta)
  (let ((C (set-functor-category X)))
    (cs-all? (lambda (a)
               (let ((x (arrow-source C a)) (y (arrow-target C a)))
                 (cs-all? (lambda (i) (= (vector-ref (vector-ref eta y) (set-functor-apply-index X a i))
                                         (set-functor-apply-index Y a (vector-ref (vector-ref eta x) i))))
                          (cs-range (set-functor-element-count X x)))))
             (cs-arrows C))))
;; variables: the elements (c, i) of X, domain Y(c); an arrow a : c -> c'
;; forces eta(c', X(a) i) = Y(a)(eta(c, i))
(define (cs-nat-problem X Y)
  (let* ((C (set-functor-category X)) (n (category-object-count C))
         (offs (let ((o (make-vector (+ n 1) 0))) (let loop ((c 0)) (if (< c n) (begin (vector-set! o (+ c 1) (+ (vector-ref o c) (set-functor-element-count X c))) (loop (+ c 1))))) o))
         (total (vector-ref offs n)) (sizes (make-vector total 0)) (out (make-vector total '())))
    (for-each (lambda (c) (for-each (lambda (i) (vector-set! sizes (+ (vector-ref offs c) i) (set-functor-element-count Y c))) (cs-range (set-functor-element-count X c))))
              (cs-objects C))
    (for-each (lambda (a)
                (let ((c (arrow-source C a)) (c2 (arrow-target C a)))
                  (if (not (= a (category-identity C c)))
                      (for-each (lambda (i)
                                  (let ((v (+ (vector-ref offs c) i)))
                                    (vector-set! out v (cons (cons (+ (vector-ref offs c2) (set-functor-apply-index X a i)) (vector-ref (vector-ref Y 3) a))
                                                             (vector-ref out v)))))
                                (cs-range (set-functor-element-count X c))))))
              (cs-arrows C))
    (list offs sizes out)))
(define (set-natural-transformations X Y)
  (let* ((C (set-functor-category X)) (pr (cs-nat-problem X Y)) (offs (car pr)))
    (map (lambda (sol) (list->vector (map (lambda (c) (list->vector (map (lambda (i) (vector-ref sol (+ (vector-ref offs c) i))) (cs-range (set-functor-element-count X c)))))
                                          (cs-objects C))))
         (cs-solve (cadr pr) (caddr pr) #t))))
(define (set-natural-transformation-count X Y) (let ((pr (cs-nat-problem X Y))) (cs-solve (cadr pr) (caddr pr) #f)))
(define (set-identity-transformation X)
  (list->vector (map (lambda (c) (list->vector (cs-range (set-functor-element-count X c)))) (cs-objects (set-functor-category X)))))
;; theta . eta (first eta, then theta)
(define (set-transformation-compose theta eta)
  (list->vector (map (lambda (c) (let ((e (vector-ref eta c)) (t (vector-ref theta c)))
                                   (list->vector (map (lambda (i) (vector-ref t (vector-ref e i))) (cs-range (vector-length e))))))
                     (cs-range (vector-length eta)))))
(define (set-transformation-identity? eta)
  (cs-all? (lambda (c) (let ((e (vector-ref eta c))) (cs-all? (lambda (i) (eqv? i (vector-ref e i))) (cs-range (vector-length e)))))
           (cs-range (vector-length eta))))
(define (set-transformation-bijective? X Y eta)
  (cs-all? (lambda (c) (let ((e (vector->list (vector-ref eta c))) (m (set-functor-element-count Y c)))
                         (and (= m (length e))
                              (cs-all? (lambda (j) (memv j e)) (cs-range m)))))
           (cs-objects (set-functor-category X))))
(define (set-natural-isomorphism? X Y eta) (and (set-natural? X Y eta) (set-transformation-bijective? X Y eta)))

;; ---------------------------------------------------------------------------
;; The Yoneda lemma: Nat(C(c, -), X) ~ X(c), theta |-> theta_c(id_c)
;; ---------------------------------------------------------------------------
(define (yoneda-element X c theta)
  (let ((C (set-functor-category X)))
    (vector-ref (vector-ref theta c) (cs-position (category-identity C c) (category-hom C c c)))))
;; the transformation C(c, -) => X with u |-> X(u)(x_i)
(define (yoneda-transformation X c i)
  (let ((C (set-functor-category X)))
    (list->vector (map (lambda (d) (list->vector (map (lambda (u) (set-functor-apply-index X u i)) (category-hom C c d)))) (cs-objects C)))))
;; (count n m) when |Nat(C(c,-), X)| /= |X(c)|, (not-natural i), (round-trip i),
;; (not-surjective theta): the bijection checked by counting and explicitly
(define (yoneda-violations X c)
  (let* ((C (set-functor-category X)) (h (corepresentable-set-functor C c))
         (nats (set-natural-transformations h X)) (out '()))
    (if (not (= (length nats) (set-functor-element-count X c))) (set! out (cons (list 'count (length nats) (set-functor-element-count X c)) out)))
    (for-each (lambda (i)
                (let ((theta (yoneda-transformation X c i)))
                  (if (not (set-natural? h X theta)) (set! out (cons (list 'not-natural i) out))
                      (if (not (= i (yoneda-element X c theta))) (set! out (cons (list 'round-trip i) out))))))
              (cs-range (set-functor-element-count X c)))
    (for-each (lambda (theta) (if (not (equal? theta (yoneda-transformation X c (yoneda-element X c theta))))
                                  (set! out (cons (list 'not-surjective theta) out))))
              nats)
    (reverse out)))
;; Nat(y(c), F) ~ F(c) for a presheaf F: y(c) = C(-, c) is C^op(c, -)
(define (presheaf-yoneda-violations F c) (yoneda-violations (presheaf->set-functor F) c))

;; ---------------------------------------------------------------------------
;; Categories of elements
;; ---------------------------------------------------------------------------
;; int X for X : C -> Set: objects (c i), arrows (a i) : (c i) -> (c', X(a) i)
(define (elements-category X)
  (let* ((C (set-functor-category X))
         (objs (apply append (map (lambda (c) (map (lambda (i) (list c i)) (cs-range (set-functor-element-count X c)))) (cs-objects C))))
         (oidx (let ((t (make-hash-table))) (let loop ((l objs) (k 0)) (if (null? l) t (begin (hash-table-set! t (car l) k) (loop (cdr l) (+ k 1)))))))
         (arrows (apply append (map (lambda (a) (map (lambda (i) (vector (hash-table-ref/default oidx (list (arrow-source C a) i) #f)
                                                                          (hash-table-ref/default oidx (list (arrow-target C a) (set-functor-apply-index X a i)) #f)
                                                                          (list a i)))
                                                       (cs-range (set-functor-element-count X (arrow-source C a)))))
                                    (cs-arrows C))))
         (av (list->vector arrows))
         (aidx (let ((t (make-hash-table))) (let loop ((k 0)) (if (< k (vector-length av)) (begin (hash-table-set! t (vector-ref (vector-ref av k) 2) k) (loop (+ k 1))))) t)))
    (make-finite-category (length objs) arrows
                          (lambda (k2 k1) (let ((n1 (vector-ref (vector-ref av k1) 2)) (n2 (vector-ref (vector-ref av k2) 2)))
                                            (hash-table-ref/default aidx (list (category-compose C (car n2) (car n1)) (cadr n1)) #f)))
                          (map (lambda (o) (hash-table-ref/default aidx (list (category-identity C (car o)) (cadr o)) #f)) objs)
                          objs)))
(define (elements-projection X E)
  (make-functor E (set-functor-category X) (map (lambda (o) (car (category-object-label E o))) (cs-objects E))
                (map (lambda (k) (car (arrow-name E k))) (cs-arrows E))))
;; int F for a presheaf F on C: objects (c i), arrows (a i) : (d F(a) i) -> (c i)
(define (presheaf-elements-category F)
  (let* ((C (presheaf-category F))
         (objs (apply append (map (lambda (c) (map (lambda (i) (list c i)) (cs-range (presheaf-element-count F c)))) (cs-objects C))))
         (oidx (let ((t (make-hash-table))) (let loop ((l objs) (k 0)) (if (null? l) t (begin (hash-table-set! t (car l) k) (loop (cdr l) (+ k 1)))))))
         (arrows (apply append (map (lambda (a) (map (lambda (i) (vector (hash-table-ref/default oidx (list (arrow-source C a) (presheaf-restrict-index F a i)) #f)
                                                                          (hash-table-ref/default oidx (list (arrow-target C a) i) #f)
                                                                          (list a i)))
                                                       (cs-range (presheaf-element-count F (arrow-target C a)))))
                                    (cs-arrows C))))
         (av (list->vector arrows))
         (aidx (let ((t (make-hash-table))) (let loop ((k 0)) (if (< k (vector-length av)) (begin (hash-table-set! t (vector-ref (vector-ref av k) 2) k) (loop (+ k 1))))) t)))
    (make-finite-category (length objs) arrows
                          (lambda (k2 k1) (let ((n1 (vector-ref (vector-ref av k1) 2)) (n2 (vector-ref (vector-ref av k2) 2)))
                                            (hash-table-ref/default aidx (list (category-compose C (car n2) (car n1)) (cadr n2)) #f)))
                          (map (lambda (o) (hash-table-ref/default aidx (list (category-identity C (car o)) (cadr o)) #f)) objs)
                          objs)))
(define (presheaf-elements-projection F E)
  (make-functor E (presheaf-category F) (map (lambda (o) (car (category-object-label E o))) (cs-objects E))
                (map (lambda (k) (car (arrow-name E k))) (cs-arrows E))))
;; P : E -> C is a discrete opfibration when every arrow out of P(e) has
;; exactly one lift out of e (a discrete fibration: every arrow into P(e)
;; has exactly one lift into e)
(define (discrete-opfibration? P)
  (let ((E (functor-source P)) (C (functor-target P)))
    (cs-all? (lambda (e) (cs-all? (lambda (a) (= 1 (length (filter (lambda (k) (= a (functor-arrow P k))) (category-arrows-from E e)))))
                                  (category-arrows-from C (functor-object P e))))
             (cs-objects E))))
(define (discrete-fibration? P)
  (let ((E (functor-source P)) (C (functor-target P)))
    (cs-all? (lambda (e) (cs-all? (lambda (a) (= 1 (length (filter (lambda (k) (= a (functor-arrow P k))) (category-arrows-into E e)))))
                                  (category-arrows-into C (functor-object P e))))
             (cs-objects E))))

;; ---------------------------------------------------------------------------
;; Kan extensions along F : C -> D, pointwise (Mac Lane X.3)
;; ---------------------------------------------------------------------------
;; per d: (K labels co) with K = (F | d), co the colimit of G P over K
(define (cs-lan-data F G)
  (let ((D (functor-target F)))
    (list->vector
     (map (lambda (d)
            (let* ((K (comma-category F (object-functor D d))) (GP (set-functor-restrict G (comma-domain-projection F K))))
              (list K (cs-label-table K) (set-colimit GP))))
          (cs-objects D)))))
;; Lan_F G: elements of Lan(d) are class representatives (c u x), u : F c -> d
(define (cs-lan-from-data F G data)
  (let ((D (functor-target F)))
    (make-set-functor-from-indices
     D
     (map (lambda (d) (let ((K (car (vector-ref data d))) (co (caddr (vector-ref data d))))
                        (map (lambda (r) (let ((lab (category-object-label K (car r))))
                                           (list (car lab) (caddr lab) (list-ref (set-functor-elements G (car lab)) (cdr r)))))
                             (set-colimit-representatives co))))
          (cs-objects D))
     (map (lambda (v)
            (let* ((d (arrow-source D v)) (K (car (vector-ref data d))) (co (caddr (vector-ref data d)))
                   (tab2 (cadr (vector-ref data (arrow-target D v)))) (co2 (caddr (vector-ref data (arrow-target D v)))))
              (list->vector (map (lambda (r) (let ((lab (category-object-label K (car r))))
                                               (set-colimit-class co2 (hash-table-ref/default tab2 (list (car lab) 0 (category-compose D v (caddr lab))) #f) (cdr r))))
                                 (set-colimit-representatives co)))))
          (cs-arrows D)))))
(define (set-lan F G) (cs-lan-from-data F G (cs-lan-data F G)))
;; per d: (K labels fams) with K = (d | F), fams the limit of G Q over K
(define (cs-ran-data F G)
  (let ((D (functor-target F)))
    (list->vector
     (map (lambda (d)
            (let* ((K (comma-category (object-functor D d) F)) (GQ (set-functor-restrict G (comma-codomain-projection F K))))
              (list K (cs-label-table K) (set-limit GQ))))
          (cs-objects D)))))
;; Ran_F G: elements of Ran(d) are families, listed as the elements x_(c,u) of
;; G(c) in the order of the objects (0 c u), u : d -> F c, of (d | F)
(define (cs-ran-from-data F G data)
  (let ((D (functor-target F)))
    (make-set-functor-from-indices
     D
     (map (lambda (d) (let ((K (car (vector-ref data d))))
                        (map (lambda (fam) (map (lambda (k) (list-ref (set-functor-elements G (cadr (category-object-label K k))) (vector-ref fam k)))
                                                (cs-objects K)))
                             (caddr (vector-ref data d)))))
          (cs-objects D))
     (map (lambda (v)
            (let* ((d (arrow-source D v)) (d2 (arrow-target D v)) (tab (cadr (vector-ref data d)))
                   (K2 (car (vector-ref data d2))) (fams2 (caddr (vector-ref data d2))))
              (list->vector
               (map (lambda (fam)
                      (cs-position (list->vector (map (lambda (k2) (let ((lab (category-object-label K2 k2)))
                                                                     (vector-ref fam (hash-table-ref/default tab (list 0 (cadr lab) (category-compose D (caddr lab) v)) #f))))
                                                      (cs-objects K2)))
                                   fams2))
                    (caddr (vector-ref data d))))))
          (cs-arrows D)))))
(define (set-ran F G) (cs-ran-from-data F G (cs-ran-data F G)))

;; F^* on transformations: (F^* psi)_c = psi_{F c}
(define (set-restrict-map F psi) (list->vector (map (lambda (c) (vector-ref psi (functor-object F c))) (cs-objects (functor-source F)))))
;; unit G => F^* Lan_F G: x in G(c) |-> the class of ((c 0 id_{Fc}), x)
(define (set-lan-unit F G)
  (let ((data (cs-lan-data F G)) (D (functor-target F)))
    (list->vector (map (lambda (c) (let* ((dd (vector-ref data (functor-object F c)))
                                          (k (hash-table-ref/default (cadr dd) (list c 0 (category-identity D (functor-object F c))) #f)))
                                     (list->vector (map (lambda (i) (set-colimit-class (caddr dd) k i)) (cs-range (set-functor-element-count G c))))))
                       (cs-objects (functor-source F))))))
;; counit Lan_F F^* Y => Y: the class of ((c 0 u), y) |-> Y(u)(y)
(define (set-lan-counit F Y)
  (let* ((FY (set-functor-restrict Y F)) (data (cs-lan-data F FY)))
    (list->vector (map (lambda (d) (let* ((dd (vector-ref data d)) (K (car dd)))
                                     (list->vector (map (lambda (r) (set-functor-apply-index Y (caddr (category-object-label K (car r))) (cdr r)))
                                                        (set-colimit-representatives (caddr dd))))))
                       (cs-objects (functor-target F))))))
;; Lan_F(phi) : Lan_F G => Lan_F G' for phi : G => G'
(define (set-lan-map F phi G G2)
  (let ((data (cs-lan-data F G)) (data2 (cs-lan-data F G2)))
    (list->vector (map (lambda (d) (let ((K (car (vector-ref data d))) (co2 (caddr (vector-ref data2 d))))
                                     (list->vector (map (lambda (r) (set-colimit-class co2 (car r) (vector-ref (vector-ref phi (car (category-object-label K (car r)))) (cdr r))))
                                                        (set-colimit-representatives (caddr (vector-ref data d)))))))
                       (cs-objects (functor-target F))))))
;; unit Y => Ran_F F^* Y: y |-> (Y(u)(y)) over (0 c u) in (d | F)
(define (set-ran-unit F Y)
  (let* ((FY (set-functor-restrict Y F)) (data (cs-ran-data F FY)))
    (list->vector (map (lambda (d) (let* ((dd (vector-ref data d)) (K (car dd)))
                                     (list->vector (map (lambda (i) (cs-position (list->vector (map (lambda (k) (set-functor-apply-index Y (caddr (category-object-label K k)) i)) (cs-objects K)))
                                                                                 (caddr dd)))
                                                        (cs-range (set-functor-element-count Y d))))))
                       (cs-objects (functor-target F))))))
;; counit F^* Ran_F G => G: a family on (F c | F) |-> its value at (0 c id)
(define (set-ran-counit F G)
  (let ((data (cs-ran-data F G)) (D (functor-target F)))
    (list->vector (map (lambda (c) (let* ((dd (vector-ref data (functor-object F c)))
                                          (k (hash-table-ref/default (cadr dd) (list 0 c (category-identity D (functor-object F c))) #f)))
                                     (list->vector (map (lambda (fam) (vector-ref fam k)) (caddr dd)))))
                       (cs-objects (functor-source F))))))
;; Ran_F(phi) : Ran_F G => Ran_F G'
(define (set-ran-map F phi G G2)
  (let ((data (cs-ran-data F G)) (data2 (cs-ran-data F G2)))
    (list->vector (map (lambda (d) (let ((K (car (vector-ref data d))))
                                     (list->vector (map (lambda (fam) (cs-position (list->vector (map (lambda (k) (vector-ref (vector-ref phi (cadr (category-object-label K k))) (vector-ref fam k))) (cs-objects K)))
                                                                                   (caddr (vector-ref data2 d))))
                                                        (caddr (vector-ref data d))))))
                       (cs-objects (functor-target F))))))
;; Lan -| F^*: (unit-natural) (counit-natural) (triangle-lan d) when
;; eps_{Lan G} o Lan(eta_G) /= id, (triangle-restrict c) when
;; F^*(eps_Y) o eta_{F^* Y} /= id
(define (set-lan-adjunction-violations F G Y)
  (let* ((L (set-lan F G)) (FY (set-functor-restrict Y F)) (out '())
         (eta (set-lan-unit F G)) (epsY (set-lan-counit F Y)))
    (if (not (set-natural? G (set-functor-restrict L F) eta)) (set! out (cons (list 'unit-natural) out)))
    (if (not (set-natural? (set-lan F FY) Y epsY)) (set! out (cons (list 'counit-natural) out)))
    (let ((t1 (set-transformation-compose (set-lan-counit F L) (set-lan-map F eta G (set-functor-restrict L F)))))
      (for-each (lambda (d) (if (not (set-transformation-identity? (vector (vector-ref t1 d)))) (set! out (cons (list 'triangle-lan d) out))))
                (cs-objects (functor-target F))))
    (let ((t2 (set-transformation-compose (set-restrict-map F epsY) (set-lan-unit F FY))))
      (for-each (lambda (c) (if (not (set-transformation-identity? (vector (vector-ref t2 c)))) (set! out (cons (list 'triangle-restrict c) out))))
                (cs-objects (functor-source F))))
    (reverse out)))
;; F^* -| Ran: (triangle-restrict c) when eps_{F^* Y} o F^*(eta_Y) /= id,
;; (triangle-ran d) when Ran(eps_G) o eta_{Ran G} /= id
(define (set-ran-adjunction-violations F Y G)
  (let* ((R (set-ran F G)) (FY (set-functor-restrict Y F)) (out '())
         (etaY (set-ran-unit F Y)) (epsG (set-ran-counit F G)))
    (if (not (set-natural? Y (set-ran F FY) etaY)) (set! out (cons (list 'unit-natural) out)))
    (if (not (set-natural? (set-functor-restrict R F) G epsG)) (set! out (cons (list 'counit-natural) out)))
    (let ((t1 (set-transformation-compose (set-ran-counit F FY) (set-restrict-map F etaY))))
      (for-each (lambda (c) (if (not (set-transformation-identity? (vector (vector-ref t1 c)))) (set! out (cons (list 'triangle-restrict c) out))))
                (cs-objects (functor-source F))))
    (let ((t2 (set-transformation-compose (set-ran-map F epsG (set-functor-restrict R F) G) (set-ran-unit F R))))
      (for-each (lambda (d) (if (not (set-transformation-identity? (vector (vector-ref t2 d)))) (set! out (cons (list 'triangle-ran d) out))))
                (cs-objects (functor-target F))))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; Kan extensions by the (co)end formulas (Mac Lane X.4, Kelly 4.1-4.2)
;; ---------------------------------------------------------------------------
;; Lan_F G(d) = int^c D(F c, d) x G(c): elements of H_d(c', c) are (u x)
(define (cs-lan-coend-at F G P d)
  (let* ((C (functor-source F)) (D (functor-target F)) (n (category-object-count C))
         (H (make-set-functor P
                              (map (lambda (o) (apply append (map (lambda (u) (map (lambda (x) (list u x)) (set-functor-elements G (remainder o n))))
                                                                  (category-hom D (functor-object F (quotient o n)) d))))
                                   (cs-objects P))
                              (lambda (k ux) (let ((f (car (arrow-name P k))) (g (cadr (arrow-name P k))))
                                               (list (category-compose D (car ux) (functor-arrow F f)) (set-functor-apply G g (cadr ux))))))))
    (cons H (set-coend C H))))
(define (set-lan-coend F G)
  (let* ((C (functor-source F)) (D (functor-target F)) (P (category-product (category-opposite C) C))
         (data (list->vector (map (lambda (d) (cs-lan-coend-at F G P d)) (cs-objects D)))))
    (make-set-functor-from-indices
     D
     (map (lambda (d) (let ((H (car (vector-ref data d))))
                        (map (lambda (r) (cons (car r) (list-ref (set-functor-elements H (cs-diag C (car r))) (cdr r))))
                             (set-colimit-representatives (cdr (vector-ref data d))))))
          (cs-objects D))
     (map (lambda (v)
            (let* ((d (arrow-source D v)) (H (car (vector-ref data d))) (co (cdr (vector-ref data d)))
                   (H2 (car (vector-ref data (arrow-target D v)))) (co2 (cdr (vector-ref data (arrow-target D v)))))
              (list->vector (map (lambda (r) (let ((ux (list-ref (set-functor-elements H (cs-diag C (car r))) (cdr r))))
                                               (set-colimit-class co2 (car r) (set-functor-element-index H2 (cs-diag C (car r)) (list (category-compose D v (car ux)) (cadr ux))))))
                                 (set-colimit-representatives co)))))
          (cs-arrows D)))))
;; Ran_F G(d) = int_c G(c)^D(d, F c): elements of H_d(c', c) are lists of
;; elements of G(c) indexed by D(d, F c') in category-hom order
(define (cs-ran-end-at F G P d)
  (let* ((C (functor-source F)) (D (functor-target F)) (n (category-object-count C))
         (H (make-set-functor P
                              (map (lambda (o) (let ((hs (category-hom D d (functor-object F (quotient o n)))) (xs (set-functor-elements G (remainder o n))))
                                                 (map (lambda (idx) (map (lambda (j) (list-ref xs j)) idx)) (cs-functions (length hs) (length xs)))))
                                   (cs-objects P))
                              (lambda (k phi) (let* ((f (car (arrow-name P k))) (g (cadr (arrow-name P k)))
                                                     (hs1 (category-hom D d (functor-object F (arrow-target C f)))) ;; f : c'2 -> c'1 in C
                                                     (hs2 (category-hom D d (functor-object F (arrow-source C f)))))
                                                (map (lambda (w) (set-functor-apply G g (list-ref phi (cs-position (category-compose D (functor-arrow F f) w) hs1)))) hs2))))))
    (cons H (set-end C H))))
(define (set-ran-end F G)
  (let* ((C (functor-source F)) (D (functor-target F)) (P (category-product (category-opposite C) C))
         (data (list->vector (map (lambda (d) (cs-ran-end-at F G P d)) (cs-objects D))))
         (value (lambda (d fam) (let ((H (car (vector-ref data d))))
                                  (map (lambda (c) (list-ref (set-functor-elements H (cs-diag C c)) (vector-ref fam c))) (cs-objects C))))))
    (make-set-functor-from-indices
     D
     (map (lambda (d) (map (lambda (fam) (value d fam)) (cdr (vector-ref data d)))) (cs-objects D))
     (map (lambda (v)
            (let* ((d (arrow-source D v)) (d2 (arrow-target D v)))
              (list->vector
               (map (lambda (fam)
                      (let ((phis (value d fam)))
                        (cs-position (map (lambda (c phi) (let ((hs (category-hom D d (functor-object F c))))
                                                            (map (lambda (w) (list-ref phi (cs-position (category-compose D w v) hs)))
                                                                 (category-hom D d2 (functor-object F c)))))
                                          (cs-objects C) phis)
                                     (map (lambda (fam2) (value d2 fam2)) (cdr (vector-ref data d2))))))
                    (cdr (vector-ref data d))))))
          (cs-arrows D)))))
;; the comparison Lan_F G => set-lan-coend: the class of ((c 0 u), x) |-> the
;; class of (u x) in H(c, c); the coend's elements are listed in class order,
;; so the class index is the element index. A natural isomorphism (checked
;; by the caller with set-natural-isomorphism?).
(define (set-lan-comparison F G)
  (let* ((L (set-lan F G)) (C (functor-source F)) (D (functor-target F)) (P (category-product (category-opposite C) C)))
    (list->vector
     (map (lambda (d)
            (let* ((hc (cs-lan-coend-at F G P d)) (H (car hc)) (co (cdr hc)))
              (list->vector (map (lambda (e) (set-coend-class co (car e) (set-functor-element-index H (cs-diag C (car e)) (list (cadr e) (caddr e)))))
                                 (set-functor-elements L d)))))
          (cs-objects D)))))
;; the comparison Ran_F G => set-ran-end: the family (x_(c,u)) |-> (u |-> x_(c,u))_c
(define (set-ran-comparison F G)
  (let* ((R (set-ran F G)) (Re (set-ran-end F G)) (C (functor-source F)) (D (functor-target F)))
    (list->vector
     (map (lambda (d)
            (let ((K (comma-category (object-functor D d) F)))
              (list->vector
               (map (lambda (xs)
                      (cs-position (map (lambda (c) (map (lambda (u) (list-ref xs (category-object-of-label K (list 0 c u)))) (category-hom D d (functor-object F c))))
                                        (cs-objects C))
                                   (set-functor-elements Re d)))
                    (set-functor-elements R d)))))
          (cs-objects D)))))
