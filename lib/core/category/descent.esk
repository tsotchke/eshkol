;;; core.category.descent -- descent and sheafification as category theory
;;; on core.sheaf's finite sites: the matching-family limit over the
;;; category of a sieve, descent as a right Kan extension, the Cech
;;; equalizer form, the sheaf condition decided through limits, and
;;; sheafification as the reflector a -| i with its unit, counit, triangle
;;; identities, universal property and idempotent monad.
;;;
;;; Usage: (require core.category.descent)   or   (require core.category)
;;;
;;; Sources: S. Mac Lane, I. Moerdijk, "Sheaves in Geometry and Logic" (1992),
;;; I.4 and III.4 (matching families; Match(S, F) = Nat(S, F); the sheaf
;;; condition for a sieve generated by a family as an equalizer), III.5
;;; (the plus construction; Theorem III.5.1: a = (-)^{++} is left adjoint to
;;; the inclusion i of sheaves, Lemma III.5.3), V.3 (a preserves finite
;;; limits; i a is an idempotent monad); P. T. Johnstone, "Sketches of an
;;; Elephant" (2002), A4.4 (reflective subcategories), C2.1-C2.2 (sheaves on
;;; a site; F is a sheaf when F(c) -> lim_{(int S)^op} F is a bijection for
;;; every covering sieve, i.e. when F is local for the sieve inclusions);
;;; E. Riehl, "Category Theory in Context" (2016), 4.5 and 6.2; nLab:
;;; "sieve", "sheaf", "sheafification", "plus construction on presheaves",
;;; "reflective subcategory", "idempotent monad", "Cech cover", "descent".
;;;
;;; The category of a sieve S on c is the full subcategory of the slice C/c
;;; on the arrows of S (Mac Lane-Moerdijk I.4); its domain functor
;;; pi : int S -> C gives Match(S, F) = lim_{(int S)^op} F pi^op, which is
;;; the value at S of the right Kan extension of F along the Yoneda
;;; embedding (F extended to presheaves P by Nat(P, F)). On a thin site the
;;; same limit is the right Kan extension of F, restricted to the objects of
;;; the sieve, along their inclusion, evaluated at c.
;;;
;;; Abelian descent (Mac Lane-Moerdijk III.4; R. W. Thomason, Math. Proc.
;;; Camb. Phil. Soc. 85 (1979); A. K. Bousfield, D. M. Kan, LNM 304, XI-XII):
;;; for a cover {U_i} of an object of a thin site with meets, the nerve
;;; category of the cover has the nonempty index sets J with an arrow K -> J
;;; when J is contained in K; Cech cohomology is lim^n over it of
;;; J |-> F(U_J). For a finite space, the Grothendieck construction of
;;; J |-> (the points of U_J) has a nerve equivalent to the space
;;; (hocolim over the cover), so lim^n over it of the stalks is the sheaf
;;; cohomology for every cover, Leray or not: cohomological descent as a
;;; derived limit. The Grothendieck construction of J |-> pi_0(U_J) is the
;;; face category of the Cech nerve C(U) (cells (J, component)).
;;;
;;; Transformations are vectors c -> vector of indices, as in core.sheaf's
;;; presheaf-natural? and core.category.set.

(require stdlib)
(require core.sheaf.site)
(require core.sheaf.glue)
(require core.sheaf.presheaf)
(require core.category.finite)
(require core.category.functor)
(require core.category.set)
(require core.integer_linalg)
(require core.sheaf.module)
(require core.category.linear)

(provide category-components cover-nerve-category cech-derived-limits
         finite-space-cover-descent-category finite-space-cech-nerve-category cech-nerve-cell-counts
         module-sieve-limit module-sheaf-at-by-limit module-sieve-unit-shape
         finite-space-cover-sections-presheaf finite-space-sections
 sieve-category sieve-matching-limit sieve-descent-violations
         presheaf-ran-along-inclusion
         cech-equalizer cech-descent-violations
         presheaf-sheaf-violations-by-limit
         presheaf-plus-map sheafification-unit sheafify-map sheafification-counit
         sheafification-adjunction-violations sheafification-monad-violations)

(define (cd-range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (cd-all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (cd-all? pred (cdr xs))) (else #f)))
(define (cd-dedup xs)
  (let loop ((l xs) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (else (loop (cdr l) (cons (car l) acc))))))
(define (cd-same-set? A B) (and (cd-all? (lambda (x) (member x B)) A) (cd-all? (lambda (x) (member x A)) B)))

;; ---------------------------------------------------------------------------
;; Sieves as categories; Match(S, F) as a limit
;; ---------------------------------------------------------------------------
;; (K . pi): K the full subcategory of C/c on the arrows of S (object labels
;; (d 0 f), f in S), pi : K -> C the domain functor
(define (sieve-category C c S)
  (let* ((sl (slice-category C c))
         (objs (filter (lambda (o) (memv (caddr (category-object-label sl o)) S)) (cd-range (category-object-count sl))))
         (inc (inclusion-functor sl objs)))
    (cons (car inc) (functor-compose (comma-domain-projection (identity-functor C) sl) (cdr inc)))))
;; the limit of F pi^op over (int S)^op, each element returned as a family
;; ((f . x_f) ...) in the order of S
(define (sieve-matching-limit F c S)
  (let* ((C (presheaf-category F)) (sc (sieve-category C c S)) (K (car sc)) (pi (cdr sc))
         (X (set-functor-restrict (presheaf->set-functor F) (functor-opposite pi)))
         (kof (lambda (f) (let loop ((k 0)) (if (= f (caddr (category-object-label K k))) k (loop (+ k 1)))))))
    (map (lambda (fam) (map (lambda (f) (let ((k (kof f))) (cons f (list-ref (set-functor-elements X k) (vector-ref fam k))))) S))
         (set-limit X))))
;; (count n m) when |lim| /= |Match(S, F)|, (not-in-match fam) for a limit
;; element that is not a matching family of core.sheaf.presheaf
(define (sieve-descent-violations F c S)
  (let* ((lim (sieve-matching-limit F c S)) (match (matching-families F c S)) (out '()))
    (if (not (= (length lim) (length match))) (set! out (cons (list 'count (length lim) (length match)) out)))
    (for-each (lambda (fam) (if (not (member fam match)) (set! out (cons (list 'not-in-match fam) out)))) lim)
    (reverse out)))
;; Ran along j^op of F restricted to the full subcategory on objs, as a
;; set-functor on C^op; its value at c is Match on the sieve generated by
;; objs when C is thin
(define (presheaf-ran-along-inclusion F objs)
  (let* ((C (presheaf-category F)) (inc (inclusion-functor C objs)) (jop (functor-opposite (cdr inc))))
    (set-ran jop (set-functor-restrict (presheaf->set-functor F) jop))))

;; ---------------------------------------------------------------------------
;; The Cech equalizer
;; ---------------------------------------------------------------------------
;; For arrows f_i : U_i -> c, the families (x_i in F(U_i)) with
;; F(g) x_i = F(h) x_j whenever f_i g = f_j h (g : V -> U_i, h : V -> U_j):
;; the equalizer of prod_i F(U_i) => prod_{i,j} prod_{(g,h)} F(V). Each
;; family is the list of its elements.
(define (cech-equalizer F c arrows)
  (let* ((C (presheaf-category F)) (fv (list->vector arrows)) (n (vector-length fv))
         (spans (lambda (i j)
                  (apply append
                         (map (lambda (g) (map (lambda (h) (cons g h))
                                               (filter (lambda (h) (and (= (arrow-source C h) (arrow-source C g))
                                                                        (eqv? (category-compose C (vector-ref fv i) g) (category-compose C (vector-ref fv j) h))))
                                                       (category-arrows-into C (arrow-source C (vector-ref fv j))))))
                              (category-arrows-into C (arrow-source C (vector-ref fv i)))))))
         (sp (list->vector (map (lambda (j) (list->vector (map (lambda (i) (spans i j)) (cd-range (+ j 1))))) (cd-range n))))
         (acc '()))
    (let search ((j 0) (xs '()))
      (if (= j n) (set! acc (cons (reverse xs) acc))
          (for-each (lambda (x)
                      (let ((all (reverse (cons x xs))))
                        (if (cd-all? (lambda (i)
                                       (cd-all? (lambda (gh) (equal? (presheaf-restrict F (car gh) (list-ref all i))
                                                                     (presheaf-restrict F (cdr gh) x)))
                                                (vector-ref (vector-ref sp j) i)))
                                     (cd-range (+ j 1)))
                            (search (+ j 1) (cons x xs)))))
                    (presheaf-elements F (arrow-source C (vector-ref fv j))))))
    (reverse acc)))
;; Match(S, F) -> Eq, (x_f) |-> (x_{f_i}), for S generated by the arrows:
;; (count m e), (not-in-equalizer fam), (not-injective)
(define (cech-descent-violations F c arrows)
  (let* ((C (presheaf-category F)) (S (sieve-generated C c arrows))
         (match (matching-families F c S)) (eq (cech-equalizer F c arrows))
         (image (map (lambda (fam) (map (lambda (f) (cdr (assv f fam))) arrows)) match)) (out '()))
    (if (not (= (length match) (length eq))) (set! out (cons (list 'count (length match) (length eq)) out)))
    (for-each (lambda (fam img) (if (not (member img eq)) (set! out (cons (list 'not-in-equalizer fam) out)))) match image)
    (if (not (= (length (cd-dedup image)) (length image))) (set! out (cons (list 'not-injective) out)))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; The sheaf condition as a limit
;; ---------------------------------------------------------------------------
;; the violations in the format of core.sheaf.presheaf's
;; presheaf-sheaf-violations, computed through sieve-matching-limit
(define (presheaf-sheaf-violations-by-limit site F)
  (let ((C (site-category site)) (out '()))
    (for-each
     (lambda (c)
       (for-each
        (lambda (S)
          (let* ((lim (sieve-matching-limit F c S))
                 (imgs (map (lambda (x) (restriction-family F S x)) (presheaf-elements F c)))
                 (unglued (filter (lambda (fam) (not (member fam imgs))) lim)))
            (if (< (length (cd-dedup imgs)) (length imgs)) (set! out (cons (list c S 'not-separated) out)))
            (if (not (null? unglued)) (set! out (cons (list c S 'not-glueing (length unglued)) out)))))
        (site-covering-sieves site c)))
     (cd-range (category-object-count C)))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; Sheafification as a reflector
;; ---------------------------------------------------------------------------
;; phi^+ : F^+ -> G^+ for phi : F -> G, on families: (x_h) |-> (phi(x_h))
(define (presheaf-plus-map site phi F G Fp Gp)
  (let ((C (site-category site)))
    (list->vector
     (map (lambda (c)
            (list->vector
             (map (lambda (fam)
                    (let ((i (presheaf-element-index
                              Gp c (map (lambda (pr) (let ((d (arrow-source C (car pr))))
                                                       (cons (car pr) (list-ref (presheaf-elements G d) (vector-ref (vector-ref phi d) (presheaf-element-index F d (cdr pr)))))))
                                        fam))))
                      (if (not i) (error "presheaf-plus-map: phi is not natural" c))
                      i))
                  (presheaf-elements Fp c))))
          (cd-range (category-object-count C))))))
;; eta : F -> a F = F^{++}, the composite of the two plus units
(define (sheafification-unit site F Fp Fpp)
  (set-transformation-compose (presheaf-unit-map site Fp Fpp) (presheaf-unit-map site F Fp)))
;; a(phi) : a F -> a G; pre = (Fp Fpp Gp Gpp) when already computed
(define (sheafify-map site phi F G . pre)
  (let* ((Fp (if (null? pre) (presheaf-plus site F) (car pre)))
         (Fpp (if (null? pre) (presheaf-plus site Fp) (cadr pre)))
         (Gp (if (null? pre) (presheaf-plus site G) (caddr pre)))
         (Gpp (if (null? pre) (presheaf-plus site Gp) (list-ref pre 3))))
    (presheaf-plus-map site (presheaf-plus-map site phi F G Fp Gp) Fp Gp Fpp Gpp)))
;; eps : a G -> G for a sheaf G: an element of G^{++}(c) is a matching family
;; of matching families; each inner family is glued in G, then the outer one
(define (sheafification-counit site G Gpp)
  (let ((C (site-category site)))
    (list->vector
     (map (lambda (c)
            (list->vector
             (map (lambda (outer)
                    (let* ((glued-inner (map (lambda (pr) (let* ((d (arrow-source C (car pr)))
                                                                 (r (glue-family G d (site-minimal-covering-sieve site d) (cdr pr))))
                                                            (if (not (glued? r)) (error "sheafification-counit: not a sheaf" (list d (gluing-obstructions r))))
                                                            (cons (car pr) (glued-value r))))
                                             outer))
                           (r (glue-family G c (site-minimal-covering-sieve site c) glued-inner)))
                      (if (not (glued? r)) (error "sheafification-counit: not a sheaf" (list c (gluing-obstructions r))))
                      (presheaf-element-index G c (glued-value r))))
                  (presheaf-elements Gpp c))))
          (cd-range (category-object-count C))))))
(define (cd-identity? eta) (set-transformation-identity? eta))
;; a -| i on (F, G), G a sheaf: (unit-natural) (counit-natural)
;; (triangle-a): eps_{aF} o a(eta_F) /= id, (triangle-i): eps_G o eta_G /= id,
;; (hom-count n m): |Nat(F, G)| /= |Nat(aF, G)|, (not-injective): psi |-> psi eta_F
(define (sheafification-adjunction-violations site F G)
  (let* ((Fp (presheaf-plus site F)) (Fpp (presheaf-plus site Fp)) (etaF (sheafification-unit site F Fp Fpp))
         (aFp (presheaf-plus site Fpp)) (aFpp (presheaf-plus site aFp))
         (Gp (presheaf-plus site G)) (Gpp (presheaf-plus site Gp))
         (etaG (sheafification-unit site G Gp Gpp)) (epsG (sheafification-counit site G Gpp))
         (out '()))
    (if (not (presheaf-natural? F Fpp etaF)) (set! out (cons (list 'unit-natural) out)))
    (if (not (presheaf-natural? Gpp G epsG)) (set! out (cons (list 'counit-natural) out)))
    (if (not (cd-identity? (set-transformation-compose (sheafification-counit site Fpp aFpp)
                                                       (sheafify-map site etaF F Fpp Fp Fpp aFp aFpp))))
        (set! out (cons (list 'triangle-a) out)))
    (if (not (cd-identity? (set-transformation-compose epsG etaG))) (set! out (cons (list 'triangle-i) out)))
    (let* ((XF (presheaf->set-functor F)) (XaF (presheaf->set-functor Fpp)) (XG (presheaf->set-functor G))
           (n (set-natural-transformation-count XF XG)) (psis (set-natural-transformations XaF XG))
           (pulled (map (lambda (psi) (set-transformation-compose psi etaF)) psis)))
      (if (not (= n (length psis))) (set! out (cons (list 'hom-count n (length psis)) out)))
      (if (not (= (length (cd-dedup pulled)) (length pulled))) (set! out (cons (list 'not-injective) out))))
    (reverse out)))
;; T = i a with eta and mu_F = eps_{aF}: (left-unit) mu o T(eta) /= id,
;; (right-unit) mu o eta_T /= id, (associativity) mu o T(mu) /= mu o mu_T
(define (sheafification-monad-violations site F)
  (let* ((Fp (presheaf-plus site F)) (Fpp (presheaf-plus site Fp)) (eta (sheafification-unit site F Fp Fpp))
         (T2p (presheaf-plus site Fpp)) (T2pp (presheaf-plus site T2p))
         (T3p (presheaf-plus site T2pp)) (T3pp (presheaf-plus site T3p))
         (mu (sheafification-counit site Fpp T2pp))
         (muT (sheafification-counit site T2pp T3pp))
         (etaT (sheafification-unit site Fpp T2p T2pp))
         (Teta (sheafify-map site eta F Fpp Fp Fpp T2p T2pp))
         (Tmu (sheafify-map site mu T2pp Fpp T3p T3pp T2p T2pp))
         (out '()))
    (if (not (cd-identity? (set-transformation-compose mu Teta))) (set! out (cons (list 'left-unit) out)))
    (if (not (cd-identity? (set-transformation-compose mu etaT))) (set! out (cons (list 'right-unit) out)))
    (if (not (equal? (set-transformation-compose mu Tmu) (set-transformation-compose mu muT))) (set! out (cons (list 'associativity) out)))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; Components, the nerve category of a cover, Cech cohomology as lim^n
;; ---------------------------------------------------------------------------
;; pi_0 of a finite category: the colimit of the constant one-point functor
(define (category-components C) (set-colimit-size (set-colimit (constant-set-functor C (list 0)))))
;; (P . G): P the poset of nonempty index sets J (by size, then
;; lexicographically) whose meet exists, with K -> J when J is contained in K,
;; labelled by J; G : P -> C sends J to U_J = the meet of the objs indexed by J
(define (cover-nerve-category C objs)
  (let* ((n (length objs)) (ov (list->vector objs))
         (meet (lambda (J) (let loop ((l (cdr J)) (m (vector-ref ov (car J)))) (cond ((not m) #f) ((null? l) m) (else (loop (cdr l) (category-meet C m (vector-ref ov (car l)))))))))
         (Js (filter meet (apply append (map (lambda (k) (sheaf-subsets-of-size (cd-range n) k)) (cdr (cd-range (+ n 1)))))))
         (Jv (list->vector Js))
         (P (poset-category (length Js) (lambda (a b) (cd-all? (lambda (i) (memv i (vector-ref Jv a))) (vector-ref Jv b))) Js)))
    (cons P (functor-from-procedures P C (lambda (j) (meet (vector-ref Jv j)))
                                     (lambda (a) (category-thin-arrow C (meet (vector-ref Jv (arrow-source P a))) (meet (vector-ref Jv (arrow-target P a)))))))))
;; Cech cohomology of the module presheaf F on a thin category with meets,
;; for the cover objs: lim^n over the nerve category of J |-> F(U_J)
(define (cech-derived-limits F objs kmax)
  (let ((PG (cover-nerve-category (module-presheaf-category F) objs)))
    (module-presheaf-derived-limits (module-presheaf-restrict F (cdr PG)) kmax)))
;; index sets of a cover of a finite space by point lists, with nonempty
;; intersection, and their poset (K -> J when J is contained in K)
(define (cd-cover-index-poset cover)
  (let* ((n (length cover)) (cv (list->vector cover))
         (inter (lambda (J) (sheaf-intersect-all (map (lambda (i) (vector-ref cv i)) J))))
         (Js (filter (lambda (J) (pair? (inter J))) (apply append (map (lambda (k) (sheaf-subsets-of-size (cd-range n) k)) (cdr (cd-range (+ n 1)))))))
         (Jv (list->vector Js)))
    (list (poset-category (length Js) (lambda (a b) (cd-all? (lambda (i) (memv i (vector-ref Jv a))) (vector-ref Jv b))) Js)
          Jv inter)))
;; (E . p): E the Grothendieck construction of J |-> the poset of points of
;; U_J (inclusions along K -> J), p : E -> the category of points (one
;; arrow y -> x for y <= x, as built by poset-module->point-presheaf)
(define (finite-space-cover-descent-category X cover)
  (let* ((ip (cd-cover-index-poset cover)) (P (car ip)) (Jv (cadr ip)) (inter (caddr ip))
         (n (finite-space-size X)) (pts (poset-category n (lambda (y x) (finite-space-leq? X y x))))
         (subs (list->vector (map (lambda (j) (inclusion-functor pts (inter (vector-ref Jv j)))) (cd-range (category-object-count P)))))
         (D (make-category-diagram
             P (map (lambda (j) (car (vector-ref subs j))) (cd-range (category-object-count P)))
             (map (lambda (a)
                    (let* ((K (car (vector-ref subs (arrow-source P a)))) (J (car (vector-ref subs (arrow-target P a))))
                           (ptsK (functor-objects (cdr (vector-ref subs (arrow-source P a))))) (ptsJ (vector->list (functor-objects (cdr (vector-ref subs (arrow-target P a))))))
                           (pos (lambda (x) (let loop ((l ptsJ) (i 0)) (if (= (car l) x) i (loop (cdr l) (+ i 1)))))))
                      (functor-from-procedures K J (lambda (k) (pos (vector-ref ptsK k)))
                                               (lambda (b) (category-thin-arrow J (pos (vector-ref ptsK (arrow-source K b))) (pos (vector-ref ptsK (arrow-target K b))))))))
                  (cd-range (category-arrow-count P)))))
         (E (grothendieck-construction D))
         (point-of (lambda (o) (let ((lab (category-object-label E o))) (vector-ref (functor-objects (cdr (vector-ref subs (car lab)))) (cadr lab))))))
    (cons E (functor-from-procedures E pts point-of
                                     (lambda (k) (category-thin-arrow pts (point-of (arrow-source E k)) (point-of (arrow-target E k))))))))
;; the face category of the Cech nerve C(U): objects (J c), c a component of
;; U_J (finite-space-components order), from the Grothendieck construction of
;; J |-> the discrete category pi_0(U_J)
(define (finite-space-cech-nerve-category X cover)
  (let* ((ip (cd-cover-index-poset cover)) (P (car ip)) (Jv (cadr ip)) (inter (caddr ip))
         (comps (list->vector (map (lambda (j) (finite-space-components X (inter (vector-ref Jv j)))) (cd-range (category-object-count P)))))
         (cats (list->vector (map (lambda (j) (discrete-category (length (vector-ref comps j)))) (cd-range (category-object-count P)))))
         ;; the component of U_J containing component c of U_K
         (host (lambda (K J c)
                 (let ((p (car (list-ref (vector-ref comps K) c))))
                   (let loop ((l (vector-ref comps J)) (i 0)) (if (memv p (car l)) i (loop (cdr l) (+ i 1)))))))
         (D (make-category-diagram
             P cats
             (map (lambda (a)
                    (let ((K (arrow-source P a)) (J (arrow-target P a)))
                      (functor-from-procedures (vector-ref cats K) (vector-ref cats J)
                                               (lambda (c) (host K J c)) (lambda (b) (host K J b)))))
                  (cd-range (category-arrow-count P))))))
    (grothendieck-construction D)))
;; cells of C(U) by dimension 0..kmax: objects (J c) with |J| = k + 1
(define (cech-nerve-cell-counts N cover kmax)
  (let ((P-sizes (map (lambda (o) (car (category-object-label N o))) (cd-range (category-object-count N)))))
    (let ((ip (cd-cover-index-poset cover)))
      (map (lambda (k) (length (filter (lambda (j) (= (+ k 1) (length (vector-ref (cadr ip) j)))) P-sizes))) (cd-range (+ kmax 1))))))

;; ---------------------------------------------------------------------------
;; The plus construction and the sheaf condition for module presheaves, by limits
;; ---------------------------------------------------------------------------
;; Match(S, F) = lim over (int S)^op of F pi^op, as a module-limit
(define (module-sieve-limit F c S)
  (let ((sc (sieve-category (module-presheaf-category F) c S)))
    (module-presheaf-limit (module-presheaf-restrict F (cdr sc)))))
;; (rank of Match(S, F), rank of F(c), rank of the map F(c) -> Match(S, F)):
;; the shape of the unit F -> F^+ at c when S is the smallest covering sieve
(define (module-sieve-unit-shape F c S)
  (let* ((sc (sieve-category (module-presheaf-category F) c S)) (K (car sc)) (pi (cdr sc))
         (L (module-presheaf-limit (module-presheaf-restrict F pi))) (rc (module-presheaf-rank F c))
         (cols (cd-restricted-columns F K pi rc)) (N (car cols)))
    (list (module-limit-rank L) rc (if (or (= rc 0) (= N 0)) 0 (ring-rank (module-presheaf-ring F) (integer-matrix-from-columns (cdr cols) N))))))
;; (N . columns): the restrictions of the basis vectors of F(c) to the
;; objects of the sieve category, as vectors of the total space
(define (cd-restricted-columns F K pi rc)
  (let ((N (apply + (map (lambda (k) (module-presheaf-rank F (functor-object pi k))) (cd-range (category-object-count K))))))
    (cons N
          (map (lambda (j)
                 (let ((v (make-vector N 0)))
                   (let loop ((k 0) (o 0))
                     (if (< k (category-object-count K))
                         (let* ((d (functor-object pi k)) (A (module-presheaf-restriction F (caddr (category-object-label K k)))) (rd (module-presheaf-rank F d)))
                           (let fill ((p 0)) (if (< p rd) (begin (vector-set! v (+ o p) (integer-matrix-ref A p j)) (fill (+ p 1)))))
                           (loop (+ k 1) (+ o rd)))))
                   v))
               (cd-range rc)))))
;; (iso r) when F(c) -> Match(S, F) is an isomorphism of rank r,
;; (not-separated rank-of-map) or (not-glueing index) otherwise; over Z the
;; map is onto when the coordinates of the restricted basis form a unimodular
;; matrix, over Q when the ranks agree
(define (module-sheaf-at-by-limit F c S)
  (let* ((sc (sieve-category (module-presheaf-category F) c S)) (K (car sc)) (pi (cdr sc))
         (L (module-presheaf-limit (module-presheaf-restrict F pi))) (ring (module-presheaf-ring F))
         (B (module-limit-basis L)) (r (module-limit-rank L)) (rc (module-presheaf-rank F c))
         (N (apply + (map (lambda (k) (module-presheaf-rank F (functor-object pi k))) (cd-range (category-object-count K)))))
         ;; the restriction of the j-th basis vector of F(c) as a total vector
         (restricted (map (lambda (j)
                            (let ((v (make-vector N 0)))
                              (let loop ((k 0) (o 0))
                                (if (< k (category-object-count K))
                                    (let* ((d (functor-object pi k)) (A (module-presheaf-restriction F (caddr (category-object-label K k)))) (rd (module-presheaf-rank F d)))
                                      (let fill ((p 0)) (if (< p rd) (begin (vector-set! v (+ o p) (integer-matrix-ref A p j)) (fill (+ p 1)))))
                                      (loop (+ k 1) (+ o rd)))))
                              v))
                          (cd-range rc)))
         (map-rank (if (or (= rc 0) (= N 0)) 0 (ring-rank ring (integer-matrix-from-columns restricted N)))))
    (cond ((< map-rank rc) (list 'not-separated map-rank))
          ((< rc r) (list 'not-glueing (- r rc)))
          ((eq? ring 'Q) (list 'iso r))
          ((= r 0) (list 'iso 0))
          (else
           (let* ((BM (integer-matrix-from-columns B N))
                  (coords (map (lambda (v) (ring-solve ring BM r v)) restricted))
                  (index (apply * (integer-invariant-factors (integer-matrix-from-columns coords r)))))
             (if (= 1 index) (list 'iso r) (list 'not-glueing index)))))))

;; ---------------------------------------------------------------------------
;; Sections over the opens of a cover of a finite space, as limits
;; ---------------------------------------------------------------------------
;; Gamma(U; M) = lim of the point presheaf M over the points of U: a
;; module-limit whose total space has the blocks of the points of U in order
(define (finite-space-sections M U)
  (let ((inc (inclusion-functor (module-presheaf-category M) U)))
    (module-presheaf-limit (module-presheaf-restrict M (cdr inc)))))
;; (P . G): P the nerve category of the cover (index sets J with nonempty
;; U_J), G the module presheaf J |-> Gamma(U_J; M) with the restrictions
;; solved in the limit bases; M a point presheaf (poset-module->point-presheaf)
(define (finite-space-cover-sections-presheaf M cover)
  (let* ((ip (cd-cover-index-poset cover)) (P (car ip)) (Jv (cadr ip)) (inter (caddr ip)) (ring (module-presheaf-ring M))
         (n (category-object-count P))
         (Us (list->vector (map (lambda (j) (inter (vector-ref Jv j))) (cd-range n))))
         (Ls (list->vector (map (lambda (j) (finite-space-sections M (vector-ref Us j))) (cd-range n))))
         (block (lambda (U x) (let loop ((l U) (o 0)) (if (= (car l) x) o (loop (cdr l) (+ o (module-presheaf-rank M (car l)))))))))
    (cons P
          (make-module-presheaf
           P ring (lambda (j) (module-limit-rank (vector-ref Ls j)))
           (lambda (a)
             (let* ((K (arrow-source P a)) (J (arrow-target P a)) (UK (vector-ref Us K)) (UJ (vector-ref Us J))
                    (LK (vector-ref Ls K)) (rK (module-limit-rank LK)) (rJ (module-limit-rank (vector-ref Ls J)))
                    (NK (apply + (map (lambda (x) (module-presheaf-rank M x)) UK)))
                    (BK (if (> rK 0) (integer-matrix-from-columns (module-limit-basis LK) NK) #f))
                    (cols (map (lambda (v)
                                 (let ((w (make-vector NK 0)))
                                   (for-each (lambda (x) (let ((oJ (block UJ x)) (oK (block UK x)))
                                                           (let fill ((p 0)) (if (< p (module-presheaf-rank M x)) (begin (vector-set! w (+ oK p) (vector-ref v (+ oJ p))) (fill (+ p 1)))))))
                                             UK)
                                   (if (= rK 0) (make-vector 0 0)
                                       (let ((c (ring-solve ring BK rK w)))
                                         (if (not c) (error "finite-space-cover-sections-presheaf: a restricted section is not a section" (list J K)))
                                         c))))
                               (module-limit-basis (vector-ref Ls J)))))
               (if (= rJ 0) (integer-matrix rK 0) (integer-matrix-from-columns cols rK))))))))
