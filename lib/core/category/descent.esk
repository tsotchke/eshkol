;;; core.category.descent -- descent and sheafification as category theory
;;; on core.sheaf's finite sites: the matching-family limit over the
;;; category of a sieve, descent as a right Kan extension, the Cech
;;; equalizer form, the sheaf condition decided through limits, and
;;; sheafification as the reflector a -| i with its unit, counit, triangle
;;; identities, universal property and idempotent monad.
;;;
;;; Usage: (require core.category.descent)   or   (require core.category)
;;;
;;; Sources: S. Mac Lane, I. Moerdijk, "Sheaves in Geometry and Logic" (1992),
;;; I.4 and III.4 (matching families; Match(S, F) = Nat(S, F); the sheaf
;;; condition for a sieve generated by a family as an equalizer), III.5
;;; (the plus construction; Theorem III.5.1: a = (-)^{++} is left adjoint to
;;; the inclusion i of sheaves, Lemma III.5.3), V.3 (a preserves finite
;;; limits; i a is an idempotent monad); P. T. Johnstone, "Sketches of an
;;; Elephant" (2002), A4.4 (reflective subcategories), C2.1-C2.2 (sheaves on
;;; a site; F is a sheaf when F(c) -> lim_{(int S)^op} F is a bijection for
;;; every covering sieve, i.e. when F is local for the sieve inclusions);
;;; E. Riehl, "Category Theory in Context" (2016), 4.5 and 6.2; nLab:
;;; "sieve", "sheaf", "sheafification", "plus construction on presheaves",
;;; "reflective subcategory", "idempotent monad", "Cech cover", "descent".
;;;
;;; The category of a sieve S on c is the full subcategory of the slice C/c
;;; on the arrows of S (Mac Lane-Moerdijk I.4); its domain functor
;;; pi : int S -> C gives Match(S, F) = lim_{(int S)^op} F pi^op, which is
;;; the value at S of the right Kan extension of F along the Yoneda
;;; embedding (F extended to presheaves P by Nat(P, F)). On a thin site the
;;; same limit is the right Kan extension of F, restricted to the objects of
;;; the sieve, along their inclusion, evaluated at c
;;; (presheaf-ran-along-inclusion, core.category.kan). Abelian descent is
;;; core.category.cohomology.
;;;
;;; Transformations are vectors c -> vector of indices, as in core.sheaf's
;;; presheaf-natural? and core.category.set.

(require stdlib)
(require core.sheaf.site)
(require core.sheaf.glue)
(require core.sheaf.presheaf)
(require core.category.finite)
(require core.category.functor)
(require core.category.set)
(require core.integer_linalg)
(require core.sheaf.module)
(require core.category.linear)

(provide category-components cover-nerve-category cech-derived-limits
         finite-space-cover-descent-category finite-space-cech-nerve-category cech-nerve-cell-counts
         module-sieve-limit module-sheaf-at-by-limit module-sieve-unit-shape
         finite-space-cover-sections-presheaf finite-space-sections
 sieve-category sieve-matching-limit sieve-descent-violations
         presheaf-ran-along-inclusion
         cech-equalizer cech-descent-violations
         presheaf-sheaf-violations-by-limit
         presheaf-plus-map sheafification-unit sheafify-map sheafification-counit
         sheafification-adjunction-violations sheafification-monad-violations)

(define (cd-range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (cd-all? pred xs) (cond ((null? xs) #t) ((pred (car xs)) (cd-all? pred (cdr xs))) (else #f)))
(define (cd-dedup xs)
  (let loop ((l xs) (acc '())) (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc)) (else (loop (cdr l) (cons (car l) acc))))))
(define (cd-same-set? A B) (and (cd-all? (lambda (x) (member x B)) A) (cd-all? (lambda (x) (member x A)) B)))

;; ---------------------------------------------------------------------------
;; Sieves as categories; Match(S, F) as a limit
;; ---------------------------------------------------------------------------
;; the limit of F pi^op over (int S)^op, each element returned as a family
;; ((f . x_f) ...) in the order of S
(define (sieve-matching-limit F c S)
  (let* ((C (presheaf-category F)) (sc (sieve-category C c S)) (K (car sc)) (pi (cdr sc))
         (X (set-functor-restrict (presheaf->set-functor F) (functor-opposite pi)))
         (kof (lambda (f) (let loop ((k 0)) (if (= f (caddr (category-object-label K k))) k (loop (+ k 1)))))))
    (map (lambda (fam) (map (lambda (f) (let ((k (kof f))) (cons f (list-ref (set-functor-elements X k) (vector-ref fam k))))) S))
         (set-limit X))))
;; (count n m) when |lim| /= |Match(S, F)|, (not-in-match fam) for a limit
;; element that is not a matching family of core.sheaf.presheaf
(define (sieve-descent-violations F c S)
  (let* ((lim (sieve-matching-limit F c S)) (match (matching-families F c S)) (out '()))
    (if (not (= (length lim) (length match))) (set! out (cons (list 'count (length lim) (length match)) out)))
    (for-each (lambda (fam) (if (not (member fam match)) (set! out (cons (list 'not-in-match fam) out)))) lim)
    (reverse out)))
;; ---------------------------------------------------------------------------
;; The Cech equalizer
;; ---------------------------------------------------------------------------
;; For arrows f_i : U_i -> c, the families (x_i in F(U_i)) with
;; F(g) x_i = F(h) x_j whenever f_i g = f_j h (g : V -> U_i, h : V -> U_j):
;; the equalizer of prod_i F(U_i) => prod_{i,j} prod_{(g,h)} F(V). Each
;; family is the list of its elements.
(define (cech-equalizer F c arrows)
  (let* ((C (presheaf-category F)) (fv (list->vector arrows)) (n (vector-length fv))
         (spans (lambda (i j)
                  (apply append
                         (map (lambda (g) (map (lambda (h) (cons g h))
                                               (filter (lambda (h) (and (= (arrow-source C h) (arrow-source C g))
                                                                        (eqv? (category-compose C (vector-ref fv i) g) (category-compose C (vector-ref fv j) h))))
                                                       (category-arrows-into C (arrow-source C (vector-ref fv j))))))
                              (category-arrows-into C (arrow-source C (vector-ref fv i)))))))
         (sp (list->vector (map (lambda (j) (list->vector (map (lambda (i) (spans i j)) (cd-range (+ j 1))))) (cd-range n))))
         (acc '()))
    (let search ((j 0) (xs '()))
      (if (= j n) (set! acc (cons (reverse xs) acc))
          (for-each (lambda (x)
                      (let ((all (reverse (cons x xs))))
                        (if (cd-all? (lambda (i)
                                       (cd-all? (lambda (gh) (equal? (presheaf-restrict F (car gh) (list-ref all i))
                                                                     (presheaf-restrict F (cdr gh) x)))
                                                (vector-ref (vector-ref sp j) i)))
                                     (cd-range (+ j 1)))
                            (search (+ j 1) (cons x xs)))))
                    (presheaf-elements F (arrow-source C (vector-ref fv j))))))
    (reverse acc)))
;; Match(S, F) -> Eq, (x_f) |-> (x_{f_i}), for S generated by the arrows:
;; (count m e), (not-in-equalizer fam), (not-injective)
(define (cech-descent-violations F c arrows)
  (let* ((C (presheaf-category F)) (S (sieve-generated C c arrows))
         (match (matching-families F c S)) (eq (cech-equalizer F c arrows))
         (image (map (lambda (fam) (map (lambda (f) (cdr (assv f fam))) arrows)) match)) (out '()))
    (if (not (= (length match) (length eq))) (set! out (cons (list 'count (length match) (length eq)) out)))
    (for-each (lambda (fam img) (if (not (member img eq)) (set! out (cons (list 'not-in-equalizer fam) out)))) match image)
    (if (not (= (length (cd-dedup image)) (length image))) (set! out (cons (list 'not-injective) out)))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; The sheaf condition as a limit
;; ---------------------------------------------------------------------------
;; the violations in the format of core.sheaf.presheaf's
;; presheaf-sheaf-violations, computed through sieve-matching-limit
(define (presheaf-sheaf-violations-by-limit site F)
  (let ((C (site-category site)) (out '()))
    (for-each
     (lambda (c)
       (for-each
        (lambda (S)
          (let* ((lim (sieve-matching-limit F c S))
                 (imgs (map (lambda (x) (restriction-family F S x)) (presheaf-elements F c)))
                 (unglued (filter (lambda (fam) (not (member fam imgs))) lim)))
            (if (< (length (cd-dedup imgs)) (length imgs)) (set! out (cons (list c S 'not-separated) out)))
            (if (not (null? unglued)) (set! out (cons (list c S 'not-glueing (length unglued)) out)))))
        (site-covering-sieves site c)))
     (cd-range (category-object-count C)))
    (reverse out)))

;; ---------------------------------------------------------------------------
;; Sheafification as a reflector
;; ---------------------------------------------------------------------------
;; phi^+ : F^+ -> G^+ for phi : F -> G, on families: (x_h) |-> (phi(x_h))
(define (presheaf-plus-map site phi F G Fp Gp)
  (let ((C (site-category site)))
    (list->vector
     (map (lambda (c)
            (list->vector
             (map (lambda (fam)
                    (let ((i (presheaf-element-index
                              Gp c (map (lambda (pr) (let ((d (arrow-source C (car pr))))
                                                       (cons (car pr) (list-ref (presheaf-elements G d) (vector-ref (vector-ref phi d) (presheaf-element-index F d (cdr pr)))))))
                                        fam))))
                      (if (not i) (error "presheaf-plus-map: phi is not natural" c))
                      i))
                  (presheaf-elements Fp c))))
          (cd-range (category-object-count C))))))
;; eta : F -> a F = F^{++}, the composite of the two plus units
(define (sheafification-unit site F Fp Fpp)
  (set-transformation-compose (presheaf-unit-map site Fp Fpp) (presheaf-unit-map site F Fp)))
;; a(phi) : a F -> a G; pre = (Fp Fpp Gp Gpp) when already computed
(define (sheafify-map site phi F G . pre)
  (let* ((Fp (if (null? pre) (presheaf-plus site F) (car pre)))
         (Fpp (if (null? pre) (presheaf-plus site Fp) (cadr pre)))
         (Gp (if (null? pre) (presheaf-plus site G) (caddr pre)))
         (Gpp (if (null? pre) (presheaf-plus site Gp) (list-ref pre 3))))
    (presheaf-plus-map site (presheaf-plus-map site phi F G Fp Gp) Fp Gp Fpp Gpp)))
;; eps : a G -> G for a sheaf G: an element of G^{++}(c) is a matching family
;; of matching families; each inner family is glued in G, then the outer one
(define (sheafification-counit site G Gpp)
  (let ((C (site-category site)))
    (list->vector
     (map (lambda (c)
            (list->vector
             (map (lambda (outer)
                    (let* ((glued-inner (map (lambda (pr) (let* ((d (arrow-source C (car pr)))
                                                                 (r (glue-family G d (site-minimal-covering-sieve site d) (cdr pr))))
                                                            (if (not (glued? r)) (error "sheafification-counit: not a sheaf" (list d (gluing-obstructions r))))
                                                            (cons (car pr) (glued-value r))))
                                             outer))
                           (r (glue-family G c (site-minimal-covering-sieve site c) glued-inner)))
                      (if (not (glued? r)) (error "sheafification-counit: not a sheaf" (list c (gluing-obstructions r))))
                      (presheaf-element-index G c (glued-value r))))
                  (presheaf-elements Gpp c))))
          (cd-range (category-object-count C))))))
(define (cd-identity? eta) (set-transformation-identity? eta))
;; a -| i on (F, G), G a sheaf: (unit-natural) (counit-natural)
;; (triangle-a): eps_{aF} o a(eta_F) /= id, (triangle-i): eps_G o eta_G /= id,
;; (hom-count n m): |Nat(F, G)| /= |Nat(aF, G)|, (not-injective): psi |-> psi eta_F
(define (sheafification-adjunction-violations site F G)
  (let* ((Fp (presheaf-plus site F)) (Fpp (presheaf-plus site Fp)) (etaF (sheafification-unit site F Fp Fpp))
         (aFp (presheaf-plus site Fpp)) (aFpp (presheaf-plus site aFp))
         (Gp (presheaf-plus site G)) (Gpp (presheaf-plus site Gp))
         (etaG (sheafification-unit site G Gp Gpp)) (epsG (sheafification-counit site G Gpp))
         (out '()))
    (if (not (presheaf-natural? F Fpp etaF)) (set! out (cons (list 'unit-natural) out)))
    (if (not (presheaf-natural? Gpp G epsG)) (set! out (cons (list 'counit-natural) out)))
    (if (not (cd-identity? (set-transformation-compose (sheafification-counit site Fpp aFpp)
                                                       (sheafify-map site etaF F Fpp Fp Fpp aFp aFpp))))
        (set! out (cons (list 'triangle-a) out)))
    (if (not (cd-identity? (set-transformation-compose epsG etaG))) (set! out (cons (list 'triangle-i) out)))
    (let* ((XF (presheaf->set-functor F)) (XaF (presheaf->set-functor Fpp)) (XG (presheaf->set-functor G))
           (n (set-natural-transformation-count XF XG)) (psis (set-natural-transformations XaF XG))
           (pulled (map (lambda (psi) (set-transformation-compose psi etaF)) psis)))
      (if (not (= n (length psis))) (set! out (cons (list 'hom-count n (length psis)) out)))
      (if (not (= (length (cd-dedup pulled)) (length pulled))) (set! out (cons (list 'not-injective) out))))
    (reverse out)))
;; T = i a with eta and mu_F = eps_{aF}: (left-unit) mu o T(eta) /= id,
;; (right-unit) mu o eta_T /= id, (associativity) mu o T(mu) /= mu o mu_T
(define (sheafification-monad-violations site F)
  (let* ((Fp (presheaf-plus site F)) (Fpp (presheaf-plus site Fp)) (eta (sheafification-unit site F Fp Fpp))
         (T2p (presheaf-plus site Fpp)) (T2pp (presheaf-plus site T2p))
         (T3p (presheaf-plus site T2pp)) (T3pp (presheaf-plus site T3p))
         (mu (sheafification-counit site Fpp T2pp))
         (muT (sheafification-counit site T2pp T3pp))
         (etaT (sheafification-unit site Fpp T2p T2pp))
         (Teta (sheafify-map site eta F Fpp Fp Fpp T2p T2pp))
         (Tmu (sheafify-map site mu T2pp Fpp T3p T3pp T2p T2pp))
         (out '()))
    (if (not (cd-identity? (set-transformation-compose mu Teta))) (set! out (cons (list 'left-unit) out)))
    (if (not (cd-identity? (set-transformation-compose mu etaT))) (set! out (cons (list 'right-unit) out)))
    (if (not (equal? (set-transformation-compose mu Tmu) (set-transformation-compose mu muT))) (set! out (cons (list 'associativity) out)))
    (reverse out)))
