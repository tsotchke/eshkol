;;; Bounded exact real Q(alpha), with certified field and root admission.
(require core.polynomial_exact)
(require core.exact_linalg)
(provide make-algebraic-field algebraic-field-degree algebraic-field-polynomial
         algebraic-generator algebraic-element algebraic-coefficients
         algebraic-add algebraic-sub algebraic-scale algebraic-mul algebraic-inverse
         algebraic-zero? algebraic-equal? algebraic-rational algebraic-enclosure
         algebraic-sign make-algebraic-embedding make-algebraic-compositum
         algebraic-field-certificate)

(define (af-exact x)
  (if (not (and (rational? x) (exact? x))) (error "Algebraic arithmetic lost exact rational type")) x)
(define (af+ a b) (af-exact (+ a b)))
(define (af- a b) (af-exact (- a b)))
(define (af* a b) (af-exact (* a b)))
(define (af/ a b) (af-exact (/ a b)))
(define (af-prime? p)
  (and (integer? p) (exact? p) (>= p 2) (<= p 65521)
    (let trial ((d 2))
      (or (> (* d d) p) (and (not (= (modulo p d) 0)) (trial (+ d 1)))))))
(define (af-mod p prime)
  (exact-poly (map (lambda (x) (modulo x prime)) (vector->list p))))
(define (af-integer-power a n prime)
  (let loop ((base (modulo a prime)) (exponent n) (out 1))
    (if (= exponent 0) out
        (loop (modulo (* base base) prime) (quotient exponent 2)
              (if (odd? exponent) (modulo (* out base) prime) out)))))
(define (af-mod-monic p prime)
  (if (exact-poly-zero? p) (vector 0)
      (af-mod (exact-poly-scale p (af-integer-power (vector-ref p (- (vector-length p) 1)) (- prime 2) prime)) prime)))
(define (af-mod-product a b modulus prime)
  (af-mod (cdr (exact-poly-divmod (exact-poly-mul a b) modulus)) prime))
(define (af-mod-power a n modulus prime)
  (let loop ((base a) (exponent n) (out (vector 1)))
    (if (= exponent 0) out
        (loop (af-mod-product base base modulus prime) (quotient exponent 2)
              (if (odd? exponent) (af-mod-product out base modulus prime) out)))))
(define (af-mod-gcd a b prime)
  (let loop ((left a) (right b))
    (if (exact-poly-zero? right) (af-mod-monic left prime)
        (loop right (af-mod (cdr (exact-poly-divmod left (af-mod-monic right prime))) prime)))))
;; Frobenius identity plus exclusion of every possible small factor degree.
;; Degree <=16 makes the exhaustive small-degree criterion inexpensive.
(define (af-irreducible? polynomial prime)
  (let* ((f (af-mod polynomial prime)) (degree (- (vector-length f) 1)) (x (vector 0 1)))
    (let frobenius ((i 1) (power x))
      (let* ((next (af-mod-power power prime f prime))
             (difference (af-mod (exact-poly-sub next x) prime)))
        (cond
          ((and (<= i (quotient degree 2))
                (> (vector-length (af-mod-gcd f difference prime)) 1)) #f)
          ((= i degree) (exact-poly-zero? difference))
          (else (frobenius (+ i 1) next)))))))
(define (af-field-check field)
  (if (not (and (vector? field) (= (vector-length field) 5)
                (eq? (vector-ref field 0) 'algebraic-field-v1))) (error "Expected a real algebraic field")))
(define (af-element-check a)
  (if (not (and (vector? a) (= (vector-length a) 3)
                (eq? (vector-ref a 0) 'algebraic-element-v1))) (error "Expected an algebraic element")))
(define (af-field a) (af-element-check a) (vector-ref a 1))
(define (af-coeff a) (af-element-check a) (vector-ref a 2))
(define (algebraic-field-degree field) (af-field-check field) (- (vector-length (vector-ref field 1)) 1))
(define (algebraic-field-polynomial field) (af-field-check field) (vector-copy (vector-ref field 1)))

;; Prime is an explicit irreducibility witness, not an unchecked assertion.
;; Root index selects ascending real order. Isolation is all-or-error.
(define (make-algebraic-field coefficients prime root-index . split-budget)
  (let* ((p (exact-poly coefficients)) (degree (- (vector-length p) 1)))
    (if (not (and (>= degree 2) (<= degree 16) (= (vector-ref p degree) 1)))
        (error "Field polynomial must be monic of degree 2 through 16"))
    (for-each (lambda (x) (if (not (integer? x)) (error "Field polynomial must have integer coefficients")))
              (vector->list p))
    (if (not (af-prime? prime)) (error "Irreducibility witness must be a prime at most 65521"))
    (if (not (af-irreducible? p prime)) (error "Polynomial reduction is not irreducible at the witness prime"))
    (if (not (and (integer? root-index) (exact? root-index) (>= root-index 0)))
        (error "Real root index must be a nonnegative exact integer"))
    (if (> (length split-budget) 1) (error "Expected at most one root-isolation budget"))
    (let ((roots (if (null? split-budget) (exact-poly-isolate p)
                     (exact-poly-isolate p (car split-budget)))))
      (if (>= root-index (length roots)) (error "Requested real root does not exist"))
      (vector 'algebraic-field-v1 p (list-ref roots root-index) prime root-index))))
(define (algebraic-element field coefficients)
  (af-field-check field)
  (let* ((p (exact-poly coefficients)) (rem (cdr (exact-poly-divmod p (vector-ref field 1))))
         (out (make-vector (algebraic-field-degree field) 0)))
    (let copy ((i 0))
      (if (< i (vector-length rem))
          (begin (vector-set! out i (vector-ref rem i)) (copy (+ i 1)))))
    (vector 'algebraic-element-v1 field out)))
(define (algebraic-generator field) (algebraic-element field '(0 1)))
(define (algebraic-coefficients a) (vector-copy (af-coeff a)))
(define (af-same a b)
  (if (not (eq? (af-field a) (af-field b))) (error "Foreign algebraic fields require an explicit embedding"))
  (af-field a))
(define (algebraic-sub a b) (algebraic-element (af-same a b) (exact-poly-sub (af-coeff a) (af-coeff b))))
(define (algebraic-add a b) (algebraic-element (af-same a b)
  (exact-poly-sub (af-coeff a) (exact-poly-scale (af-coeff b) -1))))
(define (algebraic-scale a q) (algebraic-element (af-field a) (exact-poly-scale (af-coeff a) q)))
(define (algebraic-mul a b) (algebraic-element (af-same a b) (exact-poly-mul (af-coeff a) (af-coeff b))))
(define (algebraic-inverse a) (algebraic-element (af-field a)
  (exact-poly-inverse-mod (af-coeff a) (vector-ref (af-field a) 1))))
(define (algebraic-zero? a) (exact-poly-zero? (af-coeff a)))
(define (algebraic-equal? a b)
  (af-same a b) (equal? (vector->list (af-coeff a)) (vector->list (af-coeff b))))
(define (algebraic-rational a)
  (let ((p (af-coeff a)))
    (let loop ((i 1))
      (if (= i (vector-length p)) (vector-ref p 0)
          (and (= (vector-ref p i) 0) (loop (+ i 1)))))))

(define (af-budget options)
  (let ((n (if (null? options) 256 (car options))))
    (if (not (and (<= (length options) 1) (integer? n) (exact? n) (>= n 0) (<= n 65536)))
        (error "Invalid algebraic refinement budget")) n))
(define (af-refine field interval)
  (let* ((lo (car interval)) (hi (cdr interval)) (mid (af/ (af+ lo hi) 2))
         (p (vector-ref field 1)) (fm (exact-poly-eval p mid)))
    (if (= fm 0) (error "Rational root contradicts irreducibility certificate"))
    (if (= (if (> fm 0) 1 -1) (if (> (exact-poly-eval p lo) 0) 1 -1))
        (cons mid hi) (cons lo mid))))
(define (af-interval-mul a b)
  (let ((v (list (af* (car a) (car b)) (af* (car a) (cdr b))
                 (af* (cdr a) (car b)) (af* (cdr a) (cdr b)))))
    (cons (fold-left min (car v) (cdr v)) (fold-left max (car v) (cdr v)))))
(define (af-evaluate-interval coefficients interval)
  (let loop ((i (- (vector-length coefficients) 1)) (out (cons 0 0)))
    (if (< i 0) out
        (let* ((product (af-interval-mul out interval)) (c (vector-ref coefficients i)))
          (loop (- i 1) (cons (af+ (car product) c) (af+ (cdr product) c)))))))
(define (algebraic-enclosure a . refinements)
  (let ((field (af-field a)) (n (if (null? refinements) 0 (af-budget refinements))))
    (let refine ((i 0) (interval (vector-ref field 2)))
      (if (= i n)
          (let ((out (af-evaluate-interval (af-coeff a) interval))) (list (car out) (cdr out)))
          (refine (+ i 1) (af-refine field interval))))))
(define (algebraic-sign a . budget)
  (let ((field (af-field a)) (limit (af-budget budget)))
    (if (algebraic-zero? a) 0
        (let refine ((i 0) (interval (vector-ref field 2)))
          (let ((out (af-evaluate-interval (af-coeff a) interval)))
            (cond ((> (car out) 0) 1) ((< (cdr out) 0) -1)
                  ((>= i limit) (error "Algebraic sign exhausted its refinement budget"))
                  (else (refine (+ i 1) (af-refine field interval)))))))))
(define (af-evaluate-at coefficients image)
  (let ((field (af-field image)))
    (let horner ((i (- (vector-length coefficients) 1)) (out (algebraic-element field 0)))
      (if (< i 0) out
          (horner (- i 1) (algebraic-add (algebraic-mul out image)
                                        (algebraic-element field (vector-ref coefficients i))))))))
(define (make-algebraic-embedding source target image)
  (af-field-check source) (af-field-check target)
  (if (not (eq? (af-field image) target)) (error "Embedding image belongs to the wrong target field"))
  (if (not (algebraic-zero? (af-evaluate-at (vector-ref source 1) image)))
      (error "Embedding image does not satisfy the source polynomial"))
  (let ((interval (vector-ref source 2)))
    (if (not (and (= (algebraic-sign (algebraic-sub image (algebraic-element target (car interval)))) 1)
                  (= (algebraic-sign (algebraic-sub image (algebraic-element target (cdr interval)))) -1)))
        (error "Embedding image selects the wrong real conjugate")))
  (lambda (a)
    (if (not (eq? (af-field a) source)) (error "Embedding received a foreign source element"))
    (af-evaluate-at (af-coeff a) image)))

;; A copied provenance description, not an unchecked certificate loader.
(define (algebraic-field-certificate field)
  (af-field-check field)
  (let ((certificate (vector-ref field 3)) (interval (vector-ref field 2)))
    (if (integer? certificate)
        (list 'modular-prime certificate (algebraic-field-polynomial field) (vector (car interval) (cdr interval)))
        (list 'coprime-compositum (algebraic-field-degree field) (vector-ref certificate 3)
          (algebraic-field-certificate (vector-ref certificate 1))
          (algebraic-field-certificate (vector-ref certificate 2))
          (algebraic-field-polynomial field) (vector (car interval) (cdr interval))))))
(define (af-option options index fallback maximum)
  (let ((value (if (> (length options) index) (list-ref options index) fallback)))
    (if (not (and (integer? value) (exact? value) (>= value 0) (<= value maximum)))
        (error "Invalid compositum budget")) value))
(define (af-powers field)
  (let* ((degree (algebraic-field-degree field)) (out (make-vector (- (* 2 degree) 1) #f)))
    (let powers ((k 0))
      (if (< k (vector-length out))
          (let ((basis (make-vector (+ k 1) 0)))
            (vector-set! basis k 1)
            (vector-set! out k (algebraic-coefficients (algebraic-element field basis)))
            (powers (+ k 1))))) out))
(define (af-tensor-product left right)
  (let* ((m (algebraic-field-degree left)) (n (algebraic-field-degree right))
         (degree (* m n)) (lp (af-powers left)) (rp (af-powers right)))
    (lambda (x y)
      (let ((out (make-vector degree 0)))
        (let rows ((a 0))
          (if (< a degree)
              (begin
                (let columns ((b 0))
                  (if (< b degree)
                      (begin
                        (if (and (not (= (vector-ref x a) 0)) (not (= (vector-ref y b) 0)))
                            (let ((l (vector-ref lp (+ (quotient a n) (quotient b n))))
                                  (r (vector-ref rp (+ (modulo a n) (modulo b n))))
                                  (scale (af* (vector-ref x a) (vector-ref y b))))
                              (let left-cells ((i 0))
                                (if (< i m)
                                    (begin
                                      (let right-cells ((j 0))
                                        (if (< j n)
                                            (let ((k (+ (* i n) j)))
                                              (vector-set! out k (af+ (vector-ref out k)
                                                (af* scale (af* (vector-ref l i) (vector-ref r j)))))
                                              (right-cells (+ j 1)))))
                                      (left-cells (+ i 1)))))))
                        (columns (+ b 1)))))
                (rows (+ a 1))))) out))))
(define (af-matrix-vector matrix value)
  (list->vector (map (lambda (row)
    (let dot ((i 0) (out 0))
      (if (= i (vector-length value)) out
          (dot (+ i 1) (af+ out (af* (vector-ref row i) (vector-ref value i)))))))
    (vector->list matrix))))
(define (af-certified-inverse matrix)
  (let* ((inverse (exact-inverse matrix)) (n (vector-length matrix)))
    (for-each (lambda (row) (for-each af-exact (vector->list row))) (vector->list inverse))
    ;; Do not trust exact-rank after possible scalar demotion: certify a full
    ;; inverse with guarded exact arithmetic before using the power basis.
    (let rows ((i 0))
      (if (< i n)
          (begin
            (let columns ((j 0))
              (if (< j n)
                  (begin
                    (if (not (= (let dot ((k 0) (out 0))
                      (if (= k n) out (dot (+ k 1) (af+ out
                        (af* (vector-ref (vector-ref matrix i) k) (vector-ref (vector-ref inverse k) j))))))
                      (if (= i j) 1 0))) (error "Power-basis inverse failed its exact certificate"))
                    (columns (+ j 1)))))
            (rows (+ i 1))))) inverse))
(define (af-compositum-real left right multiplier polynomial a-image b-image limit)
  (let refine ((used 0) (li (vector-ref left 2)) (ri (vector-ref right 2)))
    (let* ((lo (af+ (car li) (af* multiplier (car ri))))
           (hi (af+ (cdr li) (af* multiplier (cdr ri)))) (interval (cons lo hi))
           (la (af-evaluate-interval a-image interval)) (rb (af-evaluate-interval b-image interval))
           (original-left (vector-ref left 2)) (original-right (vector-ref right 2)))
      (cond
        ((and (not (= (exact-poly-eval polynomial lo) 0)) (not (= (exact-poly-eval polynomial hi) 0))
              (= (exact-poly-real-root-count polynomial lo hi) 1)
              (> (car la) (car original-left)) (< (cdr la) (cdr original-left))
              (> (car rb) (car original-right)) (< (cdr rb) (cdr original-right))) interval)
        ((>= used limit) (error "Compositum exhausted its real-embedding budget"))
        (else (refine (+ used 1) (af-refine left li) (af-refine right ri)))))))
(define (make-algebraic-compositum left right . budgets)
  (af-field-check left) (af-field-check right)
  (if (> (length budgets) 3) (error "Expected degree, candidate and refinement budgets"))
  (let* ((degree-limit (af-option budgets 0 16 16)) (candidate-limit (af-option budgets 1 8 16))
         (refinement-limit (af-option budgets 2 128 256))
         (m (algebraic-field-degree left)) (n (algebraic-field-degree right)) (degree (* m n)))
    (if (eq? left right)
        (let ((copy (lambda (value)
          (if (not (eq? (af-field value) left)) (error "Identity embedding received a foreign value"))
          (algebraic-element left (af-coeff value)))))
          (if (> m degree-limit) (error "Compositum exceeds its degree budget")) (vector left copy copy))
        (begin
          (if (not (= (gcd m n) 1)) (error "Noncoprime fields require a separate disjointness certificate"))
          (if (> degree degree-limit) (error "Compositum exceeds its degree budget"))
          (let ((multiply (af-tensor-product left right)) (unit (make-vector degree 0))
                (a (make-vector degree 0)) (b (make-vector degree 0)))
            (vector-set! unit 0 1) (vector-set! a n 1) (vector-set! b 1 1)
            (let candidates ((c 1))
              (if (> c candidate-limit) (error "Compositum exhausted its primitive-element budget"))
              (let ((gamma (make-vector degree 0)) (powers (make-vector (+ degree 1) #f)))
                (let cells ((i 0))
                  (if (< i degree) (begin (vector-set! gamma i (af+ (vector-ref a i) (af* c (vector-ref b i))))
                                         (cells (+ i 1)))))
                (vector-set! powers 0 unit)
                (let power ((i 1))
                  (if (<= i degree) (begin (vector-set! powers i (multiply (vector-ref powers (- i 1)) gamma))
                                           (power (+ i 1)))))
                (let* ((columns (list->vector (reverse (cdr (reverse (vector->list powers))))))
                       (matrix (exact-matrix-transpose columns)))
                  (if (< (exact-rank matrix) degree) (candidates (+ c 1))
                      (let* ((inverse (af-certified-inverse matrix))
                             (relation (af-matrix-vector inverse (vector-ref powers degree)))
                             (polynomial (make-vector (+ degree 1) 0))
                             (a-image (af-matrix-vector inverse a)) (b-image (af-matrix-vector inverse b)))
                        (let coefficients ((i 0))
                          (if (< i degree)
                              (begin (if (not (integer? (vector-ref relation i)))
                                         (error "Integral primitive-element certificate failed"))
                                     (vector-set! polynomial i (af- 0 (vector-ref relation i)))
                                     (coefficients (+ i 1)))))
                        (vector-set! polynomial degree 1)
                        (let* ((interval (af-compositum-real left right c polynomial a-image b-image refinement-limit))
                               (bound (let bound ((i 0) (largest 0))
                                 (if (= i (vector-length polynomial)) (af+ 1 largest)
                                     (bound (+ i 1) (max largest (abs (vector-ref polynomial i)))))))
                               (index (if (<= (car interval) (- bound)) 0
                                 (exact-poly-real-root-count polynomial (- bound) (car interval))))
                               (certificate (vector 'coprime-compositum-v1 left right c))
                               (field (vector 'algebraic-field-v1 polynomial interval certificate index))
                               (ai (algebraic-element field a-image)) (bi (algebraic-element field b-image)))
                          (if (not (algebraic-equal? (algebraic-generator field)
                                (algebraic-add ai (algebraic-scale bi c))))
                              (error "Primitive generator failed its exact residual"))
                          (vector field (make-algebraic-embedding left field ai)
                                        (make-algebraic-embedding right field bi)))))))))))))
