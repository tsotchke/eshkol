;;; Uniform cotangent enclosures from independently certified native solves.
(require core.certified_native_solve)
(provide solve-certified-native-pullback verify-certified-native-pullback)

(define (csp-q x)
  (if (not (and (rational? x) (exact? x))) (error "Pullback data must be exact rational")) x)
(define (csp-tab n f) (list->vector (map f (iota n))))
(define (csp-vector x n positive?)
  (if (not (and (vector? x) (= (vector-length x) n))) (error "Pullback vector shape mismatch"))
  (csp-tab n (lambda (i) (let ((q (csp-q (vector-ref x i))))
    (if (if positive? (<= q 0) (< q 0)) (error "Invalid pullback norm weight or radius")) q))))
(define (csp-transpose a)
  (let ((n (vector-length a))) (csp-tab n (lambda (i) (csp-tab n (lambda (j) (vector-ref (vector-ref a j) i)))))))
(define (csp-premises a options)
  (if (not (and (vector? a) (> (vector-length a) 0) (<= (vector-length a) 64) (<= (length options) 5)))
      (error "Pullback needs dimension 1..64 and at most five premises"))
  (let* ((n (vector-length a)) (pw (if (< (length options) 1) (make-vector n 1) (csp-vector (car options) n #t)))
         (aw (if (< (length options) 2) (make-vector n 1) (csp-vector (cadr options) n #t)))
         (da (if (< (length options) 3) (csp-tab n (lambda (i) (make-vector n 0))) (caddr options)))
         (db (if (< (length options) 4) (make-vector n 0) (list-ref options 3)))
         (ds (if (< (length options) 5) (make-vector n 0) (list-ref options 4))))
    (if (not (and (vector? da) (= (vector-length da) n))) (error "Matrix radius shape mismatch"))
    (vector pw aw (csp-tab n (lambda (i) (csp-vector (vector-ref da i) n #f)))
      (csp-vector db n #f) (csp-vector ds n #f))))
(define (csp-product a b)
  (let ((products (list (csp-q (* (car a) (car b))) (csp-q (* (car a) (cdr b)))
                        (csp-q (* (cdr a) (car b))) (csp-q (* (cdr a) (cdr b))))))
    (cons (- (apply max products)) (- (apply min products)))))
(define (csp-bars primal adjoint)
  (let* ((x (vector-ref primal 3)) (lambda-boxes (vector-ref adjoint 3)) (n (vector-length x)))
    (vector (csp-tab n (lambda (i) (csp-tab n (lambda (j)
      (csp-product (vector-ref lambda-boxes i) (vector-ref x j))))))
      (csp-tab n (lambda (i) (let ((box (vector-ref lambda-boxes i))) (cons (car box) (cdr box))))))))
;; Options: primal weights, adjoint weights, matrix radii, RHS radii, seed radii.
;; A varying seed is an explicitly declared family of linear functionals.
(define (solve-certified-native-pullback a b seed tolerance . options)
  (csp-q tolerance) (if (< tolerance 0) (error "Negative pullback solve tolerance"))
  (let* ((p (csp-premises a options))
         (n (vector-length a))
         (seed (begin (if (not (and (vector? seed) (= (vector-length seed) n))) (error "Seed shape mismatch"))
                 (list->vector (map csp-q (vector->list seed)))))
         (primal (solve-certified-native a b tolerance 3 (vector-ref p 0) (vector-ref p 2) (vector-ref p 3))))
    (if (not (eq? (vector-ref primal 1) 'proved))
        (vector 'certified-native-pullback-v1 'unknown primal #f #f #f)
        (let ((adjoint (solve-certified-native (csp-transpose a) seed tolerance 3
                        (vector-ref p 1) (csp-transpose (vector-ref p 2)) (vector-ref p 4))))
          (if (not (eq? (vector-ref adjoint 1) 'proved))
              (vector 'certified-native-pullback-v1 'unknown primal adjoint #f #f)
              (let ((bars (csp-bars primal adjoint)))
                (vector 'certified-native-pullback-v1 'proved primal adjoint (vector-ref bars 0) (vector-ref bars 1))))))))
;; Rechecks both solve certificates against the original A,b,seed and premises.
;; Product intervals are conservative even though primal and adjoint share A.
(define (verify-certified-native-pullback result a b seed tolerance . options)
  (guard (e (else #f))
    (let ((p (csp-premises a options)))
      (and (vector? result) (= (vector-length result) 6)
           (eq? (vector-ref result 0) 'certified-native-pullback-v1)
           (eq? (vector-ref result 1) 'proved)
           (verify-certified-native-solve (vector-ref result 2) a b tolerance
             (vector-ref p 0) (vector-ref p 2) (vector-ref p 3))
           (verify-certified-native-solve (vector-ref result 3) (csp-transpose a) seed tolerance
             (vector-ref p 1) (csp-transpose (vector-ref p 2)) (vector-ref p 4))
           (let ((bars (csp-bars (vector-ref result 2) (vector-ref result 3))))
             (and (equal? (vector-ref result 4) (vector-ref bars 0))
                  (equal? (vector-ref result 5) (vector-ref bars 1)))))))))
