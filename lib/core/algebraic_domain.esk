;;; Explicit coefficient operations shared by exact algebraic constructions.
;;; An algebraic domain is a core.ring carrier of the `algebraic` family
;;; (ADR-0034): a number field Q(alpha), or one of its exact Taylor or
;;; hyper-dual lifts. `algebraic-domain-ref` keeps the coefficient
;;; vocabulary (copy, add, sub, mul, inverse, equal?, zero?, unit?,
;;; coefficients, element, zero, one) its callers use; the same domain also
;;; answers the generic operations r+ r* r-inv r= ... of core.ring.
(require core.ad.algebraic)
(require core.ring)
(provide algebraic-domain algebraic-domain-ref)

(define (acd-context? x)
  (and (vector? x) (= (vector-length x) 5)
       (eq? (vector-ref x 0) 'algebraic-ad-context-v1)))
(define (acd-tag nested) (if nested 'algebraic-ad-value-v1 'algebraic-element-v1))
(define (acd-owned? owner nested x)
  (and (vector? x) (= (vector-length x) 3)
       (eq? (vector-ref x 0) (acd-tag nested))
       (eq? (vector-ref x 1) owner)))
(define (acd-admit owner nested x)
  (cond
    ((acd-owned? owner nested x) x)
    (nested (algebraic-ad-constant owner x))
    ((and (rational? x) (exact? x)) (algebraic-element owner x))
    (else (error "Coefficient is outside the declared algebraic domain"))))
(define (acd-name owner nested kind dimension parent)
  (cond ((not nested) (string-append "Q(alpha) of degree " (number->string dimension)))
        ((eq? kind 'taylor)
         (string-append (ring-carrier-name parent) "[e]/e^" (number->string dimension)))
        (else (string-append (ring-carrier-name parent) "[e1,e2]/(e1^2,e2^2)"))))
(define (algebraic-domain owner)
  (let* ((nested (acd-context? owner))
         (parent (if nested (algebraic-domain (vector-ref owner 1)) #f))
         (kind (if nested (vector-ref owner 2) 'field))
         (dimension (if nested (vector-ref owner 4) (algebraic-field-degree owner)))
         (admit (lambda (x) (acd-admit owner nested x)))
         (copy (lambda (x)
           (let ((value (admit x)))
             (if nested (algebraic-ad-value owner (algebraic-ad-coefficients value))
                 (algebraic-element owner (algebraic-coefficients value))))))
         (add (if nested algebraic-ad-add algebraic-add))
         (sub (if nested algebraic-ad-sub algebraic-sub))
         (mul (if nested algebraic-ad-mul algebraic-mul))
         (inverse (if nested algebraic-ad-inverse algebraic-inverse))
         (same (if nested algebraic-ad-equal? algebraic-equal?)))
    ;; Validate the declared owner before publishing any operation closure.
    (copy 0)
    (if (and nested (not (or (eq? kind 'taylor) (eq? kind 'hyperdual))))
        (error "Unsupported algebraic coefficient carrier"))
    (let* ((zero? (lambda (a)
                    (let ((value (admit a)))
                      (if nested
                          (let ((cells (algebraic-ad-coefficients value))
                                (parent-zero? (algebraic-domain-ref parent 'zero?)))
                            (let loop ((i 0)) (or (= i dimension)
                              (and (parent-zero? (vector-ref cells i)) (loop (+ i 1))))))
                          (algebraic-zero? value)))))
           (unit? (lambda (a)
                    (let ((value (admit a)))
                      (if nested ((algebraic-domain-ref parent 'unit?)
                                    (vector-ref (algebraic-ad-coefficients value) 0))
                          (not (algebraic-zero? value))))))
           (coefficients (lambda (a) (if nested (algebraic-ad-coefficients (admit a))
                                         (algebraic-coefficients (admit a)))))
           (ops (vector copy
                  (lambda (a b) (add (admit a) (admit b)))
                  (lambda (a b) (sub (admit a) (admit b)))
                  (lambda (a b) (mul (admit a) (admit b)))
                  (lambda (a) (inverse (admit a)))
                  (lambda (a b) (same (admit a) (admit b)))
                  zero? unit? coefficients
                  (lambda (cells) (if nested (algebraic-ad-value owner cells)
                                     (algebraic-element owner cells)))))
           (zero (copy 0))
           (primal (if nested
                       (lambda (a) (vector-ref (algebraic-ad-coefficients (admit a)) 0))
                       #f)))
      (make-family-carrier 8 (list owner) (acd-name owner nested kind dimension parent)
        (list (cons 'characteristic 0)
              (cons 'field? (or (not nested) (= dimension 1)))
              (cons 'lawful? #t) (cons 'exact? #t)
              (cons 'nilpotency (if (eq? kind 'taylor) dimension #f))
              (cons 'base parent)
              (cons 'zero zero) (cons 'one (copy 1))
              (cons 'add (vector-ref ops 1))
              (cons 'neg (lambda (a) ((vector-ref ops 2) zero a)))
              (cons 'mul (vector-ref ops 3))
              (cons 'from-integer copy) (cons 'from-rational copy)
              (cons 'constant (if nested copy #f))
              (cons 'equal? (vector-ref ops 5))
              (cons 'unit? unit?)
              (cons 'inverse (vector-ref ops 4))
              (cons 'member? (lambda (x) (acd-owned? owner nested x)))
              (cons 'primal primal)
              (cons 'nilpotent? (if nested
                                    (let ((parent-nilpotent? (ring-ref parent 'nilpotent?)))
                                      (lambda (a) (parent-nilpotent? (primal a))))
                                    zero?))
              (cons 'self-locating? #t)
              (cons 'extra (list (cons 'algebraic (vector owner kind dimension parent ops)))))))))

;; An algebraic element or AD value names its carrier through its owner.
(ring-register-recognizer!
 (lambda (x)
   (if (and (vector? x) (= (vector-length x) 3)
            (or (eq? (vector-ref x 0) 'algebraic-element-v1)
                (eq? (vector-ref x 0) 'algebraic-ad-value-v1)))
       (algebraic-domain (vector-ref x 1))
       #f)))

(define (algebraic-domain-ref domain key)
  (if (not (and (ring-carrier? domain) (= (ring-carrier-family-id domain) 8)))
      (error "Expected an algebraic coefficient domain"))
  (let* ((data (ring-carrier-extra domain 'algebraic)) (ops (vector-ref data 4)))
    (cond ((eq? key 'owner) (vector-ref data 0))
          ((eq? key 'kind) (vector-ref data 1))
          ((eq? key 'dimension) (vector-ref data 2))
          ((eq? key 'parent) (vector-ref data 3))
          ((eq? key 'depth) (if (vector-ref data 3)
              (+ 1 (algebraic-domain-ref (vector-ref data 3) 'depth)) 0))
          ((eq? key 'copy) (vector-ref ops 0))
          ((eq? key 'add) (vector-ref ops 1))
          ((eq? key 'sub) (vector-ref ops 2))
          ((eq? key 'mul) (vector-ref ops 3))
          ((eq? key 'inverse) (vector-ref ops 4))
          ((eq? key 'equal?) (vector-ref ops 5))
          ((eq? key 'zero?) (vector-ref ops 6))
          ((eq? key 'unit?) (vector-ref ops 7))
          ((eq? key 'coefficients) (vector-ref ops 8))
          ((eq? key 'element) (vector-ref ops 9))
          ((eq? key 'zero) ((vector-ref ops 0) 0))
          ((eq? key 'one) ((vector-ref ops 0) 1))
          (else (error "Unknown algebraic domain operation")))))
