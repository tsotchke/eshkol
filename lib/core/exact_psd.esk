;;; Rational PSD factors and independently checkable negative directions.
;;; Optional: (require core.exact_psd). Generic vectors preserve exact cells.
(require stdlib)
(provide exact-psd-factor psd-factor? psd-factor-rows psd-factor-weights psd-negative-direction)

(define (psd-exact x)
  (if (not (and (rational? x) (exact? x)))
      (error "exact-psd-factor: arithmetic requires exact rationals" x)) x)
(define (psd+ a b) (psd-exact (+ a b)))
(define (psd- a b) (psd-exact (- a b)))
(define (psd* a b) (psd-exact (* a b)))
(define (psd/ a b) (psd-exact (/ a b)))
(define (psd-copy-rows matrix)
  (let* ((n (vector-length matrix)) (out (make-vector n #f)))
    (let loop ((i 0))
      (if (< i n) (begin (vector-set! out i (vector-copy (vector-ref matrix i))) (loop (+ i 1))))) out))
(define (psd-check-result result)
  (if (not (and (vector? result) (= (vector-length result) 4)
                (eq? (vector-ref result 0) 'exact-psd-result-v1)))
      (error "Expected an exact PSD result")))
(define (psd-factor? result)
  (psd-check-result result) (not (eq? (vector-ref result 1) #f)))
(define (psd-factor-rows result)
  (if (not (psd-factor? result)) (error "An indefinite matrix has no PSD factor"))
  (psd-copy-rows (vector-ref result 1)))
(define (psd-factor-weights result)
  (if (not (psd-factor? result)) (error "An indefinite matrix has no PSD weights"))
  (vector-copy (vector-ref result 2)))
(define (psd-negative-direction result)
  (psd-check-result result)
  (if (eq? (vector-ref result 3) #f) #f (vector-copy (vector-ref result 3))))

;; Undo previously extracted unit-pivot rows, in reverse pivot order, to
;; transport a negative direction of the Schur remainder to the original form.
(define (psd-negative n rows w j i)
  (let ((v (make-vector n 0)))
    (if (= i j) (vector-set! v j 1)
        (let ((c (exact-matrix-ref w i j)))
          (vector-set! v i 1)
          (vector-set! v j (psd/ (psd- 0 (psd+ (exact-matrix-ref w i i) (abs c))) (psd* 2 c)))))
    (for-each (lambda (entry)
      (let ((pivot (car entry)) (row (cadr entry)))
        (vector-set! v pivot
          (psd- 0 (let dot ((k (+ pivot 1)) (sum 0))
            (if (= k n) sum (dot (+ k 1) (psd+ sum (psd* (vector-ref row k) (vector-ref v k)))))))))) rows)
    v))

;; Success owns B,D with M = transpose(B) diag(D) B and D strictly positive.
;; Symmetric indefiniteness owns v with transpose(v) M v < 0. Shape, symmetry
;; and exact-rational admission failures raise; input storage is untouched.
(define (exact-psd-factor matrix)
  (if (not (vector? matrix)) (error "Expected a square exact rational matrix"))
  (let ((n (vector-length matrix)))
    (let validate ((i 0))
      (if (< i n)
          (begin
            (if (not (and (vector? (vector-ref matrix i))
                          (= (vector-length (vector-ref matrix i)) n)))
                (error "PSD matrix must be square"))
            (let entries ((j 0))
              (if (< j n) (begin (psd-exact (exact-matrix-ref matrix i j)) (entries (+ j 1)))))
            (validate (+ i 1)))))
    (let symmetry ((i 0))
      (if (< i n)
          (begin
            (let pair ((j 0))
              (if (< j i)
                  (begin
                    (if (not (= (exact-matrix-ref matrix i j) (exact-matrix-ref matrix j i)))
                        (error "PSD matrix must be symmetric"))
                    (pair (+ j 1)))))
            (symmetry (+ i 1)))))
    (let ((w (psd-copy-rows matrix)))
      (let eliminate ((j 0) (rows '()) (weights '()))
        (if (= j n)
            (vector 'exact-psd-result-v1 (list->vector (map cadr (reverse rows)))
                    (list->vector (reverse weights)) #f)
            (let ((d (exact-matrix-ref w j j)))
              (cond
                ((< d 0) (vector 'exact-psd-result-v1 #f #f (psd-negative n rows w j j)))
                ((= d 0)
                 (let find ((i (+ j 1)))
                   (cond ((= i n) (eliminate (+ j 1) rows weights))
                         ((not (= (exact-matrix-ref w i j) 0))
                          (vector 'exact-psd-result-v1 #f #f (psd-negative n rows w j i)))
                         (else (find (+ i 1))))))
                (else
                  (let ((row (make-vector n 0)))
                    (vector-set! row j 1)
                    (let normalize ((k (+ j 1)))
                      (if (< k n)
                          (begin (vector-set! row k (psd/ (exact-matrix-ref w j k) d))
                                 (normalize (+ k 1)))))
                    (let update-row ((i (+ j 1)))
                      (if (< i n)
                          (begin
                            (let update-col ((k i))
                              (if (< k n)
                                  (let ((value (psd- (exact-matrix-ref w i k)
                                    (psd* (vector-ref row i) (exact-matrix-ref w j k)))))
                                    (vector-set! (vector-ref w i) k value)
                                    (vector-set! (vector-ref w k) i value)
                                    (update-col (+ k 1)))))
                            (update-row (+ i 1)))))
                    (eliminate (+ j 1) (cons (list j row) rows) (cons d weights)))))))))))
