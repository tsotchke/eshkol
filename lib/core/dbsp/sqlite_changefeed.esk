;;; One SQLite database owns ordered batches, consumed cursor and checkpoint.
(require agent.sqlite)
(require core.dbsp.checkpoint)
(provide dbsp-sqlite-create! dbsp-sqlite-enqueue! dbsp-sqlite-consume! dbsp-sqlite-state)
(define (cf-source source)
  (if (not (and (string? source) (> (string-byte-length source) 0) (<= (string-byte-length source) 256)))
      (error "Changefeed source must contain 1..256 bytes")) source)
(define (cf-sequence seq)
  (if (not (and (integer? seq) (exact? seq) (> seq 0) (<= seq 9223372036854775807)))
      (error "Changefeed sequence must be a positive signed-word integer")) seq)
(define (cf-ok code) (if (not (= code 0)) (error "SQLite changefeed operation failed" code)))
(define (cf-sql db sql) (cf-ok (sqlite-exec db sql)))
(define (cf-statement db sql values body)
  (with-statement db sql (lambda (stmt)
    (let bind ((rest values) (i 1)) (if (pair? rest)
      (begin (cf-ok (if (string? (car rest)) (sqlite-bind-text stmt i (car rest)) (sqlite-bind-int stmt i (car rest))))
             (bind (cdr rest) (+ i 1)))))
    (body stmt))))
(define (cf-command db sql values)
  (cf-statement db sql values (lambda (stmt)
    (if (sqlite-step-checked stmt) (error "Unexpected row from changefeed command")))))
(define (cf-transaction db body)
  (cf-sql db "BEGIN IMMEDIATE")
  (guard (e (else (guard (ignored (else #f)) (cf-sql db "ROLLBACK")) (raise e)))
    (let ((result (body))) (cf-sql db "COMMIT") result)))
(define (cf-row db source)
  (cf-source source)
  (cf-statement db "SELECT produced,consumed,checkpoint FROM eshkol_dbsp_stream_v1 WHERE source=?" (list source)
    (lambda (stmt) (if (sqlite-step-checked stmt)
      (begin
        (if (not (and (= (sqlite-column-type stmt 0) 1) (= (sqlite-column-type stmt 1) 1) (= (sqlite-column-type stmt 2) 3)))
            (error "Corrupt SQLite changefeed metadata types"))
        (let ((row (vector (sqlite-column-int stmt 0) (sqlite-column-int stmt 1) (sqlite-column-text stmt 2))))
          (if (not (and (>= (vector-ref row 1) 0) (>= (vector-ref row 0) (vector-ref row 1))))
              (error "Corrupt SQLite changefeed cursors"))
          (if (sqlite-step-checked stmt) (error "Duplicate changefeed source")) row)) #f))))
(define (cf-batch db source seq)
  (cf-statement db "SELECT payload FROM eshkol_dbsp_batch_v1 WHERE source=? AND seq=?" (list source seq)
    (lambda (stmt) (if (sqlite-step-checked stmt)
      (begin (if (not (= (sqlite-column-type stmt 0) 3)) (error "Corrupt batch payload type"))
        (let ((bytes (sqlite-column-text stmt 0)))
          (if (sqlite-step-checked stmt) (error "Duplicate source batch")) bytes)) #f))))
;; Queue payloads reuse the existing typed checkpoint codec, including its
;; exactness, acyclicity, integrity and byte budgets. There is no second codec.
(define (cf-batch-template) (make-dbsp-resumable '(batch) '() 'batch '() '(sqlite-changefeed-batch-v1)))
(define (cf-encode changes)
  (if (not (and (list? changes) (<= (length changes) 64))) (error "Expected at most 64 named changes"))
  (let ((inputs '()))
    (for-each (lambda (entry)
      (if (not (and (list? entry) (= (length entry) 2) (symbol? (car entry)) (zset? (cadr entry))))
          (error "Expected (input-name Z-set) batch"))
      (let ((old (assq (car entry) inputs)))
        (if old (set! inputs (map (lambda (p) (if (eq? (car p) (car entry))
          (cons (car p) (zset-add (cdr p) (cadr entry))) p)) inputs))
          (set! inputs (cons (cons (car entry) (cadr entry)) inputs))))) changes)
    (let ((rows '()))
      (for-each (lambda (entry) (for-each (lambda (weighted)
        (set! rows (cons (list (car entry) (car weighted) (cadr weighted)) rows))) (zset-entries (cdr entry)))) inputs)
      (dbsp-resumable-checkpoint (vector-ref (dbsp-resumable-step (cf-batch-template) 1
        (list (list 'batch (zset-from-weighted (map (lambda (row) (list 1 row)) rows))))) 0)))))
(define (cf-decode bytes)
  (let* ((state (dbsp-resumable-restore (cf-batch-template) bytes)) (inputs '()))
    (if (not (= (dbsp-resumable-tick state) 1)) (error "Invalid changefeed batch clock"))
    (for-each (lambda (weighted)
      (let ((row (cadr weighted)))
        (if (not (and (= (car weighted) 1) (list? row) (= (length row) 3) (symbol? (car row))
                      (integer? (cadr row)) (exact? (cadr row)) (not (= (cadr row) 0))))
            (error "Invalid queued weighted change"))
        (let* ((old (assq (car row) inputs)) (delta (zset-singleton (caddr row) (cadr row))))
          (if old (set! inputs (map (lambda (p) (if (eq? (car p) (car row))
            (cons (car p) (zset-add (cdr p) delta)) p)) inputs))
            (set! inputs (cons (cons (car row) delta) inputs)))))) (zset-entries (dbsp-resumable-output state)))
    (map (lambda (p) (list (car p) (cdr p))) inputs)))
(define (dbsp-sqlite-create! db source template)
  (cf-source source)
  (if (not (= (dbsp-resumable-tick template) 0)) (error "New changefeed template must start at clock zero"))
  (let ((bytes (dbsp-resumable-checkpoint template)))
    (cf-transaction db (lambda ()
      (cf-sql db "CREATE TABLE IF NOT EXISTS eshkol_dbsp_stream_v1(source TEXT PRIMARY KEY,produced INTEGER NOT NULL,consumed INTEGER NOT NULL,checkpoint TEXT NOT NULL)")
      (cf-sql db "CREATE TABLE IF NOT EXISTS eshkol_dbsp_batch_v1(source TEXT NOT NULL,seq INTEGER NOT NULL,payload TEXT NOT NULL,PRIMARY KEY(source,seq))")
      (let ((row (cf-row db source)))
        (if row (let ((restored (dbsp-resumable-restore template (vector-ref row 2))))
          (if (not (= (dbsp-resumable-tick restored) (vector-ref row 1))) (error "Checkpoint/cursor mismatch")) 'existing)
          (begin (cf-command db "INSERT INTO eshkol_dbsp_stream_v1 VALUES(?,0,0,?)" (list source bytes)) 'created)))))))
(define (dbsp-sqlite-enqueue! db source seq changes)
  (cf-source source) (cf-sequence seq)
  (let ((bytes (cf-encode changes)))
    (cf-transaction db (lambda ()
      (let ((row (cf-row db source)))
        (if (not row) (error "Unknown SQLite changefeed source"))
        (cond ((<= seq (vector-ref row 0))
               (let ((old (cf-batch db source seq)))
                 (if (and old (string=? old bytes)) 'duplicate (error "Conflicting replay of source batch"))))
              ((not (= seq (+ 1 (vector-ref row 0)))) (error "Source batch sequence gap"))
              (else (cf-command db "INSERT INTO eshkol_dbsp_batch_v1 VALUES(?,?,?)" (list source seq bytes))
                    (cf-command db "UPDATE eshkol_dbsp_stream_v1 SET produced=? WHERE source=?" (list seq source)) 'queued)))))))
(define (cf-restore template row)
  (let ((state (dbsp-resumable-restore template (vector-ref row 2))))
    (if (not (= (dbsp-resumable-tick state) (vector-ref row 1))) (error "Checkpoint/cursor mismatch")) state))
(define (dbsp-sqlite-state db source template)
  (let ((row (cf-row db source))) (if (not row) (error "Unknown SQLite changefeed source")) (cf-restore template row)))
(define (cf-publish! db source seq bytes)
  (cf-command db "UPDATE eshkol_dbsp_stream_v1 SET consumed=?,checkpoint=? WHERE source=?" (list seq bytes source)))
;; Returns #(advanced|idle state output-delta). Publication is after COMMIT.
;; Every call restores the database authority, avoiding a stale in-memory cursor.
(define (dbsp-sqlite-consume! db source template . options)
  (if (not (and (<= (length options) 1) (or (null? options) (procedure? (car options)))))
      (error "Expected an optional transactional on-advance callback"))
  (cf-source source)
  (cf-transaction db (lambda ()
    (let ((row (cf-row db source)))
      (if (not row) (error "Unknown SQLite changefeed source"))
      (let ((state (cf-restore template row)))
        (if (= (vector-ref row 0) (vector-ref row 1)) (vector 'idle state (zset-empty))
          (let* ((seq (+ 1 (vector-ref row 1))) (bytes (cf-batch db source seq)))
            (if (not bytes) (error "Queued source batch is missing"))
            (let* ((step (dbsp-resumable-step state seq (cf-decode bytes)))
                   (checkpoint (dbsp-resumable-checkpoint (vector-ref step 0))))
              (cf-publish! db source seq checkpoint)
              ;; Same-database companion writes (e.g. an outbox) share COMMIT.
              ;; Only the immutable sequence escapes; callers can query owned
              ;; state through dbsp-sqlite-state on their borrowed connection.
              (if (pair? options) ((car options) seq))
              (vector 'advanced (vector-ref step 0) (vector-ref step 1))))))))))
