;;; Explicit event-time windows. Watermarks are inputs, never ambient clocks.
(require core.dbsp)
(provide make-dbsp-window dbsp-window-step dbsp-window-output dbsp-window-info)

(define (dw-time x)
  (if (not (and (rational? x) (exact? x))) (error "Window times must be exact rationals")) x)
(define (dw-check state)
  (if (not (and (vector? state) (= (vector-length state) 9) (eq? (vector-ref state 0) 'dbsp-window-v1)))
      (error "Expected event-time window state")))
;; State retains rows newer than watermark-width, including buffered future rows.
;; The open lower/closed upper endpoints are deliberate: (watermark-width,watermark].
(define (make-dbsp-window timestamp width lateness policy watermark)
  (dw-time width) (dw-time lateness) (dw-time watermark)
  (if (not (and (procedure? timestamp) (> width 0) (>= lateness 0)
                (or (eq? policy 'reject) (eq? policy 'drop))))
      (error "Expected pure timestamp function, positive width, nonnegative lateness and reject/drop policy"))
  (vector 'dbsp-window-v1 timestamp width lateness policy watermark (zset-empty) (zset-empty) (vector 0 0 0 0)))
(define (dbsp-window-step state delta watermark)
  (dw-check state) (dw-time watermark)
  (if (< watermark (vector-ref state 5)) (error "Window watermark cannot move backwards"))
  (if (not (zset? delta)) (error "Window update must be a Z-set"))
  (let* ((entries (zset-entries delta)) (timestamp (vector-ref state 1))
         (old-time (vector-ref state 5)) (cutoff (- watermark (vector-ref state 2)))
         (late-cutoff (- old-time (vector-ref state 3)))
         (retained (vector-ref state 6)) (accepted '()) (dropped '())
         (work (vector (length entries) 0 0 0)))
    (dw-time cutoff) (dw-time late-cutoff)
    (if (> (length entries) 65536) (error "Window input exceeds changed-row budget"))
    ;; Consolidation precedes policy checks. Known retractions remain admissible
    ;; despite lateness; absent/excess retractions cannot be hidden by drop policy.
    (for-each (lambda (entry)
      (let* ((weight (car entry)) (row (cadr entry)) (t (dw-time (timestamp row))))
        (cond
          ((and (> weight 0) (< t late-cutoff))
           (if (eq? (vector-ref state 4) 'reject) (error "Late insertion exceeds window policy"))
           (set! dropped (cons entry dropped))
           (vector-set! work 3 (+ 1 (vector-ref work 3))))
          (else
           (if (< (+ (zset-weight retained row) weight) 0) (error "Window retracts absent/excess multiplicity"))
           (set! accepted (cons entry accepted)))))) entries)
    (let* ((candidate (zset-add retained (zset-from-weighted accepted)))
           (candidate-entries (zset-entries candidate)) (kept '()) (active '()))
      (if (> (length candidate-entries) 65536) (error "Window retained-row budget exceeded"))
      (for-each (lambda (entry)
        (vector-set! work 1 (+ 1 (vector-ref work 1)))
        (let ((t (dw-time (timestamp (cadr entry)))))
          (if (<= t cutoff) (vector-set! work 2 (+ 1 (vector-ref work 2)))
              (begin (set! kept (cons entry kept))
                (if (<= t watermark) (set! active (cons entry active))))))) candidate-entries)
      (let* ((next-view (zset-from-weighted active))
             (next (vector 'dbsp-window-v1 timestamp (vector-ref state 2) (vector-ref state 3)
               (vector-ref state 4) watermark (zset-from-weighted kept) next-view work)))
        (vector next (zset-add next-view (zset-negate (vector-ref state 7)))
          (zset-from-weighted dropped) (vector-copy work))))))
(define (dbsp-window-output state)
  (dw-check state) (zset-from-weighted (zset-entries (vector-ref state 7))))
(define (dbsp-window-info state)
  (dw-check state) (vector (vector-ref state 5) (vector-ref state 2) (vector-ref state 3)
    (length (zset-entries (vector-ref state 6))) (vector-copy (vector-ref state 8))))
