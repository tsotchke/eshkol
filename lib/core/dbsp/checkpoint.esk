;;; Versioned declarative DBSP templates and atomic process-restart checkpoints.
(require core.dbsp.circuit)
(require core.files)
(require core.sexp)
(require agent.crypto)
(provide make-dbsp-resumable dbsp-resumable-step dbsp-resumable-output
         dbsp-resumable-tick dbsp-resumable-checkpoint dbsp-resumable-restore
         dbsp-checkpoint-save dbsp-checkpoint-load)

;; The wire codec contains only fixed tags and exact integers. User strings,
;; symbols and characters are code-point lists, avoiding core.sexp's unescaped
;; string/symbol rendering. Unknown values and cyclic/deep data refuse.
(define (bc-encode value)
  (let ((budget 100000))
    (define (proper-elements x seen out)
      (set! budget (- budget 1))
      (if (< budget 0) (error "Checkpoint list budget exceeded"))
      (cond ((null? x) (reverse out)) ((not (pair? x)) #f)
            ((memq x seen) (error "Checkpoint values must be acyclic"))
            (else (proper-elements (cdr x) (cons x seen) (cons (car x) out)))))
    (define (walk x depth ancestors)
      (set! budget (- budget 1))
      (if (or (< budget 0) (> depth 64)) (error "Checkpoint value budget exceeded"))
      (cond
        ((null? x) '(nil))
        ((boolean? x) (list 'bool (if x 1 0)))
        ((and (rational? x) (exact? x)) (list 'rat (numerator x) (denominator x)))
        ((char? x) (list 'char (char->integer x)))
        ((or (string? x) (symbol? x))
         (let ((s (if (string? x) x (symbol->string x))))
           (if (> (string-length s) budget) (error "Checkpoint text budget exceeded"))
           (set! budget (- budget (string-length s)))
           (list (if (string? x) 'str 'sym)
                 (map (lambda (i) (char->integer (string-ref s i))) (iota (string-length s))))))
        ((or (pair? x) (vector? x))
         (if (memq x ancestors) (error "Checkpoint values must be acyclic"))
         (if (vector? x)
             (list 'vec (map (lambda (v) (walk v (+ depth 1) (cons x ancestors))) (vector->list x)))
             (let ((elements (proper-elements x '() '())))
               (if elements
                   (list 'lst (map (lambda (v) (walk v (+ depth 1) (cons x ancestors))) elements))
                   (list 'pair (walk (car x) (+ depth 1) (cons x ancestors)) (walk (cdr x) (+ depth 1) (cons x ancestors)))))))
        (else (error "Checkpoint supports exact rational data, strings, symbols, chars, booleans, lists and vectors only"))))
    (walk value 0 '())))
(define (bc-decode value)
  (let ((budget 100000))
    (define (walk x depth)
      (set! budget (- budget 1))
      (if (or (< budget 0) (> depth 64) (not (list? x)) (null? x)) (error "Malformed checkpoint wire value"))
      (let ((tag (car x)) (n (length x)))
        (cond
          ((and (eq? tag 'nil) (= n 1)) '())
          ((and (eq? tag 'bool) (= n 2) (memv (cadr x) '(0 1))) (= (cadr x) 1))
          ((and (eq? tag 'rat) (= n 3) (integer? (cadr x)) (exact? (cadr x))
                (integer? (caddr x)) (exact? (caddr x)) (> (caddr x) 0))
           (let ((v (/ (cadr x) (caddr x)))) (if (not (exact? v)) (error "Checkpoint rational lost exactness")) v))
          ((and (eq? tag 'char) (= n 2) (integer? (cadr x)) (exact? (cadr x))) (integer->char (cadr x)))
          ((and (memq tag '(str sym)) (= n 2) (list? (cadr x)))
           (let ((s (list->string (map (lambda (i)
             (if (not (and (integer? i) (exact? i) (>= i 0) (<= i 1114111))) (error "Invalid checkpoint code point"))
             (integer->char i)) (cadr x)))))
             (set! budget (- budget (length (cadr x)))) (if (eq? tag 'str) s (string->symbol s))))
          ((and (memq tag '(vec lst)) (= n 2) (list? (cadr x)))
           (let ((values (map (lambda (v) (walk v (+ depth 1))) (cadr x))))
             (if (eq? tag 'vec) (list->vector values) values)))
          ((and (eq? tag 'pair) (= n 3)) (cons (walk (cadr x) (+ depth 1)) (walk (caddr x) (+ depth 1))))
          (else (error "Unknown checkpoint wire tag" tag)))))
    (walk value 0)))
(define (bc-freeze data) (bc-decode (bc-encode data)))
(define (bc-render data)
  ;; All arbitrary strings/symbols/chars were encoded as code-point lists.
  ;; The only raw string in the envelope is the hexadecimal digest.
  (sexp->canonical-string data))
(define (bc-digest data)
  (let ((digest (sha256 (bc-render (bc-encode data)))))
    (if (not digest) (error "Checkpoint SHA-256 unavailable")) digest))
(define (bc-registry registry)
  (if (not (and (list? registry) (<= (length registry) 256))) (error "Expected a bounded versioned operator registry"))
  (let ((names '()))
    (map (lambda (entry)
      (if (not (and (list? entry) (>= (length entry) 4) (symbol? (car entry))
                    (string? (cadr entry)) (> (string-length (cadr entry)) 0)
                    (memq (caddr entry) '(map filter project join))
                    (= (length entry) (if (eq? (caddr entry) 'join) 6 4))
                    (not (memq (car entry) names)))) (error "Malformed versioned DBSP operator"))
      (for-each (lambda (p) (if (not (procedure? p)) (error "Expected pure registered procedure"))) (cdddr entry))
      (set! names (cons (car entry) names))
      (append (list (car entry) (bc-freeze (cadr entry)) (caddr entry)) (cdddr entry))) registry)))
(define (bc-versions registry)
  (sort (map (lambda (entry) (list (car entry) (cadr entry) (caddr entry))) registry)
        (lambda (a b) (string<? (zset-row-key (car a)) (zset-row-key (car b))))))
(define (bc-build contract registry)
  (let ((declarations (vector-ref contract 2)))
    (make-dbsp-circuit (vector-ref contract 1)
      (map (lambda (spec)
        (if (not (and (list? spec) (>= (length spec) 3))) (error "Malformed declarative DBSP node"))
        (let ((op (car spec)))
          (if (memq op '(union distinct)) spec
              (begin
                (if (not (and (memq op '(map filter project join)) (= (length spec) (if (eq? op 'join) 5 4))))
                    (error "Unsupported declarative checkpoint operator"))
                (let* ((name (list-ref spec (- (length spec) 1))) (entry (assq name registry)))
                  (if (not (and entry (eq? (caddr entry) op))) (error "Operator registry kind/name mismatch" name))
                  (append (take spec (- (length spec) 1)) (cdddr entry))))))) declarations)
      (vector-ref contract 3))))
(define (bc-check state)
  (if (not (and (vector? state) (= (vector-length state) 5) (eq? (vector-ref state 0) 'dbsp-resumable-v1)))
      (error "Expected a resumable DBSP snapshot")))
(define (make-dbsp-resumable inputs declarations output registry schema)
  (let* ((registry (bc-registry registry))
         (contract (bc-freeze (vector 'dbsp-template-v1 inputs declarations output schema (bc-versions registry))))
         (circuit (bc-build contract registry)))
    (vector 'dbsp-resumable-v1 contract registry circuit 0)))
(define (dbsp-resumable-tick state) (bc-check state) (vector-ref state 4))
(define (dbsp-resumable-output state)
  (bc-check state) (zset-from-weighted (bc-freeze (zset-entries (dbsp-circuit-output (vector-ref state 3))))))
(define (dbsp-resumable-step state tick changes)
  (bc-check state)
  (if (not (and (integer? tick) (exact? tick) (= tick (+ 1 (vector-ref state 4)))))
      (error "Resumable DBSP tick must be the next exact logical clock"))
  (let* ((owned (map (lambda (entry)
          (if (not (and (list? entry) (= (length entry) 2) (zset? (cadr entry)))) (error "Expected named Z-set batch"))
          (list (car entry) (zset-from-weighted (bc-freeze (zset-entries (cadr entry)))))) changes))
         (step (dbsp-circuit-step (vector-ref state 3) owned)))
    (vector (vector 'dbsp-resumable-v1 (vector-ref state 1) (vector-ref state 2) (car step) tick)
            (zset-from-weighted (bc-freeze (zset-entries (cdr step)))))))
(define (dbsp-resumable-checkpoint state)
  (bc-check state)
  (let* ((contract (vector-ref state 1)) (circuit (vector-ref state 3))
         (inputs (map (lambda (name) (list name (zset-entries (dbsp-circuit-input circuit name)))) (vector-ref contract 1)))
         (payload (vector contract (vector-ref state 4) inputs (bc-digest (dbsp-circuit-checkpoint-state circuit))))
         (encoded (bc-encode payload)) (digest (sha256 (bc-render encoded)))
         (bytes (bc-render (list 'dbsp-checkpoint-v1 digest encoded))))
    (if (or (not digest) (> (string-byte-length bytes) 4194304)) (error "Checkpoint digest/byte budget failed")) bytes))
(define (dbsp-resumable-restore template bytes)
  (bc-check template)
  (if (not (and (string? bytes) (<= (string-byte-length bytes) 4194304))) (error "Checkpoint byte budget exceeded"))
  (let* ((port (open-input-string bytes)) (wire (read port)) (trailing (read port)))
    (close-port port)
    (if (not (and (eof-object? trailing) (list? wire) (= (length wire) 3)
                  (eq? (car wire) 'dbsp-checkpoint-v1) (string? (cadr wire)))) (error "Invalid checkpoint envelope"))
    (let* ((payload (bc-decode (caddr wire)))
           (canonical (bc-render (bc-encode payload))))
      (if (not (and (equal? (bc-encode payload) (caddr wire))
                    (string=? (cadr wire) (sha256 canonical))
                    (string=? bytes (bc-render wire))
                    (vector? payload) (= (vector-length payload) 4))) (error "Checkpoint integrity check failed"))
      (if (not (equal? (vector-ref payload 0) (vector-ref template 1))) (error "Checkpoint template/version mismatch"))
      (let ((tick (vector-ref payload 1)) (inputs (vector-ref payload 2)) (contract (vector-ref template 1)))
        (if (not (and (integer? tick) (exact? tick) (>= tick 0) (list? inputs)
                      (equal? (map car inputs) (vector-ref contract 1)))) (error "Malformed checkpoint input clocks/names"))
        (let* ((empty (bc-build contract (vector-ref template 2)))
               (changes (map (lambda (entry) (if (not (and (list? entry) (= (length entry) 2))) (error "Malformed checkpoint input"))
                          (list (car entry) (zset-from-weighted (cadr entry)))) inputs))
               (restored (car (dbsp-circuit-step empty changes))))
          (if (not (string=? (bc-digest (dbsp-circuit-checkpoint-state restored)) (vector-ref payload 3)))
              (error "Checkpoint operator-state verification failed"))
          (vector 'dbsp-resumable-v1 contract (vector-ref template 2) restored tick))))))
(define (dbsp-checkpoint-save path state)
  (if (not (atomic-write-file path (dbsp-resumable-checkpoint state))) (error "Atomic checkpoint publication failed")) #t)
(define (dbsp-checkpoint-load path template)
  (let* ((port (open-input-file path)) (buffer (make-string 4194305 #\space))
         (bytes (guard (e (else (close-port port) (raise e)))
           (let loop ((i 0))
             (let ((c (read-char port)))
               (cond ((eof-object? c) (close-port port) (substring buffer 0 i))
                     ((>= i 4194304) (error "Checkpoint file exceeds byte budget"))
                     (else (string-set! buffer i c) (loop (+ i 1)))))))))
    (dbsp-resumable-restore template bytes)))
