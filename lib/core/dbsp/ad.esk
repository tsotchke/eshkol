;;; Fixed-parameter row loss/gradient lifts using the existing AD tape.
(require core.dbsp.circuit)
(require core.ad.tape)
(provide dbsp-vector-group dbsp-ad-lift)

(define (da-real x)
  (if (not (and (real? x) (finite? x))) (error "Expected a finite real AD value")) x)
(define (da-vector value dimension)
  (if (not (and (vector? value) (= (vector-length value) dimension)))
      (error "Aggregate vector dimension mismatch"))
  (let validate ((i 0))
    (if (< i dimension) (begin (da-real (vector-ref value i)) (validate (+ i 1))))))
(define (da-add a b dimension)
  (da-vector a dimension) (da-vector b dimension)
  (let ((out (make-vector dimension 0)))
    (let cells ((i 0))
      (if (< i dimension)
          (begin (vector-set! out i (da-real (+ (vector-ref a i) (vector-ref b i))))
                 (cells (+ i 1))))) out))
(define (da-negate a dimension)
  (da-vector a dimension)
  (let ((out (make-vector dimension 0)))
    (let cells ((i 0))
      (if (< i dimension)
          (begin (vector-set! out i (da-real (- (vector-ref a i)))) (cells (+ i 1))))) out))
(define (da-zero? a dimension)
  (da-vector a dimension)
  (let cells ((i 0)) (or (= i dimension) (and (= (vector-ref a i) 0) (cells (+ i 1))))))
(define (dbsp-vector-group dimension)
  (if (not (and (integer? dimension) (exact? dimension) (>= dimension 0)
                (<= dimension 9223372036854775807))) (error "Invalid aggregate vector dimension"))
  (make-dbsp-group (lambda () (make-vector dimension 0))
    (lambda (a b) (da-add a b dimension)) (lambda (a) (da-negate a dimension))
    (lambda (a) (da-zero? a dimension))))

;; BUILD receives (tape parameter-nodes row), and returns a scalar node made
;; with that tape. The returned pure lift owns the fixed parameter point.
;; Each row gets a fresh tape; returned #(loss gradient...) owns its cells.
;; Custom builder callbacks retain their existing tape correctness obligations.
(define (dbsp-ad-lift point build)
  (if (not (and (vector? point) (procedure? build))) (error "Expected AD point and loss builder"))
  (let* ((dimension (vector-length point)) (owned (vector-copy point)))
    (da-vector owned dimension)
    (lambda (row)
      (let* ((tape (make-tape))
             (parameters (map (lambda (x) (tape-input tape x)) (vector->list owned)))
             (loss (build tape parameters row)))
        (if (not (and (vector? loss) (= (vector-length loss) 2)))
            (error "Loss builder must return a scalar tape node"))
        (da-real (node-value loss))
        (let ((gradient (tape-gradient tape loss parameters)) (out (make-vector (+ dimension 1) 0)))
          (vector-set! out 0 (node-value loss))
          (let copy ((rest gradient) (i 1))
            (if (not (null? rest))
                (begin (vector-set! out i (da-real (car rest))) (copy (cdr rest) (+ i 1)))))
          out)))))
