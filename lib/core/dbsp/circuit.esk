;;; Pure standing Z-set circuits; callbacks and rows must be immutable/pure.
(require core.dbsp)
(require core.data.radix)
(provide make-dbsp-circuit dbsp-circuit-step dbsp-circuit-output
         dbsp-circuit-input dbsp-circuit-work dbsp-circuit-checkpoint-state)

;; Persistent collision buckets over the shared radix owner. Canonical key
;; encoding is core.dbsp's; equality remains equal?, never hash equality.
(define (dc-hash key)
  (let ((s (zset-row-key key)))
    (let loop ((i 0) (h 5381))
      (if (= i (string-length s)) h
          (loop (+ i 1) (modulo (+ (* h 33) (char->integer (string-ref s i))) 4294967296))))))
(define (dc-get root key fallback)
  (let ((pair (assoc key (radix-ref root (dc-hash key) '()))))
    (if pair (cdr pair) fallback)))
(define (dc-put root key value work)
  (if work (vector-set! work 3 (+ (vector-ref work 3) 1)))
  (let* ((h (dc-hash key)) (bucket (radix-ref root h '()))
         (rest (filter (lambda (pair) (not (equal? key (car pair)))) bucket)))
    (if (eq? value #f)
        (if (null? rest) (radix-delete root h) (radix-set root h rest))
        (radix-set root h (cons (cons key value) rest)))))
(define (dc-fold root function initial)
  (radix-fold root (lambda (hash bucket acc)
    (fold-left (lambda (out pair) (function (car pair) (cdr pair) out)) acc bucket)) initial))
(define (dc-trace-apply root delta work)
  (fold-left (lambda (out entry)
    (let* ((row (cadr entry)) (next (+ (dc-get out row 0) (car entry))))
      (vector-set! work 2 (+ (vector-ref work 2) 1))
      (dc-put out row (if (= next 0) #f next) work))) root (zset-entries delta)))
(define (dc-observe trace)
  (zset-from-weighted (dc-fold trace (lambda (row weight acc) (cons (list weight row) acc)) '())))
(define (dc-arrange root delta key work)
  (fold-left (lambda (out entry)
    (let* ((k (key (cadr entry)))
           (next (zset-add (dc-get out k (zset-empty)) (zset-singleton (cadr entry) (car entry)))))
      (dc-put out k (if (zset-empty? next) #f next) work))) root (zset-entries delta)))
(define (dc-probe delta arrangement key emit left? work)
  (let ((pairs '()))
    (for-each (lambda (change)
      (vector-set! work 1 (+ (vector-ref work 1) 1))
      (for-each (lambda (stored)
        (vector-set! work 1 (+ (vector-ref work 1) 1))
        (set! pairs (cons (list (* (car change) (car stored))
          (if left? (emit (cadr change) (cadr stored)) (emit (cadr stored) (cadr change)))) pairs)))
        (zset-entries (dc-get arrangement (key (cadr change)) (zset-empty)))))
      (zset-entries delta))
    (zset-from-weighted pairs)))
(define (dc-state states id)
  (radix-ref states id (vector (radix-empty) (radix-empty) (radix-empty))))
(define (dc-schedule id queue)
  (cond ((null? queue) (list id)) ((= id (car queue)) queue)
        ((< id (car queue)) (cons id queue))
        (else (cons (car queue) (dc-schedule id (cdr queue))))))
(define (dc-lookup aliases name)
  (let ((id (dc-get aliases name #f)))
    (if (eq? id #f) (error "Unknown circuit input or forward node reference" name) id)))
(define (dc-check runtime)
  (if (not (and (vector? runtime) (= (vector-length runtime) 6)
                (eq? (vector-ref runtime 0) 'dbsp-circuit-v1)))
      (error "Expected a DBSP circuit snapshot")))

;; Nodes are named topological declarations:
;; (map|filter|project out in procedure), (union out left right),
;; (join out left right left-key right-key emit), (distinct out in).
;; Names are unique symbols; referencing only earlier names excludes cycles.
(define (make-dbsp-circuit inputs declarations output)
  (if (not (and (list? inputs) (list? declarations) (symbol? output)))
      (error "Circuit expects input names, declarations and output name"))
  (if (> (+ (length inputs) (length declarations)) 65536)
      (error "Circuit exceeds the 65536-node construction budget"))
  (let ((aliases (radix-empty)) (input-names (radix-empty)) (nodes '()) (count 0))
    (define (add name operation children parameters)
      (if (not (symbol? name)) (error "Circuit node name must be a symbol"))
      (if (not (eq? (dc-get aliases name #f) #f)) (error "Duplicate circuit node name" name))
      (set! aliases (dc-put aliases name count #f))
      (set! nodes (cons (vector operation children parameters '()) nodes))
      (set! count (+ count 1)))
    (for-each (lambda (name)
      (add name 'input '() '())
      (set! input-names (dc-put input-names name (- count 1) #f))) inputs)
    (for-each (lambda (spec)
      (if (not (and (list? spec) (>= (length spec) 3))) (error "Malformed circuit declaration"))
      (let ((op (car spec)) (name (cadr spec)) (size (length spec)))
        (cond
          ((or (eq? op 'map) (eq? op 'project) (eq? op 'filter))
           (if (not (and (= size 4) (procedure? (list-ref spec 3)))) (error "Expected unary circuit procedure"))
           (add name op (list (dc-lookup aliases (list-ref spec 2))) (list (list-ref spec 3))))
          ((eq? op 'distinct)
           (if (not (= size 3)) (error "Expected distinct output input"))
           (add name op (list (dc-lookup aliases (list-ref spec 2))) '()))
          ((or (eq? op 'union) (eq? op 'join))
           (if (not (= size (if (eq? op 'join) 7 4))) (error "Malformed binary circuit declaration"))
           (let ((parameters (if (eq? op 'join) (list-tail spec 4) '())))
             (for-each (lambda (f) (if (not (procedure? f)) (error "Expected join procedure"))) parameters)
             (add name op (list (dc-lookup aliases (list-ref spec 2)) (dc-lookup aliases (list-ref spec 3)))
                         (map (lambda (f) f) parameters))))
          (else (error "Unsupported standing circuit operator" op))))) declarations)
    (let ((graph (list->vector (reverse nodes))) (root (dc-lookup aliases output)))
      (let consumers ((id 0))
        (if (< id count)
            (begin
              (for-each (lambda (child)
                (let ((node (vector-ref graph child)))
                  (vector-set! node 3 (cons id (vector-ref node 3)))))
                (vector-ref (vector-ref graph id) 1))
              (consumers (+ id 1)))))
      (vector 'dbsp-circuit-v1 graph input-names root (radix-empty) (vector 0 0 0 0)))))

(define (dc-run-node node old deltas work)
  (let* ((op (vector-ref node 0)) (children (vector-ref node 1)) (params (vector-ref node 2))
         (left (radix-ref deltas (car children) (zset-empty))))
    (cond
      ((or (eq? op 'map) (eq? op 'project)) (vector (zset-map (car params) left) (vector-ref old 1) (vector-ref old 2)))
      ((eq? op 'filter) (vector (zset-filter (car params) left) (vector-ref old 1) (vector-ref old 2)))
      ((eq? op 'union) (vector (zset-add left (radix-ref deltas (cadr children) (zset-empty))) #f #f))
      ((eq? op 'distinct)
       (let ((counts (vector-ref old 1)) (pairs '()))
         (for-each (lambda (entry)
           (let* ((row (cadr entry)) (before (dc-get counts row 0)) (after (+ before (car entry)))
                  (change (- (if (> after 0) 1 0) (if (> before 0) 1 0))))
             (if (not (= change 0)) (set! pairs (cons (list change row) pairs))))) (zset-entries left))
         (vector (zset-from-weighted pairs) (dc-trace-apply counts left work) #f)))
      ((eq? op 'join)
       (let* ((right (radix-ref deltas (cadr children) (zset-empty)))
              (lk (car params)) (rk (cadr params)) (emit (caddr params))
              (la (vector-ref old 1)) (ra (vector-ref old 2))
              (cross (dc-arrange (radix-empty) right rk work))
              (change (zset-add (zset-add (dc-probe left ra lk emit #t work)
                                        (dc-probe right la rk emit #f work))
                               (if (or (zset-empty? left) (zset-empty? right))
                                   (zset-empty) (dc-probe left cross lk emit #t work)))))
         (vector change (dc-arrange la left lk work) (dc-arrange ra right rk work))))
      (else (error "Invalid compiled circuit node" op)))))

;; All input batches are consolidated and installed before any operator runs.
;; Old snapshots are never mutated. A failed callback publishes no successor.
;; Returns (new-snapshot . output-delta); observing full output is explicit.
(define (dbsp-circuit-step runtime changes)
  (dc-check runtime)
  (if (not (list? changes)) (error "Circuit changes must be a list"))
  (let ((staged (radix-empty)) (states (vector-ref runtime 4))
        (graph (vector-ref runtime 1)) (work (vector 0 0 0 0))
        (deltas (radix-empty)) (queue '()))
    (for-each (lambda (entry)
      (if (not (and (list? entry) (= (length entry) 2) (zset? (cadr entry))))
          (error "Expected (input-name Z-set) circuit change"))
      (let ((id (dc-lookup (vector-ref runtime 2) (car entry))))
        (set! staged (radix-set staged id (zset-add (radix-ref staged id (zset-empty)) (cadr entry)))))) changes)
    (radix-fold staged (lambda (id delta unused)
      (if (not (zset-empty? delta))
          (let* ((old (dc-state states id)) (next (dc-trace-apply (vector-ref old 0) delta work)))
            (set! states (radix-set states id (vector next #f #f)))
            (set! deltas (radix-set deltas id delta))
            (vector-set! work 0 (+ (vector-ref work 0) 1))
            (for-each (lambda (consumer) (set! queue (dc-schedule consumer queue)))
                      (vector-ref (vector-ref graph id) 3)))) #f) #f)
    (let process ((remaining queue))
      (if (not (null? remaining))
          (let* ((id (car remaining)) (node (vector-ref graph id)) (old (dc-state states id))
                 (result (dc-run-node node old deltas work)) (delta (vector-ref result 0)))
            (vector-set! work 0 (+ (vector-ref work 0) 1))
            (set! states (radix-set states id
              (vector (dc-trace-apply (vector-ref old 0) delta work) (vector-ref result 1) (vector-ref result 2))))
            (set! deltas (radix-set deltas id delta))
            (let ((next (cdr remaining)))
              (if (not (zset-empty? delta))
                  (for-each (lambda (consumer) (set! next (dc-schedule consumer next))) (vector-ref node 3)))
              (process next)))))
    (cons (vector 'dbsp-circuit-v1 graph (vector-ref runtime 2) (vector-ref runtime 3) states work)
          (radix-ref deltas (vector-ref runtime 3) (zset-empty)))))
(define (dbsp-circuit-output runtime)
  (dc-check runtime) (dc-observe (vector-ref (dc-state (vector-ref runtime 4) (vector-ref runtime 3)) 0)))
(define (dbsp-circuit-input runtime name)
  (dc-check runtime)
  (dc-observe (vector-ref (dc-state (vector-ref runtime 4) (dc-lookup (vector-ref runtime 2) name)) 0)))
(define (dbsp-circuit-work runtime)
  (dc-check runtime) (vector-copy (vector-ref runtime 5)))

;; Pointer-free logical operator state for checkpoint verification. This is
;; a full observation, including hidden distinct counts and join arrangements.
;; The caller owns admitted row data; serialization must freeze those values.
(define (dbsp-circuit-checkpoint-state runtime)
  (dc-check runtime)
  (let* ((graph (vector-ref runtime 1)) (states (vector-ref runtime 4))
         (n (vector-length graph)) (out (make-vector n #f)))
    (define (arrangement root)
      (sort (dc-fold root (lambda (key rows acc) (cons (list key (zset-entries rows)) acc)) '())
            (lambda (a b) (string<? (zset-row-key (car a)) (zset-row-key (car b))))))
    (let loop ((i 0)) (if (< i n)
      (let* ((node (vector-ref graph i)) (op (vector-ref node 0)) (state (dc-state states i)))
        (vector-set! out i (vector op (zset-entries (dc-observe (vector-ref state 0)))
          (cond ((eq? op 'distinct) (zset-entries (dc-observe (vector-ref state 1))))
                ((eq? op 'join) (arrangement (vector-ref state 1))) (else #f))
          (if (eq? op 'join) (arrangement (vector-ref state 2)) #f)))
        (loop (+ i 1))))) out))
