;;; Fixed-shape named-axis expressions over persistent tensor snapshots.
(require core.dbsp.tensor_snapshot)
(provide make-tensor-circuit tensor-circuit-step tensor-circuit-output
         tensor-circuit-ref tensor-circuit-work tensor-circuit-visit)

;; Nodes: op, children, parameters, logical axes, logical shape, consumers.
;; State: immutable graph/baseline plus path-copied node overrides. Rows are
;; consumed only by projection; their full relation is not retained.
(define (tc-physical shape) (if (null? shape) '(1) shape))
(define (tc-coordinate xs) (if (null? xs) '(0) xs))
(define (tc-distinct? xs)
  (or (null? xs) (and (not (memq (car xs) (cdr xs))) (tc-distinct? (cdr xs)))))
(define (tc-position name axes)
  (let loop ((rest axes) (i 0))
    (cond ((null? rest) (error "Unknown tensor axis" name))
          ((eq? name (car rest)) i) (else (loop (cdr rest) (+ i 1))))))
(define (tc-axes axes shape)
  (if (not (and (list? axes) (list? shape) (= (length axes) (length shape)) (<= (length axes) 8)))
      (error "Expected at most eight named tensor axes"))
  (let loop ((rest axes) (sizes shape) (seen '()) (cells 1))
    (if (null? rest)
        (if (> cells 1048576) (error "Tensor expression exceeds its cell budget"))
        (begin
          (if (not (and (symbol? (car rest)) (not (memq (car rest) seen))
                        (integer? (car sizes)) (exact? (car sizes)) (> (car sizes) 0)))
              (error "Tensor axes must be unique symbols with positive exact sizes"))
          (loop (cdr rest) (cdr sizes) (cons (car rest) seen) (* cells (car sizes)))))))
(define (tc-coordinates shape procedure)
  (let visit ((rest shape) (prefix '()))
    (if (null? rest) (procedure (reverse prefix))
        (let loop ((i 0)) (if (< i (car rest))
          (begin (visit (cdr rest) (cons i prefix)) (loop (+ i 1))))))))
(define (tc-ref snapshot coords) (tensor-snapshot-ref snapshot (tc-coordinate coords)))
(define (tc-empty node) (tensor-delta (tc-physical (vector-ref node 4)) '()))
(define (tc-entries delta axes)
  (map (lambda (entry) (list (if (null? axes) '() (car entry)) (cadr entry)))
       (tensor-delta-entries delta)))
(define (tc-delta node entries)
  (tensor-delta (tc-physical (vector-ref node 4))
    (map (lambda (e) (list (tc-coordinate (car e)) (cadr e))) entries)))
(define (tc-full-delta node value)
  (let ((entries '()))
    (tc-coordinates (vector-ref node 4) (lambda (coords)
      (set! entries (cons (list coords (tc-ref value coords)) entries))))
    (tc-delta node entries)))
(define (tc-select coords axes selected)
  (map (lambda (axis) (list-ref coords (tc-position axis axes))) selected))
(define (tc-contraction-shape left right contracted)
  (let* ((la (vector-ref left 3)) (ra (vector-ref right 3))
         (ls (vector-ref left 4)) (rs (vector-ref right 4))
         (common (filter (lambda (a) (memq a ra)) la)))
    (if (not (and (list? contracted) (tc-distinct? contracted)))
        (error "Contracted axes must be distinct"))
    (for-each (lambda (a)
      (if (not (memq a common)) (error "Contraction axis must occur in both operands" a))) contracted)
    (for-each (lambda (a)
      (if (not (= (list-ref ls (tc-position a la)) (list-ref rs (tc-position a ra))))
          (error "Shared tensor axis sizes differ" a))) common)
    (if (> (fold-left * 1 (append ls (map (lambda (a) (list-ref rs (tc-position a ra)))
                       (filter (lambda (a) (not (memq a la))) ra)))) 16777216)
        (error "Initial contraction exceeds its iteration budget"))
    (let* ((axes (append (filter (lambda (a) (not (memq a contracted))) la)
                        (filter (lambda (a) (not (memq a la))) ra)))
           (shape (map (lambda (a) (if (memq a la) (list-ref ls (tc-position a la))
                                       (list-ref rs (tc-position a ra)))) axes)))
      (tc-axes axes shape) (cons axes shape))))
(define (tc-initialize-contract node left right a b)
  (let* ((la (vector-ref left 3)) (ra (vector-ref right 3))
         (axes (append la (filter (lambda (x) (not (memq x la))) ra)))
         (shape (map (lambda (x) (if (memq x la)
           (list-ref (vector-ref left 4) (tc-position x la))
           (list-ref (vector-ref right 4) (tc-position x ra)))) axes)) (entries '()))
    (tc-coordinates shape (lambda (coords)
      (set! entries (cons (list (tc-select coords axes (vector-ref node 3))
        (* (tc-ref a (tc-select coords axes la)) (tc-ref b (tc-select coords axes ra)))) entries))))
    (tc-delta node entries)))

;; Enumerate only the coordinates not fixed by one changed operand. Shared
;; free axes are batch axes. The sparse cross term matches all shared axes.
(define (tc-matrix-case? node left right)
  (let ((la (vector-ref left 3)) (ra (vector-ref right 3)) (oa (vector-ref node 3)))
    (and (= (length la) 2) (= (length ra) 2) (= (length oa) 2)
         (eq? (cadr la) (car ra)) (not (memq (car la) ra)) (not (memq (cadr ra) la))
         (equal? oa (list (car la) (cadr ra))))))
(define (tc-matrix-change left right a b da db work)
  ;; Ordinary matrix multiplication remains on core.dbsp.tensor's one kernel.
  ;; Every old-cell read accounts for one linear-term product. Matching sparse
  ;; inner coordinates account for the kernel's remaining cross products.
  (let* ((ls (vector-ref left 4)) (rs (vector-ref right 4))
         (reader-a (tensor-reader ls (lambda (i)
           (vector-set! work 1 (+ (vector-ref work 1) 1))
           (tensor-snapshot-ref a (list (quotient i (cadr ls)) (modulo i (cadr ls)))))))
         (reader-b (tensor-reader rs (lambda (i)
           (vector-set! work 1 (+ (vector-ref work 1) 1))
           (tensor-snapshot-ref b (list (quotient i (cadr rs)) (modulo i (cadr rs))))))))
    (for-each (lambda (x) (for-each (lambda (y)
      (if (= (cadar x) (caar y)) (vector-set! work 1 (+ (vector-ref work 1) 1)))) (tensor-delta-entries db))) (tensor-delta-entries da))
    (tensor-matmul-delta reader-a reader-b da db)))
(define (tc-contract-change node left right a b da db work)
  (if (tc-matrix-case? node left right)
      (tc-matrix-change left right a b da db work)
      (tc-contract-general node left right a b da db work)))
(define (tc-contract-general node left right a b da db work)
  (let* ((la (vector-ref left 3)) (ra (vector-ref right 3))
         (ls (vector-ref left 4)) (rs (vector-ref right 4)) (oa (vector-ref node 3))
         (common (filter (lambda (axis) (memq axis ra)) la)) (entries '()))
    (define (emit lc rc x y)
      (vector-set! work 1 (+ (vector-ref work 1) 1))
      (let ((amount (* x y)))
        (if (not (= amount 0))
            (set! entries (cons (list (map (lambda (axis)
              (if (memq axis la) (list-ref lc (tc-position axis la))
                  (list-ref rc (tc-position axis ra)))) oa) amount) entries)))))
    (define (one-sided changes ca other other-axes other-shape left?)
      (let* ((free (filter (lambda (axis) (not (memq axis ca))) other-axes))
             (free-shape (map (lambda (axis) (list-ref other-shape (tc-position axis other-axes))) free)))
        (for-each (lambda (entry)
          (tc-coordinates free-shape (lambda (fc)
            (let ((oc (map (lambda (axis) (if (memq axis ca)
              (list-ref (car entry) (tc-position axis ca))
              (list-ref fc (tc-position axis free)))) other-axes)))
              (if left? (emit (car entry) oc (cadr entry) (tc-ref other oc))
                  (emit oc (car entry) (tc-ref other oc) (cadr entry))))))) changes)))
    (one-sided (tc-entries da la) la b ra rs #t)
    (one-sided (tc-entries db ra) ra a la ls #f)
    (for-each (lambda (x) (for-each (lambda (y)
      (if (equal? (tc-select (car x) la common) (tc-select (car y) ra common))
          (emit (car x) (car y) (cadr x) (cadr y)))) (tc-entries db ra))) (tc-entries da la))
    (tc-delta node entries)))
(define (tc-run node graph old get delta work)
  (let* ((op (vector-ref node 0)) (children (vector-ref node 1))
         (left (vector-ref graph (car children))) (ld (delta (car children)))
         (la (vector-ref left 3)) (params (vector-ref node 2)))
    (cond
      ((eq? op 'project)
       (zset-project-tensor ld (vector-ref node 4)
         (lambda (row) (map (lambda (i) (list-ref row i)) (car params)))
         (lambda (row) (list-ref row (cadr params)))))
      ((eq? op 'contract)
       (let ((r (cadr children)))
         (tc-contract-change node left (vector-ref graph r) (get (car children)) (get r) ld (delta r) work)))
      ((or (eq? op '+) (eq? op '-))
       (let ((sign (if (eq? op '+) 1 -1)))
         (tc-delta node (append (tc-entries ld la)
           (map (lambda (e) (list (car e) (* sign (cadr e))))
                (tc-entries (delta (cadr children)) la))))))
      ((or (eq? op 'sum) (eq? op 'transpose))
       (tc-delta node (map (lambda (e) (list (tc-select (car e) la (vector-ref node 3)) (cadr e)))
                          (tc-entries ld la))))
      (else (error "Invalid tensor expression operator" op)))))
(define (tc-schedule id queue)
  (cond ((null? queue) (list id)) ((= id (car queue)) queue)
        ((< id (car queue)) (cons id queue)) (else (cons (car queue) (tc-schedule id (cdr queue))))))
(define (tc-check state)
  (if (not (and (vector? state) (= (vector-length state) 7) (eq? (vector-ref state 0) 'tensor-circuit-v1)))
      (error "Expected a tensor circuit snapshot")))
(define (tc-state state id)
  (radix-ref (vector-ref state 5) id (vector-ref (vector-ref state 4) id)))
(define (make-tensor-circuit inputs expression)
  (if (not (and (list? inputs) (<= (length inputs) 64))) (error "Expected at most 64 tensor/row input bindings"))
  (let ((nodes '()) (values '()) (aliases '()) (interned '()) (count 0))
    (define (add op children params axes shape value)
      (if (>= count 4096) (error "Tensor circuit exceeds its node budget"))
      (let ((id count))
        (set! nodes (cons (vector op children params (map (lambda (x) x) axes) (map (lambda (x) x) shape) '()) nodes))
        (set! values (cons value values)) (set! count (+ count 1)) id))
    (define (node id) (list-ref nodes (- count id 1)))
    (define (compile term depth)
      (if (> depth 64) (error "Tensor expression nesting exceeds 64"))
      (if (symbol? term)
          (let ((pair (assq term aliases))) (if pair (cdr pair) (error "Unknown tensor input" term)))
          (let ((known (assoc term interned)))
            (if known (cdr known)
                (begin
                  (if (not (and (list? term) (>= (length term) 2))) (error "Malformed tensor expression"))
                  (let* ((op (car term)) (arity (length term))
                         (l (compile (cadr term) (+ depth 1))) (left (node l))
                         (la (vector-ref left 3)) (ls (vector-ref left 4))
                         (children (list l)) (params '()) (axes la) (shape ls))
                    (cond
                      ((eq? op 'project)
                       (if (not (and (= arity 6) (eq? (vector-ref left 0) 'rows))) (error "Projection expects a row input, axes, shape, coordinate columns and value column"))
                       (set! axes (list-ref term 2)) (set! shape (list-ref term 3)) (tc-axes axes shape)
                       (let ((columns (list-ref term 4)) (value (list-ref term 5)))
                         (if (not (and (list? columns) (= (length columns) (length axes)) (not (null? axes)))) (error "Projection coordinate columns mismatch"))
                         (for-each (lambda (i) (if (not (and (integer? i) (exact? i) (>= i 0) (< i 1024))) (error "Invalid row column"))) (cons value columns))
                         (set! params (list (map (lambda (x) x) columns) value))))
                      ((or (eq? op 'contract) (eq? op '+) (eq? op '-))
                       (if (not (= arity (if (eq? op 'contract) 4 3))) (error "Binary tensor expression arity mismatch"))
                       (let* ((r (compile (caddr term) (+ depth 1))) (right (node r)))
                         (set! children (list l r))
                         (if (or (eq? (vector-ref left 0) 'rows) (eq? (vector-ref right 0) 'rows)) (error "Rows require an explicit projection"))
                         (if (eq? op 'contract)
                             (let ((result (tc-contraction-shape left right (list-ref term 3))))
                               (set! axes (car result)) (set! shape (cdr result)))
                             (if (not (and (equal? la (vector-ref right 3)) (equal? ls (vector-ref right 4)))) (error "Tensor addition requires identical axes and shape")))))
                      ((or (eq? op 'transpose) (eq? op 'sum))
                       (if (or (eq? (vector-ref left 0) 'rows) (not (= arity 3))) (error "Expected tensor and explicit axis list"))
                       (let ((selected (caddr term)))
                         (if (not (and (list? selected) (tc-distinct? selected))) (error "Expected distinct axes"))
                         (for-each (lambda (a) (tc-position a la)) selected)
                         (if (and (eq? op 'transpose) (not (= (length selected) (length la)))) (error "Transpose must name every axis"))
                         (set! axes (if (eq? op 'transpose) selected (filter (lambda (a) (not (memq a selected))) la)))
                       (set! shape (map (lambda (a) (list-ref ls (tc-position a la))) axes))))
                      (else (error "Unsupported tensor expression operator" op)))
                    (let* ((id (add op children params axes shape #f)) (key term))
                      (set! interned (cons (cons key id) interned)) id)))))))
    (for-each (lambda (binding)
      (if (not (and (list? binding) (= (length binding) 3) (symbol? (car binding)) (not (assq (car binding) aliases))))
          (error "Expected unique (name axes tensor) or (name rows Z-set) binding"))
      (let* ((axes (cadr binding)) (value (caddr binding)) (rows? (eq? axes 'rows))
             (shape (if rows? '() (tensor-shape value))))
        (if rows? (if (not (zset? value)) (error "Expected a row Z-set")) (tc-axes axes shape))
        (let ((id (add (if rows? 'rows 'input) '() '() (if rows? '() axes) shape
                        (if rows? value (tensor-snapshot value)))))
          (set! aliases (cons (cons (car binding) id) aliases))))) inputs)
    (let* ((root (compile expression 0)) (graph (list->vector (reverse nodes)))
           (base (list->vector (reverse values))) (work (vector 0 0 0)))
      (if (eq? (vector-ref (vector-ref graph root) 0) 'rows) (error "Circuit output must be a tensor"))
      (let init ((id 0)) (if (< id count)
        (let* ((n (vector-ref graph id)) (op (vector-ref n 0)))
          (for-each (lambda (child) (let ((c (vector-ref graph child)))
            (vector-set! c 5 (cons id (vector-ref c 5))))) (vector-ref n 1))
          (if (not (or (eq? op 'input) (eq? op 'rows)))
              (let* ((zero (tensor-snapshot (make-tensor (tc-physical (vector-ref n 4)) 0.0)))
                     (children (vector-ref n 1))
                     (change (if (eq? op 'contract)
                       (tc-initialize-contract n (vector-ref graph (car children)) (vector-ref graph (cadr children))
                         (vector-ref base (car children)) (vector-ref base (cadr children)))
                       (tc-run n graph zero (lambda (i) (vector-ref base i))
                         (lambda (i) (let ((cn (vector-ref graph i)))
                           (if (eq? (vector-ref cn 0) 'rows) (vector-ref base i)
                               (tc-full-delta cn (vector-ref base i))))) work))))
                (vector-set! base id (tensor-snapshot-apply zero change))))
          (init (+ id 1)))))
      ;; No input relation survives compilation, including in the graph.
      (for-each (lambda (pair) (if (eq? (vector-ref (vector-ref graph (cdr pair)) 0) 'rows)
        (vector-set! base (cdr pair) #f))) aliases)
      (vector 'tensor-circuit-v1 graph aliases root base (radix-empty) (vector 0 0 0)))))
(define (tensor-circuit-step state changes)
  (tc-check state)
  (if (not (list? changes)) (error "Expected named circuit changes"))
  (let* ((graph (vector-ref state 1)) (staged (radix-empty)) (deltas (radix-empty))
         (overrides (vector-ref state 5)) (queue '()) (work (vector 0 0 0)))
    (for-each (lambda (binding)
      (if (not (and (list? binding) (= (length binding) 2))) (error "Expected (name delta)"))
      (let ((pair (assq (car binding) (vector-ref state 2))))
        (if (not pair) (error "Unknown circuit input" (car binding)))
        (let* ((id (cdr pair)) (n (vector-ref graph id)) (rows? (eq? (vector-ref n 0) 'rows)) (d (cadr binding)))
          (if rows? (if (not (zset? d)) (error "Expected row delta"))
              (if (not (and (tensor-delta? d) (equal? (tensor-delta-shape d) (tc-physical (vector-ref n 4)))))
                  (error "Tensor input delta shape mismatch")))
          (set! staged (radix-set staged id (if rows? (zset-add (radix-ref staged id (zset-empty)) d)
            (tc-delta n (append (tc-entries (radix-ref staged id (tc-empty n)) (vector-ref n 3)) (tc-entries d (vector-ref n 3)))))))))) changes)
    (define (install id delta)
      (let* ((n (vector-ref graph id)) (rows? (eq? (vector-ref n 0) 'rows))
             (nonzero (if rows? (not (zset-empty? delta)) (not (null? (tensor-delta-entries delta))))))
        (if nonzero
            (begin
              (if (not rows?) (let* ((next (tensor-snapshot-apply (tc-state state id) delta)) (copies (tensor-snapshot-work next)))
                (set! overrides (radix-set overrides id next))
                (vector-set! work 2 (+ (vector-ref work 2) (vector-ref copies 1)))))
              (set! deltas (radix-set deltas id delta))
              (for-each (lambda (consumer) (set! queue (tc-schedule consumer queue))) (vector-ref n 5))))))
    (radix-fold staged (lambda (id delta unused) (install id delta) #f) #f)
    (let execute () (if (not (null? queue))
      (let* ((id (car queue)) (n (vector-ref graph id)))
        (set! queue (cdr queue)) (vector-set! work 0 (+ (vector-ref work 0) 1))
        (install id (tc-run n graph (tc-state state id) (lambda (i) (tc-state state i))
          (lambda (i) (radix-ref deltas i (tc-empty (vector-ref graph i)))) work))
        (execute))))
    (vector (vector 'tensor-circuit-v1 graph (vector-ref state 2) (vector-ref state 3)
                    (vector-ref state 4) overrides work)
            (radix-ref deltas (vector-ref state 3) (tc-empty (vector-ref graph (vector-ref state 3)))) (vector-copy work))))
(define (tensor-circuit-output state)
  (tc-check state) (tensor-snapshot->tensor (tc-state state (vector-ref state 3))))
(define (tensor-circuit-ref state coordinates)
  (tc-check state) (tc-ref (tc-state state (vector-ref state 3)) coordinates))
(define (tensor-circuit-work state) (tc-check state) (vector-copy (vector-ref state 6)))

;; Read-only structural visitor for consumers such as reverse-mode recording.
;; Descriptors own their lists; value access is scalar-only through a closure.
;; No graph node, mutable tensor or internal snapshot is exposed to the visitor.
(define (tensor-circuit-visit state visitor)
  (tc-check state)
  (if (not (procedure? visitor)) (error "Expected tensor circuit visitor"))
  (let* ((graph (vector-ref state 1)) (n (vector-length graph)))
    (let visit ((id 0)) (if (< id n)
      (let* ((node (vector-ref graph id)) (value (tc-state state id))
             (op (vector-ref node 0))
             (names (map car (filter (lambda (pair) (= (cdr pair) id)) (vector-ref state 2))))
             (params (if (eq? op 'project) (list (map (lambda (x) x) (car (vector-ref node 2))) (cadr (vector-ref node 2))) '())))
        (visitor id op (map (lambda (x) x) (vector-ref node 1)) params
          (map (lambda (x) x) (vector-ref node 3)) (map (lambda (x) x) (vector-ref node 4)) names
          (lambda (coordinates) (if (eq? op 'rows) (error "Rows have no tensor scalar accessor") (tc-ref value coordinates))))
        (visit (+ id 1)))))
    (vector n (vector-ref state 3))))
