;;; Immutable shared-block views over native floating-point tensors.
(require core.dbsp.tensor)
(require core.data.radix)
(provide tensor-snapshot tensor-snapshot-shape tensor-snapshot-ref
         tensor-snapshot-apply tensor-snapshot->tensor tensor-snapshot->reader tensor-snapshot-work)

;; Opaque record: tag, owned shape, shared baseline blocks, overrides, work.
;; Native one-dimensional blocks hold at most 256 cells. Public reads never
;; expose blocks or the radix root; materialization is an explicit dense copy.
(define (ts-check s)
  (if (not (and (vector? s) (= (vector-length s) 5)
                (eq? (vector-ref s 0) 'tensor-snapshot-v1)))
      (error "Expected a tensor snapshot")))
(define (ts-size shape) (fold-left * 1 shape))
(define (ts-index coordinates shape)
  (if (not (and (list? coordinates) (= (length coordinates) (length shape))))
      (error "Tensor snapshot coordinate rank mismatch"))
  (let loop ((cs coordinates) (ds shape) (index 0))
    (if (null? ds) index
        (let ((c (car cs)) (d (car ds)))
          (if (not (and (integer? c) (exact? c) (>= c 0) (< c d)))
              (error "Tensor snapshot coordinate outside shape"))
          (loop (cdr cs) (cdr ds) (+ (* index d) c))))))
(define (ts-block s i)
  (radix-ref (vector-ref s 3) i (vector-ref (vector-ref s 2) i)))
(define (tensor-snapshot value)
  (let* ((shape (tensor-shape value)) (size (ts-size shape))
         (count (quotient (+ size 255) 256)) (base (make-vector count #f)))
    (let blocks ((i 0))
      (if (< i count)
          (let* ((start (* i 256)) (n (min 256 (- size start))) (block (make-tensor (list n) 0.0)))
            (let cells ((j 0))
              (if (< j n) (begin (tensor-set! block j (tensor-ref value (+ start j))) (cells (+ j 1)))))
            (vector-set! base i block)
            (blocks (+ i 1)))))
    (vector 'tensor-snapshot-v1 (map (lambda (x) x) shape) base (radix-empty) (vector 0 0 0 0))))
(define (tensor-snapshot-shape s)
  (ts-check s) (map (lambda (x) x) (vector-ref s 1)))
(define (tensor-snapshot-ref s coordinates)
  (ts-check s)
  (let ((i (ts-index coordinates (vector-ref s 1))))
    (tensor-ref (ts-block s (quotient i 256)) (modulo i 256))))
(define (tensor-snapshot-work s)
  (ts-check s) (vector-copy (vector-ref s 4)))
(define (tensor-snapshot->reader s)
  (ts-check s)
  (tensor-reader (vector-ref s 1)
    (lambda (i) (tensor-ref (ts-block s (quotient i 256)) (modulo i 256)))))

;; Entries are sorted flat indices. Copy a touched block exactly once and
;; return its remaining entries; all mutations are private to this attempt.
(define (ts-change-block old entries number n)
  (let ((block (make-tensor (list n) 0.0)))
    (let copy ((i 0))
      (if (< i n) (begin (tensor-set! block i (tensor-ref old i)) (copy (+ i 1)))))
    (let change ((rest entries))
      (if (or (null? rest) (not (= (quotient (caar rest) 256) number)))
          (cons block rest)
          (let ((i (modulo (caar rest) 256)))
            (tensor-set! block i (+ (tensor-ref block i) (cadar rest)))
            (change (cdr rest)))))))
(define (tensor-snapshot-apply s delta)
  (ts-check s)
  (if (not (tensor-delta? delta)) (error "Expected a tensor delta"))
  (let ((shape (vector-ref s 1)))
    (if (not (equal? shape (tensor-delta-shape delta)))
        (error "Tensor snapshot delta shape mismatch"))
    (let ((entries (map (lambda (e) (list (ts-index (car e) shape) (cadr e)))
                        (tensor-delta-entries delta))) (size (ts-size shape)))
      (let integrate ((rest entries) (root (vector-ref s 3)) (blocks 0) (cells 0))
        (if (null? rest)
            (vector 'tensor-snapshot-v1 shape (vector-ref s 2) root
                    (vector blocks cells (* blocks 16) (* blocks 256)))
            (let* ((number (quotient (caar rest) 256)) (n (min 256 (- size (* number 256))))
                   (old (radix-ref root number (vector-ref (vector-ref s 2) number)))
                   (changed (ts-change-block old rest number n)))
              (integrate (cdr changed) (radix-set root number (car changed))
                         (+ blocks 1) (+ cells n))))))))
(define (tensor-snapshot->tensor s)
  (ts-check s)
  (let* ((shape (vector-ref s 1)) (size (ts-size shape)) (out (make-tensor shape 0.0))
         (count (vector-length (vector-ref s 2))))
    (let blocks ((i 0))
      (if (< i count)
          (let* ((block (ts-block s i)) (start (* i 256)) (n (min 256 (- size start))))
            (let cells ((j 0))
              (if (< j n) (begin (tensor-set! out (+ start j) (tensor-ref block j)) (cells (+ j 1)))))
            (blocks (+ i 1))))) out))
