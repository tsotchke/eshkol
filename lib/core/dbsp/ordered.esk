;;; Persistent weighted order statistics over nonnegative integrated Z-sets.
(require core.dbsp)
(provide make-dbsp-ordered dbsp-ordered-step dbsp-ordered-select dbsp-ordered-quantile
         dbsp-ordered-rank dbsp-ordered-top dbsp-ordered-info dbsp-ordered-work)

(define (dor-integer value)
  (if (not (and (integer? value) (exact? value))) (error "Ordered multiplicities must remain exact integers")) value)
(define (dor-limit k)
  (if (not (and (integer? k) (exact? k) (>= k 0) (<= k 65536)))
      (error "Top-k size must be an exact integer from zero through 65536")) k)
;; Nodes: #(key row positive-weight left right height subtree-mass distinct).
;; Keys are (exact rational score, canonical row encoding), giving stable ties.
(define (dor-height node) (if node (vector-ref node 5) 0))
(define (dor-mass node) (if node (vector-ref node 6) 0))
(define (dor-size node) (if node (vector-ref node 7) 0))
(define (dor-node key row weight left right work)
  (vector-set! work 2 (+ (vector-ref work 2) 1))
  (vector key row weight left right (+ 1 (max (dor-height left) (dor-height right)))
    (dor-integer (+ weight (dor-mass left) (dor-mass right)))
    (+ 1 (dor-size left) (dor-size right))))
(define (dor-left node work)
  (vector-set! work 3 (+ (vector-ref work 3) 1))
  (let* ((right (vector-ref node 4))
         (lower (dor-node (vector-ref node 0) (vector-ref node 1) (vector-ref node 2)
           (vector-ref node 3) (vector-ref right 3) work)))
    (dor-node (vector-ref right 0) (vector-ref right 1) (vector-ref right 2) lower (vector-ref right 4) work)))
(define (dor-right node work)
  (vector-set! work 3 (+ (vector-ref work 3) 1))
  (let* ((left (vector-ref node 3))
         (lower (dor-node (vector-ref node 0) (vector-ref node 1) (vector-ref node 2)
           (vector-ref left 4) (vector-ref node 4) work)))
    (dor-node (vector-ref left 0) (vector-ref left 1) (vector-ref left 2) (vector-ref left 3) lower work)))
(define (dor-balance key row weight left right work)
  (let ((node (dor-node key row weight left right work))
        (difference (- (dor-height left) (dor-height right))))
    (cond
      ((> difference 1)
       (if (< (dor-height (vector-ref left 3)) (dor-height (vector-ref left 4)))
           (dor-right (dor-node key row weight (dor-left left work) right work) work)
           (dor-right node work)))
      ((< difference -1)
       (if (< (dor-height (vector-ref right 4)) (dor-height (vector-ref right 3)))
           (dor-left (dor-node key row weight left (dor-right right work) work) work)
           (dor-left node work)))
      (else node))))
(define (dor-key scorer row)
  (let ((score (scorer row)))
    (if (not (and (rational? score) (exact? score))) (error "Ordered scores must be exact rationals"))
    (vector score (zset-row-key row))))
(define (dor-compare a b)
  (cond ((< (vector-ref a 0) (vector-ref b 0)) -1)
        ((> (vector-ref a 0) (vector-ref b 0)) 1)
        ((string<? (vector-ref a 1) (vector-ref b 1)) -1)
        ((string<? (vector-ref b 1) (vector-ref a 1)) 1)
        (else 0)))
(define (dor-minimum node work)
  (vector-set! work 1 (+ (vector-ref work 1) 1))
  (if (vector-ref node 3) (dor-minimum (vector-ref node 3) work) node))
(define (dor-delete-min node work)
  (vector-set! work 1 (+ (vector-ref work 1) 1))
  (if (not (vector-ref node 3)) (vector-ref node 4)
      (dor-balance (vector-ref node 0) (vector-ref node 1) (vector-ref node 2)
        (dor-delete-min (vector-ref node 3) work) (vector-ref node 4) work)))
(define (dor-update node key row delta work)
  (if (not node)
      (if (< delta 0) (error "Ordered view cannot retract an absent row")
          (dor-node key row delta #f #f work))
      (let* ((compared (dor-compare key (vector-ref node 0)))
             (left (vector-ref node 3)) (right (vector-ref node 4)))
        (vector-set! work 1 (+ (vector-ref work 1) 1))
        (cond
          ((< compared 0) (dor-balance (vector-ref node 0) (vector-ref node 1) (vector-ref node 2)
            (dor-update left key row delta work) right work))
          ((> compared 0) (dor-balance (vector-ref node 0) (vector-ref node 1) (vector-ref node 2)
            left (dor-update right key row delta work) work))
          (else
           (if (not (equal? row (vector-ref node 1))) (error "Canonical ordered-key collision"))
           (let ((weight (dor-integer (+ (vector-ref node 2) delta))))
             (cond
               ((< weight 0) (error "Ordered view cannot admit negative integrated multiplicity"))
               ((> weight 0) (dor-balance key (vector-ref node 1) weight left right work))
               ((not left) right) ((not right) left)
               (else (let ((next (dor-minimum right work)))
                 (dor-balance (vector-ref next 0) (vector-ref next 1) (vector-ref next 2)
                   left (dor-delete-min right work) work))))))))))
(define (dor-select root rank)
  (if (not (and (integer? rank) (exact? rank) (>= rank 0) (< rank (dor-mass root))))
      (error "Weighted rank outside current view"))
  (let search ((node root) (offset 0))
    (let* ((start (+ offset (dor-mass (vector-ref node 3))))
           (end (+ start (vector-ref node 2))))
      (cond ((< rank start) (search (vector-ref node 3) offset))
            ((>= rank end) (search (vector-ref node 4) end))
            (else (vector (vector-ref node 1) (vector-ref (vector-ref node 0) 0) start (vector-ref node 2)))))))
(define (dor-rank root key row)
  (let search ((node root) (offset 0))
    (if (not node) #f
      (let* ((compared (dor-compare key (vector-ref node 0)))
             (start (+ offset (dor-mass (vector-ref node 3)))))
        (cond ((< compared 0) (search (vector-ref node 3) offset))
              ((> compared 0) (search (vector-ref node 4) (+ start (vector-ref node 2))))
              (else (if (not (equal? row (vector-ref node 1))) (error "Canonical ordered-key collision"))
                (cons start (+ start (vector-ref node 2)))))))))
(define (dor-top root k)
  (dor-limit k)
  (let ((remaining k) (entries '()))
    (define (visit node)
      (if (and node (> remaining 0))
        (begin
          (visit (vector-ref node 4))
          (if (> remaining 0)
            (let ((weight (min remaining (vector-ref node 2))))
              (set! entries (cons (list weight (vector-ref node 1)) entries))
              (set! remaining (- remaining weight))))
          (visit (vector-ref node 3)))))
    (visit root) (zset-from-weighted entries)))
;; Row payloads and the scorer obey the ordinary DBSP immutable/pure contract.
;; The tree and metadata remain private; returned top views own outer Z-sets.
(define (dor-state scorer root top-k work)
  (lambda (action argument)
    (cond
      ((eq? action 'info) (vector (dor-size root) (dor-mass root) (dor-height root)))
      ((eq? action 'work) (vector-copy work))
      ((eq? action 'select) (dor-select root argument))
      ((eq? action 'rank) (dor-rank root (dor-key scorer argument) argument))
      ((eq? action 'top) (dor-top root argument))
      ((eq? action 'quantile)
       (if (not (and (rational? argument) (exact? argument) (>= argument 0) (<= argument 1)))
           (error "Quantile must be an exact rational in [0,1]"))
       (let ((rank (max 0 (- (dor-integer (ceiling (* argument (dor-mass root)))) 1))))
         (dor-select root rank)))
      ((eq? action 'step)
       (if (not (zset? argument)) (error "Ordered step requires a signed Z-set"))
       (if (> (zset-size argument) 65536) (error "Ordered delta exceeds 65536 changed rows"))
       (let* ((delta (zset-consolidate argument)) (receipt (vector 0 0 0 0))
              (next (fold-left (lambda (tree entry)
                (let* ((weight (dor-integer (car entry))) (row (cadr entry)) (key (dor-key scorer row)))
                  (vector-set! receipt 0 (+ (vector-ref receipt 0) 1))
                  (dor-update tree key row weight receipt))) root (zset-entries delta)))
              (output-delta (and top-k (zset-sub (dor-top next top-k) (dor-top root top-k)))))
         (vector (dor-state scorer next top-k receipt) output-delta (vector-copy receipt))))
      (else (error "Unknown ordered view action")))))
(define (make-dbsp-ordered scorer . top-size)
  (if (not (and (procedure? scorer) (<= (length top-size) 1))) (error "Expected a scorer and optional fixed top-k size"))
  (let ((k (and (pair? top-size) (dor-limit (car top-size)))))
    (dor-state scorer #f k (vector 0 0 0 0))))
(define (dbsp-ordered-step snapshot delta) (snapshot 'step delta))
(define (dbsp-ordered-select snapshot rank) (snapshot 'select rank))
(define (dbsp-ordered-quantile snapshot q) (snapshot 'quantile q))
(define (dbsp-ordered-rank snapshot row) (snapshot 'rank row))
(define (dbsp-ordered-top snapshot k) (snapshot 'top k))
(define (dbsp-ordered-info snapshot) (snapshot 'info #f))
(define (dbsp-ordered-work snapshot) (snapshot 'work #f))
