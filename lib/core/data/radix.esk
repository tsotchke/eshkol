;;; Persistent 63-bit integer index. Values must be treated as immutable.
;;; Path copying touches sixteen 16-slot nodes per set, independent of size.
(require stdlib)
(provide radix-empty radix-ref radix-set radix-delete radix-fold)
(define (radix-empty) #f)
(define (ri-key key)
  (if (not (and (integer? key) (exact? key) (>= key 0) (<= key 9223372036854775807)))
      (error "Radix keys must be nonnegative exact signed-word integers" key)))
(define (radix-ref root key fallback)
  (ri-key key)
  (let walk ((node root) (k key) (level 0))
    (cond ((eq? node #f) fallback)
          ((= level 16) (vector-ref node 0))
          (else (walk (vector-ref node (modulo k 16)) (quotient k 16) (+ level 1))))))
(define (ri-put node key level value)
  (if (= level 16) (vector value)
      (let* ((digit (modulo key 16))
             (copy (if (eq? node #f) (make-vector 16 #f) (vector-copy node))))
        (vector-set! copy digit
          (ri-put (if (eq? node #f) #f (vector-ref node digit)) (quotient key 16) (+ level 1) value))
        copy)))
(define (radix-set root key value)
  (ri-key key) (ri-put root key 0 value))
(define (ri-empty-node? node)
  (let loop ((i 0))
    (or (= i 16) (and (eq? (vector-ref node i) #f) (loop (+ i 1))))))
(define (ri-delete node key level)
  (cond ((eq? node #f) #f)
        ((= level 16) #f)
        (else
          (let* ((digit (modulo key 16)) (old (vector-ref node digit))
                 (next (ri-delete old (quotient key 16) (+ level 1))))
            (if (eq? old next) node
                (let ((copy (vector-copy node)))
                  (vector-set! copy digit next)
                  (if (ri-empty-node? copy) #f copy)))))))
(define (radix-delete root key)
  (ri-key key) (ri-delete root key 0))
;; Deterministic radix traversal; consumers requiring numeric/canonical order
;; sort explicitly. A stored #f is distinct from an absent leaf.
(define (ri-fold-children node level prefix place procedure i acc)
  (if (= i 16) acc
      (ri-fold-children node level prefix place procedure (+ i 1)
        (ri-fold-node (vector-ref node i) (+ level 1) (+ prefix (* i place))
                      (* place 16) procedure acc))))
(define (ri-fold-node node level prefix place procedure acc)
  (cond ((eq? node #f) acc)
        ((= level 16) (procedure prefix (vector-ref node 0) acc))
        (else (ri-fold-children node level prefix place procedure 0 acc))))
(define (radix-fold root procedure initial)
  (ri-fold-node root 0 0 1 procedure initial))
