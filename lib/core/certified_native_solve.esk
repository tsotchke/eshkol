;;; Native candidates, exact original-model admission, bounded defect correction.
(require stdlib)
(require core.certified_solve)
(provide solve-certified-native verify-certified-native-solve)

(define (cns-q x)
  (if (not (and (rational? x) (exact? x))) (error "Expected exact rational solve data")) x)
(define (cns-tab n f) (list->vector (map f (iota n))))
(define (cns-vector x n)
  (if (not (and (vector? x) (= (vector-length x) n))) (error "Solve vector shape mismatch"))
  (list->vector (map cns-q (vector->list x))))
(define (cns-matrix a n) (if (not (and (vector? a) (= (vector-length a) n))) (error "Solve matrix shape mismatch"))
  (list->vector (map (lambda (row) (cns-vector row n)) (vector->list a))))
(define (cns-sum n f) (let loop ((i 0) (s 0)) (if (= i n) s (loop (+ i 1) (cns-q (+ s (f i)))))))
(define (cns-tensor a n matrix?)
  (let ((out (make-tensor (if matrix? (list n n) (list n)) 0.0)))
    (let loop ((i 0)) (if (< i (if matrix? (* n n) n))
      (let ((x (exact->inexact (if matrix? (vector-ref (vector-ref a (quotient i n)) (modulo i n)) (vector-ref a i)))))
        (if (not (finite? x)) (error "Native conversion is nonfinite"))
        (tensor-set! out i x) (loop (+ i 1))))) out))
(define (cns-reconstruct x)
  (if (not (finite? x)) (error "Native solver produced a nonfinite candidate"))
  (let ((sign (if (< x 0) -1 1)))
    (let fraction ((y (abs x)) (p0 0) (p1 1) (q0 1) (q1 0) (steps 0))
      (let* ((a (inexact->exact (floor y))) (p (+ (* a p1) p0)) (q (+ (* a q1) q0))
             (tail (- y (exact->inexact a))))
        (cond ((or (> q 4096) (= steps 32)) (cns-q (/ (* sign p1) q1)))
              ((= tail 0.0) (cns-q (/ (* sign p) q)))
              (else (fraction (/ 1.0 tail) p1 p q1 q (+ steps 1))))))))
(define (cns-decode value n matrix?)
  (define (entry i) (cns-reconstruct (tensor-ref value i)))
  (if matrix? (cns-tab n (lambda (i) (cns-tab n (lambda (j) (entry (+ (* i n) j))))))
      (cns-tab n entry)))
(define (cns-tight? certificate tolerance)
  (and (eq? (vector-ref certificate 1) 'proved)
       (let ((radii (vector-ref (vector-ref certificate 3) 13)))
         (let loop ((i 0)) (or (= i (vector-length radii))
           (and (<= (vector-ref radii i) tolerance) (loop (+ i 1))))))))
;; Optional correction cap (0..8), then the existing checker's w,dA,db.
;; Native floats propose bounded-denominator rationals; only exact original-model
;; verification admits them. Reconstruction is never assumed correct.
(define (solve-certified-native matrix rhs tolerance . options)
  (if (not (and (vector? matrix) (> (vector-length matrix) 0) (<= (vector-length matrix) 64)))
      (error "Native certified solves have dimension 1..64"))
  (cns-q tolerance) (if (< tolerance 0) (error "Tolerance must be nonnegative"))
  (if (> (length options) 4) (error "Expected correction cap and optional weights/matrix/RHS radii"))
  (let* ((n (vector-length matrix)) (a (cns-matrix matrix n)) (b (cns-vector rhs n))
         (cap (if (null? options) 3 (car options)))
         (extra (if (null? options) '() (cdr options))))
    (if (not (and (integer? cap) (exact? cap) (>= cap 0) (<= cap 8))) (error "Correction cap must be 0..8"))
    ;; Validate and own every optional premise before attempting native work.
    (let* ((premises (apply certify-linear-solve a b (make-vector n 0)
                       (cns-tab n (lambda (i) (make-vector n 0))) extra))
           (source (vector-ref premises 3))
           (owned (list (vector-ref source 4) (vector-ref source 5) (vector-ref source 6))))
      (guard (e (else (vector 'certified-native-solve-v1 'unknown #f #f #f (vector 'candidate-unavailable 0 0))))
        (let* ((native-a (cns-tensor a n #t)) (native-b (cns-tensor b n #f))
               (initial (cns-decode (linear-solve native-a native-b) n #f))
               (inverse (cns-decode (tensor-inverse native-a) n #t)))
          (let refine ((x initial) (iteration 0))
            (let* ((certificate (apply certify-linear-solve a b x inverse owned))
                   (tight (cns-tight? certificate tolerance))
                   (contraction (eq? (vector-ref certificate 1) 'proved)))
              (if (or tight (= iteration cap) (not contraction))
                  (vector 'certified-native-solve-v1 (if tight 'proved 'unknown)
                    (vector-copy x) (and tight (vector-ref certificate 2)) certificate
                    (vector (cond (tight 'tolerance-met) ((not contraction) 'contraction-unresolved) (else 'budget-exhausted)) iteration 2))
                  (let* ((residual (vector-ref (vector-ref certificate 3) 7))
                         (next (cns-tab n (lambda (i) (cns-q (+ (vector-ref x i)
                           (cns-sum n (lambda (j) (cns-q (* (vector-ref (vector-ref inverse i) j) (vector-ref residual j)))))))))))
                    (refine next (+ iteration 1)))))))))))
;; Verification trusts no native residual, status flag or recorded cost claim.
;; It verifies a proved enclosure against the caller's original problem.
(define (verify-certified-native-solve result matrix rhs tolerance . premises)
  (guard (e (else #f))
    (cns-q tolerance)
    (and (>= tolerance 0) (vector? result) (= (vector-length result) 6)
         (eq? (vector-ref result 0) 'certified-native-solve-v1)
         (eq? (vector-ref result 1) 'proved)
         (let* ((certificate (vector-ref result 4)) (receipt (vector-ref certificate 3))
                (x (vector-ref result 2)) (inverse (vector-ref receipt 3)))
           (and (apply verify-linear-solve-certificate certificate matrix rhs x inverse premises)
                (equal? (vector-ref result 3) (vector-ref certificate 2))
                (cns-tight? certificate tolerance))))))
