;;; One bottom-field LU, reused through every enclosing coefficient recurrence.
(require core.algebraic_domain)
(provide algebraic-factor algebraic-factor-solve algebraic-factor-solve-transpose algebraic-factor-positive-definite? algebraic-factor-summary
         algebraic-matrix-mul algebraic-solve)

(define (al-matrix domain matrix)
  (if (not (and (vector? matrix) (> (vector-length matrix) 0)))
      (error "Expected a nonempty row-vector matrix"))
  (let* ((rows (vector-length matrix)) (first (vector-ref matrix 0))
         (copy (algebraic-domain-ref domain 'copy)) (out (make-vector rows #f)))
    (if (not (and (vector? first) (> (vector-length first) 0)))
        (error "Expected nonempty matrix rows"))
    (let ((cols (vector-length first)))
      (let loop ((i 0))
        (if (< i rows)
            (let ((row (vector-ref matrix i)) (owned (make-vector cols #f)))
              (if (not (and (vector? row) (= (vector-length row) cols)))
                  (error "Ragged algebraic matrix"))
              (let cells ((j 0)) (if (< j cols)
                (begin (vector-set! owned j (copy (vector-ref row j))) (cells (+ j 1)))))
              (vector-set! out i owned) (loop (+ i 1))))) out)))
(define (al-ref matrix i j) (vector-ref (vector-ref matrix i) j))
(define (al-set! matrix i j value) (vector-set! (vector-ref matrix i) j value))
(define (algebraic-matrix-mul owner a b)
  (let* ((domain (algebraic-domain owner)) (a (al-matrix domain a)) (b (al-matrix domain b))
         (m (vector-length a)) (n (vector-length (vector-ref a 0)))
         (p (vector-length (vector-ref b 0))) (out (make-vector m #f))
         (add (algebraic-domain-ref domain 'add)) (mul (algebraic-domain-ref domain 'mul)))
    (if (not (= n (vector-length b))) (error "Algebraic matrix inner dimensions differ"))
    (let rows ((i 0)) (if (< i m)
      (let ((row (make-vector p #f)))
        (let columns ((j 0)) (if (< j p)
          (begin (vector-set! row j
            (let dot ((k 0) (sum (algebraic-domain-ref domain 'zero)))
              (if (= k n) sum (dot (+ k 1) (add sum (mul (al-ref a i k) (al-ref b k j)))))))
            (columns (+ j 1)))))
        (vector-set! out i row) (rows (+ i 1))))) out))
(define (al-lu domain matrix)
  (let* ((lu (al-matrix domain matrix)) (n (vector-length lu))
         (permutation (make-vector n 0)) (sub (algebraic-domain-ref domain 'sub))
         (mul (algebraic-domain-ref domain 'mul)) (inv (algebraic-domain-ref domain 'inverse))
         (unit? (algebraic-domain-ref domain 'unit?)))
    (let init ((i 0)) (if (< i n) (begin (vector-set! permutation i i) (init (+ i 1)))))
    (let columns ((k 0))
      (if (< k n)
          (let ((pivot (let search ((i k))
            (cond ((= i n) (error "Singular primal algebraic matrix"))
                  ((unit? (al-ref lu i k)) i) (else (search (+ i 1)))))))
            (let ((row (vector-ref lu k)) (old (vector-ref permutation k)))
              (vector-set! lu k (vector-ref lu pivot)) (vector-set! lu pivot row)
              (vector-set! permutation k (vector-ref permutation pivot)) (vector-set! permutation pivot old))
            (let ((scale (inv (al-ref lu k k))))
              (let eliminate ((i (+ k 1))) (if (< i n)
                (let ((factor (mul (al-ref lu i k) scale)))
                  (al-set! lu i k factor)
                  (let trailing ((j (+ k 1))) (if (< j n)
                    (begin (al-set! lu i j (sub (al-ref lu i j) (mul factor (al-ref lu k j))))
                           (trailing (+ j 1)))))
                  (eliminate (+ i 1))))))
            (columns (+ k 1)))))
    ;; Verify P*A=L*U, not merely the nonzero diagonal.
    (let ((equal? (algebraic-domain-ref domain 'equal?)) (add (algebraic-domain-ref domain 'add)))
      (let rows ((i 0)) (if (< i n)
        (begin (let cols ((j 0)) (if (< j n)
          (let ((value (let sum ((k 0) (acc (algebraic-domain-ref domain 'zero)))
            (if (= k n) acc
              (sum (+ k 1) (add acc (mul
                (cond ((< k i) (al-ref lu i k)) ((= k i) (algebraic-domain-ref domain 'one))
                      (else (algebraic-domain-ref domain 'zero)))
                (if (<= k j) (al-ref lu k j) (algebraic-domain-ref domain 'zero)))))))))
            (if (not (equal? value (al-ref matrix (vector-ref permutation i) j)))
                (error "Algebraic LU failed its full residual")) (cols (+ j 1)))))
          (rows (+ i 1))))))
    (vector lu permutation)))
(define (algebraic-factor owner matrix)
  (let* ((domain (algebraic-domain owner)) (matrix (al-matrix domain matrix))
         (n (vector-length matrix)) (parent (algebraic-domain-ref domain 'parent)))
    (if (not (and (= n (vector-length (vector-ref matrix 0))) (<= n 32)))
        (error "Algebraic factorization requires a square matrix of size 1 through 32"))
    (if parent
        (let* ((dimension (algebraic-domain-ref domain 'dimension))
               (coefficients (make-vector dimension #f))
               (observe (algebraic-domain-ref domain 'coefficients)))
          (let powers ((k 0)) (if (< k dimension)
            (let ((part (make-vector n #f)))
              (let rows ((i 0)) (if (< i n)
                (let ((row (make-vector n #f)))
                  (let cols ((j 0)) (if (< j n)
                    (begin (vector-set! row j (vector-ref (observe (al-ref matrix i j)) k)) (cols (+ j 1)))))
                  (vector-set! part i row) (rows (+ i 1)))))
              (vector-set! coefficients k part) (powers (+ k 1)))))
          (vector 'algebraic-factor-v1 domain matrix coefficients
            (algebraic-factor (algebraic-domain-ref parent 'owner) (vector-ref coefficients 0))))
        (vector 'algebraic-factor-v1 domain matrix (al-lu domain matrix) #f))))
(define (al-factor-check factor)
  (if (not (and (vector? factor) (= (vector-length factor) 5)
                (eq? (vector-ref factor 0) 'algebraic-factor-v1)))
      (error "Expected an algebraic factorization")) factor)
(define (algebraic-factor-summary factor)
  (al-factor-check factor)
  (vector (vector-length (vector-ref factor 2))
          (algebraic-domain-ref (vector-ref factor 1) 'depth) 1))
(define (al-lu-solve factor rhs)
  (let* ((domain (vector-ref factor 1)) (data (vector-ref factor 3))
         (lu (vector-ref data 0)) (permutation (vector-ref data 1)) (n (vector-length lu))
         (out (make-vector n #f)) (sub (algebraic-domain-ref domain 'sub))
         (mul (algebraic-domain-ref domain 'mul)) (inv (algebraic-domain-ref domain 'inverse)))
    (let forward ((i 0)) (if (< i n)
      (begin (vector-set! out i
        (let sum ((j 0) (value (vector-ref rhs (vector-ref permutation i))))
          (if (= j i) value (sum (+ j 1) (sub value (mul (al-ref lu i j) (vector-ref out j)))))))
        (forward (+ i 1)))))
    (let back ((i (- n 1))) (if (>= i 0)
      (begin (vector-set! out i (mul (inv (al-ref lu i i))
        (let sum ((j (+ i 1)) (value (vector-ref out i)))
          (if (= j n) value (sum (+ j 1) (sub value (mul (al-ref lu i j) (vector-ref out j))))))))
        (back (- i 1))))) out))
(define (al-lu-solve-transpose factor rhs)
  (let* ((domain (vector-ref factor 1)) (data (vector-ref factor 3))
         (lu (vector-ref data 0)) (permutation (vector-ref data 1)) (n (vector-length lu))
         (work (make-vector n #f)) (out (make-vector n #f))
         (sub (algebraic-domain-ref domain 'sub)) (mul (algebraic-domain-ref domain 'mul))
         (inv (algebraic-domain-ref domain 'inverse)))
    ;; U^T z=b; L^T y=z; P x=y, using the retained P*A=L*U.
    (let forward ((i 0)) (if (< i n)
      (begin (vector-set! work i (mul (inv (al-ref lu i i))
        (let sum ((j 0) (value (vector-ref rhs i)))
          (if (= j i) value (sum (+ j 1) (sub value (mul (al-ref lu j i) (vector-ref work j))))))))
        (forward (+ i 1)))))
    (let back ((i (- n 1))) (if (>= i 0)
      (begin (vector-set! work i
        (let sum ((j (+ i 1)) (value (vector-ref work i)))
          (if (= j n) value (sum (+ j 1) (sub value (mul (al-ref lu j i) (vector-ref work j)))))))
        (back (- i 1)))))
    (let scatter ((i 0)) (if (< i n)
      (begin (vector-set! out (vector-ref permutation i) (vector-ref work i)) (scatter (+ i 1))))) out))
(define (al-product-index kind i j)
  (if (eq? kind 'taylor) (+ i j)
      (cond ((= i 0) j) ((= j 0) i) ((= (+ i j) 3) 3) (else -1))))
(define (al-factor-solve factor rhs transposed)
  (al-factor-check factor)
  (let* ((domain (vector-ref factor 1)) (matrix (vector-ref factor 2)) (n (vector-length matrix))
         (copy (algebraic-domain-ref domain 'copy)) (owned (make-vector n #f))
         (parent (algebraic-domain-ref domain 'parent)))
    (if (not (and (vector? rhs) (= (vector-length rhs) n))) (error "Algebraic RHS dimension mismatch"))
    (let cells ((i 0)) (if (< i n)
      (begin (vector-set! owned i (copy (vector-ref rhs i))) (cells (+ i 1)))))
    (let ((out (if (not parent) (if transposed (al-lu-solve-transpose factor owned) (al-lu-solve factor owned))
      (let* ((dimension (algebraic-domain-ref domain 'dimension))
             (kind (algebraic-domain-ref domain 'kind)) (parts (vector-ref factor 3))
             (answers (make-vector dimension #f)) (out (make-vector n #f))
             (observe (algebraic-domain-ref domain 'coefficients))
             (sub (algebraic-domain-ref parent 'sub)) (mul (algebraic-domain-ref parent 'mul)))
        (let coefficients ((k 0)) (if (< k dimension)
          (let ((b (make-vector n #f)))
            (let rows ((r 0)) (if (< r n)
              (let ((value (vector-ref (observe (vector-ref owned r)) k)))
                (let left ((i 1)) (if (< i dimension)
                  (begin (let right ((j 0)) (if (< j k)
                    (begin (if (= (al-product-index kind i j) k)
                      (let dot ((c 0)) (if (< c n)
                        (begin (set! value (sub value (mul (if transposed (al-ref (vector-ref parts i) c r) (al-ref (vector-ref parts i) r c))
                          (vector-ref (vector-ref answers j) c)))) (dot (+ c 1))))))
                      (right (+ j 1))))) (left (+ i 1)))))
                (vector-set! b r value) (rows (+ r 1)))))
            (vector-set! answers k (al-factor-solve (vector-ref factor 4) b transposed))
            (coefficients (+ k 1)))))
        (let rows ((r 0)) (if (< r n)
          (let ((cells (make-vector dimension #f)))
            (let coefficients ((k 0)) (if (< k dimension)
              (begin (vector-set! cells k (vector-ref (vector-ref answers k) r)) (coefficients (+ k 1)))))
            (vector-set! out r ((algebraic-domain-ref domain 'element) cells)) (rows (+ r 1))))) out))))
      (let ((add (algebraic-domain-ref domain 'add)) (mul (algebraic-domain-ref domain 'mul))
            (equal? (algebraic-domain-ref domain 'equal?)))
        (let rows ((r 0)) (if (< r n)
          (begin (if (not (equal? (let dot ((c 0) (value (algebraic-domain-ref domain 'zero)))
            (if (= c n) value (dot (+ c 1) (add value (mul (if transposed (al-ref matrix c r) (al-ref matrix r c)) (vector-ref out c))))))
            (vector-ref owned r))) (error "Algebraic solve failed its full residual")) (rows (+ r 1)))))) out)))
(define (algebraic-solve owner matrix rhs)
  (algebraic-factor-solve (algebraic-factor owner matrix) rhs))

(define (algebraic-factor-solve factor rhs) (al-factor-solve factor rhs #f))
(define (algebraic-factor-solve-transpose factor rhs) (al-factor-solve factor rhs #t))

;;; Sylvester admission from the already-verified symmetric LU: SPD implies
;;; identity pivot permutation and strictly positive Schur-complement pivots.
(define (algebraic-factor-positive-definite? factor)
  (al-factor-check factor)
  (let* ((domain (vector-ref factor 1)) (matrix (vector-ref factor 2)) (n (vector-length matrix))
         (equal? (algebraic-domain-ref domain 'equal?)))
    (and (let rows ((i 0)) (or (= i n)
      (and (let cols ((j 0)) (or (= j i)
        (and (equal? (al-ref matrix i j) (al-ref matrix j i)) (cols (+ j 1))))) (rows (+ i 1)))))
      (let bottom ((f factor))
        (if (vector-ref f 4) (bottom (vector-ref f 4))
          (let ((lu (vector-ref (vector-ref f 3) 0)) (permutation (vector-ref (vector-ref f 3) 1)))
            (let pivots ((i 0)) (or (= i n)
              (and (= (vector-ref permutation i) i) (= (algebraic-sign (al-ref lu i i)) 1)
                   (pivots (+ i 1)))))))))))
