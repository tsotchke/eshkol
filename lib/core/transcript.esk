;; transcript.esk — exact, content-addressed transcripts of certified
;; mathematical quantities.
;;
;; (require core.transcript)
;;
;; A transcript is a JSON document recording, for one program run, every
;; certified quantity (a rank, a Smith-normal-form invariant-factor list, a
;; Gram matrix, a character count, a determinant, a polynomial gcd, ...)
;; together with the exact inputs that produced it, so an independent
;; program — the pure-Python replay checker in scripts/math_crosscheck/, or
;; PARI/GP and SymPy on a second host — can recompute each claim from its
;; own copy of the inputs and compare against the recorded output.  Each
;; claim also carries a content hash over its own canonical encoding, so a
;; transcript file is tamper-evident the same way core.merkle's
;; content-addressable store is: the hash function is literally the same
;; one (fnv1a-64), reused here rather than defining a second hash.
;;
;; Recording is OFF by default and never changes a program's printed
;; output: (transcript-open name) with no ESHKOL_TRANSCRIPT environment
;; variable set returns an INACTIVE handle, and every transcript-record!
;; / transcript-close! call on an inactive handle is a silent no-op (no
;; file is touched, nothing is computed beyond the handle itself). Set
;; ESHKOL_TRANSCRIPT to a file path to turn recording on for that process;
;; transcript-close! then writes every claim collected so far, oldest
;; first, to that path as one JSON document.
;;
;; ---------------------------------------------------------------------
;; Canonical value encoding
;; ---------------------------------------------------------------------
;; Every encoded value is a JSON object tagged by "t":
;;
;;   exact integer    {"t":"z","v":"<decimal string, sign included>"}
;;   exact rational   {"t":"q","n":"<num string>","d":"<den string>"}   (d > 0, lowest terms)
;;   finite double    {"t":"dyadic","m":"<int string>","e":"<int string>"}  the exact value m * 2^e
;;   matrix           {"t":"mat","rows":R,"cols":C,"data":[[<value>...]...]}
;;   vector           {"t":"vec","n":N,"data":[<value>...]}
;;   polynomial       {"t":"poly","var":"<name>","deg":D,"coeffs":[<value>...]}  (lowest degree first)
;;   list             {"t":"list","n":N,"data":[<value>...]}
;;   string           {"t":"str","v":"<string>"}
;;   boolean          {"t":"bool","v":true|false}
;;   opaque fallback  {"t":"opaque","label":"<carrier/kind>","repr":"<string>"}
;;
;; Integers and rational numerators/denominators are ALWAYS encoded as
;; decimal STRINGS, never bare JSON numbers: Eshkol's exact integers are
;; bignums with no size bound, and a JSON number is not guaranteed beyond
;; float64 precision by every reader, so a bare big integer would silently
;; lose precision in some consumer. Small structural counts (rows, cols,
;; vector/list length, polynomial degree) are plain JSON numbers — they are
;; always small int64s by construction.
;;
;; A claim document is:
;;   {"kind":"<claim kind, e.g. smith_normal_form>",
;;    "label":"<human label identifying the instance>",
;;    "inputs":{"<name>":<value>, ...},
;;    "output":<value>,
;;    "hash":"<16-hex fnv1a-64 of the canonical JSON text of
;;             {"kind":...,"label":...,"inputs":...,"output":...} in that
;;             field order, with the hash field itself excluded>"}
;;
;; A transcript document is:
;;   {"schema":"eshkol.transcript.v1","program":"<name>","claims":[<claim>...]}
;;
;; The JSON Schema for both is scripts/math_crosscheck/transcript_schema.json;
;; the reference page is docs/reference/stdlib/transcript.md.
;;
;; A claim may carry further fields after "output" (core.certificate adds
;; "witness", "premises" and a sha256 "id"; ADR-0047).  The hash rule is
;; the same for every claim: fnv1a-64 of the canonical JSON text of every
;; field except "hash", in the order written.  For a four-field claim this
;; is exactly the rule above.  transcript-open-as and transcript-open-path
;; bind a handle to another environment variable, an explicit path, or
;; another document schema (core.certificate uses "eshkol.certificate.v1"
;; and ESHKOL_CERTIFICATES).

(require stdlib)
(require core.merkle)
(require core.json)

(provide
  ;; handle lifecycle
  transcript-open transcript-active? transcript-record! transcript-close!
  transcript-open-as transcript-open-path transcript-record-claim! transcript-seal-claim
  ;; canonical value encoders
  tv-int tv-rat tv-float tv-bool tv-string tv-opaque
  tv-list tv-int-list tv-rat-list
  tv-vector tv-matrix-rows tv-matrix-vec tv-matrix
  tv-poly)

;; ---------------------------------------------------------------------
;; Canonical value encoders — each returns an ordered alist ("t" first)
;; ready for core.json's json-stringify.
;; ---------------------------------------------------------------------

(define (tv-int z)
  "Encode an exact integer (bignum-safe: always a decimal string)."
  (list (cons "t" "z") (cons "v" (number->string z))))

(define (tv-rat q)
  "Encode an exact rational (or integer, which is encoded as tv-int)."
  (if (integer? q)
      (tv-int q)
      (list (cons "t" "q")
            (cons "n" (number->string (numerator q)))
            (cons "d" (number->string (denominator q))))))

(define (tv-float x)
  "Encode a finite double EXACTLY as m * 2^e (m, e exact integers; m odd
   or zero), so a reader recovers the very binary64 value with no decimal
   rounding.  An exact argument is encoded as tv-rat would."
  (cond ((exact? x) (tv-rat x))
        ((not (= x x)) (error "tv-float: NaN has no exact value"))
        ((> (abs x) 1.7976931348623157e308) (error "tv-float: an infinity has no exact value" x))
        ((= x 0.0) (list (cons "t" "dyadic") (cons "m" "0") (cons "e" "0")))
        (else
         ;; Doubling and halving a binary64 are exact, so the loops below
         ;; only move the binary point.
         (let up ((y x) (e 0))
           (if (not (integer? y))
               (up (* y 2.0) (- e 1))
               (let down ((y y) (e e))
                 (if (integer? (/ y 2.0))
                     (down (/ y 2.0) (+ e 1))
                     (list (cons "t" "dyadic")
                           (cons "m" (number->string (inexact->exact y)))
                           (cons "e" (number->string e))))))))))

(define (tv-bool b) (list (cons "t" "bool") (cons "v" (if b #t #f))))
(define (tv-string s) (list (cons "t" "str") (cons "v" s)))

(define (tv-opaque label repr-string)
  "Fallback for a value with no numeric encoding (e.g. a non-numeric ring
   carrier element): records a label and a caller-supplied string
   representation. Not independently recomputable by the replay checker;
   use a numeric encoder whenever one applies."
  (list (cons "t" "opaque") (cons "label" label) (cons "repr" repr-string)))

(define (tv-list encoded-xs)
  "encoded-xs: a list already produced by one of the other tv-* encoders.
   \"data\" is stored as a vector, not a list: core.json's json-stringify
   cannot tell an empty LIST apart from JSON null (see core.json's
   module comment), so the empty case -- e.g. a Smith normal form with
   no nonzero invariant factor -- would otherwise silently serialize as
   null instead of []."
  (list (cons "t" "list") (cons "n" (length encoded-xs)) (cons "data" (list->vector encoded-xs))))

(define (tv-int-list xs) (tv-list (map tv-int xs)))
(define (tv-rat-list xs) (tv-list (map tv-rat xs)))

(define (tv-vector xs)
  "xs: a plain Eshkol list of exact numbers (the vector's elements)."
  (list (cons "t" "vec") (cons "n" (length xs)) (cons "data" (list->vector (map tv-rat xs)))))

(define (tv-matrix-rows rows)
  "rows: a list of lists of exact numbers, row-major.  Both the outer
   data and every row are stored as vectors (see tv-list) so a 0-row or
   0-column matrix still serializes as [] rather than null."
  (list (cons "t" "mat")
        (cons "rows" (length rows))
        (cons "cols" (if (null? rows) 0 (length (car rows))))
        (cons "data" (list->vector (map (lambda (r) (list->vector (map tv-rat r))) rows)))))

(define (tv-matrix-vec V)
  "V: a vector of vectors of exact numbers (the make-matrix / integer_linalg
   convention used by the mathematics examples)."
  (tv-matrix-rows (map vector->list (vector->list V))))

(define (tv-matrix V) (tv-matrix-vec V))

(define (tv-poly var coeffs)
  "coeffs: a list of exact numbers, LOWEST degree first."
  (list (cons "t" "poly") (cons "var" var)
        (cons "deg" (if (null? coeffs) 0 (- (length coeffs) 1)))
        (cons "coeffs" (list->vector (map tv-rat coeffs)))))

;; ---------------------------------------------------------------------
;; Handle
;; ---------------------------------------------------------------------
;; A handle is (vector 'eshkol-transcript active? program-name path box schema)
;; where box is a one-element vector holding the claims collected so far
;; (newest first); mutating box is how transcript-record! "mutates" a
;; handle built from immutable fields.

(define (transcript-open-path program-name path schema)
  "An ACTIVE handle bound to an explicit output path and document schema,
   independent of any environment variable."
  (vector 'eshkol-transcript #t program-name path (vector '()) schema))

(define (transcript-open-as program-name env-var schema)
  "A handle that is active iff the environment variable env-var names a
   non-empty path; otherwise every call on it is a no-op."
  (let ((path (get-environment-variable env-var)))
    (if (and path (string? path) (not (string=? path "")))
        (transcript-open-path program-name path schema)
        (vector 'eshkol-transcript #f program-name #f (vector '()) schema))))

(define (transcript-open program-name)
  "Returns a transcript handle for program-name.  Active (recording
   claims and, on transcript-close!, writing a file) iff the
   ESHKOL_TRANSCRIPT environment variable is set to a non-empty path;
   otherwise every subsequent call on this handle is a no-op."
  (transcript-open-as program-name "ESHKOL_TRANSCRIPT" "eshkol.transcript.v1"))

(define (transcript-active? h) (vector-ref h 1))

(define (transcript-claim-alist kind label inputs output)
  (list (cons "kind" kind) (cons "label" label) (cons "inputs" inputs) (cons "output" output)))

(define (transcript-seal-claim claim)
  "claim: an ordered alist of fields (kind, label, inputs, output, then
   any further fields).  Returns the same alist with \"hash\" appended:
   fnv1a-64 of the canonical JSON text of every field, in order."
  (append claim (list (cons "hash" (hash->hex (fnv1a-64 (json-stringify claim)))))))

(define (transcript-record-claim! h claim)
  "Record one claim given as an ordered field alist (see
   transcript-seal-claim).  No-op returning #f when h is inactive."
  (if (transcript-active? h)
      (let ((box (vector-ref h 4)))
        (vector-set! box 0 (cons (transcript-seal-claim claim) (vector-ref box 0)))
        #t)
      #f))

(define (transcript-record! h kind label inputs output)
  "Record one claim.  kind/label: strings.  inputs: an alist of
   (name-string . encoded-value).  output: an encoded-value.  No-op (and
   computes nothing beyond the handle check) when h is inactive; never
   prints anything, so it never changes a program's visible output."
  (if (transcript-active? h)
      (transcript-record-claim! h (transcript-claim-alist kind label inputs output))
      #f))

(define (transcript-close! h)
  "Write every claim collected so far (oldest first) as one JSON document
   to the handle's path.  No-op, and no file is touched, when h is
   inactive.  The handle stays usable: a later record and close rewrites
   the document with every claim so far."
  (if (transcript-active? h)
      (let* ((claims (reverse (vector-ref (vector-ref h 4) 0)))
             (doc (list (cons "schema" (vector-ref h 5))
                        (cons "program" (vector-ref h 2))
                        (cons "claims" (list->vector claims)))))
        (json-write-file (vector-ref h 3) doc)
        #t)
      #f))
