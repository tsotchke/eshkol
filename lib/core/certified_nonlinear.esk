;;; Source-bound exact polynomial Newton boxes and implicit derivative bounds.
(require core.ad.derived_operator)
(require core.certified_solve)
(provide make-certified-polynomial-system certify-polynomial-root verify-polynomial-root-certificate)

(define (cn-number x)
  (if (not (and (rational? x) (exact? x))) (error "polynomial root certificates require exact rationals")) x)
(define (cn+ a b) (cn-number (+ a b)))
(define (cn- a b) (cn-number (- a b)))
(define (cn* a b) (cn-number (* a b)))
(define (cn/ a b) (cn-number (/ a b)))
(define (cn-vector value n positive?)
  (if (not (and (vector? value) (= (vector-length value) n))) (error "polynomial system shape mismatch"))
  (list->vector (map (lambda (x)
    (cn-number x) (if (and positive? (<= x 0)) (error "trial radii must be positive")) x) (vector->list value))))
(define (cn-matrix value n)
  (if (not (and (vector? value) (= (vector-length value) n))) (error "preconditioner shape mismatch"))
  (list->vector (map (lambda (row) (cn-vector row n #f)) (vector->list value))))
(define (cn-tabulate n function) (list->vector (map function (iota n))))
(define (cn-mid box) (cn/ (cn+ (car box) (cdr box)) 2))
(define (cn-radius box) (cn/ (cn- (cdr box) (car box)) 2))
(define (cn-info system)
  (let ((info (system 'info #f #f)))
    (if (not (and (vector? info) (= (vector-length info) 3)
                  (eq? (vector-ref info 0) 'certified-polynomial-system-v1)))
        (error "Expected a compiled certified polynomial system")) info))
(define (make-certified-polynomial-system unknowns parameters expressions)
  (if (not (and (list? unknowns) (list? parameters) (list? expressions)
                (> (length unknowns) 0) (<= (+ (length unknowns) (length parameters)) 8)
                (= (length expressions) (length unknowns))))
      (error "Polynomial system needs 1..8 total variables and one equation per unknown"))
  (let* ((n (length unknowns)) (p (length parameters))
         (operators (map (lambda (expression) (make-derived-operator (append unknowns parameters) expression)) expressions)))
    (lambda (action point values)
      (cond
        ((eq? action 'info) (vector 'certified-polynomial-system-v1 n p))
        ((eq? action 'point)
         (let ((combined (list->vector (append (vector->list (cn-vector point n #f))
                                              (vector->list (cn-vector values p #f))))))
           (list->vector (map (lambda (op) (cn-number (derived-operator-value op combined))) operators))))
        ((eq? action 'family-box)
         (if (not (and (vector? point) (= (vector-length point) n)
                       (vector? values) (= (vector-length values) p))) (error "family box shape mismatch"))
         (let ((combined (list->vector (append (vector->list point) (vector->list values)))))
           (list->vector (map (lambda (op) (derived-operator-enclosure op combined)) operators))))
        ((eq? action 'box)
         (let ((parameters (cn-vector values p #f)))
           (if (not (and (vector? point) (= (vector-length point) n))) (error "root box shape mismatch"))
           (let ((combined (list->vector (append (vector->list point)
                   (map (lambda (x) (cons x x)) (vector->list parameters))))))
             (list->vector (map (lambda (op) (derived-operator-enclosure op combined)) operators)))))
        (else (error "Unknown polynomial system action"))))))
(define (certify-polynomial-root system center radii parameters inverse)
  (let* ((info (cn-info system)) (n (vector-ref info 1)) (p (vector-ref info 2))
         (center (cn-vector center n #f)) (radii (cn-vector radii n #t))
         (parameters (cn-vector parameters p #f)) (inverse (cn-matrix inverse n))
         (trial (cn-tabulate n (lambda (i) (cons (cn- (vector-ref center i) (vector-ref radii i))
                                               (cn+ (vector-ref center i) (vector-ref radii i))))))
         (residual (system 'point center parameters)) (bounds (system 'box trial parameters))
         (jacobian (cn-tabulate n (lambda (i) (cn-tabulate n (lambda (j)
           (cn-mid (vector-ref (vector-ref (vector-ref bounds i) 1) j)))))))
         (jacobian-radii (cn-tabulate n (lambda (i) (cn-tabulate n (lambda (j)
           (cn-radius (vector-ref (vector-ref (vector-ref bounds i) 1) j)))))))
         ;; The existing linear checker supplies |I-RJ|+|R|dJ and |R F(c)|.
         ;; Whole-box derivatives are generated from the admitted source terms.
         (linear (certify-linear-solve jacobian
           (cn-tabulate n (lambda (i) (cn- 0 (vector-ref residual i))))
           (make-vector n 0) inverse radii jacobian-radii))
         (receipt (vector-ref linear 3)) (majorant (vector-ref receipt 9))
         (forcing (vector-ref receipt 10)) (q (vector-ref receipt 11))
         (margin (cn-tabulate n (lambda (i)
           (cn- (vector-ref radii i)
             (cn+ (vector-ref forcing i)
               (let sum ((j 0) (out 0))
                 (if (= j n) out (sum (+ j 1) (cn+ out
                   (cn* (vector-ref (vector-ref majorant i) j) (vector-ref radii j)))))))))))
         (proved (and (eq? (vector-ref linear 1) 'proved)
           (let check ((i 0)) (or (= i n) (and (>= (vector-ref margin i) 0) (check (+ i 1)))))))
         (boxes (and proved (cn-tabulate n (lambda (i)
           (let ((radius (min (vector-ref radii i) (vector-ref (vector-ref receipt 13) i))))
             (cons (cn- (vector-ref center i) radius) (cn+ (vector-ref center i) radius)))))))
         (sensitivity (and proved (make-vector n #f))))
    (if proved
      (let ((columns (make-vector p #f)))
        (let parameter ((k 0)) (if (< k p)
          (let* ((rhs-boxes (cn-tabulate n (lambda (i)
                   (let ((box (vector-ref (vector-ref (vector-ref bounds i) 1) (+ n k))))
                     (cons (cn- 0 (cdr box)) (cn- 0 (car box)))))))
                 (rhs (cn-tabulate n (lambda (i) (cn-mid (vector-ref rhs-boxes i)))))
                 (received (cn-tabulate n (lambda (i)
                   (let sum ((j 0) (out 0)) (if (= j n) out
                     (sum (+ j 1) (cn+ out (cn* (vector-ref (vector-ref inverse i) j) (vector-ref rhs j)))))))))
                 (answer (certify-linear-solve jacobian rhs
                   received inverse radii jacobian-radii
                   (cn-tabulate n (lambda (i) (cn-radius (vector-ref rhs-boxes i)))))))
            (if (not (eq? (vector-ref answer 1) 'proved)) (error "admitted Newton box lost Jacobian invertibility"))
            (vector-set! columns k (vector-ref answer 2)) (parameter (+ k 1)))))
        (let rows ((i 0)) (if (< i n)
          (begin (vector-set! sensitivity i (cn-tabulate p (lambda (k) (vector-ref (vector-ref columns k) i))))
                 (rows (+ i 1)))))))
    (vector 'polynomial-root-certificate-v1 (if proved 'proved 'unknown) boxes sensitivity
      (vector system center radii parameters inverse residual jacobian jacobian-radii majorant forcing q margin linear))))
(define (verify-polynomial-root-certificate certificate system center radii parameters inverse)
  (guard (e (else #f))
    (and (vector? certificate) (= (vector-length certificate) 5)
         (equal? certificate (certify-polynomial-root system center radii parameters inverse)))))
