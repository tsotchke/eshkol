;;; Finite extensions of a checked prime field. Selected source donation: MIT.
;;; Quotient arithmetic and polynomial gcd/division belong to core.ring.
(require core.ring)
(provide make-extension-field extension-field? extension-prime extension-degree
         extension-order extension-modulus extension-element extension-coefficients
         extension-index->element extension-element->index extension-frobenius
         extension-conjugates extension-minimal-polynomial)

(define (ef-integer? n) (and (number? n) (integer? n) (exact? n)))
(define (ef-bounded-list? xs limit)
  (let loop ((xs xs) (left limit))
    (cond ((null? xs) #t) ((or (= left 0) (not (pair? xs))) #f)
          (else (loop (cdr xs) (- left 1))))))
(define (extension-field? F)
  (and (ring-carrier? F) (pair? (ring-carrier-extra F 'extension-v1))))
(define (ef-data F)
  (if (not (extension-field? F)) (error "Expected an extension-field carrier"))
  (ring-carrier-extra F 'extension-v1))
(define (extension-prime F) (car (ef-data F)))
(define (extension-degree F) (cadr (ef-data F)))
(define (extension-order F) (caddr (ef-data F)))
(define (extension-modulus F) (map (lambda (x) x) (cadddr (ef-data F))))
(define (ef-polys F) (list-ref (ef-data F) 4))
(define (ef-modulus-poly F) (list-ref (ef-data F) 5))

;; Binary exponentiation modulo f, entirely in the existing polynomial carrier.
(define (ef-poly-power P f a n)
  (let loop ((x (r-remainder P a f)) (k n) (out (r1 P)))
    (if (= k 0) out
        (loop (r-remainder P (r* P x x) f) (quotient k 2)
              (if (odd? k) (r-remainder P (r* P out x) f) out)))))

;; Rabin's criterion, checking every k <= floor(m/2) instead of factoring m:
;; gcd(x^(p^k)-x,f)=1 there, and x^(p^m)=x mod f.
(define (ef-irreducible? P f p m)
  (let ((x (r-remainder P (ring-poly-variable P) f)))
    (let loop ((k 1) (power x))
      (let* ((next (ef-poly-power P f power p)) (delta (r- P next x)))
        (and (or (> k (quotient m 2))
                 (= (ring-poly-degree (r-gcd P f delta)) 0))
             (if (= k m) (r-zero? P delta) (loop (+ k 1) next)))))))

(define (make-extension-field p coefficients)
  (if (not (and (ef-integer? p) (<= 2 p) (<= p 65521)))
      (error "Extension base outside exact prime profile [2,65521]"))
  (if (not (and (ef-bounded-list? coefficients 33) (>= (length coefficients) 2)))
      (error "Expected a monic modulus of degree 1..32"))
  (if (not (every ef-integer? coefficients)) (error "Modulus requires exact integer coefficients"))
  (let* ((K (make-zmod p)) (P (make-polys K)) (m (- (length coefficients) 1))
         (f (ring-poly P coefficients)) (order (expt p m)))
    (if (not (ring-ref K 'field?)) (error "Extension base is composite"))
    (if (not (and (= (ring-poly-degree f) m) (= (ring-poly-leading f) 1)))
        (error "Modulus must be monic of its declared degree"))
    (if (not (ef-irreducible? P f p m)) (error "Modulus is reducible"))
    (let* ((box (vector #f))
           (wrap (lambda (poly) (vector 'ring-element-v1 (vector-ref box 0)
                                       (ring-poly-coefficients (r-remainder P poly f)))))
           (poly (lambda (a) (ring-poly P (vector-ref a 2))))
           (member? (lambda (a)
             (and (vector? a) (= (vector-length a) 3)
                  (eq? (vector-ref a 0) 'ring-element-v1)
                  (eq? (vector-ref a 1) (vector-ref box 0))
                  (ef-bounded-list? (vector-ref a 2) m)
                  (every (lambda (c) (and (ef-integer? c) (<= 0 c) (< c p))) (vector-ref a 2))
                  (or (null? (vector-ref a 2)) (not (= (car (reverse (vector-ref a 2))) 0))))))
           (F (make-ring-carrier "finite extension field"
                'characteristic p 'field? #t 'lawful? #t 'exact? #t
                'base K 'self-locating? #t 'member? member?
                'zero #f 'one #f
                'add (lambda (a b) (wrap (r+ P (poly a) (poly b))))
                'neg (lambda (a) (wrap (r-neg P (poly a))))
                'mul (lambda (a b) (wrap (r* P (poly a) (poly b))))
                'from-integer (lambda (n) (wrap (r-int P n)))
                'constant (lambda (n) (wrap (ring-poly P (list n))))
                'equal? (lambda (a b) (equal? (vector-ref a 2) (vector-ref b 2)))
                'unit? (lambda (a) (not (null? (vector-ref a 2))))
                'inverse (lambda (a) (wrap (ef-poly-power P f (poly a) (- order 2))))
                'nilpotent? (lambda (a) (null? (vector-ref a 2)))
                'extra (list (cons 'extension-v1
                  (list p m order (ring-poly-coefficients f) P f))))))
      (vector-set! box 0 F)
      ;; The descriptor's zero/one are filled only after its identity exists.
      (vector-set! F 12 (wrap (r0 P)))
      (vector-set! F 13 (wrap (r1 P)))
      F)))

(define (extension-element F coefficients)
  (let ((m (extension-degree F)))
    (if (not (and (ef-bounded-list? coefficients m) (every ef-integer? coefficients)))
        (error "Expected at most degree exact integer coefficients"))
    (vector 'ring-element-v1 F
      (ring-poly-coefficients (ring-poly (ef-polys F) coefficients)))))
(define (extension-coefficients F a)
  (if (not (ring-member? F a)) (error "Element belongs to another field or is malformed"))
  (map (lambda (x) x) (vector-ref a 2)))
(define (extension-index->element F n)
  (if (not (and (ef-integer? n) (<= 0 n) (< n (extension-order F))))
      (error "Element index outside field"))
  (let ((p (extension-prime F)))
    (let loop ((n n) (out '()))
      (if (= n 0) (extension-element F (reverse out))
          (loop (quotient n p) (cons (modulo n p) out))))))
(define (extension-element->index F a)
  (let ((p (extension-prime F)))
    (let loop ((cs (reverse (extension-coefficients F a))) (out 0))
      (if (null? cs) out (loop (cdr cs) (+ (* p out) (car cs)))))))
(define (extension-frobenius F a . powers)
  (let ((k (if (null? powers) 1 (car powers))))
    (if (not (and (<= (length powers) 1) (ef-integer? k) (>= k 0)))
        (error "Frobenius power must be a nonnegative exact integer"))
    (r-expt F a (expt (extension-prime F) (modulo k (extension-degree F))))))
(define (extension-conjugates F a)
  (let ((start (r+ F a (r0 F))))
    (let loop ((x start) (left (extension-degree F)) (out '()))
      (if (and (pair? out) (r= F x start)) (reverse out)
          (if (= left 0) (error "Frobenius orbit failed to close")
              (loop (extension-frobenius F x) (- left 1) (cons x out)))))))
(define (extension-minimal-polynomial F a)
  (let* ((P (make-polys F)) (x (ring-poly-variable P))
         (result (let loop ((cs (extension-conjugates F a)) (out (r1 P)))
                   (if (null? cs) out
                       (loop (cdr cs) (r* P out (r- P x (ring-poly P (list (car cs))))))))))
    (map (lambda (c)
           (let ((cs (extension-coefficients F c)))
             (if (> (length cs) 1) (error "Minimal polynomial did not descend to the prime field"))
             (if (null? cs) 0 (car cs))))
         (ring-poly-coefficients result))))
