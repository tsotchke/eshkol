;;; Exact Q(zeta_n) arithmetic, shared by the cyclotomic mathematics examples.
;;; Usage: (require core.cyclotomic)
;;;
;;; Coefficients stay on the scalar exact rational tower, never native tensors.
;;; Each arithmetic result is checked: a runtime that demotes an overflowing
;;; rational to a double causes an error, never a rounded field value.
;;; Field/element vectors are opaque immutable values; public data is copied.

(require stdlib)
(require core.polynomial_exact)

(provide make-cyclotomic-field cyclotomic-order cyclotomic-degree
         cyclotomic-polynomial cyclotomic-element cyclotomic-coefficients
         cyclotomic-root cyclotomic-add cyclotomic-sub cyclotomic-scale
         cyclotomic-mul cyclotomic-inverse cyclotomic-zero? cyclotomic-equal?
         cyclotomic-rational cyclotomic-galois cyclotomic-norm)

(define (cf-exact x)
  (if (not (and (rational? x) (exact? x)))
      (error "Cyclotomic arithmetic requires an exact rational result" x))
  x)
(define (cf+ a b) (cf-exact (+ a b)))
(define (cf- a b) (cf-exact (- a b)))
(define (cf* a b) (cf-exact (* a b)))
(define (cf/ a b) (cf-exact (/ a b)))

;; One checked polynomial owner, shared with general real algebraic fields.
(define (cf-trim p) (exact-poly p))
(define (cf-zero? p) (exact-poly-zero? p))
(define (cf-at p i) (if (< i (vector-length p)) (vector-ref p i) 0))
(define (cf-poly-sub a b) (exact-poly-sub a b))
(define (cf-poly-scale p x) (exact-poly-scale p x))
(define (cf-poly-mul a b) (exact-poly-mul a b))
(define (cf-divmod a b) (exact-poly-divmod a b))

(define (cf-field-check field)
  (if (not (and (vector? field) (= (vector-length field) 3)
                (eq? (vector-ref field 0) 'eshkol-cyclotomic-field-v1)))
      (error "Expected a cyclotomic field" field)))
(define (cf-element-check value)
  (if (not (and (vector? value) (= (vector-length value) 3)
                (eq? (vector-ref value 0) 'eshkol-cyclotomic-element-v1)))
      (error "Expected a cyclotomic element" value)))
(define (cf-field value) (cf-element-check value) (vector-ref value 1))
(define (cf-coeff value) (cf-element-check value) (vector-ref value 2))
(define (cyclotomic-order value)
  (let ((field (if (and (vector? value) (= (vector-length value) 3)
                        (eq? (vector-ref value 0) 'eshkol-cyclotomic-element-v1))
                   (vector-ref value 1) value)))
    (cf-field-check field)
    (vector-ref field 1)))
(define (cyclotomic-degree field)
  (cf-field-check field)
  (- (vector-length (vector-ref field 2)) 1))
(define (cyclotomic-polynomial field)
  (cf-field-check field)
  (vector-copy (vector-ref field 2)))

;; Phi_n = (x^n - 1) / product_{d|n, d<n} Phi_d. The memo table belongs only
;; to this construction; no global field registry or implicit cross-field map.
;; The optional positive order budget defaults to 256.
(define (make-cyclotomic-field n . budget)
  (let ((limit (if (null? budget) 256 (car budget))))
    (if (not (and (<= (length budget) 1) (integer? limit) (exact? limit) (> limit 0)
                  (integer? n) (exact? n) (> n 0) (<= n limit)))
        (error "Cyclotomic order must be positive and within the explicit budget" n limit))
    (let ((memo (make-vector (+ n 1) #f)))
      (letrec ((phi
                 (lambda (order)
                   (or (vector-ref memo order)
                       (let ((numerator (make-vector (+ order 1) 0)))
                         (vector-set! numerator 0 -1)
                         (vector-set! numerator order 1)
                         (let divide ((d 1) (acc numerator))
                           (if (= d order)
                               (let ((out (cf-trim acc))) (vector-set! memo order out) out)
                               (if (= (modulo order d) 0)
                                   (let ((qr (cf-divmod acc (phi d))))
                                     (if (not (cf-zero? (cdr qr)))
                                         (error "Cyclotomic polynomial division left a remainder"))
                                     (divide (+ d 1) (car qr)))
                                   (divide (+ d 1) acc)))))))))
        (vector 'eshkol-cyclotomic-field-v1 n (phi n))))))

(define (cf-wrap field polynomial)
  (let* ((remainder (cdr (cf-divmod polynomial (vector-ref field 2))))
         (out (make-vector (cyclotomic-degree field) 0)))
    (let copy ((i 0))
      (if (< i (vector-length out))
          (begin (vector-set! out i (cf-at remainder i)) (copy (+ i 1)))))
    (vector 'eshkol-cyclotomic-element-v1 field out)))
(define (cyclotomic-element field coefficients)
  (cf-field-check field)
  (let ((values (cond ((number? coefficients) (list coefficients))
                      ((list? coefficients) coefficients)
                      ((vector? coefficients) (vector->list coefficients))
                      (else (error "Expected exact rational coefficients" coefficients)))))
    (cf-wrap field (if (null? values) (vector 0)
                      (list->vector (map cf-exact values))))))
(define (cyclotomic-coefficients value) (vector-copy (cf-coeff value)))
(define (cyclotomic-root field exponent)
  (cf-field-check field)
  (if (not (and (integer? exponent) (exact? exponent)))
      (error "Cyclotomic root exponent must be an exact integer" exponent))
  (let* ((k (modulo exponent (cyclotomic-order field))) (p (make-vector (+ k 1) 0)))
    (vector-set! p k 1)
    (cf-wrap field p)))
(define (cf-same-field a b)
  (if (not (= (cyclotomic-order (cf-field a)) (cyclotomic-order (cf-field b))))
      (error "Cyclotomic field orders differ; transport must be explicit"))
  (cf-field a))
(define (cyclotomic-add a b)
  (let* ((field (cf-same-field a b)) (av (cf-coeff a)) (bv (cf-coeff b))
         (out (make-vector (vector-length av) 0)))
    (let loop ((i 0))
      (if (< i (vector-length out))
          (begin (vector-set! out i (cf+ (vector-ref av i) (vector-ref bv i)))
                 (loop (+ i 1)))))
    (vector 'eshkol-cyclotomic-element-v1 field out)))
(define (cyclotomic-scale a scalar)
  (cf-exact scalar)
  (cf-wrap (cf-field a) (cf-poly-scale (cf-coeff a) scalar)))
(define (cyclotomic-sub a b) (cyclotomic-add a (cyclotomic-scale b -1)))
(define (cyclotomic-mul a b)
  (cf-wrap (cf-same-field a b) (cf-poly-mul (cf-coeff a) (cf-coeff b))))
(define (cyclotomic-zero? a) (cf-zero? (cf-coeff a)))
(define (cyclotomic-equal? a b)
  (cf-same-field a b)
  (let ((av (cf-coeff a)) (bv (cf-coeff b)))
    (let loop ((i 0))
      (or (= i (vector-length av))
          (and (= (vector-ref av i) (vector-ref bv i)) (loop (+ i 1)))))))
(define (cyclotomic-rational a)
  (let ((v (cf-coeff a)))
    (let loop ((i 1))
      (if (= i (vector-length v)) (vector-ref v 0)
          (and (= (vector-ref v i) 0) (loop (+ i 1)))))))

(define (cyclotomic-inverse a)
  (let ((field (cf-field a)))
    (cf-wrap field (exact-poly-inverse-mod (cf-coeff a) (vector-ref field 2)))))

(define (cf-gcd a b)
  (if (= b 0) (abs a) (cf-gcd b (modulo a b))))
(define (cyclotomic-galois a exponent)
  (let* ((field (cf-field a)) (n (cyclotomic-order field)) (v (cf-coeff a)))
    (if (not (and (integer? exponent) (exact? exponent) (= (cf-gcd exponent n) 1)))
        (error "Cyclotomic Galois exponent must be a unit modulo the order" exponent n))
    (let loop ((i 0) (out (cyclotomic-element field 0)))
      (if (= i (vector-length v)) out
          (loop (+ i 1)
                (cyclotomic-add out (cyclotomic-scale (cyclotomic-root field (* i exponent))
                                                     (vector-ref v i))))))))
(define (cyclotomic-norm a)
  (let* ((field (cf-field a)) (n (cyclotomic-order field)))
    (let loop ((r 0) (out (cyclotomic-element field 1)))
      (if (= r n)
          (let ((result (cyclotomic-rational out)))
            (if (eq? result #f) (error "Cyclotomic norm failed rational descent"))
            result)
          (loop (+ r 1) (if (= (cf-gcd r n) 1)
                            (cyclotomic-mul out (cyclotomic-galois a r)) out))))))
