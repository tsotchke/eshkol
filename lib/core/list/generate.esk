;;; core/list/generate.esk
;;; List generation functions

;;; Need length for make-list's dual-mode detection
(require core.list.query)

(provide iota iota-from iota-step repeat make-list range zip)

;;; iota: Generate a list of numbers (SRFI-1 semantics)
;;; (iota count)             => (0 1 ... count-1)
;;; (iota count start)       => (start start+1 ... start+count-1)
;;; (iota count start step)  => (start start+step ... start+(count-1)*step)
;;; start/step may be exact or inexact; exactness follows the standard
;;; numeric-tower contagion rule of +/* (any inexact argument makes the
;;; corresponding elements inexact).
;;;
;;; Uses let*/named-let rather than sequential internal (define ...) forms:
;;; the VM's compile_form_define() leaves an internal define's value on the
;;; stack and registers it as a local at that slot, but the body sequencer
;;; then emits OP_POP for every non-final body form, popping the variable's
;;; own slot out from under it (filed:
;;; tests/vm_parity/found/internal_define_then_body_form.esk). Two or more
;;; sequential internal defines hit this on every define but the last.
(define (iota count . rest)
  (let* ((start (if (pair? rest) (car rest) 0))
         (step (if (and (pair? rest) (pair? (cdr rest))) (cadr rest) 1)))
    (let loop ((n (- count 1)) (acc '()))
      (if (< n 0)
          acc
          (loop (- n 1) (cons (+ start (* n step)) acc))))))

;;; iota-from: SRFI-1 iota with an explicit start (kept as a public alias)
;;; (iota-from 5 1) => (1 2 3 4 5)
(define (iota-from count start)
  (iota count start))

;;; iota-step: SRFI-1 iota with an explicit start and step (kept as a public alias)
;;; (iota-step 5 0 2) => (0 2 4 6 8)
(define (iota-step count start step)
  (iota count start step))

;;; repeat: Create a list with n copies of x
(define (repeat n x)
  (if (<= n 0)
      '()
      (cons x (repeat (- n 1) x))))

;;; make-list: Dual-mode list constructor
;;; Mode 1 (2 args, first is positive integer): Create n copies of fill
;;;   (make-list 3 'x) => (x x x)
;;; Mode 2 (variadic): Create list from all arguments
;;;   (make-list 1 2 3) => (1 2 3)
(define (make-list . args)
  (if (and (= (length args) 2)
           (integer? (car args))
           (>= (car args) 0))
      ;; Mode 1: (make-list n fill)
      (repeat (car args) (car (cdr args)))
      ;; Mode 2: variadic
      args))

;;; range: Generate a list of numbers from start to end (exclusive)
;;; (range 0 5) => (0 1 2 3 4)
(define (range start end)
  (if (>= start end)
      '()
      (cons start (range (+ start 1) end))))

;;; zip: Combine two lists into a list of pairs
;;; (zip '(a b c) '(1 2 3)) => ((a 1) (b 2) (c 3))
(define (zip lst1 lst2)
  (if (or (null? lst1) (null? lst2))
      '()
      (cons (list (car lst1) (car lst2))
            (zip (cdr lst1) (cdr lst2)))))
