;;; Exact a-posteriori admission of received linear solves. No solver runs here.
(provide certify-linear-solve verify-linear-solve-certificate)

(define (cs-number x)
  (if (not (and (rational? x) (exact? x)))
      (error "certified solve requires exact rational data")) x)
(define (cs+ a b) (cs-number (+ a b)))
(define (cs- a b) (cs-number (- a b)))
(define (cs* a b) (cs-number (* a b)))
(define (cs/ a b) (cs-number (/ a b)))
(define (cs-vector value n nonnegative?)
  (if (not (and (vector? value) (= (vector-length value) n)))
      (error "certified solve vector shape mismatch"))
  (let ((out (make-vector n 0)))
    (let loop ((i 0)) (if (< i n)
      (let ((x (cs-number (vector-ref value i))))
        (if (and nonnegative? (< x 0)) (error "negative uncertainty radius"))
        (vector-set! out i x) (loop (+ i 1))))) out))
(define (cs-matrix value n nonnegative?)
  (if (not (and (vector? value) (= (vector-length value) n)))
      (error "certified solve matrix shape mismatch"))
  (let ((out (make-vector n #f)))
    (let loop ((i 0)) (if (< i n)
      (begin (vector-set! out i (cs-vector (vector-ref value i) n nonnegative?))
             (loop (+ i 1))))) out))
(define (cs-at matrix i j) (vector-ref (vector-ref matrix i) j))
(define (cs-tabulate n function)
  (let ((out (make-vector n 0)))
    (let loop ((i 0)) (if (< i n)
      (begin (vector-set! out i (function i)) (loop (+ i 1))))) out))
(define (cs-sum n function)
  (let loop ((i 0) (out 0))
    (if (= i n) out (loop (+ i 1) (cs+ out (function i))))))
(define (cs-max v)
  (let loop ((i 0) (out 0))
    (if (= i (vector-length v)) out (loop (+ i 1) (max out (vector-ref v i))))))

;; A,b,x,R are plain vectors (matrix rows are vectors). Optional arguments:
;; positive norm weights, nonnegative matrix radii, nonnegative RHS radii.
;; Decode received finite floats explicitly with inexact->exact. The theorem
;; then concerns those represented values; original model uncertainty is separate.
(define (certify-linear-solve matrix rhs received inverse . options)
  (if (> (length options) 3) (error "certified solve accepts at most three options"))
  (if (not (and (vector? matrix) (> (vector-length matrix) 0)
                (<= (vector-length matrix) 64)))
      (error "certified solve dimension must be 1..64"))
  (let* ((n (vector-length matrix)) (a (cs-matrix matrix n #f))
         (b (cs-vector rhs n #f)) (x (cs-vector received n #f))
         (r (cs-matrix inverse n #f))
         (w (if (null? options) (make-vector n 1) (cs-vector (car options) n #f)))
         (da (if (< (length options) 2) (cs-tabulate n (lambda (i) (make-vector n 0)))
                 (cs-matrix (cadr options) n #t)))
         (db (if (< (length options) 3) (make-vector n 0) (cs-vector (caddr options) n #t))))
    (let loop ((i 0)) (if (< i n)
      (begin (if (<= (vector-ref w i) 0) (error "norm weights must be strictly positive"))
             (loop (+ i 1)))))
    (let* ((residual (cs-tabulate n (lambda (i)
             (cs- (vector-ref b i) (cs-sum n (lambda (j) (cs* (cs-at a i j) (vector-ref x j))))))))
           (defect (cs-tabulate n (lambda (i) (cs-tabulate n (lambda (j)
             (cs- (if (= i j) 1 0) (cs-sum n (lambda (k) (cs* (cs-at r i k) (cs-at a k j))))))))))
           (forcing (cs-tabulate n (lambda (i)
             (cs+ (abs (cs-sum n (lambda (j) (cs* (cs-at r i j) (vector-ref residual j)))))
                  (cs-sum n (lambda (j) (cs* (abs (cs-at r i j))
                    (cs+ (vector-ref db j) (cs-sum n (lambda (k)
                      (cs* (cs-at da j k) (abs (vector-ref x k)))))))))))))
           (majorant (cs-tabulate n (lambda (i) (cs-tabulate n (lambda (j)
             (cs+ (abs (cs-at defect i j)) (cs-sum n (lambda (k)
               (cs* (abs (cs-at r i k)) (cs-at da k j))))))))))
           (weighted (cs-tabulate n (lambda (i) (cs-sum n (lambda (j)
             (cs* (cs-at majorant i j) (vector-ref w j)))))))
           (theta (cs-max (cs-tabulate n (lambda (i) (cs/ (vector-ref weighted i) (vector-ref w i))))))
           (eta (cs-max (cs-tabulate n (lambda (i) (cs/ (vector-ref forcing i) (vector-ref w i))))))
           (backward (cs-max (cs-tabulate n (lambda (i)
             (let ((denominator (cs+ (abs (vector-ref b i))
                     (cs-sum n (lambda (j) (cs* (abs (cs-at a i j)) (abs (vector-ref x j))))))))
               (if (= denominator 0) 0 (cs/ (abs (vector-ref residual i)) denominator)))))))
           (proved (< theta 1))
           (radii (if proved (cs-tabulate n (lambda (i)
             (cs+ (vector-ref forcing i) (cs/ (cs* (vector-ref weighted i) eta) (cs- 1 theta))))) #f))
           (boxes (if proved (cs-tabulate n (lambda (i)
             (cons (cs- (vector-ref x i) (vector-ref radii i))
                   (cs+ (vector-ref x i) (vector-ref radii i))))) #f)))
      ;; Public receipt: source copies, signed nominal defect/residual, uncertainty
      ;; majorant/forcing, norm bound and NOMINAL componentwise backward error.
      (vector 'linear-solve-certificate-v1 (if proved 'proved 'unknown) boxes
        (vector a b x r w da db residual defect majorant forcing theta backward radii)))))

;; Source-bound verification recomputes the exact admission data. No estimated
;; condition number, floating residual or opaque certificate bit is trusted.
(define (verify-linear-solve-certificate certificate matrix rhs received inverse . options)
  (guard (e (else #f))
    (and (vector? certificate) (= (vector-length certificate) 4)
         (equal? certificate (apply certify-linear-solve matrix rhs received inverse options)))))
