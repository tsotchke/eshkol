;;; Signed Clifford preparation and finite stabilizer-decoder certificates. MIT.
(require core.quantum.circuit)
(provide stabilizer-prepare verify-stabilizer-preparation
         make-qec-code qec-code-width qec-code-checks qec-syndrome qec-recovery
         qec-certificate verify-qec-certificate steane-qec shor-qec surface-d3-qec)

;; Canonical Pauli i^phase X^x Z^z. Every intermediate phase is retained.
(define (qp-all p xs) (or (null? xs) (and (p (car xs)) (qp-all p (cdr xs)))))
(define (qp-range n) (let loop ((i 0) (a '())) (if (= i n) (reverse a) (loop (+ i 1) (cons i a)))))
(define (qp-zero n) (make-vector n 0))
(define (qp-copy p) (vector (vector-ref p 0) (list->vector (vector->list (vector-ref p 1))) (list->vector (vector->list (vector-ref p 2)))))
(define (qp-x p q) (vector-ref (vector-ref p 1) q))
(define (qp-z p q) (vector-ref (vector-ref p 2) q))
(define (qp-phase! p k) (vector-set! p 0 (modulo (+ (vector-ref p 0) k) 4)))
(define (qp-parse n s)
  (if (not (and (integer? n) (exact? n) (> n 0) (string? s))) (error "Invalid Pauli width or string"))
  (let* ((prefix (if (and (> (string-length s) 0) (or (char=? (string-ref s 0) #\+) (char=? (string-ref s 0) #\-))) 1 0))
         (p (vector (if (and (= prefix 1) (char=? (string-ref s 0) #\-)) 2 0) (qp-zero n) (qp-zero n))))
    (if (not (= (string-length s) (+ n prefix))) (error "Pauli width mismatch"))
    (for-each (lambda (q)
      (let ((c (string-ref s (+ prefix q))))
        (cond ((char=? c #\I) #t)
              ((char=? c #\X) (vector-set! (vector-ref p 1) q 1))
              ((char=? c #\Z) (vector-set! (vector-ref p 2) q 1))
              ((char=? c #\Y) (vector-set! (vector-ref p 1) q 1) (vector-set! (vector-ref p 2) q 1) (qp-phase! p 1))
              (else (error "Expected Hermitian signed IXYZ Pauli"))))) (qp-range n))
    p))
(define (qp-inner n a b)
  (modulo (fold-left + 0 (map (lambda (q) (+ (* (qp-x a q) (qp-z b q)) (* (qp-z a q) (qp-x b q)))) (qp-range n))) 2))
(define (qp-mul n a b)
  (let ((p (vector (+ (vector-ref a 0) (vector-ref b 0)) (qp-zero n) (qp-zero n))))
    (for-each (lambda (q)
      (vector-set! (vector-ref p 1) q (modulo (+ (qp-x a q) (qp-x b q)) 2))
      (vector-set! (vector-ref p 2) q (modulo (+ (qp-z a q) (qp-z b q)) 2))
      (qp-phase! p (* 2 (qp-z a q) (qp-x b q)))) (qp-range n))
    (qp-phase! p 0) p))
(define (qp-support n p) (filter (lambda (q) (or (= (qp-x p q) 1) (= (qp-z p q) 1))) (qp-range n)))
(define (qp-apply! p g)
  (let* ((q (cadr g)) (x (qp-x p q)) (z (qp-z p q)))
    (case (car g)
      ((H) (qp-phase! p (* 2 x z)) (vector-set! (vector-ref p 1) q z) (vector-set! (vector-ref p 2) q x))
      ((S Sdg) (qp-phase! p (* x (if (eq? (car g) 'S) 1 3))) (vector-set! (vector-ref p 2) q (modulo (+ z x) 2)))
      ((X) (qp-phase! p (* 2 z)))
      ((Z) (qp-phase! p (* 2 x)))
      ((CNOT)
       (let ((t (caddr g)))
         (vector-set! (vector-ref p 1) t (modulo (+ (qp-x p t) x) 2))
         (vector-set! (vector-ref p 2) q (modulo (+ z (qp-z p t)) 2))))
      (else (error "Expected H/S/Sdg/X/Z/CNOT Clifford gate")))) p)
(define (qp-inverse g) (case (car g) ((S) (list 'Sdg (cadr g))) ((Sdg) (list 'S (cadr g))) (else g)))
(define (qp-checks! n strings)
  (if (not (and (integer? n) (exact? n) (> n 0) (list? strings))) (error "Expected positive width and generator list"))
  (let ((ps (map (lambda (s) (qp-parse n s)) strings)))
    (for-each (lambda (p) (for-each (lambda (q) (if (not (= (qp-inner n p q) 0)) (error "Anticommuting stabilizers"))) ps)) ps)
    ps))
;; Independent signed GF(2) elimination also rejects a derived -I.
(define (qp-basis n ps)
  (let ((basis '()))
    (for-each (lambda (original)
      (let loop ((p (qp-copy original)) (j 0))
        (if (= j (* 2 n))
            (if (not (= (vector-ref p 0) 0)) (error "Inconsistent signed stabilizer group"))
            (if (= (if (< j n) (qp-x p j) (qp-z p (- j n))) 0)
                (loop p (+ j 1))
                (let ((row (assv j basis)))
                  (if row (loop (qp-mul n p (cdr row)) (+ j 1))
                      (set! basis (cons (cons j p) basis)))))))) ps)
    basis))
;; The returned qcircuit uses the upstream chronological, MSB-first wire convention.
(define (stabilizer-prepare n strings)
  (let* ((ps (qp-checks! n strings)) (rows (list->vector ps)) (m (vector-length rows))
         (rank 0) (rev '()) (sign-gates '()))
    (define (apply-gate! g) (for-each (lambda (p) (qp-apply! p g)) (vector->list rows)) (set! rev (cons g rev)))
    (qp-basis n ps)
    (let loop ()
      (let ((candidate (let find ((i rank))
        (cond ((= i m) #f) ((pair? (qp-support n (vector-ref rows i))) i) (else (find (+ i 1)))))))
        (if candidate
            (begin
              (let ((old (vector-ref rows rank))) (vector-set! rows rank (vector-ref rows candidate)) (vector-set! rows candidate old))
              (let* ((p (vector-ref rows rank)) (support (qp-support n p)) (pivot (car support)))
                (for-each (lambda (q)
                  (cond ((= (qp-x p q) 0) (apply-gate! (list 'H q)))
                        ((= (qp-z p q) 1) (apply-gate! (list 'S q))))) support)
                (for-each (lambda (q) (apply-gate! (list 'CNOT pivot q))) (cdr support))
                (apply-gate! (list 'H pivot))
                (if (= (vector-ref p 0) 2) (set! sign-gates (cons (list 'X pivot) sign-gates)))
                (let clear ((i (+ rank 1)))
                  (if (< i m) (begin
                    (if (= (qp-z (vector-ref rows i) pivot) 1) (vector-set! rows i (qp-mul n p (vector-ref rows i))))
                    (clear (+ i 1)))))
                (set! rank (+ rank 1)) (loop))))))
    (let ((c (make-qcircuit n (append (reverse sign-gates) (map qp-inverse rev)))))
      (if (not (verify-stabilizer-preparation n strings c)) (error "Clifford preparation replay failed")) c)))
(define (verify-stabilizer-preparation n strings circuit)
  (guard (e (else #f))
    (and (qcircuit? circuit) (= (qcircuit-width circuit) n) (qcircuit-validate circuit)
      (let ((ps (qp-checks! n strings)) (gs (map qp-inverse (reverse (qcircuit-gates circuit)))))
        (qp-all (lambda (p)
          (for-each (lambda (g) (qp-apply! p g)) gs)
          (and (= (vector-ref p 0) 0) (qp-all (lambda (x) (= x 0)) (vector->list (vector-ref p 1))))) ps)))))
(define (qp-error-strings n)
  (apply append (map (lambda (q) (map (lambda (c)
    (list->string (map (lambda (i) (if (= i q) c #\I)) (qp-range n)))) (list #\X #\Y #\Z))) (qp-range n))))
(define (qp-syndrome n checks e) (map (lambda (g) (qp-inner n g e)) checks))
(define (qec-code-width c) (vector-ref c 1))
(define (qec-code-checks c) (map (lambda (s) (list->string (string->list s))) (vector-ref c 2)))
(define (make-qec-code n strings)
  (let* ((owned (map (lambda (s) (list->string (string->list s))) strings))
         (ps (qp-checks! n owned)) (identity (make-string n #\I))
         (table (list (list (map (lambda (p) 0) ps) identity))))
    (qp-basis n ps)
    (for-each (lambda (s)
      (let ((key (qp-syndrome n ps (qp-parse n s))))
        (if (not (assoc key table)) (set! table (append table (list (list key s))))))) (qp-error-strings n))
    (vector 'qec-code-v1 n owned table)))
(define (qec-syndrome code error)
  (let ((n (qec-code-width code))) (qp-syndrome n (qp-checks! n (vector-ref code 2)) (qp-parse n error))))
(define (qec-recovery code syndrome)
  (let ((row (assoc syndrome (vector-ref code 3)))) (if row (cadr row) #f)))
(define (qec-certificate code)
  (vector 'qec-decoder-v1 (qec-code-width code) (qec-code-checks code)
    (map (lambda (r) (list (map (lambda (x) x) (car r)) (list->string (string->list (cadr r))))) (vector-ref code 3))))
;; Includes identity and every weight-one X/Y/Z error. A certificate cannot
;; shorten that quantified domain or replace the requested source code.
(define (verify-qec-certificate cert n strings)
  (guard (e (else #f))
    (and (vector? cert) (= (vector-length cert) 4) (eq? (vector-ref cert 0) 'qec-decoder-v1)
         (integer? (vector-ref cert 1)) (exact? (vector-ref cert 1)) (= (vector-ref cert 1) n) (equal? (vector-ref cert 2) strings)
         (list? (vector-ref cert 3))
         (let* ((ps (qp-checks! n strings)) (basis (qp-basis n ps)) (table (vector-ref cert 3))
                (identity (make-string n #\I)))
           (and
             (let valid ((ts table))
               (or (null? ts)
                 (and (list? (car ts)) (= (length (car ts)) 2) (list? (caar ts))
                   (= (length (caar ts)) (length strings)) (qp-all (lambda (b) (and (integer? b) (exact? b) (or (= b 0) (= b 1)))) (caar ts))
                   (not (assoc (caar ts) (cdr ts))) (qp-parse n (cadar ts)) (valid (cdr ts)))))
             (qp-all (lambda (s)
               (let* ((e (qp-parse n s)) (syndrome (qp-syndrome n ps e)) (row (assoc syndrome table)))
                 (and row
                   (let ((p (qp-mul n (qp-parse n (cadr row)) e)))
                     ;; Phase is physically irrelevant for error recovery.
                     (let loop ((j 0))
                       (if (= j (* 2 n)) #t
                           (if (= (if (< j n) (qp-x p j) (qp-z p (- j n))) 0) (loop (+ j 1))
                               (let ((b (assv j basis)))
                                 (and b (begin (set! p (qp-mul n p (cdr b))) (loop (+ j 1))))))))))))
               (cons identity (qp-error-strings n))))))))
(define (steane-qec) (make-qec-code 7 '("IIIXXXX" "IXXIIXX" "XIXIXIX" "IIIZZZZ" "IZZIIZZ" "ZIZIZIZ")))
(define (shor-qec) (make-qec-code 9 '("ZZIIIIIII" "IZZIIIIII" "IIIZZIIII" "IIIIZZIII" "IIIIIIZZI" "IIIIIIIZZ" "XXXXXXIII" "IIIXXXXXX")))
(define (surface-d3-qec) (make-qec-code 9 '("ZZIZZIIII" "IIIIZZIZZ" "IXXIXXIII" "IIIXXIXXI" "XXIIIIIII" "IIIIIIIXX" "IIZIIZIII" "IIIZIIZII")))
