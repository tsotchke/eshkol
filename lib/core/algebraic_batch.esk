;;; Packed rational coordinates, certified i32 bounds, native integer loops.
(require core.algebraic_domain)
(provide make-algebraic-multiplication-plan algebraic-batch-mul)

(define (ab-i32 value)
  (if (not (and (integer? value) (exact? value) (>= value -2147483648) (<= value 2147483647)))
      (error "Packed algebraic integer exceeds signed-32-bit admission")) value)
(define (ab-components domain)
  (* (algebraic-domain-ref domain 'dimension)
     (if (algebraic-domain-ref domain 'parent) (ab-components (algebraic-domain-ref domain 'parent)) 1)))
(define (ab-coordinates domain value)
  (let* ((cells ((algebraic-domain-ref domain 'coefficients) value))
         (parent (algebraic-domain-ref domain 'parent)))
    (if (not parent) cells
      (let* ((width (ab-components parent)) (out (make-vector (* (vector-length cells) width) 0)))
        (let coefficients ((i 0)) (if (< i (vector-length cells))
          (let ((part (ab-coordinates parent (vector-ref cells i))))
            (let copy ((j 0)) (if (< j width)
              (begin (vector-set! out (+ (* i width) j) (vector-ref part j)) (copy (+ j 1)))))
            (coefficients (+ i 1))))) out))))
(define (ab-element domain coordinates)
  (let ((parent (algebraic-domain-ref domain 'parent)))
    (if (not parent) ((algebraic-domain-ref domain 'element) coordinates)
      (let* ((width (ab-components parent)) (n (algebraic-domain-ref domain 'dimension)) (cells (make-vector n #f)))
        (let coefficients ((i 0)) (if (< i n)
          (let ((part (make-vector width 0)))
            (let copy ((j 0)) (if (< j width)
              (begin (vector-set! part j (vector-ref coordinates (+ (* i width) j))) (copy (+ j 1)))))
            (vector-set! cells i (ab-element parent part)) (coefficients (+ i 1)))))
        ((algebraic-domain-ref domain 'element) cells)))))
(define (ab-product-index kind i j n)
  (if (eq? kind 'taylor) (if (< (+ i j) n) (+ i j) -1)
      (cond ((= i 0) j) ((= j 0) i) ((= (+ i j) 3) 3) (else -1))))
(define (ab-table domain)
  (let* ((parent (algebraic-domain-ref domain 'parent)) (n (algebraic-domain-ref domain 'dimension))
         (terms '()) (count 0))
    (define (emit i j k coefficient)
      (ab-i32 coefficient)
      (if (>= count 8192) (error "Packed multiplication table exceeds 8192 terms"))
      (set! terms (cons (vector i j k coefficient) terms)) (set! count (+ count 1)))
    (if parent
      (let* ((width (ab-components parent)) (table (ab-table parent)) (kind (algebraic-domain-ref domain 'kind)))
        (let left ((i 0)) (if (< i n)
          (begin (let right ((j 0)) (if (< j n)
            (let ((k (ab-product-index kind i j n)))
              (if (>= k 0)
                (let entries ((t 0)) (if (< t (vector-length table))
                  (let ((term (vector-ref table t)))
                    (emit (+ (* i width) (vector-ref term 0)) (+ (* j width) (vector-ref term 1))
                          (+ (* k width) (vector-ref term 2)) (vector-ref term 3)) (entries (+ t 1))))))
              (right (+ j 1))))) (left (+ i 1))))))
      (let ((basis (make-vector n #f)) (mul (algebraic-domain-ref domain 'mul))
            (element (algebraic-domain-ref domain 'element)) (observe (algebraic-domain-ref domain 'coefficients)))
        (let init ((i 0)) (if (< i n)
          (let ((cells (make-vector n 0))) (vector-set! cells i 1)
            (vector-set! basis i (element cells)) (init (+ i 1)))))
        (let left ((i 0)) (if (< i n)
          (begin (let right ((j 0)) (if (< j n)
            (let ((cells (observe (mul (vector-ref basis i) (vector-ref basis j)))))
              (let outputs ((k 0)) (if (< k n)
                (begin (if (not (= (vector-ref cells k) 0)) (emit i j k (vector-ref cells k))) (outputs (+ k 1)))))
              (right (+ j 1))))) (left (+ i 1)))))))
    (list->vector (reverse terms))))
(define (make-algebraic-multiplication-plan owner . options)
  (let* ((domain (algebraic-domain owner)) (components (ab-components domain))
         (budget (if (null? options) 64 (car options))))
    (if (not (and (<= (length options) 1) (integer? budget) (exact? budget) (>= budget 1) (<= budget 64)))
        (error "Packed component budget must be an exact integer from 1 through 64"))
    (if (> components budget) (error "Packed algebraic domain exceeds its component budget"))
    (vector 'algebraic-multiplication-plan-v1 domain components (ab-table domain))))
(define (ab-pack domain value)
  (let* ((coordinates (ab-coordinates domain value)) (n (vector-length coordinates))
         (denominator-common (let loop ((i 0) (d 1))
           (if (= i n) d
             (let ((next (denominator (vector-ref coordinates i))))
               (loop (+ i 1) (ab-i32 (quotient (* d next) (gcd d next))))))))
         (out (make-vector n 0)))
    (let coefficients ((i 0)) (if (< i n)
      (let ((q (vector-ref coordinates i)))
        (vector-set! out i (ab-i32 (* (numerator q) (quotient denominator-common (denominator q)))))
        (coefficients (+ i 1)))))
    (vector out denominator-common)))
(define (ab-kernel table components packed)
  ;; Called only after admission for the entire batch. The native JIT/AOT
  ;; executes integer multiply/accumulate; there is no field reduction here.
  (let ((outputs (make-vector (vector-length packed) #f)))
    (let batches ((b 0)) (if (< b (vector-length packed))
      (let* ((pair (vector-ref packed b)) (left (vector-ref pair 0)) (right (vector-ref pair 1))
             (out (make-vector components 0)))
        (let terms ((t 0)) (if (< t (vector-length table))
          (let* ((term (vector-ref table t)) (k (vector-ref term 2)))
            (vector-set! out k (+ (vector-ref out k)
              (* (vector-ref term 3) (* (vector-ref left (vector-ref term 0)) (vector-ref right (vector-ref term 1))))))
            (terms (+ t 1)))))
        (vector-set! outputs b out) (batches (+ b 1))))) outputs))
(define (algebraic-batch-mul plan left right)
  (if (not (and (vector? plan) (= (vector-length plan) 4)
                (eq? (vector-ref plan 0) 'algebraic-multiplication-plan-v1)))
      (error "Expected a packed algebraic multiplication plan"))
  (if (not (and (vector? left) (vector? right) (= (vector-length left) (vector-length right))
                (<= (vector-length left) 4096))) (error "Packed batches require equal lengths at most 4096"))
  (let* ((domain (vector-ref plan 1)) (components (vector-ref plan 2)) (table (vector-ref plan 3))
         (n (vector-length left)) (packed (make-vector n #f)) (denominators (make-vector n 1)) (maximum 0))
    ;; Absolute-term bounds certify every product and every accumulation in
    ;; any order, before executing even the first admitted batch item.
    (let batches ((b 0)) (if (< b n)
      (let* ((a (ab-pack domain (vector-ref left b))) (c (ab-pack domain (vector-ref right b)))
             (av (vector-ref a 0)) (cv (vector-ref c 0)) (bounds (make-vector components 0)))
        (vector-set! denominators b (ab-i32 (* (vector-ref a 1) (vector-ref c 1))))
        (let terms ((t 0)) (if (< t (vector-length table))
          (let* ((term (vector-ref table t)) (k (vector-ref term 2))
                 (bound (ab-i32 (+ (vector-ref bounds k)
                   (* (abs (vector-ref term 3)) (abs (vector-ref av (vector-ref term 0)))
                      (abs (vector-ref cv (vector-ref term 1))))))))
            (vector-set! bounds k bound) (set! maximum (max maximum bound)) (terms (+ t 1)))))
        (vector-set! packed b (vector av cv)) (batches (+ b 1)))))
    (let* ((integers (if (= n 0) (vector) (ab-kernel table components packed))) (outputs (make-vector n #f)))
      (let batches ((b 0)) (if (< b n)
        (let ((coordinates (make-vector components 0)))
          (let cells ((i 0)) (if (< i components)
            (begin (vector-set! coordinates i (/ (vector-ref (vector-ref integers b) i) (vector-ref denominators b)))
                   (cells (+ i 1)))))
          (vector-set! outputs b (ab-element domain coordinates)) (batches (+ b 1)))))
      (vector outputs (vector 'native-scheme-integer n components (vector-length table) maximum
                              (* n (vector-length table)) (if (= n 0) 0 1))))))
