;;; Differentiable proposals for the bounded SBLC verifier (ADR-0017).
(require core.blc)
(require core.sblc)
(require core.ml.gradient_estimators)

(provide sblc-relax-enumerated-domain sblc-relax-program-domain sblc-relax-grammar-domain
         sblc-relax-sample sblc-relax-exact-oracle sblc-relax-exact-expectation
         sblc-relax-exact-gradient sblc-relax-exact-ad-gradient sblc-relax-reinforce-rb
         sblc-relax-gumbel-grammar sblc-relax-project-strict sblc-relax-grammar-step
         sblc-relax-verify-invariance sblc-relax-optimize-logits
         sblc-relax-receipt? sblc-relax-receipt-version sblc-relax-receipt-method
         sblc-relax-receipt-exact? sblc-relax-receipt-status sblc-relax-receipt-expected-reward
         sblc-relax-receipt-gradient sblc-relax-receipt-variance-stats
         sblc-relax-receipt-baseline-variance sblc-relax-receipt-post-rb-variance
         sblc-relax-receipt-variance-reduction-ratio sblc-relax-receipt-variance-bound
         sblc-relax-receipt-confidence sblc-relax-receipt-sample-count
         sblc-relax-receipt-projection-residual sblc-relax-receipt-error-detail
         sblc-relax-receipt-candidates sblc-relax-receipt-best sblc-relax-receipt->string
         sblc-relax-candidate-term sblc-relax-candidate-bits sblc-relax-candidate-prior
         sblc-relax-candidate-likelihood sblc-relax-candidate-weight
         sblc-relax-candidate-probability sblc-relax-candidate-verified?)

(define (sblc-relax-opt opts key fallback)
  (let ((entry (assq key opts))) (if entry (cdr entry) fallback)))
(define (sblc-relax-integer? x) (and (integer? x) (exact? x)))
(define (sblc-relax-real? x) (and (real? x) (finite? (exact->inexact x))))
(define (sblc-relax-enumerated-domain limit examples bound)
  (vector 'enumerated limit examples bound))
(define (sblc-relax-program-domain terms examples bound)
  (vector 'programs terms examples bound))
(define (sblc-relax-grammar-domain depth examples bound)
  (vector 'grammar depth examples bound))

(define (sblc-relax-programs domain)
  (if (eq? (vector-ref domain 0) 'programs) (vector-ref domain 1)
      (let loop ((i (vector-ref domain 1)) (terms '()))
        (if (< i 4) terms
            (loop (- i 1) (append (sblc-enumerate-closed i) terms))))))

(define (sblc-relax-receipt? r)
  (and (vector? r) (= (vector-length r) 11)
       (eq? (vector-ref r 0) 'sblc-relax-receipt-v1)))
(define (sblc-relax-receipt-version r) (vector-ref r 0))
(define (sblc-relax-receipt-method r) (vector-ref r 1))
(define (sblc-relax-receipt-exact? r) (vector-ref r 2))
(define (sblc-relax-receipt-status r) (vector-ref r 3))
(define (sblc-relax-receipt-expected-reward r) (vector-ref r 4))
(define (sblc-relax-receipt-gradient r) (vector-ref r 5))
(define (sblc-relax-receipt-variance-stats r) (vector-ref r 6))
(define (sblc-relax-receipt-projection-residual r) (vector-ref r 7))
(define (sblc-relax-receipt-error-detail r) (vector-ref r 8))
(define (sblc-relax-receipt-candidates r) (vector-ref r 9))
(define (sblc-relax-receipt-best r) (vector-ref r 10))
(define (sblc-relax-stat r key) (cdr (assq key (sblc-relax-receipt-variance-stats r))))
(define (sblc-relax-receipt-baseline-variance r) (sblc-relax-stat r 'baseline-variance))
(define (sblc-relax-receipt-post-rb-variance r) (sblc-relax-stat r 'post-rb-variance))
(define (sblc-relax-receipt-variance-reduction-ratio r) (sblc-relax-stat r 'variance-reduction-ratio))
(define (sblc-relax-receipt-variance-bound r) (sblc-relax-stat r 'variance-bound))
(define (sblc-relax-receipt-confidence r) (sblc-relax-stat r 'confidence))
(define (sblc-relax-receipt-sample-count r) (sblc-relax-stat r 'sample-count))
(define (sblc-relax-stats naive rb ratio bound confidence n)
  (list (cons 'baseline-variance naive) (cons 'post-rb-variance rb)
        (cons 'variance-reduction-ratio ratio) (cons 'variance-bound bound)
        (cons 'confidence confidence) (cons 'sample-count n)))

(define (sblc-relax-receipt->string receipt)
  (let ((port (open-output-string))) (write receipt port) (get-output-string port)))
(define (sblc-relax-error method status detail residual n)
  (vector 'sblc-relax-receipt-v1 method #f status #f (make-vector n 0.0)
          (sblc-relax-stats #f #f #f #f 'unavailable 0) residual detail '() #f))

(define (sblc-relax-candidate-term e) (vector-ref e 0))
(define (sblc-relax-candidate-bits e) (vector-ref e 1))
(define (sblc-relax-candidate-prior e) (vector-ref e 2))
(define (sblc-relax-candidate-likelihood e) (vector-ref e 3))
(define (sblc-relax-candidate-weight e) (vector-ref e 4))
(define (sblc-relax-candidate-probability e) (vector-ref e 5))
(define (sblc-relax-candidate-verified? e) (vector-ref e 6))

(define (sblc-relax-valid-term? term)
  (and (sblc-term? term) (sblc-closed? term)
       (equal? term (sblc-decode (sblc-encode term)))))
(define (sblc-relax-candidate term probability domain)
  (if (not (sblc-relax-valid-term? term)) (error "Invalid SBLC candidate"))
  (let ((prior (sblc-weight term)) (bound (vector-ref domain 3)))
    (let loop ((xs (vector-ref domain 2)) (mass 1))
      (if (null? xs)
          (let ((weight (* prior mass)))
            (if (and (exact? prior) (> prior 0) (exact? mass) (exact? weight))
                (vector term (sblc-encode term) prior mass weight probability #t)
                (error "Verifier weights must be exact")))
          (loop (cdr xs) (* mass (car (sblc-likelihood term (car xs) bound))))))))

;; Best is the verified MDL witness. Ties use the core catalogue order.
(define (sblc-relax-better? a b)
  (let ((wa (sblc-relax-candidate-weight a)) (wb (sblc-relax-candidate-weight b))
        (sa (sblc-relax-candidate-bits a)) (sb (sblc-relax-candidate-bits b)))
    (or (> wa wb)
        (and (= wa wb)
             (or (< (string-length sa) (string-length sb))
                 (and (= (string-length sa) (string-length sb)) (string<? sa sb)))))))
(define (sblc-relax-ok method reward grad stats residual entries)
  (let loop ((xs entries) (best #f))
    (if (null? xs)
        (vector 'sblc-relax-receipt-v1 method (eq? method 'exact-oracle) 'ok
                reward grad stats residual #f entries best)
        (loop (cdr xs) (if (or (not best) (sblc-relax-better? (car xs) best)) (car xs) best)))))

(define (sblc-relax-reward entry mass opts)
  (let* ((mode (sblc-relax-opt opts 'reward-mode 'likelihood))
         (prior (sblc-relax-candidate-prior entry))
         (value (cond ((eq? mode 'likelihood) mass)
                      ((eq? mode 'mdl) (* prior mass))
                      (else (let ((f (sblc-relax-opt opts 'reward-fn #f)))
                              (f (sblc-relax-candidate-term entry) mass prior))))))
    (if (sblc-relax-real? value) (exact->inexact value) (error "Expected a finite reward"))))

(define (sblc-relax-dot a b)
  (let loop ((i 0) (v 0.0))
    (if (= i (vector-length b)) v
        (loop (+ i 1) (+ v (* (vector-ref a i) (vector-ref b i)))))))
(define (sblc-relax-catalogue terms q domain opts)
  (let ((values (make-vector (length terms) 0.0)))
    (let loop ((xs terms) (i 0) (entries '()))
      (if (null? xs) (list (reverse entries) values)
          (let ((e (sblc-relax-candidate (car xs) (vector-ref q i) domain)))
            (vector-set! values i (sblc-relax-reward e (sblc-relax-candidate-likelihood e) opts))
            (loop (cdr xs) (+ i 1) (cons e entries)))))))

(define (sblc-relax-oracle domain logits opts terms)
  (let* ((q (softmax logits)) (table (sblc-relax-catalogue terms q domain opts))
         (rewards (cadr table)))
    (sblc-relax-ok 'exact-oracle (sblc-relax-dot q rewards)
                   (categorical-expectation-gradient logits rewards)
                   (sblc-relax-stats 0.0 0.0 1.0 0.0 'exact-zero-variance 0)
                   0.0 (car table))))
(define (sblc-relax-exact-oracle domain logits opts)
  (sblc-relax-sample domain 'exact-oracle logits opts))
(define (sblc-relax-require-oracle domain logits opts)
  (let ((receipt (sblc-relax-exact-oracle domain logits opts)))
    (if (sblc-relax-receipt-exact? receipt) receipt
        (error "Exact oracle unavailable" (sblc-relax-receipt-error-detail receipt)))))
(define (sblc-relax-exact-expectation domain logits opts)
  (sblc-relax-receipt-expected-reward (sblc-relax-require-oracle domain logits opts)))
(define (sblc-relax-exact-gradient domain logits opts)
  (sblc-relax-receipt-gradient (sblc-relax-require-oracle domain logits opts)))
(define (sblc-relax-exact-ad-gradient domain logits opts)
  (let* ((terms (sblc-relax-admit domain 'exact-oracle logits opts))
         (table (sblc-relax-catalogue terms (softmax logits) domain opts))
         (values (cadr table)) (zeros (make-vector (vector-length logits) 0.0)))
    (if (sblc-relax-constraint-error (car table) opts 'exact-oracle (vector-length logits))
        (error "Exact catalogue violates hard constraint"))
    (gradient (lambda (l) (sblc-relax-dot (gumbel-softmax-relaxed l zeros 1.0) values)) logits)))

;; A draw matches only if every independent example normalizes to its target.
(define (sblc-relax-match prng term examples bound)
  (let loop ((xs examples) (match 1))
    (if (null? xs) match
        (let ((run (sblc-sample-prng prng (blc-app term (caar xs)) bound)))
          (loop (cdr xs) (if (and (eq? (sblc-run-status run) 'normal)
                                  (equal? (sblc-run-term run) (cdar xs))) match 0))))))
(define (sblc-relax-noisy prng entry domain opts trials rb)
  (let loop ((i 0) (hits 0))
    (if (= i trials)
        ;; For nonlinear custom rewards the centered Bernoulli innovation keeps
        ;; E[noisy | term] = reward(term, likelihood, prior). For likelihood and
        ;; MDL this reduces to the empirical match rate and its prior multiple.
        (let ((rate (/ hits trials)) (mass (sblc-relax-candidate-likelihood entry)))
          (+ rb (* (exact->inexact (- rate mass))
                   (- (sblc-relax-reward entry 1 opts) (sblc-relax-reward entry 0 opts)))))
        (loop (+ i 1) (+ hits (sblc-relax-match prng (sblc-relax-candidate-term entry)
                                               (vector-ref domain 2) (vector-ref domain 3)))))))
(define (sblc-relax-centered r total count mode)
  (cond ((eq? mode 'none) r)
        ((eq? mode 'mean) (- r (/ total count)))
        ((= count 1) r)
        (else (- r (/ (- total r) (- count 1))))))

;; Welford mean vector and sum of squared Euclidean deviations.
(define (sblc-relax-observe! mean grad count)
  (let loop ((j 0) (m2 0.0))
    (if (= j (vector-length mean)) m2
        (let* ((x (vector-ref grad j)) (old (vector-ref mean j))
               (delta (- x old)) (next (+ old (/ delta count))))
          (vector-set! mean j next)
          (loop (+ j 1) (+ m2 (* delta (- x next))))))))
(define (sblc-relax-range-bound values n mode)
  ;; Efron-Stein: replacing one draw changes its own centered score by at
  ;; most 2 sqrt(2) range, and all other LOO scores by sqrt(2) range in total.
  (let loop ((i 0) (lo (vector-ref values 0)) (hi (vector-ref values 0)))
    (if (= i (vector-length values))
        (let ((span (if (or (eq? mode 'none) (= n 1)) (max (abs lo) (abs hi)) (- hi lo))))
          (/ (* 9.0 span span) n))
        (loop (+ i 1) (min lo (vector-ref values i)) (max hi (vector-ref values i))))))

(define (sblc-relax-rb domain logits opts terms)
  (let* ((n (sblc-relax-opt opts 'samples 64)) (width (vector-length logits))
         (prng (make-prng (sblc-relax-opt opts 'seed 42)))
         (mode (sblc-relax-opt opts 'baseline-mode 'loo))
         (trials (sblc-relax-opt opts 'inner-coin-trials 1))
         (q (softmax logits)) (programs (list->vector terms))
         ;; Custom rewards have no declared range. Evaluate their finite range
         ;; for the bound. Likelihood and MDL rewards always lie in [0,1].
         (custom (and (eq? (sblc-relax-opt opts 'reward-mode 'likelihood) 'custom)
                      (sblc-relax-catalogue terms q domain opts)))
         (entries (if custom (list->vector (car custom)) (make-vector width #f)))
         (values (if custom (cadr custom) (make-vector width 0.0)))
         (bound (if custom (sblc-relax-range-bound values n mode) (/ 9.0 n)))
         (seen (make-vector width #f))
         (mean-rb (make-vector width 0.0)) (mean-naive (make-vector width 0.0)))
    (let draw ((i 0) (rows '()) (rb-total 0.0) (noisy-total 0.0) (verified '()))
      (if (< i n)
          (let* ((k (gumbel-max-sample logits (sample-gumbel-noise width prng)))
                 (cached (vector-ref entries k))
                 (e (if cached cached (sblc-relax-candidate (vector-ref programs k) (vector-ref q k) domain)))
                 (r (if cached (vector-ref values k) (sblc-relax-reward e (sblc-relax-candidate-likelihood e) opts)))
                 (noisy (sblc-relax-noisy prng e domain opts trials r))
                 (next (if (vector-ref seen k) verified (cons e verified))))
            (vector-set! entries k e)
            (vector-set! values k r)
            (vector-set! seen k #t)
            (draw (+ i 1) (cons (list k r noisy) rows) (+ rb-total r) (+ noisy-total noisy) next))
          (let measure ((xs rows) (count 1) (rb-m2 0.0) (naive-m2 0.0))
            (if (pair? xs)
                (let* ((row (car xs)) (k (car row))
                       (rg (score-function-gradient logits k (sblc-relax-centered (cadr row) rb-total n mode)))
                       (ng (score-function-gradient logits k (sblc-relax-centered (caddr row) noisy-total n mode)))
                       (rd (sblc-relax-observe! mean-rb rg count))
                       (nd (sblc-relax-observe! mean-naive ng count)))
                  (measure (cdr xs) (+ count 1) (+ rb-m2 rd) (+ naive-m2 nd)))
                (let* ((post (/ rb-m2 (max 1 (- n 1)))) (base (/ naive-m2 (max 1 (- n 1))))
                       (ratio (if (> base 0.0) (- 1.0 (/ post base)) (if (= post 0.0) 1.0 0.0)))
                       (confidence (cond ((= post 0.0) 'exact-zero-variance)
                                         ((and (> base 0.0)
                                               (< ratio (sblc-relax-opt opts 'confidence-threshold 0.5)))
                                          'low-confidence)
                                         (else 'high))))
                  (sblc-relax-ok 'reinforce-rb (/ rb-total n) mean-rb
                      (sblc-relax-stats base post ratio bound confidence n)
                      0.0 (reverse verified)))))))))
(define (sblc-relax-reinforce-rb domain logits opts)
  (sblc-relax-sample domain 'reinforce-rb logits opts))

;; Every legal set is a contiguous slice, so compacting the mask gives illegal
;; choices exactly zero mass even when legal logits are extremely negative.
(define (sblc-relax-slice l start n)
  (let ((out (make-vector n 0.0)))
    (let loop ((i 0))
      (if (= i n) out
          (begin (vector-set! out i (vector-ref l (+ start i))) (loop (+ i 1)))))))
(define (sblc-relax-l1 soft hard)
  (let loop ((i 0) (v 0.0))
    (if (= i (vector-length soft)) v
        (loop (+ i 1) (+ v (abs (- (vector-ref soft i) (vector-ref hard i))))))))
;; A trace carries the term, L1 residual, hard-path probability and AD sites.
(define (sblc-relax-site logits start count tau prng)
  (let* ((local (sblc-relax-slice logits start count)) (noise (sample-gumbel-noise count prng))
         (soft (gumbel-softmax-relaxed local noise tau)) (hard (gumbel-softmax-st local noise tau))
         (k (gumbel-max-sample local noise)))
    (vector (+ start k) (sblc-relax-l1 soft hard) (vector-ref (softmax local) k)
            (list (list start count noise k)))))
(define (sblc-relax-combine term a b)
  (vector term (+ (vector-ref a 1) (vector-ref b 1)) (* (vector-ref a 2) (vector-ref b 2))
          (append (vector-ref a 3) (vector-ref b 3))))
(define (sblc-relax-expand logits env depth tau prng)
  (if (and (= env 0) (= depth 0))
      ;; Missing one unit of required one-hot mass at an empty mask.
      (vector #f 1.0 0.0 '())
      (let* ((start (if (= env 0) 1 0)) (count (if (= depth 0) 1 (- 4 start)))
             (site (sblc-relax-site logits start count tau prng)) (op (vector-ref site 0)))
        (cond ((= op 0)
               (let ((idx (sblc-relax-site logits 4 (min env (- (vector-length logits) 4)) tau prng)))
                 (sblc-relax-combine (blc-var (- (vector-ref idx 0) 3)) site idx)))
              ((= op 1)
               (let* ((body (sblc-relax-expand logits (+ env 1) (- depth 1) tau prng))
                      (term (vector-ref body 0)))
                 (sblc-relax-combine (and term (blc-lam term)) site body)))
              (else
               (let* ((left (sblc-relax-expand logits env (- depth 1) tau prng))
                      (a (vector-ref left 0)) (partial (sblc-relax-combine a site left)))
                 (if (not a) partial
                     (let* ((right (sblc-relax-expand logits env (- depth 1) tau prng))
                            (b (vector-ref right 0)))
                       (sblc-relax-combine
                         (and b (if (= op 2) (blc-app a b) (sblc-choice a b))) partial right)))))))))

(define (sblc-relax-logits? logits)
  (and (vector? logits)
       (let loop ((i 0))
         (or (= i (vector-length logits))
             (and (sblc-relax-real? (vector-ref logits i)) (loop (+ i 1)))))))
(define (sblc-relax-grammar-step logits env depth tau prng)
  (if (not (and (sblc-relax-logits? logits) (>= (vector-length logits) 5)
                (sblc-relax-integer? env) (>= env 0) (sblc-relax-integer? depth) (>= depth 0)
                (sblc-relax-real? tau) (> tau 0) (prng? prng)))
      (error "Expected grammar logits, nonnegative depths, positive temperature and an isolated PRNG"))
  (sblc-relax-expand logits env depth tau prng))

;; On success return the original term. A rejected deterministic projection
;; with zero soft distance has unit residual for the unsatisfied constraint.
(define (sblc-relax-project-strict term constraint residual)
  (let ((detail
          (guard (ex (else 'invalid-projection))
            (cond ((not (sblc-term? term)) 'invalid-term)
                  ((not (sblc-closed? term)) 'open-term)
                  ((not (equal? term (sblc-decode (sblc-encode term)))) 'codec-mismatch)
                  ((and constraint (not (constraint term))) 'constraint-rejected)
                  (else #f)))))
    (if detail (sblc-relax-error 'gumbel-softmax 'projection-error detail
                                  (if (> residual 0.0) residual 1.0) 0)
        term)))

;; Multilinear surrogate for the observed hard path: reward times the product
;; of selected straight-through coordinates. Noise and verifier outcomes stay
;; constant during differentiation. Shared logits accumulate across all sites.
(define (sblc-relax-path-value l sites tau reward)
  (let loop ((xs sites) (v reward))
    (if (null? xs) v
        (let* ((site (car xs)) (sub (sblc-relax-slice l (car site) (cadr site)))
               (hard (gumbel-softmax-st sub (caddr site) tau)))
          (loop (cdr xs) (* v (vector-ref hard (list-ref site 3))))))))
(define (sblc-relax-grammar domain logits opts)
  (let* ((n (sblc-relax-opt opts 'samples 64)) (tau (sblc-relax-opt opts 'tau 0.5))
         (prng (make-prng (sblc-relax-opt opts 'seed 42))) (constraint (sblc-relax-opt opts 'constraint #f))
         (mean (make-vector (vector-length logits) 0.0)))
    (let loop ((i 0) (reward 0.0) (residual 0.0) (entries '()) (seen '()))
      (if (= i n)
          (sblc-relax-ok 'gumbel-softmax (/ reward n) mean
                         (sblc-relax-stats #f #f #f #f 'surrogate n) residual (reverse entries))
          (let* ((trace (sblc-relax-expand logits 0 (vector-ref domain 1) tau prng))
                 (dist (+ residual (vector-ref trace 1)))
                 (term (sblc-relax-project-strict (vector-ref trace 0) constraint dist)))
            (if (sblc-relax-receipt? term)
                (sblc-relax-error 'gumbel-softmax 'projection-error (sblc-relax-receipt-error-detail term)
                                  (sblc-relax-receipt-projection-residual term) (vector-length logits))
                (let* ((e (sblc-relax-candidate term (vector-ref trace 2) domain))
                       (seen? (member term seen))
                       (r (sblc-relax-reward e (sblc-relax-candidate-likelihood e) opts))
                       (sites (vector-ref trace 3))
                       (g (gradient (lambda (l) (sblc-relax-path-value l sites tau r)) logits)))
                  (sblc-relax-observe! mean g (+ i 1))
                  (loop (+ i 1) (+ reward r) dist
                        (if seen? entries (cons e entries)) (if seen? seen (cons term seen))))))))))
(define (sblc-relax-gumbel-grammar domain logits opts)
  (sblc-relax-sample domain 'gumbel-softmax logits opts))

(define (sblc-relax-options? opts)
  (and (list? opts)
       (let loop ((xs opts) (seen '()))
         (or (null? xs)
             (and (pair? (car xs)) (not (memq (caar xs) seen))
                  (let ((k (caar xs)) (v (cdar xs)))
                    (and (cond ((eq? k 'seed) (sblc-relax-integer? v))
                               ((memq k '(samples inner-coin-trials))
                                (and (sblc-relax-integer? v) (> v 0)))
                               ((eq? k 'tau) (and (sblc-relax-real? v) (> v 0)))
                               ((eq? k 'confidence-threshold) (and (sblc-relax-real? v) (< 0 v) (< v 1)))
                               ((eq? k 'baseline-mode) (memq v '(loo mean none)))
                               ((eq? k 'reward-mode) (memq v '(likelihood mdl custom)))
                               ((memq k '(constraint reward-fn)) (or (not v) (procedure? v)))
                               (else #f))
                         (loop (cdr xs) (cons k seen)))))))
       (or (not (eq? 'custom (sblc-relax-opt opts 'reward-mode 'likelihood)))
           (procedure? (sblc-relax-opt opts 'reward-fn #f)))))
(define (sblc-relax-admit domain method logits opts)
  (if (not (and (vector? domain) (= (vector-length domain) 4)))
      (error "Expected an SBLC proposal domain"))
  (if (not (sblc-relax-logits? logits))
      (error "Expected a vector of finite logits"))
  (if (not (sblc-relax-options? opts)) (error "Invalid proposal options"))
  (let ((kind (vector-ref domain 0)) (spec (vector-ref domain 1))
        (exs (vector-ref domain 2)) (bound (vector-ref domain 3)))
    (if (not (and (sblc-relax-integer? bound) (>= bound 0) (list? exs)
                  (let loop ((xs exs))
                    (or (null? xs)
                        (and (pair? (car xs)) (sblc-term? (caar xs))
                             (sblc-term? (cdar xs)) (loop (cdr xs)))))))
        (error "Invalid examples or step bound"))
    (cond ((eq? kind 'grammar)
           (if (and (eq? method 'gumbel-softmax) (sblc-relax-integer? spec)
                    (>= spec 0) (>= (vector-length logits) 5))
               '() (error "Grammar requires explicit Concrete sampling and at least five logits")))
          ((and (memq kind '(enumerated programs)) (memq method '(exact-oracle reinforce-rb)))
           (if (and (eq? kind 'enumerated)
                    (not (and (sblc-relax-integer? spec) (>= spec 0) (<= spec 16))))
               (error "Enumeration length must be within 0..16"))
           (let ((terms (sblc-relax-programs domain)))
             (if (and (list? terms) (pair? terms) (= (length terms) (vector-length logits))
                      (let loop ((xs terms) (seen '()))
                        (or (null? xs)
                            (and (sblc-relax-valid-term? (car xs)) (not (member (car xs) seen))
                                 (loop (cdr xs) (cons (car xs) seen))))))
                 terms (error "Expected distinct closed programs with one logit per program"))))
          (else (error "Method and domain are incompatible")))))

(define (sblc-relax-constraint-error entries opts method width)
  (let ((predicate (sblc-relax-opt opts 'constraint #f)))
    (and predicate
         (let loop ((xs entries))
           (and (pair? xs)
                (let ((result (sblc-relax-project-strict (sblc-relax-candidate-term (car xs)) predicate 0.0)))
                  (if (sblc-relax-receipt? result)
                      (sblc-relax-error method 'projection-error (sblc-relax-receipt-error-detail result)
                                        (sblc-relax-receipt-projection-residual result) width)
                      (loop (cdr xs)))))))))

(define (sblc-relax-sample domain method logits opts)
  (guard (ex (else (sblc-relax-error method 'domain-error
                     (if (error-object? ex) (error-object-message ex) 'invalid-input)
                     0.0 (if (vector? logits) (vector-length logits) 0))))
    (let ((terms (sblc-relax-admit domain method logits opts)))
      (if (eq? method 'gumbel-softmax) (sblc-relax-grammar domain logits opts)
          (let ((r (if (eq? method 'exact-oracle) (sblc-relax-oracle domain logits opts terms)
                       (sblc-relax-rb domain logits opts terms))))
            (or (sblc-relax-constraint-error (sblc-relax-receipt-candidates r) opts method (vector-length logits))
                r))))))

(define (sblc-relax-bits-before? a b)
  (or (< (string-length a) (string-length b))
      (and (= (string-length a) (string-length b)) (string<? a b))))

;; For an explicit catalogue, condition the singleton identity catalogue on
;; (M input, target). The initial identity beta step consumes one extra step.
;; This exercises the public conditioner even for programs longer than 16 bits.
(define (sblc-relax-verifier-row entry domain)
  (let ((term (sblc-relax-candidate-term entry)) (bound (vector-ref domain 3)))
    (let loop ((xs (vector-ref domain 2)) (lifted '()) (distributions '()))
      (if (null? xs)
          (list (sblc-relax-candidate-bits entry) (sblc-relax-candidate-prior entry)
                (sblc-relax-candidate-likelihood entry) (sblc-distribution term bound)
                (reverse distributions)
                (sblc-receipt->string (sblc-condition 42 4 (+ bound 1) (reverse lifted))))
          (let ((input (blc-app term (caar xs))))
            (loop (cdr xs) (cons (cons input (cdar xs)) lifted)
                  (cons (sblc-distribution input bound) distributions)))))))

(define (sblc-relax-verifier-view domain logits)
  (let* ((r (sblc-relax-exact-oracle domain logits '()))
         (ranked (sort (sblc-relax-receipt-candidates r)
                       (lambda (a b) (> (sblc-relax-candidate-probability a)
                                        (sblc-relax-candidate-probability b))))))
    (if (not (sblc-relax-receipt-exact? r)) (error "Expected a finite catalogue"))
    (let loop ((xs ranked) (rows '()))
      (if (null? xs)
          (sort rows (lambda (a b) (sblc-relax-bits-before? (car a) (car b))))
          (loop (cdr xs) (cons (sblc-relax-verifier-row (car xs) domain) rows))))))

(define (sblc-relax-verify-invariance domain logits1 logits2)
  (guard (ex (else #f))
    (let* ((terms (sblc-relax-admit domain 'exact-oracle logits1 '()))
           (exs (vector-ref domain 2)) (bound (vector-ref domain 3))
           (rev (sblc-relax-program-domain (reverse terms) exs bound))
           (bounded (eq? (vector-ref domain 0) 'enumerated))
           (before (and bounded (sblc-receipt->string (sblc-condition 42 (vector-ref domain 1) bound exs))))
           (left (sblc-relax-verifier-view domain logits1))
           (right (sblc-relax-verifier-view rev logits2)))
      (and (equal? left right)
           (or (not bounded) (string=? before (sblc-receipt->string
                                   (sblc-condition 42 (vector-ref domain 1) bound exs))))))))

;; Result: (final-logits chronological-rewards final-receipt). Reuse the seed
;; across steps for common random numbers. Stop at the first refused step.
(define (sblc-relax-optimize-logits domain method init-logits lr steps opts)
  (if (not (and (sblc-relax-real? lr) (> lr 0) (sblc-relax-integer? steps) (>= steps 0)))
      (error "Expected a positive learning rate and a nonnegative step count"))
  (let loop ((l init-logits) (i 0) (history '()))
    (let* ((r (sblc-relax-sample domain method l opts)) (ok (eq? 'ok (sblc-relax-receipt-status r)))
           (next-history (if ok (cons (sblc-relax-receipt-expected-reward r) history) history)))
      (if (or (not ok) (= i steps)) (list l (reverse next-history) r)
          (let ((next (make-vector (vector-length l) 0.0)) (g (sblc-relax-receipt-gradient r)))
            (let update ((j 0))
              (if (= j (vector-length l)) (loop next (+ i 1) next-history)
                  (begin (vector-set! next j (+ (vector-ref l j) (* lr (vector-ref g j))))
                         (update (+ j 1))))))))))
