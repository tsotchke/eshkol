;;; Source-specific exact stochastic work laws. Selected source donation: MIT.
(require core.sblc)
(require core.blc)
(provide sblc-branching-source sblc-latent-source sblc-resource-analyze
         sblc-resource-verify sblc-resource-status sblc-resource-certificate
         sblc-resource-summary sblc-resource-coefficients)

(define (sr-integer? x) (and (number? x) (exact? x) (integer? x)))
(define (sr-rational? x) (and (number? x) (exact? x) (rational? x)))
(define (sr-exact x) (if (not (sr-rational? x)) (error "SBLC resource arithmetic lost exactness")) x)
(define (sr+ a b) (sr-exact (+ a b)))
(define (sr* a b) (sr-exact (* a b)))
(define (sr/ a b) (sr-exact (/ a b)))
(define (sr-power a n)
  (let loop ((k n) (out 1)) (if (= k 0) out (loop (- k 1) (sr* out a)))))
(define (sr-list? xs n)
  (let loop ((xs xs) (left n))
    (cond ((null? xs) #t) ((or (= left 0) (not (pair? xs))) #f) (else (loop (cdr xs) (- left 1))))))
(define (sr-form? x tag arity)
  (and (sr-list? x arity) (= (length x) arity) (eq? (car x) tag)))
(define (sr-safe-source? source)
  (let ((left 4096))
    (define (walk t depth)
      (set! left (- left 1))
      (and (>= left 0) (< depth 64)
        (cond ((sr-form? t 'var 2) (and (sr-integer? (cadr t)) (<= 1 (cadr t)) (<= (cadr t) 64)))
              ((sr-form? t 'lam 2) (walk (cadr t) (+ depth 1)))
              ((or (sr-form? t 'app 3) (sr-form? t 'choice 3))
               (and (walk (cadr t) (+ depth 1)) (walk (caddr t) (+ depth 1))))
              (else #f))))
    (and (walk source 0) (sblc-closed? source))))
(define (sblc-branching-source leaves)
  (if (not (and (sr-integer? leaves) (<= 0 leaves) (<= leaves 4))) (error "Expected 0..4 terminating coin leaves"))
  (let* ((i (blc-lam (blc-var 1))) (xx (blc-app (blc-var 1) (blc-var 1)))
         (branch (blc-app xx xx))
         (leaf (lambda (j) (if (< j leaves) i branch)))
         (d (blc-lam (sblc-choice (sblc-choice (leaf 0) (leaf 1))
                                       (sblc-choice (leaf 2) (leaf 3))))))
    (blc-app d d)))
(define (sr-sequence term count)
  (let loop ((left (- count 1)) (out term))
    (if (= left 0) out (loop (- left 1) (blc-app out term)))))
(define (sblc-latent-source mode leaves0 leaves1 invocations)
  (if (not (and (memq mode '(shared fresh)) (sr-integer? invocations) (<= 1 invocations) (<= invocations 8)))
      (error "Expected shared/fresh and 1..8 invocations"))
  (let ((a (sblc-branching-source leaves0)) (b (sblc-branching-source leaves1)))
    (if (eq? mode 'shared) (sblc-choice (sr-sequence a invocations) (sr-sequence b invocations))
        (sr-sequence (sblc-choice a b) invocations))))

;; Read the actual source. This bounded structural bridge is shared trust code.
;; No constructor, evaluator, sampled trace or producer metadata is consulted.
(define (sr-branch-count term)
  (and (sr-form? term 'app 3) (equal? (cadr term) (caddr term))
       (sr-form? (cadr term) 'lam 2)
       (let ((body (cadr (cadr term))))
         (and (sr-form? body 'choice 3) (sr-form? (cadr body) 'choice 3)
              (sr-form? (caddr body) 'choice 3)
              (let ((leaves (list (cadr (cadr body)) (caddr (cadr body))
                                  (cadr (caddr body)) (caddr (caddr body)))))
                (and (every (lambda (x) (or (equal? x '(lam (var 1)))
                    (equal? x '(app (app (var 1) (var 1)) (app (var 1) (var 1)))))) leaves)
                     (length (filter (lambda (x) (equal? x '(lam (var 1)))) leaves))))))))
(define (sr-leaf term)
  (let ((k (sr-branch-count term)))
    (if k (list 'branch k)
        (and (sr-form? term 'choice 3)
             (let ((a (sr-branch-count (cadr term))) (b (sr-branch-count (caddr term))))
               (and a b (list 'latent a b)))))))
(define (sr-leaves term)
  (let ((leaf (sr-leaf term)))
    (if leaf (list leaf)
        (and (sr-form? term 'app 3)
             (let ((right (sr-leaf (caddr term))) (left (sr-leaves (cadr term))))
               (and right left (< (length left) 8) (append left (list right))))))))
(define (sr-read term)
  (if (not (sr-safe-source? term)) (error "Source outside bounded SBLC grammar"))
  (let ((single (sr-branch-count term)))
    (cond (single (list 'branch single single 1))
          ((sr-form? term 'choice 3)
           (let ((a (sr-leaves (cadr term))) (b (sr-leaves (caddr term))))
             (if (not (and a b (= (length a) (length b))
                    (every (lambda (x) (equal? x (car a))) a)
                    (every (lambda (x) (equal? x (car b))) b)
                    (eq? (caar a) 'branch) (eq? (caar b) 'branch)))
                 (error "Shared source is not a uniform pair of admitted sequences"))
             (list 'shared (cadar a) (cadar b) (length a))))
          (else
           (let ((leaves (sr-leaves term)))
             (if (not (and leaves (eq? (caar leaves) 'latent)
                           (every (lambda (x) (equal? x (car leaves))) leaves)))
                 (error "Source outside latent-sequence grammar"))
             (list 'fresh (cadar leaves) (caddar leaves) (length leaves)))))))

(define (sr-convolve a b degree)
  (let ((out (make-vector (+ degree 1) 0)) (va (list->vector a)) (vb (list->vector b)))
    (let outer ((i 0))
      (if (<= i degree)
          (begin (let inner ((j 0))
                   (if (<= (+ i j) degree)
                       (begin (vector-set! out (+ i j) (sr+ (vector-ref out (+ i j))
                                                    (sr* (vector-ref va i) (vector-ref vb j))))
                              (inner (+ j 1))))) (outer (+ i 1)))))
    (vector->list out)))
(define (sr-unit degree) (cons 1 (make-list degree 0)))
(define (sr-series-power a m degree)
  (let loop ((k m) (x a) (out (sr-unit degree)))
    (if (= k 0) out
        (loop (quotient k 2) (sr-convolve x x degree)
              (if (odd? k) (sr-convolve out x degree) out)))))
(define (sr-shift a shift degree)
  (let loop ((i 0)) (if (> i degree) '() (cons (if (< i shift) 0 (list-ref a (- i shift))) (loop (+ i 1))))))
(define (sr-average a b) (map (lambda (x y) (sr/ (sr+ x y) 2)) a b))
(define (sr-coefficients k degree)
  (let ((out (make-vector (+ degree 1) 0)) (p (sr/ k 4)))
    (let loop ((n 0) (catalan 1))
      (if (<= (+ (* 7 n) 3) degree)
          (begin (vector-set! out (+ (* 7 n) 3)
                   (sr* catalan (sr* (sr-power p (+ n 1)) (sr-power (- 1 p) n))))
                 (loop (+ n 1) (quotient (* catalan 2 (+ (* 2 n) 1)) (+ n 2))))))
    (vector->list out)))
(define (sr-branch-record k degree)
  (let* ((p (sr/ k 4)) (q (if (< p 1/2) (sr/ p (- 1 p)) 1))
         (denominator (- 1 (sr* 2 (sr* (- 1 p) q)))))
    (list k q
      (if (= denominator 0) 'infinite (sr/ (sr+ p (sr* 2 (sr* (- 1 p) (sr* q q)))) denominator))
      (if (= denominator 0) 'infinite (sr/ (sr+ (* 2 p) (sr* 2 (sr* (- 1 p) (sr* q q)))) denominator))
      (sr-coefficients k degree))))
(define (sr-weight weight moment)
  (cond ((= weight 0) 0) ((eq? moment 'infinite) 'infinite) (else (sr* weight moment))))
(define (sr-moment+ a b) (if (or (eq? a 'infinite) (eq? b 'infinite)) 'infinite (sr+ a b)))
(define (sr-summary descriptor records)
  (let* ((mode (car descriptor)) (m (list-ref descriptor 3)) (a (car records)) (b (cadr records))
         (qa (cadr a)) (qb (cadr b)) (qbar (sr/ (+ qa qb) 2))
         (q (cond ((eq? mode 'branch) qa) ((eq? mode 'shared) (sr/ (+ (sr-power qa m) (sr-power qb m)) 2))
                  (else (sr-power qbar m)))))
    (define (moment slot)
      (if (eq? mode 'branch) (list-ref a slot)
          (let* ((offset (if (= slot 2) (- m 1) (if (eq? mode 'shared) 1 m)))
                 (inside (if (eq? mode 'shared)
                    (sr-weight (sr/ m 2)
                      (sr-moment+ (sr-weight (sr-power qa (- m 1)) (list-ref a slot))
                                  (sr-weight (sr-power qb (- m 1)) (list-ref b slot))))
                    (sr-weight (sr* m (sr-power qbar (- m 1)))
                      (sr-weight 1/2 (sr-moment+ (list-ref a slot) (list-ref b slot)))))))
            (sr-moment+ (sr* offset q) inside))))
    (let* ((beta (moment 2)) (coins (moment 3)) (total (sr-moment+ beta coins)))
      (list q beta coins (if (< q 1) 'infinite total)
            (if (= q 0) 'undefined (sr-weight (sr/ 1 q) total))))))
(define (sr-output descriptor records degree)
  (let* ((mode (car descriptor)) (m (list-ref descriptor 3))
         (a (list-ref (car records) 4)) (b (list-ref (cadr records) 4)))
    (cond ((eq? mode 'branch) a)
          ((eq? mode 'shared) (sr-shift (sr-average (sr-series-power a m degree) (sr-series-power b m degree)) m degree))
          (else (sr-shift (sr-series-power (sr-average a b) m degree) (- (* 2 m) 1) degree)))))
(define (sblc-resource-status result) (vector-ref result 1))
(define (sblc-resource-certificate result) (vector-ref result 2))
(define (sblc-resource-summary certificate) (map (lambda (x) x) (vector-ref certificate 6)))
(define (sblc-resource-coefficients certificate) (map (lambda (x) x) (vector-ref certificate 5)))
(define (sblc-resource-analyze term degree)
  (if (not (and (sr-integer? degree) (<= 0 degree) (<= degree 48))) (error "Cost degree must be in 0..48"))
  (guard (e (else (vector 'sblc-resource-result-v1 'unknown #f)))
    (let* ((descriptor (sr-read term))
           (records (list (sr-branch-record (cadr descriptor) degree) (sr-branch-record (caddr descriptor) degree)))
           (proof (vector 'sblc-resource-v1 (sblc-program-id term) descriptor degree records
                          (sr-output descriptor records degree) (sr-summary descriptor records))))
      (if (sblc-resource-verify term proof) (vector 'sblc-resource-result-v1 'certified proof)
          (vector 'sblc-resource-result-v1 'unknown #f)))))

;; Independent coefficient replay: each output diagonal is accumulated anew.
(define (sr-replay-product a b degree)
  (let loop ((d 0) (out '()))
    (if (> d degree) (reverse out)
        (let diagonal ((i 0) (sum 0))
          (if (> i d) (loop (+ d 1) (cons sum out))
              (diagonal (+ i 1) (sr+ sum (sr* (list-ref a i) (list-ref b (- d i))))))))))
(define (sr-replay-power a m degree)
  (let loop ((i 0) (out (sr-unit degree)))
    (if (= i m) out (loop (+ i 1) (sr-replay-product out a degree)))))
(define (sr-check-branch record k degree)
  (and (sr-list? record 5) (= (length record) 5) (equal? (car record) k)
       (let* ((q (cadr record)) (beta (caddr record)) (coins (cadddr record))
              (coefficients (list-ref record 4)) (p (sr/ k 4)))
         (and (sr-rational? q) (<= 0 q) (<= q 1)
              (= q (sr+ p (sr* (- 1 p) (sr* q q))))
              (if (< p 1/2) (= (sr* (- 1 p) q) p) (= q 1))
              (sr-list? coefficients (+ degree 1)) (= (length coefficients) (+ degree 1))
              (every (lambda (x) (and (sr-rational? x) (>= x 0))) coefficients)
              (let ((squared (sr-replay-product coefficients coefficients degree)))
                (let all ((d 0))
                  (or (> d degree)
                      (and (= (list-ref coefficients d)
                              (sr+ (if (= d 3) p 0) (if (< d 4) 0 (sr* (- 1 p) (list-ref squared (- d 4))))))
                           (all (+ d 1))))))
              (let ((denominator (- 1 (sr* 2 (sr* (- 1 p) q)))))
                (if (= denominator 0) (and (eq? beta 'infinite) (eq? coins 'infinite))
                    (and (sr-rational? beta) (sr-rational? coins) (>= beta 0) (>= coins 0)
                         (= (sr* denominator beta) (sr+ p (sr* 2 (sr* (- 1 p) (sr* q q)))))
                         (= (sr* denominator coins) (sr+ (* 2 p) (sr* 2 (sr* (- 1 p) (sr* q q))))))))))))

;; Independent dual-semiring composition of mass and both first work moments.
(define (sr-check-summary descriptor records)
  (define (product a b)
    (list (sr* (car a) (car b))
          (sr-moment+ (sr-weight (car b) (cadr a)) (sr-weight (car a) (cadr b)))
          (sr-moment+ (sr-weight (car b) (caddr a)) (sr-weight (car a) (caddr b)))))
  (define (repeated a m)
    (let loop ((i 0) (out '(1 0 0))) (if (= i m) out (loop (+ i 1) (product out a)))))
  (define (mixture a b)
    (list (sr/ (sr+ (car a) (car b)) 2)
          (sr-weight 1/2 (sr-moment+ (cadr a) (cadr b)))
          (sr-weight 1/2 (sr-moment+ (caddr a) (caddr b)))))
  (define (bill a beta coins)
    (list (car a) (sr-moment+ (cadr a) (sr* beta (car a)))
          (sr-moment+ (caddr a) (sr* coins (car a)))))
  (let* ((mode (car descriptor)) (m (list-ref descriptor 3))
         (a (list (cadar records) (caddar records) (list-ref (car records) 3)))
         (b (list (cadr (cadr records)) (caddr (cadr records)) (list-ref (cadr records) 3)))
         (state (cond ((eq? mode 'branch) a)
                      ((eq? mode 'shared) (bill (mixture (repeated a m) (repeated b m)) (- m 1) 1))
                      (else (bill (repeated (bill (mixture a b) 0 1) m) (- m 1) 0))))
         (q (car state)) (total (sr-moment+ (cadr state) (caddr state))))
    (list q (cadr state) (caddr state) (if (< q 1) 'infinite total)
          (if (= q 0) 'undefined (sr-weight (sr/ 1 q) total)))))
(define (sblc-resource-verify term proof)
  (guard (e (else #f))
    (and (vector? proof) (= (vector-length proof) 7) (eq? (vector-ref proof 0) 'sblc-resource-v1)
         (let* ((descriptor (sr-read term)) (degree (vector-ref proof 3)) (records (vector-ref proof 4)))
           (and (equal? (vector-ref proof 1) (sblc-program-id term)) (equal? descriptor (vector-ref proof 2))
                (sr-integer? degree) (<= 0 degree) (<= degree 48)
                (sr-list? records 2) (= (length records) 2)
                (sr-check-branch (car records) (cadr descriptor) degree)
                (sr-check-branch (cadr records) (caddr descriptor) degree)
                (let* ((mode (car descriptor)) (m (list-ref descriptor 3))
                       (a (list-ref (car records) 4)) (b (list-ref (cadr records) 4))
                       (wanted (cond ((eq? mode 'branch) a)
                         ((eq? mode 'shared) (sr-shift (sr-average (sr-replay-power a m degree) (sr-replay-power b m degree)) m degree))
                         (else (sr-shift (sr-replay-power (sr-average a b) m degree) (- (* 2 m) 1) degree)))))
                  (and (equal? wanted (vector-ref proof 5))
                       (equal? (sr-check-summary descriptor records) (vector-ref proof 6))
                       (<= (fold-left sr+ 0 wanted) (car (vector-ref proof 6))))))))))
