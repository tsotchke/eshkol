;;; Checked rational polynomial arithmetic. Coefficients run low degree first.
(require stdlib)
(provide exact-poly exact-poly-zero? exact-poly-sub exact-poly-scale exact-poly-mul
         exact-poly-divmod exact-poly-inverse-mod exact-poly-eval
         exact-poly-real-root-count exact-poly-isolate)

;; Public constructor always owns coefficients and refuses inexact data.
(define (exact-poly coefficients)
  (let ((items (cond ((number? coefficients) (list coefficients))
                     ((list? coefficients) coefficients)
                     ((vector? coefficients) (vector->list coefficients))
                     (else (error "Expected exact rational polynomial coefficients")))))
    (ep-trim (if (null? items) (vector 0) (list->vector (map ep-exact items))))))
;; Arithmetic borrows vectors during the call, including zero padding that
;; the arithmetic kernels already handle. Validate without allocating lists
;; or redundant normalized copies; every operation still owns its result.
;; Degree-sensitive operations normalize explicitly. Constructors always copy.
(define (ep-input p)
  (if (and (vector? p) (> (vector-length p) 0))
      (begin
        (let validate ((i 0))
          (if (< i (vector-length p))
              (begin (ep-exact (vector-ref p i)) (validate (+ i 1)))))
        p)
      (exact-poly p)))
(define (exact-poly-zero? p) (ep-zero? (ep-input p)))
(define (exact-poly-sub a b) (ep-poly-sub (ep-input a) (ep-input b)))
(define (exact-poly-scale p x) (ep-poly-scale (ep-input p) (ep-exact x)))
(define (exact-poly-mul a b) (ep-poly-mul (ep-input a) (ep-input b)))
(define (exact-poly-divmod a b) (ep-divmod (ep-input a) (ep-input b)))
(define (exact-poly-eval p x)
  (ep-exact x)
  (let ((v (ep-input p)))
    (let loop ((i (- (vector-length v) 1)) (out 0))
      (if (< i 0) out (loop (- i 1) (ep+ (ep* out x) (vector-ref v i)))))))
(define (exact-poly-inverse-mod a modulus)
  (let ((m (ep-trim (ep-input modulus))) (v (ep-trim (ep-input a))))
    (if (<= (vector-length m) 1) (error "Polynomial modulus must be nonconstant"))
    (let euclid ((r0 m) (r1 v) (t0 (vector 0)) (t1 (vector 1)))
      (if (ep-zero? r1)
          (begin
            (if (or (ep-zero? r0) (not (= (vector-length r0) 1)))
                (error "Polynomial is not a unit modulo the modulus"))
            (cdr (ep-divmod (ep-poly-scale t0 (ep/ 1 (vector-ref r0 0))) m)))
          (let ((qr (ep-divmod r0 r1)))
            (euclid r1 (cdr qr) t1 (ep-poly-sub t0 (ep-poly-mul (car qr) t1))))))))

(define (ep-derivative p)
  (let* ((degree (- (vector-length p) 1)) (out (make-vector (max 1 degree) 0)))
    (let loop ((i 1))
      (if (<= i degree)
          (begin (vector-set! out (- i 1) (ep* i (vector-ref p i))) (loop (+ i 1)))))
    (ep-trim out)))
(define (ep-sturm p)
  (if (ep-zero? p) (error "The zero polynomial has no finite root count"))
  (let loop ((a p) (b (ep-derivative p)) (out (list p)))
    (if (ep-zero? b) (reverse out)
        (loop b (ep-poly-scale (cdr (ep-divmod a b)) -1) (cons b out)))))
(define (ep-variations sequence x)
  (let loop ((rest sequence) (previous 0) (changes 0))
    (if (null? rest) changes
        (let* ((value (exact-poly-eval (car rest) x))
               (sign (cond ((> value 0) 1) ((< value 0) -1) (else 0))))
          (if (= sign 0) (loop (cdr rest) previous changes)
              (loop (cdr rest) sign (+ changes (if (and (not (= previous 0)) (not (= previous sign))) 1 0))))))))
(define (ep-count sequence lower upper)
  (- (ep-variations sequence lower) (ep-variations sequence upper)))
(define (exact-poly-real-root-count p lower upper)
  (let ((v (ep-input p)))
    (ep-exact lower) (ep-exact upper)
    (if (or (not (< lower upper)) (= (exact-poly-eval v lower) 0) (= (exact-poly-eval v upper) 0))
        (error "Root-count interval must be ordered with nonroot endpoints"))
    (ep-count (ep-sturm v) lower upper)))
(define (ep-nonroot-split p lower upper k)
  (if (> k (+ 2 (vector-length p))) (error "Could not find a nonroot split"))
  (let ((mid (ep/ (ep+ lower (ep* k upper)) (+ k 1))))
    (if (= (exact-poly-eval p mid) 0) (ep-nonroot-split p lower upper (+ k 1)) mid)))
;; Returns (intervals . spent-splits). No partial result escapes exhaustion.
(define (ep-isolate p sequence lower upper count budget)
  (cond ((= count 0) (cons '() 0))
        ((= count 1) (cons (list (cons lower upper)) 0))
        ((= budget 0) (error "Real-root isolation exhausted its split budget"))
        (else
          (let* ((mid (ep-nonroot-split p lower upper 1)) (left-count (ep-count sequence lower mid))
                 (left (ep-isolate p sequence lower mid left-count (- budget 1)))
                 (right (ep-isolate p sequence mid upper (- count left-count) (- budget 1 (cdr left)))))
            (cons (append (car left) (car right)) (+ 1 (cdr left) (cdr right)))))))
(define (exact-poly-isolate p . budget)
  (let* ((v (ep-trim (ep-input p))) (limit (if (null? budget) 256 (car budget))))
    (if (not (and (<= (length budget) 1) (integer? limit) (exact? limit) (>= limit 0) (<= limit 65536)))
        (error "Invalid real-root split budget"))
    (let* ((lead (vector-ref v (- (vector-length v) 1)))
           (bound (let loop ((i 0) (out 1))
             (if (= i (- (vector-length v) 1)) (+ out 1)
                 (loop (+ i 1) (max out (ceiling (abs (ep/ (vector-ref v i) lead))))))))
           (sequence (ep-sturm v)))
      (car (ep-isolate v sequence (- bound) bound (ep-count sequence (- bound) bound) limit)))))

(define (ep-exact x)
  (if (not (and (rational? x) (exact? x)))
      (error "Exact polynomial arithmetic requires an exact rational result" x))
  x)
(define (ep+ a b) (ep-exact (+ a b)))
(define (ep- a b) (ep-exact (- a b)))
(define (ep* a b) (ep-exact (* a b)))
(define (ep/ a b) (ep-exact (/ a b)))

;; Dense exact polynomials, low degree first. The zero polynomial is #(0),
;; constructed with the vector procedure rather than a numeric tensor literal.
(define (ep-trim p)
  (let loop ((n (vector-length p)))
    (if (and (> n 1) (= (vector-ref p (- n 1)) 0))
        (loop (- n 1))
        (let ((out (make-vector n 0)))
          (let copy ((i 0))
            (if (< i n)
                (begin (vector-set! out i (vector-ref p i)) (copy (+ i 1)))))
          out))))
(define (ep-zero? p)
  (let loop ((i 0))
    (or (= i (vector-length p))
        (and (= (vector-ref p i) 0) (loop (+ i 1))))))
(define (ep-at p i) (if (< i (vector-length p)) (vector-ref p i) 0))
(define (ep-poly-sub a b)
  (let* ((n (max (vector-length a) (vector-length b))) (out (make-vector n 0)))
    (let loop ((i 0))
      (if (< i n)
          (begin (vector-set! out i (ep- (ep-at a i) (ep-at b i))) (loop (+ i 1)))))
    (ep-trim out)))
(define (ep-poly-scale a scalar)
  (let* ((n (vector-length a)) (out (make-vector n 0)))
    (let loop ((i 0))
      (if (< i n)
          (begin (vector-set! out i (ep* (vector-ref a i) scalar)) (loop (+ i 1)))))
    (ep-trim out)))
(define (ep-poly-mul a b)
  (let ((out (make-vector (- (+ (vector-length a) (vector-length b)) 1) 0)))
    (let outer ((i 0))
      (if (< i (vector-length a))
          (begin
            (if (not (= (vector-ref a i) 0))
                (let inner ((j 0))
                  (if (< j (vector-length b))
                      (begin
                        (if (not (= (vector-ref b j) 0))
                            (vector-set! out (+ i j)
                              (ep+ (vector-ref out (+ i j))
                                   (ep* (vector-ref a i) (vector-ref b j)))))
                        (inner (+ j 1))))))
            (outer (+ i 1)))))
    (ep-trim out)))

;; General rational long division, also valid for nonmonic Euclid remainders.
;; Returns (quotient . remainder), preserving both inputs.
(define (ep-divmod numerator denominator)
  (let* ((a (ep-trim numerator)) (b (ep-trim denominator))
         (da (- (vector-length a) 1)) (db (- (vector-length b) 1)))
    (if (ep-zero? b) (error "Polynomial division by zero"))
    (if (< da db)
        (cons (vector 0) a)
        (let ((r (vector-copy a)) (q (make-vector (+ (- da db) 1) 0)))
          (let loop ((k (- da db)))
            (if (>= k 0)
                (let ((factor (ep/ (vector-ref r (+ k db)) (vector-ref b db))))
                  (vector-set! q k factor)
                  (if (not (= factor 0))
                      (let subtract ((j 0))
                        (if (<= j db)
                            (begin
                              (vector-set! r (+ k j)
                                (ep- (vector-ref r (+ k j)) (ep* factor (vector-ref b j))))
                              (subtract (+ j 1))))))
                  (loop (- k 1)))))
          (let ((rem (make-vector (max 1 db) 0)))
            (let copy ((i 0))
              (if (< i db)
                  (begin (vector-set! rem i (vector-ref r i)) (copy (+ i 1)))))
            (cons (ep-trim q) (ep-trim rem)))))))
