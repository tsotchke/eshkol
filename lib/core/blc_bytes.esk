;;; core/blc_bytes.esk — classical BLC byte observation with a bounded heap.
;;; Lexical call-by-need, memoized thunks and copying collection.
;;; Syntax and the independent strong tree reducer remain in core.blc.
(require core.list.query)
(require core.list.transform)
(require core.list.search)
(require core.blc)
(provide blc-run-bytes)

;; State fields: limits 0/1, work 2, allocations 3, beta 4, cache hits 5,
;; status 6, active tag/a/b/c vectors 7..10, spare vectors 11..14,
;; forwarding 15, allocation cursors 16/17, roots 18, root count 19,
;; collections 20, maximum sampled GC live count 21, AST 22, mode 23.
;; Heap tags: 0 thunk(AST,env), 1 env(thunk,next), 2 closure(AST,env),
;; 3 observer(arity,head,tail), 4 observed-pair(head,tail), 5 token(number),
;; 6 cached-thunk(value), 7 update(thunk,next), 8 apply(argument,next).
;; Object zero is null. All mutable state belongs to one invocation.
(define (bcb-ok? s) (eq? (vector-ref s 6) 'running))
(define (bcb-refuse s why) (if (bcb-ok? s) (vector-set! s 6 why)) 0)
(define (bcb-tick s)
  (if (not (bcb-ok? s)) #f
      (if (>= (vector-ref s 2) (vector-ref s 0))
          (begin (bcb-refuse s 'work-bound) #f)
          (begin (vector-set! s 2 (+ 1 (vector-ref s 2))) #t))))
(define (bcb-root s i) (vector-ref (vector-ref s 18) i))
(define (bcb-set-root s i value) (vector-set! (vector-ref s 18) i value))
(define (bcb-push s value)
  (let ((i (vector-ref s 19)))
    (if (>= i 64) (error "blc-run-bytes: internal observer root overflow")
        (begin (bcb-set-root s i value) (vector-set! s 19 (+ i 1)) i))))
(define (bcb-pop s count) (vector-set! s 19 count))
(define (bcb-clear-machine s)
  (bcb-set-root s 0 0) (bcb-set-root s 1 0) (bcb-set-root s 2 0))
(define (bcb-tag s object) (vector-ref (vector-ref s 7) object))
(define (bcb-a s object) (vector-ref (vector-ref s 8) object))
(define (bcb-b s object) (vector-ref (vector-ref s 9) object))
(define (bcb-c s object) (vector-ref (vector-ref s 10) object))
(define (bcb-env-ref s env index)
  (if (= index 1) (bcb-a s env)
      (bcb-env-ref s (bcb-b s env) (- index 1))))

;; Copy without recursive traversal; Cheney scanning fixes the child IDs.
;; AST pointers are immutable host data and are never treated as heap IDs.
(define (bcb-forward s object)
  (if (= object 0) 0
      (let ((forwarded (vector-ref (vector-ref s 15) object)))
        (if (> forwarded 0) forwarded
            (let ((next (vector-ref s 17)))
              (vector-set! s 17 (+ next 1))
              (vector-set! (vector-ref s 15) object next)
              (vector-set! (vector-ref s 11) next (bcb-tag s object))
              (vector-set! (vector-ref s 12) next (bcb-a s object))
              (vector-set! (vector-ref s 13) next (bcb-b s object))
              (vector-set! (vector-ref s 14) next (bcb-c s object))
              next)))))
(define (bcb-collect s)
  (let clear ((i 1))
    (if (< i (vector-ref s 16))
        (begin (vector-set! (vector-ref s 15) i 0) (clear (+ i 1)))))
  (vector-set! s 17 1)
  (let roots ((i 0))
    (if (< i (vector-ref s 19))
        (begin (bcb-set-root s i (bcb-forward s (bcb-root s i))) (roots (+ i 1)))))
  (let scan ((i 1))
    (if (and (< i (vector-ref s 17)) (bcb-tick s))
        (let* ((tag (vector-ref (vector-ref s 11) i))
               (a (vector-ref (vector-ref s 12) i))
               (b (vector-ref (vector-ref s 13) i))
               (c (vector-ref (vector-ref s 14) i)))
          (cond
            ((or (= tag 0) (= tag 2))
             (vector-set! (vector-ref s 13) i (bcb-forward s b)))
            ((= tag 3)
             (vector-set! (vector-ref s 13) i (bcb-forward s b))
             (vector-set! (vector-ref s 14) i (bcb-forward s c)))
            ((or (= tag 1) (= tag 4) (= tag 7) (= tag 8))
             (vector-set! (vector-ref s 12) i (bcb-forward s a))
             (vector-set! (vector-ref s 13) i (bcb-forward s b)))
            ((= tag 6) (vector-set! (vector-ref s 12) i (bcb-forward s a))))
          (scan (+ i 1)))))
  (if (bcb-ok? s)
      (begin
        (let swap ((i 7))
          (if (< i 11)
              (let ((old (vector-ref s i)))
                (vector-set! s i (vector-ref s (+ i 4)))
                (vector-set! s (+ i 4) old) (swap (+ i 1)))))
        (vector-set! s 16 (vector-ref s 17))
        (vector-set! s 20 (+ 1 (vector-ref s 20)))
        (if (> (- (vector-ref s 16) 1) (vector-ref s 21))
            (vector-set! s 21 (- (vector-ref s 16) 1))))))
(define (bcb-reserve s count)
  (if (not (bcb-ok? s)) #f
      (begin
        (if (> (+ (vector-ref s 16) count) (vector-ref s 1)) (bcb-collect s))
        (if (not (bcb-ok? s)) #f
            (if (> (+ (vector-ref s 16) count) (vector-ref s 1))
                (begin (bcb-refuse s 'heap-bound) #f) #t)))))
;; Allocation occurs only after reserve. No collection inside a transition.
(define (bcb-new s tag a b c)
  (let ((i (vector-ref s 16)))
    (vector-set! s 16 (+ i 1)) (vector-set! s 3 (+ 1 (vector-ref s 3)))
    (vector-set! (vector-ref s 7) i tag) (vector-set! (vector-ref s 8) i a)
    (vector-set! (vector-ref s 9) i b) (vector-set! (vector-ref s 10) i c) i))

;; Three permanent machine roots: environment, value, continuation.
(define (bcb-machine s)
  (let loop ()
    (if (not (and (bcb-tick s) (bcb-reserve s 3))) 0
        (let ((term (vector-ref s 22)) (env (bcb-root s 0))
              (value (bcb-root s 1)) (stack (bcb-root s 2)))
          (if (= (vector-ref s 23) 0)
              (cond
                ((= (vector-ref term 0) 0)
                 (let ((thunk (bcb-env-ref s env (vector-ref term 1))))
                   (if (= (bcb-tag s thunk) 6)
                       (begin (vector-set! s 5 (+ 1 (vector-ref s 5)))
                              (bcb-set-root s 1 (bcb-a s thunk)) (vector-set! s 23 1))
                       (begin (vector-set! s 22 (bcb-a s thunk))
                              (bcb-set-root s 0 (bcb-b s thunk))
                              (bcb-set-root s 2 (bcb-new s 7 thunk stack 0)))))
                 (loop))
                ((= (vector-ref term 0) 1)
                 (bcb-set-root s 1 (bcb-new s 2 (vector-ref term 1)
                                          (if (= (vector-ref term 3) 0) 0 env) 0))
                 (vector-set! s 23 1) (loop))
                (else
                 (let* ((code (vector-ref term 2))
                        (argument (bcb-new s 0 code (if (= (vector-ref code 3) 0) 0 env) 0)))
                   (bcb-set-root s 2 (bcb-new s 8 argument stack 0))
                   (vector-set! s 22 (vector-ref term 1))) (loop)))
              (if (= stack 0) value
                  (let ((tag (bcb-tag s stack)) (item (bcb-a s stack)) (rest (bcb-b s stack)))
                    (bcb-set-root s 2 rest)
                    (cond
                      ((= tag 7)
                       (vector-set! (vector-ref s 7) item 6)
                       (vector-set! (vector-ref s 8) item value)
                       (vector-set! (vector-ref s 9) item 0)
                       (vector-set! (vector-ref s 10) item 0) (loop))
                      ((= (bcb-tag s value) 2)
                       (vector-set! s 4 (+ 1 (vector-ref s 4)))
                       (vector-set! s 22 (bcb-a s value))
                       (bcb-set-root s 0 (bcb-new s 1 item (bcb-b s value) 0))
                       (vector-set! s 23 0) (loop))
                      ((= (bcb-tag s value) 3)
                       (let ((remaining (bcb-a s value)))
                         (bcb-set-root s 1
                           (cond ((= remaining 3) (bcb-new s 3 2 item 0))
                                 ((= remaining 2) (bcb-new s 3 1 (bcb-b s value) item))
                                 (else (bcb-new s 4 (bcb-b s value) (bcb-c s value) 0)))))
                       (loop))
                      (else (bcb-refuse s 'invalid-output))))))))))

(define (bcb-force s thunk)
  (let* ((base (vector-ref s 19)) (saved (bcb-push s thunk)) (answer 0))
    (bcb-clear-machine s)
    (if (bcb-reserve s 1)
        (let ((current (bcb-root s saved)))
          (if (= (bcb-tag s current) 6)
              (begin (vector-set! s 5 (+ 1 (vector-ref s 5))) (set! answer (bcb-a s current)))
              (begin (vector-set! s 22 (bcb-a s current))
                     (bcb-set-root s 0 (bcb-b s current))
                     (bcb-set-root s 2 (bcb-new s 7 current 0 0))
                     (vector-set! s 23 0) (set! answer (bcb-machine s))))))
    (bcb-set-root s 1 answer) (bcb-pop s base) answer))
(define (bcb-apply s function argument)
  (let* ((base (vector-ref s 19)) (fn (bcb-push s function)) (arg (bcb-push s argument)) (answer 0))
    (bcb-clear-machine s)
    (if (bcb-reserve s 1)
        (begin (bcb-set-root s 1 (bcb-root s fn))
               (bcb-set-root s 2 (bcb-new s 8 (bcb-root s arg) 0 0))
               (vector-set! s 23 1) (set! answer (bcb-machine s))))
    (bcb-pop s base) answer))
;; Native selectors are output contexts only; no arithmetic enters the term.
(define (bcb-observe s value bit?)
  (let* ((base (vector-ref s 19)) (saved (bcb-push s value)) (answer 0))
    (bcb-clear-machine s)
    (if (bcb-reserve s 4)
        (let* ((left (if bit? (bcb-new s 5 0 0 0) (bcb-new s 3 3 0 0)))
               (left-thunk (bcb-new s 6 left 0 0))
               (right (bcb-new s 5 (if bit? 1 -1) 0 0))
               (right-thunk (bcb-new s 6 right 0 0))
               (right-root (bcb-push s right-thunk))
               (first (bcb-apply s (bcb-root s saved) left-thunk)))
          (set! answer (bcb-apply s first (bcb-root s right-root)))))
    (bcb-pop s base) answer))
(define (bcb-nil? s value) (and (> value 0) (= (bcb-tag s value) 5) (= (bcb-a s value) -1)))
(define (bcb-bit s value)
  (let ((answer (bcb-observe s value #t)))
    (if (not (bcb-ok? s)) 0
        (if (and (= (bcb-tag s answer) 5) (or (= (bcb-a s answer) 0) (= (bcb-a s answer) 1)))
            (bcb-a s answer) (bcb-refuse s 'invalid-output)))))
(define (bcb-byte s value)
  (let* ((base (vector-ref s 19)) (stream (bcb-push s value)) (answer 0))
    (let loop ((count 0) (number 0))
      (let ((cell (bcb-observe s (bcb-root s stream) #f)))
        (if (bcb-ok? s)
            (cond
              ((= count 8) (if (bcb-nil? s cell) (set! answer number) (bcb-refuse s 'invalid-output)))
              ((not (= (bcb-tag s cell) 4)) (bcb-refuse s 'invalid-output))
              (else
               (let* ((saved (bcb-push s cell))
                      (discarded (bcb-set-root s stream 0))
                      (bit (bcb-bit s (bcb-force s (bcb-a s cell))))
                      (tail (bcb-force s (bcb-b s (bcb-root s saved)))))
                 (bcb-set-root s stream tail) (bcb-pop s (+ base 1))
                 (if (bcb-ok? s) (loop (+ count 1) (+ (* number 2) bit)))))))))
    (bcb-pop s base) answer))

;; Annotate immutable code with the maximum ambient index it needs. Closed
;; arguments and lambdas capture the empty environment, avoiding retention of
;; caller continuations through constant data. This changes no source binder.
(define (bcb-var-code index) (vector 0 index #f index))
(define (bcb-lam-code body)
  (vector 1 body #f (if (> (vector-ref body 3) 0) (- (vector-ref body 3) 1) 0)))
(define (bcb-app-code function argument)
  (vector 2 function argument (if (> (vector-ref function 3) (vector-ref argument 3))
                                (vector-ref function 3) (vector-ref argument 3))))
(define (bcb-compile s program)
  (let loop ((pending (list (vector 0 program 0))) (results '()) (nodes 0))
    (if (null? pending) (car results)
        (if (not (bcb-tick s)) #f
            (let* ((item (car pending)) (phase (vector-ref item 0)) (term (vector-ref item 1))
                   (depth (vector-ref item 2)) (rest (cdr pending)))
              (cond
                ((= phase 1) (loop rest (cons (bcb-lam-code (car results)) (cdr results)) nodes))
                ((= phase 2) (loop rest (cons (bcb-app-code (cadr results) (car results)) (cddr results)) nodes))
                ((>= nodes 65536) (bcb-refuse s 'input-bound) #f)
                ((and (pair? term) (pair? (cdr term)) (null? (cddr term)))
                 (cond ((and (blc-var? term) (integer? (blc-var-index term))
                             (>= (blc-var-index term) 1) (<= (blc-var-index term) depth))
                        (loop rest (cons (bcb-var-code (blc-var-index term)) results) (+ nodes 1)))
                       ((blc-lam? term)
                        (loop (cons (vector 0 (blc-lam-body term) (+ depth 1))
                                    (cons (vector 1 #f 0) rest)) results (+ nodes 1)))
                       (else (bcb-refuse s 'invalid-term) #f)))
                ((and (pair? term) (pair? (cdr term)) (pair? (cddr term))
                      (null? (cdddr term)) (blc-app? term))
                 (loop (cons (vector 0 (blc-app-fun term) depth)
                             (cons (vector 0 (blc-app-arg term) depth)
                                   (cons (vector 2 #f 0) rest))) results (+ nodes 1)))
                (else (bcb-refuse s 'invalid-term) #f)))))))
(define (bcb-cons-code head tail)
  (bcb-lam-code (bcb-app-code (bcb-app-code (bcb-var-code 1) head) tail)))
(define (bcb-input-code s input)
  ;; Reuse core.blc's byte encoder; cache its immutable closed byte syntax.
  (let ((cache (make-vector 256 #f)) (nil-code (bcb-compile s blc-nil)))
    (let loop ((rest (reverse input)) (tail nil-code))
      (if (or (null? rest) (not (bcb-ok? s))) tail
          (let* ((byte (car rest)) (known (vector-ref cache byte))
                 (code (if known known (bcb-compile s (blc-byte->term byte)))))
            (if (not (bcb-ok? s)) #f
                (begin (vector-set! cache byte code)
                       (loop (cdr rest) (bcb-cons-code code tail)))))))))
(define (bcb-input? s bytes)
  (let loop ((rest bytes) (count 0))
    (cond ((null? rest) #t) ((not (bcb-tick s)) #f)
          ((>= count 65536) (bcb-refuse s 'input-bound) #f)
          ((and (pair? rest) (integer? (car rest)) (>= (car rest) 0) (< (car rest) 256))
           (loop (cdr rest) (+ count 1)))
          (else (bcb-refuse s 'invalid-input) #f))))
(define (blc-run-bytes program input work-limit heap-capacity output-limit)
  "Return (status bytes work allocations beta cache-hits collections max-gc-live).
Only normal is a complete byte observation. Work includes transitions,
validation visits and copied GC objects; it is not a strong-beta-step count."
  (if (not (and (integer? work-limit) (>= work-limit 0)
                (integer? heap-capacity) (>= heap-capacity 16)
                (integer? output-limit) (>= output-limit 0) (<= output-limit 65536)))
      (error "blc-run-bytes: invalid resource limits")
      (let ((s (vector work-limit heap-capacity 0 0 0 0 'running
                       (make-vector heap-capacity 0) (make-vector heap-capacity 0)
                       (make-vector heap-capacity 0) (make-vector heap-capacity 0)
                       (make-vector heap-capacity 0) (make-vector heap-capacity 0)
                       (make-vector heap-capacity 0) (make-vector heap-capacity 0)
                       (make-vector heap-capacity 0) 1 1 (make-vector 64 0) 3 0 0 #f 0))
            (output '()))
        (let ((code (bcb-compile s program)))
        (if (and code (bcb-input? s input))
            (begin
              (vector-set! s 22 code)
              (let* ((function (bcb-machine s)) (saved (bcb-push s function)))
                (bcb-clear-machine s)
                (let ((input-code (bcb-input-code s input)))
                (if (bcb-reserve s 1)
                    (let* ((argument (bcb-new s 0 input-code 0 0))
                           (start (bcb-apply s (bcb-root s saved) argument)))
                      (bcb-set-root s saved start)
                      (let loop ((count 0))
                        (let ((cell (bcb-observe s (bcb-root s saved) #f)))
                          (if (bcb-ok? s)
                              (cond
                                ((bcb-nil? s cell) (vector-set! s 6 'normal))
                                ((not (= (bcb-tag s cell) 4)) (bcb-refuse s 'invalid-output))
                                ((>= count output-limit) (bcb-refuse s 'output-bound))
                                (else
                                 (let* ((current (bcb-push s cell))
                                        (discarded (bcb-set-root s saved 0))
                                        (byte (bcb-byte s (bcb-force s (bcb-a s cell))))
                                        (tail (bcb-force s (bcb-b s (bcb-root s current)))))
                                   (if (bcb-ok? s)
                                       (begin (set! output (cons byte output))
                                              (bcb-set-root s saved tail) (bcb-pop s (+ saved 1))
                                              (loop (+ count 1)))))))))))))))))
        (list (vector-ref s 6) (reverse output) (vector-ref s 2) (vector-ref s 3)
              (vector-ref s 4) (vector-ref s 5) (vector-ref s 20) (vector-ref s 21)))))
