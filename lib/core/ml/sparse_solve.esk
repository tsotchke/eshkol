;;; CSR Krylov solves, implicit JVP/VJP, and exact sparse enclosures. MIT.
;;; Certificates use strict row diagonal dominance (Varah's infinity-norm
;;; inverse bound); a residual alone never certifies solution/gradient error.
(require core.ml.sparse)
(provide sparse-cg sparse-minres sparse-enclose verify-sparse-enclosure
         sparse-solve-jvp verify-sparse-jvp sparse-solve-vjp verify-sparse-vjp)

(define (ss-tab n f) (let ((v (make-vector n 0))) (let loop ((i 0)) (if (< i n) (begin (vector-set! v i (f i)) (loop (+ i 1))))) v))
(define (ss-all v p) (and (vector? v) (let loop ((i 0)) (or (= i (vector-length v)) (and (p (vector-ref v i)) (loop (+ i 1)))))))
(define (ss-finite? x) (and (number? x) (real? x) (finite? x)))
(define (ss-index? x n) (and (integer? x) (exact? x) (>= x 0) (< x n)))
(define (ss-vector! b n) (if (not (and (vector? b) (= (vector-length b) n) (ss-all b ss-finite?))) (error "Invalid finite solve vector")))
(define (ss-shape! a b)
  (if (not (sparse? a)) (error "Expected existing CSR matrix"))
  (let ((n (sparse-rows a)) (rp (vector-ref a 3)) (ci (vector-ref a 4)) (v (sparse-values a)))
    (if (not (and (integer? n) (exact? n) (> n 0) (equal? n (sparse-cols a))
                 (vector? rp) (= (vector-length rp) (+ n 1)) (vector? ci) (vector? v)
                 (= (vector-length ci) (vector-length v)) (ss-all v ss-finite?)
                 (ss-all rp (lambda (x) (ss-index? x (+ (vector-length v) 1))))
                 (= (vector-ref rp 0) 0) (= (vector-ref rp n) (vector-length v)))) (error "Invalid square CSR structure"))
    (let rows ((i 0))
      (if (< i n)
          (begin
            (if (> (vector-ref rp i) (vector-ref rp (+ i 1))) (error "Decreasing CSR pointer"))
            (let slots ((k (vector-ref rp i)) (last -1))
              (if (< k (vector-ref rp (+ i 1)))
                  (let ((j (vector-ref ci k)))
                    (if (not (and (ss-index? j n) (> j last))) (error "CSR columns must be unique and sorted"))
                    (slots (+ k 1) j)))) (rows (+ i 1)))))
    (ss-vector! b n) n))
(define (ss-symmetric! a)
  (let ((rp (vector-ref a 3)) (ci (vector-ref a 4)) (vs (sparse-values a)) (n (sparse-rows a)))
    (let rows ((i 0)) (if (< i n) (begin
      (let slots ((k (vector-ref rp i))) (if (< k (vector-ref rp (+ i 1)))
        (begin (if (not (= (vector-ref vs k) (sparse-ref a (vector-ref ci k) i))) (error "Krylov method requires symmetric A")) (slots (+ k 1)))))
      (rows (+ i 1)))))))
(define (ss-controls! tolerance limit)
  (if (not (and (ss-finite? tolerance) (> tolerance 0) (integer? limit) (exact? limit) (>= limit 0))) (error "Invalid Krylov tolerance or iteration cap")))
(define (ss-dot a b) (let loop ((i 0) (s 0.0)) (if (= i (vector-length a)) s (loop (+ i 1) (+ s (* (vector-ref a i) (vector-ref b i)))))))
(define (ss-norm a) (sqrt (ss-dot a a)))
(define (ss-combine a alpha b) (ss-tab (vector-length a) (lambda (i) (+ (vector-ref a i) (* alpha (vector-ref b i))))))
(define (ss-residual a b x) (ss-norm (ss-combine b -1.0 (sparse-matvec a x))))
(define (ss-result method status a b x iter tolerance)
  (let ((r (ss-residual a b x)) (threshold (* tolerance (max 1.0 (ss-norm b)))))
    (vector 'sparse-solve-v1 method
      (cond ((not (and (finite? r) (finite? threshold))) 'breakdown)
            ((<= r threshold) 'converged)
            ((eq? status 'converged) 'residual-mismatch) (else status))
      x r iter tolerance)))
(define (sparse-cg a b tolerance limit)
  (let* ((n (ss-shape! a b)) (x (make-vector n 0.0)) (r (ss-tab n (lambda (i) (exact->inexact (vector-ref b i)))))
         (p (ss-tab n (lambda (i) (vector-ref r i)))) (threshold (* tolerance (max 1.0 (ss-norm b)))))
    (ss-controls! tolerance limit) (ss-symmetric! a)
    (let loop ((x x) (r r) (p p) (rr (ss-dot r r)) (iter 0))
      (cond ((<= (sqrt rr) threshold) (ss-result 'cg 'converged a b x iter tolerance))
            ((= iter limit) (ss-result 'cg 'iteration-limit a b x iter tolerance))
            (else
              (let* ((ap (sparse-matvec a p)) (pap (ss-dot p ap)))
                (if (or (not (finite? pap)) (<= pap 0.0))
                    (ss-result 'cg 'non-positive-curvature a b x iter tolerance)
                    (let* ((alpha (/ rr pap)) (xx (ss-combine x alpha p))
                           (rnew (ss-combine r (- alpha) ap)) (rrnew (ss-dot rnew rnew)))
                      (if (not (and (ss-all xx ss-finite?) (finite? rrnew)))
                          (ss-result 'cg 'breakdown a b x iter tolerance)
                          (loop xx rnew (ss-combine rnew (/ rrnew rr) p) rrnew (+ iter 1)))))))))))
;; Full-orthogonalization symmetric minimum residual. In exact arithmetic
;; this minimizes over the same Krylov space as MINRES. Storage is O(n*k+k^2),
;; not the short-recurrence O(n) profile. Only the projected problem is dense.
(define (ss-project h g basis k n)
  (let ((y (make-vector k 0.0)))
    (let back ((i (- k 1)))
      (if (>= i 0)
          (let ((diag (vector-ref (vector-ref h i) i)))
            (if (= diag 0.0) (error "Singular projected Krylov problem"))
            (let sum ((j (+ i 1)) (s (vector-ref g i)))
              (if (= j k) (vector-set! y i (/ s diag))
                  (sum (+ j 1) (- s (* (vector-ref (vector-ref h i) j) (vector-ref y j))))))
            (back (- i 1)))))
    (ss-tab n (lambda (i) (let loop ((j 0) (s 0.0))
      (if (= j k) s (loop (+ j 1) (+ s (* (vector-ref y j) (vector-ref (vector-ref basis j) i))))))))))
(define (sparse-minres a b tolerance limit)
  (let* ((n (ss-shape! a b)) (cap (min n limit)) (beta (ss-norm b)) (zero (make-vector n 0.0))
         (threshold (* tolerance (max 1.0 beta))))
    (ss-controls! tolerance limit) (ss-symmetric! a)
    (cond ((<= beta threshold) (ss-result 'minres 'converged a b zero 0 tolerance))
          ((= cap 0) (ss-result 'minres 'iteration-limit a b zero 0 tolerance))
          (else
            (let ((basis (make-vector (+ cap 1) #f))
                  (h (ss-tab (+ cap 1) (lambda (i) (make-vector cap 0.0))))
                  (cs (make-vector cap 0.0)) (sn (make-vector cap 0.0)) (g (make-vector (+ cap 1) 0.0)))
              (vector-set! basis 0 (ss-tab n (lambda (i) (/ (vector-ref b i) beta)))) (vector-set! g 0 beta)
              (let step ((j 0) (last zero))
                (let ((w (sparse-matvec a (vector-ref basis j))))
                  ;; Two modified Gram-Schmidt passes; accumulate both passes.
                  (let pass ((p 0)) (if (< p 2) (begin
                    (let orth ((i 0)) (if (<= i j)
                      (let* ((v (vector-ref basis i)) (q (ss-dot v w)))
                        (vector-set! (vector-ref h i) j (+ (vector-ref (vector-ref h i) j) q))
                        (set! w (ss-combine w (- q) v)) (orth (+ i 1))))) (pass (+ p 1)))))
                  (let ((next (ss-norm w)))
                    (if (not (finite? next)) (ss-result 'minres 'breakdown a b last j tolerance)
                        (begin
                          (vector-set! (vector-ref h (+ j 1)) j next)
                          (let rotate ((i 0)) (if (< i j)
                            (let* ((u (vector-ref (vector-ref h i) j)) (v (vector-ref (vector-ref h (+ i 1)) j))
                                   (c (vector-ref cs i)) (s (vector-ref sn i)))
                              (vector-set! (vector-ref h i) j (+ (* c u) (* s v)))
                              (vector-set! (vector-ref h (+ i 1)) j (+ (* (- s) u) (* c v))) (rotate (+ i 1)))))
                          (let* ((u (vector-ref (vector-ref h j) j)) (den (sqrt (+ (* u u) (* next next)))))
                            (if (or (= den 0.0) (not (finite? den))) (ss-result 'minres 'breakdown a b last j tolerance)
                                (let* ((c (/ u den)) (s (/ next den)) (gj (vector-ref g j)))
                                  (vector-set! cs j c) (vector-set! sn j s)
                                  (vector-set! (vector-ref h j) j den) (vector-set! (vector-ref h (+ j 1)) j 0.0)
                                  (vector-set! g j (* c gj)) (vector-set! g (+ j 1) (* (- s) gj))
                                  (let ((x (ss-project h g basis (+ j 1) n)))
                                    (cond ((not (ss-all x ss-finite?)) (ss-result 'minres 'breakdown a b last j tolerance))
                                          ((<= (ss-residual a b x) threshold) (ss-result 'minres 'converged a b x (+ j 1) tolerance))
                                          ((= (+ j 1) cap) (ss-result 'minres 'iteration-limit a b x (+ j 1) tolerance))
                                          ((<= next 1e-28) (ss-result 'minres 'breakdown a b x (+ j 1) tolerance))
                                          (else (vector-set! basis (+ j 1) (ss-tab n (lambda (i) (/ (vector-ref w i) next))))
                                                (step (+ j 1) x)))))))))))))))))

(define (ss-q x) (if (not (and (rational? x) (exact? x))) (error "Exact rational certificate profile exceeded")) x)
(define (ss-q+ a b) (ss-q (+ (ss-q a) (ss-q b))))
(define (ss-q- a b) (ss-q (- (ss-q a) (ss-q b))))
(define (ss-q* a b) (ss-q (* (ss-q a) (ss-q b))))
(define (ss-q/ a b) (ss-q (/ (ss-q a) (ss-q b))))
(define (ss-qmv a x)
  (let ((rp (vector-ref a 3)) (ci (vector-ref a 4)) (v (sparse-values a)))
    (ss-tab (sparse-rows a) (lambda (i) (let loop ((k (vector-ref rp i)) (s 0))
      (if (= k (vector-ref rp (+ i 1))) s
          (loop (+ k 1) (ss-q+ s (ss-q* (vector-ref v k) (vector-ref x (vector-ref ci k)))))))))))
(define (ss-gap a)
  (let ((rp (vector-ref a 3)) (ci (vector-ref a 4)) (v (sparse-values a)))
    (let rows ((i 0) (gap #f))
      (if (= i (sparse-rows a)) gap
          (let ((d (let slots ((k (vector-ref rp i)) (s 0))
             (if (= k (vector-ref rp (+ i 1))) s
                 (slots (+ k 1) (ss-q+ s (* (if (= i (vector-ref ci k)) 1 -1) (abs (ss-q (vector-ref v k))))))))))
            (rows (+ i 1) (if gap (min gap d) d)))))))
(define (ss-enclosure-data a b x)
  (ss-shape! a b) (ss-vector! x (sparse-rows a))
  (let* ((gap (ss-gap a)) (ax (ss-qmv a x))
         (r (let loop ((i 0) (v 0)) (if (= i (vector-length b)) v
           (loop (+ i 1) (max v (abs (ss-q- (vector-ref b i) (vector-ref ax i)))))))))
    (if (<= gap 0) #f (vector (ss-tab (vector-length x) (lambda (i) (ss-q (vector-ref x i)))) gap (ss-q/ r gap)))))
;; Candidates are explicitly snapped to a 2^-20 grid. The exact replay, not
;; reconstruction accuracy, admits the enclosure of the original exact model.
(define (sparse-enclose a b candidate)
  (guard (e (else #f))
    (ss-vector! candidate (sparse-rows a))
    (let ((d (ss-enclosure-data a b (ss-tab (sparse-rows a) (lambda (i)
      (ss-q/ (ss-q (inexact->exact (round (* (vector-ref candidate i) 1048576)))) 1048576))))))
      (and d (vector 'sparse-enclosure-v1 (vector-ref d 0) (vector-ref d 1) (vector-ref d 2))))))
(define (verify-sparse-enclosure cert a b)
  (guard (e (else #f))
    (and (vector? cert) (= (vector-length cert) 4) (eq? (vector-ref cert 0) 'sparse-enclosure-v1)
         (let ((expected (ss-enclosure-data a b (vector-ref cert 1))))
           (and expected (equal? expected (vector (vector-ref cert 1) (vector-ref cert 2) (vector-ref cert 3))))))))
(define (ss-solve method a b tolerance limit)
  (case method ((cg) (sparse-cg a b tolerance limit)) ((minres) (sparse-minres a b tolerance limit)) (else (error "Unknown sparse solve method"))))
(define (ss-proved raw cert) (and (eq? (vector-ref raw 2) 'converged) cert))
(define (ss-sensitivity-rhs a db dvalues x)
  (let ((da (sparse-with-values a dvalues)))
    (ss-shape! da db)
    (let ((dx (ss-qmv da x))) (ss-tab (vector-length db) (lambda (i) (ss-q- (vector-ref db i) (vector-ref dx i)))))))
(define (ss-row-norm a)
  (let ((rp (vector-ref a 3)) (v (sparse-values a)))
    (let rows ((i 0) (out 0)) (if (= i (sparse-rows a)) out
      (rows (+ i 1) (max out (let slots ((k (vector-ref rp i)) (s 0))
        (if (= k (vector-ref rp (+ i 1))) s (slots (+ k 1) (ss-q+ s (abs (ss-q (vector-ref v k)))))))))))))
;; #(tag status primal-raw tangent-raw primal-cert tangent-cert center radius).
(define (sparse-solve-jvp method a b dvalues db tolerance limit)
  (let* ((p (ss-solve method a b tolerance limit)) (pc (sparse-enclose a b (vector-ref p 3))))
    (if (not (ss-proved p pc)) (vector 'sparse-jvp-v1 'unknown p #f pc #f #f #f)
        (guard (e (else (vector 'sparse-jvp-v1 'unknown p #f pc #f #f #f)))
          (let* ((rhs (ss-sensitivity-rhs a db dvalues (vector-ref pc 1)))
                 (t (ss-solve method a rhs tolerance limit)) (tc (sparse-enclose a rhs (vector-ref t 3))))
            (if (not (ss-proved t tc)) (vector 'sparse-jvp-v1 'unknown p t pc tc #f #f)
                (vector 'sparse-jvp-v1 'proved p t pc tc (vector-ref tc 1)
                  (ss-q+ (vector-ref tc 3) (ss-q/ (ss-q* (ss-row-norm (sparse-with-values a dvalues)) (vector-ref pc 3)) (vector-ref pc 2))))))))))
(define (verify-sparse-jvp r a b dvalues db)
  (guard (e (else #f))
    (and (vector? r) (= (vector-length r) 8) (eq? (vector-ref r 0) 'sparse-jvp-v1) (eq? (vector-ref r 1) 'proved)
         (verify-sparse-enclosure (vector-ref r 4) a b)
         (let* ((pc (vector-ref r 4)) (tc (vector-ref r 5))
                (rhs (ss-sensitivity-rhs a db dvalues (vector-ref pc 1))))
           (and (verify-sparse-enclosure tc a rhs) (equal? (vector-ref r 6) (vector-ref tc 1))
                (= (ss-q (vector-ref r 7)) (ss-q+ (vector-ref tc 3)
                  (ss-q/ (ss-q* (ss-row-norm (sparse-with-values a dvalues)) (vector-ref pc 3)) (vector-ref pc 2)))))))))
(define (ss-bars a pc ac)
  (let* ((x (vector-ref pc 1)) (l (vector-ref ac 1)) (rx (vector-ref pc 3)) (rl (vector-ref ac 3))
         (rp (vector-ref a 3)) (ci (vector-ref a 4)) (gv (make-vector (sparse-nnz a) 0)) (radii (make-vector (sparse-nnz a) 0)))
    (let rows ((i 0)) (if (< i (sparse-rows a)) (begin
      (let slots ((k (vector-ref rp i))) (if (< k (vector-ref rp (+ i 1)))
        (let ((li (vector-ref l i)) (xj (vector-ref x (vector-ref ci k))))
          (vector-set! gv k (ss-q* (- li) xj))
          (vector-set! radii k (ss-q+ (ss-q+ (ss-q* (abs li) rx) (ss-q* (abs xj) rl)) (ss-q* rx rl)))
          (slots (+ k 1))))) (rows (+ i 1)))))
    (vector gv radii l rl)))
;; #(tag status primal-raw adjoint-raw primal-cert adjoint-cert bars).
;; bars = #(stored-value centers, stored-value radii, RHS centers, RHS radius).
(define (sparse-solve-vjp method a b seed tolerance limit)
  (let* ((p (ss-solve method a b tolerance limit)) (adj (ss-solve method a seed tolerance limit))
         (pc (sparse-enclose a b (vector-ref p 3))) (ac (sparse-enclose a seed (vector-ref adj 3))))
    (if (not (and (ss-proved p pc) (ss-proved adj ac))) (vector 'sparse-vjp-v1 'unknown p adj pc ac #f)
        (guard (e (else (vector 'sparse-vjp-v1 'unknown p adj pc ac #f)))
          (vector 'sparse-vjp-v1 'proved p adj pc ac (ss-bars a pc ac))))))
(define (verify-sparse-vjp r a b seed)
  (guard (e (else #f))
    (and (vector? r) (= (vector-length r) 7) (eq? (vector-ref r 0) 'sparse-vjp-v1) (eq? (vector-ref r 1) 'proved)
         (begin (ss-symmetric! a) #t)
         (verify-sparse-enclosure (vector-ref r 4) a b) (verify-sparse-enclosure (vector-ref r 5) a seed)
         (equal? (vector-ref r 6) (ss-bars a (vector-ref r 4) (vector-ref r 5))))))
