;;; Exact query-generated invariant spaces. Selected source donation: MIT.
(require core.exact_linalg)
(require core.symbolic)
(provide compile-observable-closure verify-observable-closure project-observations
         compile-generator-closure verify-generator-closure
         observable-status observable-certificate observable-dimension)

(define (oc-list? xs bound)
  (let loop ((xs xs) (left bound))
    (cond ((null? xs) #t) ((or (= left 0) (not (pair? xs))) #f)
          (else (loop (cdr xs) (- left 1))))))
(define (oc-rational? x) (and (number? x) (rational? x) (exact? x)))
(define (oc-exact x) (if (not (oc-rational? x)) (error "Observable arithmetic lost exactness")) x)
(define (oc+ a b) (oc-exact (+ a b)))
(define (oc* a b) (oc-exact (* a b)))
(define (oc-zero n) (make-list n 0))
(define (oc-row row n)
  (if (not (and (oc-list? row 32) (= (length row) n) (every oc-rational? row)))
      (error "Expected a bounded exact rational row"))
  (map (lambda (x) x) row))
(define (oc-matrix rows height width)
  (if (not (and (oc-list? rows 32) (= (length rows) height))) (error "Wrong matrix height"))
  (map (lambda (row) (oc-row row width)) rows))
(define (oc-actions actions n)
  (if (not (oc-list? actions 16)) (error "At most 16 actions admitted"))
  (let loop ((rest actions) (names '()) (out '()))
    (if (null? rest) (reverse out)
        (let ((a (car rest)))
          (if (not (and (pair? a) (or (symbol? (car a))
                                     (and (oc-rational? (car a)) (integer? (car a))))
                        (not (member (car a) names))))
              (error "Invalid or duplicate action name"))
          (loop (cdr rest) (cons (car a) names)
                (cons (cons (car a) (oc-matrix (cdr a) n n)) out))))))
(define (oc-model queries actions)
  (if (not (and (oc-list? queries 32) (pair? queries) (oc-list? (car queries) 32)
                (pair? (car queries)))) (error "Expected nonempty query rows of width 1..32"))
  (let ((n (length (car queries))))
    (list (map (lambda (q) (oc-row q n)) queries) (oc-actions actions n) n)))
(define (oc-transpose rows width)
  (let loop ((i 0) (out '()))
    (if (= i width) (reverse out)
        (loop (+ i 1) (cons (map (lambda (row) (list-ref row i)) rows) out)))))
(define (oc-dot a b) (fold-left oc+ 0 (map oc* a b)))
(define (oc-act row matrix width)
  (map (lambda (column) (oc-dot row column)) (oc-transpose matrix width)))
(define (oc-solve rows rhs columns)
  (guard (e (else #f))
    (let ((answer (car (exact-affine-solve (list->vector (map list->vector rows))
                                          (list->vector rhs) columns))))
      (map oc-exact (vector->list answer)))))
(define (oc-coordinates row basis n)
  (if (null? basis) (if (every zero? row) '() #f)
      (oc-solve (oc-transpose basis n) row (length basis))))
(define (oc-result status proof reason work) (vector 'observable-result-v1 status proof reason work))
(define (observable-status result) (vector-ref result 1))
(define (observable-certificate result) (vector-ref result 2))
(define (observable-dimension result)
  (let ((p (observable-certificate result)))
    (if (not p) #f
        (length (vector-ref (if (eq? (vector-ref p 0) 'generator-closure-v1)
                                (vector-ref p 4) p) 2)))))

;; BFS retains actual reachable rows, with words witnessing their provenance.
(define (compile-observable-closure queries actions . limits)
  (let* ((model (oc-model queries actions)) (qs (car model)) (gs (cadr model)) (n (caddr model))
         (bounds (if (null? limits) '(32 4096) (car limits))))
    (if (not (and (<= (length limits) 1) (oc-list? bounds 2) (= (length bounds) 2)
                  (every (lambda (x) (and (oc-rational? x) (integer? x) (>= x 0))) bounds)
                  (<= (car bounds) 32) (<= (cadr bounds) 65536)))
        (error "Invalid observable dimension/work limits"))
    (let ((basis '()) (origins '()) (queue '()) (spent 0) (reason #f))
      (define (admit row origin)
        (if (not (oc-coordinates row basis n))
            (if (= (length basis) (car bounds)) (set! reason 'dimension-budget)
                (begin (set! basis (append basis (list row)))
                       (set! origins (append origins (list origin)))
                       (set! queue (append queue (list (cons row origin))))))))
      (let seeds ((rest qs) (i 0))
        (if (pair? rest) (begin (admit (car rest) (list i '())) (seeds (cdr rest) (+ i 1)))))
      (let search ()
        (if (and (pair? queue) (not reason))
            (let* ((entry (car queue)) (row (car entry)) (origin (cdr entry)))
              (set! queue (cdr queue))
              (for-each (lambda (action)
                (if (not reason)
                    (if (= spent (cadr bounds)) (set! reason 'action-budget)
                        (begin (set! spent (+ spent 1))
                               (admit (oc-act row (cdr action) n)
                                      (list (car origin) (append (cadr origin) (list (car action))))))))) gs)
              (search))))
      (if reason (oc-result 'unknown #f reason spent)
          (let* ((r (length basis))
                 (coordinates (map (lambda (q) (oc-coordinates q basis n)) qs))
                 (reduced (map (lambda (action)
                   (cons (car action) (map (lambda (row) (oc-coordinates (oc-act row (cdr action) n) basis n)) basis))) gs))
                 (columns (let loop ((i 0) (out '()))
                   (if (= i r) (reverse out)
                       (loop (+ i 1) (cons (oc-solve basis
                           (let unit ((j 0)) (if (= j r) '() (cons (if (= i j) 1 0) (unit (+ j 1))))) n) out)))))
                 (proof (vector 'observable-closure-v1 n basis coordinates reduced origins
                                (oc-transpose columns n))))
            (if (verify-observable-closure qs gs proof)
                (oc-result 'closed proof 'minimal-query-reachable-space spent)
                (oc-result 'unknown #f 'exact-admission-failed spent)))))))

;; Independent replay: direct coordinate loops, no producer action/rank/solve.
(define (oc-replay row matrix width)
  (let ((out (make-vector width 0)))
    (let outer ((r row) (rows matrix))
      (if (pair? r)
          (begin
            (let inner ((cs (car rows)) (j 0))
              (if (pair? cs)
                  (begin (vector-set! out j (oc+ (vector-ref out j) (oc* (car r) (car cs))))
                         (inner (cdr cs) (+ j 1)))))
            (outer (cdr r) (cdr rows)))))
    (vector->list out)))
(define (verify-observable-closure queries actions proof)
  (guard (e (else #f))
    (let* ((model (oc-model queries actions)) (qs (car model)) (gs (cadr model)) (n (caddr model)))
      (and (vector? proof) (= (vector-length proof) 7)
           (eq? (vector-ref proof 0) 'observable-closure-v1) (equal? (vector-ref proof 1) n)
           (oc-list? (vector-ref proof 2) n)
           (let* ((r (length (vector-ref proof 2)))
                  (basis (oc-matrix (vector-ref proof 2) r n))
                  (coordinates (oc-matrix (vector-ref proof 3) (length qs) r))
                  (small (oc-actions (vector-ref proof 4) r))
                  (origins (vector-ref proof 5))
                  (inverse (oc-matrix (vector-ref proof 6) n r)))
             (and (equal? (map car gs) (map car small)) (oc-list? origins r) (= (length origins) r)
                  (every (lambda (pair) (equal? (car pair) (oc-replay (cadr pair) basis n)))
                         (map list qs coordinates))
                  (let independent ((rows basis) (i 0))
                    (or (null? rows)
                        (and (equal? (oc-replay (car rows) inverse r)
                              (let unit ((j 0)) (if (= j r) '() (cons (if (= i j) 1 0) (unit (+ j 1))))))
                             (independent (cdr rows) (+ i 1)))))
                  (every (lambda (pair)
                    (let ((large (cdr (car pair))) (reduced (cdr (cadr pair))))
                      (every (lambda (rows)
                        (equal? (oc-replay (car rows) large n) (oc-replay (cadr rows) basis n)))
                        (map list basis reduced)))) (map list gs small))
                  (every (lambda (pair)
                    (let ((origin (cadr pair)))
                      (and (oc-list? origin 2) (= (length origin) 2)
                           (oc-rational? (car origin)) (integer? (car origin))
                           (<= 0 (car origin)) (< (car origin) (length qs))
                           (oc-list? (cadr origin) 4096)
                           (let walk ((row (list-ref qs (car origin))) (word (cadr origin)))
                             (if (null? word) (equal? row (car pair))
                                 (let ((action (assoc (car word) gs)))
                                   (and action (walk (oc-replay row (cdr action) n) (cdr word)))))))))
                    (map list basis origins))))))))
(define (project-observations queries actions proof requested)
  (if (not (verify-observable-closure queries actions proof)) (error "Invalid closure certificate"))
  (if (not (oc-list? requested 32)) (error "Too many requested observations"))
  (let ((n (vector-ref proof 1)) (basis (vector-ref proof 2)) (inverse (vector-ref proof 6)))
    (let loop ((rest requested) (i 0) (out '()))
      (if (null? rest) (list 'available (reverse out))
          (let* ((q (oc-row (car rest) n)) (coordinate (oc-replay q inverse (length basis)))
                 (residual (map (lambda (a b) (oc+ a (- b))) q (oc-replay coordinate basis n))))
            (if (every zero? residual) (loop (cdr rest) (+ i 1) (cons coordinate out))
                (list 'reconstruction-required i residual)))))))

;; Polynomial source adapter; canonical sparse arithmetic belongs to core.symbolic.
(define (oc-poly p)
  (if (not (and (poly? p) (<= (poly-degree p) 16) (<= (length (caddr p)) 1024)
                (every (lambda (term) (oc-rational? (cdr term))) (caddr p))))
      (error "Polynomial profile or exactness exceeded")) p)
(define (oc-p+ a b) (oc-poly (poly+ a b)))
(define (oc-p* a b)
  (if (> (* (length (caddr a)) (length (caddr b))) 4096) (error "Polynomial product budget"))
  (oc-poly (poly* a b)))
(define (oc-pow a n)
  (let loop ((k n) (out (poly-const 1)))
    (if (= k 0) out (loop (- k 1) (oc-p* out a)))))
(define (oc-expression expression names depth)
  (if (> depth 24) (error "Polynomial expression depth budget"))
  (cond ((oc-rational? expression) (poly-const expression))
        ((and (symbol? expression) (memq expression names)) (poly-var expression))
        ((and (oc-list? expression 17) (pair? expression))
         (let ((op (car expression)) (args (cdr expression)))
           (cond ((memq op '(+ *))
                  (fold-left (if (eq? op '+) oc-p+ oc-p*) (poly-const (if (eq? op '+) 0 1))
                    (map (lambda (x) (oc-expression x names (+ depth 1))) args)))
                 ((and (eq? op '-) (pair? args))
                  (let ((a (oc-expression (car args) names (+ depth 1))))
                    (if (null? (cdr args)) (oc-poly (poly-scale a -1))
                        (fold-left (lambda (x y) (oc-poly (poly- x y))) a
                          (map (lambda (x) (oc-expression x names (+ depth 1))) (cdr args))))))
                 ((and (eq? op 'expt) (= (length args) 2) (oc-rational? (cadr args))
                       (integer? (cadr args)) (<= 0 (cadr args)) (<= (cadr args) 8))
                  (oc-pow (oc-expression (car args) names (+ depth 1)) (cadr args)))
                 (else (error "Unsupported polynomial expression")))))
        (else (error "Unsupported polynomial datum"))))
(define (oc-distinct? xs) (or (null? xs) (and (not (member (car xs) (cdr xs))) (oc-distinct? (cdr xs)))))
(define (oc-spec spec)
  (if (not (and (oc-list? spec 6) (= (length spec) 6)
                (every pair? spec) (oc-distinct? (map car spec))
                (every (lambda (x) (memq x '(variables parameters basis drift jumps observations))) (map car spec))))
      (error "Expected exactly six generator specification fields"))
  (let* ((variables (cdr (assq 'variables spec))) (parameters (cdr (assq 'parameters spec)))
         (basis (cdr (assq 'basis spec))) (drift (cdr (assq 'drift spec)))
         (jumps (cdr (assq 'jumps spec))) (queries (cdr (assq 'observations spec))))
    (if (not (and (oc-list? variables 4) (pair? variables) (oc-list? parameters 2)))
        (error "Invalid generator variable lists"))
    (let ((names (append variables parameters)))
    (if (not (and (oc-list? variables 4) (pair? variables) (oc-list? parameters 2)
                  (every symbol? names) (oc-distinct? names)
                  (oc-list? basis 32) (pair? basis) (oc-distinct? basis)
                  (every (lambda (e) (and (oc-list? e 4) (= (length e) (length variables))
                    (every (lambda (x) (and (oc-rational? x) (integer? x) (<= 0 x) (<= x 8))) e))) basis)
                  (oc-list? drift 4) (= (length drift) (length variables))
                  (oc-list? jumps 8) (oc-list? queries 32) (pair? queries)))
        (error "Invalid generator dimensions or names"))
    (list variables parameters (map (lambda (e) (map (lambda (x) x) e)) basis)
          (map (lambda (x) (oc-expression x names 0)) drift)
          (map (lambda (jump)
            (if (not (and (oc-list? jump 2) (= (length jump) 2)
                          (oc-list? (cadr jump) 4) (= (length (cadr jump)) (length variables))))
                (error "Jump needs rate and simultaneous coordinate updates"))
            (list (oc-expression (car jump) names 0)
                  (map (lambda (x) (oc-expression x names 0)) (cadr jump)))) jumps)
          (map (lambda (x) (oc-expression x names 0)) queries)))))
(define (oc-monomial names exponents)
  (oc-poly (poly names (list (cons exponents 1)))))
(define (oc-compose polynomial variables updates)
  (let ((names (cadr polynomial)))
    (fold-left oc-p+ (poly-const 0)
      (map (lambda (term)
        (let ((powers (vector->list (car term))))
          (fold-left oc-p* (poly-const (cdr term))
            (map (lambda (name e)
              (let ((binding (assq name (map cons variables updates))))
                (oc-pow (if binding (cdr binding) (poly-var name)) e))) names powers))))
        (caddr polynomial)))))
(define (oc-source-image model exponents)
  (let* ((variables (car model)) (p (oc-monomial variables exponents))
         (drift (list-ref model 3)) (jumps (list-ref model 4)))
    (fold-left oc-p+ (poly-const 0)
      (append (map (lambda (v b) (oc-p* b (oc-poly (poly-deriv p v)))) variables drift)
              (map (lambda (jump) (oc-p* (car jump)
                (oc-poly (poly- (oc-compose p variables (cadr jump)) p)))) jumps)))))
(define (oc-exponents polynomial term names)
  (map (lambda (name)
    (let find ((vs (cadr polynomial)) (i 0))
      (cond ((null? vs) 0) ((eq? (car vs) name) (vector-ref (car term) i))
            (else (find (cdr vs) (+ i 1)))))) names))
(define (oc-position x xs)
  (let loop ((xs xs) (i 0)) (cond ((null? xs) #f) ((equal? x (car xs)) i) (else (loop (cdr xs) (+ i 1))))))
(define (oc-query-row polynomial model)
  (let* ((basis (caddr model)) (out (make-vector (length basis) 0)))
    (for-each (lambda (term)
      (let ((i (oc-position (oc-exponents polynomial term (car model)) basis)))
        (if (or (not i) (not (every zero? (oc-exponents polynomial term (cadr model)))))
            (error "Query outside declared monomial basis"))
        (vector-set! out i (oc+ (vector-ref out i) (cdr term))))) (caddr polynomial))
    (vector->list out)))
(define (oc-generator-lowering model)
  (let* ((basis (caddr model)) (n (length basis))
         (images (map (lambda (e) (oc-source-image model e)) basis)) (powers '()))
    (for-each (lambda (p) (for-each (lambda (term)
      (let ((e (oc-exponents p term (cadr model))))
        (if (not (member e powers)) (set! powers (append powers (list e)))))) (caddr p))) images)
    (if (null? powers) (set! powers (list (oc-zero (length (cadr model))))))
    (if (> (length powers) 16) (error "Parameter-action budget"))
    (let ((actions (map (lambda (power)
      (let ((rows (map (lambda (p)
        (let ((out (make-vector n 0)))
          (for-each (lambda (term)
            (let ((column (oc-position (oc-exponents p term (car model)) basis)))
              (if (and column (equal? power (oc-exponents p term (cadr model))))
                  (vector-set! out column (oc+ (vector-ref out column) (cdr term)))))) (caddr p))
          (vector->list out))) images)))
        (cons (oc-position power powers) rows))) powers)))
      (list powers (map (lambda (p) (oc-query-row p model)) (list-ref model 5)) actions images))))

;; Independent source replay differentiates monomials by their exponent rule,
;; never calling source-image, symbolic differentiation or the lowering producer.
(define (oc-replay-generator model row)
  (let ((variables (car model)) (basis (caddr model))
        (drift (list-ref model 3)) (jumps (list-ref model 4)))
    (fold-left oc-p+ (poly-const 0)
      (map (lambda (coefficient exponents)
        (let* ((monomial (oc-monomial variables exponents))
               (derivatives
                 (let loop ((es exponents) (bs drift) (i 0) (out '()))
                   (if (null? es) out
                       (loop (cdr es) (cdr bs) (+ i 1)
                         (if (= (car es) 0) out
                             (cons (oc-p* (car bs) (oc-poly (poly-scale
                               (oc-monomial variables
                                 (let lower ((rest exponents) (j 0))
                                   (if (null? rest) '() (cons (- (car rest) (if (= i j) 1 0)) (lower (cdr rest) (+ j 1))))))
                               (car es)))) out))))))
               (changes (map (lambda (jump)
                 (let ((substituted (fold-left oc-p* (poly-const 1)
                                      (map oc-pow (cadr jump) exponents))))
                   (oc-p* (car jump) (oc-poly (poly- substituted monomial))))) jumps)))
          (oc-poly (poly-scale (fold-left oc-p+ (poly-const 0) (append derivatives changes)) coefficient))))
        row basis))))
(define (oc-polynomial-row row model)
  (fold-left oc-p+ (poly-const 0)
    (map (lambda (c e) (oc-poly (poly-scale (oc-monomial (car model) e) c))) row (caddr model))))
(define (verify-generator-closure spec proof)
  (guard (e (else #f))
    (let* ((model (oc-spec spec)) (n (length (caddr model))))
      (and (vector? proof) (= (vector-length proof) 5) (eq? (vector-ref proof 0) 'generator-closure-v1)
           (oc-list? (vector-ref proof 1) 16)
           (every (lambda (power) (and (oc-list? power 2) (= (length power) (length (cadr model)))
             (every (lambda (x) (and (oc-rational? x) (integer? x) (<= 0 x) (<= x 16))) power))) (vector-ref proof 1))
           (oc-distinct? (vector-ref proof 1))
           (let* ((powers (vector-ref proof 1)) (qs (vector-ref proof 2)) (gs (vector-ref proof 3))
                  (linear (vector-ref proof 4)))
             (and (verify-observable-closure qs gs linear)
                  (= n (vector-ref linear 1)) (= (length powers) (length gs))
                  (equal? (map car gs) (let ids ((i 0)) (if (= i (length powers)) '() (cons i (ids (+ i 1))))))
                  (= (length qs) (length (list-ref model 5)))
                  (every (lambda (pair) (poly=? (car pair) (oc-polynomial-row (cadr pair) model)))
                         (map list (list-ref model 5) qs))
                  (let ((basis (vector-ref linear 2)) (reduced (vector-ref linear 4)))
                    (let rows ((rest basis) (i 0))
                      (or (null? rest)
                          (let ((right (fold-left oc-p+ (poly-const 0)
                            (map (lambda (power action)
                              (oc-p* (oc-monomial (cadr model) power)
                                (oc-polynomial-row
                                  (oc-replay (list-ref (cdr action) i) basis n) model))) powers reduced))))
                            (and (poly=? (oc-replay-generator model (car rest)) right)
                                 (rows (cdr rest) (+ i 1)))))))))))))
(define (compile-generator-closure spec . limits)
  (let* ((model (oc-spec spec)) (failure 'unknown)
         (lowered (guard (e (else
                     (if (and (error-object? e) (string=? (error-object-message e) "Query outside declared monomial basis"))
                         (set! failure 'outside-basis)) #f)) (oc-generator-lowering model))))
    (if (not lowered) (oc-result failure #f 'query-or-expansion-refusal 0)
        (let* ((powers (car lowered)) (qs (cadr lowered)) (gs (caddr lowered))
               (result (apply compile-observable-closure qs gs limits)))
          (if (not (eq? (observable-status result) 'closed)) result
              (guard (e (else (oc-result 'unknown #f 'exact-source-admission-refused (vector-ref result 4))))
                (let* ((linear (observable-certificate result)) (basis (vector-ref linear 2))
                       (small (vector-ref linear 4)) (images (list-ref lowered 3))
                       (residual
                         (let rows ((rest basis) (i 0))
                           (if (null? rest) #f
                               (let* ((left (fold-left oc-p+ (poly-const 0)
                                          (map (lambda (c p) (oc-poly (poly-scale p c))) (car rest) images)))
                                      (right (fold-left oc-p+ (poly-const 0)
                                        (map (lambda (power action)
                                          (oc-p* (oc-monomial (cadr model) power)
                                            (oc-polynomial-row (oc-replay (list-ref (cdr action) i) basis (length (caddr model))) model))) powers small)))
                                      (delta (oc-poly (poly- left right))))
                                 (if (poly=? delta (poly-const 0)) (rows (cdr rest) (+ i 1)) delta)))))
                       (proof (vector 'generator-closure-v1 powers qs gs linear)))
                  (cond (residual (oc-result 'outside-basis #f (list 'nonzero-required-generator-residual residual) (vector-ref result 4)))
                        ((verify-generator-closure spec proof)
                         (oc-result 'closed proof 'source-bound-minimal-space (vector-ref result 4)))
                        (else (oc-result 'unknown #f 'independent-source-replay-failed (vector-ref result 4)))))))))))
