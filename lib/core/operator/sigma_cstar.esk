;;; core.operator.sigma_cstar -- finite Boolean sigma-algebras, point-free
;;; L^infty_abs(Sigma) commutative sigma-C*-algebras, and the maximal tensor
;;; product L^infty_abs(Sigma) (x) A (ADR-0062; arXiv:2611.32363 Sec. 2, 6).
;;;
;;; Commutative sigma-C*-algebras are equivalent to Boolean sigma-algebras
;;; (Loregian & Lorenzin 2026, Sec. 2): a finite Boolean sigma-algebra Sigma
;;; with k atoms embeds as L^infty_abs(Sigma) = Q[i]^k (diagonal k x k), and
;;; the maximal tensor product L^infty_abs(Sigma) (x) M_n(Q[i]) is the exact
;;; direct sum of k copies of M_n(Q[i]).

(require stdlib)
(require core.operator.cstar)

(provide
  ;; Finite Boolean sigma-algebra (generated by k named atoms)
  make-boolean-sigma-algebra boolean-sigma-algebra?
  sigma-atom-count sigma-atoms sigma-top sigma-bottom
  sigma-join sigma-meet sigma-complement sigma-disjoint? sigma-event=?
  sigma-tensor-product
  ;; Point-free L^infty_abs(Sigma) commutative sigma-C*-algebra embedding
  sigma-indicator-cmat sigma-l-inf-embed
  ;; Maximal tensor product L^infty_abs(Sigma) (x) M_n(Q[i]) as block-direct-sum
  make-block-cstar block-cstar? block-cstar-count block-cstar-fiber-dim
  block-cstar-ref block-cstar-zero block-cstar-identity
  block-cstar+ block-cstar* block-cstar-adjoint block-cstar=
  block-cstar-pure-tensor block-cstar-commutes?
  ;; sigma-normal monotone order-convergence check on finite bounded chains
  cmat-leq? cmat-monotone-increasing-chain? cmat-sigma-normal-preserves-sup?)

;; ---------------------------------------------------------------------------
;; Finite Boolean sigma-algebra represented by bitmasks/sorted atom index lists
;; ---------------------------------------------------------------------------

(define (sig-range n)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons i acc)))))

(define (sig-sort-dedup xs)
  (let loop ((l xs) (acc '()))
    (if (null? l) acc
        (loop (cdr l)
              (let ins ((x (car l)) (ys acc))
                (cond ((null? ys) (list x))
                      ((= x (car ys)) ys)
                      ((< x (car ys)) (cons x ys))
                      (else (cons (car ys) (ins x (cdr ys))))))))))

(define (make-boolean-sigma-algebra atom-names)
  (let ((names (if (vector? atom-names) atom-names (list->vector atom-names))))
    (vector 'boolean-sigma-alg-v1 (vector-length names) names)))

(define (boolean-sigma-algebra? s)
  (and (vector? s) (= (vector-length s) 3) (eq? (vector-ref s 0) 'boolean-sigma-alg-v1)))

(define (sigma-atom-count s) (vector-ref s 1))
(define (sigma-atoms s) (sig-range (sigma-atom-count s)))
(define (sigma-bottom s) '())
(define (sigma-top s) (sig-range (sigma-atom-count s)))

(define (sigma-join s u v) (sig-sort-dedup (append u v)))
(define (sigma-meet s u v) (sig-sort-dedup (filter (lambda (x) (memv x v)) u)))
(define (sigma-complement s u) (filter (lambda (x) (not (memv x u))) (sigma-top s)))
(define (sigma-disjoint? s u v) (null? (sigma-meet s u v)))
(define (sigma-event=? u v) (equal? (sig-sort-dedup u) (sig-sort-dedup v)))

;; Universal tensor product Sigma (x) Sigma' of finite Boolean sigma-algebras:
;; atoms are ordered pairs (i, j) indexed by i * k2 + j.
(define (sigma-tensor-product s1 s2)
  (let* ((k1 (sigma-atom-count s1))
         (k2 (sigma-atom-count s2))
         (n1 (vector-ref s1 2))
         (n2 (vector-ref s2 2))
         (out (make-vector (* k1 k2) #f)))
    (let li ((i 0))
      (if (< i k1)
          (begin
            (let lj ((j 0))
              (if (< j k2)
                  (begin
                    (vector-set! out (+ (* i k2) j)
                                 (cons (vector-ref n1 i) (vector-ref n2 j)))
                    (lj (+ j 1)))))
            (li (+ i 1)))))
    (make-boolean-sigma-algebra out)))

;; Indicator projection 1_U in L^infty_abs(Sigma) <= M_k(Q[i]) (diagonal)
(define (sigma-indicator-cmat s event)
  (let* ((k (sigma-atom-count s))
         (m (cmat-zero k)))
    (for-each (lambda (idx) (cmat-set! m idx idx qi-one)) event)
    m))

;; Embed bounded measurable function f: atoms -> Q[i] into diagonal M_k(Q[i])
(define (sigma-l-inf-embed s vals)
  (let* ((k (sigma-atom-count s))
         (m (cmat-zero k)))
    (let loop ((i 0))
      (if (< i k)
          (begin
            (let ((v (vector-ref vals i)))
              (cmat-set! m i i (if (pair? v) v (qi v 0))))
            (loop (+ i 1)))))
    m))

;; ---------------------------------------------------------------------------
;; Maximal tensor product L^infty_abs(Sigma) (x) M_n(Q[i]) = direct sum of k
;; copies of M_n(Q[i]) (arXiv:2611.32363 Sec. 6)
;; ---------------------------------------------------------------------------

(define (make-block-cstar blocks)
  (let* ((bv (if (vector? blocks) blocks (list->vector blocks)))
         (k (vector-length bv))
         (d (if (> k 0) (cmat-dim (vector-ref bv 0)) 0)))
    (vector 'block-cstar-v1 k d bv)))

(define (block-cstar? x)
  (and (vector? x) (= (vector-length x) 4) (eq? (vector-ref x 0) 'block-cstar-v1)))

(define (block-cstar-count x) (vector-ref x 1))
(define (block-cstar-fiber-dim x) (vector-ref x 2))
(define (block-cstar-ref x i) (vector-ref (vector-ref x 3) i))

(define (block-cstar-zero k n)
  (let ((bv (make-vector k #f)))
    (let loop ((i 0))
      (if (< i k) (begin (vector-set! bv i (cmat-zero n)) (loop (+ i 1)))))
    (make-block-cstar bv)))

(define (block-cstar-identity k n)
  (let ((bv (make-vector k #f)))
    (let loop ((i 0))
      (if (< i k) (begin (vector-set! bv i (cmat-identity n)) (loop (+ i 1)))))
    (make-block-cstar bv)))

(define (block-cstar+ X Y)
  (let* ((k (block-cstar-count X)) (bv (make-vector k #f)))
    (let loop ((i 0))
      (if (< i k)
          (begin (vector-set! bv i (cmat+ (block-cstar-ref X i) (block-cstar-ref Y i)))
                 (loop (+ i 1)))))
    (make-block-cstar bv)))

(define (block-cstar* X Y)
  (let* ((k (block-cstar-count X)) (bv (make-vector k #f)))
    (let loop ((i 0))
      (if (< i k)
          (begin (vector-set! bv i (cmat* (block-cstar-ref X i) (block-cstar-ref Y i)))
                 (loop (+ i 1)))))
    (make-block-cstar bv)))

(define (block-cstar-adjoint X)
  (let* ((k (block-cstar-count X)) (bv (make-vector k #f)))
    (let loop ((i 0))
      (if (< i k)
          (begin (vector-set! bv i (cmat-adjoint (block-cstar-ref X i)))
                 (loop (+ i 1)))))
    (make-block-cstar bv)))

(define (block-cstar= X Y)
  (and (= (block-cstar-count X) (block-cstar-count Y))
       (let ((k (block-cstar-count X)))
         (let loop ((i 0))
           (cond ((= i k) #t)
                 ((cmat= (block-cstar-ref X i) (block-cstar-ref Y i)) (loop (+ i 1)))
                 (else #f))))))

(define (block-cstar-commutes? X Y)
  (block-cstar= (block-cstar* X Y) (block-cstar* Y X)))

;; Pure tensor (f (x) A) in L^infty_abs(Sigma) (x) M_n(Q[i]):
;; fiber i holds f(i) * A.
(define (block-cstar-pure-tensor s vals A)
  (let* ((k (sigma-atom-count s))
         (bv (make-vector k #f)))
    (let loop ((i 0))
      (if (< i k)
          (begin (vector-set! bv i (cmat-scale (vector-ref vals i) A))
                 (loop (+ i 1)))))
    (make-block-cstar bv)))

;; ---------------------------------------------------------------------------
;; Loewner operator order A <= B iff (B - A) is exact Hermitian PSD
;; ---------------------------------------------------------------------------

(define (cmat-leq? A B)
  (cmat-psd? (cmat- B A)))

(define (cmat-monotone-increasing-chain? seq)
  (cond ((or (null? seq) (null? (cdr seq))) #t)
        ((cmat-leq? (car seq) (cadr seq))
         (cmat-monotone-increasing-chain? (cdr seq)))
        (else #f)))

;; Verify a map phi preserves the supremum (last element) of a finite bounded
;; increasing chain and stays monotone throughout.
(define (cmat-sigma-normal-preserves-sup? phi chain sup-el)
  (and (cmat-monotone-increasing-chain? chain)
       (let ((mapped (map phi chain))
             (mapped-sup (phi sup-el)))
         (and (cmat-monotone-increasing-chain? mapped)
              (let loop ((ms mapped))
                (cond ((null? ms) #t)
                      ((cmat-leq? (car ms) mapped-sup) (loop (cdr ms)))
                      (else #f)))))))
