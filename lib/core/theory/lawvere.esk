;;; core.theory.lawvere -- the Lawvere theory of an algebraic theory: the
;;; category with finite products whose objects are the natural numbers and
;;; whose morphisms n -> m are m-tuples of terms in n variables modulo the
;;; equations; models as finite-product-preserving functors to sets; and the
;;; standard interpretations between the catalogue theories.
;;;
;;; ADR-0039. Lawvere's thesis (1963) presents an algebraic theory T as the
;;; category L_T: object n is the n-th power of the generic model, a
;;; morphism n -> m is an m-tuple (t1 ... tm) of terms in the variables
;;; x1 ... xn, composition is substitution, n + m is the product of n and m
;;; with the projections given by variables, and two morphisms are equal
;;; exactly when T proves their components equal (decided by the word
;;; problem of core.theory.free). L_T is the opposite of the category of
;;; finitely generated free T-models: (lawvere-free-homomorphism f) is the
;;; homomorphism F(m) -> F(n) sending generator x_j to t_j. A model M is the
;;; product-preserving functor n -> M^n, a morphism acting by evaluation.
;;;
;;;; The symbolic category part is kept to what L_T needs (objects,
;;; morphisms, identities, composition, products, pairing, equality). When
;;; the free models on at most N generators are finite (Boolean algebras,
;;; distributive lattices, modules over a finite ring),
;;; (lawvere-truncation T N) is the full subcategory on 0 .. N as a finite
;;; category in the representation of core.sheaf.site, the one core.category
;;; (ADR-0036) builds on, so its category laws and constructions apply.
;;;
;;; References: F. W. Lawvere, "Functorial Semantics of Algebraic Theories"
;;; (1963); Adamek, Rosicky, Vitale, "Algebraic Theories" (2011), chapters
;;; 1, 11 and 13; nLab, "Lawvere theory".

(require core.theory.equational)
(require core.theory.free)
(require core.sheaf.site)

(provide lawvere-category lawvere-category? lawvere-category-theory lawvere-variables
         lawvere-morphism lawvere-morphism? lawvere-source lawvere-target lawvere-terms
         lawvere-identity lawvere-compose lawvere-projections lawvere-pairing
         lawvere-morphism=? lawvere-apply lawvere-free-homomorphism lawvere-truncation
         monoid->semigroup group->monoid abelian-group->group group->abelian-group ring->abelian-group ring->monoid
         commutative-ring->ring ring->commutative-ring lattice->heyting-algebra
         heyting-algebra->boolean-algebra lattice->distributive-lattice
         distributive-lattice->boolean-algebra)

(define (tl-range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (tl-take xs k) (if (= k 0) '() (cons (car xs) (tl-take (cdr xs) (- k 1)))))
(define (tl-subset? xs ys) (or (null? xs) (and (memq (car xs) ys) (tl-subset? (cdr xs) ys))))
(define (tl-drop xs k) (if (= k 0) xs (tl-drop (cdr xs) (- k 1))))

(define (lawvere-category T) (vector 'lawvere-v1 T))
(define (lawvere-category? x) (and (vector? x) (= (vector-length x) 2) (eq? (vector-ref x 0) 'lawvere-v1)))
(define (lawvere-category-theory L) (vector-ref L 1))

;; The variables of object n: x1 ... xn.
(define (lawvere-variables n)
  (map (lambda (i) (string->symbol (string-append "x" (number->string (+ i 1))))) (tl-range n)))

;; The morphism n -> (length terms) with the given components, each a term
;; of the theory in the variables x1 ... xn.
(define (lawvere-morphism L n terms)
  (let ((T (lawvere-category-theory L)) (vars (lawvere-variables n)))
    (for-each (lambda (t)
                (if (not (and (well-formed-term? T t)
                              (tl-subset? (term-variables t) vars)))
                    (error "theory-ill-formed-term" 'lawvere-morphism t)))
              terms)
    (vector 'lawvere-morphism-v1 L n terms)))
(define (lawvere-morphism? x) (and (vector? x) (= (vector-length x) 4) (eq? (vector-ref x 0) 'lawvere-morphism-v1)))
(define (lawvere-source f) (vector-ref f 2))
(define (lawvere-target f) (length (vector-ref f 3)))
(define (lawvere-terms f) (vector-ref f 3))

(define (lawvere-identity L n) (lawvere-morphism L n (lawvere-variables n)))
;; g after f, for f : n -> m and g : m -> k: substitute f's components for
;; g's variables.
(define (lawvere-compose g f)
  (if (not (= (lawvere-source g) (lawvere-target f)))
      (error "lawvere-compose: the target of f is not the source of g" (lawvere-target f) (lawvere-source g)))
  (let ((subst (map (lambda (x t) (cons x t)) (lawvere-variables (lawvere-target f)) (lawvere-terms f))))
    (lawvere-morphism (vector-ref g 1) (lawvere-source f)
                      (map (lambda (t) (term-substitute t subst)) (lawvere-terms g)))))
;; The two projections of the product n + m: (n + m -> n, n + m -> m).
(define (lawvere-projections L n m)
  (let ((vars (lawvere-variables (+ n m))))
    (list (lawvere-morphism L (+ n m) (tl-take vars n))
          (lawvere-morphism L (+ n m) (tl-drop vars n)))))
;; <f, g> : k -> n + m for f : k -> n and g : k -> m.
(define (lawvere-pairing f g)
  (if (not (= (lawvere-source f) (lawvere-source g)))
      (error "lawvere-pairing: the sources differ" (lawvere-source f) (lawvere-source g)))
  (lawvere-morphism (vector-ref f 1) (lawvere-source f) (append (lawvere-terms f) (lawvere-terms g))))
;; Equality of morphisms: equal sources and targets and every component
;; equal in the theory.
(define (lawvere-morphism=? f g)
  (let ((T (lawvere-category-theory (vector-ref f 1))))
    (and (= (lawvere-source f) (lawvere-source g)) (= (lawvere-target f) (lawvere-target g))
         (let loop ((s (lawvere-terms f)) (t (lawvere-terms g)))
           (or (null? s)
               (and (theory-word-problem T (car s) (car t)) (loop (cdr s) (cdr t))))))))

;; The functor of a model: f : n -> m acts on a list of n elements.
(define (lawvere-apply M f xs)
  (let ((env (map (lambda (x v) (cons x v)) (lawvere-variables (lawvere-source f)) xs)))
    (map (lambda (t) (model-evaluate M t env)) (lawvere-terms f))))

;; The homomorphism F(m) -> F(n) of free models on x1 ... xm and x1 ... xn
;; that f : n -> m names (contravariant: L_T is the opposite of free models).
(define (lawvere-free-homomorphism f)
  (let* ((T (lawvere-category-theory (vector-ref f 1)))
         (n (lawvere-source f)) (m (lawvere-target f))
         (Fm (theory-free-model T (lawvere-variables m)))
         (Fn (theory-free-model T (lawvere-variables n)))
         (images (map (lambda (x t) (cons x (model-evaluate Fn t (model-ref Fn 'generators))))
                      (lawvere-variables m) (lawvere-terms f))))
    (list Fm Fn (free-model-lift Fm Fn images))))

;; The full subcategory of L_T on the objects 0 .. N as a core.sheaf.site
;; finite category. Arrow n -> m is named (n m (e1 ... em)), the ei elements
;; of the free model on x1 ... xn; composition evaluates in free models.
(define (lawvere-truncation T N)
  (let* ((objs (tl-range (+ N 1)))
         (frees (list->vector (map (lambda (n) (theory-free-model T (lawvere-variables n))) objs)))
         (checked (for-each (lambda (n) (if (not (model-finite? (vector-ref frees n)))
                                      (error "theory-infinite-model" 'lawvere-truncation (theory-name T))))
                      objs))
         (arrows '()) (index (make-hash-table)) (count 0))
    (for-each (lambda (n)
                (for-each (lambda (m)
                            (for-each (lambda (tuple)
                                        (hash-table-set! index (list n m tuple) count)
                                        (set! arrows (cons (vector n m (list n m tuple)) arrows))
                                        (set! count (+ count 1)))
                                      (tl-tuples (model-elements (vector-ref frees n)) m)))
                          objs))
              objs)
    (let* ((av (list->vector (reverse arrows)))
           (compose (lambda (g f)
                      (let* ((fn (vector-ref av f)) (gn (vector-ref av g))
                             (n (vector-ref fn 0)) (m (vector-ref fn 1)) (k (vector-ref gn 1))
                             (Fm (vector-ref frees m)) (Fn (vector-ref frees n))
                             (lift (free-model-lift Fm Fn (map (lambda (x e) (cons x e)) (lawvere-variables m) (caddr (vector-ref fn 2))))))
                        (hash-table-ref/default index (list n k (map (lambda (e) (lift e)) (caddr (vector-ref gn 2)))) #f))))
           (ids (map (lambda (n) (hash-table-ref/default index (list n n (map (lambda (x) (free-model-generator (vector-ref frees n) x)) (lawvere-variables n))) #f))
                     objs)))
      (make-finite-category (+ N 1) (vector->list av) compose ids objs))))
(define (tl-tuples xs k)
  (if (= k 0) (list '()) (apply append (map (lambda (x) (map (lambda (r) (cons x r)) (tl-tuples xs (- k 1)))) xs))))

;; ---------------------------------------------------------------------------
;; Interpretations between the catalogue theories (morphisms of Lawvere
;; theories); the reduct along each is the forgetful functor on models.
;; ---------------------------------------------------------------------------

(define monoid->semigroup
  (make-interpretation semigroup-theory monoid-theory (list (list 'mul '(x y) '(mul x y)))))
(define group->monoid
  (make-interpretation monoid-theory group-theory
                       (list (list 'one '() '(one)) (list 'mul '(x y) '(mul x y)))))
;; An abelian group, written additively, is a group.
(define abelian-group->group
  (make-interpretation group-theory abelian-group-theory
                       (list (list 'one '() '(zero)) (list 'mul '(x y) '(add x y)) (list 'inv '(x) '(neg x)))))
;; A group read in additive notation: not a morphism of theories (groups do
;; not prove commutativity); the reduct of a group along it satisfies the
;; abelian group laws exactly when the group is abelian.
(define group->abelian-group
  (make-interpretation abelian-group-theory group-theory
                       (list (list 'zero '() '(one)) (list 'add '(x y) '(mul x y)) (list 'neg '(x) '(inv x)))))
(define ring->abelian-group
  (make-interpretation abelian-group-theory ring-theory
                       (list (list 'zero '() '(zero)) (list 'add '(x y) '(add x y)) (list 'neg '(x) '(neg x)))))
(define ring->monoid
  (make-interpretation monoid-theory ring-theory
                       (list (list 'one '() '(one)) (list 'mul '(x y) '(mul x y)))))
(define tl-ring-identity
  (list (list 'zero '() '(zero)) (list 'one '() '(one)) (list 'add '(x y) '(add x y))
        (list 'neg '(x) '(neg x)) (list 'mul '(x y) '(mul x y))))
;; Every commutative ring is a ring.
(define commutative-ring->ring (make-interpretation ring-theory commutative-ring-theory tl-ring-identity))
;; The identity on symbols from commutative rings to rings: not a morphism
;; of theories (rings do not prove commutativity); interpretation-violations
;; names the equation.
(define ring->commutative-ring (make-interpretation commutative-ring-theory ring-theory tl-ring-identity))
(define tl-lattice-ops (list (list 'meet '(x y) '(meet x y)) (list 'join '(x y) '(join x y))))
(define lattice->heyting-algebra (make-interpretation lattice-theory heyting-algebra-theory tl-lattice-ops))
(define lattice->distributive-lattice (make-interpretation lattice-theory distributive-lattice-theory tl-lattice-ops))
(define distributive-lattice->boolean-algebra
  (make-interpretation distributive-lattice-theory boolean-algebra-theory tl-lattice-ops))
;; A Boolean algebra is a Heyting algebra with x -> y = (not x) \/ y.
(define heyting-algebra->boolean-algebra
  (make-interpretation heyting-algebra-theory boolean-algebra-theory
                       (append (list (list 'bottom '() '(bottom)) (list 'top '() '(top))
                                     (list 'implies '(x y) '(join (complement x) y)))
                               tl-lattice-ops)))
