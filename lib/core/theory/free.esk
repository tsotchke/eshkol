;;; core.theory.free -- free models on finite generators and the word
;;; problem for every theory of the catalogue of core.theory.equational.
;;;
;;; ADR-0039. (theory-free-model T generators) is the free T-model on a list
;;; of generator symbols, with an equality that decides the word problem:
;;;
;;;   absolutely free  terms, syntactic equality (a theory with no equations)
;;;   semigroups       nonempty words
;;;   monoids          words
;;;   groups           freely reduced words over the generators and inverses
;;;   abelian groups   integer coefficient vectors, Z^n
;;;   rings            Z<X>, integer combinations of words, as core.dbsp Z-sets
;;;   commutative      Z[X], core.ring's monoid ring on exponent vectors
;;;     rings          (zset-group-ring), as a model through ring-carrier->model
;;;   lattices         terms; s <= t decided by Whitman's conditions
;;;   distributive     monotone Boolean functions (truth tables): the variety
;;;     lattices       is generated by the two-element lattice
;;;   Boolean algebras truth tables over the 2^n assignments
;;;   Heyting algebras terms; s <= t iff s |- t in intuitionistic
;;;                    propositional logic, decided by Dyckhoff's
;;;                    contraction-free sequent calculus G4ip
;;;   R-modules        coefficient vectors R^n (R finite)
;;;
;;; Every free model records (model-ref F 'generators), an alist generator
;;; -> element, and (model-ref F 'to-term), a procedure giving a term over
;;; the generators for each element; (free-model-lift F M images) is then
;;; the unique homomorphism F -> M extending the images of the generators.
;;; A theory of kind 'user with equations has no decision procedure here,
;;; and is refused by name.
;;;
;;; Sources: J. M. Whitman, "Free lattices", Ann. of Math. 42 (1941);
;;; R. Dyckhoff, "Contraction-free sequent calculi for intuitionistic
;;; logic", J. Symbolic Logic 57 (1992); W. Magnus, A. Karrass, D. Solitar,
;;; "Combinatorial Group Theory" (1966), 1.4 (free reduction); Burris and
;;; Sankappanavar II.10-II.11 (free algebras, the variety generated by an
;;; algebra).

(require core.theory.equational)
(require core.dbsp)
(require core.ring)

(provide theory-free-model free-model-generator free-model-lift free-element->term
         theory-word-problem theory-normal-form
         interpretation-violations
         lattice-leq? heyting-provable?)

;; ---------------------------------------------------------------------------
;; Private helpers (prefixed tf-)
;; ---------------------------------------------------------------------------
(define (tf-range n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (tf-tuples xs k)
  (if (= k 0) (list '())
      (let ((rest (tf-tuples xs (- k 1))))
        (apply append (map (lambda (x) (map (lambda (t) (cons x t)) rest)) xs)))))
(define (tf-position x xs)
  (let loop ((xs xs) (i 0)) (cond ((null? xs) #f) ((equal? (car xs) x) i) (else (loop (cdr xs) (+ i 1))))))
(define (tf-repeat x n) (if (<= n 0) '() (cons x (tf-repeat x (- n 1)))))
;; A left-nested fold of a binary operation over terms, or unit when empty.
(define (tf-fold-op op terms unit)
  (if (null? terms) unit
      (fold-left (lambda (acc t) (list op acc t)) (car terms) (cdr terms))))
;; n copies of a term summed with add, negated when n < 0; zero when n = 0.
(define (tf-multiple n t)
  (cond ((= n 0) '(zero))
        ((< n 0) (list 'neg (tf-multiple (- n) t)))
        (else (tf-fold-op 'add (tf-repeat t n) '(zero)))))

(define (tf-model T name ops elements same gens to-term)
  (make-model T name 'operations ops 'elements elements 'equal? same
              'extra (list (cons 'generators gens) (cons 'to-term to-term) (cons 'free #t))))
(define (tf-name T gens)
  (string-append "F_" (theory-name T) "("
                 (fold-left (lambda (s g) (if (string=? s "") (symbol->string g) (string-append s "," (symbol->string g))))
                            "" gens)
                 ")"))

;; ---------------------------------------------------------------------------
;; The dispatcher
;; ---------------------------------------------------------------------------

(define (theory-free-model T gens)
  (for-each (lambda (g) (if (not (symbol? g)) (error "theory-free-model: a generator must be a symbol" g))) gens)
  (let ((k (theory-kind T)))
    (cond ((eq? k 'absolutely-free) (tf-term-model T gens))
          ((eq? k 'semigroup) (tf-words T gens #f))
          ((eq? k 'monoid) (tf-words T gens #t))
          ((eq? k 'group) (tf-free-group T gens))
          ((eq? k 'abelian-group) (tf-free-abelian T gens))
          ((eq? k 'ring) (tf-free-ring T gens))
          ((eq? k 'commutative-ring) (tf-free-commutative-ring T gens))
          ((eq? k 'lattice) (tf-decided-terms T gens lattice-leq?))
          ((eq? k 'heyting-algebra) (tf-decided-terms T gens heyting-provable?))
          ((eq? k 'distributive-lattice) (tf-truth-tables T gens #f))
          ((eq? k 'boolean-algebra) (tf-truth-tables T gens #t))
          ((eq? k 'module) (tf-free-module T gens))
          (else (error "theory-no-decision-procedure" 'theory-free-model (theory-name T))))))

(define (free-model-generator F g)
  (let ((p (assq g (or (model-ref F 'generators) (error "free-model-generator: not a free model" (model-name F))))))
    (if p (cdr p) (error "free-model-generator: not a generator" g))))
(define (free-element->term F x) ((model-ref F 'to-term) x))
;; The homomorphism F -> M sending each generator g to (cdr (assq g images)).
(define (free-model-lift F M images)
  (let ((to-term (model-ref F 'to-term)) (gens (map car (model-ref F 'generators))))
    (lambda (x)
      (model-evaluate M (to-term x) (map (lambda (g) (cons g (cdr (assq g images)))) gens)))))

;; The element of the free model on the variables of t that t denotes.
(define (theory-normal-form T t . generators)
  (let* ((gens (if (pair? generators) (car generators) (term-variables t)))
         (F (theory-free-model T gens)))
    (model-evaluate F t (model-ref F 'generators))))
;; Whether T proves s = t: both evaluated in the free model on their
;; variables, compared by its equality.
(define (theory-word-problem T s t)
  (let* ((gens (term-variables (list 'pair s t)))
         (F (theory-free-model T gens)) (env (model-ref F 'generators)))
    (model-equal? F (model-evaluate F s env) (model-evaluate F t env))))

;; The equations of the source theory whose translation the target theory
;; does not prove: empty exactly when the interpretation is a morphism of
;; theories (of Lawvere theories).
(define (interpretation-violations I)
  (let ((T (interpretation-target I)))
    (map equation-name
         (filter (lambda (e)
                   (not (theory-word-problem T (interpretation-translate I (equation-lhs e))
                                             (interpretation-translate I (equation-rhs e)))))
                 (theory-equations (interpretation-source I))))))

;; ---------------------------------------------------------------------------
;; Terms: absolutely free models, and models decided by an order
;; ---------------------------------------------------------------------------

(define (tf-term-ops T)
  (map (lambda (op)
         (cons op (if (= 0 (theory-arity T op)) (list op) (lambda args (cons op args)))))
       (theory-operations T)))
(define (tf-term-model T gens)
  (tf-model T (tf-name T gens) (tf-term-ops T) #f equal?
            (map (lambda (g) (cons g g)) gens) (lambda (x) x)))
(define (tf-decided-terms T gens leq?)
  (tf-model T (tf-name T gens) (tf-term-ops T) #f
            (lambda (s t) (and (leq? s t) (leq? t s)))
            (map (lambda (g) (cons g g)) gens) (lambda (x) x)))

;; Whitman's solution of the word problem for free lattices: s <= t.
(define (lattice-leq? s t)
  (cond ((and (pair? s) (eq? (car s) 'join)) (and (lattice-leq? (cadr s) t) (lattice-leq? (caddr s) t)))
        ((and (pair? t) (eq? (car t) 'meet)) (and (lattice-leq? s (cadr t)) (lattice-leq? s (caddr t))))
        ((and (symbol? s) (symbol? t)) (eq? s t))
        ((symbol? s) (or (lattice-leq? s (cadr t)) (lattice-leq? s (caddr t))))
        ((symbol? t) (or (lattice-leq? (cadr s) t) (lattice-leq? (caddr s) t)))
        (else (or (lattice-leq? (cadr s) t) (lattice-leq? (caddr s) t)
                  (lattice-leq? s (cadr t)) (lattice-leq? s (caddr t))))))

;; Intuitionistic propositional provability of s |- t (G4ip). Formulas are
;; Heyting terms: variables, (top), (bottom), (meet a b), (join a b),
;; (implies a b).
(define (heyting-provable? s t) (tf-g4 (list s) t))
(define (tf-op? f op) (and (pair? f) (eq? (car f) op)))
(define (tf-remove f gamma)
  (cond ((null? gamma) '()) ((eq? (car gamma) f) (cdr gamma)) (else (cons (car gamma) (tf-remove f (cdr gamma))))))
(define (tf-has-atom? p gamma) (and (memq p gamma) #t))
;; The first formula of gamma an invertible left rule applies to, or #f.
(define (tf-invertible gamma)
  (let loop ((gs gamma))
    (if (null? gs) #f
        (let ((f (car gs)))
          (cond ((or (tf-op? f 'bottom) (tf-op? f 'top) (tf-op? f 'meet) (tf-op? f 'join)) f)
                ((tf-op? f 'implies)
                 (let ((a (cadr f)))
                   (if (or (and (symbol? a) (tf-has-atom? a gamma))
                           (tf-op? a 'bottom) (tf-op? a 'top) (tf-op? a 'meet) (tf-op? a 'join))
                       f
                       (loop (cdr gs)))))
                (else (loop (cdr gs))))))))
(define (tf-g4 gamma c)
  (cond
    ((tf-op? c 'top) #t)
    ((tf-op? c 'meet) (and (tf-g4 gamma (cadr c)) (tf-g4 gamma (caddr c))))
    ((tf-op? c 'implies) (tf-g4 (cons (cadr c) gamma) (caddr c)))
    (else
     (let ((f (tf-invertible gamma)))
       (if f
           (let ((rest (tf-remove f gamma)))
             (cond
               ((tf-op? f 'bottom) #t)
               ((tf-op? f 'top) (tf-g4 rest c))
               ((tf-op? f 'meet) (tf-g4 (cons (cadr f) (cons (caddr f) rest)) c))
               ((tf-op? f 'join) (and (tf-g4 (cons (cadr f) rest) c) (tf-g4 (cons (caddr f) rest) c)))
               (else
                (let ((a (cadr f)) (b (caddr f)))
                  (cond ((symbol? a) (tf-g4 (cons b rest) c))
                        ((tf-op? a 'bottom) (tf-g4 rest c))
                        ((tf-op? a 'top) (tf-g4 (cons b rest) c))
                        ((tf-op? a 'meet) (tf-g4 (cons (list 'implies (cadr a) (list 'implies (caddr a) b)) rest) c))
                        (else (tf-g4 (cons (list 'implies (cadr a) b) (cons (list 'implies (caddr a) b) rest)) c)))))))
           ;; gamma: atoms, p -> b with p absent, (c -> d) -> b
           (or (and (symbol? c) (tf-has-atom? c gamma))
               (and (tf-op? c 'join) (or (tf-g4 gamma (cadr c)) (tf-g4 gamma (caddr c))))
               (tf-g4-left-implications gamma gamma c)))))))
(define (tf-g4-left-implications gamma gs c)
  (if (null? gs) #f
      (let ((f (car gs)))
        (or (and (tf-op? f 'implies) (tf-op? (cadr f) 'implies)
                 (let* ((a (cadr f)) (b (caddr f)) (rest (tf-remove f gamma)))
                   (and (tf-g4 (cons (list 'implies (caddr a) b) rest) a)
                        (tf-g4 (cons b rest) c))))
            (tf-g4-left-implications gamma (cdr gs) c)))))

;; ---------------------------------------------------------------------------
;; Words: semigroups, monoids, groups
;; ---------------------------------------------------------------------------

(define (tf-words T gens unit?)
  (tf-model T (tf-name T gens)
            (append (list (cons 'mul (lambda (a b) (append a b))))
                    (if unit? (list (cons 'one '())) '()))
            #f equal?
            (map (lambda (g) (cons g (list g))) gens)
            (lambda (w) (tf-fold-op 'mul w '(one)))))

;; A letter is (g . 1) or (g . -1); a word is freely reduced when no letter
;; is followed by its inverse.
(define (tf-reduce-product a b)
  ;; a and b reduced: cancel at the junction
  (let loop ((ra (reverse a)) (b b))
    (if (and (pair? ra) (pair? b) (eq? (car (car ra)) (car (car b))) (= (cdr (car ra)) (- (cdr (car b)))))
        (loop (cdr ra) (cdr b))
        (append (reverse ra) b))))
(define (tf-free-group T gens)
  (tf-model T (tf-name T gens)
            (list (cons 'one '())
                  (cons 'mul tf-reduce-product)
                  (cons 'inv (lambda (w) (map (lambda (l) (cons (car l) (- (cdr l)))) (reverse w)))))
            #f equal?
            (map (lambda (g) (cons g (list (cons g 1)))) gens)
            (lambda (w) (tf-fold-op 'mul (map (lambda (l) (if (= (cdr l) 1) (car l) (list 'inv (car l)))) w) '(one)))))

(define (tf-free-abelian T gens)
  (tf-model T (tf-name T gens)
            (list (cons 'zero (map (lambda (g) 0) gens))
                  (cons 'add (lambda (a b) (map + a b)))
                  (cons 'neg (lambda (a) (map - a))))
            #f equal?
            (map (lambda (g) (cons g (map (lambda (h) (if (eq? g h) 1 0)) gens))) gens)
            (lambda (v) (tf-fold-op 'add (filter (lambda (t) (not (equal? t '(zero))))
                                                 (map tf-multiple v gens))
                                    '(zero)))))

;; ---------------------------------------------------------------------------
;; Rings: integer combinations of monomials as core.dbsp Z-sets
;; ---------------------------------------------------------------------------

(define (tf-linear-term monomial->term z)
  (tf-fold-op 'add (map (lambda (e) (tf-multiple (car e) (monomial->term (cadr e)))) (zset-entries z)) '(zero)))

;; Z<X>: the monoid ring of the free monoid; a monomial is a word.
(define (tf-free-ring T gens)
  (tf-model T (tf-name T gens)
            (list (cons 'zero (zset-empty)) (cons 'one (zset-singleton '() 1))
                  (cons 'add zset-add) (cons 'neg zset-negate)
                  (cons 'mul (lambda (a b) (zset-join a b (lambda (r) 0) (lambda (r) 0) append))))
            #f zset=?
            (map (lambda (g) (cons g (zset-singleton (list g) 1))) gens)
            (lambda (z) (tf-linear-term (lambda (w) (tf-fold-op 'mul w '(one))) z))))

;; Z[X]: core.ring's monoid ring on the free commutative monoid N^n
;; (exponent vectors), the same construction as its group rings Z[G].
(define (tf-free-commutative-ring T gens)
  (let* ((unit (map (lambda (g) 0) gens))
         (R (zset-group-ring (lambda (a b) (map + a b)) unit #f (tf-name T gens)))
         (M (ring-carrier->model R))
         (monomial (lambda (exps)
                     (tf-fold-op 'mul (apply append (map (lambda (e g) (tf-repeat g e)) exps gens)) '(one)))))
    (make-model T (tf-name T gens)
                'operations (map (lambda (op) (cons op (model-operation M op))) (theory-operations T))
                'equal? zset=?
                'extra (list (cons 'generators (map (lambda (g) (cons g (zset-singleton (map (lambda (h) (if (eq? g h) 1 0)) gens) 1))) gens))
                             (cons 'to-term (lambda (z) (tf-linear-term monomial z)))
                             (cons 'free #t) (cons 'ring-carrier R)))))

;; ---------------------------------------------------------------------------
;; Truth tables: distributive lattices and Boolean algebras
;; ---------------------------------------------------------------------------
;;
;; An element is the list of its values (0 or 1) at the 2^n assignments of
;; the generators, assignments in lexicographic order (first generator most
;; significant). The free model lists its elements when it has at most 4096.

(define (tf-truth-tables T gens boolean?)
  (let* ((n (length gens)) (points (tf-tuples '(0 1) n))
         (gen-table (lambda (i) (map (lambda (p) (list-ref p i)) points)))
         (all (lambda (v) (map (lambda (p) v) points)))
         (meet (lambda (a b) (map min a b))) (join (lambda (a b) (map max a b)))
         (minterm (lambda (p) (tf-fold-op 'meet (map (lambda (v g) (if (= v 1) g (list 'complement g))) p gens) '(top))))
         (monotone? (lambda (f) (tf-monotone? points f)))
         (to-term
          (if boolean?
              (lambda (f) (tf-fold-op 'join (filter (lambda (x) x) (map (lambda (p v) (and (= v 1) (minterm p))) points f)) '(bottom)))
              ;; join over the minimal true points of the meets of their true generators
              (lambda (f)
                (let* ((true-points (filter (lambda (x) x) (map (lambda (p v) (and (= v 1) p)) points f)))
                       (minimal (filter (lambda (p) (not (tf-any-below? p true-points))) true-points)))
                  (tf-fold-op 'join
                              (map (lambda (p) (tf-fold-op 'meet (filter (lambda (x) x) (map (lambda (v g) (and (= v 1) g)) p gens)) '(top)))
                                   minimal)
                              '(bottom))))))
         (count (expt 2 (expt 2 n)))
         (elements (if (<= count 4096)
                       (let ((tables (tf-tuples '(0 1) (length points))))
                         (if boolean? tables
                             (filter (lambda (f) (and (monotone? f) (= 0 (car f)) (= 1 (list-ref f (- (length f) 1)))))
                                     tables)))
                       #f)))
    (tf-model T (tf-name T gens)
              (append (list (cons 'meet meet) (cons 'join join))
                      (if boolean?
                          (list (cons 'bottom (all 0)) (cons 'top (all 1))
                                (cons 'complement (lambda (a) (map (lambda (v) (- 1 v)) a))))
                          '()))
              elements equal?
              (map (lambda (g i) (cons g (gen-table i))) gens (tf-range n))
              to-term)))
;; f(p) = 1 and p <= q imply f(q) = 1
(define (tf-monotone? points f)
  (let ((pairs (map cons points f)))
    (tf-every? (lambda (pv)
                 (or (= (cdr pv) 0)
                     (tf-every? (lambda (qw) (or (= (cdr qw) 1) (not (tf-below? (car pv) (car qw))))) pairs)))
               pairs)))
(define (tf-every? p xs) (cond ((null? xs) #t) ((p (car xs)) (tf-every? p (cdr xs))) (else #f)))
;; p <= q pointwise, p /= q
(define (tf-below? p q) (and (not (equal? p q)) (let loop ((p p) (q q)) (or (null? p) (and (<= (car p) (car q)) (loop (cdr p) (cdr q)))))))
(define (tf-any-below? p ps) (let loop ((qs ps)) (and (pair? qs) (or (tf-below? (car qs) p) (loop (cdr qs))))))

;; ---------------------------------------------------------------------------
;; Free modules R^n over a finite ring R
;; ---------------------------------------------------------------------------

(define (tf-free-module T gens)
  (let* ((R (cdr (assq 'ring (theory-parameters T))))
         (rs (model-elements R)) (zero (model-operation R 'zero)) (one (model-operation R 'one))
         (radd (model-operation R 'add)) (rneg (model-operation R 'neg)) (rmul (model-operation R 'mul))
         (count (expt (length rs) (length gens))))
    (tf-model T (tf-name T gens)
              (append (list (cons 'zero (map (lambda (g) zero) gens))
                            (cons 'add (lambda (a b) (map radd a b)))
                            (cons 'neg (lambda (a) (map rneg a))))
                      (map (lambda (r) (cons (list 'scale r) (lambda (a) (map (lambda (c) (rmul r c)) a)))) rs))
              (if (<= count 4096) (tf-tuples rs (length gens)) #f)
              (lambda (a b) (let loop ((a a) (b b)) (or (null? a) (and (model-equal? R (car a) (car b)) (loop (cdr a) (cdr b))))))
              (map (lambda (g) (cons g (map (lambda (h) (if (eq? g h) one zero)) gens))) gens)
              (lambda (v) (tf-fold-op 'add
                                      (filter (lambda (x) x)
                                              (map (lambda (c g) (and (not (model-equal? R c zero)) (list (list 'scale c) g))) v gens))
                                      '(zero))))))
