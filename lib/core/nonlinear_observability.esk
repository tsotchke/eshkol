;;; Exact task observability of polynomial ODEs. Selected MIT contribution.
;;; Proof admission and replay do not invoke a Groebner search.
(require core.groebner)
(require core.ring)
(provide observation-jet observation-fiber observation-task-hint
         certify-observation-task verify-observation-task observation-symmetry?)

(define (no-all p xs) (or (null? xs) (and (p (car xs)) (no-all p (cdr xs)))))
(define (no-range n) (let loop ((i 0) (a '())) (if (= i n) (reverse a) (loop (+ i 1) (cons i a)))))
(define (no-take xs n) (if (= n 0) '() (cons (car xs) (no-take (cdr xs) (- n 1)))))
(define (no-vars! vs)
  (if (not (and (list? vs) (pair? vs) (no-all symbol? vs))) (error "Expected polynomial variables"))
  (let loop ((xs vs))
    (if (pair? xs) (begin (if (memq (car xs) (cdr xs)) (error "Duplicate variable")) (loop (cdr xs))))))
(define (no-expr P vs e)
  (cond ((and (number? e) (rational? e) (exact? e)) (ring-admit P e))
        ((symbol? e) (if (memq e vs) (ring-poly-variable P e) (error "Unbound polynomial variable" e)))
        ((and (list? e) (pair? e) (memq (car e) '(+ - *)))
         (let ((xs (map (lambda (x) (no-expr P vs x)) (cdr e))))
           (cond ((eq? (car e) '+) (fold-left (lambda (a b) (r+ P a b)) (r0 P) xs))
                 ((eq? (car e) '*) (fold-left (lambda (a b) (r* P a b)) (r1 P) xs))
                 ((null? xs) (error "Empty subtraction"))
                 ((null? (cdr xs)) (r-neg P (car xs)))
                 (else (fold-left (lambda (a b) (r- P a b)) (car xs) (cdr xs))))))
        ((and (list? e) (= (length e) 3) (eq? (car e) 'expt)
              (integer? (caddr e)) (exact? (caddr e)) (>= (caddr e) 0))
         (r-expt P (no-expr P vs (cadr e)) (caddr e)))
        (else (error "Expected exact polynomial expression" e))))
(define (no-deriv P p j)
  (ring-poly P
    (let loop ((ts (ring-poly-terms p)) (out '()))
      (if (null? ts) (reverse out)
          (let* ((t (car ts)) (es (cdr t)) (k (list-ref es j)))
            (loop (cdr ts)
              (if (= k 0) out
                  (cons (cons (* k (car t))
                    (map (lambda (e i) (if (= i j) (- e 1) e)) es (no-range (length es)))) out))))))))
(define (no-lie P vs f h)
  (fold-left (lambda (a b) (r+ P a b)) (r0 P)
    (map (lambda (fi j) (r* P fi (no-deriv P h j))) f (no-range (length vs)))))
(define (no-model! vs f h depth)
  (no-vars! vs)
  (if (not (and (list? f) (= (length f) (length vs)) (list? h)
                (integer? depth) (exact? depth) (>= depth 0))) (error "Invalid polynomial observation model")))
(define (no-jets P vs f hs depth)
  (let loop ((k 0) (row hs) (out '()))
    (if (= k depth) (append out row)
        (loop (+ k 1) (map (lambda (h) (no-lie P vs f h)) row) (append out row)))))
;; Ordered by derivative order, then by sensor; entries are carrier polynomials.
(define (observation-jet vs f h depth)
  (no-model! vs f h depth)
  (let ((P (make-polys rationals vs)))
    (no-jets P vs (map (lambda (e) (no-expr P vs e)) f)
                     (map (lambda (e) (no-expr P vs e)) h) depth)))
(define (no-mirror vs)
  (let ((ys (map (lambda (v) (string->symbol (string-append "observation$" (symbol->string v)))) vs)))
    (if (no-all (lambda (v) (not (memq v vs))) ys) ys (error "Reserved observation variable collision"))))
(define (no-sub e from to)
  (cond ((symbol? e) (let loop ((xs from) (ys to))
                        (cond ((null? xs) e) ((eq? e (car xs)) (car ys)) (else (loop (cdr xs) (cdr ys))))))
        ((pair? e) (cons (car e) (map (lambda (x) (no-sub x from to)) (cdr e))))
        (else e)))
(define (no-rename P p)
  (let ((n (quotient (length (ring-poly-variable-names P)) 2)))
    (ring-poly P (map (lambda (t) (cons (car t) (append (map (lambda (i) 0) (no-range n)) (no-take (cdr t) n))))
                     (ring-poly-terms p)))))
;; #(P constraints task-difference); the model is supplied again to every replay.
(define (observation-fiber vs f h depth task)
  (no-model! vs f h depth)
  (let* ((ys (no-mirror vs)) (all (append vs ys)) (P (make-polys rationals all))
         (fs (map (lambda (e) (no-expr P vs e)) f))
         (hs (map (lambda (e) (no-expr P vs e)) h))
         (jets (no-jets P vs fs hs depth)) (q (no-expr P vs task)))
    (vector P (map (lambda (p) (r- P p (no-rename P p))) jets) (r- P q (no-rename P q)))))
;; Discovery only: false means no ideal-membership proof, not nonobservability.
(define (observation-task-hint vs f h depth task)
  (let* ((m (observation-fiber vs f h depth task)) (P (vector-ref m 0))
         (q (vector-ref m 2)) (gs (vector-ref m 1)))
    (if (or (r-zero? P q) (and (pair? gs) (ideal-member? q gs))) 'ideal-consequence 'unknown)))
;; Sum_i multiplier_i * (jet_i(x)-jet_i(y)) = (task(x)-task(y))^power.
;; Positive powers certify vanishing over Q/R/C. No real-radical completeness claim.
(define (verify-observation-task cert vs f h depth task)
  (guard (e (else #f))
    (and (vector? cert) (= (vector-length cert) 3) (eq? (vector-ref cert 0) 'observation-task-v1)
         (integer? (vector-ref cert 1)) (exact? (vector-ref cert 1)) (> (vector-ref cert 1) 0)
         (list? (vector-ref cert 2))
         (let* ((m (observation-fiber vs f h depth task)) (P (vector-ref m 0))
                (gs (vector-ref m 1)) (all (ring-poly-variable-names P))
                (qs (map (lambda (q) (no-expr P all q)) (vector-ref cert 2))))
           (and (= (length gs) (length qs))
                (r= P (r-expt P (vector-ref m 2) (vector-ref cert 1))
                  (fold-left (lambda (a b) (r+ P a b)) (r0 P)
                    (map (lambda (q g) (r* P q g)) qs gs))))))))
(define (certify-observation-task vs f h depth task power multipliers)
  (let ((c (vector 'observation-task-v1 power multipliers)))
    (if (verify-observation-task c vs f h depth task) c #f)))
;; An invariant parameterized family and an involutive parameter permutation.
;; Exact polynomial identities prove equal observation trajectories at all orders.
;; Task noninvariance proves that some of those trajectories differ in the task.
(define (observation-symmetry? vs f h task ps embed pf perm)
  (guard (e (else #f))
    (no-model! vs f h 0) (no-vars! ps)
    (and (= (length embed) (length vs)) (= (length pf) (length ps))
         (= (length perm) (length ps)) (no-all (lambda (p) (memq p ps)) perm)
         (equal? (map (lambda (p) (no-sub p ps perm)) perm) ps)
         (let* ((P (make-polys rationals ps))
                (ee (map (lambda (x) (no-expr P ps x)) embed))
                (ff (map (lambda (x) (no-expr P ps x)) pf))
                (same (lambda (a b) (r= P (no-expr P ps a) (no-expr P ps b)))))
           (and
             (no-all (lambda (pair)
               (r= P (no-expr P ps (no-sub (car pair) vs embed)) (no-lie P ps ff (cadr pair)))) (map list f ee))
             (no-all (lambda (s) (same (no-sub s vs embed) (no-sub (no-sub s vs embed) ps perm))) h)
             (no-all (lambda (pair) (same (no-sub (car pair) ps perm) (cadr pair))) (map list pf (map (lambda (p) (no-sub p ps pf)) perm)))
             (not (same (no-sub task vs embed) (no-sub (no-sub task vs embed) ps perm))))))))
