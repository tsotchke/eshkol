# Run a JIT or VM library fixture, requiring both a clean exit and verdict.
foreach(required ESHKOL_EXE ESHKOL_SOURCE ESHKOL_MODE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(ESHKOL_MODE STREQUAL "jit")
    if(NOT DEFINED ESHKOL_LINK_DIR)
        message(FATAL_ERROR "Missing ESHKOL_LINK_DIR")
    endif()
    set(args -r "${ESHKOL_SOURCE}" "-L${ESHKOL_LINK_DIR}")
elseif(ESHKOL_MODE STREQUAL "vm")
    set(args "${ESHKOL_SOURCE}")
else()
    message(FATAL_ERROR "Unknown ESHKOL_MODE: ${ESHKOL_MODE}")
endif()
execute_process(COMMAND "${ESHKOL_EXE}" ${args} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 240)
message("${output}${errors}")
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Library execution failed: ${status}")
endif()
if(NOT output MATCHES "(^|\n)RESULT: PASS(\r?\n|$)" OR
   "${output}${errors}" MATCHES "FAIL:|RESULT: FAIL|fatal signal")
    message(FATAL_ERROR "Library suite lacks a clean explicit verdict")
endif()
