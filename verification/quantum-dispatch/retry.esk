(require core.quantum.register)
(require core.quantum.circuit)

(define (check ok message) (if (not ok) (error message)))
(define (caught thunk)
  (guard (e (#t e)) (thunk) #f))
(define recorder (vector 0))
(define (apply-count) (vector-ref recorder 0))
(define original-apply (vector-ref statevector-backend 4))
(vector-set! statevector-backend 4
  (lambda (st w gs)
    (vector-set! recorder 0 (+ 1 (apply-count)))
    (original-apply st w gs)))

(define (basis? box expected)
  (let ((v (vector->list (vector-ref box 0))))
    (and (= (length v) (length expected))
         (every (lambda (x) (= 0 (imag-part x))) v)
         (every (lambda (x) x) (map = (map real-part v) expected)))))

(set-quantum-region-options! '((seed . 1)))
(call-with-quantum-region
  (lambda (r)
    (let* ((q (qapply-circuit (qalloc r 2) (make-qcircuit 2 '((H 1) (H 1) (X 0)))))
           (pending (vector-ref r 5)) (log (vector-ref r 9)) (box (quantum-region-state r))
           (amps (vector-ref box 0)) (measure (lambda () (qmeasure q))))
      (qr-test-allocation-failure! #t)
      (let ((e (with-region 'child (caught measure))))
        (let ((message (and (error-object? e) (error-object-message e)))
              (prefix "region promotion: out of memory"))
          (check (and message (>= (string-length message) (string-length prefix))
                      (equal? prefix (substring message 0 (string-length prefix))))
                 "expected allocation error from the promotion barrier")))
      (check (and (= (apply-count) 1) (eq? pending (vector-ref r 5)) (eq? log (vector-ref r 9))
                  (not (vector-ref r 11)) (eq? box (quantum-region-state r))
                  (eq? amps (vector-ref box 0)) (basis? box '(1 0 0 0)) (qreg-live? q))
             "failed preparation changed the region")
      (qr-test-allocation-failure! #f)
      (check (equal? (with-region 'retry (measure)) '(1 0)) "wrong retry result")
      (check (and (= (apply-count) 2) (null? (vector-ref r 5)) (eq? box (quantum-region-state r))
                  (basis? box '(0 0 1 0)) (equal? (qregion-gate-log r) '((X 0))))
             "retry did not commit exactly once"))))
(display "retry: two applies, one committed X") (newline)

(vector-set! statevector-backend 4 original-apply)
