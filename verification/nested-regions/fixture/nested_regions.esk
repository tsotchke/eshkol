(require core.blc)
(require core.blc-fast)
(extern void boundary i64 :real nested_boundary)
(extern void observe-pair i64 ptr :real nested_pair)

(define (exercise term expected seed)
  (boundary 0)
  (with-region ('parent 1048576)
    (let ((prior (cons seed (+ seed 1))))
      (observe-pair 1 prior)
      (with-region ('child 1048576)
        (let ((out (blc-fast-run term 200000)))
          (if (not (and (eq? (car out) 'normal) (equal? expected (cadr out))))
              (error "unexpected normal form"))
          (display (blc-encode (cadr out))) (newline)
          (boundary 2)
          0))
      (observe-pair 5 prior)
      (let ((fresh (cons (cdr prior) (car prior))))
        (if (not (and (= (car fresh) (+ seed 1)) (= (cdr fresh) seed)))
            (error "invalid parent pair"))
        (observe-pair 6 fresh)
        0)))
  (boundary 9))

(define apply-two (blc-lam (blc-lam (blc-app (blc-var 2) (blc-var 1)))))
(exercise (blc-app (blc-app apply-two blc-I) blc-I) blc-I 37)
(exercise (blc-app (blc-U) (blc-list-of-bits blc-I-bits blc-K)) blc-K 731)
