;; R0 reads a vector of Unicode scalar values for each NDJSON record.
;; Objects and arrays are tagged separately, including when empty.
(define (k-stop status reason) (raise (list 'verdict status reason)))
(define (k-error why) (k-stop "ERROR" why))
(define (k-unsupported why) (k-stop "UNSUPPORTED" why))
(define (k-reject why) (k-stop "REJECT" why))

;; Escape transport delimiters injectively. This also preserves NUL and scalars
;; that the VM's C strings cannot store directly. No Unicode normalization.
(define (k-text-unit n)
  (if (and (>= n 32) (< n 127) (not (= n 124)) (not (= n 126)))
      (make-string 1 (integer->char n))
      (string-append "~" (number->string n) ";")))
(define (k-digit? c) (and (>= c 48) (<= c 57)))
(define (k-parse chars)
  (let ((at 0) (limit (vector-length chars)))
    (define (peek) (if (< at limit) (vector-ref chars at) -1))
    (define (take) (let ((c (peek))) (if (< c 0) (k-error "truncated-json"))
                      (set! at (+ at 1)) c))
    (define (expect c) (if (not (= (take) c)) (k-error "json-token")))
    (define (space) (if (memv (peek) '(9 13 32)) (begin (take) (space))))
    (define (hex4)
      (let loop ((i 0) (v 0))
        (if (= i 4) v
            (let* ((c (take)) (d (cond ((k-digit? c) (- c 48))
                                       ((and (>= c 65) (<= c 70)) (- c 55))
                                       ((and (>= c 97) (<= c 102)) (- c 87))
                                       (else (k-error "unicode-escape")))))
              (loop (+ i 1) (+ (* 16 v) d))))))
    (define (escaped)
      (case (take)
        ((34) 34) ((47) 47) ((92) 92) ((98) 8) ((102) 12) ((110) 10)
        ((114) 13) ((116) 9)
        ((117) (let ((a (hex4)))
                 (cond ((and (>= a 55296) (< a 56320))
                        (if (not (= (take) 92)) (k-error "surrogate"))
                        (if (not (= (take) 117)) (k-error "surrogate"))
                        (let ((b (hex4)))
                          (if (or (< b 56320) (> b 57343)) (k-error "surrogate"))
                          (+ 65536 (* 1024 (- a 55296)) (- b 56320))))
                       ((and (>= a 56320) (<= a 57343)) (k-error "surrogate"))
                       (else a))))
        (else (k-error "json-escape"))))
    (define (text)
      (expect 34)
      (let loop ((parts '()))
        (let ((c (take)))
          (cond ((= c 34) (apply string-append (reverse parts)))
                ((< c 32) (k-error "json-string"))
                (else (loop (cons (k-text-unit (if (= c 92) (escaped) c)) parts)))))))
    (define (digits)
      (if (not (k-digit? (peek))) (k-error "json-number"))
      (let loop () (if (k-digit? (peek)) (begin (take) (loop)))))
    (define (number)
      (let ((start at) (integral #t))
        (if (= (peek) 45) (take))
        (if (= (peek) 48) (take) (digits))
        (if (= (peek) 46) (begin (take) (digits) (set! integral #f)))
        (if (memv (peek) '(69 101))
            (begin (take) (if (memv (peek) '(43 45)) (take)) (digits) (set! integral #f)))
        (if (> (- at start) 12) (k-error "numeric-limit"))
        (if integral
            (let loop ((i start) (v 0))
              (if (= i at) (if (= (vector-ref chars start) 45) (- v) v)
                  (let ((c (vector-ref chars i)))
                    (loop (+ i 1) (if (= c 45) v (+ (* v 10) (- c 48)))))))
            'json-real)))
    (define (collection object? depth parse)
      (take) (space)
      (let ((end (if object? 125 93)) (tag (if object? 'obj 'arr)))
        (if (= (peek) end) (begin (take) (list tag))
            (let loop ((xs '()))
              (let ((entry (if object?
                               (let ((key (text)))
                                 (if (assoc key xs) (k-error "duplicate-json-key"))
                                 (space) (expect 58) (cons key (parse (+ depth 1))))
                               (parse (+ depth 1)))))
                (space)
                (if (= (peek) end) (begin (take) (cons tag (reverse (cons entry xs))))
                    (begin (expect 44) (space) (loop (cons entry xs)))))))))
    (define (value depth)
      (if (> depth 48) (k-error "json-depth"))
      (space)
      (case (peek)
        ((123) (collection #t depth value)) ((91) (collection #f depth value))
        ((34) (text)) ((116) (for-each expect '(116 114 117 101)) #t)
        ((102) (for-each expect '(102 97 108 115 101)) #f)
        ((110) (for-each expect '(110 117 108 108)) 'json-null)
        (else (number))))
    (let ((result (value 0))) (space) (if (< at limit) (k-error "trailing-json")) result)))

(define (k-obj x) (if (and (pair? x) (eq? (car x) 'obj)) (cdr x) (k-error "expected-object")))
(define (k-arr x) (if (and (pair? x) (eq? (car x) 'arr)) (cdr x) (k-error "expected-array")))
(define (k-get x key)
  (let ((p (assoc key (k-obj x)))) (if p (cdr p) (k-error "missing-field"))))
(define (k-has x key) (assoc key (k-obj x)))
(define (k-schema x keys)
  (if (not (= (length (k-obj x)) (length keys))) (k-error "schema"))
  (for-each (lambda (k) (k-get x k)) keys) x)
(define (k-nat x) (if (and (integer? x) (>= x 0)) x (k-error "expected-natural")))
(define (k-str x) (if (string? x) x (k-error "expected-string")))
