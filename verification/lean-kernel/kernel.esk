;; Zero-based terms. Var, sort, constant, Pi, annotated lambda, application.
;; Every kernel traversal consumes fuel, including structural comparison.
(define k-fuel 0)
(define (k-tick) (set! k-fuel (- k-fuel 1)) (if (< k-fuel 0) (k-error "kernel-budget")))
(define (k-v i) (list 'var i))
(define (k-sort l) (list 'sort l))
(define (k-ref n) (list 'const n))
(define (k-pi a b) (list 'pi a b))
(define k-false-name '("False"))
(define k-false (k-ref k-false-name))

;; Rename variables under binders; substitution lifts the argument when it
;; crosses a binder and lowers indices outside the binder being removed.
(define (k-shift term by cutoff)
  (k-tick)
  (cond
    ((eq? (car term) 'var) (let ((i (cadr term))) (if (>= i cutoff) (k-v (+ i by)) term)))
    ((memq (car term) '(app pi lam))
     (list (car term) (k-shift (cadr term) by cutoff)
           (k-shift (caddr term) by (if (eq? (car term) 'app) cutoff (+ cutoff 1)))))
    (else term)))
(define (k-inst term arg depth)
  (k-tick)
  (cond
    ((eq? (car term) 'var) (let ((i (cadr term)))
             (cond ((= i depth) (k-shift arg depth 0))
                   ((> i depth) (k-v (- i 1))) (else term))))
    ((memq (car term) '(app pi lam))
     (list (car term) (k-inst (cadr term) arg depth)
           (k-inst (caddr term) arg (if (eq? (car term) 'app) depth (+ depth 1)))))
    (else term)))

;; A declaration entry is (structured-name kind checked-type optional-value).
(define (k-lookup env name)
  (let ((v (assoc name env))) (if v v (k-reject "undeclared-constant"))))
(define (k-whnf t env)
  (k-tick)
  (cond
    ((eq? (car t) 'const) (let ((d (k-lookup env (cadr t))))
               (if (eq? (cadr d) 'def) (k-whnf (cadddr d) env) t)))
    ((eq? (car t) 'app) (let ((fn (k-whnf (cadr t) env)))
             (if (eq? (car fn) 'lam) (k-whnf (k-inst (caddr fn) (caddr t) 0) env)
                 (list 'app fn (caddr t)))))
    (else t)))
(define (k-conv lhs left-env rhs right-env external?)
  (k-tick)
  (let ((a (k-whnf lhs left-env)) (b (k-whnf rhs right-env)))
    (and (eq? (car a) (car b))
         (cond
           ((memq (car a) '(sort var)) (equal? (cadr a) (cadr b)))
           ((eq? (car a) 'const) (if (and external? (not (equal? (cadr a) k-false-name)))
                        (k-unsupported "opaque-cross-environment-comparison")
                        (equal? (cadr a) (cadr b))))
           (else
             (let ((same? (and (k-conv (cadr a) left-env (cadr b) right-env external?)
                               (k-conv (caddr a) left-env (caddr b) right-env external?))))
               ;; Comparing neutral spines can require type-directed proof
               ;; irrelevance or eta. Structural agreement suffices for R0.
               (if (and (not same?) (memq (car a) '(app lam)))
                   (k-unsupported "higher-order-conversion") same?)))))))
(define (k-level t env)
  (let ((n (k-whnf t env)))
    (if (not (eq? (car n) 'sort)) (k-reject "expected-sort"))
    (if (not (integer? (cadr n))) (k-unsupported "polymorphic-inference"))
    (cadr n)))
(define (k-infer t ctx env)
  (k-tick)
  (cond
    ((eq? (car t) 'sort) (if (integer? (cadr t)) (k-sort (+ (cadr t) 1))
                (k-unsupported "polymorphic-inference")))
    ((eq? (car t) 'var) (let ((i (cadr t)))
             (if (>= i (length ctx)) (k-reject "unbound-variable"))
             (k-shift (list-ref ctx i) (+ i 1) 0)))
    ((eq? (car t) 'const) (let ((d (k-lookup env (cadr t))))
               (if (eq? (cadr d) 'rec) (k-unsupported "recursor-application"))
               (caddr d)))
    ((memq (car t) '(pi lam))
     (let* ((a (cadr t)) (u (k-level (k-infer a ctx env) env))
            (body-type (k-infer (caddr t) (cons a ctx) env)))
       (if (eq? (car t) 'lam) (k-pi a body-type)
           (let ((v (k-level body-type env))) (k-sort (if (= v 0) 0 (max u v)))))))
    ((eq? (car t) 'app)
     (let ((fn (k-whnf (k-infer (cadr t) ctx env) env)))
       (if (not (eq? (car fn) 'pi)) (k-reject "non-function"))
       (if (not (k-conv (k-infer (caddr t) ctx env) env (cadr fn) env #f))
           (k-reject "application-domain"))
       (k-inst (caddr fn) (caddr t) 0)))
    (else (k-unsupported "expression"))))

(define (k-exact actual expected)
  (if (not (equal? actual expected)) (k-reject "declaration")))
(define (k-single x)
  (let ((xs (k-arr x))) (if (not (= (length xs) 1)) (k-reject "declaration")) (car xs)))
(define (k-table-ref table i)
  (let ((entry (assoc (k-nat i) table))) (if entry (cdr entry) (k-error "undefined-index"))))
(define (k-insert table i value)
  (k-nat i)
  (if (assoc i table) (k-error "duplicate-index"))
  (cons (cons i value) table))
(define (k-tag row skips)
  (let loop ((xs (k-obj row)) (found #f))
    (if (null? xs) (or found (k-error "missing-tag"))
        (let ((key (caar xs)))
          (cond ((member key skips) (loop (cdr xs) found))
                (found (k-error "multiple-tags"))
                (else (loop (cdr xs) key)))))))
(define (k-metadata row)
  (k-schema row '("meta"))
  (let* ((m (k-schema (k-get row "meta") '("lean" "format" "exporter")))
         (format-info (k-schema (k-get m "format") '("version")))
         (lean (k-schema (k-get m "lean") '("githash" "version")))
         (exporter (k-schema (k-get m "exporter") '("name" "version"))))
    (for-each k-str (list (k-get lean "githash") (k-get lean "version")
                          (k-get exporter "name") (k-get exporter "version")))
    (if (not (equal? (k-str (k-get format-info "version")) "3.1.0"))
        (k-unsupported "format-version"))))

(define (k-environment rows)
  (let ((names (list (cons 0 '()))) (levels (list (cons 0 0)))
        (exprs '()) (env '()))
    (define (name i) (k-table-ref names i))
    (define (expr i) (k-table-ref exprs i))
    (define (declare n kind t val)
      (if (null? n) (k-error "anonymous-declaration"))
      (if (assoc n env) (k-error "duplicate-declaration"))
      (set! env (cons (list n kind t val) env)))
    (define (expression tag x)
      (cond
        ((equal? tag "bvar") (k-v (k-nat x)))
        ((equal? tag "sort") (k-sort (k-table-ref levels x)))
        ((equal? tag "const")
         (k-schema x '("name" "us"))
         (if (pair? (k-arr (k-get x "us"))) (k-unsupported "universe-instantiation"))
         (k-ref (name (k-get x "name"))))
        ((equal? tag "app") (k-schema x '("fn" "arg"))
         (list 'app (expr (k-get x "fn")) (expr (k-get x "arg"))))
        ((member tag '("forallE" "lam"))
         (k-schema x '("type" "body" "binderInfo" "name"))
         (name (k-get x "name"))
         (if (not (member (k-get x "binderInfo") '("default" "implicit" "strictImplicit" "instImplicit")))
             (k-error "binder-info"))
         (list (if (equal? tag "lam") 'lam 'pi) (expr (k-get x "type")) (expr (k-get x "body"))))
        (else (k-unsupported "expression"))))
    (define (empty-package x)
      (k-schema x '("types" "ctors" "recs"))
      (let ((types (k-arr (k-get x "types"))))
        (if (or (not (= (length types) 1))
                (not (equal? (name (k-get (car types) "name")) k-false-name)))
            (k-unsupported "inductive")))
      (let* ((i (k-single (k-get x "types"))) (r (k-single (k-get x "recs")))
             (iname (name (k-get i "name"))) (rname (name (k-get r "name")))
             (u (name (k-single (k-get r "levelParams")))))
        (k-schema i '("all" "ctors" "isRec" "isReflexive" "isUnsafe" "levelParams" "name"
                      "numIndices" "numNested" "numParams" "type"))
        (k-schema r '("all" "isUnsafe" "k" "levelParams" "name" "numIndices" "numMinors"
                      "numMotives" "numParams" "rules" "type"))
        (k-exact (k-arr (k-get x "ctors")) '())
        (k-exact rname '("False" "rec"))
        (for-each (lambda (p) (k-exact (name (k-single (k-get p "all"))) iname)) (list i r))
        (for-each (lambda (key) (k-exact (k-get i key) #f)) '("isRec" "isReflexive" "isUnsafe"))
        (for-each (lambda (key) (k-exact (k-get r key) #f)) '("k" "isUnsafe"))
        (for-each (lambda (key) (k-exact (k-get i key) 0)) '("numIndices" "numNested" "numParams"))
        (for-each (lambda (key) (k-exact (k-get r key) 0)) '("numIndices" "numMinors" "numParams"))
        (k-exact (k-get r "numMotives") 1)
        (k-exact (k-arr (k-get r "rules")) '())
        (k-exact (k-arr (k-get i "ctors")) '())
        (k-exact (k-arr (k-get i "levelParams")) '())
        (if (null? u) (k-error "anonymous-universe"))
        (k-exact (expr (k-get i "type")) (k-sort 0))
        (let ((rt (k-pi (k-pi k-false (k-sort (list 'param u)))
                        (k-pi k-false (list 'app (k-v 1) (k-v 0))))))
          (k-exact (expr (k-get r "type")) rt)
          (declare iname 'ind (k-sort 0) #f)
          (declare rname 'rec rt #f))))
    (define (definition tag d)
      (let* ((def? (equal? tag "def")) (n (name (k-get d "name")))
             (t (expr (k-get d "type"))) (v (expr (k-get d "value"))))
        (k-schema d (if def? '("all" "name" "levelParams" "type" "value" "hints" "safety")
                            '("all" "name" "levelParams" "type" "value")))
        (if (member n '(("False") ("False" "rec"))) (k-reject "reserved-declaration"))
        (k-exact (name (k-single (k-get d "all"))) n)
        (if (pair? (k-arr (k-get d "levelParams"))) (k-unsupported "universe-parameters"))
        (if def? (begin
                   (if (not (equal? (k-get d "safety") "safe")) (k-unsupported "definition-safety"))
                   (let ((h (k-get d "hints")))
                     (cond ((and (pair? h) (k-has h "regular"))
                            (k-schema h '("regular")) (k-nat (k-get h "regular")))
                           (else (k-unsupported "reducibility-hints"))))))
        (let ((u (k-level (k-infer t '() env) env)))
          (if (and (not def?) (not (= u 0))) (k-reject "non-proposition")))
        (if (not (k-conv (k-infer v '() env) env t env #f)) (k-reject "body-type"))
        (declare n (if def? 'def 'thm) t v)))
    (define (record row)
      (let* ((tag (k-tag row '("in" "il" "ie"))) (x (k-get row tag)))
        (cond
          ((k-has row "in")
           (k-schema row (list tag "in"))
           (if (not (member tag '("str" "num"))) (k-unsupported "name"))
           (let ((field (if (equal? tag "str") "str" "i")))
             (k-schema x (list "pre" field))
             (set! names (k-insert names (k-get row "in")
                              (append (name (k-get x "pre"))
                                      (list (if (equal? tag "str") (k-str (k-get x field))
                                                (k-nat (k-get x field)))))))))
          ((k-has row "il")
           (k-schema row (list tag "il"))
           (set! levels (k-insert levels (k-get row "il")
                          (cond ((equal? tag "param") (list 'param (name x)))
                                ((equal? tag "succ")
                                 (let ((u (k-table-ref levels x)))
                                   (if (integer? u) (+ 1 u) (k-unsupported "symbolic-successor"))))
                                (else (k-unsupported "level"))))))
          ((k-has row "ie")
           (k-schema row (list tag "ie"))
           (set! exprs (k-insert exprs (k-get row "ie") (expression tag x))))
          (else (k-schema row (list tag))
                (cond ((equal? tag "inductive") (empty-package x))
                      ((member tag '("def" "thm")) (definition tag x))
                      ((equal? tag "axiom") (k-reject "axiom-policy"))
                      (else (k-unsupported "declaration")))))))
    (if (null? rows) (k-error "empty-export"))
    (k-metadata (car rows))
    (for-each record (cdr rows))
    env))

(define (check-export export-records expected-proposition axiom-allowlist)
  (guard (e (else (if (and (pair? e) (eq? (car e) 'verdict)) (cdr e)
                      (list "ERROR" "internal"))))
    (set! k-fuel 12000)
    (if (pair? axiom-allowlist) (k-unsupported "nonempty-axiom-policy"))
    (let* ((env (k-environment (map k-parse (car export-records))))
           (spec (k-environment (map k-parse (car expected-proposition))))
           (proof (k-lookup env (cadr export-records)))
           (goal (k-lookup spec (cadr expected-proposition))))
      (if (not (eq? (cadr proof) 'thm)) (k-reject "target-kind"))
      (if (not (eq? (cadr goal) 'def)) (k-reject "expected-definition"))
      (if (not (k-conv (caddr goal) spec (k-sort 0) spec #f)) (k-reject "expected-proposition"))
      (if (not (k-conv (caddr proof) env (cadddr goal) spec #t)) (k-reject "target"))
      (list "ACCEPT" "checked" (map (lambda (d) (list (car d) (cadr d))) (reverse env)) '()))))

(define (k-report r)
  (if (equal? (car r) "ACCEPT")
      (for-each (lambda (d)
                  (display "D|") (display (cadr d))
                  (for-each (lambda (part) (display "|")
                              (display (if (string? part) "s" "n")) (display part)) (car d))
                  (newline)) (caddr r)))
  (display "V|") (display (car r)) (display "|") (display (cadr r)) (newline))
