;; Test-only observer, inserted into a scratch copy of core.blc-fast.
;; Preserve each suspension's original code and environment independently of
;; its mutable payload. The alist uses pair identity and lives for one run.
(define audit-cells '())
(define audit-depth 0)
(define audit-ids '())
(define audit-fresh 0)
(define (audit-start term fuel)
  (set! audit-cells '()) (set! audit-ids '()) (set! audit-depth 0) (set! audit-fresh 0)
  (display "START ") (display fuel) (display " ") (display (blc-encode term)) (newline))
(define (audit-id cell)
  (let ((record (assq cell audit-ids)))
    (if record (cdr record) (error "unknown cell identity"))))
(define (audit-operation kind cell)
  (display kind) (display " ") (display (audit-id cell)) (newline))
(define (audit-env env)
  (if (pair? env)
      (begin
        (if (eq? (caar env) 'level)
            (begin (display " l") (display (cdar env)))
            (begin (display " a") (display (audit-id (car env)))))
        (audit-env (cdr env)))))
(define (audit-raw-value v)
  (cond ((integer? v)
         (if (< v 0)
             (begin (display "FREE ") (display (- -1 v)))
             (begin (display "BOUND ") (display v))))
        ((eq? (car v) 'closure)
         (display "FUN ") (display (blc-encode (cadr v))) (audit-env (cddr v)))
        (else
         (audit-raw-value (cadr v))
         (audit-env (list (caddr v))))))
(define (audit-value-event kind cell v)
  (display kind) (display " ") (display (audit-id cell))
  (display " ") (audit-raw-value v) (newline))
(define (audit-write! destination returned)
  (set-cdr! destination returned)
  (audit-value-event "WRITE" destination (cdr destination)))
(define (audit-publish! destination)
  (set-car! destination 'memo)
  (audit-value-event "PUBLISH" destination (cdr destination))
  (audit-event "FILL" destination))
(define (audit-save cell)
  (if (assq cell audit-ids) (error "duplicate live suspension identity"))
  (set! audit-cells (cons (cons cell (cdr cell)) audit-cells))
  (set! audit-ids (cons (cons cell audit-fresh) audit-ids))
  (display "ALLOC ") (display audit-fresh) (display " ") (display (blc-encode (cadr cell)))
  (audit-env (cddr cell)) (newline)
  (set! audit-fresh (+ audit-fresh 1)))
(define (audit-variable i env d)
  (cond ((null? env) (blc-var (+ d i)))
        ((= i 1) (audit-cell (car env) d))
        (else (audit-variable (- i 1) (cdr env) d))))
(define (audit-code t env d)
  (cond ((blc-var? t) (audit-variable (blc-var-index t) env d))
        ((blc-app? t) (blc-app (audit-code (blc-app-fun t) env d)
                               (audit-code (blc-app-arg t) env d)))
        (else (blc-lam (audit-code (blc-lam-body t)
                                   (cons (cons 'level d) env) (+ d 1))))))
(define (audit-cell cell d)
  (if (eq? (car cell) 'level)
      (blc-var (- d (cdr cell)))
      (let ((saved (assq cell audit-cells)))
        (if (not saved) (error "missing original suspension"))
        (audit-code (cadr saved) (cddr saved) d))))
(define (audit-value v d)
  (cond ((integer? v) (blc-var (- d v)))
        ((eq? (car v) 'spine)
         (blc-app (audit-value (cadr v) d) (audit-cell (caddr v) d)))
        (else (blc-lam (audit-code (cadr v) (cons (cons 'level d) (cddr v)) (+ d 1))))))
(define (audit-event kind cell)
  (display kind) (display " ")
  (display (blc-encode (audit-cell cell audit-depth))) (display " ")
  (display (blc-encode (audit-value (cdr cell) audit-depth))) (newline))
(define (audit-end status forces hits steps item)
  (display "STOP ") (display status) (display " ") (display steps)
  (if (eq? status 'normal) (begin (display " ") (display (blc-encode item))))
  (newline)
  (display "END ") (display status) (display " ") (display forces)
  (display " ") (display hits) (newline))
