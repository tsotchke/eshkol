(extern i64 observe-tensor ptr :real verificatum_observe_tensor)
(define (audited-product a b) (tensor-matmul a b))
(define left (reshape (vector 1 2 3 4 5 6) 2 3))
(define right (reshape (vector 1 2 3 4 5 6) 3 2))
(define other (reshape (vector 1 2 3 4 5 6) 2 3))
(display (tensor-shape (audited-product left right)))
(newline)
(display (observe-tensor right))
(newline)
(display (tensor-shape (audited-product left right)))
(newline)
(display (tensor-shape (audited-product left other)))
(newline)
