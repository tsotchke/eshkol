(require core.blc)

(define (iter-app n f x)
  (if (= n 0) x (iter-app (- n 1) f (blc-app f x))))
(define (wrap n body)
  (if (= n 0) body (wrap (- n 1) (blc-lam body))))
(define (church n)
  (wrap 2 (iter-app n (blc-var 2) (blc-var 1))))
(define (dup-normal n)
  (if (= n 0) (blc-var 1)
      (let ((child (dup-normal (- n 1)))) (blc-app child child))))
(define (case-depth default maximum)
  (let ((raw (get-environment-variable "BLC_DEPTH")))
    (if (and (string? raw) (> (string-length raw) 0))
        (let ((n (string->number raw)))
          (if (and (integer? n) (>= n 0) (<= n maximum)) n
              (error "invalid BLC_DEPTH" raw)))
        default)))
(define (bench-input name)
  ;; Each pair holds the workload and an independently constructed full NF.
  (cond
    ((equal? name "universal")
     (cons (blc-app (blc-U) (blc-list-of-bits blc-I-bits blc-K)) blc-K))
    ((equal? name "discard")
     (cons (blc-app (blc-app blc-K blc-I) blc-omega) blc-I))
    ((equal? name "byte-prefix")
     ;; Demand the second byte from a BLC8 stream with an unfinished tail.
     (let* ((byte (blc-byte->term 165))
            (stream (blc-cons (blc-byte->term 0) (blc-cons byte blc-omega))))
       (cons (blc-app (blc-app stream blc-false) blc-true) byte)))
    ((equal? name "church")
     (cons (blc-app (church 2) (church 5)) (church 25)))
    ((equal? name "already-normal")
     (let ((t (wrap 256 (blc-var 257)))) (cons t t)))
    ((equal? name "deep")
     (let ((n (case-depth 256 1024)))
       (cons (wrap n (blc-app blc-I (blc-var (+ n 1)))) (wrap n (blc-var (+ n 1))))))
    ((equal? name "shared-bound")
     (set! blc-max-steps 0)
     (cons (blc-app (blc-app blc-I blc-I) (dup-normal (case-depth 16 48)))
           "blc-eval: no normal form within step bound"))
    ((equal? name "duplicate")
     (let* ((dup (blc-lam (blc-app (blc-var 1) (blc-var 1))))
            (arg (iter-app 8 blc-I (blc-var 1))))
       (let ((n (case-depth 5 10)))
         (cons (iter-app n dup arg) (dup-normal n)))))
    (else (error "BLC_CASE must be universal, discard, byte-prefix, church, deep, shared-bound or duplicate"))))

(define bench-name (get-environment-variable "BLC_CASE"))
(define fixture (bench-input bench-name))
(define input-term (car fixture))
(define expected (cdr fixture))
(define start-ns (current-time-ns))
(define result
  (if (equal? bench-name "shared-bound")
      (guard (condition (#t (error-object-message condition))) (blc-eval input-term))
      (blc-eval input-term)))
(define elapsed-ns (- (current-time-ns) start-ns))
(if (not (equal? expected result)) (error "normal form mismatch" bench-name))
(display elapsed-ns) (newline)
